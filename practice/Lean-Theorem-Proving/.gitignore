# Lake build directory — contains the entire compiled Mathlib. Never commit.
.lake/
build/

# Slurm job logs. Build output, not source: the live out/err files are truncated
# and rewritten on every submission, and preserved copies of past runs are kept
# locally by hand. The job script itself IS tracked.
slurm_jobs/*.txt

# Kept otherwise minimal, matching the ignore set used in Research-Journey.
__pycache__
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.*.swp

# live tutoring board (Tutor-Board) — scratch space, never tracked
live/
