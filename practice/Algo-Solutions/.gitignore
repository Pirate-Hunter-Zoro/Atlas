.DS_Store
.claude/
.vscode/
__debug*
.*

# live tutoring board (Tutor-Board) — runtime state stays local; the lesson
# transcript (cards, turns, ink, answers, archive) is tracked, so a lecture is
# the same whichever machine it is picked up on.
live/*
!live/cards/
!live/slate/
!live/answers/
!live/archive/
!live/inbox/
!live/text/
!live/state.json
!live/turns.jsonl

# the attribution hook must survive the blanket .* rule above
!.githooks/
!.githooks/**

# The assistant's config directory stays ignored, all of it. The permission
# allowlist that used to be let back in here is `ai-config/workspaces/
# algo-solutions.allow` now, and `install.sh` renders it back into place —
# so the file below this directory is generated and belongs to whichever
# assistant is installed, not to this workspace.
