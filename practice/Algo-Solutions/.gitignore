.DS_Store
.claude/
.vscode/
__debug*
.*

# live tutoring board (Tutor-Board) — runtime state stays local; the lesson
# transcript (cards, turns, ink, answers, archive) is tracked, so a lecture is
# the same whichever machine it is picked up on.
live/*
!live/cards/
!live/slate/
!live/answers/
!live/archive/
!live/inbox/
!live/text/
!live/state.json
!live/turns.jsonl

# the attribution hook must survive the blanket .* rule above
!.githooks/
!.githooks/**

# so must the board's permission settings — .claude/ above keeps the
# machine-local settings.local.json out, this lets the shared one in.
!.claude/
!.claude/settings.json
