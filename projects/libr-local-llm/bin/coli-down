#!/bin/bash
# End the colibri chain. It holds most of a 1 TB node -- do not leave it up after
# you are done.
#
#   coli-down
#
# THE FLAG AND THE CANCEL, IN THAT ORDER, AND THE ORDER IS THE WHOLE OF IT. A
# running generation submits its own successor, so cancelling one on its own is
# how you replace a server rather than stop it: the chain reads the cancel as a
# node failure and does exactly what it was built to do. The flag is what says
# somebody meant it.
set -euo pipefail

_self="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
. "$(dirname "$_self")/scripts/colibri-env.sh"

coli_mark_stopped "coli-down"

# The generations, and any `coli-adopt` watcher standing beside one. The watcher
# stands down on the flag by itself, but only at its next pass, and a spare CPU
# held for five minutes after somebody said stop is five minutes of somebody
# asking what that job is.
sweep() {
    local found=0 job node
    for job in $(coli_jobs | awk '{ print $1 }') \
               $(squeue -u "$USER" -n colibri_adopt -h -o '%i' 2>/dev/null || true); do
        node="$(squeue -j "$job" -h -o '%N' 2>/dev/null || true)"
        scancel "$job" 2>/dev/null || true
        echo "Cancelled job ${job} (${node:-unallocated})"
        found=1
    done
    return $(( 1 - found ))
}

FOUND=0
sweep && FOUND=1

# A SECOND SWEEP, BECAUSE A GENERATION CAN QUEUE ITS SUCCESSOR IN THE GAP. The
# first sweep reads the queue and then cancels, and a chain watcher submitting in
# between leaves a successor nothing has cancelled -- which is a server that comes
# back an hour after somebody asked for it to go. The flag above means the new
# generation will stand down on its own, but only after it has pinned 406 GB.
sleep 2
sweep && FOUND=1

if [ "$FOUND" -eq 0 ]; then
    echo "No colibri server jobs to cancel."
fi
echo "The chain is stopped. 'coli-up' starts it again."
exit 0
