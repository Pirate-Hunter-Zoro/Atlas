#!/bin/bash
# Put colibri to work in a directory. Any directory, any task.
#
#   coli-code                          # Claude Code, TUI, in the current directory
#   coli-code -d ~/Atlas/research/X    # ...somewhere else
#   coli-code "fix the failing test"   # one-shot, no TUI
#   coli-code -a opencode              # the other front end
#   coli-code --yes "..."              # do not stop to ask about each tool call
#   coli-code -c "and now the tests"   # continue the session already open
#   coli-code --instructions           # carry the repository's CLAUDE.md in too
#
# -c is not a nicety on this model, it is the whole cost argument. The client's
# preamble is 15,900 tokens and prefill runs at a few tokens a second, so a fresh
# session is two to three hours before the first word; a continued one reuses the
# KV prefix and starts answering. Anything driving this in turns -- the tutor
# board's headless daemon, most obviously -- must continue rather than reopen.
#
# The endpoint is loopback-only on the serving node, so the client has to run
# there. This steps into the existing allocation with `srun --overlap` rather
# than ssh: no key, and it lands inside the job with the right devices visible.
set -euo pipefail

_self="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
. "$(dirname "$_self")/scripts/colibri-env.sh"

AGENT=claude
WORKDIR="$PWD"
YES=""
CONTINUE=""
INSTRUCTIONS=""
while [ $# -gt 0 ]; do
    case "$1" in
        -a|--agent)  AGENT="$2"; shift 2 ;;
        -d|--dir)    WORKDIR="$2"; shift 2 ;;
        -p|--port)   COLI_PORT="$2"; shift 2 ;;
        --yes)       YES=1; shift ;;
        -c|--continue) CONTINUE=1; shift ;;
        --instructions) INSTRUCTIONS=1; shift ;;
        -h|--help)   awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;;
        --)          shift; break ;;
        *)           break ;;
    esac
done
MESSAGE="$*"

case "$AGENT" in
    claude|opencode) ;;
    *) echo "coli-code: -a takes 'claude' or 'opencode'" >&2; exit 2 ;;
esac

[ -d "$WORKDIR" ] || { echo "coli-code: no such directory: $WORKDIR" >&2; exit 2; }
WORKDIR="$(cd "$WORKDIR" && pwd -P)"

# ONLY THE GUARDED FRONT END GOES BEHIND THE FENCE.
#
# The egress guard below is a `PreToolUse` hook, which is a thing the claude
# front end has and the other one does not. Both get a shell either way, so in
# a fenced directory the unguarded one is a session that can read PHI and run
# curl -- which is the exfiltration event the whole arrangement exists to
# prevent. Outside the fence it is a coding agent like any other and is fine.
#
# The question "is this directory fenced" is the lab's, not this script's:
# `generic.py --path` answers it with the same policy every other guard reads.
#
# Fail closed. A missing adapter is not an answer of "not fenced": it is no
# answer, and the whole point of `generic.py` refusing an empty question is
# that a guard which quietly stops being consulted is worse than none.
if [ "$AGENT" != claude ]; then
    _asks="$ATLAS_ROOT/ai-config/adapters/generic.py"
    if [ ! -r "$_asks" ]; then
        echo "coli-code: cannot tell whether ${WORKDIR} is behind the PHI fence --" >&2
        echo "there is no policy at $_asks. Refusing the unguarded front end." >&2
        exit 1
    fi
    if ! python3 "$_asks" --path "$WORKDIR/" >/dev/null 2>&1; then
        echo "coli-code: ${AGENT} has no pre-tool hook, so it cannot carry the" >&2
        echo "egress guard, and ${WORKDIR} is behind the PHI fence. Use the" >&2
        echo "default front end here: coli-code -d ${WORKDIR}" >&2
        exit 2
    fi
fi

# Find the server. Ask Slurm rather than reading a state file: a state file goes
# stale the moment a job ends, squeue never does. Under a chain there can be two
# generations running at once for an hour, so this asks which one can ANSWER
# rather than taking whichever Slurm listed first.
JOB_ID="$(coli_serving_job)"
if [ -z "$JOB_ID" ]; then
    PENDING="$(coli_jobs | awk '$2 != "RUNNING" { print $1; exit }')"
    if [ -n "$PENDING" ]; then
        echo "The server is queued as job ${PENDING} and has not started yet." >&2
        echo "Reason: $(squeue -j "$PENDING" -h -o '%r')" >&2
    else
        echo "No colibri server is running. Start one:" >&2
        echo "    coli-up" >&2
    fi
    exit 1
fi
NODE="$(squeue -j "$JOB_ID" -h -o '%N')"
echo "Using ${COLI_JOB_NAME} job ${JOB_ID} on ${NODE}" >&2

# THE WALLTIME IS A CEILING ON THE TURN, AND UNDER A CHAIN IT IS A CEILING ON
# THIS CLIENT ONLY. `srun --overlap` makes this a STEP of that generation, so the
# client dies when the generation does -- the chain replaces the server, not the
# session. `coli-code -c` continues where it left off and the on-disk KV makes
# the continuation cheap, which is why the number is worth printing.
LEFT="$(coli_seconds_left "$JOB_ID")"
if [ -n "$LEFT" ] && [ "$LEFT" -lt 3600 ]; then
    echo "That generation has $(( LEFT / 60 )) min of walltime left. This client is a step" >&2
    echo "of it and ends with it; the chain brings the server back on another node." >&2
    echo "Pick it up again with 'coli-code -c'." >&2
fi

# --------------------------------------------------------------- the transcript
#
# A driver that can read `phi` writes a transcript that quotes `phi`. Both front
# ends keep their session history under $HOME by default -- ~/.claude/projects and
# ~/.local/share/opencode -- which is exactly where a hosted assistant reads all
# day. Redirect both stores under a directory named `phi`, which is fenced whole
# and by name in ai-config/policy/phi.py, so the existing rule covers this without
# a new rule to keep in step.
SESSION_DIR="$COLI_SESSION_ROOT/$AGENT"
mkdir -p "$SESSION_DIR"
# No chmod here on purpose. This filer serves NFSv4 ACLs and synthesises the
# POSIX mode bits from them lossily -- the same defect that makes `os.access`
# lie -- so a chmod writes back a mode derived from a bad reading and can drop
# the real ACL. The parent directory already restricts this tree.

# Clearing the outer job's SLURM_* is load-bearing. Run from inside another
# allocation -- a VSCode remote session on a compute node, an interactive srun --
# the nested srun inherits the OUTER job's step context and dies with exit 192,
# even though --jobid names a different job explicitly.
srun_on_server() {
    (
        for v in $(env | grep -oE '^SLURM_[A-Z_0-9]+' || true); do unset "$v"; done
        exec srun --jobid="$JOB_ID" --overlap "$@"
    )
}

BASE="http://127.0.0.1:${COLI_PORT}"

if [ "$AGENT" = claude ]; then
    # A fresh config directory is not just about where the transcript lands: it
    # also decides the size of the preamble, and on this engine the preamble is
    # the bill. Prefill runs at a few tokens per second on the CPU-streaming
    # path, so every token of system prompt, tool catalog, MCP server, plugin and
    # CLAUDE.md is paid for in wall-clock before the first word comes back.
    # An empty config dir carries none of them.
    #
    # It also means the PHI hook in ~/.claude is not loaded. That is the point:
    # this model runs on our own hardware and reading `phi` is the job it exists
    # for. It is also why the transcript goes behind the fence above.
    mkdir -p "$SESSION_DIR"
    if [ ! -f "$SESSION_DIR/.claude.json" ]; then
        cat > "$SESSION_DIR/.claude.json" <<'SEED'
{ "hasCompletedOnboarding": true, "theme": "dark", "autoUpdates": false }
SEED
    fi

    # ------------------------------------------------------- THE OTHER HALF
    #
    # The read fence comes off so this model can do its job. What replaces it
    # is a fence in the other direction: nothing it reads may leave the node.
    #
    # THE ROUTE IS NOT THE CONTROL. These compute nodes resolve DNS and reach
    # arbitrary hosts over HTTPS -- measured on the serving node, not assumed --
    # so "a local model cannot exfiltrate" is false as a statement about the
    # wiring and has to be made true as a guard. And a deny list over the web
    # tools alone would be decoration, because a coding agent has a shell and
    # the shell has curl. `policy/egress.py` judges the shell too.
    #
    # A HOOK, NOT A PERMISSION. `--yes` is `--dangerously-skip-permissions`, and
    # the unattended session that carries it is exactly the one that needs this.
    # PreToolUse runs whatever the permission mode says; a deny rule is a
    # question, and this repository's own argument about questions is that they
    # are answered by whoever is in a hurry.
    EGRESS_HOOK="$ATLAS_ROOT/ai-config/adapters/claude_code_egress.py"
    if [ ! -r "$EGRESS_HOOK" ]; then
        echo "coli-code: no egress guard at $EGRESS_HOOK" >&2
        echo "This session reads PHI on the strength of that guard existing, so" >&2
        echo "it does not start without it. Check out ai-config/ and try again." >&2
        exit 1
    fi
    cat > "$SESSION_DIR/settings.json" <<JSON
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "python3 $EGRESS_HOOK", "timeout": 10 }
        ]
      }
    ]
  },
  "permissions": { "deny": ["WebFetch", "WebSearch"] }
}
JSON
    if [ -n "$INSTRUCTIONS" ] && [ -r "$HOME/.claude/CLAUDE.md" ]; then
        cp -L "$HOME/.claude/CLAUDE.md" "$SESSION_DIR/CLAUDE.md"
        echo "Carrying CLAUDE.md into the preamble ($(wc -c <"$SESSION_DIR/CLAUDE.md") bytes)." >&2
        echo "At a few tokens per second of prefill, that is minutes before the first word." >&2
    else
        rm -f "$SESSION_DIR/CLAUDE.md"
    fi

    # ANTHROPIC_AUTH_TOKEN, not ANTHROPIC_API_KEY. Both reach the gateway --
    # colibri accepts `Authorization: Bearer` as well as `x-api-key` -- but the
    # API_KEY spelling makes the client ask, on first run in a fresh config
    # directory, whether you really meant to use a key it has not seen. That
    # prompt is a blocking question in a session that may be running unattended.
    # The token spelling sets the bearer header and asks nothing. The gateway
    # does not check it either way unless COLI_API_KEY is set on the server.
    ENVS=(
        "ANTHROPIC_BASE_URL=$BASE"
        "ANTHROPIC_AUTH_TOKEN=local"
        "ANTHROPIC_MODEL=$COLI_MODEL_ID"
        "ANTHROPIC_DEFAULT_OPUS_MODEL=$COLI_MODEL_ID"
        "ANTHROPIC_DEFAULT_SONNET_MODEL=$COLI_MODEL_ID"
        "ANTHROPIC_DEFAULT_HAIKU_MODEL=$COLI_MODEL_ID"
        "ANTHROPIC_SMALL_FAST_MODEL=$COLI_MODEL_ID"
        "CLAUDE_CONFIG_DIR=$SESSION_DIR"
        # The client does not know this model, so it assumes the 200k window it
        # uses for the ones it does know and sizes auto-compact against that --
        # which is 69k tokens past what the server will accept, and the overrun
        # surfaces as a refused request rather than a compaction. Tell it the
        # real number; it says so itself in the warning it prints.
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS=${COLI_CTX:-131072}"
        # Every one of these is a call to a host nobody asked to be called:
        # telemetry, the changelog, the updater, and the small-model calls that
        # title a conversation. They are off because a session reading PHI
        # should be talking to the gateway and to nothing else -- and the node
        # CAN reach them, which is the reason to say so rather than rely on a
        # timeout.
        "DISABLE_NON_ESSENTIAL_MODEL_CALLS=1"
        "DISABLE_TELEMETRY=1"
        "DISABLE_ERROR_REPORTING=1"
        "DISABLE_AUTOUPDATER=1"
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
    )
    CLI=(claude)
    # The belt over the hook's braces. `--strict-mcp-config` means no MCP
    # server is picked up from anywhere, whatever a config file elsewhere says,
    # and the two named tools are the ones whose entire job is a network call.
    # Neither of these is the control -- the hook is, because these are
    # settings and the hook runs under the bypass flag below.
    # Comma-separated on purpose: the space-separated spelling is variadic and
    # swallows whatever positional follows it.
    CLI+=(--strict-mcp-config --disallowedTools WebFetch,WebSearch)
    [ -n "$YES" ] && CLI+=(--dangerously-skip-permissions)
    # The session store is already per-agent under $COLI_SESSION_ROOT and
    # CLAUDE_CONFIG_DIR points at it, so there is nothing to wire here: the
    # client finds its own last conversation in the directory it was given.
    [ -n "$CONTINUE" ] && CLI+=(--continue)
    if [ -n "$MESSAGE" ]; then CLI+=(-p "$MESSAGE"); fi
else
    ENVS=(
        "OPENAI_BASE_URL=$BASE/v1"
        "OPENAI_API_KEY=local"
        "XDG_DATA_HOME=$SESSION_DIR/data"
        "XDG_STATE_HOME=$SESSION_DIR/state"
        "XDG_CONFIG_HOME=$SESSION_DIR/config"
    )
    mkdir -p "$SESSION_DIR/config/opencode"
    # opencode reaches the gateway as a plain OpenAI-compatible provider. Its own
    # config lives under the fenced XDG_CONFIG_HOME so the ollama provider in
    # config/opencode.json is not disturbed.
    cat > "$SESSION_DIR/config/opencode/opencode.json" <<JSON
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "colibri/${COLI_MODEL_ID}",
  "enabled_providers": ["colibri"],
  "permission": { "webfetch": "deny", "websearch": "deny" },
  "provider": {
    "colibri": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Colibri (GLM-5.2 int4, local)",
      "options": { "baseURL": "${BASE}/v1" },
      "models": { "${COLI_MODEL_ID}": { "name": "GLM-5.2 int4 (colibri)" } }
    }
  }
}
JSON
    CLI=(opencode)
    if [ -n "$MESSAGE" ]; then
        CLI+=(run)
        # `-c` on `run`, and only there: continuing is a property of a
        # non-interactive turn. The TUI opens on its own last session already.
        [ -n "$CONTINUE" ] && CLI+=(-c)
        CLI+=(-m "colibri/${COLI_MODEL_ID}" -- "$MESSAGE")
    else CLI+=(-m "colibri/${COLI_MODEL_ID}"); fi
fi

# The invocation crosses a `bash -lc` string boundary, so everything interpolated
# into it is quoted with printf %q: the far side is the same bash, so %q
# round-trips exactly and a path or prompt containing a quote cannot break the
# command apart. A login shell is used so nvm's PATH -- and therefore both CLIs --
# exists on the far node.
Q_ENV="$(printf '%q ' "${ENVS[@]}")"
Q_CLI="$(printf '%q ' "${CLI[@]}")"
Q_DIR="$(printf '%q' "$WORKDIR")"

# `unset -f opencode` first. ~/.bashrc defines an `opencode` SHELL FUNCTION that
# probes OLLAMA_HOST and, finding nothing there, prints the ollama-up advice
# instead of running anything -- it is a signpost for the ollama stack and has no
# idea this one exists. The far side is a login shell, so the function is defined
# there. `command opencode` would also reach past it, but not through `exec`:
# `exec` takes a program, and `command` is a builtin, so the two do not compose.
REMOTE="unset -f opencode 2>/dev/null; cd ${Q_DIR} && export ${Q_ENV} && exec ${Q_CLI}"

cat >&2 <<BANNER
Directory:  ${WORKDIR}
Endpoint:   ${BASE}  (${COLI_MODEL_ID})
Transcript: ${SESSION_DIR}  -- behind the phi fence, deliberately

This model decodes at 3.2-4.4 tok/s and prefills at a few tok/s. A short, single
ask works. An iterative agent session re-pays its growing context every turn.
BANNER

if [ -n "$MESSAGE" ]; then
    srun_on_server --quiet bash -lc "$REMOTE"
else
    # --pty is what makes the terminal interactive through Slurm.
    srun_on_server --quiet --pty bash -lc "$REMOTE"
fi
