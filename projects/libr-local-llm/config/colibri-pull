#!/usr/bin/env bash
# ---------------------------------------------------------------------------
#  colibri-pull -- move colibri forward, at most once a day.
#
#  Colibri is not a clone of its own. It is `vendor/colibri`, a SUBMODULE of
#  Atlas, so moving it is two things and not one: fast-forward the submodule,
#  then commit the bumped pointer in the superproject. An uncommitted pointer
#  nobody touched shows on the tutoring board as unsaved work, which is a lie
#  the person cannot act on.
#
#  Both halves, and the three guards that make an unattended commit safe, are
#  `pull_vendor` in `board/bin/tutor`. This script does not reimplement them --
#  it calls `tutor pull`, which is that routine with nothing else attached. The
#  same routine runs on login from `tutor resume`; this is the copy for a
#  workstation that is left up for a week and never has a login.
#
#      colibri-pull            pull if it has not already run today
#      colibri-pull --force    pull regardless
#
#  Never fatal, and never clever: a dirty tree, a detached HEAD or an
#  unreachable remote is reported to the log and left alone. Merging somebody
#  else's repository is not a decision a timer gets to make.
# ---------------------------------------------------------------------------
set -uo pipefail

STAMP="$HOME/.local/state/colibri-pull.stamp"
LOG="$HOME/.local/state/colibri-pull.log"
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

mkdir -p "$(dirname "$LOG")"
say() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

today="$(date '+%Y-%m-%d')"
if [ "$FORCE" -eq 0 ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$today" ]; then
  exit 0
fi

# A systemd --user unit gets almost no PATH, so find the tool the way the
# person's shell would and then the way the installer put it.
TUTOR="$(command -v tutor 2>/dev/null)"
[ -x "${TUTOR:-}" ] || TUTOR="$HOME/.local/bin/tutor"
[ -x "$TUTOR" ] || { say "no tutor on PATH; colibri not pulled"; exit 0; }

export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false
out="$("$TUTOR" pull 2>&1)"
rc=$?

# `tutor pull` is silent when colibri was already current, so silence is the
# common case and worth saying once rather than logging an empty line.
trimmed="$(printf '%s' "$out" | tr -s ' \n' ' ' | sed 's/^ *//; s/ *$//')"
if [ -n "$trimmed" ]; then
  say "$trimmed"
elif [ "$rc" -eq 0 ]; then
  say "already current"
else
  say "colibri not pulled (exit $rc)"
fi

printf '%s\n' "$today" > "$STAMP"
exit 0
