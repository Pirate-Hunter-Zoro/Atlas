# ---- Slurm logs ----
# Job logs record hostnames, paths, and prompts; keep them out of git.
slurm_jobs/logs/*
!slurm_jobs/logs/.gitkeep

# ---- Never commit ----
# No PHI should ever reach this repo -- it holds infrastructure only, no data
# and no transcripts. These patterns are belt-and-braces.
*.m4a
*.wav
*.mp3
*.json
!config/opencode.json
!config/claude-settings.json
# And this one is not a copy of a live file, it IS the file: `ds-code` exports
# OPENCODE_CONFIG at it where it sits. Left ignored, a fresh clone has the
# command and not the provider it points at.
!config/opencode-deepseek.json
*.jsonl

# so must the markdown linter's, which is config and not data
!.markdownlint.json
*.csv
*.gguf
*.safetensors

# ---- Editor / OS / secrets ----
.claude/
.vscode/
.env
.DS_Store
Thumbs.db
*~
.*.swp
__pycache__/
*.pyc
node_modules/

# live tutoring board (Tutor-Board) — scratch space, never tracked, with one
# exception. `live/map.json` is the written map: the boxes this project is made
# of, in the names its own documents use, which no amount of reading the
# directory listing produces. It is judgement rather than runtime state, so it is
# tracked and travels with a clone.
#
# The SHAPE matters, and `live/` alone cannot express it: git never descends into
# a directory it has excluded, so a negation under `live/` can never fire.
# `live/*` excludes the same files and leaves the door open for this one. The
# negation also has to come after the `*.json` rule above, or that rule is the
# last match and wins.
live/*
!live/map.json

# ---- LaTeX build artifacts ----
# docs/*.tex is the source and docs/*.pdf is the deliverable; everything
# pdflatex writes alongside them regenerates on the next build.
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.fls
*.fdb_latexmk

# ---- chain state ----
# The stop flag and anything else the running chain writes. Runtime, not config.
slurm_jobs/state/
