# ---- Slurm logs ----
# Job logs record hostnames, paths, and prompts; keep them out of git.
slurm_jobs/logs/*
!slurm_jobs/logs/.gitkeep

# ---- Never commit ----
# No PHI should ever reach this repo -- it holds infrastructure only, no data
# and no transcripts. These patterns are belt-and-braces.
*.m4a
*.wav
*.mp3
*.json
!config/opencode.json
!config/claude-settings.json
# And this one is not a copy of a live file, it IS the file: `ds-code` exports
# OPENCODE_CONFIG at it where it sits. Left ignored, a fresh clone has the
# command and not the provider it points at.
!config/opencode-deepseek.json
*.jsonl

# so must the markdown linter's, which is config and not data
!.markdownlint.json
*.csv
*.gguf
*.safetensors

# ---- Editor / OS / secrets ----
.claude/
.vscode/
.env
.DS_Store
Thumbs.db
*~
.*.swp
__pycache__/
*.pyc
node_modules/

# live tutoring board (Tutor-Board) — scratch space, never tracked.
live/*
# but the job registry is tracked: which Slurm jobs ran for which thread,
# appended by `board job`.
!live/jobs.jsonl

# THE THREAD FILE IS TRACKED: this project's deliverables and threads, which is
# judgement no other file contains. The negation comes after the `*.json` rule
# above, or that rule is the last match and wins.
!threads.json

# THE RELAY'S REQUESTS AND REPORTS ARE TRACKED: they are how the Mac and the
# cluster talk, through the repository. Each must survive the blanket *.json
# rule above.
!relay/requests/*.json
!relay/reports/*.json

# ---- LaTeX build artifacts ----
# docs/*.tex is the source and docs/*.pdf is the deliverable; everything
# pdflatex writes alongside them regenerates on the next build.
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.fls
*.fdb_latexmk

# ---- chain state ----
# The stop flag and anything else the running chain writes. Runtime, not config.
slurm_jobs/state/
