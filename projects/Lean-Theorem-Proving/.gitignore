# Lake build directory — contains the entire compiled Mathlib. Never commit.
.lake/
build/

# Slurm job logs. Build output, not source: the live out/err files are truncated
# and rewritten on every submission, and preserved copies of past runs are kept
# locally by hand. The job script itself IS tracked.
slurm_jobs/*.txt

# Kept otherwise minimal, matching the ignore set used in Research-Journey.
__pycache__
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.*.swp

# live tutoring board (Tutor-Board) — runtime state stays local; the lesson
# transcript (cards, turns, ink, answers, archive) is tracked, so a lecture is
# the same whichever machine it is picked up on.
live/*
!live/cards/
!live/slate/
!live/answers/
!live/archive/
!live/inbox/
!live/text/
!live/state.json
!live/turns.jsonl
