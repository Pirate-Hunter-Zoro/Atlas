# The keys this repository reads, and nothing about this machine.
#
# Copy to `.env` and fill in. `.env` itself is not tracked: the real one names
# the on-disk locations of identifiable patient data on lab storage, and this
# repository is public. Every key below has a default in the code; this file is
# the list of what can be overridden, in the order the real file sets them.

# Random seed for reproducibility
SEED=42

# Loading, creating, and cleaning patient data
PREP_DATA_DIR=
OUTPUT_DATA_DIR=
PROCEDURE_CSV_PATH=
MEDICATION_CSV_PATH=
DIAGNOSIS_CSV_PATH=
ENCOUNTER_CSV_PATH=
VITALS_CSV_PATH=
PERSON_CSV_PATH=
TRD_LIST_PATH=
ANALYSIS_DIR=
MDD_MED_DATE_CSV_PATH=
PATIENT_JSON_DIR=
SLICED_PATIENT_JSON_DIR=
COHORT_PATH=

# HuggingFace cache
HF_HOME=

# Embedding model to use
EMBEDDER_MODEL_NAME=
EMBEDDER_MODEL_PATH=
# Bear in mind that 'cuda' tends to lead to running out of VRAM when trying to embed large strings with the GPU, and reserving multiple GPUs does not help because the SentenceTransformer does not know how to use both together - use 'cpu' in that case
EMBEDDER_DEVICE=
# How many strings we feed into the embedder at once for it to return a corresponding list of vectors
EMBEDDER_BATCH_SIZE=32

# Generative model to use
VLLM_MODEL_NAME=
VLLM_MODEL_PATH=
MAX_MODEL_LEN=32768
# Maximum number of tokens allowed in response
MAX_TOKENS=512
# Maximum number of requests we want to throw at the LLM server at a time
LLM_MAX_CONCURRENCY=64
# Number of VLLM servers working on judging
NUM_VLLM_SERVERS=2
# For the correct server URLS
ENDPOINTS_DIR=

# Storage of computed narratives, vectors, analysis values, and logs
ARTIFACTS_DIR=
SCRUB_PATIENT_JSON=0
SCRUB_NARRATIVES=0
SCRUB_FEATURE_VECTORS=0
SCRUB_EMBEDDINGS=0
SCRUB_TRAINED_MODELS=0
NARRATIVES_DIR=
FEATURE_DATAFRAME_PATH=
EMBEDDINGS_DIR=
JUDGEMENTS_DIR=
RESULTS_DIR=

# Concurrency hyperparameters - beware of overwhelming the vllm server...
NUM_WORKERS_NON_LLM_TASK=16
NUM_WORKERS_LLM_TASK=16

# Hyperparameters for patient parsing windows
YEARS_BACK=2
YEARS_AHEAD=1
# Maximum days of history allowed to show up in a histogram of chronological lengths
HISTORY_LENGTH_CUTOFF=5000
# Total number of neighbors we look at for risk score calculation
NUM_NEIGHBOR_PATIENTS=50
# Total number of random neighbors we pick fo the subsampling method
SUBSAMPLE_POOL_SIZE=200
HIGH_SIM_THRESHOLD=0.95
LOW_CONFIDENCE_ESS_THRESHOLD=20
NUM_PAIRS_SANITY_CHECK=1000
WEIGHTING_EXPONENT=5.0
TRD_TEST_COUNT=1000

# Hyperparameters pertaining to querying VLLM server
COMPUTE_LLM_SIMILARITY=1
NEIGHBOR_FARTHEST=1
NEIGHBOR_SUBSAMPLE=1
VLLM_URL=
