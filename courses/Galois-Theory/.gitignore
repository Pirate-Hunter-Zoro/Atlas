# This course is its OWN private repository (github.com/Pirate-Hunter-Zoro/Galois-Theory),
# ignored by Atlas, and this file is its whole ignore set: a nested repository
# reads none of Atlas's root .gitignore. So the build, LaTeX and credential
# rules are repeated here.
#
# The textbook, its chapter excerpts, the professor's slides and the assignment
# sheets ARE tracked, because the repository is private.

# ---- regenerated ----
# A compiled PDF under build/ is tracked, so another machine can open it;
# what LaTeX writes beside it is not.
*.pyc
*.pyo
.venv/
*.log
*.out
*.aux
*.nav
*.snm
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
**/relay/state/
.vscode/
.nfs*
**/.claude/

# ---- a credential dropped in the tree ----
*-api-key
*_api_key
*.key
keys.env
.env

__pycache__
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.*.swp

# live tutoring board (Tutor-Board) — runtime state stays local; the lesson
# transcript (cards, turns, ink, answers, archive) is tracked, so a lecture is
# the same whichever machine it is picked up on.
live/*
!live/cards/
!live/slate/
!live/answers/
!live/archive/
!live/inbox/
!live/text/
!live/state.json
!live/turns.jsonl
!live/jobs.jsonl
