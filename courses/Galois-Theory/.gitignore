# Kept deliberately minimal. Atlas's root .gitignore decides most of what this
# workspace carries — it is the one that refuses the set text, the chapter
# excerpts cut from it, and anything a command regenerates — and this file adds
# only the live board's allowlist on top of it.

__pycache__
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.*.swp

# live tutoring board (Tutor-Board) — runtime state stays local; the lesson
# transcript (cards, turns, ink, answers, archive) is tracked, so a lecture is
# the same whichever machine it is picked up on.
live/*
!live/cards/
!live/slate/
!live/answers/
!live/archive/
!live/inbox/
!live/text/
!live/state.json
!live/turns.jsonl
