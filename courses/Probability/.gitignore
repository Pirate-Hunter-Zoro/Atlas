# Kept deliberately minimal: this matches the ignore set used in
# Research-Journey. Nothing else is ignored — build products, compiled PDFs,
# editor state and course material are all tracked.

__pycache__
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.*.swp

# live tutoring board (Tutor-Board) — runtime state stays local; the lesson
# transcript (cards, turns, ink, answers, archive) is tracked, so a lecture is
# the same whichever machine it is picked up on.
live/*
!live/cards/
!live/slate/
!live/answers/
!live/archive/
!live/state.json
!live/turns.jsonl
