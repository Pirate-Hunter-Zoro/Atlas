# Kept deliberately minimal: this matches the ignore set used in
# Research-Journey. Build products, compiled PDFs, editor state and the work
# written in here are tracked.
#
# What is NOT tracked is what somebody else wrote — the textbook, its chapter
# excerpts, the professor's module slides and the assignment sheets. Those
# rules live in the ROOT .gitignore, with the other categories of other
# people's work, so a second course gets them without writing them again.

__pycache__
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.*.swp

# live tutoring board (Tutor-Board) — runtime state stays local; the lesson
# transcript (cards, turns, ink, answers, archive) is tracked, so a lecture is
# the same whichever machine it is picked up on.
live/*
!live/cards/
!live/slate/
!live/answers/
!live/archive/
!live/inbox/
!live/text/
!live/state.json
!live/turns.jsonl
