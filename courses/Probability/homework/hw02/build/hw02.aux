\@writefile{toc}{\contentsline {paragraph}{(i) $\Var  (cX) = c^{2}\Var  (X)$.}{1}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(ii) $\Cov  (cX,Y) = c\,\Cov  (X,Y)$.}{1}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(iii) $\Cov  (X+Y,Z) = \Cov  (X,Z) + \Cov  (Y,Z)$.}{2}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(a) $P\{\text  {a record occurs at time } n\} = 1/n$.}{4}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Check at $n = 2$, by integration.}{4}{section*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(b) $\mathbb  {E}[\text  {number of records by time } n] = \DOTSB \sum@ \slimits@ _{i=1}^{n} 1/i$.}{4}{section*.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(c) $\Var  (\text  {number of records by time } n) = \DOTSB \sum@ \slimits@ _{i=1}^{n} (i-1)/i^2$.}{5}{section*.7}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(d) $N = \min \{n : n > 1 \text  { and a record occurs at time } n\}$ has $\mathbb  {E}[N] = \infty $.}{5}{section*.8}\protected@file@percent }
