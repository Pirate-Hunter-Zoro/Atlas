      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x1", ",", 
        RowBox[{"-", "0.2"}], ",", "0.2"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x2", ",", 
        RowBox[{"-", "0.4"}], ",", "0.4"}], "}"}], ",", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Angle Clockwise from Vertical\>\"", ",", 
         "\"\<Angular Velocity\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PointSize", "[", ".04", "]"}], ",", "Red", ",", 
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], "]"}]}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.39835882485*^9, 3.398358870642*^9}, {
  3.3983589354040003`*^9, 3.398358948844*^9}, {3.4647138069132743`*^9, 
  3.4647138113038993`*^9}},
 CellLabel->
  "In[1341]:=",ExpressionUUID->"0881f6f9-350c-44b3-96db-8ce8fa0e51ea"],

Cell[TextData[{
 "Find a specific solution with the pendulum just beyond the equilibrium \
point with initial conditions:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t\t", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]", "[", "0", "]"}], " ", "=", " ", ".1"}], "\n", 
     "\t\t", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], " ", "=", " ", ".2"}]}]}], 
   TraditionalForm]],ExpressionUUID->"745d8190-8260-40d8-a18f-50ec42b4553a"]
}], "Text",
 CellChangeTimes->{{3.398356659646*^9, 
  3.3983566735*^9}},ExpressionUUID->"d1eed06b-6609-4c57-b4a0-a95c5cd2f1ea"],

Cell[BoxData[
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"f1", "[", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], ",", 
         RowBox[{"x2", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"f2", "[", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], ",", 
         RowBox[{"x2", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "==", ".1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", "[", "0", "]"}], "==", ".2"}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
      RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.398355220526*^9, 3.398355231617*^9}},
 CellLabel->
  "In[1342]:=",ExpressionUUID->"6a28b3b5-e4d0-4bad-bc28-1143c7090b93"],

Cell[BoxData[
 RowBox[{"solnRules", "=", 
  RowBox[{"Flatten", "[", "solnRules", "]"}]}]], "Input",
 CellLabel->
  "In[1343]:=",ExpressionUUID->"bc35e634-1aff-451e-b0b5-b1cc5112ca33"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x1New", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x1", "[", "t", "]"}], "/.", "solnRules"}]}]], "Input",
 CellLabel->
  "In[1344]:=",ExpressionUUID->"8cda50a6-f8c2-4f79-b01e-0f387a5d6bd2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x2New", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x2", "[", "t", "]"}], "/.", "solnRules"}]}]], "Input",
 CellLabel->
  "In[1345]:=",ExpressionUUID->"970d4c6c-0ced-47f5-95cf-c5f5081f167d"],

Cell["\<\
Generate the parametric plot of the solution in the phase plane:\
\>", "Text",ExpressionUUID->"52a4e42d-56c8-4e54-86b0-2b158f165f7a"],

Cell[BoxData[
 RowBox[{"graph9", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
