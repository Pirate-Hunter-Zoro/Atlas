Cell["\<\
As expected, if we start the nonlinear system to far away from the \
equilibrium point ( which is located at the origin within the phase plane), \
then the solution will not converge to the origin.\
\>", "Text",ExpressionUUID->"e1e4ac4e-d06a-474b-a73c-481b1e9227cf"],

Cell["Next, zoom in closer to the equilibrium point.", "Text",ExpressionUUID->"070a40e7-04f3-412c-8560-dce99c3a2c52"],

Cell[BoxData[
 RowBox[{"graph2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f1", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}], ",", 
        RowBox[{"f2", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x1", ",", 
        RowBox[{"-", "0.2"}], ",", "0.2"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x2", ",", 
        RowBox[{"-", "0.4"}], ",", "0.4"}], "}"}], ",", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Angle Clockwise from Vertical\>\"", ",", 
         "\"\<Angular Velocity\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PointSize", "[", ".04", "]"}], ",", "Red", ",", 
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], "]"}]}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.398357437741*^9, 3.398357495453*^9}, {
  3.3983575396289997`*^9, 3.3983575516*^9}, {3.4647128290226493`*^9, 
  3.4647128335695243`*^9}},
 CellLabel->
  "In[1290]:=",ExpressionUUID->"0fe8495f-3656-4925-af58-1d9f2e55635f"],

Cell["\<\
As expected, having the pendulum start close to the equilibrium point, the \
system is asymptotically stable.
(However, for different values of the physical constants, the system may not \
be stable.)
\
\>", "Text",ExpressionUUID->"d57687a2-4202-4219-b590-92e50ef332be"],

Cell["\<\
Next, find the solution orbit to this problem (using the above physical \
constants) when the initial angle and initial \"velocity\" are chosen to be:  
\t \[Theta] [0]  = .1 
\t \[Theta] '[0] = .2 \
\>", "Text",ExpressionUUID->"b4818fef-eadb-43b3-9eb7-c507befb9383"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x1", ",", "x2"}], "]"}]], "InputOnly",
 CellLabel->
  "In[1291]:=",ExpressionUUID->"c536ba4f-3f0c-4693-be7b-e80194c01a06"],

Cell[BoxData[
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"f1", "[", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], ",", 
         RowBox[{"x2", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"f2", "[", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], ",", 
         RowBox[{"x2", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "==", ".1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", "[", "0", "]"}], "==", ".2"}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
      RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.398355140724*^9, 3.3983551532539997`*^9}},
 CellLabel->
  "In[1292]:=",ExpressionUUID->"c48a1071-e304-4f50-9963-0ffacdd655e7"],

Cell[BoxData[
 RowBox[{"solnRules", "=", 
  RowBox[{"Flatten", "[", "solnRules", "]"}]}]], "Input",
 CellLabel->
  "In[1293]:=",ExpressionUUID->"497c91af-2940-47c0-a121-6c9b28704cee"],

Cell["Extract the coordinate functions from the replace the rules:", "Text",ExpressionUUID->"7e0db849-2ca2-4998-a469-ca61b58ef59d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x1New", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x1", "[", "t", "]"}], "/.", "solnRules"}]}]], "Input",
 CellLabel->
  "In[1294]:=",ExpressionUUID->"59b52eb0-ada3-444c-84af-4a84db66f306"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x2New", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x2", "[", "t", "]"}], "/.", "solnRules"}]}]], "Input",
 CellLabel->
  "In[1295]:=",ExpressionUUID->"4725a15a-6b43-47db-8907-bbd39f619e86"],

Cell[BoxData[
 RowBox[{"graph3", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1New", "[", "t", "]"}], ",", 
      RowBox[{"x2New", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"Thickness", "[", ".01", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.4647128897726493`*^9, 3.4647128908351493`*^9}},
 CellLabel->
  "In[1296]:=",ExpressionUUID->"dc301a59-8e93-4d5b-92e0-de426d170d09"],

Cell["\<\
Observe that the solution corresponding to the motion of the pendulum moves \
clockwise within the phase plane.  Therefore, the solution orbit approaches \
the equilibrium point and the equilibrium point will therefore be \
asymptotically stable.

Next, look at the solution orbit superimposed on the vector field:\
\>", "Text",ExpressionUUID->"39844d54-74f3-4f0b-9f40-3d419bb83487"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph1", ",", "graph3"}], "]"}]], "Input",
 CellLabel->
  "In[1297]:=",ExpressionUUID->"b99adaf9-6a2a-4332-b8e5-d133ae9f9152"],

Cell["\<\
Observe that the solution starts close enough to the equilibrium point so \
that it converges to the correct equilibrium point.

Next, zoom in:\
\>", "Text",ExpressionUUID->"07715e0c-1ebe-4823-b976-2f1b7bf93106"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph2", ",", "graph3"}], "]"}]], "Input",
 CellLabel->
  "In[1298]:=",ExpressionUUID->"d8b11bf0-4425-4294-8656-306817f20382"],

Cell["\<\
Observe that this equilibrium point of the nonlinear equation is \
asymptotically stable.\
\>", "Text",ExpressionUUID->"dd01e4e1-2115-4343-8478-6f3ba83e2801"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" The Motion Of The Pendulum Base", "Section",ExpressionUUID->"a4555f52-ba71-40bc-8ee3-da10766127fb"],

Cell[TextData[{
 "We assume that current measurements of angle (\[Theta]) and \"velocity\" (\
\[Theta]') are available, and that our feedback results in supplying a \
sufficient force in the x direction to produce the acceleration x''.  We will \
assume that the device that produces this x-acceleration responds in a linear \
fashion to these two input variables:\n\n\t\tx'' = c1 \[Theta] + c2 \[Theta]' \
\n\t\t    = c1 x1  +  c2 x2\n\t    \nWe have found solutions for x1[t] and \
x2[t].  It is now possible to use those solutions to determine the motion of \
the ",
 StyleBox["base",
  FontVariations->{"Underline"->True}],
 " of the pendulum required to produce the feedback.  Initial conditions are \
required for the ",
 StyleBox["base",
  FontVariations->{"Underline"->True}],
 " of the pendulum.  We will assume that at t = 0 the base of the pendulum \
starts at position zero with zero velocity:\n \n\t \tx[0] = 0\n\t \tx'[t] = 0\
\n \t\nBecause we are interested in both the position (i.e. x[t]) and the \
velocity (i.e. v[t]) of the base, the ODE system and initial conditions for \
the base of the pendulum become:\n \n\t \tx'[t] = v[t]\n\t \tv'[t] = x''[t] \n\
\t \t      = c1 x1[t]  +  c2 x2[t]\n \t\n\t \tx[0] = 0\n\t \tv[0] = 0\n \t    "
}], "Text",
 CellChangeTimes->{{3.398356619251*^9, 
  3.398356638079*^9}},ExpressionUUID->"53e57953-252a-4854-8de0-22545c4510eb"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "v"}], "]"}]], "InputOnly",
 CellLabel->
  "In[1299]:=",ExpressionUUID->"f8b76fa4-4307-4a6c-9f26-6cae7fbb3d1f"],

Cell[BoxData[
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"v", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["v", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"c1", " ", 
         RowBox[{"x1New", "[", "t", "]"}]}], "+", 
        RowBox[{"c2", " ", 
         RowBox[{"x2New", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "0."}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"v", "[", "0", "]"}], "==", "0."}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", 
      RowBox[{"v", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.398355162868*^9, 3.398355167757*^9}, {
  3.3983576631940002`*^9, 3.398357666289*^9}, {3.398358125185*^9, 
  3.398358125322*^9}, {3.398358324024*^9, 3.398358324415*^9}},
 CellLabel->
  "In[1300]:=",ExpressionUUID->"46c72856-cc1e-48be-8685-1b112144c627"],

Cell["\<\
Extract the position and velocity functions for the motion of the base of the \
pendulum:\
\>", "Text",ExpressionUUID->"112111b9-35d1-4d10-946b-7dd6e91df86b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xNew", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellLabel->
  "In[1301]:=",ExpressionUUID->"8a65b10a-8386-4853-8a9f-4fd268becf1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vNew", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"v", "[", "t", "]"}], "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellLabel->
  "In[1302]:=",ExpressionUUID->"41f8bb61-d137-485f-928a-d7d203ad47f1"],

Cell["\<\
Plot the feedback control motion required to stabilize the motion of the \
pendulum:\
\>", "Text",ExpressionUUID->"66ecd53e-6ab6-4e0b-a072-f2ee93cafe10"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"xNew", "[", "t", "]"}], ",", 
     RowBox[{"vNew", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".007", "]"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Epilog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Text", "[", 
       RowBox[{"\"\<Base Position= x[t]\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "18"}], "}"}]}], "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<Base Velocity= v[t]\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3983576993380003`*^9, 3.398357716559*^9}},
 CellLabel->
  "In[1303]:=",ExpressionUUID->"470af917-3464-4f1e-adb0-e7ff507981c6"],

Cell["\<\
Observe that the resulting control produces a positive velocity (i.e. from \
left to right) which eventually approaches a constant positive value of \
approximately 2.  As a result, the position continues to increase at almost a \
constant rate.\
\>", "Text",ExpressionUUID->"aafb3489-d930-421b-8add-ac9f222fd7f9"],

Cell[CellGroupData[{

Cell["\<\
Remove the uniform velocity component from the motion of the pendulum base\
\>", "Subsubsection",ExpressionUUID->"32d5259a-7fa5-4f7c-aa18-e7c6b2d874b8"],

Cell["\<\
If we attempt to generate a graph of the pendulum motion, then the left to \
right motion for the base of the pendulum would dominate the appearance of \
the graph.  Therefore, it seems desirable to remove any uniform motion from \
the base of the pendulum so that the oscillations produced by the feedback \
control predominate.  Remember, the feedback control is designed only to \
stabilize the pendulum in the vertical position and not to control any motion \
for the base of the pendulum.  This can be accomplished quite simply by using \
the following procedure:
\t 1: Calculate the average velocity for the base of the pendulum
\t 2: Calculate the position of the base with the average velocity removed
\t 3: Generate the corresponding graphs\t

Calculate the average velocity for the base of the pendulum.
First, generate a list of 1000 equally spaced velocity values:\
\>", "Text",ExpressionUUID->"9a8e19b2-59ea-451a-933d-a3e8c8c6edc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vData", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vNew", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10", ",", ".01"}], "}"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}]], "InputOnly",
 CellChangeTimes->{{3.39835774169*^9, 3.3983577540150003`*^9}},
 CellLabel->
  "In[1304]:=",ExpressionUUID->"808c0059-a39c-400f-8b28-93fde8c17ab1"],

Cell["Calculate the average value for this list:", "Text",ExpressionUUID->"58749d97-1b13-475f-8a46-f3e9b9a7d509"],

Cell[BoxData[
 RowBox[{"vAverage", "=", 
  FractionBox[
   RowBox[{"Apply", "[", 
    RowBox[{"Plus", ",", "vData"}], "]"}], 
   RowBox[{"Length", "[", "vData", "]"}]]}]], "Input",
 CellLabel->
  "In[1305]:=",ExpressionUUID->"fff5e6a6-2a7e-4f85-a5c8-94d58ba6e6e2"],

Cell["or more simply:", "Text",
 CellChangeTimes->{{3.398357792922*^9, 
  3.398357804092*^9}},ExpressionUUID->"76928e13-0d8d-4e3d-80e0-f64817168b66"],

Cell[BoxData[
 RowBox[{"vAverage", "=", 
  RowBox[{"Mean", "[", "vData", "]"}]}]], "Input",
 CellChangeTimes->{{3.3983578189639997`*^9, 3.398357831677*^9}},
 CellLabel->
  "In[1306]:=",ExpressionUUID->"6bfc9f5c-3ebf-4103-b422-5d1c6296192b"],

Cell["\<\
Subtract the average velocity from our original velocity function:\
\>", "Text",ExpressionUUID->"21139302-6d4c-45d8-9f63-1d850ea3703c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vAvg", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"vNew", "[", "t", "]"}], "-", "vAverage"}]}]], "Input",
 CellLabel->
  "In[1307]:=",ExpressionUUID->"65c01959-ca89-4ffd-9d54-37b503944bdd"],

Cell["\<\
Calculate the corresponding position for the base of the pendulum using this \
average velocity:\
\>", "Text",ExpressionUUID->"e88818dc-624d-4d63-8495-5e7bcfbd8343"],

Cell[BoxData[
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["xAvg", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"vAvg", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xAvg", "[", "0", "]"}], "==", "0."}]}], "\[IndentingNewLine]",
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"xAvg", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3983551774849997`*^9, 3.3983551852980003`*^9}, {
  3.398358102368*^9, 3.398358102612*^9}, {3.3983583625109997`*^9, 
  3.3983583628450003`*^9}},
 CellLabel->
  "In[1308]:=",ExpressionUUID->"0caae6af-58d5-4ff2-bfcb-35186b6c690d"],

Cell["\<\
Extract the \"average\" position function for the motion of the base of the \
pendulum:\
\>", "Text",ExpressionUUID->"61cbdb26-2c75-462e-9264-6ce60adbb4fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xAvgNew", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"xAvg", "[", "t", "]"}], "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellLabel->
  "In[1309]:=",ExpressionUUID->"4c23aa08-9b8d-4385-b3c6-ddb581a1f55a"],

Cell["\<\
Plot the modified velocity and modified position for the motion of the base \
of the pendulum:\
\>", "Text",ExpressionUUID->"333b4af5-32e2-4985-8362-e05a3aecbedf"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"xAvgNew", "[", "t", "]"}], ",", 
     RowBox[{"vAvg", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".007", "]"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Epilog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Text", "[", 
       RowBox[{"\"\<Base Position= x[t]\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1.5"}], "}"}]}], "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<Base Velocity= v[t]\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"2.3", ",", "2.2"}], "}"}]}], "]"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.398357956608*^9, 3.398357988801*^9}, 3.398358028414*^9},
 CellLabel->
  "In[1310]:=",ExpressionUUID->"1de92268-10b6-486b-8992-ce3036bd467c"],

Cell["\<\
The above graph clearly indicates that once the constant motion component of \
the solution is removed, then the oscillations of the pendulum approach \
equilibrium.\
\>", "Text",ExpressionUUID->"18c060cd-290a-4165-93b4-8d374b6b2550"]
}, Closed]],

Cell[CellGroupData[{

Cell["Animate the feedback control to the base of the pendulum", \
"Subsubsection",ExpressionUUID->"c9b96a2f-b238-4f20-8686-f32a8d9030b2"],

Cell["\<\
The graphic utility that we created earlier to display the appearance of a \
pendulum can be used to animate our feedback control problem.  The only \
modification that is required is to adjust the 0 position for the angle of \
the pendulum from straight down to straight up and to change the positive \
direction from counter-clockwise to clockwise:\
\>", "Text",ExpressionUUID->"53705545-7175-4043-b198-8b37f4900204"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"pendulumBase", "[", 
    RowBox[{
     RowBox[{"\[Pi]", "-", 
      RowBox[{"x1New", "[", "t", "]"}]}], ",", 
     RowBox[{"xAvgNew", "[", "t", "]"}], ",", "L"}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "7"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.398358061759*^9, 3.398358071682*^9}, {
  3.3986799128885927`*^9, 3.398679951747222*^9}},
 CellLabel->
  "In[1311]:=",ExpressionUUID->"77a94bb5-beff-4720-8989-e0dd2aac135c"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" Example: With No Damping But With Controlling Feedback", "Section",ExpressionUUID->"388cab72-9278-4ad3-ba48-bbddb33fcc6e"],

Cell["\<\
Recall that positive frictional damping increases the stability of a system.  \
As an example, consider the case with exactly the same feedback control, but \
with no damping from friction.\
\>", "Text",ExpressionUUID->"a5f9a66a-07c1-4748-affb-93d53563ca24"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x1", ",", "x2"}], "]"}]], "InputOnly",
 CellLabel->
  "In[1312]:=",ExpressionUUID->"3fece406-4bff-4d5b-8fad-c7db98ef1d43"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", "32.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"k1", "=", "0"}], ";"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{
    StyleBox["No",
     FontVariations->{"Underline"->True}], " ", "Friction", " ", "Damping"}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c1", "=", "50"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Same", " ", "Feedback", " ", "Control"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c2", "=", "1"}], ";"}], "     ", 
  RowBox[{"(*", " ", 
   RowBox[{"Same", " ", "Feedback", " ", "Control"}], " ", "*)"}], 
  "  "}]}], "InputOnly",
 CellChangeTimes->{3.398358421039*^9},
 CellLabel->
  "In[1313]:=",ExpressionUUID->"820682e8-fc64-4731-bc8c-f9429ad27b5c"],

Cell["As before, look at the linearized form of the ODE system:", "Text",ExpressionUUID->"7f24dd11-38cb-4875-8ae0-7d0bd74ebb59"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "   ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", " ", "\[Rule]", " ", "0"}], ",", 
     RowBox[{"x2", " ", "\[Rule]", " ", "0"}]}], "}"}]}], "   ", "//", 
  "MatrixForm"}]], "Input",
 CellLabel->
  "In[1319]:=",ExpressionUUID->"bfbfc7cd-1f2b-4d61-a0ee-47c61b8ab3be"],

Cell["\<\
Examine the eigenvalues of the linearized system for stability:\
\>", "Text",ExpressionUUID->"bd6c48ad-739b-403a-b997-3cb9926e4450"],

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"Eigenvalues", "[", 
   RowBox[{"A", "/.", "\[InvisibleSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "\[Rule]", "0"}], ",", 
      RowBox[{"x2", "\[Rule]", "0"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[1320]:=",ExpressionUUID->"907893fa-b98c-4a8b-87c7-3da2536c1ea5"],

Cell["\<\
Observe that the real parts of the eigenvalues of the corresponding linear \
system are negative, and therefore the equilibrium point for the nonlinear \
pendulum problem will be asymptotically stable (however not as stable as in \
the previous example):
\t-0.166667 = Real part of eigenvalues without viscous damping
\t-0.216667 = Real part of eigenvalues with viscous damping
\t\
\>", "Text",ExpressionUUID->"c5ef1fe9-eb18-45da-9632-c4259ba21e79"],

Cell["Look at the new vector field:", "Text",ExpressionUUID->"bceb5407-2cac-4320-ab54-fb984ee5d609"],

Cell[BoxData[
 RowBox[{"graph4", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f1", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}], ",", 
        RowBox[{"f2", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x1", ",", 
        RowBox[{"-", 
         FractionBox["\[Pi]", "2"]}], ",", 
        FractionBox["\[Pi]", "2"]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x2", ",", 
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameTicks", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["\[Pi]", "2"]}], ",", "0", ",", 
           FractionBox["\[Pi]", "2"]}], "}"}], ",", "Automatic", ",", "None", 
         ",", "None"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Angle Clockwise from Vertical\>\"", ",", 
         "\"\<Angular Velocity\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PointSize", "[", ".04", "]"}], ",", "Red", ",", 
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], "]"}]}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.398358461237*^9, 3.3983585062209997`*^9}, {
  3.398358546666*^9, 3.398358565318*^9}, {3.4647131657257743`*^9, 
  3.4647131706320243`*^9}},
 CellLabel->
  "In[1321]:=",ExpressionUUID->"47634c49-a485-46ee-ba21-7e43e1a37b54"],

Cell["Zoom in:", "Text",ExpressionUUID->"7fb3170d-3ca6-42a0-b028-3a00ac4e697a"],

Cell[BoxData[
 RowBox[{"graph5", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f1", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}], ",", 
        RowBox[{"f2", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x1", ",", 
        RowBox[{"-", "0.2"}], ",", "0.2"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x2", ",", 
        RowBox[{"-", "0.4"}], ",", "0.4"}], "}"}], ",", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Angle Clockwise from Vertical\>\"", ",", 
         "\"\<Angular Velocity\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PointSize", "[", ".04", "]"}], ",", "Red", ",", 
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], "]"}]}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.398358582691*^9, 3.398358660092*^9}, {
  3.4647131806320243`*^9, 3.4647131842413993`*^9}},
 CellLabel->
  "In[1322]:=",ExpressionUUID->"9a9a4714-6ce0-47f1-9d00-c8cecf7fe551"],

Cell[TextData[{
 "Find the new solution corresponding to the case of no viscous damping \
starting with initial conditions:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t\t", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]", "[", "0", "]"}], " ", "=", " ", ".1"}], "\n", 
     "\t\t", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], " ", "=", " ", ".2"}]}]}], 
   TraditionalForm]],ExpressionUUID->"b6c213d0-2a4d-4d3f-8312-67bd42a0123a"]
}], "Text",
 CellChangeTimes->{{3.3983566506549997`*^9, 3.398356651744*^9}, {
  3.39835668476*^9, 
  3.39835668983*^9}},ExpressionUUID->"62e1e882-4a2b-4537-a6f8-7e2602e4d788"],

Cell[BoxData[
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"f1", "[", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], ",", 
         RowBox[{"x2", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"f2", "[", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], ",", 
         RowBox[{"x2", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "==", ".1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", "[", "0", "]"}], "==", ".2"}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
      RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3983551983120003`*^9, 3.398355210054*^9}},
 CellLabel->
  "In[1323]:=",ExpressionUUID->"0ed963f3-0b96-4054-9e83-0e0b5849840c"],

Cell[BoxData[
 RowBox[{"solnRules", "=", 
  RowBox[{"Flatten", "[", "solnRules", "]"}]}]], "Input",
 CellLabel->
  "In[1324]:=",ExpressionUUID->"2acf7f6f-d893-443d-a6b8-c69bb776944d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x1New", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x1", "[", "t", "]"}], "/.", "solnRules"}]}]], "Input",
 CellLabel->
  "In[1325]:=",ExpressionUUID->"29fd80ed-b105-4a8b-ab84-c049e0d53055"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x2New", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x2", "[", "t", "]"}], "/.", "solnRules"}]}]], "Input",
 CellLabel->
  "In[1326]:=",ExpressionUUID->"cc37557e-4567-4c23-a12f-fa113cc1f9e1"],

Cell[BoxData[
 RowBox[{"graph6", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1New", "[", "t", "]"}], ",", 
      RowBox[{"x2New", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thickness", "[", ".01", "]"}], ",", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "]"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.4647132023038993`*^9, 3.4647132043820243`*^9}},
 CellLabel->
  "In[1327]:=",ExpressionUUID->"626d4ac3-87ef-47e0-aaad-a95b09105f15"],

Cell["\<\
Show both the vector field and the specific solution corresponding to the \
case of no viscous damping:\
\>", "Text",ExpressionUUID->"8c2daf9d-b586-450f-927b-1926b560ba68"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph5", ",", " ", "graph6"}], "]"}]], "Input",
 CellLabel->
  "In[1328]:=",ExpressionUUID->"668d95b6-1e5c-415b-a832-311c6fa75de3"],

Cell["\<\
Next, compare the new solution without viscous damping (less stable) to the \
earlier solution with viscous damping.  The new solution is further from the \
origin than the solution which has damping.\
\>", "Text",ExpressionUUID->"acb6f12d-dd2e-47ec-87ba-119dd01ee1c3"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph6", ",", "graph3"}], "]"}]], "Input",
 CellLabel->
  "In[1329]:=",ExpressionUUID->"c1b631be-9c0c-476b-9a3a-f0ff0c6f924f"],

Cell[TextData[{
 "This is exactly the result that we expect!\n\nIt is easy to animate the \
specific case (",
 StyleBox["remember",
  FontVariations->{"Underline"->True}],
 ", feedback control gives the base motion):"
}], "Text",
 CellChangeTimes->{{3.4647136897882743`*^9, 
  3.4647137054288993`*^9}},ExpressionUUID->"c11c2d53-059a-4718-8a85-\
53aaf475e30c"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"pendulumBase", "[", 
    RowBox[{
     RowBox[{"\[Pi]", "-", 
      RowBox[{"x1New", "[", "t", "]"}]}], ",", 
     RowBox[{"xAvgNew", "[", "t", "]"}], ",", "L"}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "7"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3983596253719997`*^9, 3.398359633901*^9}, {
   3.398359670983*^9, 3.3983596796879997`*^9}, {3.39835982985*^9, 
   3.3983599242790003`*^9}, 3.3986800133241644`*^9, {3.398680069198347*^9, 
   3.3986800767764235`*^9}, {3.4647133374601493`*^9, 3.4647133611476493`*^9}, 
   3.4647136686788993`*^9},
 CellLabel->
  "In[1330]:=",ExpressionUUID->"6e65ba3a-10b2-4924-a252-e1ab622cb1e1"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Example: With No Damping And No Feedback Control", "Section",ExpressionUUID->"d5e6c771-5973-4669-984f-32f88049dc80"],

Cell["\<\
Recall that if the two constants (c1 = 0;c2 = 0;) then the feedback \
acceleration x ''[t] is always 0 (no feedback control).  We expect that with \
no feedback control and no damping that the system will be unstable for this \
particular equilibrium point (pendulum positioned vertically upward).\
\>", "Text",ExpressionUUID->"3533ea5e-51f4-45c0-adbb-1d10886a697f"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x1", ",", "x2"}], "]"}]], "InputOnly",
 CellLabel->
  "In[1331]:=",ExpressionUUID->"f6a373ad-f157-4d68-8781-ecf7fbe70a86"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", "32.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"k1", "=", "0"}], ";"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"No", " ", "Viscous", " ", "Damping"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c1", "=", "0"}], ";"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"No", " ", "Feedback", " ", "Control"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c2", "=", "0"}], ";"}], "     ", 
  RowBox[{"(*", " ", 
   RowBox[{"No", " ", "Feedback", " ", "Control"}], " ", 
   "*)"}]}]}], "InputOnly",
 CellChangeTimes->{3.398358726574*^9},
 CellLabel->
  "In[1332]:=",ExpressionUUID->"acd1c1a1-31e1-48db-9f88-e782ebd2d763"],

Cell["\<\
The coefficient matrix for the corresponding linear system is:\
\>", "Text",ExpressionUUID->"13ed0cf4-8cf1-4e62-b0ab-eebff30d3222"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", " ", "\[Rule]", " ", "0"}], ",", 
     RowBox[{"x2", " ", "\[Rule]", " ", "0"}]}], "}"}]}], "  ", "//", 
  "MatrixForm"}]], "Input",
 CellLabel->
  "In[1338]:=",ExpressionUUID->"f4e064f4-2751-4782-8576-f5a755258221"],

Cell["The corresponding eigenvalues of the linear system are:", "Text",ExpressionUUID->"2d7897b4-ab4a-4d43-a966-5b5ffb73e29e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Eigenvalues", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"A", "/.", "\[InvisibleSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "\[Rule]", "0"}], ",", 
      RowBox[{"x2", "\[Rule]", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.398358743053*^9, 3.398358759686*^9}},
 CellLabel->
  "In[1339]:=",ExpressionUUID->"e99d2589-b8cd-4692-afb5-e05f7603bae1"],

Cell["\<\
As expected, one of the eigenvalues is positive (unstable) for the linearized \
system.
\
\>", "Text",ExpressionUUID->"4064b741-b62a-442d-b5a8-8d7789fd92a1"],

Cell["\<\
Look at the vector field for the corresponding nonlinear system:\
\>", "Text",ExpressionUUID->"3d083e64-a28d-4e87-a55c-8f06e97c7fd8"],

Cell[BoxData[
 RowBox[{"graph7", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f1", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}], ",", 
        RowBox[{"f2", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x1", ",", 
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x2", ",", 
        RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameTicks", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "\[Pi]"}], ",", 
           RowBox[{"-", 
            FractionBox["\[Pi]", "2"]}], ",", "0", ",", 
           FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], "}"}], ",", "Automatic",
          ",", "None", ",", "None"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Angle Clockwise from Vertical\>\"", ",", 
         "\"\<Angular Velocity\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PointSize", "[", ".04", "]"}], ",", "Red", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", " ", "\[Pi]"}], ",", "0"}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.398358769434*^9, 3.398358812583*^9}, {3.398358903729*^9,
   3.398358915023*^9}, {3.398359255639*^9, 3.398359317545*^9}, {
  3.4647134593820243`*^9, 3.4647134658976493`*^9}},
 CellLabel->
  "In[1340]:=",ExpressionUUID->"f7e6da30-72c2-4627-aef4-04b38847bb11"],

Cell["Zoom in:", "Text",ExpressionUUID->"8957aced-3cf3-43a5-8ea7-9e090677b88e"],

Cell[BoxData[
 RowBox[{"graph8", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
