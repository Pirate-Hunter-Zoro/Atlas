Cell[TextData[{
 "For these specific physical constants (with no feedback control), the \
linearized system is predicted to be asymptotically ",
 StyleBox["unstable",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " and therefore the nonlinear system can ",
 StyleBox["not",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " be predicted to be asymptotically stable.\n\nThe corresponding vector \
field is:"
}], "Text",
