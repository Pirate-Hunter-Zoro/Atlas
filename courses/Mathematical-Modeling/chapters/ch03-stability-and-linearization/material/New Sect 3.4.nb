    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thickness", "[", ".01", "]"}], ",", "Magenta"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{
  3.398359018448*^9, {3.3983590488269997`*^9, 3.398359049297*^9}, {
   3.398359199422*^9, 3.398359201466*^9}, {3.4647138462882743`*^9, 
   3.4647138581632743`*^9}},
 CellLabel->
  "In[1346]:=",ExpressionUUID->"5cbff43b-c8d4-4a4c-8fe5-497ae9780135"],

Cell["\<\
Superimpose the current solution (with no feedback control) along with the \
previous solution (which has feedback control).\
\>", "Text",ExpressionUUID->"e09c61f8-ed1b-41dd-ad3d-b4e477787ef4"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph6", ",", "graph9", ",", 
   RowBox[{"PlotRange", " ", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.398359056666*^9, 3.398359057769*^9}},
 CellLabel->
  "In[1347]:=",ExpressionUUID->"9d5b9531-538c-4693-90a5-9db8d6cbd32a"],

Cell["\<\
What is going on here?  Look at our solution and the vector field:\
\>", "Text",ExpressionUUID->"a60e4361-b914-4053-a1e8-7fbf3ba8806f"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph7", ",", "graph6", ",", "graph9", ",", 
   RowBox[{"PlotRange", " ", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.398359065487*^9, 3.398359066174*^9}},
 CellLabel->
  "In[1348]:=",ExpressionUUID->"f66f878a-1807-4d85-b66a-0623caff6258"],

Cell["\<\
The solution is out of the range of our vector field.
Expand the vector field graph and try again:\
\>", "Text",ExpressionUUID->"522aeca1-e373-4240-8d17-2a8247f03e9b"],

Cell[BoxData[
 RowBox[{"graph10", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f1", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}], ",", 
        RowBox[{"f2", "[", 
         RowBox[{"x1", ",", "x2"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "0", ",", 
        RowBox[{"3", " ", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x2", ",", 
        RowBox[{"-", "12"}], ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameTicks", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           FractionBox["\[Pi]", "2"], ",", "\[Pi]", ",", 
           FractionBox[
            RowBox[{"3", " ", "\[Pi]"}], "2"], ",", 
           RowBox[{"2", " ", "\[Pi]"}], ",", 
           FractionBox[
            RowBox[{"5", " ", "\[Pi]"}], "2"], ",", 
           RowBox[{"3", " ", "\[Pi]"}]}], "}"}], ",", "Automatic", ",", 
         "None", ",", "None"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Angle Clockwise from Vertical\>\"", ",", 
         "\"\<Angular Velocity\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PointSize", "[", ".04", "]"}], ",", "Red", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", " ", "\[Pi]"}], ",", "0"}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3983590859040003`*^9, 3.398359125094*^9}, {
  3.398359437648*^9, 3.3983594665179996`*^9}, {3.4647134794913993`*^9, 
  3.4647134846632743`*^9}},
 CellLabel->
  "In[1349]:=",ExpressionUUID->"44887656-1693-43b3-9fbb-daaff7d7dfc2"],

Cell["\<\
Superimpose the vector field, the solution orbit without feedback control and \
the solution orbit with feedback control:\
\>", "Text",ExpressionUUID->"031f69c6-6859-4b44-9502-df2da9a45ccf"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph10", ",", "graph6", ",", "graph9", ",", 
   RowBox[{"PlotRange", " ", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.398359386981*^9, 3.398359387709*^9}},
 CellLabel->
  "In[1350]:=",ExpressionUUID->"6a1c042b-c8ec-4ec0-b568-aad5c20943cb"],

Cell["\<\
From this graph it is obvious that our solution is in a stable (but not \
asymptotically stable) orbit.  Notice that the solution never reaches the \
origin (vertical upward position).  Thus the pendulum oscillates left and \
right, but never has enough energy to go over the top.  \
\>", "Text",
 CellChangeTimes->{{3.4647141168820243`*^9, 
  3.4647141178820243`*^9}},ExpressionUUID->"e9a9c6f3-4a1a-4de6-b223-\
690d382892b9"],

Cell["\<\
It is easy to animate the specific case (remember, without feedback control \
the base has no motion):\
\>", "Text",
 CellChangeTimes->{{3.4647140455851493`*^9, 3.4647140463195243`*^9}, 
   3.4647141200070243`*^9},ExpressionUUID->"e5a59078-87f4-4682-b5aa-\
51a058b68578"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"pendulumBase", "[", 
    RowBox[{
     RowBox[{"\[Pi]", "-", 
      RowBox[{"x1New", "[", "t", "]"}]}], ",", "0", ",", "L"}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3983596253719997`*^9, 3.398359633901*^9}, {
  3.398359670983*^9, 3.3983596796879997`*^9}, {3.398359980524*^9, 
  3.3983599922209997`*^9}, {3.3986801633852444`*^9, 3.398680190817973*^9}, {
  3.4647141673351493`*^9, 3.4647142175070243`*^9}, {3.4647142672101493`*^9, 
  3.4647142784601493`*^9}},
 CellLabel->
  "In[1351]:=",ExpressionUUID->"43661229-9910-44f9-871f-cf226af35152"],

Cell[TextData[{
 "\nHowever, the vector field indicates that a ",
 StyleBox["small",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["increase",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " in energy should allow the solution to continue rotating past the \
equilibrium point over and over.  We can accomplish this by increasing the \
initial velocity (kinetic energy) that we release the pendulum with.  \
(Increase \"velocity\" \[Theta] '[0] = x2[0] = .4 (from .2))."
}], "Text",
 CellChangeTimes->{
  3.4647140608976493`*^9},ExpressionUUID->"915e5d5a-e813-4537-ac7e-\
2abd8245dd31"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x1", ",", "x2"}], "]"}]], "InputOnly",
 CellLabel->
  "In[1352]:=",ExpressionUUID->"2d06af09-f2c7-4c07-8db3-5141efd07500"],

Cell[BoxData[
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"f1", "[", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], ",", 
         RowBox[{"x2", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"f2", "[", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], ",", 
         RowBox[{"x2", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "==", ".1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", "[", "0", "]"}], "==", ".4"}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
      RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.398355241324*^9, 3.398355252538*^9}},
 CellLabel->
  "In[1353]:=",ExpressionUUID->"6e4d78b4-5715-43af-9ec2-51d466495b66"],

Cell[BoxData[
 RowBox[{"solnRules", "=", 
  RowBox[{"Flatten", "[", "solnRules", "]"}]}]], "Input",
 CellLabel->
  "In[1354]:=",ExpressionUUID->"4da44512-ff29-455c-bc99-045e19026378"],

Cell["Extract the solution function from the solution rules:", "Text",ExpressionUUID->"2169d254-0de6-4892-92e9-7f2fbeb5a4c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x1New", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x1", "[", "t", "]"}], "/.", "solnRules"}]}]], "Input",
 CellLabel->
  "In[1355]:=",ExpressionUUID->"ce764b68-baaa-40af-a7a0-7fdf1b9712d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x2New", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x2", "[", "t", "]"}], "/.", "solnRules"}]}]], "Input",
 CellLabel->
  "In[1356]:=",ExpressionUUID->"5ddf738f-8a5c-4cb3-b9c3-e81522dfde0f"],

Cell["\<\
Generate the parametric plot for the solution orbit within the phase plane:\
\>", "Text",ExpressionUUID->"86a4bc27-066b-4d27-b41b-5df9ee98b638"],

Cell[BoxData[
 RowBox[{"graph11", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1New", "[", "t", "]"}], ",", 
      RowBox[{"x2New", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thickness", "[", ".01", "]"}], ",", "Magenta"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{
  3.398359561054*^9, {3.4647134962101493`*^9, 3.4647135193038993`*^9}},
 CellLabel->
  "In[1357]:=",ExpressionUUID->"fb125258-2227-4b08-a42f-ce2589e26397"],

Cell["\<\
Cut the domain of the graph down and combine it with the vector field:\
\>", "Text",ExpressionUUID->"14662eba-09d0-4fec-870a-9fa6fe7d7a48"],

Cell[BoxData[
 RowBox[{"graph12", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1New", "[", "t", "]"}], ",", 
      RowBox[{"x2New", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "4.5"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thickness", "[", ".01", "]"}], ",", "Magenta"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{
  3.3983595882*^9, {3.4647139547413993`*^9, 3.4647139558663993`*^9}},
 CellLabel->
  "In[1358]:=",ExpressionUUID->"d4cb9252-234e-4d10-abc3-3b550815121c"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph10", ",", "graph12", ",", 
   RowBox[{"PlotRange", " ", "->", "All"}]}], "]"}]], "Input",
 CellLabel->
  "In[1359]:=",ExpressionUUID->"0e7df7e0-11f3-4f4e-b6db-de584966c49c"],

Cell["\<\
This is exactly the result that we expect!

It is easy to animate the specific case (remember, without feedback control \
the base has no motion):\
\>", "Text",ExpressionUUID->"df310d56-ee2a-4e92-ac3d-b9fdc34f4d32"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"pendulumBase", "[", 
