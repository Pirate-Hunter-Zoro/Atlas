   RowBox[{"k1", "=", ".1"}], ";"}], "      ", 
  RowBox[{"(*", " ", "Damping", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c1", "=", "50"}], ";"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{"Sufficient", " ", "Feedback", " ", "Control"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
