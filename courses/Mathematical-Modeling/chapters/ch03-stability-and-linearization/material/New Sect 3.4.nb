Notebook[{

Cell[CellGroupData[{
Cell[" Section 3.4", "Title",ExpressionUUID->"1a3679f6-7392-4d92-b222-4c1983732cf4"],

Cell[TextData[StyleBox["  Feedback Control Systems",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"1d5adb91-0552-46bb-a140-\
f349b836b557"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly",
 CellChangeTimes->{3.398354748067*^9},
 CellLabel->
  "In[1246]:=",ExpressionUUID->"ecc8e688-20d7-4af4-ac7d-975b94effb10"],

Cell[CellGroupData[{

Cell[" Introduction", "Section",ExpressionUUID->"2989db3d-5db5-47d6-b012-d5691d4cbaf6"],

Cell["\<\
Consider a pendulum positioned in the upright direction \[Theta] = \[Pi] \
(unstable equilibrium).  \
\>", "Text",ExpressionUUID->"cb2ce812-cde9-4797-9c5d-07d4dd860271"],

Cell["\<\
Construct a Module which will show the position of the pendulum (\[Theta] is \
measured from the downward position and xBase is measured from the origin):\
\>", "Text",ExpressionUUID->"9e96c5cf-6548-4e6e-8de9-d531ca09c404"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pendulumBase", "[", 
   RowBox[{"\[Theta]_", ",", "xBase_", ",", "L_"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "xyPoint", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xyPoint", "=", 
      RowBox[{
       RowBox[{"L", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{
            FractionBox[
             RowBox[{"3", " ", "\[Pi]"}], "2"], "+", "\[Theta]"}], "]"}], ",", 
          RowBox[{"Sin", "[", 
           RowBox[{
            FractionBox[
             RowBox[{"3", " ", "\[Pi]"}], "2"], "+", "\[Theta]"}], "]"}]}], 
         "}"}]}], "+", 
       RowBox[{"{", 
        RowBox[{"xBase", ",", "0"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".01", "]"}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xBase", ",", "0"}], "}"}], ",", "xyPoint"}], "}"}], 
           "]"}], ",", 
          RowBox[{"PointSize", "[", ".05", "]"}], ",", 
          RowBox[{"Point", "[", "xyPoint", "]"}]}], "}"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Axes", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"True", ",", "False"}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Ticks", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1.05"}], " ", "L"}], ",", 
            RowBox[{"1.05", " ", "L"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1.05"}], " ", "L"}], ",", 
            RowBox[{"1.05", " ", "L"}]}], "}"}]}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{3.39835529396*^9},
 CellLabel->
  "In[1247]:=",ExpressionUUID->"ace780ea-4496-41ef-9f86-0c962a3706a6"],

Cell["\<\
Display the graph of the pendulum for one angle corresponding to \[Theta] = \
\[Pi] and xBase = 0:\
\>", "Text",
 CellChangeTimes->{
  3.398354920282*^9},ExpressionUUID->"e77bb7d5-e6f8-41af-ba3f-8155993655e5"],

Cell[BoxData[
 RowBox[{"pendulumBase", " ", "[", 
  RowBox[{"\[Pi]", ",", "0", ",", "3"}], "]"}]], "Input",
 CellChangeTimes->{{3.398356761587*^9, 3.39835676176*^9}},
 CellLabel->
  "In[1248]:=",ExpressionUUID->"af4a08e0-cb94-472d-a56b-e1c7c8227044"],

Cell[TextData[{
 "In order to create a control problem (feedback), we will assume that the \
pivot point at the bottom of the pendulum rod can be moved laterally left and \
right in order to maintain the pendulum at the unstable equilibrium point \
(vertical position).  If we can create such a control problem, the combined \
problem (vertical pendulum and feedback control) should result in a stable \
system.\n\nThe following development is slightly different than the one in \
the book.\nExamine Fig. 3.7 for the force diagram on an inverted pendulum \
(this diagram is not completely correct).\n\n\tx = Position of the rod pivot \
(x-axis)\n\t\[Theta] = Angle measured clockwise from the ",
 StyleBox["vertical position",
  FontVariations->{"Underline"->True}],
 " (y-axis)\n\tk1 = Damping force coefficient\n\ts = Position of the pendulum \
mass\n\tm = Pendulum mass\n\n\tm s'' = m g Sin[\[Theta]] - k1 s' - m x'' Cos[\
\[Theta]]\n\ts = L \[Theta]\n\ts' = L \[Theta]'\n\ts'' = L \[Theta]''\n\n\tm \
L \[Theta]'' = m g Sin[\[Theta]] - k1 L \[Theta]' - m x'' Cos[\[Theta]]\n\t\n\
Convert the second-order ODE into a first-order system:\n\tx1 = \[Theta]\n\t\
x2 = \[Theta] '\n\n\tx1' = x2\n\tm L x2' = m g Sin[x1] - k1 L x2 - m x'' \
Cos[x1]\n\tx2' =  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["g", "L"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "0b20a6fe-02f1-4045-9590-c4d1c2871081"],
 " Sin[x1] - ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["k1", "m"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "9fd5550b-4d63-446d-bc74-40ef9bfd7790"],
 " x2 - ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["1", "L"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "4ef5c7b1-0a0d-428c-838d-95481fb22dec"],
 " x'' Cos[x1]\n\t\nThe damping term:   -",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["k1", "m"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "81fb0fc4-8332-4faa-9ae0-ef9cff126934"],
 " x2  is incomplete in this development.  Specifically, it ignores the \
velocity component in the x-direction (i.e. x').  The correct expression \
should be:   -( ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["k1", "m"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "36e699c6-786d-4e23-a307-fec228f8d56c"],
 " x2  +  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["k1", "mL"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b0984e77-2e21-426d-9556-b892cbcc1e66"],
 " x' )."
}], "Text",ExpressionUUID->"3b3d3f4c-eb09-469b-bc25-72b59090fa4b"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Example With Controlling Feedback", "Section",ExpressionUUID->"570fe9fe-72d4-4c0b-a149-5f1c1d973171"],

Cell[TextData[{
 "The second-order ODE:\n\t\tm L \[Theta]'' = m g Sin[\[Theta]] - k1 L \
\[Theta]' - m x'' Cos[\[Theta]]\nConverted into a first-order system:\n\t\t\
x1' = x2\n\t\tx2' =  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["g", "L"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "94e473a9-efbc-460c-93b2-5c4b8efee9d4"],
 " Sin[x1] - ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["k1", "m"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "a874c142-6884-4a71-b725-31118d810169"],
 " x2 - ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["1", "L"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "2e14f494-8595-4018-8489-9fedbeea258d"],
 " x'' Cos[x1],   \nwhere x'' represents the lateral acceleration of the \
pivot.\t"
}], "Text",
 CellChangeTimes->{{3.39835655805*^9, 
  3.398356581391*^9}},ExpressionUUID->"db73564f-333d-4aa0-935f-a1d708ffec4c"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
  "g", ",", "L", ",", "k1", ",", "m", ",", "c1", ",", "c2", ",", "f1", ",", 
   "f2"}], "]"}]], "InputOnly",
 CellLabel->
  "In[1249]:=",ExpressionUUID->"670c9065-1b5f-4e50-9939-c84cf92f66b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"x1_", ",", "x2_"}], "]"}], " ", ":=", " ", "x2"}]], "InputOnly",
 CellLabel->
  "In[1250]:=",ExpressionUUID->"d79001f7-0e9e-4813-ac9b-cecbb4d73c11"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{"x1_", ",", "x2_"}], "]"}], " ", ":=", "  ", 
  RowBox[{
   RowBox[{
    FormBox[
     FractionBox["g", "L"],
     TraditionalForm], " ", 
    RowBox[{"Sin", "[", "x1", "]"}]}], " ", "-", " ", 
   RowBox[{
    FormBox[
     FractionBox["k1", "m"],
     TraditionalForm], " ", "x2"}], " ", "-", " ", 
   RowBox[{
    FormBox[
     FractionBox["1", "L"],
     TraditionalForm], " ", 
    RowBox[{
     RowBox[{"x", "'"}], "'"}], " ", 
    RowBox[{"Cos", "[", "x1", "]"}]}]}]}]], "InputOnly",
 CellLabel->
  "In[1251]:=",ExpressionUUID->"7204474b-b446-4ac2-b239-aa71146584f0"],

Cell["Find the equilibrium points:", "Text",ExpressionUUID->"1b32e320-b399-4535-a398-b4b968461caf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"f1", "[", 
        RowBox[{"x1", ",", "x2"}], "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"f2", "[", 
        RowBox[{"x1", ",", "x2"}], "]"}], "==", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.39835509912*^9, 3.3983551029890003`*^9}, {
  3.3983553735629997`*^9, 3.398355406716*^9}},
 CellLabel->
  "In[1252]:=",ExpressionUUID->"71be4196-2838-4607-95ec-2945fc40c237"],

Cell[TextData[{
 "The origin in the phase plane is one of the equilibrium points if there is \
0 feedback control.\nWe can see that  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x2", "\[Rule]", 
    RowBox[{
     RowBox[{"0", "  ", "and", "  ", "x1"}], "\[Rule]", "0"}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "28ecf92f-134e-40e0-9ebe-8ecc764f6b5c"],
 ",  when ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"x", "''"}], "\[Rule]", "0"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "aec1ce2b-9c5f-46b3-a92e-fc2552df993b"],
 "  by simplifying one of the above solutions assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "44fe6a9f-77e0-4c46-a57c-cf4fdb78c597"],
 "."
}], "Text",
 CellChangeTimes->{{3.3983560851359997`*^9, 
  3.398356245632*^9}},ExpressionUUID->"a4c74963-aafa-4a83-883f-f454ca5a81af"],

Cell[BoxData[
 RowBox[{"Assuming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"g", ">", "0"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x2", "\[Rule]", "0"}], ",", 
       RowBox[{"x1", "\[Rule]", 
        RowBox[{"ArcCos", "[", 
         FractionBox["g", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["g", "2"], "+", 
            SuperscriptBox[
             RowBox[{"(", 
              SuperscriptBox["x", "\[Prime]\[Prime]",
               MultilineFunction->None], ")"}], "2"]}]]], "]"}]}]}], "}"}], 
     " ", "/.", " ", 
     RowBox[{
      RowBox[{"x", "''"}], "\[Rule]", "0"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.398355946479*^9, 3.398356053594*^9}, 3.398356279231*^9},
 CellLabel->
  "In[1253]:=",ExpressionUUID->"3ee4904f-48cc-4116-ab00-b299018d8b43"],

Cell[TextData[{
 "Thus, the origin in the phase plane is one of the equilibrium points if \
there is 0 feedback control (i.e. if ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"x2", "\[Rule]", "0"}], ",", 
    RowBox[{"x1", "\[Rule]", "0"}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "45f44851-45bb-4cda-938b-ca070b0e94c0"],
 ",  and ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"x", "''"}], "\[Rule]", "0"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e91fc8ee-a5d1-4f85-9e43-d810cda6db35"],
 ", then the origin is an equilibrium point).\nRemember, x1 = \[Theta] = 0 \
corresponds to the ",
 StyleBox["vertical",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " position.\nRecall that the vertical position is expected to be an ",
 StyleBox["unstable",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " equilibrium."
}], "Text",
 CellChangeTimes->{
  3.3983563102609997`*^9},ExpressionUUID->"facf38ad-8eec-485c-9ac2-\
bd4aac9d406f"],

Cell["\<\
Next, we need to decide upon what sort of control (feedback) will be provided \
for this system.  Although many different controls could be considered, at \
this time we will examine only a simple control defined as follows:

Assume that current measurements of angle (\[Theta]) and \"velocity\" (\
\[Theta]') are available, and that our feedback results in supplying a \
sufficient force in the x direction to produce the lateral acceleration x''.  \
We will assume that the device that produces this x-acceleration responds in \
a linear fashion to these two input variables:
\t\tx'' = c1 \[Theta] + c2 \[Theta]' 
\t\t    = c1 x1  +  c2 x2
Note!  This is different than the book (especially the change in minus sign). \
 The book uses: 
\t\tv = -m x'' = c1 \[Theta] + c2 \[Theta]' 
\t\t   = c1 x1  +  c2 x2, 
so in the book: 
\t\tx'' = - (c1 x1  +  c2 x2)/m.
However for our equations:\
\>", "Text",
 CellChangeTimes->{{3.3983565383129997`*^9, 
  3.3983565499119997`*^9}},ExpressionUUID->"ddb6185f-9ad7-4b87-b79e-\
38e7f23b3bb3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"x1_", ",", "x2_"}], "]"}], " ", ":=", " ", "x2"}]], "InputOnly",
 CellLabel->
  "In[1254]:=",ExpressionUUID->"2bf2e5aa-bb13-496a-9116-fcb573ee6c26"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{"x1_", ",", "x2_"}], "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"g", " ", 
      RowBox[{"Sin", "[", "x1", "]"}]}], "L"], "-", 
    FractionBox[
     RowBox[{"k1", " ", "x2"}], "m"], "-", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       SuperscriptBox["x", "\[Prime]",
        MultilineFunction->None], "\[Prime]",
       MultilineFunction->None], " ", 
      RowBox[{"Cos", "[", "x1", "]"}]}], "L"]}], "/.", "\[InvisibleSpace]", 
   RowBox[{
    SuperscriptBox[
     SuperscriptBox["x", "\[Prime]",
      MultilineFunction->None], "\[Prime]",
     MultilineFunction->None], "\[Rule]", 
    RowBox[{
     RowBox[{"c1", " ", "x1"}], "+", 
     RowBox[{"c2", " ", "x2"}]}]}]}]}]], "InputOnly",
 CellLabel->
  "In[1255]:=",ExpressionUUID->"d3d6f97c-5805-4cce-9e39-d584f346dcb6"],

Cell["\<\
Next, check to see if the origin remains an equilibrium point:\
\>", "Text",ExpressionUUID->"16bc6862-d8b1-4380-9c1b-9934c3efc0ee"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"f1", "[", 
       RowBox[{"x1", ",", "x2"}], "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f2", "[", 
       RowBox[{"x1", ",", "x2"}], "]"}], "==", " ", "0"}]}], 
    "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3983551087060003`*^9, 3.398355113943*^9}, {
  3.398356823492*^9, 3.398356833723*^9}},
 CellLabel->
  "In[1256]:=",ExpressionUUID->"310f98c4-060f-4c81-8312-dce1eec8ba39"],

Cell["\<\
The equations are non algebraic and therefore they have no algebraic solution.
Becaues this attempt has failed, then we will try direct substitution:\
\>", "Text",
 CellChangeTimes->{{3.398356867311*^9, 
  3.398356935325*^9}},ExpressionUUID->"35e8b33f-ed0a-4560-b2c0-e9b84ae65ec0"],

Cell[BoxData[
 RowBox[{"f1", "[", 
  RowBox[{"0", ",", "0"}], "]"}]], "Input",
 CellLabel->
  "In[1257]:=",ExpressionUUID->"4000302b-2c8d-481a-860a-96c1f7088af9"],

Cell[BoxData[
 RowBox[{"f2", "[", 
  RowBox[{"0", ",", "0"}], "]"}]], "Input",
 CellLabel->
  "In[1258]:=",ExpressionUUID->"b88558a3-486c-4110-b891-89beb0c585ba"],

Cell["\<\
Next, examine the stability of the nonlinear equation by looking at the \
linearized ODE system expanded about the equilibrium point. The Jacobian \
matrix is:\
\>", "Text",ExpressionUUID->"1e04b9cc-3959-4828-9bc9-0190e73266cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["\[PartialD]", "x1"], " ", 
         RowBox[{"f1", "[", 
          RowBox[{"x1", ",", "x2"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x2"], " ", 
         RowBox[{"f1", "[", 
          RowBox[{"x1", ",", "x2"}], "]"}]}]},
       {
        RowBox[{
         SubscriptBox["\[PartialD]", "x1"], " ", 
         RowBox[{"f2", "[", 
          RowBox[{"x1", ",", "x2"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x2"], " ", 
         RowBox[{"f2", "[", 
          RowBox[{"x1", ",", "x2"}], "]"}]}]}
      }], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"MatrixForm", "[", "A", "]"}]}], "Input",
 CellChangeTimes->{3.398355117869*^9},
 CellLabel->
  "In[1259]:=",ExpressionUUID->"b1b45b4c-9eb9-4157-8937-9fe9e00d4843"],

Cell["Substitute the coordinates of the equilibrium:", "Text",ExpressionUUID->"39424fe4-d524-4955-a023-3812184e8d1d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", " ", "\[Rule]", " ", "0"}], ",", 
     RowBox[{"x2", " ", "\[Rule]", " ", "0"}]}], "}"}]}], "  ", "//", 
  "MatrixForm"}]], "Input",
 CellLabel->
  "In[1261]:=",ExpressionUUID->"69f464e7-feb4-4ad0-98a0-9522e888855d"],

Cell["\<\
We have shown earlier that the linearized system is asymptotically stable if \
the real part of the eigenvalues is strictly negative.\
\>", "Text",ExpressionUUID->"f03763f9-0cf2-4621-a6ef-bd3c8c112769"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Eigenvalues", "[", 
   RowBox[{"A", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", " ", "\[Rule]", " ", "0"}], ",", 
      RowBox[{"x2", " ", "\[Rule]", " ", "0"}]}], "}"}]}], "]"}], " ", "//", 
  " ", "TableForm"}]], "Input",
 CellLabel->
  "In[1262]:=",ExpressionUUID->"463e7208-51f8-4b5d-8278-2293192fd843"],

Cell[TextData[{
 "We can see in this case, that:\n\tIf: ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k1", " ", "L"}], "+", 
       RowBox[{"c2", " ", "m"}]}], ")"}], "2"], "-", 
    RowBox[{"4", " ", "L", " ", "m", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c1", " ", "m"}], "-", 
       RowBox[{"g", " ", "m"}]}], ")"}]}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "6b3aafcb-e4dd-4a65-b518-61ab197235cf"],
 "  < 0, then:  Real[\[Lambda]] < 0   if:   -k1 L-c2 m < 0\n\t(Which is \
always true if c2 > 0) \nOtherwise, if:  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k1", " ", "L"}], "+", 
       RowBox[{"c2", " ", "m"}]}], ")"}], "2"], "-", 
    RowBox[{"4", " ", "L", " ", "m", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c1", " ", "m"}], "-", 
       RowBox[{"g", " ", "m"}]}], ")"}]}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "e9c058ad-9630-4ca6-b89b-02d604e1f1d3"],
 "  \[GreaterEqual] 0, then \[Lambda] is real, so we must pick the physical \
constants and the feedback control coefficients c1 and c2 so that: \n\t",
 Cell[BoxData[
  StyleBox[
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", "k1"}], " ", "L"}], "-", 
     RowBox[{"c2", " ", "m"}], "+", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k1", " ", "L"}], "+", 
          RowBox[{"c2", " ", "m"}]}], ")"}], "2"], "-", 
       RowBox[{"4", " ", "L", " ", "m", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c1", " ", "m"}], "-", 
          RowBox[{"g", " ", "m"}]}], ")"}]}]}]]}], 
    RowBox[{"2", " ", "L", " ", "m"}]],
   FontWeight->"Bold"]],ExpressionUUID->
  "5ec93844-28cd-4162-a0bc-7963f3400e15"],
 " < 0\nin order to guarantee that the equilibrium point is an attractor."
}], "Text",ExpressionUUID->"cd3c7f4c-8f18-4539-9750-7dd1d3b95980"],

Cell["\<\
Let's assign some values to the physical constants and examine the resulting \
vector fields:\
\>", "Text",ExpressionUUID->"1899b64c-2b88-4ece-8427-f6cb7bc081c1"],

Cell[CellGroupData[{

Cell["Case 1    No Feedback Control", "Subsubsection",ExpressionUUID->"c6fab23b-e4e7-4801-8711-c8edbda60819"],

