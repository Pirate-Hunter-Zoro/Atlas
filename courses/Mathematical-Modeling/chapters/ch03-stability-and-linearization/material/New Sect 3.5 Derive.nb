  3.398408506974*^9, {3.3984097462539997`*^9, 3.398409753492*^9}, {
   3.39840989354*^9, 3.398409894318*^9}, {3.398410047658*^9, 
   3.398410090199*^9}, {3.398680691589333*^9, 3.3986807013842645`*^9}},
