     RowBox[{"BoxData", "[", "\[IndentingNewLine]", 
      RowBox[{"ToBoxes", "[", "\[IndentingNewLine]", 
       RowBox[{"Animate", "[", 
        RowBox[{
         RowBox[{"plot12", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "4", ",", ".02"}], "}"}], ",", 
         RowBox[{"DisplayAllSteps", "\[Rule]", "True"}]}], "]"}], 
       "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}], ",", 
