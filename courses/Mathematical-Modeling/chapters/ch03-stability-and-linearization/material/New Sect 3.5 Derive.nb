Cell[TextData[{
 "Although we could derive this problem directly by making specific algebraic \
substitutions and manipulations, we will instead derive this equation from \
more fundamental principles.  This will better illustrate the general \
procedure that one would use to derive formulas in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". (For our first example, we will manipulate the coordinate equations \
separately in our vector problem.)\n\nConsider a pendulum consisting of a \
mass m1 and a rigid rod of length L1 for which: viscous damping, gravity and \
the forces applied through the rod are the primary forces acting upon the \
system.  Further, assume that the viscous forces are negatively proportional \
to the velocity of the pendulum mass.  Therefore, the vector form of Newton's \
law yields:\n\tm ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "8511516a-c588-4d69-8d00-507628a49f45"],
 " = \[Sum] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F", "i"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"82ec9715-56b5-4ecb-b6ea-d1d3d4a79b94"],
 " =  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["damping", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"6f317913-d38e-43a3-a692-d948723dbd09"],
 "  +  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["gravity", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"c0ab25a5-2661-4aeb-b207-959936cac19e"],
 "  +  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    RowBox[{"rod", " ", "forces"}], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"481592f4-cbaa-47d9-b72c-a04ce2043a0f"],
 "\n\tm ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "b38f9a23-2b68-43ba-ac57-f5283cebe7fb"],
 " = \[Sum] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F", "i"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"86783373-7814-4475-a0ab-9934c9ba1aa6"],
 " =   - k1 ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["v", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "a8dc9a69-63fe-4ac5-8356-1bb6d22e0429"],
 "      -    m ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["g", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "720cf76c-0ebd-4a99-b9df-2ffbd907933e"],
 "     -      ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F", "rod"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"310568a5-7c39-4054-a9a8-0426f7f1fc4c"],
 "\nExpressing both the x and y components of the vector equation in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " yields:\n\tm ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {
       RowBox[{
        RowBox[{
         RowBox[{"x1", "'"}], "'"}], "[", "t", "]"}]},
      {
       RowBox[{
        RowBox[{
         RowBox[{"y1", "'"}], "'"}], "[", "t", "]"}]}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "9f3c34ee-2cf3-4f1c-9c9d-339c48cec2f4"],
 " == - k1 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {
       RowBox[{
        RowBox[{"x1", "'"}], "[", "t", "]"}]},
      {
       RowBox[{
        RowBox[{"y1", "'"}], "[", "t", "]"}]}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "758424ff-b09d-4057-bb17-7aad0e0a4d65"],
 " - m",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
       {"0"},
       {"g"}
      }], "\[NegativeThinSpace]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "03d5893d-8466-4f9c-aa14-ffe53ea05b17"],
 " - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod"], TraditionalForm]],ExpressionUUID->
  "79a1438c-d755-4497-b2b6-d4142f6e53cc"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
       {
        RowBox[{"  ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]},
       {
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}
      }], "\[NegativeThinSpace]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c489bb56-5417-4527-9f1c-2c7333562f85"],
 "\nSeparating the vector equation into its coordinate equations yields:\n\t\
m1*x1''[t] == - k1*x1'[t] - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod"], TraditionalForm]],ExpressionUUID->
  "46e3d743-e14c-414c-a8bb-5b400ac7629c"],
 " Sin[\[Theta]1[t]]\n\tm1*y1''[t] == - k1*y1'[t] +  m1*g + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod"], TraditionalForm]],ExpressionUUID->
  "a1abe198-4bb3-40fe-bd99-1ff77bac6759"],
 " Cos[\[Theta]1[t]]\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod"], TraditionalForm]],ExpressionUUID->
  "548ff05a-1f67-4bff-8d36-587b3dd885ca"],
 " is the scalar magnitude of the rod forces."
}], "Text",
 CellChangeTimes->{3.3984085066470003`*^9, 
  3.749557892901131*^9},ExpressionUUID->"1393647b-baa9-4d17-8914-\
9cf77469863f"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "InputOnly",
 CellChangeTimes->{3.398408506648*^9, 3.398409207198*^9},
 CellLabel->
  "In[1380]:=",ExpressionUUID->"c4a77585-212c-42d1-93a9-66423448f6f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m1", " ", 
     RowBox[{
      SuperscriptBox[
       SuperscriptBox["x1", "\[Prime]",
        MultilineFunction->None], "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}]}], "\[Equal]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "k1"}], " ", 
      RowBox[{
       SuperscriptBox["x1", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "-", 
     RowBox[{
      SubscriptBox["F", "rod"], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1", " ", 
    RowBox[{
     SuperscriptBox[
      SuperscriptBox["y1", "\[Prime]",
       MultilineFunction->None], "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}]}], "\[Equal]", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "k1"}], " ", 
     RowBox[{
      SuperscriptBox["y1", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}]}], "-", 
    RowBox[{"m1", " ", "g"}], "+", 
    RowBox[{
     SubscriptBox["F", "rod"], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}]}], ";"}]}], "InputOnly",
 CellChangeTimes->{3.398408506653*^9},
 CellLabel->
  "In[1381]:=",ExpressionUUID->"39fafb79-b251-4216-b384-46cb9325eff9"],

Cell["\<\
Our first step is to move the rhs to the lhs so that \"all\" of the equation \
is on just one side:\
\>", "Text",
 CellChangeTimes->{
  3.3984085066540003`*^9},ExpressionUUID->"8f70195b-3fb0-4b8d-8815-\
7b6538bfce78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eq1x", ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"m1", " ", 
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["x1", "\[Prime]",
          MultilineFunction->None], "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], "+", 
      RowBox[{"k1", " ", 
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], "+", 
      RowBox[{
       SubscriptBox["F", "rod"], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}], "\[Equal]", "0"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq1y", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"m1", " ", 
      RowBox[{
       SuperscriptBox[
        SuperscriptBox["y1", "\[Prime]",
         MultilineFunction->None], "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "+", 
     RowBox[{"k1", " ", 
      RowBox[{
       SuperscriptBox["y1", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "+", 
     RowBox[{"m1", " ", "g"}], "-", 
     RowBox[{
      SubscriptBox["F", "rod"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}], "\[Equal]", "0"}]}], 
  ";"}]}], "InputOnly",
 CellChangeTimes->{3.3984085066540003`*^9},
 CellLabel->
  "In[1383]:=",ExpressionUUID->"937fd066-a48c-4913-bb5e-816cbb83426f"],

Cell[TextData[{
 "The above equations represent free body motion.  However, we wish to impose \
the assumption that the pendulum rod is rigid, and therefore the pendulum \
mass can only move along the following coordinates. (Note that the angle \
\[Theta]1 is measured counterclockwise from the vertical downward position.  \
Therefore, the angle measured counterclockwise from the positive x-axis is \
given by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[Theta]1", "[", "t", "]"}], "+", 
   FractionBox[
    RowBox[{"3", "\[Pi]"}], "2"]}]],
  FontWeight->"Bold",ExpressionUUID->"4b5f106e-802c-4cd7-ac2c-fef1b33715bb"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.398408506664*^9},ExpressionUUID->"d7d9921f-f4cc-461f-9ea1-52ae4547340a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"x1", "[", "t_", "]"}], ":=", 
    RowBox[{"L1", "*", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"\[Theta]1", "[", "t", "]"}], "+", 
       FractionBox[
        RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}]}], " ", ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"y1", "[", "t_", "]"}], ":=", 
   RowBox[{"L1", "*", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"\[Theta]1", "[", "t", "]"}], "+", 
      FractionBox[
       RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}]}], " ", ";"}]}], "InputOnly",
 CellChangeTimes->{3.398408506664*^9},
 CellLabel->
  "In[1385]:=",ExpressionUUID->"06d34a6c-ad49-43e7-ae86-95a684241712"],

Cell[TextData[{
 "Notice that evaluation of the following two cells causes ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to substitute for both x[t] and y[t], and to also evaluate the derivatives:"
}], "Text",
 CellChangeTimes->{
  3.398408506665*^9},ExpressionUUID->"2426396d-c8c6-441e-b65a-291baf64dd7e"],

Cell[BoxData[
 RowBox[{"eq1x", "=", 
  RowBox[{"Map", "[", 
   RowBox[{"Simplify", ",", "eq1x"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.4028519108130035`*^9, 3.402851931595886*^9}, {
  3.402851993092778*^9, 3.4028520212936945`*^9}},
 CellLabel->
  "In[1387]:=",ExpressionUUID->"98a1a885-a50f-4191-8d57-32a603e821c5"],

Cell[BoxData[
 RowBox[{"eq1y", "=", 
  RowBox[{"Map", "[", 
   RowBox[{"Simplify", ",", "eq1y"}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.402851972340868*^9, {3.4028520103292522`*^9, 3.4028520385921144`*^9}},
 CellLabel->
  "In[1388]:=",ExpressionUUID->"45f2a3f9-069f-4b0b-808a-5d01e3438d45"],

Cell[TextData[{
 "We could use a simple ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command to combine the above equations in such a way as to eliminate the \
unknown value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod"], TraditionalForm]],ExpressionUUID->
  "9a047296-30c9-4596-b47c-4eb2a972e2f8"],
 ".  However, we would like to illustrate how direct algebraic manipulations \
can be used to simplify the above equations (which is to multiply the first \
equation by Cos and the second equation by Sin, and then add the resulting \
equations):"
}], "Text",
 CellChangeTimes->{
  3.398408506665*^9},ExpressionUUID->"5683a991-1d2e-4c6d-9e7e-aef781c67604"],

Cell[BoxData[
 RowBox[{"eq1x", " ", "=", " ", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}], "*", "eq1x"}], ",", " ", 
    "Equal"}], "]"}]}]], "Input",
 CellChangeTimes->{3.398408506665*^9},
 CellLabel->
  "In[1389]:=",ExpressionUUID->"5cbbd808-352b-4c34-81dc-5f78994cd98c"],

Cell[BoxData[
 RowBox[{"eq1y", " ", "=", " ", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}], "*", "eq1y"}], ",", " ", 
    "Equal"}], "]"}]}]], "Input",
 CellChangeTimes->{3.398408506665*^9},
 CellLabel->
  "In[1390]:=",ExpressionUUID->"0677c2c9-255e-40de-b615-a812d8756841"],

Cell[BoxData[
 RowBox[{"finalEq", " ", "=", " ", 
  RowBox[{
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"eq1x", "  ", "+", "  ", "eq1y"}], ",", " ", "Equal"}], "]"}], "//",
    "Simplify"}]}]], "Input",
 CellChangeTimes->{
  3.398408506666*^9, 3.402851674400999*^9, {3.402851775048539*^9, 
   3.4028517952093043`*^9}, 3.4028521848311343`*^9},
 CellLabel->
  "In[1391]:=",ExpressionUUID->"87a9c3ed-c6e0-4578-b4d0-f152ead97f1b"],

Cell["\<\
Observe that the above equation is exactly the same as Equation 1.9 on page 7 \
of the book.  Even though the derivation of this equation is not very \
complicated, it illustrates the fundamental steps that are used for the \
general derivation process.  
As a final remark, it is also possible to change the final appearance of the \
equation by removing the:  [t]   from the final expression.\
\>", "Text",
 CellChangeTimes->{
  3.398408506666*^9},ExpressionUUID->"7f8031f1-214a-4d22-8c6b-e20ad01578d1"],

Cell[BoxData[
 RowBox[{"finalEq", "/.", " ", 
  RowBox[{
   RowBox[{"head_", "[", "t", "]"}], "\[Rule]", "head"}]}]], "Input",
 CellChangeTimes->{3.398408506666*^9},
 CellLabel->
  "In[1392]:=",ExpressionUUID->"5b8282a6-1aed-4474-a411-e226535f495a"],

Cell["Or change the symbolic notation even further:", "Text",
 CellChangeTimes->{
  3.398408506666*^9},ExpressionUUID->"8fc83ec7-2472-4241-be2a-b92dff5214a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"finalEq", "/.", " ", 
   RowBox[{
    RowBox[{"head_", "[", "t", "]"}], "\[Rule]", "head"}]}], " ", "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Theta]1", "\[Prime]",
      MultilineFunction->None], "\[Rule]", 
     OverscriptBox["\[Theta]", "."]}], ",", 
    RowBox[{
     SuperscriptBox["\[Theta]1", "\[DoublePrime]",
      MultilineFunction->None], "\[Rule]", 
     OverscriptBox["\[Theta]", "\[DoubleDot]"]}]}], "}"}]}]], "Input",
 CellChangeTimes->{3.398408506667*^9},
 CellLabel->
  "In[1393]:=",ExpressionUUID->"fbdc7c6b-e74e-4c30-8c51-3223ba615c21"],

Cell[TextData[{
 "Remember, the above equation is not in standard ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notation, and therefore can not be directly evaluated in its current form."
}], "Text",
 CellChangeTimes->{
  3.398408506667*^9},ExpressionUUID->"55ef83d9-320b-4830-a651-5620cef9f0a0"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example: Derivation of the Double Pendulum Formulas", "Section",
 CellChangeTimes->{
  3.398408506667*^9},ExpressionUUID->"965dc1d2-d2c8-4b50-96d9-958d59541cf6"],

Cell["\<\
We can extend the above procedure to derive the equations of motion for a \
double pendulum system.  The upper pendulum will be designated as: 1, and the \
lower pendulum will be designated as: 2.\
\>", "Text",
 CellChangeTimes->{
  3.749556214420722*^9},ExpressionUUID->"56833e84-20db-485c-8400-\
1c042fdfda8b"],

Cell[TextData[Cell[BoxData[
 GraphicsBox[
  {Thickness[0.01], 
   LineBox[{{0, 0}, {0.48114650868772285`, -1.9412619702599685`}}], 
   {PointSize[0.05], PointBox[{0.48114650868772285`, -1.9412619702599685`}], 
    LineBox[{{
     0.48114650868772285`, -1.9412619702599685`}, {-0.34191017569416887`, \
-2.509221206732347}}]}, 
   {PointSize[0.05], PointBox[{-0.34191017569416887`, -2.509221206732347}]}},
  AspectRatio->1,
  Axes->Automatic,
  AxesStyle->GrayLevel[0.5],
  ImageSize->{243.9999999999983, Automatic},
  PlotRange->{{-3.21, 3.21}, {-3.21, 3.21}},
  Ticks->None]],
 CellChangeTimes->{
  3.7495557134237223`*^9, 3.7495560320347223`*^9, {3.749556062974722*^9, 
   3.749556076146722*^9}},ExpressionUUID->"ac22b35c-d9ea-4121-b778-\
1759051dac10"]], "Item",
 CellChangeTimes->{
  3.749556173952722*^9},ExpressionUUID->"9afecbb7-1c16-48fe-bfe7-\
61fee982bea1"],

Cell[TextData[{
 "\nThe first step is to use Newton's law on both pendulums.\nTherefore, the \
vector form of Newton's law for the upper pendulum mass yields:\n\tm1 ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a1", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "d2c682b9-325a-4c86-8d8c-6222a44f0043"],
 " = \[Sum] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F1", "i"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"5b4f7f1f-9bed-417d-8854-04e398310ba6"],
 " =  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["damping", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"22913e25-6ac5-4bae-ae3d-769d220802f4"],
 "  +  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["gravity", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"c5bef208-9d8b-4fcf-a352-8321bb2ac591"],
 "  +  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    RowBox[{"rod", " ", "forces"}], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"40356b23-2fde-4a82-96f0-d00e775789ed"],
 "\n\tm1 ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a1", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "c515a777-4e33-4c44-a9e2-faea0989e911"],
 " = \[Sum] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F1", "i"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"dae231f8-b7ae-4292-9ca7-46ef6b9a8222"],
 " =  - k1 ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["v1", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "2e57dd4c-f0cc-43c6-8752-cb2dff1e4375"],
 "     -   m1 ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["g", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "57f989c7-5778-4076-a5b7-1d0b4ae35c46"],
 "    +  (- ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F", "rod1"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"3fb8d725-b2ad-4d19-b400-21e0c5b0eb2d"],
 "+",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F", "rod2"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"2b192809-d781-4020-9db8-b53cd1ff55d1"],
 ")\nwhere the rod force ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F", "rod1"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"e34747be-bf52-4ad2-897b-2fd25f9d5a5a"],
 " on mass m1 is expressed in terms of its scalar magnitude ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod1"], TraditionalForm]],ExpressionUUID->
  "d1c71e5f-cd77-438a-9ee4-66be2b13fa92"],
 " and a vector of unit length pointing in the outward direction of the upper \
rod (which is expressed in terms of the angle \[Theta]1[t]).  The rod force \
on mass m1 produced by the lower rod ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["F", "rod2"], "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"7f17ab6a-75c5-436d-aae9-6b77b84947c3"],
 " is likewise expressed in terms of a unit vector pointing outward in the \
direction of the lower rod at angle \[Theta]2[t].\n\tm1 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {
       RowBox[{
        RowBox[{
         RowBox[{"x1", "'"}], "'"}], "[", "t", "]"}]},
      {
       RowBox[{
        RowBox[{
         RowBox[{"y1", "'"}], "'"}], "[", "t", "]"}]}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "d430b0c7-7dee-40a5-814f-4f5aeb8a6f91"],
 " == - k1 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {
       RowBox[{
        RowBox[{"x1", "'"}], "[", "t", "]"}]},
      {
       RowBox[{
        RowBox[{"y1", "'"}], "[", "t", "]"}]}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "a5cec6c3-4afe-4688-9fd6-60d60e147e19"],
 " - m1",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
       {"0"},
       {"g"}
      }], "\[NegativeThinSpace]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "187c84d6-ba37-4638-8470-abd1a26a44d7"],
 " - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod1"], TraditionalForm]],ExpressionUUID->
  "3f3829a7-e59e-4c9c-997b-cdbcc36a0fb8"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
       {
        RowBox[{"  ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]},
       {
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}]}
      }], "\[NegativeThinSpace]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "cdff3ac6-525f-4b6e-b245-6b40845abead"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod2"], TraditionalForm]],ExpressionUUID->
  "ccc92291-a1c1-41fd-aead-b026125adda4"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
       {
        RowBox[{"  ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}]},
       {
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}]}
      }], "\[NegativeThinSpace]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "397e1fb9-2474-4507-a0d9-2d724eff876e"],
 "\nThe equation of motion for the lower rod is given by:\n\tm2 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {
       RowBox[{
        RowBox[{
         RowBox[{"x2", "'"}], "'"}], "[", "t", "]"}]},
      {
       RowBox[{
        RowBox[{
         RowBox[{"y2", "'"}], "'"}], "[", "t", "]"}]}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "ace8bcac-816a-46ce-8352-72e9ee0abab7"],
 " == - k2 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {
       RowBox[{
        RowBox[{"x2", "'"}], "[", "t", "]"}]},
      {
       RowBox[{
        RowBox[{"y2", "'"}], "[", "t", "]"}]}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "3d680675-c9c6-4554-98ee-4db98be75569"],
 " - m2",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
       {"0"},
       {"g"}
      }], "\[NegativeThinSpace]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "cffbcc28-df0a-4e85-8fc3-2e50d993014e"],
 " - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod2"], TraditionalForm]],ExpressionUUID->
  "47b95310-2fd4-4cc1-b294-134cb21d4311"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
       {
        RowBox[{"  ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}]},
       {
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}]}
      }], "\[NegativeThinSpace]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "a096e218-532b-4d19-b81e-2611083cde16"],
 "\nWe will derive the above equations using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.398408506672*^9, {3.749556197804722*^9, 
   3.749556200775722*^9}},ExpressionUUID->"088cd796-03ed-4c74-bc3b-\
e33351207aed"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "InputOnly",
 CellChangeTimes->{3.398408506672*^9, {3.398409344769*^9, 3.398409345094*^9}},
 CellLabel->
  "In[1394]:=",ExpressionUUID->"6b4702a4-9288-4f32-aa06-5225e22be74e"],

Cell["\<\
First, define two vectors in rectangular coordinates as a function of time \
corresponding to the respective locations of masses m1 and m2:\
\>", "Text",
 CellChangeTimes->{
  3.3984085066730003`*^9},ExpressionUUID->"e5cc74aa-11dc-4a23-be40-\
87dde68966d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["X", "1"], "[", "t_", "]"}], ":=", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", "[", "t", "]"}], ",", 
     RowBox[{"y1", "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["X", "2"], "[", "t_", "]"}], ":=", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x2", "[", "t", "]"}], ",", 
     RowBox[{"y2", "[", "t", "]"}]}], "}"}]}], ";"}]}], "InputOnly",
 CellChangeTimes->{3.3984085066730003`*^9},
 CellLabel->
  "In[1395]:=",ExpressionUUID->"939c0ffc-8ecc-42fc-818b-2c8a9d2b8fcb"],

Cell["\<\
For example, the vector acceleration of the first mass would be expressed as:\
\>", "Text",
 CellChangeTimes->{
  3.398408506683*^9},ExpressionUUID->"5e5d83b0-a5c2-4841-a0e9-8423f5102074"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["X", "1"], "'"}], "'"}], "[", "t", "]"}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{3.398408506683*^9},
 CellLabel->
  "In[1397]:=",ExpressionUUID->"20c0fda5-555a-4b12-9c70-73dd9568d09b"],

Cell["\<\
Define a vector formula which will calculate the direction of a unit vector \
pointing in the outward direction with angle \[Theta].  Remember, our angle \
\[Theta] is to be measured counterclockwise from the vertical downward \
position, and therefore the correct representation for this angle measured \
counterclockwise from the positive x-axis is: \[Theta] + 3\[Pi]/2.  We can \
use this formula for both the upper and lower rods by substituting either \
\[Theta]1 or \[Theta]2.\
\>", "Text",
 CellChangeTimes->{
  3.398408506683*^9},ExpressionUUID->"a9eae6d3-5f38-4c0f-afbd-a51638d0987f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["uV", "rod"], "[", "\[Theta]_", "]"}], ":=", "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"\[Theta]", "+", 
      FractionBox[
       RowBox[{"3", "\[Pi]"}], "2"]}], "]"}], ",", 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Theta]", "+", 
      FractionBox[
       RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}], "}"}]}]], "InputOnly",
 CellChangeTimes->{3.398408506684*^9},
 CellLabel->
  "In[1398]:=",ExpressionUUID->"dba6d6f1-0d93-42cb-b58f-4364fd56373f"],

Cell["\<\
For example, the outward unit vector for the upper rod at time t would be:\
\>", "Text",
 CellChangeTimes->{
  3.398408506684*^9},ExpressionUUID->"fd5a8f66-a57e-447d-a1e9-451f280d77d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["uV", "rod"], "[", 
   RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{3.398408506692*^9},
 CellLabel->
  "In[1399]:=",ExpressionUUID->"0fa68710-e185-4320-a508-58c7369a7dad"],

Cell["\<\

The vector equation of motion for the upper rod becomes:\
\>", "Text",
 CellChangeTimes->{
  3.398408506692*^9},ExpressionUUID->"5c20fb4e-fcea-4b0d-840e-3293a9789471"],

Cell[BoxData[
 RowBox[{"vectorEqs1", " ", "=", " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"m1", "*", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["X", "1"], "'"}], "'"}], "[", "t", "]"}]}], "==", 
   RowBox[{
    RowBox[{
     RowBox[{"-", " ", "k1"}], "*", 
     RowBox[{
      RowBox[{
       SubscriptBox["X", "1"], "'"}], "[", "t", "]"}]}], " ", "+", 
    RowBox[{"m1", "*", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "g"}]}], "}"}]}], "-", 
    RowBox[{
     SubscriptBox["F", "rod1"], "*", 
     RowBox[{
      SubscriptBox["uV", "rod"], "[", 
      RowBox[{"\[Theta]1", "[", "t", "]"}], "]"}]}], "+", 
    RowBox[{
     SubscriptBox["F", "rod2"], "*", 
     RowBox[{
      SubscriptBox["uV", "rod"], "[", 
      RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{3.398408506692*^9},
 CellLabel->
  "In[1400]:=",ExpressionUUID->"a3368731-9f0e-4665-8ca8-dd1b81797cdb"],

Cell["The vector equation of motion for the lower rod becomes:", "Text",
 CellChangeTimes->{
  3.398408506692*^9},ExpressionUUID->"a8b4a8aa-8db8-435b-a337-4ca39a3ee983"],

Cell[BoxData[
 RowBox[{"vectorEqs2", " ", "=", " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"m2", "*", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["X", "2"], "'"}], "'"}], "[", "t", "]"}]}], "==", 
   RowBox[{
    RowBox[{
     RowBox[{"-", " ", "k2"}], "*", 
     RowBox[{
      RowBox[{
       SubscriptBox["X", "2"], "'"}], "[", "t", "]"}]}], " ", "+", 
    RowBox[{"m2", "*", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "g"}]}], "}"}]}], "-", 
    RowBox[{
     SubscriptBox["F", "rod2"], "*", 
     RowBox[{
      SubscriptBox["uV", "rod"], "[", 
      RowBox[{"\[Theta]2", "[", "t", "]"}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{3.398408506692*^9},
 CellLabel->
  "In[1401]:=",ExpressionUUID->"0bc5ea8e-1c09-4f54-92ee-fdc2dd94d442"],

Cell["\<\
Observe that we need to Thread \"==\" over the List (because vectors are \
represented as 1-dimensional lists).  Therefore, the vector equation for the \
upper pendulum becomes:\
\>", "Text",
 CellChangeTimes->{
  3.398408506693*^9},ExpressionUUID->"698cb928-63a4-4f7c-9540-80d5711c5c5b"],

Cell[BoxData[
 RowBox[{"vectorEqs1", "  ", "=", "   ", 
  RowBox[{"Thread", "[", " ", 
   RowBox[{"vectorEqs1", " ", ",", "List"}], "]"}]}]], "Input",
 CellChangeTimes->{3.398408506693*^9},
 CellLabel->
  "In[1402]:=",ExpressionUUID->"3e6dad05-48db-48d3-9378-31ea274f5327"],

Cell["The vector equation for the lower pendulum becomes:", "Text",
 CellChangeTimes->{
  3.398408506693*^9},ExpressionUUID->"eb55242d-9185-4502-bdb1-0517ae81e0d1"],

Cell[BoxData[
 RowBox[{"vectorEqs2", "  ", "=", "   ", 
  RowBox[{"Thread", "[", " ", 
   RowBox[{"vectorEqs2", " ", ",", "List"}], "]"}]}]], "Input",
 CellChangeTimes->{3.398408506693*^9},
 CellLabel->
  "In[1403]:=",ExpressionUUID->"7e410145-ec60-4efd-984c-709341396b20"],

Cell["Display all 4 equations of motion:", "Text",
 CellChangeTimes->{
  3.398408506693*^9},ExpressionUUID->"0fda6655-08cc-468b-8680-0fcd9395ebd7"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"vectorEqs1", "\[Union]", "vectorEqs2"}], "//", " ", 
   "TableForm"}]}]], "Input",
 CellChangeTimes->{3.398408506693*^9},
 CellLabel->
  "In[1404]:=",ExpressionUUID->"64e4f5d2-456c-466b-8d98-fd5cf4cd8335"],

Cell[TextData[{
 "The above equations represent free body motion.  However, we wish to impose \
the assumption that both pendulum rods are rigid, and therefore each pendulum \
mass can only move with the following coordinates. (Note that the angles \
\[Theta]1 and \[Theta]2 are measured counterclockwise from the vertical \
downward position.  Therefore, the angles measured counterclockwise from the \
positive x-axis are given by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[Theta]1", "[", "t", "]"}], "+", 
   FractionBox[
    RowBox[{"3", "\[Pi]"}], "2"]}]],
  FontWeight->"Bold",ExpressionUUID->"00d5c369-c07a-488b-a9fa-0f2a97b3bb33"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[Theta]2", "[", "t", "]"}], "+", 
   FractionBox[
    RowBox[{"3", "\[Pi]"}], "2"]}]],
  FontWeight->"Bold",ExpressionUUID->"a4568d4f-5733-4777-97d5-8861c4baef93"],
 "."
}], "Text",
 CellChangeTimes->{
  3.3984085066940002`*^9},ExpressionUUID->"41d306c0-b8cc-4690-9875-\
78c0f781c79d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"x1", "[", "t_", "]"}], ":=", 
    RowBox[{"L1", "*", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"\[Theta]1", "[", "t", "]"}], "+", 
       FractionBox[
        RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}]}], " ", ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"y1", "[", "t_", "]"}], ":=", 
    RowBox[{"L1", "*", 
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"\[Theta]1", "[", "t", "]"}], "+", 
       FractionBox[
        RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}]}], " ", ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"x2", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"L1", "*", 
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"\[Theta]1", "[", "t", "]"}], "+", 
        FractionBox[
         RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}], " ", "+", " ", 
     RowBox[{"L2", "*", 
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"\[Theta]2", "[", "t", "]"}], "+", 
        FractionBox[
         RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"y2", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"L1", "*", 
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"\[Theta]1", "[", "t", "]"}], "+", 
       FractionBox[
        RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}], " ", "+", " ", 
    RowBox[{"L2", "*", 
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"\[Theta]2", "[", "t", "]"}], "+", 
       FractionBox[
        RowBox[{"3", "\[Pi]"}], "2"]}], "]"}]}]}]}], ";"}]}], "InputOnly",
 CellChangeTimes->{3.398408506727*^9},
 CellLabel->
  "In[1405]:=",ExpressionUUID->"90bf795c-631b-4b88-a6a6-cd8bb566f412"],

Cell[TextData[{
 "Notice that evaluation of the above 4 ODE formulas causes ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to substitute for: x1[t], y1[t], x2[t], y2[t] and to also evaluate the \
derivatives:"
}], "Text",
 CellChangeTimes->{
  3.398408506727*^9},ExpressionUUID->"6ad30403-5c02-4572-9066-ae1594584684"],

Cell[BoxData[
 RowBox[{"allEqns", "=", 
  RowBox[{"vectorEqs1", "\[Union]", "vectorEqs2"}]}]], "Input",
 CellChangeTimes->{3.398408506727*^9},
 CellLabel->
  "In[1409]:=",ExpressionUUID->"fc2c91ca-7209-4aac-b15a-64d8f0d69346"],

Cell["Display all four equations:", "Text",
 CellChangeTimes->{
  3.398408506727*^9},ExpressionUUID->"2bb2db12-654b-4faa-ae89-5ec7a2d2002e"],

Cell[BoxData[
 RowBox[{"allEqns", "//", "TableForm"}]], "Input",
 CellChangeTimes->{3.398408506727*^9},
 CellLabel->
  "In[1410]:=",ExpressionUUID->"7f836a13-3de3-4e2a-826b-faf2bffcb4d4"],

Cell[TextData[{
 "Examination of the above 4 formulas indicates that we need to eliminate the \
two unknown scalar magnitudes: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod1"], TraditionalForm]],ExpressionUUID->
  "1193b17b-8e89-459a-9ac5-4a0209825b6a"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod2"], TraditionalForm]],ExpressionUUID->
  "4d8d9985-9508-4056-a73f-c45c38c1e32f"],
 ".   This can be accomplished directly by using the Eliminate command.  \
However the Eliminate command can make a number of different choices on how \
to eliminate 2 variables from 4 equations.  Therefore, the Eliminate command \
returns a number of acceptable formulas from which the 2 variables have been \
removed.  It expects that you will select the formulas that you like best \
from the offering.  The returned formulas are connected by \"And\" because \
they are not necessarily independent of each other (i.e. the returned \
formulas are given as:    lhs1==rhs1 && lhs2==rhs2 && lhs3==rhs3 &&  ...).  \n\
Therefore, it will be easier in our case to select 3 formulas and eliminate \
both ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod1"], TraditionalForm]],ExpressionUUID->
  "c5b45b44-700b-4087-a5b1-8ac4b7ac531e"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "rod2"], TraditionalForm]],ExpressionUUID->
  "b2f0f6b8-6f9b-4bbb-b828-006754714722"],
 " producing a single resulting formula.  We will do this twice to obtain 2 \
independent formulas.   Start by using both of the upper pendulum coordinate \
equations and only the first (i.e. x-coordinate) lower pendulum equation:"
}], "Text",
 CellChangeTimes->{
  3.3984085067279997`*^9},ExpressionUUID->"0646636f-4395-4a13-b723-\
20ac9a7c1b9e"],

Cell[BoxData[
 RowBox[{"firstEqn", " ", "=", " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Eliminate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectorEqs1", "\[Union]", 
     RowBox[{"{", 
      RowBox[{
      "vectorEqs2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
      "}"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["F", "rod1"], ",", 
      SubscriptBox["F", "rod2"]}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{3.3984085067279997`*^9},
 CellLabel->
  "In[1411]:=",ExpressionUUID->"f3699249-3113-44fd-8eb2-3b57754dcaa9"],

Cell["Simplify the result:", "Text",
 CellChangeTimes->{
  3.398408506729*^9},ExpressionUUID->"c942a741-80ba-4a39-995a-74ea7feffcb0"],

Cell[BoxData[
 RowBox[{"firstEqn", " ", "=", " ", 
  RowBox[{"firstEqn", "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{3.398408506729*^9},
 CellLabel->
  "In[1412]:=",ExpressionUUID->"f80a005b-3d67-4d29-9a15-2bad6a723d38"],

Cell["\<\
Next use both of the upper pendulum coordinate equations and only the second \
(i.e. y-coordinate) lower pendulum equation:\
\>", "Text",
 CellChangeTimes->{
  3.398408506729*^9},ExpressionUUID->"6acee4b8-ff1f-4a22-96a1-7f14e0948a06"],

Cell[BoxData[
 RowBox[{"secondEqn", " ", "=", " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Eliminate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectorEqs1", "\[Union]", 
     RowBox[{"{", 
      RowBox[{
      "vectorEqs2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
      "}"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["F", "rod1"], ",", 
      SubscriptBox["F", "rod2"]}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{3.398408506729*^9},
 CellLabel->
  "In[1413]:=",ExpressionUUID->"9dab3c0d-0564-409d-baab-02f994c6747d"],

Cell["Simplify the result:", "Text",
 CellChangeTimes->{
  3.398408506729*^9},ExpressionUUID->"2d9d6a16-3267-40ec-b596-a427459ef37d"],

Cell[BoxData[
 RowBox[{"secondEqn", " ", "=", " ", 
  RowBox[{"secondEqn", "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{3.398408506729*^9},
 CellLabel->
  "In[1414]:=",ExpressionUUID->"4d2daabf-75a5-498a-98c6-3db5a9c7bc98"],

Cell["\<\
The above 2 nonlinear second-order coupled ODEs represent the motion of our \
double pendulum system.\
\>", "Text",
 CellChangeTimes->{
  3.398408506729*^9},ExpressionUUID->"cecf5191-c931-4621-98d3-0c3577d816f6"]
}, Closed]],

Cell[CellGroupData[{

Cell["Numerical Solutions for the Double Pendulum Problem", "Section",
 CellChangeTimes->{
  3.398408506729*^9},ExpressionUUID->"828a45fc-a813-40c9-996f-e8fa91f33caa"],

Cell["\<\
The formulas for the double pendulum problem are both nonlinear and second \
order.  A symbolic solution to our nonlinear problem is not expected.  \
Therefore, only numerical examples will be generated.  Consider some \
reasonable values for the lengths, masses and friction coefficients for each \
of the two pendulums:\
\>", "Text",
 CellChangeTimes->{
  3.398408506729*^9},ExpressionUUID->"7fc29f3b-adb3-4b96-b80d-6495a27f2b5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L1", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m1", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k1", "=", ".5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L2", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m2", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k2", "=", "k1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", "32"}], ";"}]}], "InputOnly",
 CellChangeTimes->{3.39840850673*^9},
 CellLabel->
  "In[1415]:=",ExpressionUUID->"9ae1d622-5a63-43b9-b5d0-9d5431e6bcd1"],

Cell["\<\
Observe the form of our second-order nonlinear ODE equations after \
substituting the above values:\
\>", "Text",
 CellChangeTimes->{
  3.39840850673*^9},ExpressionUUID->"d62d7e83-7c26-41f7-ad40-f5f6bef470c7"],

Cell[BoxData["firstEqn"], "Input",
 CellChangeTimes->{3.39840850673*^9},
 CellLabel->
  "In[1422]:=",ExpressionUUID->"0da3eacc-851a-4b08-aa3d-dd0121f830ce"],

Cell[BoxData["secondEqn"], "Input",
 CellChangeTimes->{3.39840850673*^9},
 CellLabel->
  "In[1423]:=",ExpressionUUID->"c1ac6b4e-1a8e-40ca-a329-b53bea6fff96"],

Cell["\<\
Numerically solve the ODE system using an initial angular displacement and \
initial angular velocity for each of the two pendulums.  (Note that I chose \
to express the ODE equations in terms of \[Theta]1 and \[Theta]2, which are \
also used in the above formulas.  Therefore, it is extremely important that \
both \[Theta]1 and \[Theta]2 are cleared before calling NDSolve.)
Basically, the initial conditions correspond to moving the lower pendulum \
counterclockwise 1.5 radians and letting go with zero angular velocity.\
\>", "Text",
 CellChangeTimes->{
  3.39840850673*^9},ExpressionUUID->"6811bb81-c26b-4c50-8046-fa2e8a71d428"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"\[Theta]1", ",", "\[Theta]2"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "firstEqn", ",", "\[IndentingNewLine]", "secondEqn", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Theta]1", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]1", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Theta]2", "[", "0", "]"}], "\[Equal]", "1.5"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]2", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", "\[Theta]2"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{
  3.398408506731*^9, {3.398409474731*^9, 3.398409483148*^9}, 
   3.398409831245*^9, {3.398409922778*^9, 3.3984099243599997`*^9}},
 CellLabel->
  "In[1424]:=",ExpressionUUID->"d1e3f156-c136-4eb7-bf0f-cf2155e045ec"],

Cell["\<\
Extract the two angle solutions.  (Note that I must use \[Theta]1 and \
\[Theta]2 as the names of my solutions if I want to use the formulas for \
x1[t] and x2[t] defined above.  One consequence of this action is that I must \
clear both \[Theta]1 and \[Theta]2 before re-calling NDSolve.)\
\>", "Text",
 CellChangeTimes->{
  3.398408506731*^9},ExpressionUUID->"f16d8963-b71f-46a4-8e9c-2ed9bd1aaf3d"],

Cell[BoxData[
 RowBox[{"\[Theta]1", " ", "=", " ", 
  RowBox[{"\[Theta]1", "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellChangeTimes->{3.398408506731*^9, {3.398409494551*^9, 3.3984095045*^9}},
 CellLabel->
  "In[1426]:=",ExpressionUUID->"993c010d-7934-4ec6-8c17-4554b4ff55a8"],

Cell[BoxData[
 RowBox[{"\[Theta]2", " ", "=", " ", 
  RowBox[{"\[Theta]2", "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellChangeTimes->{3.398408506731*^9, 3.398409518289*^9},
 CellLabel->
  "In[1427]:=",ExpressionUUID->"b35a6d4e-15ab-4a42-8a93-b8edd7d292dd"],

Cell["Plot the two angular displacements as a function of time:", "Text",
 CellChangeTimes->{3.398408506731*^9, 
  3.398410885243*^9},ExpressionUUID->"4566d88f-d559-4786-b6a1-fe453f341dd4"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]1", "[", "t", "]"}], ",", 
     RowBox[{"\[Theta]2", "[", "t", "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".007", "]"}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".007", "]"}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".01", ",", ".01"}], "}"}], "]"}]}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"6", " ", "72"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "\[Rule]", ".5"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{
  3.3984085067320004`*^9, {3.3984095400559998`*^9, 3.398409590983*^9}, {
   3.398409789948*^9, 3.39840980465*^9}, {3.398409847008*^9, 
   3.3984098687720003`*^9}, {3.398409952113*^9, 3.39840995223*^9}, {
   3.3984099856429996`*^9, 3.3984100150629997`*^9}, {3.398410553914*^9, 
   3.3984105555769997`*^9}, {3.398410737743*^9, 3.398410766598*^9}},
 CellLabel->
  "In[1428]:=",ExpressionUUID->"4e54e39f-bad4-457a-a384-516a11554c28"]
}, Closed]],

Cell[CellGroupData[{

Cell["Animate the Double Pendulum Solution", "Section",
 CellChangeTimes->{
  3.3984085067320004`*^9},ExpressionUUID->"3b9df001-4b49-4406-8c71-\
1129d95293e3"],

Cell["\<\
Generate a module which will use graphic primitives to display the positions \
of the two pendulums:\
\>", "Text",
 CellChangeTimes->{
  3.3984085067320004`*^9},ExpressionUUID->"0d89e229-fd2a-4348-bda4-\
01bbc10450fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotPendulums", "[", "t_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"totalL", "=", 
      RowBox[{"1.07", " ", 
       RowBox[{"(", 
        RowBox[{"L1", "+", "L2"}], ")"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", ".01", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x1", "[", "t", "]"}], ",", 
              RowBox[{"y1", "[", "t", "]"}]}], "}"}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"PointSize", "[", 
          FractionBox[
           RowBox[{".1", " ", "m1"}], 
           RowBox[{"m1", "+", "m2"}]], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x1", "[", "t", "]"}], ",", 
            RowBox[{"y1", "[", "t", "]"}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x1", "[", "t", "]"}], ",", 
              RowBox[{"y1", "[", "t", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x2", "[", "t", "]"}], ",", 
              RowBox[{"y2", "[", "t", "]"}]}], "}"}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"PointSize", "[", 
          FractionBox[
           RowBox[{".1", " ", "m2"}], 
           RowBox[{"m1", "+", "m2"}]], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x2", "[", "t", "]"}], ",", 
            RowBox[{"y2", "[", "t", "]"}]}], "}"}], "]"}]}], "}"}], 
       "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Axes", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Ticks", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AxesStyle", "\[Rule]", 
       RowBox[{"GrayLevel", "[", ".5", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "totalL"}], ",", "totalL"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "totalL"}], ",", "totalL"}], "}"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{3.398408506733*^9, 3.398409654368*^9, 3.398409713002*^9},
 CellLabel->
  "In[1429]:=",ExpressionUUID->"6aa0d064-501f-4301-bfd0-b285185f4055"],

Cell[TextData[{
 " The initial pendulum displacements are at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "7917fd31-7780-4738-9da1-ae08ea024b44"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.398408506733*^9, {3.749556287743722*^9, 
   3.749556293889722*^9}},ExpressionUUID->"894cb012-b6e0-469c-a21d-\
c90e47d5dee4"],

Cell[BoxData[
 RowBox[{"plotPendulums", "[", "0", "]"}]], "Input",
 CellChangeTimes->{{3.749556062463722*^9, 3.749556075382722*^9}, {
  3.749556278675722*^9, 3.749556280480722*^9}},
 CellLabel->
  "In[1435]:=",ExpressionUUID->"fd5392c8-e591-41ff-a90b-950f899c91b3"],

Cell["\<\
Generate a time animation of plots to indicate the pendulum positions as a \
function of time:\
\>", "Text",
 CellChangeTimes->{
  3.398408506974*^9, {3.3984103514890003`*^9, 
   3.398410359448*^9}},ExpressionUUID->"1a972dea-4739-41ab-8782-620ce5561199"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plotPendulums", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
