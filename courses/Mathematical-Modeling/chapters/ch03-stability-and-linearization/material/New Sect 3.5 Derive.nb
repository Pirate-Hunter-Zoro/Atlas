Cell[TextData[{
 "\nThe following ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " functions will be used to generate a pair of 2-dimensional vector fields \
(one for the top pendulum and one for the bottom pendulum).  Also, the left \
vector field will have a schematic which illustrates the current \
configuration of both the top and bottom pendulums.\nDefine a function which \
will plot the 2-dimensional vector field \"slice\" for the top pendulum:"
}], "Text",
 CellChangeTimes->{
  3.398408507006*^9},ExpressionUUID->"42f0cc7b-8a72-4e8e-b026-a6bcd0a070aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vecField1", "[", "t_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f1", "[", 
     RowBox[{"\[Theta]1a", ",", "\[Theta]1p", ",", 
      RowBox[{"\[Theta]2", "[", "t", "]"}], ",", 
      RowBox[{
       SuperscriptBox["\[Theta]2", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Theta]1a", ",", 
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Theta]1p", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.398408507007*^9, {3.3984113517200003`*^9, 3.398411416068*^9}, {
   3.4647182058351493`*^9, 3.4647182156945243`*^9}},
 CellTags->"S5.42.1",
 CellLabel->
  "In[1472]:=",ExpressionUUID->"7bab41c3-54be-43c9-bc44-10f8438bb22a"],

