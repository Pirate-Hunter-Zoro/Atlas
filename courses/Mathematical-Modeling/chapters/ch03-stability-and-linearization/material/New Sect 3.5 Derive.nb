Cell["\<\
Animate the above plot, while slowing the animation using the controls \
located at the top.  Observe that the motion of the lower pendulum causes the \
upper pendulum to move as well.  Eventually, the viscous damping will slow \
the pendulums until they stop moving,\
\>", "Text",
 CellChangeTimes->{
  3.398408506975*^9, {3.398410401642*^9, 
   3.398410450776*^9}},ExpressionUUID->"88ef1d29-0200-4ce6-9f29-00945abbd8f2"]
}, Closed]],

Cell[CellGroupData[{

Cell["Additional Animations", "Section",
 CellChangeTimes->{
  3.398408506975*^9},ExpressionUUID->"63df5dfe-87be-4a69-8296-e79fb044a236"],

Cell["\<\
Consider an example where the initial displacements for our two pendulums is \
much greater, which better illustrates the nonlinear nature of our solution:\
\>", "Text",
 CellChangeTimes->{
  3.398408506975*^9},ExpressionUUID->"1b528391-31e3-4c97-9f13-f5b95816fe75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L1", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m1", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k1", "=", ".5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L2", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m2", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k2", "=", "k1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", "32"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxTime", "=", "15"}], ";"}]}], "InputOnly",
 CellChangeTimes->{
  3.398408506975*^9, {3.39841084908*^9, 3.3984108492390003`*^9}},
 CellLabel->
  "In[1436]:=",ExpressionUUID->"a0e48a62-1455-45d7-8fef-48f6c7a0a2b6"],

Cell["Solve the nonlinear ODE system for these values:", "Text",
 CellChangeTimes->{
  3.398408506975*^9},ExpressionUUID->"dd1bdad7-dd5a-4f4c-bfdc-ac2f77ec21c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"\[Theta]1", ",", "\[Theta]2"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "firstEqn", ",", "\[IndentingNewLine]", "secondEqn", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Theta]1", "[", "0", "]"}], "\[Equal]", "2"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]1", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Theta]2", "[", "0", "]"}], "\[Equal]", "3"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]2", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", "\[Theta]2"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "maxTime"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", "5000"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{3.398408506976*^9, {3.398410481182*^9, 3.398410492135*^9}},
 CellLabel->
  "In[1444]:=",ExpressionUUID->"b53a207e-d064-4bd5-b653-3c9d0dd75b9b"],

Cell["Extract the two angle solutions:", "Text",
 CellChangeTimes->{
  3.398408506976*^9},ExpressionUUID->"2d3e9c00-85de-40a8-b093-90e585a226c0"],

Cell[BoxData[
 RowBox[{"\[Theta]1", " ", "=", " ", 
  RowBox[{"\[Theta]1", "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.398408506976*^9, {3.3984105021070004`*^9, 3.398410508873*^9}},
 CellLabel->
  "In[1446]:=",ExpressionUUID->"d93345fb-e659-4455-9204-d87211c473e0"],

Cell[BoxData[
 RowBox[{"\[Theta]2", " ", "=", " ", 
  RowBox[{"\[Theta]2", "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellChangeTimes->{3.398408506976*^9, 3.39841051813*^9},
 CellLabel->
  "In[1447]:=",ExpressionUUID->"cd372503-bf26-4d6d-9e3e-ad7c20b4bbf6"],

Cell["Plot the two angular displacements as a function of time:", "Text",
 CellChangeTimes->{3.398408506976*^9, 
  3.398410875924*^9},ExpressionUUID->"4b3cc545-6141-4b27-8706-362457190d0e"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]1", "[", "t", "]"}], ",", 
     RowBox[{"\[Theta]2", "[", "t", "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "maxTime"}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".007", "]"}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".007", "]"}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".01", ",", ".01"}], "}"}], "]"}]}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"6", " ", "72"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{3.398408506976*^9, 3.39841059004*^9},
 CellLabel->
  "In[1448]:=",ExpressionUUID->"9c2b3471-ef09-4ddb-a794-e6087cedeedb"],

Cell[" The initial pendulum angular displacements are:", "Text",
 CellChangeTimes->{
  3.398408506976*^9},ExpressionUUID->"02ed3c3c-7683-45d3-ade7-059d430e1c29"],

Cell[BoxData[
 RowBox[{"plotPendulums", "[", "0", "]"}]], "Input",
 CellLabel->
  "In[1449]:=",ExpressionUUID->"91279092-0de0-4960-91b7-ebf2e02b91e4"],

Cell["\<\
Animate a time sequence of plots to indicate the pendulum positions as a \
function of time:\
\>", "Text",
 CellChangeTimes->{
  3.398408506977*^9, {3.398410644008*^9, 
   3.398410656026*^9}},ExpressionUUID->"f308f83d-76eb-4ee7-9ac2-7ab7de755cf8"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plotPendulums", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "maxTime"}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "maxTime"}]}], "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{
  3.398408506977*^9, {3.398410663388*^9, 3.398410706823*^9}, {
   3.398680728738211*^9, 3.3986807506088715`*^9}},
 CellLabel->
  "In[1450]:=",ExpressionUUID->"3d664309-f086-4c95-963d-53aad0762534"],

Cell["\<\
Animate the plots, while slowing the animation using the controls located at \
the top.  Observe that the motion of the lower pendulum causes the upper \
pendulum to move as well.  Eventually, the viscous damping will slow the \
pendulums until they stop moving,\
\>", "Text",
 CellChangeTimes->{
  3.398408506977*^9, {3.398410966594*^9, 
   3.398410986105*^9}},ExpressionUUID->"9a3b6315-945c-436f-bc4c-e073e4c61320"]
}, Closed]],

Cell[CellGroupData[{

Cell["Visualizing the Four-Dimensional Phase Space", "Section",
 CellChangeTimes->{
  3.398408506977*^9},ExpressionUUID->"ad4b0dab-95a9-4e83-9dce-8a4c29c82ed5"],

Cell["\<\
The following development is intended to illustrate how the behavior of each \
individual pendulum is interrelated by the coupled nonlinear second-order ODE \
system.  What we would like to do, is examine the phase plane for each \
individual pendulum.  However, the phase plane of one pendulum depends \
directly upon the current behavior of the other pendulum, and therefore is \
not constant in time.  The correct way to visualize this problem is as a \
four-dimensional phase space, rather than two separate phase planes.  The \
solution orbits would move in this four-dimensional phase space producing the \
range of behavior illustrated above.  However, there is no way to display a \
four-dimensional graph on a computer screen.  Therefore, we will illustrate \
some of the behavior of the four-dimensional phase space by graphing two \
2-dimensional slices.  One 2-dimensional slice corresponds to \[Theta]1 and \
\[Theta]1' for fixed values of both \[Theta]2 and \[Theta]2'.  The second \
2-dimensional slice corresponds to \[Theta]2 and \[Theta]2' for fixed values \
of both \[Theta]1 and \[Theta]1'.  Please understand that the 2-dimensional \
slices move through the four-dimensional phase space in such a way as to \
follow the solution orbit.  Therefore, as expected, each 2-dimensional phase \
plane will exhibit behavior related to the behavior of the other, and will \
therefore change with time.  However, please realize that the overall \
behavior of the 4-dimensional phase space is time independent because the \
coefficients in the second order nonlinear ODE system are all independent of \
time.  Therefore, a solution orbit starting with initial conditions \
\[Theta]1, \[Theta]1', \[Theta]2 and \[Theta]2' will follow a unique path \
through the 4-dimensional phase space.

Our first step is to reduce the two second-order ODEs into four first-order \
ODEs.  This is accomplished in the usual way by introducing new variables:
\t\[Theta]1[t]\[Rule]\[Theta]1a
\t\[Theta]1'[t]\[Rule]\[Theta]1p
\t\[Theta]2[t]\[Rule]\[Theta]2a
\t\[Theta]2'[t]\[Rule]\[Theta]2p\
\>", "Text",
 CellChangeTimes->{
  3.39840850698*^9},ExpressionUUID->"bf2bc1e2-d309-4e2f-b874-8e711dcfb121"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
  "L1", ",", "m1", ",", "k1", ",", "L2", ",", "m2", ",", "k2", ",", "g", ",", 
   "\[Theta]1", ",", "\[Theta]2"}], "]"}]], "InputOnly",
 CellChangeTimes->{3.39840850698*^9},
 CellLabel->
  "In[1451]:=",ExpressionUUID->"f9552d46-90e7-4d47-8ddb-079847568568"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]1", "[", "t", "]"}], "\[Rule]", "\[Theta]1a"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]1", "'"}], "[", "t", "]"}], "\[Rule]", "\[Theta]1p"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]2", "[", "t", "]"}], "\[Rule]", "\[Theta]2a"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]2", "'"}], "[", "t", "]"}], "\[Rule]", 
      "\[Theta]2p"}]}], "}"}]}], ";"}]], "InputOnly",
 CellChangeTimes->{3.39840850698*^9},
 CellLabel->
  "In[1452]:=",ExpressionUUID->"18388574-241d-4384-adfc-8d90463b9ad6"],

Cell["\<\
Recall that our two second-order ODEs are contained in: firstEqn and \
secondEqn.  Also, reducing a second order ordinary differential equation to a \
first-order system will introduce two additional ODEs (which arise from the \
definition of our new variables):
\t\[Theta]1'[t] = \[Theta]1p
\t\[Theta]2'[t] = \[Theta]2p
Create a list of all four first-order differential equations and substitute \
the new variables into the right hand side of each equation:\
\>", "Text",
 CellChangeTimes->{
  3.39840850698*^9},ExpressionUUID->"4fc83cc1-e310-4c99-b16c-8ba7f5fb3cbf"],

Cell[BoxData[
 RowBox[{"allEqs", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Theta]1", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", "\[Theta]1p"}], 
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"firstEqn", "/.", "\[InvisibleSpace]", "rules"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Theta]2", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", "\[Theta]2p"}], 
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"secondEqn", "/.", "\[InvisibleSpace]", "rules"}]}], 
   "\[IndentingNewLine]", "}"}]}]], "Input",
 CellChangeTimes->{
  3.398408506981*^9, {3.398411047678*^9, 3.3984110735880003`*^9}},
 CellLabel->
  "In[1453]:=",ExpressionUUID->"c4ae1f72-8db9-4f27-8c56-8ecd54772b1d"],

Cell["\<\
Rearrange our first order system of four equations so that the terms \
containing the first-order derivatives appear on the left-hand side (Observe \
that I did not explicitly express the second derivatives as first derivatives \
in the new variables, i.e. \[Theta]1''[t] = \[Theta]1p' and \[Theta]2''[t] = \
\[Theta]2p'):\
\>", "Text",
 CellChangeTimes->{
  3.398408506981*^9},ExpressionUUID->"9b62874a-8305-4978-b527-b5901d6871b0"],

Cell[BoxData[
 RowBox[{"allEqsNew", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Simplify", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"allEqs", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], ",", 
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["\[Theta]1", "\[Prime]",
          MultilineFunction->None], "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], ",", 
       RowBox[{
        SuperscriptBox["\[Theta]2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], ",", 
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["\[Theta]2", "\[Prime]",
          MultilineFunction->None], "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{3.398408506988*^9},
 CellLabel->
  "In[1454]:=",ExpressionUUID->"a25c8135-f526-40ea-a61c-a1a539ce8396"],

Cell["Examine our replacement rules in TableForm:", "Text",
 CellChangeTimes->{
  3.398408506988*^9},ExpressionUUID->"8c116c3f-e7db-45a6-b3fb-ba13ae08fc21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"allEqsNew", "//", "Flatten"}], "//", "TableForm"}]], "Input",
 CellChangeTimes->{
  3.398408506988*^9, {3.3984111071429996`*^9, 3.3984111376540003`*^9}},
 CellLabel->
  "In[1455]:=",ExpressionUUID->"f40fb703-50ff-4cc2-84ba-3d210d19cdf3"],

Cell["\<\
Define our first 2-dimensional slice of the four-dimensional phase plane:

\t{\[Theta]1a,\[Theta]1p,\[Theta]2a,\[Theta]2p} = {\[Theta]1a,\[Theta]1p,\
\[Theta]2'[t],\[Theta]2''[t]}
\t
where the 2 dimensional slice passes through the point \
{\[Theta]2'[t],\[Theta]2''[t]} containing the current value of the solution \
orbit for the second pendulum.  Remember, \[Theta]1'[t] and \[Theta]1''[t] \
will be replaced by the right hand side of the ODE system calculated above: \
\>", "Text",
 CellChangeTimes->{
  3.3984085069890003`*^9, {3.3984111493900003`*^9, 
   3.398411154863*^9}},ExpressionUUID->"4f9c189e-b015-4a90-ac5e-4286ce1514dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{
   "\[Theta]1a_", ",", "\[Theta]1p_", ",", "\[Theta]2a_", ",", 
    "\[Theta]2p_"}], "]"}], "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]1", "'"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]1", "'"}], "'"}], "[", "t", "]"}]}], "}"}], " ", "/.", 
   RowBox[{"Flatten", "[", "allEqsNew", "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.3984085069890003`*^9, {3.398411163031*^9, 3.3984111727209997`*^9}},
 CellLabel->
  "In[1456]:=",ExpressionUUID->"7a4d5097-d336-4858-826e-fc9f08d8309c"],

Cell["\<\
Define our second 2-dimensional slice of the four-dimensional phase plane:
\t{\[Theta]1a,\[Theta]1p,\[Theta]2a,\[Theta]2p} = \
{\[Theta]1'[t],\[Theta]1''[t],\[Theta]2a,\[Theta]2p}
where the 2 dimensional slice passes through the point \
{\[Theta]1'[t],\[Theta]1''[t]} containing the current value of the solution \
orbit for the first pendulum.  Remember, \[Theta]2'[t] and \[Theta]2''[t] \
will be replaced by the right hand side of the ODE system calculated above: \
\>", "Text",
 CellChangeTimes->{
  3.3984085069890003`*^9},ExpressionUUID->"5332ac77-9d86-44af-ab78-\
9c50728a2d71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{
   "\[Theta]1a_", ",", "\[Theta]1p_", ",", "\[Theta]2a_", ",", 
    "\[Theta]2p_"}], "]"}], "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]2", "'"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]2", "'"}], "'"}], "[", "t", "]"}]}], "}"}], " ", "/.", 
   RowBox[{"Flatten", "[", "allEqsNew", "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.3984085069890003`*^9, {3.398411186866*^9, 3.398411196634*^9}},
 CellLabel->
  "In[1457]:=",ExpressionUUID->"f8afbf4c-dd44-46f9-b215-dac32e2fd374"],

Cell["\<\

Specify the same numerical values for our system parameters as used in the \
previous section:\
\>", "Text",
 CellChangeTimes->{
  3.3984085069890003`*^9},ExpressionUUID->"136e3306-4fc4-48e4-b3e3-\
d7df4ccc3dea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L1", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m1", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k1", "=", ".5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L2", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m2", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k2", "=", "k1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", "32"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxTime", "=", "15"}], ";"}]}], "InputOnly",
 CellChangeTimes->{3.39840850699*^9, {3.398411206251*^9, 3.398411207609*^9}},
 CellLabel->
  "In[1458]:=",ExpressionUUID->"77728ea1-844e-45bc-8e98-978e45299dda"],

Cell["Solve our ODE system:", "Text",
 CellChangeTimes->{
  3.39840850699*^9},ExpressionUUID->"b35ffa10-7752-4c46-9ed7-55882bbf52be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"\[Theta]1", ",", "\[Theta]2"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"solnRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "firstEqn", ",", "\[IndentingNewLine]", "secondEqn", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Theta]1", "[", "0", "]"}], "\[Equal]", "2"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]1", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Theta]2", "[", "0", "]"}], "\[Equal]", "3"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]2", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", "\[Theta]2"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "maxTime"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", "5000"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{3.39840850699*^9, {3.398411214861*^9, 3.398411223757*^9}},
 CellLabel->
  "In[1466]:=",ExpressionUUID->"b1b99b9f-c80f-4363-8561-54e365d7d8a3"],

Cell["Extract our two solutions:", "Text",
 CellChangeTimes->{
  3.39840850699*^9},ExpressionUUID->"4118f083-af96-4cbb-ac82-8dfc0b4923b7"],

Cell[BoxData[
 RowBox[{"\[Theta]1", " ", "=", " ", 
  RowBox[{"\[Theta]1", "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellChangeTimes->{3.398408506991*^9, {3.39841123406*^9, 3.398411242692*^9}},
 CellLabel->
  "In[1468]:=",ExpressionUUID->"3629b3f8-5eb1-40fc-84f0-579560643288"],

Cell[BoxData[
 RowBox[{"\[Theta]2", " ", "=", " ", 
  RowBox[{"\[Theta]2", "/.", 
   RowBox[{"Flatten", "[", "solnRules", "]"}]}]}]], "Input",
 CellChangeTimes->{3.398408506991*^9, 3.398411257324*^9},
 CellLabel->
  "In[1469]:=",ExpressionUUID->"bf3305ed-da83-4191-9262-6b45d5c41e52"],

Cell["\<\
The following graph illustrates the behavior of the first pendulum in terms \
of: \[Theta]1[t] and \[Theta]1'[t].  The behavior illustrated below is very \
involved, and would require a tremendous number of vector field graphs in \
order to visualize correctly.  Therefore, we are going to illustrate the \
changing 2-dimensional slice of the four-dimensional phase plane only over \
the time interval from 0 to 4.  This shorter time interval still contains \
significant behavior, but is short enough to allow an animation on your \
computer system.\
\>", "Text",
 CellChangeTimes->{
  3.398408506991*^9, {3.3984232309189997`*^9, 
   3.3984232368380003`*^9}},ExpressionUUID->"d978a854-c998-4166-8837-\
86bd23e5c290"],

