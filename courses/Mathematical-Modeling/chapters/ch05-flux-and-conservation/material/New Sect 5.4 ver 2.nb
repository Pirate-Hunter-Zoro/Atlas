Cell[CellGroupData[{

Cell["\<\
  Numerical solution 
  Non-uniform density solution
  >> High density
  >> Lower upstream density:\
\>", "Section",ExpressionUUID->"5a5bb578-bf94-4a68-bf6d-1bcd642f787e"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}]}]}]], "InputOnly",
 CellLabel->
  "In[162]:=",ExpressionUUID->"40f2d129-91d5-4f56-b6a1-3bcbdab1af47"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"um", " ", "=", " ", "55"}], ";"}], "       ", 
  RowBox[{"(*", "  ", 
   RowBox[{"miles", " ", "/", " ", "hour"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]m", " ", "=", " ", 
    RowBox[{"5280", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "15"}], ")"}]}]}], ";"}], "        ", 
  RowBox[{"(*", "  ", 
   RowBox[{"cars", " ", "/", " ", "mile"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
   RowBox[{"um", " ", 
    RowBox[{"(", " ", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[164]:=",ExpressionUUID->"0dd67b71-3683-4268-9fdb-ceb37043efc3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", "[", 
   RowBox[{"x_", ",", "x1_", ",", "y1_", ",", "x2_", ",", "y2_"}], "]"}], "=",
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Which", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "\[LessEqual]", "x1"}], ",", "y1", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"x", "\[GreaterEqual]", "x2"}], ",", "y2", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "True", ",", 
    RowBox[{
     FractionBox[
      RowBox[{"y1", " ", 
       RowBox[{"(", 
        RowBox[{"x", "-", "x2"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]], "+", 
     FractionBox[
      RowBox[{"y2", " ", 
       RowBox[{"(", 
        RowBox[{"x1", "-", "x"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[169]:=",ExpressionUUID->"5a5c6db8-1b1c-402d-b11a-9c4896ca88e0"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]0", "[", 
    RowBox[{"x", ",", "50", ",", 
     RowBox[{".6", " ", "\[Rho]m"}], ",", "90", ",", 
     RowBox[{".8", " ", "\[Rho]m"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]0\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985228233591805`*^9, 3.3985228281716805`*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"f46e1bcb-841f-4690-befa-d4659ab8ee07"],

Cell["Restrict the maximum time:", "Text",ExpressionUUID->"a6d08861-3221-4e32-b8ef-f324b35c6cf8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", " ", "=", "1.75"}], ";"}]], "InputOnly",
 CellLabel->
  "In[171]:=",ExpressionUUID->"096fcb6c-d7f7-461d-9ad5-3737795bfcd2"],

Cell["\<\
Calculate the numerical solution for this initial density distribution:\
\>", "Text",ExpressionUUID->"eca076a6-15d0-4982-ba15-a3250c876b9a"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", 
           RowBox[{"\[Rho]", "[", 
            RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", 
        RowBox[{"x", ",", "50", ",", 
         RowBox[{".6", " ", "\[Rho]m"}], ",", "90", ",", 
         RowBox[{".8", " ", "\[Rho]m"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{".6", " ", "\[Rho]m"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{".8", " ", "\[Rho]m"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1000", ",", "15000"}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PrecisionGoal", "\[Rule]", "6"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3985240571873055`*^9, 3.3985240689216805`*^9}, 
   3.3985261231091805`*^9, {3.5305361240151567`*^9, 3.530536128211584*^9}, {
   3.751137499725312*^9, 3.7511375077973127`*^9}, {3.7511375425273123`*^9, 
   3.7511376020733123`*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"5352fbd7-822d-493d-9c96-48c149bcdda0"],

Cell["Plot the car density:", "Text",ExpressionUUID->"bbfaab51-a63d-4fd9-a67c-223414090dbb"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<\[Rho][x,t]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ViewPoint", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.552"}], ",", 
      RowBox[{"-", "2.245"}], ",", "2.000"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\< \[Rho]\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985228346091805`*^9, {3.3985240738123055`*^9, 3.3985240833748055`*^9}, {
   3.7511375158613124`*^9, 3.751137534220312*^9}},
 CellLabel->
  "In[186]:=",ExpressionUUID->"485533b3-4c75-402d-a3bb-74d875679517"],

Cell["\<\
The above graph illustrates that the high density region migrates backwards \
in time.  The reason for this is that at higher densities (i.e. very low \
velocities) the highway begins to fill with cars.  This is a classic example \
of bumper to bumper traffic.  Because there are high speed (i.e. low density) \
cars upstream approaching the slower moving traffic, then the interval \
between high and low density cars will decrease to zero.  This will \
eventually generate a shock.\
\>", "Text",ExpressionUUID->"15632a1f-ae00-4557-8492-fad24e5871d4"],

Cell["Examine the velocity at each location and time:", "Text",ExpressionUUID->"e6008dfb-5ae6-46af-b0c7-b3256b09e1ff"],

