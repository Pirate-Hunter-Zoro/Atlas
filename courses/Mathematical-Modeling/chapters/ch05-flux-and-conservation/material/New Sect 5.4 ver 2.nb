     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho] \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985227897185555`*^9, {3.3985239733435555`*^9, 3.3985239883279305`*^9}, 
