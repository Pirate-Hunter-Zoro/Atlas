   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]   \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985228772498055`*^9, {3.3985241576248055`*^9, 3.3985241791091805`*^9}, {
   3.3985267931404305`*^9, 3.3985267933435555`*^9}, 3.7511376890373125`*^9},
 CellLabel->
