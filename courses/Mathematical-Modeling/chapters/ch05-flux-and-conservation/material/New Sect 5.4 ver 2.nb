Cell["Restrict the maximum time:", "Text",ExpressionUUID->"fa526b50-4c46-4d5e-bbd3-4091ef07fa0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", " ", "=", "1.5"}], ";"}]], "InputOnly",
 CellLabel->
  "In[151]:=",ExpressionUUID->"923e7428-f994-44d1-b240-f98182c1424e"],

Cell["\<\
Calculate the numerical solution for this initial density distribution:\
\>", "Text",ExpressionUUID->"3cc25db1-ca8b-4aca-8932-ed0116bae697"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", 
           RowBox[{"\[Rho]", "[", 
            RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", 
        RowBox[{"x", ",", "50", ",", 
         RowBox[{".8", " ", "\[Rho]m"}], ",", "90", ",", 
         RowBox[{".6", " ", "\[Rho]m"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{".8", " ", "\[Rho]m"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{".6", " ", "\[Rho]m"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1000", ",", "10000"}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PrecisionGoal", "\[Rule]", "6"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3985239616716805`*^9, 3.3985239674685555`*^9}, {
  3.3985260288279305`*^9, 3.3985260424373055`*^9}, {3.5305360516306925`*^9, 
  3.5305360730808306`*^9}, {3.7511374274613123`*^9, 3.7511374365923123`*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"a72c4b3c-49c8-420d-bf7a-653a698df2ec"],

