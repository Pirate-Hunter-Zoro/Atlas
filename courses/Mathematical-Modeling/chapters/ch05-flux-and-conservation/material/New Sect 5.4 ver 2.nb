      RowBox[{"\[Rho]", "\[Rule]", 
       RowBox[{".4", " ", "\[Rho]m"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]m", " ", 
         RowBox[{"(", 
