Cell[CellGroupData[{

Cell["\<\
  Boundary conditions
  >> With interior influence:\
\>", "Section",ExpressionUUID->"0d12628e-2849-4844-bb1e-5d9fdbd20caa"],

Cell[TextData[{
 "For our problem it is possible to specify boundary conditions at the entry \
point (i.e. x = 0) and at the exit point (i.e. x = L).  \n\nHowever, our \
examination of the slope of characteristic curves indicates that only \
characteristics that slope to the right will have an influence at the left \
boundary point.  This condition corresponds to left boundary condition which \
has a density < \[Rho]m / 2.\n\nLikewise, the slope of the characteristics \
must be negative (corresponding to densities > \[Rho]m / 2) for the right \
boundary condition to have any influence on the interior domain.  \n\nAs a \
second example, consider specifying a low density boundary condition at the \
left boundary point:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"0", ",", "t"}], "]"}], "   ", "=", "    ", 
    RowBox[{"\[Rho]m", "*", 
     RowBox[{"t", "/", "2"}]}]}], TraditionalForm]],ExpressionUUID->
  "eef2a110-1323-4cac-8113-548d692003ad"],
 "\n\t\n and a high density boundary condition at the right boundary point:\n \
\n\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"L", ",", "t"}], "]"}], "   ", "=", "    ", 
    RowBox[{"\[Rho]m", " ", "-", 
     RowBox[{"\[Rho]m", "*", 
      RowBox[{"t", "/", "2"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "44726502-83a1-4a80-a1ff-3b536a256ac1"],
 "\n\t \n   This will guarantee that both the left and the right boundary \
conditions will influence the interior domain:\n"
}], "Text",
 CellChangeTimes->{{3.466529809290916*^9, 
  3.466529814197072*^9}},ExpressionUUID->"9182a384-ab13-4044-87ba-\
bf571198e057"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}]}]}]], "InputOnly",
 CellLabel->
  "In[240]:=",ExpressionUUID->"edf57597-e779-4772-8670-9d5d1eb36afd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"um", " ", "=", " ", "55"}], ";"}], "       ", 
  RowBox[{"(*", "  ", 
   RowBox[{"miles", " ", "/", " ", "hour"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]m", " ", "=", " ", 
    RowBox[{"5280", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "15"}], ")"}]}]}], ";"}], "        ", 
  RowBox[{"(*", "  ", 
   RowBox[{"cars", " ", "/", " ", "mile"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
   RowBox[{"um", " ", 
    RowBox[{"(", " ", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[242]:=",ExpressionUUID->"43d21f97-f97a-4d7a-9c64-0f9544254095"],

Cell["Consider an uneven density distribution:", "Text",ExpressionUUID->"37778d28-78dd-435f-9dbe-a11592b6a813"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox[
    RowBox[{"\[Rho]m", " ", "x"}], "L"], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]0\>\""}], "}"}]}]}], 
