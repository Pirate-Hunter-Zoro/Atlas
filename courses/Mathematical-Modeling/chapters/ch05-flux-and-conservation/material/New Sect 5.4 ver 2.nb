    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<u  \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985228398279305`*^9, {3.3985240894060555`*^9, 3.3985240912810555`*^9}, 
   3.7511376148303127`*^9},
 CellLabel->
  "In[187]:=",ExpressionUUID->"78332009-47fc-43e0-928a-cf7146b5a428"],

