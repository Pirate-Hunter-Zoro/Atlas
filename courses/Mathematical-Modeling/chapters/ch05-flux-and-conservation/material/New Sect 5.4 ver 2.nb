Cell[CellGroupData[{

Cell["\<\
  Numerical solution 
  Non-uniform density solution
  >> Low density
  >> Lower upstream density:\
\>", "Section",ExpressionUUID->"f24726f2-0067-4103-8487-2ec948649c06"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}]}]}]], "InputOnly",
 CellLabel->"In[63]:=",ExpressionUUID->"b716d625-1db9-4ae7-8ec4-f405f11c739c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"um", " ", "=", " ", "55"}], ";"}], "       ", 
  RowBox[{"(*", "  ", 
   RowBox[{"miles", " ", "/", " ", "hour"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]m", " ", "=", " ", 
    RowBox[{"5280", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "15"}], ")"}]}]}], ";"}], "        ", 
  RowBox[{"(*", "  ", 
   RowBox[{"cars", " ", "/", " ", "mile"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
   RowBox[{"um", " ", 
    RowBox[{"(", " ", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5"}], ";"}]}], "InputOnly",
 CellLabel->"In[65]:=",ExpressionUUID->"d45a6631-dd23-466f-98c9-da72a0748b9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", "[", 
   RowBox[{"x_", ",", "x1_", ",", "y1_", ",", "x2_", ",", "y2_"}], "]"}], "=",
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Which", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "\[LessEqual]", "x1"}], ",", "y1", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"x", "\[GreaterEqual]", "x2"}], ",", "y2", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "True", ",", 
    RowBox[{
     FractionBox[
      RowBox[{"y1", " ", 
       RowBox[{"(", 
        RowBox[{"x", "-", "x2"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]], "+", 
     FractionBox[
      RowBox[{"y2", " ", 
       RowBox[{"(", 
        RowBox[{"x1", "-", "x"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"a446682a-7b3e-4ae6-83fd-44eeaa44ede5"],

Cell["Consider a new initial density distribution:", "Text",ExpressionUUID->"56348505-a350-48fe-bda6-d2820ac30c56"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]0", "[", 
    RowBox[{"x", ",", "10", ",", 
     RowBox[{".2", " ", "\[Rho]m"}], ",", "60", ",", 
     RowBox[{".4", " ", "\[Rho]m"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]0\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985227004685555`*^9, 3.3985227033279305`*^9}, 
   3.3985246223748055`*^9},
 CellLabel->"In[71]:=",ExpressionUUID->"cebb142d-af50-4558-9beb-371d74f801ee"],

Cell["Restrict the time interval to 1.5 hr:", "Text",ExpressionUUID->"cc02ec70-e50c-494c-8df3-8c5330c91b3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "1.5"}], ";"}]], "InputOnly",
 CellLabel->"In[83]:=",ExpressionUUID->"25e93953-60e4-45ac-8a01-6a1b6c4b2a19"],

Cell["\<\
Calculate the numerical solution for this initial density distribution:\
\>", "Text",ExpressionUUID->"ad67e132-b4be-4a50-aa66-77bfd02a1bf9"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", 
           RowBox[{"\[Rho]", "[", 
            RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", 
        RowBox[{"x", ",", "10", ",", 
         RowBox[{".2", " ", "\[Rho]m"}], ",", "60", ",", 
         RowBox[{".4", " ", "\[Rho]m"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{".2", " ", "\[Rho]m"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{".4", " ", "\[Rho]m"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1000", ",", "15000"}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PrecisionGoal", "\[Rule]", "6"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3985246304998055`*^9, 3.3985246344998055`*^9}, {
   3.3985246704685555`*^9, 3.3985246905623055`*^9}, {3.3985254027966805`*^9, 
   3.3985254090154305`*^9}, {3.3985254655310555`*^9, 3.3985254890623055`*^9}, 
   3.3985255192498055`*^9, {3.3985255596091805`*^9, 3.3985255606873055`*^9}, {
   3.3985255922654305`*^9, 3.3985256053279305`*^9}, {3.5305353310599847`*^9, 
   3.5305353683941345`*^9}, {3.5305353993473125`*^9, 3.5305355860882792`*^9}, 
   3.5305356431705084`*^9, 3.7511369328333125`*^9, {3.751136976918312*^9, 
   3.7511370274363127`*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"35960aa2-171a-488d-bc7e-99687f7826c2"],

