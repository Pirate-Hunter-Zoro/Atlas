(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[" Section 5.4", "Title",ExpressionUUID->"1acc3cda-8ca1-42ad-ab66-5bd970e040a6"],

Cell[TextData[StyleBox["  Highway Traffic",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"884cdaa7-0cfb-45ed-a355-a320e1cb2fec"],

Cell["", "Text",ExpressionUUID->"96ae1bf5-a828-44d8-9da0-460545ca9c71"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly",
 CellChangeTimes->{3.3985158009685555`*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"1acc3d81-584c-462b-828e-80b47effb9ae"],

Cell[CellGroupData[{

Cell["  Introduction:", "Section",
 ExpressionUUID -> "bb6f00b4-1fce-4d28-b64a-a40b29545ab6"],

Cell[TextData[{
 "Consider the problem of cars moving down a long single-lane highway from \
left to right.  This problem, like our river pollution problem, appears to be \
an advective flux model.  However, this model is much more interesting \
because the advective velocity is not always constant.\n\nFrom observations \
of actual traffic patterns, it is known that car velocity depends on traffic \
density in roughly a linear way.  Suppose that ",
 StyleBox["um",
  FontWeight->"Bold"],
 " is the maximum legal speed and ",
 StyleBox["\[Rho]m",
  FontWeight->"Bold"],
 " is the maximum possible car density (which corresponds to bumper to bumper \
traffic).  We will assume that when the cars are bumper to bumper then the \
velocity reaches 0.  Therefore, our linear model for velocity becomes:\n\n\t\
u[ \[Rho] ]  =  um ( 1 - ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["\[Rho]", "\[Rho]m"],
    FontSize->16,
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "be5d2af2-20f8-405a-aec0-b37f807d126b"],
 ")\n\nIt is clear that as the car density approaches zero, then the cars \
travel at the maximum speed.  It is also clear that as the cars reach maximum \
density then the speed reaches zero velocity.\n\nBecause the only mechanism \
for internal flux is advection, then the flux term becomes:\n\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", 
    RowBox[{" ", "Total"}]], TraditionalForm]],ExpressionUUID->
  "d2cc049b-4265-4cc9-9170-14948c74dd77"],
 "  =  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", 
    RowBox[{" ", "Diffusion"}]], TraditionalForm]],ExpressionUUID->
  "8709d901-3064-431b-b237-4d6116795bc1"],
 "  +  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", 
    RowBox[{" ", "Advection"}]], TraditionalForm]],ExpressionUUID->
  "8bb31ab3-1ab2-4b9b-803c-e6f251037d6b"],
 "\n\t\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", 
    RowBox[{" ", "Diffusion"}]], TraditionalForm]],ExpressionUUID->
  "b84f6f23-90ac-4b79-adc9-aa360772e18c"],
 "    =  0  \n\t\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", 
    RowBox[{" ", "Advection"}]], TraditionalForm]],ExpressionUUID->
  "7e7e5d30-ef76-4c1f-a106-1f1188e84480"],
 "  =  -  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"(", 
     RowBox[{"u", " ", "\[Rho]"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "135fb046-d7ec-4367-9e3b-1840ca5c267f"],
 "                          (flux from left to right)\n\t                    \
-  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"(", " ", 
      RowBox[{"um", " ", 
       RowBox[{"(", " ", 
        RowBox[{"1", " ", "-", " ", 
         FormBox[
          StyleBox[
           FractionBox["\[Rho]", "\[Rho]m"],
           FontSize->16,
           FontWeight->"Bold"],
          TraditionalForm]}], ")"}], "  ", "\[Rho]"}], " ", ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"f8c70102-a18d-4500-903c-842ad4795a8a"],
 "   (where the velocity is not constant)\n\t                    -   um",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"1", " ", "-", " ", 
         FormBox[
          StyleBox[
           FractionBox["\[Rho]", "\[Rho]m"],
           FontSize->16,
           FontWeight->"Bold"],
          TraditionalForm]}], ")"}], "  ", "\[Rho]"}], " ", ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"d25c9fcf-c3bf-497c-9189-59239ac5f159"],
 " \n\t                    -   um",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"1", " ", "-", " ", 
         FormBox[
          StyleBox[
           FractionBox["\[Rho]", "\[Rho]m"],
           FontSize->16,
           FontWeight->"Bold"],
          TraditionalForm]}], ")"}], "  ", "\[Rho]"}], " ", ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"ffce88af-d637-484e-ab93-92cbe75bdcac"],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"(", "\[Rho]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "88cdd40c-e991-4cd5-95ec-ada8607e6e8b"],
 "\n\t                    -   um",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      StyleBox[
       FractionBox[
        RowBox[{"2", " ", "\[Rho]"}], "\[Rho]m"],
       FontSize->16,
       FontWeight->"Bold"]}], 
     StyleBox[")",
      FontSize->16]}]}], TraditionalForm]],ExpressionUUID->
  "a9ec8676-e6e8-4064-a9ce-61dafdf2f466"],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"(", "\[Rho]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "ea2c90a9-3fdc-45b5-8c55-6a71fd592c5d"],
 "\n"
}], "Text",ExpressionUUID->"5370801a-63b8-4579-9145-174783502af4"],

Cell[TextData[{
 "Finally, substituting the above terms into our basic conservation law \
yields:\n\n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", "\[Rho]", " ", ")"}]}], TraditionalForm]],
  ExpressionUUID -> "9e4b5318-5b2a-4bc2-8185-421a4ceade13"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{"    ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", " ", 
      SubscriptBox["q", 
       RowBox[{" ", "Total"}]], " ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID -> "fee6a57b-9bd4-4f26-8a9a-e8a2a0e139bf"],
 "  +  k\n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", "\[Rho]", " ", ")"}]}], TraditionalForm]],
  ExpressionUUID -> "b63eb961-0f69-41c2-b394-73ea4db8f3eb"],
 "  =  -  um",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      StyleBox[
       FractionBox[
        RowBox[{"2", " ", "\[Rho]"}], "\[Rho]m"],
       FontSize->16,
       FontWeight->"Bold"]}], 
     StyleBox[")",
      FontSize->16]}]}], TraditionalForm]],
  ExpressionUUID -> "21a55261-386e-4426-8a2b-01aca0c5d8e7"],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"(", "\[Rho]", ")"}]}], TraditionalForm]],
  ExpressionUUID -> "c9dd2614-bf5d-4e10-8017-517a27c78747"],
 "  +  0\n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], " ", ")"}]}], TraditionalForm]],
  ExpressionUUID -> "7f1f89a8-6f0f-42e4-ad8e-2cf22f135ea3"],
 "  =  -  um",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      StyleBox[
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], "\[Rho]m"],
       FontSize->16,
       FontWeight->"Bold"]}], 
     StyleBox[")",
      FontSize->16]}]}], TraditionalForm]],
  ExpressionUUID -> "03cfd8e7-3a90-4aa6-a119-2a6fca8da344"],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"(", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ")"}]}], TraditionalForm]],
  ExpressionUUID -> "bf4e09d9-6349-4147-9c1e-deaab0ec793e"],
 "\n"
}], "Text",
 ExpressionUUID -> "75dc59ce-2408-445a-9605-7ba2e51cbd42"],

Cell["\<\
We can check to make sure that the above differentiation is correct.  Define \
a formula for our velocity:\
\>", "Text",ExpressionUUID->"57c1b86c-d3a5-4c52-8f03-ae0bf0bab54b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
  RowBox[{"um", " ", 
   RowBox[{"(", " ", 
    RowBox[{"1", " ", "-", " ", 
     FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"a37ae24f-5e1d-43a4-8799-b1b014224950"],

Cell["Then differentiate and simplify:", "Text",ExpressionUUID->"b284623a-26db-4378-acd3-dd23095e6d91"],

Cell[BoxData[
 RowBox[{"Simplify", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"u", "[", " ", 
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", "*", "  ", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985159075466805`*^9, 3.3985159099373055`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"eea1ba35-ea09-4916-a8d4-df16a25badd8"]
}, Closed]],

Cell[CellGroupData[{

Cell["  Characteristics:", "Section",
 ExpressionUUID -> "cd266648-c06f-4961-bb4d-1a9358ff87ba"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellLabel->"In[4]:=",ExpressionUUID->"5887bc6c-6045-4867-9d4c-851234b28607"],

Cell[TextData[{
 "As we view the highway from above, we can observe the individual cars \
moving with their specific velocity from left right.  Because of the \
relationship developed above, the velocity with which individual cars move is \
a function of the local car density.  As such, the density concentrations \
will appear to migrate from one location on the highway to another location \
as fast moving (i.e. low density) cars catch up with slow moving (i.e. high \
density) cars and vice versa.  This creates the appearance that the density \
concentration is moving backwards (when fast cars catch up with slow cars) or \
that the density concentration is moving forwards (when fast cars move out \
ahead of slow cars).  Our conservation PDE is ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " predicting car velocity distribution but rather car density distribution.  \
As such, the solution of the PDE will depend upon the characteristic movement \
of the density distribution (which is only indirectly related to the velocity \
distribution)."
}], "Text",
 CellChangeTimes->{{3.4665286788126216`*^9, 
  3.4665286793751106`*^9}},ExpressionUUID->"54c3baf9-93e1-4cfc-94b0-\
2ad5e44198cf"],

Cell[TextData[{
 "Characteristics correspond to the traveling wave solution of our equation.  \
 It should be clear from the above discussion that our initial density \
condition translates through space and time with the characteristic direction \
(i.e. velocity = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"(", "q", ")"}]}], TraditionalForm]],ExpressionUUID->
  "74aceda5-79c8-4c8f-8547-c2001e923352"],
 " ) which may be ",
 StyleBox["different",
  FontVariations->{"Underline"->True}],
 " than the actual car velocity.   \nConsider the  SPECIAL case of a CONSTANT \
car velocity:\n\n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", "\[Rho]", " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"a131ab7b-0841-4a55-8495-f88cd792dcbe"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", "  ", 
      RowBox[{"u", " ", "\[Rho]"}], "  ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"784b8421-62d5-4f31-aeb8-190f21f00c7a"],
 "  \n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", "\[Rho]", " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"8c3cf6ba-9f40-4cfa-b347-b78907244aaa"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{"u", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"(", "  ", "\[Rho]", "  ", ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"ae66fcc5-28ad-45df-8afa-a2f9e50d3335"],
 "   (when u =  constant)\n\nThe constant velocity case reduces to the \
problem we considered earlier.  For this problem, the slope of the \
characteristics coincides with the actual velocity.   However, the general \
solution to our problem will NOT necessarily have a constant velocity.  The \
velocity is a function of the density and the velocity will vary as the \
density varies.  Therefore, we will derive the characteristic curves \
associated with the general advective flux term.\n\n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", "\[Rho]", " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"a4574132-74f8-4fb3-ad43-fd359244d6bd"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", "  ", 
      RowBox[{
       RowBox[{"u", " ", "[", "\[Rho]", "]"}], "  ", "*", " ", "\[Rho]"}], 
      "  ", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "fd66e130-b657-4a83-bfac-2ded22a706c1"],
 "  \n \t "
}], "Text",ExpressionUUID->"fbed83de-1bf7-4bd4-b10d-a1942fcc6b96"],

Cell[TextData[{
 "The basic idea is to determine the velocity at which one must move so that \
the car density remains constant.  Specifically, we wish to find a path x[t] \
(i.e. a characteristic curve) so that x'[t] is exactly the velocity required \
so that the density remains constant on this path.\n\nTherefore, if this path \
starts at location x[0] at t = 0 with density  \[Rho][ x[0], 0 ] =  \[Rho]0, \
then on the characteristic curve x[t] we will have:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "[", " ", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], " ", "]"}], "  ", "=", "  ", 
    RowBox[{
     RowBox[{"\[Rho]", "[", " ", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], ",", "0"}], " ", "]"}], " ", "=", "  ", 
     "\[Rho]0"}]}], TraditionalForm]],ExpressionUUID->
  "a30e4198-286f-4f4a-b32b-6b93cb5f21bd"],
 "\n\t\nDifferentiating the left-hand side yields:"
}], "Text",
 CellChangeTimes->{
  3.3985160110623055`*^9},ExpressionUUID->"ee6ade4b-ecef-4251-94b1-\
d25552135ce9"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "t"], " ", 
  RowBox[{"(", " ", 
   RowBox[{"\[Rho]", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"7e01d338-83b6-43eb-be75-6f9006a51e94"],

Cell["Differentiating the right hand side yields:", "Text",ExpressionUUID->"cf085618-2c71-4b62-acba-b55fb44c5683"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "t"], "  ", "\[Rho]0"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"03881118-e919-4152-b33a-bb8e2a2a69c1"],

Cell[TextData[{
 "We are now going to substitute the PDE evaluated on the characteristic \
curve x[t].  Our conservation PDE for advective flux is:\n\n\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], " ", "=", " ", 
    RowBox[{"-", "  ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", "q"}]}]}], TextForm], "\n", 
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], " ", "=", " ", 
    RowBox[{"-", "  ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", 
      RowBox[{"q", "[", "\[Rho]", "]"}]}]}]}], TextForm]}], "Text",
  ExpressionUUID->"8fc64329-cd77-41d6-8e3a-94f29db909b1"],
 "\n\t\nWhere the flux in our problem is a function of the local car density. \
 \nEvaluating the left-hand side of our PDE on the characteristic curve \
yields:"
}], "Text",ExpressionUUID->"16644d91-5eea-4207-bbd3-95ddbd4d450e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", "t"], " ", 
   RowBox[{"(", " ", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "/.", " ", 
  RowBox[{"x", " ", "\[Rule]", " ", 
   RowBox[{"x", "[", "t", "]"}]}]}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"a0561f7a-db08-42fa-8789-ddf86ea498f2"],

Cell["\<\
Evaluating the right hand side of our PDE on the characteristic curve yields\
\>", "Text",ExpressionUUID->"1d36dc0a-5390-4fc8-9257-0535f0ad6ba3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", " ", 
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"(", " ", 
     RowBox[{"q", "[", 
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], "]"}], ")"}]}]}], "   ", "/.", " ", 
  RowBox[{"x", " ", "\[Rule]", " ", 
   RowBox[{"x", "[", "t", "]"}]}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"d9cf9ca0-4674-4899-b950-ef016e859114"],

Cell["\<\
Taking the time derivative of our density from above and substituting our PDE \
(evaluated on the characteristic curve) yields:\
\>", "Text",ExpressionUUID->"7db486a9-6686-4926-a22f-02c924a9b9a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", "t"], " ", 
   RowBox[{"(", " ", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], ")"}]}], "  ", "/.", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "t"], " ", 
      RowBox[{"(", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "   ", "\[Rule]", " ", 
     RowBox[{"-", " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], " ", 
       RowBox[{"(", " ", 
        RowBox[{"q", "[", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}], "]"}], ")"}]}]}]}], "/.", " ", 
    RowBox[{"x", " ", "\[Rule]", " ", 
     RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.3985159532341805`*^9, 3.3985159560935555`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"73b4e010-54d7-49cc-9692-23b138b724b5"],

Cell["Solving for x'[t] yields:", "Text",ExpressionUUID->"0cedc23e-742d-4053-83d2-f565de3b469a"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        SuperscriptBox["q", "\[Prime]",
         MultilineFunction->None], "[", 
        RowBox[{"\[Rho]", "[", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}], " ", 
      RowBox[{
       SuperscriptBox["\[Rho]", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"1", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], " ", 
      RowBox[{
       SuperscriptBox["\[Rho]", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"1", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]}], "\[Equal]", 
    "0"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    SuperscriptBox["x", "\[Prime]",
     MultilineFunction->None], "[", "t", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{3.3985159764841805`*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"8bce1e7b-72f4-4d8f-b9f0-e6a38384bcb8"],

Cell["\<\
Because the density on our characteristic curve is constant, it is therefore \
equal to the initial density  \[Rho]0:\
\>", "Text",ExpressionUUID->"a28b1b9c-11fb-482b-93ee-526af949326a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "\[Prime]",
     MultilineFunction->None], "[", "t", "]"}], "==", 
   RowBox[{
    SuperscriptBox["q", "\[Prime]",
     MultilineFunction->None], "[", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}], "   ", "/.", 
  "  ", 
  RowBox[{
   RowBox[{"\[Rho]", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "  ", "\[Rule]", "  ", 
   "\[Rho]0"}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"757d7806-affd-4904-9877-8b6a02de565c"],

Cell[TextData[{
 "The above equation represents the required velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "'"}], "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "9ed321ff-e075-440e-a6d1-b3c4928c9b5d"],
 " that will maintain a constant density through space and time. \n\n\
Integrating the velocity yields the characteristic curve:"
}], "Text",
 CellChangeTimes->{
  3.3985159983591805`*^9},ExpressionUUID->"8f0be94a-c3d8-45a4-bed2-\
265c8ac106b8"],

Cell[BoxData[
 RowBox[{"\[Integral]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "'"}], "[", "s", "]"}], 
   RowBox[{"\[DifferentialD]", "s", "  "}]}]}]], "Input",
 CellChangeTimes->{{3.7505995006894264`*^9, 3.7505995165140085`*^9}, {
  3.750617419585372*^9, 3.7506174366520786`*^9}, {3.750617541287541*^9, 
  3.750617547247137*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"50c6e463-78bd-4a04-936b-758713b44e5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], "-", 
   RowBox[{"x", "[", "0", "]"}]}], "     ", "==", "     ", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "t"], 
   RowBox[{
    RowBox[{
     SuperscriptBox["q", "\[Prime]",
      MultilineFunction->None], "[", "\[Rho]0", "]"}], 
    RowBox[{"\[DifferentialD]", "s"}]}]}]}]], "Input",
 CellChangeTimes->{{3.750617567249137*^9, 3.7506175797703886`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"65bf3496-8512-44c1-a1df-4adccdd07ff9"],

Cell["Solve for x[t]:", "Text",ExpressionUUID->"2e112fdc-14d6-4a2e-a3de-03673c469542"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"x", "[", "0", "]"}]}], "+", 
     RowBox[{"x", "[", "t", "]"}]}], " ", "==", " ", 
    RowBox[{"t", " ", 
     RowBox[{
      SuperscriptBox["q", "\[Prime]",
       MultilineFunction->None], "[", "\[Rho]0", "]"}]}]}], ",", " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"x", "[", "t", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985160344685555`*^9, 3.3985160387810555`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"8de49e95-345a-4d36-a10d-12c4d690e7d0"],

Cell["\<\
The above equation is the characteristic curve along which the density \
remains constant.  Observe that the slope of this curve is constant for each \
initial density.

Next, substitute the equation for flux:\
\>", "Text",ExpressionUUID->"cb758394-4fc4-407b-b63f-7950aae06be6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"q", "[", "\[Rho]_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"u", "[", "\[Rho]", "]"}], " ", "*", " ", "\[Rho]"}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"bdeb5d85-5321-4267-a4aa-78c86e6a8372"],

Cell["\<\
Evaluate the derivative of the flux term within the characteristic curve:\
\>", "Text",ExpressionUUID->"2a5b4e25-ebaf-46a4-8922-264463c914ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "[", "t", "]"}], "==", 
  RowBox[{
   RowBox[{"x", "[", "0", "]"}], "+", 
   RowBox[{"t", " ", 
    RowBox[{
     SuperscriptBox["q", "\[Prime]",
      MultilineFunction->None], "[", "\[Rho]0", "]"}]}], "  "}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"e586972e-cd05-4c95-bfcc-0aad87d4e5e3"],

Cell["\<\
Next, enter our equation for the traffic velocity as a function of car \
density:\
\>", "Text",ExpressionUUID->"fb232fc0-775a-4397-a729-0c1dd26a271a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
  RowBox[{"um", " ", 
   RowBox[{"(", " ", 
    RowBox[{"1", " ", "-", " ", 
     FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"a37ae24f-5e1d-43a4-8799-b1b014224950"],

Cell["\<\
Evaluate the derivative within the characteristic curve for this specific \
equation:\
\>", "Text",ExpressionUUID->"b11ec892-49a4-4777-9ef0-48bce19d4258"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "[", "t", "]"}], "==", 
  RowBox[{
   RowBox[{"x", "[", "0", "]"}], "+", 
   RowBox[{"t", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"u", "[", "\[Rho]0", "]"}], "+", 
      RowBox[{"\[Rho]0", " ", 
       RowBox[{
        SuperscriptBox["u", "\[Prime]",
         MultilineFunction->None], "[", "\[Rho]0", "]"}]}]}], 
     ")"}]}]}]}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"e98f203c-f372-4ea1-a328-2651fa3b5fcc"],

Cell["Simplify the equation:", "Text",ExpressionUUID->"f832eac9-018e-4f96-b9ba-4a4028e302b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "[", "t", "]"}], "==", 
  RowBox[{
   RowBox[{"t", " ", 
    RowBox[{"(", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"um", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox["\[Rho]0", "\[Rho]m"]}], ")"}]}], "-", 
       FractionBox[
        RowBox[{"um", " ", "\[Rho]0"}], "\[Rho]m"]}], "]"}], ")"}]}], "+", 
   RowBox[{"x", "[", "0", "]"}]}]}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"3977541a-29be-4b24-b4af-d5b56d6a04ee"],

Cell["\<\
Express the initial density in terms of the initial location x[0]:\
\>", "Text",ExpressionUUID->"befd3340-79f8-4480-bacc-fa63313e93c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], "==", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"(", 
      RowBox[{"um", "-", 
       FractionBox[
        RowBox[{"2", " ", "um", " ", "\[Rho]0"}], "\[Rho]m"]}], ")"}]}], "+", 
    RowBox[{"x", "[", "0", "]"}]}]}], "     ", "/.", "      ", 
  RowBox[{"\[Rho]0", "\[Rule]", 
   RowBox[{"\[Rho]", "[", 
    RowBox[{
     RowBox[{"x", "[", "0", "]"}], ",", "0"}], "]"}]}]}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"9fc9d4ef-baba-417d-9903-0d5a34cb4ef2"],

Cell["\<\
Because the y-axis of our graph will be time, solve the above equation for t:\
\>", "Text",ExpressionUUID->"25dafce8-d179-4cf7-be77-5b41e797ae62"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"x", "==", 
    RowBox[{
     RowBox[{"x", "[", "0", "]"}], "+", 
     RowBox[{"t", " ", 
      RowBox[{"(", 
       RowBox[{"um", "-", 
        FractionBox[
         RowBox[{"2", " ", "um", " ", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], ",", "0"}], "]"}]}], "\[Rho]m"]}], 
       ")"}]}]}]}], ",", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   " ", "t"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985160755154305`*^9, 3.3985160817654305`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"5121599c-74ec-4a63-b2e2-4d36f34a263f"],

Cell["\<\
To illustrate the characteristic curves, consider the values we will use \
below:\
\>", "Text",ExpressionUUID->"39d328b3-875b-4efa-ba40-c0fbecc07dfc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]m", " ", "=", " ", 
   RowBox[{"5280", "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", "15"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"um", " ", "=", " ", "55"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]", "[", 
    RowBox[{"x0_", ",", "0"}], "]"}], "=", " ", 
   FractionBox["\[Rho]m", "3"]}], ";"}]}], "InputOnly",
 CellLabel->"In[22]:=",ExpressionUUID->"500e57f0-64cd-4d5d-bd7a-59820fdabfa0"],

Cell[TextData[{
 "Generate the graph of several characteristic curves using the constant \
density  ",
 Cell[BoxData[
  StyleBox[
   FractionBox["\[Rho]m", "3"],
   FontSize->16,
   FontWeight->"Bold"]],ExpressionUUID->
  "a8a25740-c0f9-48fc-a99f-d65de55c014e"],
 ":"
}], "Text",ExpressionUUID->"4bb05ed8-379a-4401-8343-c99f9d2634cc"],

Cell[BoxData[
 RowBox[{"graph1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]m", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"um", " ", "\[Rho]m"}], "-", 
         RowBox[{"2", " ", "um", " ", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], ",", "0"}], "]"}]}]}]], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], ",", 
         RowBox[{"-", "L"}], ",", "L", ",", "20"}], "}"}]}], "]"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "L"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "tStop"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985160954841805`*^9, 3.3985161262185555`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"6a64c0ed-e595-4a7b-bed6-fd8a1dc7352c"],

Cell["\<\
It is also possible to evaluate the corresponding car velocity for the same \
density.  The car velocity equals u[\[Rho][x[0],0]] and is shown on the graph \
below:\
\>", "Text",ExpressionUUID->"9f15c06a-fd1e-4262-a9d8-559775aa020f"],

Cell[BoxData[
 RowBox[{"graph2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox["x", 
         RowBox[{"u", "[", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], ",", "0"}], "]"}], "]"}]], "-", 
        FractionBox[
         RowBox[{"x", "[", "0", "]"}], 
         RowBox[{"u", "[", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], ",", "0"}], "]"}], "]"}]]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], " ", "L"}], ",", "L", ",", "20"}], "}"}]}], 
      "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", ".03", "}"}], "]"}]}], "}"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "L"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "tStop"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985161370154305`*^9, 3.3985161905310555`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"2d4a3368-9aff-4130-8083-558684deb4e2"],

Cell["", "Text",ExpressionUUID->"14416123-86ac-4218-ad9e-7ada999e754e"],

Cell["\<\
Observe that the characteristic curves move from left to right for this value \
of the density.  (We will show that for higher densities, the characteristic \
curve slopes in the opposite direction).

Superimposing the characteristic velocity along with the car velocity shows \
that they are not the same for this PDE:\
\>", "Text",ExpressionUUID->"4b36eea4-f744-4d8c-8903-ee3ca0927323"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph1", ",", "graph2"}], "]"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"b9073aee-f2c1-4d01-b26b-08b6b07d5fd4"],

Cell[TextData[{
 "The above graph illustrates that the car velocity and the slope of the \
characteristic curve for this particular density are different.\n\nNext, \
consider the characteristic slopes corresponding to different densities.  In \
particular, consider characteristic slopes corresponding to low densities \
(i.e. 0 < ",
 Cell[BoxData[
 "\[Rho]"],ExpressionUUID->"1a3ab674-09a1-45f8-a43e-d818a24d1105"],
 " < ",
 Cell[BoxData[
  FractionBox["\[Rho]m", "2"]],ExpressionUUID->
  "c390b586-eb8f-4cbe-a41a-882f37cc1de7"],
 ")."
}], "Text",ExpressionUUID->"292aad17-a650-47d9-a108-8c66ffa95776"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]m", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"um", " ", "\[Rho]m"}], "-", 
         RowBox[{"2", " ", "um", " ", "\[Rho]"}]}]], "/.", 
       "\[InvisibleSpace]", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Rule]", "50"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "0", ",", 
        FractionBox["\[Rho]m", "2"], ",", 
        FractionBox["\[Rho]m", "11"]}], "}"}]}], "]"}], "\[IndentingNewLine]",
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "tStop"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985162170466805`*^9, {3.3985162565623055`*^9, 3.3985162777341805`*^9}, {
   3.3985163104998055`*^9, 3.3985163221091805`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"5d81251a-5224-4fa6-be84-4b591cd57e77"],

Cell[TextData[{
 "Observe that all of these characteristic curves slope forward (i.e. the \
constant density wave appears to move from left to right on the highway).  \
Also observe that the closer the density is to ",
 Cell[BoxData[
  FractionBox["\[Rho]m", "2"]],ExpressionUUID->
  "8e371886-3b52-4a71-b1eb-9c7a496f66de"],
 ", then the more vertical is the characteristic curve.  Specifically, at \
exactly the density ",
 Cell[BoxData[
  FractionBox["\[Rho]m", "2"]],ExpressionUUID->
  "2ea3d1d2-c776-4bcc-82dd-32aa33a4d5e2"],
 ", the slope will be vertical (i.e. the the constant density curve will \
appear to be stationary relative to the road surface for all subsequent times \
even though the cars are moving with velocity = um/2)."
}], "Text",ExpressionUUID->"c0eb69af-46c0-4a44-a214-c05d2d90c15f"],

Cell[TextData[{
 "Next, consider the characteristic slopes corresponding to higher densities \
(i.e. ",
 Cell[BoxData[
  FractionBox["\[Rho]m", "2"]],ExpressionUUID->
  "dc1c9897-60fa-41dc-b9f3-8e7b3059a972"],
 " < ",
 Cell[BoxData[
 "\[Rho]"],ExpressionUUID->"b37c3912-a9ba-45f2-b661-e79e5e7bfe4a"],
 " < ",
 Cell[BoxData[
 "\[Rho]m"],ExpressionUUID->"a8423a8e-8a5d-49cf-84ae-a12b9daf67ff"],
 ")."
}], "Text",ExpressionUUID->"e93df42c-fc88-4dc7-a8b4-f86f129a3f41"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]m", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"um", " ", "\[Rho]m"}], "-", 
         RowBox[{"2", " ", "um", " ", "\[Rho]"}]}]], "/.", 
       "\[InvisibleSpace]", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Rule]", "50"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "\[Rho]m", ",", 
        FractionBox["\[Rho]m", "2"], ",", 
        RowBox[{"-", 
         FractionBox["\[Rho]m", "11"]}]}], "}"}]}], "]"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "tStop"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985163006716805`*^9, {3.3985163351404305`*^9, 3.3985163433123055`*^9}, {
   3.3985163976091805`*^9, 3.3985164004998055`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"3d2ca684-d888-4a62-868b-508a10e43260"],

Cell["\<\
Observe that all of these characteristic curves slope backwards.  This means \
that for high-density traffic, that a constant density wave will appear to \
move backwards (even though the cars are moving forward).  This gives meaning \
to the phrase \"the traffic is beginning to backup\", which refers not to the \
velocity of the cars but rather to the car density relative to the road.

Finally, plot all possible characteristic curves:\
\>", "Text",ExpressionUUID->"e4e55c4c-4fab-4f58-b459-5c9662cac859"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]m", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"um", " ", "\[Rho]m"}], "-", 
         RowBox[{"2", " ", "um", " ", "\[Rho]"}]}]], "/.", 
       "\[InvisibleSpace]", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Rule]", "50"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "0", ",", "\[Rho]m", ",", 
        FractionBox["\[Rho]m", "21"]}], "}"}]}], "]"}], "\[IndentingNewLine]",
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "tStop"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985164185935555`*^9, 3.3985164369998055`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"0b435ff2-ed37-4c5d-8767-e71fe4e61ca0"],

Cell["\<\
Observe that fast moving low density cars have characteristics that move from \
left to right, and that slow moving high density cars characteristics that \
move from right to left (opposite the actual car velocity).\
\>", "Text",ExpressionUUID->"915813ae-d9d5-48a0-9d2c-356382fc6016"]
}, Closed]],

Cell[CellGroupData[{

Cell["  Closed form solution procedure:", "Section",ExpressionUUID->"99956f36-7bf4-4f8c-b5cb-00159f2b1a0d"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellLabel->"In[33]:=",ExpressionUUID->"f4bbb9ad-37e0-4e8e-b6e3-6ef37da8d98b"],

Cell["\<\
Simple closed form solutions for PDEs are usually difficult if not impossible \
to obtain.  
To obtain this solution, use DSolve (which produces closed form solutions) \
rather than NDSolve (which produces numerical solutions).\
\>", "Text",ExpressionUUID->"f7226ac0-b709-4ec2-9d8f-491835e76505"],

Cell[BoxData[
 RowBox[{
  RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
  RowBox[{"um", " ", 
   RowBox[{"(", " ", 
    RowBox[{"1", " ", "-", " ", 
     FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"2f1471ad-0134-42d2-b1b6-6d05b2367155"],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"\[Rho]", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985164586248055`*^9, 3.3985164595466805`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"d0e753b8-1595-48cc-b9b7-11233b9813a9"],

Cell[TextData[{
 "This nonlinear equation ",
 StyleBox["cannot",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " be solved by Mathematica in closed form.  Therefore, numerical techniques \
must be used."
}], "Text",ExpressionUUID->"9e996e90-f2e7-43c9-8fb6-c326c68bc438"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  Numerical solution 
  >> Uniform density solution:\
\>", "Section",ExpressionUUID->"d95bc751-a12a-48a4-a090-8bfb912db290"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellLabel->"In[36]:=",ExpressionUUID->"dd082828-4e5f-4f6c-857f-1a57736c28e8"],

Cell["\<\
It is also possible to solve the above PDE using numerical techniques.  The \
advantage of this procedure is that the final solution can be found in one \
step.
\
\>", "Text",ExpressionUUID->"ced7de8e-98f2-4a11-81dd-e57760e50abc"],

Cell["\<\
Before we start, define the maximum velocity to be (miles / hour):\
\>", "Text",ExpressionUUID->"d39dc746-0aac-4923-93ee-cfc9e04bf61e"],

Cell[BoxData[
 RowBox[{"um", " ", "=", " ", "55", "       ", 
  RowBox[{"(*", "  ", 
   RowBox[{"miles", " ", "/", " ", "hour"}], "  ", "*)"}]}]], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"9ba161ca-66a8-42fb-836c-9cedf26edc67"],

Cell["\<\
We need to define the maximum car density (measured in cars per mile).  The \
typical length of car is 15 feet.  Assuming that one car length is left \
between two consecutive cars in bumper to bumper traffic, then the maximum \
car density is 176 cars / mile.\
\>", "Text",ExpressionUUID->"5c5f234f-015c-441f-9672-06948b7e0859"],

Cell[BoxData[
 RowBox[{"\[Rho]m", " ", "=", " ", 
  RowBox[{"5280", "/", 
   RowBox[{"(", 
    RowBox[{"2", "*", "15"}], ")"}]}], "        ", 
  RowBox[{"(*", "  ", 
   RowBox[{"cars", " ", "/", " ", "mile"}], "  ", "*)"}]}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"604391c0-dcbc-4450-afa8-1690457f1c96"],

Cell["\<\
Therefore, the formula for the velocity as a function of local density is:\
\>", "Text",ExpressionUUID->"bf6c9f53-c050-41de-8524-a559564839b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
  RowBox[{"um", " ", 
   RowBox[{"(", " ", 
    RowBox[{"1", " ", "-", " ", 
     FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}]], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"c6bf9105-d214-42de-8207-bbbabc6774c4"],

Cell["\<\
 Define our domain as 100 miles long and having 5 hours of time:\
\>", "Text",ExpressionUUID->"68bc6d2a-1dc0-45b1-b335-308a0082102c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5"}], ";"}]}], "InputOnly",
 CellLabel->"In[40]:=",ExpressionUUID->"1620ddcf-a633-41b3-accf-44efe64306d8"],

Cell["\<\
Next, find the numerical solution within the range of x and t values.  Note \
that we had to supply the initial density distribution at t = 0 along with \
the upstream boundary condition at x = 0 and downstream velocity at x = L.   \
We will start by considering the case of a uniform density distribution \
corresponding to one-third of the maximum car density.\
\>", "Text",ExpressionUUID->"b1014fcb-8278-4d0d-9e88-ca659dac0cd2"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", 
           RowBox[{"\[Rho]", "[", 
            RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       FractionBox["\[Rho]m", "3"]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
       FractionBox["\[Rho]m", "3"]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", 
       FractionBox["\[Rho]m", "3"]}]}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985225561873055`*^9, 3.3985225665154305`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"8415472a-ef8c-4d43-927c-8f25cb21a154"],

Cell["Plot the car density:", "Text",ExpressionUUID->"c590cd9a-4d9d-4e2f-ae45-5f0c0fd6a718"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<\[Rho][x,t]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "15"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\\nx-Distance\>\"", ",", "\"\<time\>\"", ",", 
      "\"\<\\n\[Rho] \>\""}], "}"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985225812029305`*^9, 3.3985226291248055`*^9}, {
  3.3985238319841805`*^9, 3.3985238624216805`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"913a6167-01b2-47bc-b405-ed0f06fec0c2"],

Cell["\<\
The above plot indicates that the car density at any location along our 100 \
mile road over a 5 hour interval remains constant at one-third of the maximum \
car density.\
\>", "Text",ExpressionUUID->"03d6002a-c21c-42ad-b12c-8f2a19f3fee6"],

Cell["Examine the velocity at each location and time:", "Text",ExpressionUUID->"b3e28752-101e-4ba1-9843-048ea171e8d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"u", "[", 
   RowBox[{"\[Rho]", "[", 
    RowBox[{"x", ",", "t"}], "]"}], "]"}], "/.", 
  RowBox[{"Flatten", "[", "solutionRule", "]"}]}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"302df611-0c7d-4aba-baa6-403bb46205e1"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<u[\[Rho][x,t]]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "15"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\\nx-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\\nu \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985226387966805`*^9, {3.3985229920466805`*^9, 3.3985230269373055`*^9}, {
   3.3985238182498055`*^9, 3.3985238196248055`*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"40e37b7d-f9dd-416e-9f1e-10642302543c"],

Cell["\<\
Observe that the velocity is constant at all locations and times.  This is \
exactly as expected because the velocity is a function of local car density \
which is also constant at all locations and times.\
\>", "Text",ExpressionUUID->"c4238e52-b310-47e5-8b83-cb79629bf13e"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  Numerical solution 
  Non-uniform density solution
  >> Low density
  >> Higher upstream density:\
\>", "Section",ExpressionUUID->"7b0c8f4b-e147-447c-bb4d-164d885a3e39"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}]}]}]], "InputOnly",
 CellLabel->"In[46]:=",ExpressionUUID->"f4c15732-7125-4dcf-9d37-66b257c52c9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"um", " ", "=", " ", "55"}], ";"}], "       ", 
  RowBox[{"(*", "  ", 
   RowBox[{"miles", " ", "/", " ", "hour"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]m", " ", "=", " ", 
    RowBox[{"5280", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "15"}], ")"}]}]}], ";"}], "        ", 
  RowBox[{"(*", "  ", 
   RowBox[{"cars", " ", "/", " ", "mile"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
   RowBox[{"um", " ", 
    RowBox[{"(", " ", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5"}], ";"}]}], "InputOnly",
 CellLabel->"In[48]:=",ExpressionUUID->"108b10c8-d37b-44ba-98b0-c5677bf62394"],

Cell["\<\
The uniform density solution (although correct) does not illustrate very much \
about the behavior of our traffic problem.  We are interested in \
understanding how traffic moves in response to variations in the density.  We \
might try (as we did for the river problem) to create variations in the \
initial and boundary density distributions so that we can study their \
influence on the interior solution.  However, in this case it will not work.  \
The reason is that the local velocity is a function of the density, and \
therefore variations in the density will produce variations in the solution.  \
With this understanding, consider some special cases where the density \
distribution starts at one level and smoothly changes to another.\
\>", "Text",ExpressionUUID->"43d68672-4ed7-4123-9013-3387db2a77af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", "[", 
   RowBox[{"x_", ",", "x1_", ",", "y1_", ",", "x2_", ",", "y2_"}], "]"}], "=",
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Which", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "\[LessEqual]", "x1"}], ",", "y1", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"x", "\[GreaterEqual]", "x2"}], ",", "y2", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "True", ",", 
    RowBox[{
     FractionBox[
      RowBox[{"y1", " ", 
       RowBox[{"(", 
        RowBox[{"x", "-", "x2"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]], "+", 
     FractionBox[
      RowBox[{"y2", " ", 
       RowBox[{"(", 
        RowBox[{"x1", "-", "x"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"b2cc6fa8-68bd-490e-aa9a-e4eb83c3dba2"],

Cell["\<\
Consider the case of a high upstream car density followed by a low car \
density:\
\>", "Text",ExpressionUUID->"4a1e8863-ab73-4122-bb49-fa07cce65d38"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]0", "[", 
    RowBox[{"x", ",", "10", ",", 
     RowBox[{".4", " ", "\[Rho]m"}], ",", "30", ",", 
     RowBox[{".2", " ", "\[Rho]m"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]0\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985226509998055`*^9, 3.3985226540779305`*^9}, 
   3.3985230514685555`*^9},
 CellLabel->"In[54]:=",ExpressionUUID->"8b30d49e-3d8c-4251-b31f-5042e901e10e"],

Cell["Restrict the time to maximum of two hours:", "Text",ExpressionUUID->"329dfaf5-aaea-4bfd-9ba8-ccedc579cf62"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", "=", "2"}], ";"}]], "InputOnly",
 CellLabel->"In[55]:=",ExpressionUUID->"1d573b96-f90a-446c-8cca-e35a7b54acda"],

Cell["\<\
Calculate the numerical solution for this initial density distribution:\
\>", "Text",ExpressionUUID->"02e119a3-1db2-43a3-9071-f2b5d89c2cb0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", 
           RowBox[{"\[Rho]", "[", 
            RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", 
        RowBox[{"x", ",", "10", ",", 
