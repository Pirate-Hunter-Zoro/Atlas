Cell["\<\
Observe in the above graph that neither the left nor the right boundary \
condition had any influence on the INTERIOR solution.\
\>", "Text",ExpressionUUID->"f9be9197-504a-4950-ad14-76c42f5b4450"],

Cell["\<\
Using the equation developed above for the characteristic curve (along which \
the density is constant), plot the characteristics corresponding to the high \
density and low density regions:\
\>", "Text",ExpressionUUID->"3f4c7bf8-0ced-4018-98b2-eb3d04357f8a"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Rho]0", "[", 
            RowBox[{"x", ",", "0", ",", "1", ",", "0.0001", ",", "0"}], "]"}],
            " ", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Rho]m", " ", 
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
              RowBox[{
               RowBox[{"um", " ", "\[Rho]m"}], "-", 
               RowBox[{"2", " ", "um", " ", "\[Rho]"}]}]], "+", "ti"}], 
            ")"}]}], "/.", "\[InvisibleSpace]", 
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], "\[Rule]", "0"}]}], "/.", 
         "\[InvisibleSpace]", 
         RowBox[{"\[Rho]", "\[Rule]", "\[Rho]m"}]}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Rho]0", "[", 
            RowBox[{"x", ",", 
             RowBox[{".9999", " ", "L"}], ",", "0", ",", "L", ",", "1"}], 
            "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Rho]m", " ", 
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
              RowBox[{
               RowBox[{"um", " ", "\[Rho]m"}], "-", 
               RowBox[{"2", " ", "um", " ", "\[Rho]"}]}]], "+", "ti"}], 
            ")"}]}], "/.", "\[InvisibleSpace]", 
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], "\[Rule]", "L"}]}], "/.", 
         "\[InvisibleSpace]", 
         RowBox[{"\[Rho]", "\[Rule]", "0"}]}]}], "\[IndentingNewLine]", "}"}],
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ti", ",", "0", ",", "tStop", ",", 
        RowBox[{".1", " ", "tStop"}]}], "}"}]}], "\[IndentingNewLine]", "]"}],
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", ".2"}], " ", "L"}], ",", 
     RowBox[{"1.2", " ", "L"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", ".2"}], " ", "L"}], ",", 
        RowBox[{"1.2", " ", "L"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "tStop"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "\[Rule]", 
    FractionBox["1", "1.4"]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{3.3985229322029305`*^9, 3.3985252313279305`*^9, 
