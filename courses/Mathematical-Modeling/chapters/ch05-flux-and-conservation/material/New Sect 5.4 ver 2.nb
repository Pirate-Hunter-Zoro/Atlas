Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"um", " ", "=", " ", "55"}], ";"}], "       ", 
  RowBox[{"(*", "  ", 
   RowBox[{"miles", " ", "/", " ", "hour"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]m", " ", "=", " ", 
    RowBox[{"5280", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "15"}], ")"}]}]}], ";"}], "        ", 
