       RowBox[{".6", " ", "\[Rho]m"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]m", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"um", " ", "\[Rho]m"}], "-", 
