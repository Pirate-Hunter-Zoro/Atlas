Cell["Plot the car density:", "Text",ExpressionUUID->"85342559-62b5-48e3-b7a5-772484897788"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<\[Rho][x,t]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"ViewPoint", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.552"}], ",", 
      RowBox[{"-", "2.245"}], ",", "2.000"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985229680623055`*^9, {3.3985243439216805`*^9, 3.3985243707341805`*^9}, 
   3.751137952319312*^9},
 CellLabel->
  "In[259]:=",ExpressionUUID->"da568cfc-1003-493b-81d8-086527057de2"],

Cell["\<\
Observe in the above graph that both the left and the right boundary \
condition influenced the interior solution.\
\>", "Text",ExpressionUUID->"4269d61f-70e1-4cad-8fc7-3751f1dbcee3"],

Cell["\<\
Using the equation developed above for the characteristic curve (along which \
the density is constant), plot the characteristics corresponding to the high \
density and low density regions:\
\>", "Text",ExpressionUUID->"b65cb2da-fe71-4795-bbbc-51af8aed565f"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"\[Rho]m", " ", 
             RowBox[{"(", 
              RowBox[{"x", "-", 
               RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
            RowBox[{
             RowBox[{"um", " ", "\[Rho]m"}], "-", 
             RowBox[{"2", " ", "um", " ", "\[Rho]"}]}]], "+", "ti"}], "/.", 
          "\[InvisibleSpace]", 
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], "\[Rule]", "0"}]}], "/.", 
         "\[InvisibleSpace]", 
         RowBox[{"\[Rho]", "\[Rule]", 
          FractionBox[
           RowBox[{"\[Rho]m", " ", "ti"}], "2"]}]}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"\[Rho]m", " ", 
             RowBox[{"(", 
              RowBox[{"x", "-", 
               RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
            RowBox[{
             RowBox[{"um", " ", "\[Rho]m"}], "-", 
             RowBox[{"2", " ", "um", " ", "\[Rho]"}]}]], "+", "ti"}], "/.", 
          "\[InvisibleSpace]", 
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], "\[Rule]", "L"}]}], "/.", 
         "\[InvisibleSpace]", 
         RowBox[{"\[Rho]", "\[Rule]", 
          RowBox[{"\[Rho]m", "-", 
           FractionBox[
            RowBox[{"\[Rho]m", " ", "ti"}], "2"]}]}]}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ti", ",", "0", ",", "tStop", ",", 
        RowBox[{".1", " ", "tStop"}]}], "}"}]}], "\[IndentingNewLine]", "]"}],
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "tStop"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{3.3985243775310555`*^9, 3.3985252482498055`*^9, 
  3.3985272510779305`*^9},
