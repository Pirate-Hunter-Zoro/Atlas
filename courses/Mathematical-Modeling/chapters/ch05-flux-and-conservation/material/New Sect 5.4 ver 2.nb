       FractionBox[
        RowBox[{"\[Rho]m", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"um", " ", "\[Rho]m"}], "-", 
         RowBox[{"2", " ", "um", " ", "\[Rho]"}]}]], "/.", 
       "\[InvisibleSpace]", 
