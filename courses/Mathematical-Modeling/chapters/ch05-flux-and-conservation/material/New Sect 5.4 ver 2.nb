       RowBox[{"1.0", " ", "\[Rho]m"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]m", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"x", "[", "0", "]"}]}], ")"}]}], 
