Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", " ", "=", ".7"}], ";"}]], "InputOnly",
 CellLabel->
  "In[248]:=",ExpressionUUID->"a3b3543b-0bbb-4ffc-bb7e-c15f9509f2ab"],

Cell["\<\
Calculate the numerical solution for this initial density distribution:\
\>", "Text",ExpressionUUID->"950998c3-3cbd-4423-a967-d255dd9f09dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<eerr\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", 
           RowBox[{"\[Rho]", "[", 
            RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       FractionBox[
        RowBox[{"\[Rho]m", " ", "x"}], "L"]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
       FractionBox[
        RowBox[{"\[Rho]m", " ", "t"}], "2"]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]m", "-", 
        FractionBox[
         RowBox[{"\[Rho]m", " ", "t"}], "2"]}]}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"2000", ",", "5000"}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PrecisionGoal", "\[Rule]", "6"}], ",", "\[IndentingNewLine]", 
    RowBox[{"MaxStepSize", "\[Rule]", ".05"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
