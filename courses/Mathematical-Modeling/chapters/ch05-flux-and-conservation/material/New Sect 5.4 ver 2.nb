Cell[CellGroupData[{

Cell["\<\
  Numerical solution 
  Non-uniform density solution
  >> High density
  >> Higher upstream density:\
\>", "Section",ExpressionUUID->"b7d06ae1-32af-4501-9288-3b8af70f7395"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}]}]}]], "InputOnly",
 CellLabel->
  "In[142]:=",ExpressionUUID->"b2c5786a-38ef-4ed0-9d8f-ec1c46abce76"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"um", " ", "=", " ", "55"}], ";"}], "       ", 
  RowBox[{"(*", "  ", 
   RowBox[{"miles", " ", "/", " ", "hour"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]m", " ", "=", " ", 
    RowBox[{"5280", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "15"}], ")"}]}]}], ";"}], "        ", 
  RowBox[{"(*", "  ", 
   RowBox[{"cars", " ", "/", " ", "mile"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
   RowBox[{"um", " ", 
    RowBox[{"(", " ", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[144]:=",ExpressionUUID->"6fcb7b12-dfb4-41c9-a195-5926eaa2e2af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", "[", 
   RowBox[{"x_", ",", "x1_", ",", "y1_", ",", "x2_", ",", "y2_"}], "]"}], "=",
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Which", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "\[LessEqual]", "x1"}], ",", "y1", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"x", "\[GreaterEqual]", "x2"}], ",", "y2", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "True", ",", 
    RowBox[{
     FractionBox[
      RowBox[{"y1", " ", 
       RowBox[{"(", 
        RowBox[{"x", "-", "x2"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]], "+", 
     FractionBox[
      RowBox[{"y2", " ", 
       RowBox[{"(", 
        RowBox[{"x1", "-", "x"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[149]:=",ExpressionUUID->"19bf0e04-3a51-4c42-8564-6db79638044e"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]0", "[", 
    RowBox[{"x", ",", "50", ",", 
     RowBox[{".8", " ", "\[Rho]m"}], ",", "90", ",", 
     RowBox[{".6", " ", "\[Rho]m"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]0\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
