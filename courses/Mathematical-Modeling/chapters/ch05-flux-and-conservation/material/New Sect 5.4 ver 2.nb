Cell[CellGroupData[{

Cell["\<\
  Boundary conditions
  >> No interior influence:\
\>", "Section",ExpressionUUID->"62680cd0-49bd-41ca-a3e5-dc8e238e1d86"],

Cell["\<\
For our problem it is possible to specify boundary conditions at the entry \
point (i.e. x = 0) and at the exit point (i.e. x = L).  

However, our examination of the slope of characteristic curves indicates that \
only characteristics that slope to the right will have an influence at the \
left boundary point.  This condition corresponds to left boundary condition \
which has a density < \[Rho]m / 2.

Likewise, the slope of the characteristics must be negative (corresponding to \
densities > \[Rho]m / 2) for the right boundary condition to have any \
influence on the interior domain.  

As a first example, consider specifying a high density boundary condition at \
the left boundary point:

\t\[Rho][0,t]   =   1.0  \[Rho]m
\t
 and a low density boundary condition at the right boundary point:
 
\t \[Rho][L,t]   =   0.0  \[Rho]m
\t 
   This will guarantee that neither the left nor the right boundary \
conditions will influence the interior domain:
\
\>", "Text",ExpressionUUID->"17d093c9-b523-408d-a8b8-2ed96556af12"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}]}]}]], "InputOnly",
 CellLabel->
  "In[213]:=",ExpressionUUID->"eb2a0ae7-68e8-4339-b99a-f85c2192947c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"um", " ", "=", " ", "55"}], ";"}], "       ", 
  RowBox[{"(*", "  ", 
   RowBox[{"miles", " ", "/", " ", "hour"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]m", " ", "=", " ", 
    RowBox[{"5280", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "15"}], ")"}]}]}], ";"}], "        ", 
  RowBox[{"(*", "  ", 
   RowBox[{"cars", " ", "/", " ", "mile"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "\[Rho]_", "]"}], " ", "=", " ", 
   RowBox[{"um", " ", 
    RowBox[{"(", " ", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["\[Rho]", "\[Rho]m"]}], " ", ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[215]:=",ExpressionUUID->"4bebeacc-d257-4bb0-8332-485645d7516c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", "[", 
   RowBox[{"x_", ",", "x1_", ",", "y1_", ",", "x2_", ",", "y2_"}], "]"}], "=",
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Which", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "\[LessEqual]", "x1"}], ",", "y1", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"x", "\[GreaterEqual]", "x2"}], ",", "y2", ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "True", ",", 
    RowBox[{
     FractionBox[
      RowBox[{"y1", " ", 
       RowBox[{"(", 
        RowBox[{"x", "-", "x2"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]], "+", 
     FractionBox[
      RowBox[{"y2", " ", 
       RowBox[{"(", 
        RowBox[{"x1", "-", "x"}], ")"}]}], 
      RowBox[{"x1", "-", "x2"}]]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[220]:=",ExpressionUUID->"87e104c0-aa07-4676-878e-630f6d682269"],

Cell["Consider an uneven density distribution:", "Text",ExpressionUUID->"3fa93865-ac30-4891-8f73-7089efd3276e"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]m", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["x", "L"]}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Rho]m"}], "}"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]0\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985229137654305`*^9, 3.3985229177966805`*^9}, 
   3.3985242472966805`*^9},
 CellLabel->
  "In[221]:=",ExpressionUUID->"9bde3c35-f863-4981-8a84-40aa3eb6820f"],

Cell["Restrict the maximum time:", "Text",ExpressionUUID->"969258f3-b091-47e5-9d37-242d4be7720e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", " ", "=", "1"}], ";"}]], "InputOnly",
 CellLabel->
  "In[222]:=",ExpressionUUID->"61c7c1b9-91df-47e6-bc0e-c867dd02d215"],

Cell["\<\
Calculate the numerical solution for this initial density distribution:\
\>", "Text",ExpressionUUID->"89550713-1d99-4d89-b7ef-6cc5fc09cfc2"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "]"}], " ", 
           RowBox[{"\[Rho]", "[", 
            RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]m", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox["x", "L"]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "\[Rho]m"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"MaxStepSize", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{".1", ",", ".1"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
