Cell[TextData[{
 "Observe that the flux across the left boundary and the right boundary are \
both positive because the fluid motion is from left to right.  Also, observe \
that as the primary portion of the wave crosses the left boundary that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], " ", ">", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"e4041430-9260-4833-916d-510d8266e524"],
 ", and as the primary portion of the wave crosses the right boundary that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], " ", "<", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"9eb1d7b0-8934-4417-a971-ca77b6111583"],
 ".\n\n",
 StyleBox["Example: No Flux, but with Sink", "Subsubsection"],
 "\nThe following example illustrates the rate of change in total accumulated \
volume within the interval from 0 to 5 if there is:\n\tx  Interval = { 0, 5 }\
\n\tNet Flux = None\n\tNet Source & Sink = Only a sink term\n"
}], "Text",ExpressionUUID->"695a243c-fc0b-49fc-b70a-18f33b07cbed"],

