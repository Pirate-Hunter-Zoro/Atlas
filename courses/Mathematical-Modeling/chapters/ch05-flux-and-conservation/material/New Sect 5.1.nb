Cell[TextData[{
 "Observe that because this example only has a sink term, then the change in \
accumulation will be negative, i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], " ", "<", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"b440b000-8b89-4e51-b83a-2ff81f640447"],
 ".\n",
 StyleBox["\nExample: Flux and with Sink", "Subsubsection"],
 "\nThe following example illustrates the rate of change in total accumulated \
volume within the interval from 0 to 5 if there is:\n\tx  Interval = { 0, 5 }\
\n\tNet Flux = By transport (left to right)\n\tNet Source & Sink = Only a \
sink term\n\t"
}], "Text",ExpressionUUID->"5b74e468-55e6-4f09-b84a-b69eeff18897"],

