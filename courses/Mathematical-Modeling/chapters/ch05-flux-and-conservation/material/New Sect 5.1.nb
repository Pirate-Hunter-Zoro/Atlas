           RowBox[{"{", 
            RowBox[{
             RowBox[{"t", "-", "1.5"}], ",", ".1"}], "}"}], "]"}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"Orange", ",", 
          RowBox[{"Rectangle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"5", ",", 
              RowBox[{"total", "[", "t", "]"}]}], "}"}]}], "]"}]}], "}"}], 
        ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1.1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "1.1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<q > 0\>\"", ",", 
            RowBox[{"FontSize", "\[Rule]", 
             RowBox[{
              RowBox[{"33.", " ", 
               RowBox[{"flux", "[", 
                RowBox[{"0", ",", "t"}], "]"}]}], "+", "9"}]}], ",", 
            RowBox[{"FontWeight", "\[Rule]", "\"\<Bold\>\""}], ",", 
            RowBox[{"FontColor", "\[Rule]", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"0", ",", "0", ",", "1"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", ".5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<q > 0\>\"", ",", 
            RowBox[{"FontSize", "\[Rule]", 
             RowBox[{
              RowBox[{"33.", " ", 
               RowBox[{"flux", "[", 
                RowBox[{"5", ",", "t"}], "]"}]}], "+", "9"}]}], ",", 
            RowBox[{"FontWeight", "\[Rule]", "\"\<Bold\>\""}], ",", 
            RowBox[{"FontColor", "\[Rule]", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"0", ",", "0", ",", "1"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", ".5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"totalPt", "[", "t", "]"}], ">", "0"}], ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 SubscriptBox["\"\<\[PartialD]\>\"", "\"\<t\>\""], ",", 
                 "\"\<\[Rho] > 0 \[DoubleUpArrow]\>\""}], "}"}], "]"}], ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<0 > \>\"", ",", 
                 SubscriptBox["\"\<\[PartialD]\>\"", "\"\<t\>\""], ",", 
                 "\"\<\[Rho] \[DoubleDownArrow]\>\""}], "}"}], "]"}]}], "]"}],
             ",", 
            RowBox[{"FontSize", "\[Rule]", 
             RowBox[{
              RowBox[{"100.", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{"totalPt", "[", "t", "]"}], "]"}]}], "+", "12"}]}], 
            ",", 
            RowBox[{"FontWeight", "\[Rule]", "\"\<Bold\>\""}], ",", 
            RowBox[{"FontColor", "\[Rule]", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"1", ",", "0", ",", "0"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2.5", ",", ".1"}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<k < 0\>\"", ",", 
            RowBox[{"FontSize", "\[Rule]", "18"}], ",", 
            RowBox[{"FontWeight", "\[Rule]", "\"\<Bold\>\""}], ",", 
            RowBox[{"FontColor", "\[Rule]", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"1", ",", "0", ",", "0"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2.5", ",", ".3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "7"}], ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.1"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"AspectRatio", "\[Rule]", ".4"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "\[Rule]", 
      RowBox[{"72", " ", "6"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "7"}], ",", "11", ",", ".1"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AnimationRate", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AnimationRunning", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{
  3.3984497383255043`*^9, {3.3984498381386433`*^9, 3.398449872513863*^9}, {
   3.3984499449362016`*^9, 3.3984500112960014`*^9}, {3.3984503275324*^9, 
   3.3984503388293476`*^9}, 3.3984504651114054`*^9, {3.3984506102060843`*^9, 
   3.398450621424906*^9}, {3.398450672550233*^9, 3.3984507035348063`*^9}, {
   3.398450748597595*^9, 3.39845079705103*^9}, {3.3984509012860723`*^9, 
   3.3984509355675416`*^9}, 3.398452350810974*^9, {3.3984523920456133`*^9, 
   3.3984523936862483`*^9}, {3.3984525950000367`*^9, 
   3.3984526299065104`*^9}, {3.465150913876822*^9, 3.4651509148925314`*^9}},
 CellLabel->
  "In[1568]:=",ExpressionUUID->"797abdf9-9a80-4d3e-83b9-de678819f85f"],

Cell[TextData[{
 "The behavior of this problem is more complicated because the rate of \
accumulation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"7c170306-6726-41d1-a54d-19d3c8a83a51"],
 ", changes both in sign and magnitude depending upon both the flux and the \
sink term.  Observe that the flux is always positive and the sink is always \
negative for this example.  However, the sign and the magnitude of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"8472d425-0cba-48bb-9506-371964fb9de8"],
 " depend upon which affect is currently the largest, the flux term or the \
sink term, and which boundary the flux is currently moving across.  Observe \
that the sign of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"87295507-0ed0-4670-b32e-ea8ab9f34f59"],
 " changes several times throughout this animation."
}], "Text",ExpressionUUID->"6acafe41-aa0a-467b-b3ad-313263826975"],

Cell[TextData[{
 StyleBox["Distribution of Density Changes Over Space", "Subsubsection"],
 "\nThe above animations only illustrate changes in density, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", "\[Rho]"}], TraditionalForm]],
  ExpressionUUID->"a3f316d5-f40b-458b-84b6-fdc3b7eaabbd"],
 ", ",
 StyleBox["averaged over the full space interval:",
  FontVariations->{"Underline"->True}],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", " ", "5"}], 
   TraditionalForm]],ExpressionUUID->"30fec7a5-b27d-4ec1-9340-dfe42137ff1e"],
 ".\nIn actuality, the PDE keeps track of density changes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "a2693315-b15d-4407-9d6e-e5a9f2d036be"],
 ", at each location x."
}], "Text",
 CellChangeTimes->{{3.3984529799243755`*^9, 
  3.398452998080742*^9}},ExpressionUUID->"a7039b0a-39e3-4bd3-ab84-\
acf42b0eccd2"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Flux Term:", "Section",ExpressionUUID->"8af3ae01-bbb4-40b1-b5d7-72fdda147290"],

Cell[CellGroupData[{

Cell["\<\
Introduction:
\
\>", "Subsubsection",
 CellChangeTimes->{{3.4651510262916017`*^9, 
  3.465151028854282*^9}},ExpressionUUID->"76961304-abfe-4777-aabb-\
fd6d554d52f4"],

Cell[TextData[{
 "In order to solve the partial differential equation, it is necessary to \
find an explicit expression for the flux term.  The flux depends upon the \
physical process involved in the model being analyzed.  Although there are \
many possible mechanisms which produce flux, the flux can usually be \
subdivided into two distinct types:\n\n\tAdvection:\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "Advection"], TraditionalForm]],ExpressionUUID->
  "c55dd517-e600-458a-a6f0-94fa69666295"],
 "\n\n\tDiffusion:\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "Diffusion"], TraditionalForm]],ExpressionUUID->
  "c941b4ca-0eee-4538-bd28-3cb4c6108f2d"],
 "\n"
}], "Text",ExpressionUUID->"064db417-da07-40d2-8add-e3bdaa5c8742"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Advection:
\
\>", "Subsubsection",
 CellChangeTimes->{
  3.465151029838726*^9},ExpressionUUID->"097eea26-40e1-40fe-bbdb-\
4912f0ee9fc3"],

Cell[TextData[{
 StyleBox["Advection",
  FontVariations->{"Underline"->True}],
 " corresponds to the case where the quantity being conserved is transported \
across the boundary with velocity equal to u.  Thus:\n\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "Advection"], TraditionalForm]],ExpressionUUID->
  "acca581d-58de-44da-b84e-7723676e3ba2"],
 "  =   \[Rho] u\n\nWhere the velocity u is measured relative to the \
boundary.\n\nThe resulting PDE corresponding to ",
 StyleBox["advection",
  FontVariations->{"Underline"->True}],
 " is:\n\n\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"d01e73e8-4498-4206-8812-9e2d6cde6c9f"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", "  ", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], "  ", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}], "  ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"2c481823-9c94-4f9f-8549-e353adc30443"],
 "  +  k[x,t]  \n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", "\[Rho]", " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"c37ea557-6a38-4b83-8b9e-edd6cfe0f404"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", "  ", 
      RowBox[{"\[Rho]", "  ", "u"}], " ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"92b02b63-9c43-4944-bd85-1024d59ba1f9"],
 "  +  k\n \t "
}], "Text",ExpressionUUID->"6e39d504-f076-4a82-8b5a-42848c3d9990"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Diffusion Flux:
\
\>", "Subsubsection",
 CellChangeTimes->{
  3.46515103074504*^9},ExpressionUUID->"57d462ac-d7d5-4f58-aa27-125591cba844"],

Cell[TextData[{
 StyleBox["Diffusion",
  FontVariations->{"Underline"->True}],
 " corresponds to the case where flux occurs in response to the uneven \
distribution of the quantity being conserved.  A classic example of this is \
the diffusion of heat.  There is a flux of heat (left or right) because heat \
flux will only occur from warmer to cooler locations.  A consequence of this \
is that a constant temperature distribution will produce no diffusion heat \
flux.  For many physical processes the diffusion flux is often proportional \
to the gradient of some other quantity.  For example, heat flux is \
approximately proportional to the temperature gradient (where the constant of \
proportionality is negative (i.e. heat moves from warmer to cooler)).  In our \
notation, the diffusion flux term would be expressed as:\n\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "Diffusion"], TraditionalForm]],ExpressionUUID->
  "ce12fa44-b46a-47e5-80dd-90557af5a03b"],
 "  =  - \[Nu]   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"(", "\[Rho]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "3f207633-937c-46d8-a2cd-70da39c30568"],
 "\n\nwhere \[Nu] is the constant of proportionality.\n(Remember, the above \
formula is valid ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " for the specific case where the flux is negatively proportional to the the \
gradient.  However, more complicated mechanisms produce more complicated \
formulas for the flux.)\n\nThe resulting PDE corresponding to ",
 StyleBox["diffusion",
  FontVariations->{"Underline"->True}],
 " flux is:\n\n\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"6bb5cc85-d873-4492-bcfd-e90064fe4f4d"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", "  ", 
      RowBox[{
       RowBox[{"-", " ", "\[Nu]"}], "   ", 
       FormBox[
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ")"}]}],
        TraditionalForm]}], "  ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"7751bd2e-87d8-49f4-aeb3-0582ac116b94"],
 "  +  k[x,t]  \n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"(", " ", "\[Rho]", " ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"e9c0788c-b1fa-4d24-81cb-f66e56493e7c"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"-", " ", "\[Nu]"}], "   ", 
       FormBox[
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"(", "\[Rho]", ")"}]}],
        TraditionalForm]}], " ", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "4b4e4df2-2034-44b0-a9f3-aea9d545a843"],
 "  +  k\n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"(", " ", "\[Rho]", " ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"f8c6c5d8-4a92-4db7-8a09-a1c86ab8e347"],
 "  =   \[Nu] ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "xx"], 
     RowBox[{"(", " ", 
      FormBox[
       RowBox[{"\[Rho]", ")"}],
       TraditionalForm], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "77a9dd8c-eb6b-4ea4-8ee4-353828e0e40c"],
 "  +  k"
}], "Text",ExpressionUUID->"fe273fd3-0c36-4e50-ae68-7a1dacccba17"],

Cell[TextData[{
 "\n(Remember, the above formula is valid ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " for the specific case where the flux is negatively proportional to the the \
gradient.)"
}], "Text",ExpressionUUID->"8550f76f-f486-4670-9dd8-98240cdc22ac"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Example: Diffusion Flux (Heat Flow)
\
\>", "Subsubsection",
 CellChangeTimes->{
  3.4651510321826415`*^9},ExpressionUUID->"f86fbdde-951c-42f3-a386-\
ef3e2f9ed5e3"],

Cell[TextData[{
 "The following animation illustrates diffusion.\nConsider 1-dimensional heat \
flow for 0 \[LessEqual] x \[LessEqual] 10, with:\n\tInitial temperature \
distribution of 0 along the length of the rod (i.e. u[x,0] = 0)\n\tLeft \
boundary temperature is always held constant and equal to 1  (i.e. u[0,t] = \
1)\n\tRight boundary temperature flux is 0 (i.e. insulated)   0 = q[10,t] = - \
",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Alpha]", "*", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"u", "[", 
      RowBox[{"10", ",", "t"}], "]"}]}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "bd2c623a-7662-4086-af6f-481bdabd40d5"],
 "\nThe following PDE, initial condition and two boundary conditions model \
this situation:\n\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\t\t\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], " ", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}], "==", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"x", ",", "x"}]], 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}]}], "\n", "\t\t\t", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "==", "0"}], "\n", "\t\t\t", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "==", "1"}], ",", "\n", "\t\t\t", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "x"], " ", 
        RowBox[{"u", "[", 
         RowBox[{"10", ",", "t"}], "]"}]}], " ", "==", "0"}]}]}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "af434825-716a-4a72-a4d5-adea530b6856"],
 "\nHowever, the extension of NDSolve to PDEs has certain limitations.  \
Specifically that the initial and boundary conditions should agree with each \
other.  This is not true for the above problem (look at the point (0, 0)).  \
Therefore, we will solve the slightly modified problem (which produces a \
solution virtually identical to the above formulation).\n\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\t\t\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], " ", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}], "==", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"x", ",", "x"}]], 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}]}], "\n", "\t\t\t", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0.1"}], "]"}], "==", 
      SuperscriptBox["E", 
       RowBox[{
        RowBox[{"-", "3"}], "x"}]]}], "\n", "\t\t\t", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"0", ",", "t"}], "]"}], "==", "1"}], "\n", "\t\t\t", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], " ", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], "/.", 
        RowBox[{"x", "->", "10"}]}], ")"}], " ", "==", 
      RowBox[{
       RowBox[{"-", "3"}], "*", " ", 
       SuperscriptBox["E", 
        RowBox[{"-", "30"}]]}]}]}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "851d644a-79fb-4347-b415-f3b8d1df9914"],
 "\nThe modified problem satisfies the condition that the initial and \
boundary conditions agree.\n\nSolve the PDE, initial and boundary \
conditions:"
}], "Text",ExpressionUUID->"d4e97481-41e9-4ff4-918e-da3b7b50095d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<eerr\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"x", ",", "x"}]], 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "0.1"}], "]"}], "\[Equal]", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "3"}], " ", "x"}]]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", "\[InvisibleSpace]", 
         RowBox[{"x", "\[Rule]", "10"}]}], ")"}], "\[Equal]", 
       RowBox[{"-", 
        FractionBox["3", 
