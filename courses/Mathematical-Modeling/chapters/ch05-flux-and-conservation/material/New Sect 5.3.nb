    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"MaxStepSize", "\[Rule]", ".1"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985087006091805`*^9, 3.3985087084060555`*^9}},
 CellLabel->
  "In[1687]:=",ExpressionUUID->"4f403fac-f7c9-45a3-866f-60a3e61da56f"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]   \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985087136091805`*^9, 3.3985087399060555`*^9}, {
   3.3985090936404305`*^9, 3.3985091541716805`*^9}, 3.3985092636248055`*^9, 
   3.3985114253279305`*^9},
 CellLabel->
  "In[1688]:=",ExpressionUUID->"df475173-be3b-48f7-bd49-a9e44ed177fe"],

Cell["Animate the solution.", "Text",
 CellChangeTimes->{
  3.466268628172406*^9},ExpressionUUID->"062492fa-cf82-4a04-b0c9-\
9e014a10ce4a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]SolutionNew", "[", 
     RowBox[{"x_", ",", "t_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
     RowBox[{"Flatten", "[", "solutionRule", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]SolutionNew", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FillingStyle", "\[Rule]", 
      RowBox[{"{", "LightOrange", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "\[Rule]", 
      RowBox[{"5", " ", "72"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"AspectRatio", "\[Rule]", ".4"}]}], "\[IndentingNewLine]", "]"}],
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AnimationRate", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.3985075304998055`*^9, 3.3985076966716805`*^9}, {
  3.3985077277185555`*^9, 3.3985078406091805`*^9}, {3.466268940719281*^9, 
  3.466268962094281*^9}, {3.466269237375531*^9, 3.466269269625531*^9}},
 CellLabel->
  "In[1689]:=",ExpressionUUID->"221b322c-5a1d-41b0-a04e-8658d87e9c03"],

Cell[CellGroupData[{

Cell["Summary of characteristic curves:", "Subsubsection",ExpressionUUID->"d99bb4e7-a47a-4833-b7f3-5306e9111e03"],

Cell["\<\
Intuitively, for a conservation PDE where the flux term corresponds to \
advection only (i.e. the substance is transported with a velocity c) then the \
motion of the initial condition through space and time (illustrated in the \
above three-dimensional graph) corresponds to the direction of the space-time \
curves (i.e. characteristic curves) given in the two-dimensional space-time \
domain.  We also have illustrated that only the flux (i.e. advection) term \
determines the characteristic directions through space and time.  Therefore, \
an understanding of a conservation PDE with flux arising only from advection \
can be understood in terms of two principles:

\tI.   The characteristic direction through space and time.

\tII.  The source term (i.e. growth or decay).
\t
In the example given above the flux term (which corresponds to the river \
velocity) was constant.  Therefore, the characteristic curves were all \
straight and parallel.  However, in more complicated problems, the flux \
velocity need not be constant.  We will consider examples of this type later.\
\>", "Text",ExpressionUUID->"30c532cb-30ad-408c-9131-69cae15f96d8"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["  Boundary vs. initial conditions:", "Section",ExpressionUUID->"3d283c46-036f-40c6-beb0-50ca2b2f5af0"],

Cell["\<\
The above example makes it clear that the conservation PDE only describes the \
behavior of the solution within the interior of our space-time domain.  For \
our example, at time = 0, the density distribution along the river must be \
known.  However, for times >  0, we must know the density that enters the \
stream at location x = 0.  The nature of the characteristic curves for this \
equation clearly indicates what initial and boundary conditions are required \
(and which portion of the solution is affected by each).

Once again, consider the characteristic curves in our space-time domain:\
\>", "Text",ExpressionUUID->"8336ebd1-6190-4bdf-a7ab-125a7556445d"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox["x", "c"], "-", 
       FractionBox["dx", "c"]}], ",", 
      RowBox[{"{", 
       RowBox[{"dx", ",", 
        RowBox[{"-", "7"}], ",", "7", ",", "2"}], "}"}]}], "]"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "50"}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985087944998055`*^9, 3.3985088122966805`*^9}, {
  3.3985114532654305`*^9, 3.3985114572810555`*^9}},
 CellLabel->
  "In[1691]:=",ExpressionUUID->"f539e2ec-8169-4626-9182-1117b4c4d6ec"],

Cell["\<\
The above plot of the characteristic curves makes it clear that for certain \
space-time locations only the initial density distribution is required, and \
at other space-time locations only the left (i.e. entrance) boundary \
condition is required. 
 It should also be clear that if the velocity c was negative, then the \
characteristic curves would slope in the opposite direction (because the flux \
would move from right to left) and the appropriate initial and boundary \
conditions would be the initial density distribution and the boundary \
condition at the right hand side(i.e. the new entrance).\
\>", "Text",ExpressionUUID->"f0d31382-c766-4cbc-87ae-c59cb180f42b"],

Cell["\<\
Consider a plot of the characteristic curves for a negative velocity:\
\>", "Text",ExpressionUUID->"096a2225-80d3-468f-b1ab-70fee0fa4386"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c", " ", "=", " ", 
   RowBox[{"-", ".20"}]}], ";"}]], "InputOnly",
 CellLabel->
  "In[1692]:=",ExpressionUUID->"8ff3a257-acaa-441a-bb54-e27bf3606fc7"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox["x", "c"], "-", 
       FractionBox["dx", "c"]}], ",", 
      RowBox[{"{", 
       RowBox[{"dx", ",", "1", ",", "17", ",", "2"}], "}"}]}], "]"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "50"}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesOrigin", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"10", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985088231248055`*^9, 3.3985088380310555`*^9}, {
  3.3985114730466805`*^9, 3.3985114762654305`*^9}},
 CellLabel->
  "In[1693]:=",ExpressionUUID->"756dca9c-3bc2-4180-b26c-51aa44e37d96"],

Cell[CellGroupData[{

Cell["Example: pollution at inlet:", "Subsubsection",ExpressionUUID->"32bb243c-f75f-4822-8a95-0c0a145e7a7b"],

Cell[TextData[{
 "Consider an example of pollutants been dumped into a river (at location x = \
0) at a rate given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]LB", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "1c204bdb-9c26-401a-ab8a-3cfd3be3b8d6"],
 ".  Also, assume that the pollution dumping started only at t = 0.  \
Therefore, the left boundary condition \[Rho]LB becomes:"
}], "Text",
 CellChangeTimes->{{3.3985096878279305`*^9, 
  3.3985097004685555`*^9}},ExpressionUUID->"4aa8d61b-b19c-4eff-b10d-\
7b0a92d8e50b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]LB", "[", "t_", "]"}], "=", 
  RowBox[{"\[Gamma]", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", ".1"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"t", "-", "15"}], ")"}], "2"]}]]}]}]], "Input",
 CellChangeTimes->{{3.3985088459060555`*^9, 3.3985088576560555`*^9}, {
  3.3985094969216805`*^9, 3.3985095254373055`*^9}, {3.3985095923904305`*^9, 
  3.3985095985310555`*^9}},
 CellLabel->
  "In[1694]:=",ExpressionUUID->"172cbf55-e769-4844-a11f-ae7428939cef"],

Cell["\<\
The implicit assumption here is that the river is free of pollution at all \
locations for t = 0.  Therefore, the initial density distribution is:\
\>", "Text",ExpressionUUID->"12196806-e71c-4a16-b442-c0e1aebc8811"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], " ", "=", " ", "0"}]], "Input",
 CellLabel->
  "In[1695]:=",ExpressionUUID->"6132f45d-4adc-45a8-bacf-d6dbce76d702"],

Cell["Assign values to the model parameters:", "Text",ExpressionUUID->"73488942-2169-48dd-a60d-fbf079d001ef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", " ", "=", " ", ".20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", " ", "=", " ", ".1"}], ";"}], "    ", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "with"}], " ", "decay"}], "  ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Gamma]", " ", "=", " ", "2.0"}], ";"}], " ", 
  RowBox[{"(*", "  ", 
   RowBox[{"dumping", " ", "rate"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[1696]:=",ExpressionUUID->"6f578239-8705-4a28-aa83-bedbcfe79e42"],

Cell["\<\
Examine the time dependent left (i.e. entrance) boundary condition:\
\>", "Text",ExpressionUUID->"7efb2fd5-81ea-4472-96e7-54d357826e3d"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]LB", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "4"}], ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", "\"\<\[Rho]   \>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Boundary Condition at  x = 0\>\""}]}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985088685466805`*^9, 3.3985088873904305`*^9}, {
  3.3985095672185555`*^9, 3.3985095742185555`*^9}, {3.3985115251873055`*^9, 
  3.3985115789060555`*^9}},
 CellLabel->
  "In[1701]:=",ExpressionUUID->"8d588c9e-cf55-430f-9e63-e1d3f9ca7f26"],

Cell["\<\
Solve the conservation PDE along with the initial condition and entrance \
boundary condition:\
\>", "Text",ExpressionUUID->"578fbf7c-7153-4b2b-8230-d53b61fdac0a"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]LB", "[", "t", "]"}]}]}], "\[IndentingNewLine]", "}"}], 
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", "1000"}], ",", "\[IndentingNewLine]", 
    RowBox[{"MaxStepSize", "\[Rule]", ".1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PrecisionGoal", "\[Rule]", "4"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985088953904305`*^9, 3.3985089043748055`*^9}, 
   3.3985098953435555`*^9, {3.3985099449529305`*^9, 3.3985099455779305`*^9}, {
   3.3985099769216805`*^9, 3.3985099795154305`*^9}, 3.3985100132966805`*^9, {
   3.3985101754529305`*^9, 3.3985101894373055`*^9}, {3.3985102447341805`*^9, 
   3.3985102825623055`*^9}},
 CellLabel->
  "In[1702]:=",ExpressionUUID->"5d54f58c-04b8-4b38-94c6-f70666c9db9d"],

Cell["Plot the results:", "Text",ExpressionUUID->"5c569adb-5186-4a27-91f8-6f76012ef524"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "40"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]   \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985089106404305`*^9, 3.3985089164373055`*^9}, 
   3.3985116050779305`*^9},
 CellLabel->
  "In[1703]:=",ExpressionUUID->"0062baf3-30aa-465d-bd6e-658cf91fe559"],

Cell["\<\
The above solution appears to be reasonable, therefore no further attempt \
will be made to improve the numerical accuracy.\
\>", "Text",
 CellChangeTimes->{
  3.466269439094281*^9},ExpressionUUID->"45429809-09bf-425b-8ce5-\
0f4614f43fa0"],

Cell["Animate the solution.", "Text",
 CellChangeTimes->{
  3.466268628172406*^9},ExpressionUUID->"4340c488-e47b-4989-89ff-\
1d143c4b6aa3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]SolutionNew", "[", 
     RowBox[{"x_", ",", "t_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
     RowBox[{"Flatten", "[", "solutionRule", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]SolutionNew", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FillingStyle", "\[Rule]", 
      RowBox[{"{", "LightOrange", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "\[Rule]", 
      RowBox[{"5", " ", "72"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"AspectRatio", "\[Rule]", ".4"}]}], "\[IndentingNewLine]", "]"}],
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AnimationRate", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.3985075304998055`*^9, 3.3985076966716805`*^9}, {
  3.3985077277185555`*^9, 3.3985078406091805`*^9}, {3.466268940719281*^9, 
  3.466268962094281*^9}, {3.466269237375531*^9, 3.466269269625531*^9}},
 CellLabel->
  "In[1704]:=",ExpressionUUID->"c2b7ca2a-1816-410c-985a-33ad1fd40bb8"],

Cell[TextData[{
 "Look at the above 3-D plot and the above animation and understand that it \
will take some time (",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "10"}], TraditionalForm]],ExpressionUUID->
  "d50229bd-02e6-4f48-8243-8b1f3fa396da"],
 ") before you will see the curve.\n\nConsider what happens over a longer \
time interval.  For example, the pollution introduced into the river by a \
factory over a two-day interval:"
}], "Text",
 CellChangeTimes->{
  3.466269439094281*^9, {3.466269590234906*^9, 
   3.466269684453656*^9}},ExpressionUUID->"2a7a3539-75b2-4db7-a88d-\
cc8cefd5b8eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", " ", "=", "100"}], ";"}]], "InputOnly",
 CellLabel->
  "In[1706]:=",ExpressionUUID->"081e8a3a-ac50-4e58-924d-c65f536a3ad5"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]LB", "[", "t", "]"}]}]}], "\[IndentingNewLine]", "}"}], 
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", "1000"}], ",", "\[IndentingNewLine]", 
    RowBox[{"MaxStepSize", "\[Rule]", ".1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PrecisionGoal", "\[Rule]", "4"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985093194060555`*^9, 3.3985093293279305`*^9}, 
   3.3985103793591805`*^9},
 CellLabel->
  "In[1707]:=",ExpressionUUID->"f873120c-0d80-4501-bd38-8d23564d07e2"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
