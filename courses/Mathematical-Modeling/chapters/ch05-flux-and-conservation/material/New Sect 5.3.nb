   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", "\"\<    \[Rho]\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{
   "PlotLabel", "\[Rule]", 
    "\"\<Boundary Condition \[Rho][0,t] at  x = 0\>\""}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985088685466805`*^9, 3.3985088873904305`*^9}, {
  3.3985095672185555`*^9, 3.3985095742185555`*^9}, {3.3985115251873055`*^9, 
  3.3985115789060555`*^9}, {3.3985120183748055`*^9, 3.3985120612185555`*^9}, {
  3.3985121752654305`*^9, 3.3985121825466805`*^9}, {3.3985122213279305`*^9, 
  3.3985122249529305`*^9}, {3.3985127608748055`*^9, 3.3985127636404305`*^9}},
 CellLabel->
  "In[1717]:=",ExpressionUUID->"5d6d1799-899c-4d69-9151-809dca8cb71c"],

Cell[TextData[{
 "Examine the space dependent (i.e. initial) boundary condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "[", 
    RowBox[{"x", ",", "0"}], "]"}], TraditionalForm]],ExpressionUUID->
  "ac1fa325-9010-4fed-9e89-f0610e21b4ec"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3985121323123055`*^9, 3.3985121561560555`*^9}, {
   3.3985124343435555`*^9, 3.3985124386248055`*^9}, 
   3.3985125917966805`*^9},ExpressionUUID->"ae3b4e1a-80fe-414c-ad4e-\
07a773e7dae4"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"2", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
