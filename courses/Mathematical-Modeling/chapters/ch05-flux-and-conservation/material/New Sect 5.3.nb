  "In[1665]:=",ExpressionUUID->"b1d290e7-8b7e-43c7-8bfb-b7cef9f0d819"],

Cell["\<\
A maximum step size of 0.1 seems to be adequate for our problem.\
\>", "Text",ExpressionUUID->"ba972255-fdfe-49b3-86c2-4b19c6ea3fbf"]
}, Closed]],

Cell[CellGroupData[{

Cell["Decay using numerical procedures:", "Subsubsection",ExpressionUUID->"90ffb95a-3334-454b-babf-e6d40b4b11b4"],

Cell["\<\
Now that an acceptable step size has been determined for our numerical \
technique, it is possible to examine the numerical solution corresponding to \
our PDE with decay:\
\>", "Text",ExpressionUUID->"f5e0f3ee-5f09-4c32-9412-91a2f223e990"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", " ", "=", " ", ".20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", " ", "=", " ", ".1"}], ";"}], "   ", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "with"}], " ", "decay"}], "  ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "x", " ", "\[LessEqual]", " ", "2"}], ",", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"2", "-", "x"}], ")"}]}], ")"}], "2"], ",", "0"}], 
   "]"}]}]}], "InputOnly",
 CellLabel->
  "In[1666]:=",ExpressionUUID->"62d4f17d-5cab-4bb9-9310-f87e9a2a494b"],

