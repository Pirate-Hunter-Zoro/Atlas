\>", "Text",ExpressionUUID->"54c96f1b-0a61-4a0e-9ebc-1551bbb49b04"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["  Characteristics:", "Section",ExpressionUUID->"67d453dd-e27a-4dde-b04a-93d59ffcb23d"],

Cell[TextData[{
 "Characteristics correspond to the traveling wave solution of our equation.  \
It is clear from the above graph that our initial condition translates \
through space and time with the characteristic direction (i.e. slope = 1/c) \
corresponding to the velocity c appearing in our PDE.\n\n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", "\[Rho]", " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"86b46975-e8dc-492b-bb7c-61fb0daab908"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"c", "  ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"(", "  ", "\[Rho]", "  ", ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"8935a203-d53b-4895-bd25-1f5645febb25"],
 "  -  \[Mu] \[Rho]\n \t \nIt is possible to indicate the direction of the \
characteristics in the space-time domain:"
}], "Text",ExpressionUUID->"a2a3d981-88b6-4737-8739-8df9b9574e70"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox["x", "c"], "-", 
       FractionBox["dx", "c"]}], ",", 
      RowBox[{"{", 
       RowBox[{"dx", ",", "1", ",", "7", ",", "2"}], "}"}]}], "]"}], "]"}], 
   ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "50"}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985083995466805`*^9, 3.3985084147498055`*^9}, {
  3.3985113135779305`*^9, 3.3985113178904305`*^9}, {3.466268820625531*^9, 
  3.466268824984906*^9}},
 CellLabel->
  "In[1673]:=",ExpressionUUID->"47a0fe79-3c22-4e5f-885c-2ab5e72689f8"],

Cell["\<\
Another way to illustrate the characteristic directions is to plot the \
solution in three dimensions.

Define an initial condition which has several waves:\
\>", "Text",ExpressionUUID->"3dfbc6eb-2673-4101-8c8c-71b962d6a398"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}], "3"], 
    RowBox[{"\[Rho]0", "[", 
     RowBox[{"x", "-", 
      RowBox[{"2", "*", "n"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]   \>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985084452654305`*^9, 3.3985085173123055`*^9}, {
  3.3985113371873055`*^9, 3.3985113422185555`*^9}},
 CellLabel->
  "In[1674]:=",ExpressionUUID->"278b0b5b-2fc6-4025-b571-95c1b5444968"],

Cell["\<\
Use a numerical procedure to find the solution.  

Consider the special case with no decay.\
\>", "Text",
 CellChangeTimes->{{3.3985085309373055`*^9, 
  3.3985085316560555`*^9}},ExpressionUUID->"210e42aa-0147-49a4-b9e1-\
817d31ba6236"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", " ", "=", " ", ".20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", " ", "=", " ", ".0"}], ";"}], "   ", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "no"}], " ", "decay"}], "  ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "x", " ", "\[LessEqual]", " ", "2"}], ",", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"2", "-", "x"}], ")"}]}], ")"}], "2"], ",", "0"}], 
   "]"}]}]}], "InputOnly",
 CellLabel->
  "In[1675]:=",ExpressionUUID->"899c82b8-d34f-427d-ace4-e84f5ea3cee0"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "3"], 
        RowBox[{"\[Rho]0", "[", 
         RowBox[{"x", "-", 
          RowBox[{"2", " ", "n"}]}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}]}], 
