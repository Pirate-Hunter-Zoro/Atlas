    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxStepSize", "\[Rule]", ".1"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985085380466805`*^9, 3.3985085526248055`*^9}},
 CellLabel->
  "In[1680]:=",ExpressionUUID->"a87d4ba3-f586-4168-b1ff-3e1a3c7acfd6"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
