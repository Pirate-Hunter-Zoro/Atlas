    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "40"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<   time\>\"", ",", "\"\<\[Rho]   \>\""}],
      "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"BoxRatios", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", ".4"}], "}"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985103914216805`*^9, 3.3985103943435555`*^9}, {
   3.3985105272341805`*^9, 3.3985105484841805`*^9}, {3.3985106141091805`*^9, 
   3.3985106204373055`*^9}, {3.3985106521873055`*^9, 3.3985107000466805`*^9}, 
   3.3985107637029305`*^9, {3.3985116617966805`*^9, 3.3985116825466805`*^9}},
 CellLabel->
