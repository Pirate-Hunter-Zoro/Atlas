(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[" Section 5.3", "Title",ExpressionUUID->"2ecede47-1fa3-4ece-9116-7dcb564a96fe"],

Cell[TextData[StyleBox["  Pollution in Rivers",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"680e072f-f4aa-44ca-9b07-\
9ed73136aec6"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellChangeTimes->{3.3985071764373055`*^9},
 CellLabel->
  "In[1618]:=",ExpressionUUID->"ecf76704-14ae-4d72-a893-1ef7e3c94f35"],

Cell[CellGroupData[{

Cell["  Introduction:", "Section",ExpressionUUID->"5ef0da9b-53f2-4911-a8b6-9fd2f82b5958"],

Cell[TextData[{
 "An organic pollutant is thoroughly mixed in the water of a river which is \
moving downstream at a constant velocity c.  The concentration of the \
pollutant \[Rho] in the river is homogeneous in all directions perpendicular \
to the direction of flow, which we take to be from left to right along the \
x-axis.  The river is thereby modeled by an advective flow in one dimension.  \
We will assume that advection is the primary mechanism for flux (and \
therefore the effects of diffusion due to river turbulence and irregularities \
in its contours as it meanders downstream can be ignored).\n\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", 
    RowBox[{" ", "Advection"}]], TraditionalForm]],ExpressionUUID->
  "c545eeba-b079-4be8-9539-0a4b5a473c2c"],
 "  =  -  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"(", 
     RowBox[{"c", " ", "\[Rho]"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "da6e52a5-0a81-421c-8ce6-dae44b368ffa"],
 "   (flux from left to right)\n\t                    -  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "  ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"(", "\[Rho]", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "5ec644ca-d392-4e43-8528-859c95797e87"],
 "   (where the velocity is constant)\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", 
    RowBox[{" ", "Diffusion"}]], TraditionalForm]],ExpressionUUID->
  "e2701561-db9d-4da5-ae66-29004433dc12"],
 "    =  0  \n"
}], "Text",ExpressionUUID->"7f60d66e-3013-4410-afb0-7f26b4304844"],

Cell[TextData[{
 "However, the pollutant is allowed to decay in the water due to bacterial \
action, which gradually decomposes it.  This represents a ",
 StyleBox["sink",
  FontVariations->{"Underline"->True}],
 " term.  We will assume that the rate of decay is proportional to the \
density of the pollutant (remember decay represents a negative value).\n\n\tk \
 =  - \[Mu] \[Rho]\n"
}], "Text",
 CellChangeTimes->{{3.4662683191742477`*^9, 
  3.4662683407209845`*^9}},ExpressionUUID->"adf9bc30-aea4-49a3-b0ff-\
c969793887a4"],

Cell[TextData[{
 "Finally, substituting the above terms into our basic conservation law \
yields:\n\n \t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", "\[Rho]", " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"1ce76ab3-1be4-457f-9eca-7e814e3fb3d5"],
 "  =  -",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"c", "  ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"(", "  ", "\[Rho]", "  ", ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"6f8054a2-b278-4295-954d-ee3fb090f7ac"],
 "  -  \[Mu] \[Rho]\n\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    RowBox[{"(", " ", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], " ", ")"}]}], TraditionalForm]],
  ExpressionUUID->"0133b6c2-ff85-4328-b383-148c419301ab"],
 "  =  - c ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", "  ", 
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], "  ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"b20fbec2-e161-4b83-85a0-0e837fd379e2"],
 "  -  \[Mu] \[Rho][x,t]  \n"
}], "Text",ExpressionUUID->"b00c8794-b09f-4e2c-9cb5-15ba295ab3c3"]
}, Closed]],

Cell[CellGroupData[{

Cell["  Model Solution:", "Section",ExpressionUUID->"8aa6eafd-6e7d-4411-8303-99526ed3dc3d"],

Cell["\<\
There are two approaches which can be used to determine the solution to our \
model.

\tClosed form solution procedures
\tNumerical solution procedures
\t
Each of these methods has its strengths and weaknesses.  However, as the \
complexity of a problem increases, eventually numerical methods represent the \
only possibility.\
\>", "Text",ExpressionUUID->"b53604eb-3b09-4f5a-a0f8-c45745c63ead"]
}, Closed]],

Cell[CellGroupData[{

Cell["  Closed form solution procedures", "Section",ExpressionUUID->"abe9cb13-1be0-41b3-aba7-803018c04294"],

Cell["\<\
Simple closed form solutions for PDEs are usually difficult if not impossible \
to obtain.  However, for the above example, a simple closed form solution \
exists.

To obtain this solution, use DSolve (which produces closed form solutions) \
rather than NDSolve (which produces numerical solutions).\
\>", "Text",ExpressionUUID->"b2554866-d720-4a5b-a3a9-5e63a54a084f"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "t"], 
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "c"}], " ", 
       RowBox[{
        SubscriptBox["\[PartialD]", "x"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
      RowBox[{"\[Mu]", " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985073361873055`*^9, 3.3985073369216805`*^9}},
 CellLabel->
  "In[1619]:=",ExpressionUUID->"ab76a2dc-6c86-4db5-a963-88a18913fcfe"],

Cell["\<\
Observe that the above solution contains an arbitrary function C[1].  Unlike \
ODE solutions which contain arbitrary constants of integration, PDE solutions \
contain arbitrary functions of integration.  The precise value for this \
function will depend upon our initial and boundary conditions.

Our first step is to define the solution density using the above solution \
rule.\
\>", "Text",ExpressionUUID->"46d6d81c-5a65-4ab8-843e-aab651a840d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]Solution", "[", 
   RowBox[{"x_", ",", "t_"}], "]"}], "=", "  ", 
  RowBox[{
   RowBox[{"\[Rho]", "[", 
    RowBox[{"x", ",", "t"}], "]"}], " ", "/.", " ", 
   RowBox[{"Flatten", "[", "solutionRule", "]"}]}]}]], "Input",
 CellLabel->
  "In[1620]:=",ExpressionUUID->"09958628-f3b3-495d-863d-b2ed7545c649"],

Cell["We can verify the contents of our density solution function:", "Text",ExpressionUUID->"755e078b-5faf-4d8b-adc9-aef78fe0e2ae"],

Cell[BoxData[
 RowBox[{"?", "\[Rho]Solution"}]], "Input",
 CellLabel->
  "In[1621]:=",ExpressionUUID->"529abc8f-b13b-4f32-b449-0a9435a03938"],

Cell[CellGroupData[{

Cell[" Initial condition \[Rho]0[x]:", "Subsubsection",ExpressionUUID->"e54a658e-71c8-4e52-8dfb-c2be56e96448"],

Cell[TextData[{
 "Our next step is to determine the arbitrary function C[1] using the initial \
condition \[Rho][x,0]  =  \[Rho]0[x].  To do this, change the form of the \
argument appearing inside of our arbitrary function to a new variable \[Eta]:\
\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "  ", "=", "  ", 
    StyleBox[
     FractionBox[
      RowBox[{
       RowBox[{"c", " ", "t"}], "-", "x"}], "c"],
     FontWeight->"Bold"]}], TextForm]], "Text",ExpressionUUID->
  "ae712334-5f9b-4e8c-b4c6-f225ffb27307"],
 "\n\t"
}], "Text",
 CellChangeTimes->{{3.4662684461890593`*^9, 
  3.4662684461890593`*^9}},ExpressionUUID->"ef2cff51-b2ec-4f54-b0ad-\
713ec923d6ba"],

Cell["\<\
Because we wish to express our solution in terms of the initial condition \
\[Rho]0[x], solve for the variable x:\
\>", "Text",ExpressionUUID->"d9f05746-4e27-4a15-b1b8-c69af38931d5"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Eta]", " ", "==", " ", 
    FractionBox[
     RowBox[{
      RowBox[{"c", " ", "t"}], "-", "x"}], "c"]}], ",", "\[IndentingNewLine]",
    "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985073561404305`*^9, 3.3985073602966805`*^9}, 
   3.4662684340797625`*^9},
 CellLabel->
  "In[1622]:=",ExpressionUUID->"f818ffd0-624f-4eec-95df-98e3df46dbdf"],

Cell["\<\
Substitute this expression for the variable x into our solution:\
\>", "Text",ExpressionUUID->"3aa93316-3f6c-461a-a958-b82793c9e69d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]Solution", "[", 
    RowBox[{"x", ",", "t"}], "]"}], "  ", "/.", 
   RowBox[{"x", "\[Rule]", 
    RowBox[{"c", " ", 
     RowBox[{"(", 
      RowBox[{"t", "-", "\[Eta]"}], ")"}]}]}]}], " ", "//", 
  "Simplify"}]], "Input",
 CellLabel->
  "In[1623]:=",ExpressionUUID->"3dcd0d4d-9083-4f62-af4f-158cb4b7db2c"],

Cell["\<\
 and also substitute t\[Rule]0 corresponding to our initial condition \
\[Rho][x,0]:\
\>", "Text",ExpressionUUID->"2f71e6a6-837f-43df-83ab-ee8c6a26d6ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]Solution", "[", 
    RowBox[{"x", ",", "t"}], "]"}], "  ", "/.", 
   RowBox[{"x", "\[Rule]", 
    RowBox[{"c", " ", 
     RowBox[{"(", 
      RowBox[{"t", "-", "\[Eta]"}], ")"}]}]}]}], "/.", 
  RowBox[{"t", "\[Rule]", "0"}]}]], "Input",
 CellLabel->
  "In[1624]:=",ExpressionUUID->"c7bd7159-b209-4ac1-99bb-e1730ce8a269"],

Cell[" Likewise for \[Rho]0[x]:", "Text",ExpressionUUID->"173d9ff6-4be3-4f9d-a292-237fb9171be8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]0", "[", "x", "]"}], "  ", "/.", 
   RowBox[{"x", "\[Rule]", 
    RowBox[{"c", " ", 
     RowBox[{"(", 
      RowBox[{"t", "-", "\[Eta]"}], ")"}]}]}]}], "/.", 
  RowBox[{"t", "\[Rule]", "0"}]}]], "Input",
 CellLabel->
  "In[1625]:=",ExpressionUUID->"4b3291d9-0451-4a45-aced-c0fa2d924a6e"],

Cell["\<\
 Finally, set the two expressions equal to each other and solve for the \
arbitrary function:\
\>", "Text",ExpressionUUID->"adc5bc21-b56e-4670-b42f-37e40ac1183a"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Eta]", " ", "\[Mu]"}]], " ", 
     RowBox[{
      RowBox[{"C", "[", "1", "]"}], "[", "\[Eta]", "]"}]}], "==", 
    RowBox[{"\[Rho]0", "[", 
     RowBox[{
      RowBox[{"-", "c"}], " ", "\[Eta]"}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"C", "[", "1", "]"}], "[", "\[Eta]", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[1626]:=",ExpressionUUID->"f4bac78f-1c88-4cd8-b607-229731990875"],

Cell["\<\
Now that we have a formula for our arbitrary function, use this formula to \
determine the overall density distribution.  Recall that the solution to our \
model is:\
\>", "Text",ExpressionUUID->"75599056-cac7-4ed8-8212-c8b34c40b0f1"],

Cell[BoxData[
 RowBox[{"\[Rho]Solution", "[", 
  RowBox[{"x", ",", "t"}], "]"}]], "Input",
 CellLabel->
  "In[1627]:=",ExpressionUUID->"2caac92f-92ea-4aed-b223-cd7cba796b6b"],

Cell["\<\
Substitute the formula for the arbitrary function into the solution:\
\>", "Text",ExpressionUUID->"8020050a-fbe7-4c47-b432-9051e954ade1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]Solution", "[", 
   RowBox[{"x", ",", "t"}], "]"}], "   ", "/.", 
  RowBox[{
   RowBox[{
    RowBox[{"C", "[", "1", "]"}], "[", "\[Eta]_", "]"}], "\[Rule]", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Eta]"}], " ", "\[Mu]"}]], " ", 
    RowBox[{"\[Rho]0", "[", 
     RowBox[{
      RowBox[{"-", "c"}], " ", "\[Eta]"}], "]"}]}]}]}]], "Input",
 CellLabel->
  "In[1628]:=",ExpressionUUID->"00cee319-a214-4ca2-83f2-24074250f547"],

Cell["Finally, simplify the result.", "Text",ExpressionUUID->"ade9e119-bd3e-4cc0-a3a9-80cb90649776"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]Solution", "[", 
   RowBox[{"x_", ",", "t_"}], "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", " ", "t"}], "-", "x"}], ")"}], " ", "\[Mu]"}], "c"]}],
       "-", 
      FractionBox[
       RowBox[{"x", " ", "\[Mu]"}], "c"]}]], " ", 
    RowBox[{"\[Rho]0", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "c"}], " ", "t"}], "+", "x"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[1629]:=",ExpressionUUID->"e5457e1f-9efd-4ce9-8674-e07b075a0355"],

Cell["\<\
The above expression is identical to the one obtained in the book.\
\>", "Text",ExpressionUUID->"6912856a-26b0-4b9a-8814-194fc1f8a1ce"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Visualization of the solution:", "Subsubsection",ExpressionUUID->"84324742-f9e3-4f33-9a85-98c982451ee1"],

Cell["\<\
In order to better understand the behavior of our solution, consider some \
typical values for the constants appearing in the equation along with a \
particular initial density condition.\
\>", "Text",ExpressionUUID->"84697df4-80da-44d5-a2f2-572fae78f53e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", " ", "=", " ", ".20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", " ", "=", " ", ".0"}], ";"}], "   ", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "no"}], " ", "decay"}], "  ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "x", " ", "\[LessEqual]", " ", "2"}], ",", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"2", "-", "x"}], ")"}]}], ")"}], "2"], ",", "0"}], 
   "]"}]}]}], "InputOnly",
 CellLabel->
  "In[1630]:=",ExpressionUUID->"074bc0c4-2b13-48f7-a5bd-6a5cb1b6e770"],

Cell["Look at a plot of the initial condition  \[Rho]0[x]:", "Text",ExpressionUUID->"45f44418-c46e-4a4b-9cb9-7e730c261354"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]0", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "4"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"5", " ", "72"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "\[Rule]", ".4"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985074237810555`*^9, 3.3985074429373055`*^9}, {
  3.3985108740154305`*^9, 3.3985109221404305`*^9}},
 CellLabel->
  "In[1635]:=",ExpressionUUID->"22f078f7-15e9-4aac-92e0-bebb8ce389ab"],

Cell["Look at the solution density over both space and time:", "Text",
 CellChangeTimes->{{3.3985109367966805`*^9, 
  3.3985109437966805`*^9}},ExpressionUUID->"f3defba9-2fc4-4355-b265-\
d35657c79bcd"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]Solution", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "40"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]   \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985074530623055`*^9, 3.3985074580623055`*^9}, {
  3.3985109510154305`*^9, 3.3985109810466805`*^9}},
 CellLabel->
  "In[1636]:=",ExpressionUUID->"4c5883ba-7752-435a-91d7-2821fbac860f"],

Cell["\<\
Observe that the initial density distribution moves down stream with velocity \
c.\
\>", "Text",ExpressionUUID->"33d19dbc-df87-4e7a-ae34-bf4330aca034"],

Cell["\<\
Another way to visualize the density distribution for different times is to \
animate the solution.\
\>", "Text",ExpressionUUID->"1eb0f219-a0d0-41f0-8a66-9b4301d8b9b1"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]Solution", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FillingStyle", "\[Rule]", 
      RowBox[{"{", "LightOrange", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "\[Rule]", 
      RowBox[{"5", " ", "72"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"AspectRatio", "\[Rule]", ".4"}]}], "\[IndentingNewLine]", "]"}],
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AnimationRate", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985075304998055`*^9, 3.3985076966716805`*^9}, {
  3.3985077277185555`*^9, 3.3985078406091805`*^9}},
 CellLabel->
  "In[1637]:=",ExpressionUUID->"061cf5e0-5c04-45a7-a86d-df96ff8ef01f"],

Cell["\<\
Note that the density distribution remains unchanged as it moves because the \
decay term has been set to 0.

Next, consider a nonzero value for the decay term:\
\>", "Text",ExpressionUUID->"6029e812-c5c0-481a-abce-127f73535541"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", " ", "=", " ", ".20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", " ", "=", " ", ".1"}], ";"}], "   ", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "with"}], " ", "decay"}], "  ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "x", " ", "\[LessEqual]", " ", "2"}], ",", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"2", "-", "x"}], ")"}]}], ")"}], "2"], ",", "0"}], 
   "]"}]}]}], "InputOnly",
 CellLabel->
  "In[1638]:=",ExpressionUUID->"a6255a0d-ec25-462b-be13-ed50a1f7cac1"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]Solution", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "40"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]   \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985078577185555`*^9, 3.3985078603279305`*^9}, {
  3.3985110299529305`*^9, 3.3985110400310555`*^9}, {3.7505318915198402`*^9, 
  3.750531924313119*^9}},
 CellLabel->
  "In[1645]:=",ExpressionUUID->"6acda822-5c46-4b72-8d4b-8ac0f5ad47e2"],

Cell["\<\
The above plot demonstrates that the initial density distribution of the \
pollution decays as it moves downstream.  For the above values, most of \
pollution has decayed after it has moved downstream 10 units of distance \
(corresponding to about 50 units of time at velocity c).\
\>", "Text",ExpressionUUID->"4f0f0a7b-a0ed-42e3-a52b-436b7b71c504"],

Cell["Animate the solution.", "Text",
 CellChangeTimes->{
  3.466268628172406*^9},ExpressionUUID->"5c3c556e-1824-440a-85db-\
961feb10c0ec"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]Solution", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Filling", "\[Rule]", "Axis"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FillingStyle", "\[Rule]", 
      RowBox[{"{", "LightOrange", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "\[Rule]", 
      RowBox[{"5", " ", "72"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"AspectRatio", "\[Rule]", ".4"}]}], "\[IndentingNewLine]", "]"}],
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AnimationRate", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985075304998055`*^9, 3.3985076966716805`*^9}, {
  3.3985077277185555`*^9, 3.3985078406091805`*^9}},
 CellLabel->
  "In[1646]:=",ExpressionUUID->"440dcf7b-d4a9-43f0-9b86-99118c33b5ca"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["  Numerical solution procedures:", "Section",ExpressionUUID->"4d89eb41-e035-48bb-a1c8-8c17be92a37d"],

Cell["\<\
It is also possible to solve the above PDE using numerical techniques.  The \
advantage of this procedure is that the final solution can be found in one \
step.

As a starting point consider the density distribution problem given above.  \
We will start by considering the case of no decay (for which we have a good \
understanding).\
\>", "Text",ExpressionUUID->"23a4832b-2af8-4ef7-bc68-c62cddc396ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", " ", "=", " ", ".20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", " ", "=", " ", ".0"}], ";"}], "   ", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "no"}], " ", "decay"}], "  ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "x", " ", "\[LessEqual]", " ", "2"}], ",", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"2", "-", "x"}], ")"}]}], ")"}], "2"], ",", "0"}], 
   "]"}]}]}], "InputOnly",
 CellLabel->
  "In[1647]:=",ExpressionUUID->"a31f29bd-1290-45d4-8e3d-a6678efd4ef5"],

Cell["\<\
Next, find the numerical solution within the range of x and t values.  Note \
that we had to supply the initial density distribution at t equals 0 along \
with the upstream boundary condition at x equals 0.\
\>", "Text",ExpressionUUID->"a843223d-d593-4275-9d75-e081f67c77dd"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985078835935555`*^9, 3.3985078934216805`*^9}},
 CellLabel->
  "In[1652]:=",ExpressionUUID->"9d567686-405e-48b5-809b-ef96ff040ad8"],

Cell[TextData[{
 "What is the error from ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "?\n\nPlot the result:"
}], "Text",
 CellChangeTimes->{{3.3985079658279305`*^9, 
  3.3985079818904305`*^9}},ExpressionUUID->"d3efe0f3-4f86-4650-847f-\
68c12f55b99f"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "40"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]   \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985079311716805`*^9, 3.3985079496873055`*^9}, {
  3.3985079892654305`*^9, 3.3985079914373055`*^9}, {3.3985110762341805`*^9, 
  3.3985110819841805`*^9}},
 CellLabel->
  "In[1653]:=",ExpressionUUID->"96288e36-459c-48ad-8f8d-57e862e1c03c"],

Cell["\<\
Observed that the above plot differs significantly from the exact solution.  \
It appears that the solution has decay even though zero decay was specified.  \
Also, the solution has density waves further downstream (i.e. to the right) \
than expected.

In order to get a better feeling for the solution at different times, \
superimpose the density distribution for several different times.\
\>", "Text",ExpressionUUID->"25db90ec-cb0a-428e-9127-037ad997edfb"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "50", ",", "10"}], "}"}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"5", " ", "72"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "\[Rule]", ".4"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985080183748055`*^9, 3.3985080319529305`*^9}, 
   3.3985111270466805`*^9, {3.3985111651404305`*^9, 3.3985111951404305`*^9}},
 CellLabel->
  "In[1654]:=",ExpressionUUID->"63ab50be-7f32-4750-9c32-ecaa311fd5b6"],

Cell[TextData[{
 "The above graph clearly illustrates that the density distribution does not \
maintain the same shape for later times.  Therefore the numerical solution is \
",
 StyleBox["inaccurate",
  FontVariations->{"Underline"->True}],
 " for this problem.\n"
}], "Text",ExpressionUUID->"24869364-a857-4e16-85b1-8ad48da99c0b"],

Cell[CellGroupData[{

Cell["Improving the accuracy the of the numerical method:", "Subsubsection",ExpressionUUID->"a282468c-6933-4c27-b663-80a8cbd733f2"],

Cell[TextData[{
 "\nHow can we correct this?\n\nBecause a numerical method is being used, \
computational error is ",
 StyleBox["always",
  FontVariations->{"Underline"->True}],
 " introduced into the solution.  However, it is important that the magnitude \
of the numerical error be small relative to the size of the solution.  \
Although a detailed study of numerical techniques is beyond the scope of this \
course, many common problems can be corrected using these two steps:\n\nI.   \
Always compare your ",
 StyleBox["numerical",
  FontVariations->{"Underline"->True}],
 " solution to a known ",
 StyleBox["solution",
  FontVariations->{"Underline"->True}],
 " for at least one case.  This will prevent you from accepting a numerical \
solution as automatically correct (which would have been disastrous for the \
above example).\n\nII.    If the numerical error is unacceptably large, then \
the accuracy can usually be improved by using a finer mesh in the numerical \
method.\n\nFor our case we are using NDSolve.  By examining the options for \
this Mathematica command, we find that the maximum step size is controlled by \
the option: MaxStepSize.  We will now run a numerical experiment by \
decreasing the maximum step size until the accuracy becomes acceptable."
}], "Text",
 CellChangeTimes->{{3.3985080725154305`*^9, 
  3.3985080729998055`*^9}},ExpressionUUID->"21da19c1-6ea4-4eb0-b5e3-\
e8a63f2dea3e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", " ", "=", " ", ".20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", " ", "=", " ", ".0"}], ";"}], "   ", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"i", ".", "e", ".", " ", "no"}], " ", "decay"}], "  ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "x", " ", "\[LessEqual]", " ", "2"}], ",", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"2", "-", "x"}], ")"}]}], ")"}], "2"], ",", "0"}], 
   "]"}]}]}], "InputOnly",
 CellLabel->
  "In[1655]:=",ExpressionUUID->"8e4eccdf-2a39-44b1-bc1a-0a9c354460d3"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxStepSize", "\[Rule]", "5."}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985081172810555`*^9, 3.3985081256560555`*^9}},
 CellLabel->
  "In[1660]:=",ExpressionUUID->"ee8b4111-2e78-4edf-8a0e-1e60c256a043"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
