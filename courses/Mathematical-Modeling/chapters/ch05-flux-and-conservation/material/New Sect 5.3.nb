Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", 
       RowBox[{"1", "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", ".5"}], "t"}]]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Delta]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Delta]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], "+", 
        RowBox[{"\[Mu]1", " ", 
         RowBox[{"(", 
          RowBox[{"\[Delta]m", "-", 
           RowBox[{"\[Delta]", "[", 
            RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Delta]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", "2"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Delta]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "2"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"\[Delta]", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxStepSize", "\[Rule]", ".1"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
