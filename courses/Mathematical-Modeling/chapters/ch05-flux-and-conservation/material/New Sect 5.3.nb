      RowBox[{"-", ".1"}], ",", "1"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{
   "PlotLabel", "\[Rule]", 
    "\"\<Initial Condition \[Rho][x,0] at  t = 0\>\""}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985088685466805`*^9, 3.3985088873904305`*^9}, {
   3.3985095672185555`*^9, 3.3985095742185555`*^9}, {3.3985115251873055`*^9, 
   3.3985115789060555`*^9}, {3.3985120183748055`*^9, 
   3.3985120612185555`*^9}, {3.3985122334216805`*^9, 3.3985123706873055`*^9}, 
   3.3985127724685555`*^9},
 CellLabel->
  "In[1716]:=",ExpressionUUID->"e3880657-2616-499a-bb83-ca26dd464fe9"],

Cell[TextData[{
 "Examine the time dependent left (i.e. entrance) boundary condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "[", 
    RowBox[{"0", ",", "t"}], "]"}], TraditionalForm]],ExpressionUUID->
  "41df6ced-7276-448a-ba71-1e564928ad5a"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3985124670154305`*^9, 
  3.3985124790466805`*^9}},ExpressionUUID->"7af3d215-17c6-4001-9835-\
4c72a0b5a29f"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"1", "-", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", ".5"}], "t"}]]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
