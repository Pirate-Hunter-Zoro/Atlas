    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<h\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985284325935555`*^9, 3.3985284372966805`*^9}, {
  3.3985289071560555`*^9, 3.3985289087654305`*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"47bb1711-d9fc-47ae-970e-f0fe172ed66d"],

Cell["\<\
Observed that both the morphogen and inhibitor are at uniform steady-state \
conditions.

\
\>", "Text",ExpressionUUID->"8e21c105-e36f-498c-91a0-b3e56c78032b"]
}, Closed]],

Cell[CellGroupData[{

Cell["General Solution:  morphogen-inhibitor ", "Subsubsection",ExpressionUUID->"26fd5e35-b4c3-42c4-89ea-c18aef285666"],

Cell["Next consider the same values as above:", "Text",ExpressionUUID->"06898991-697f-4ad7-b115-b88c6f9ca511"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]", "  ", "=", "  ", ".01"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Nu]", "  ", "=", "  ", ".02"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "  ", "=", "  ", ".1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "  ", "=", "  ", ".2"}], ";"}]}], "InputOnly",
 CellLabel->"In[89]:=",ExpressionUUID->"de1d61e1-3462-45ba-a3a9-3b52a679a8b3"],

Cell["\<\
Consider an initial morphogen density profile that has a small excess \
concentration of morphogen in the center of our biological strip:\
\>", "Text",ExpressionUUID->"083d0c5a-87fb-412a-a311-d655e0e64d79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], " ", "=", 
  RowBox[{"1", "+", 
   RowBox[{".3", "*", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{".4", "*", "L"}], "<", "x", "<", 
       RowBox[{".6", "*", "L"}]}], ",", 
      RowBox[{"Cos", "[", 
       RowBox[{
        FractionBox["\[Pi]", 
         RowBox[{".2", "*", "L"}]], 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{".5", "*", "L"}]}], ")"}]}], "]"}], ",", "0"}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[95]:=",ExpressionUUID->"09e80544-d765-4462-9522-43b22922671c"],

Cell["Plot the initial morphogen density:", "Text",ExpressionUUID->"ca95fa83-77e2-4a15-ab70-9297edc5ecc5"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]0", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1.5"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]0\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985284442185555`*^9, 3.3985284539216805`*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"79ffd448-97b0-4d45-8066-3e38231e9d59"],

Cell["\<\
The above initial morphogen density profile is out of equilibrium near the \
center.  We expect that the inhibitor will respond by increasing its \
production and subsequently suppressing the production of morphogen.

Solve for the morphogen-inhibitor concentrations for five units of time:\
\>", "Text",ExpressionUUID->"c7eca551-f7ba-427a-84fb-7da15e3299aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"SolutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Mu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"k1", "[", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"h", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Nu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"k2", "[", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", "1"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"600", ",", "600"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.3985284575779305`*^9, 3.3985284623904305`*^9}, {
  3.466531918828537*^9, 3.466531949718569*^9}, {3.466532127762026*^9, 
