Cell[CellGroupData[{

Cell["Animate the above solution:", "Subsubsection",ExpressionUUID->"d640763f-5011-4fff-888e-86f5fe414da8"],

Cell["\<\
It may be easier to visualize the morphogen-inhibitor concentrations as a \
function of time if animation is used.

Animate the above solution:
(morphogen = solid line, inhibitor = dashed line)\
\>", "Text",ExpressionUUID->"72dfa983-1b52-493c-a4ca-a04b5aa7bea6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]1", "[", 
       RowBox[{"x_", ",", "t_"}], "]"}], ",", 
      RowBox[{"h1", "[", 
       RowBox[{"x_", ",", "t_"}], "]"}]}], "}"}], "=", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"Flatten", "[", "SolutionRule", "]"}]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"Flatten", "[", "SolutionRule", "]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]1", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", 
       RowBox[{"h1", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "3"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotPoints", "\[Rule]", "30"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".007", "]"}], ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0", ",", "0"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".007", "]"}], ",", 
          RowBox[{"Dashing", "[", 
           RowBox[{"{", 
            RowBox[{".03", ",", ".03"}], "}"}], "]"}], ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0", ",", "0", ",", "1"}], "]"}]}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<x-Distance\>\"", ",", 
        "\"\<\!\(\*StyleBox[\"\[Rho]\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"x\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\",\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[1, 0, 0]]\)   and   \
\!\(\*StyleBox[\"h\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"x\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\",\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[0, 0, 1]]\)\>\""}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AnimationRate", "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.3985285247654305`*^9, 3.3985285284841805`*^9}, {
  3.3985290617810555`*^9, 3.3985290672341805`*^9}, {3.3985291069841805`*^9, 
  3.3985291310779305`*^9}, {3.3985292070154305`*^9, 3.3985292269529305`*^9}, {
  3.3985292776404305`*^9, 3.3985293079216805`*^9}, {3.3985294127029305`*^9, 
  3.3985294330935555`*^9}, {3.3985301300466805`*^9, 3.3985302012810555`*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"b2b84253-d2ab-42d6-83ad-bd2d04e9a078"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Predator-prey
Reaction-diffusion equations:\
\>", "Section",ExpressionUUID->"da062679-bab3-4401-a62b-30eef633ae08"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}]}]}]], "InputOnly",
 CellChangeTimes->{3.3985285374998055`*^9, 3.4665322563533063`*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"e341afd3-36f4-4773-a273-4767f4a2ee5b"],

Cell[TextData[{
 "Recall our plankton distribution on the surface of the ocean.  If a new \
element is introduced in terms of a predator, a tiny crustacean called a \
copepod, which consumes the plankton, then we have a predator-prey problem.\n\
\nWe will create a conservation based PDE model for both the predator and the \
prey.  The flux term for the plankton will assumed to be by diffusion only.  \
Likewise, the flux term for the tiny crustacean is also by diffusion only.  \
Although the crustacean has a higher diffusion coefficient due to the \
increased mobility of the crustacean over the plankton.\n\n\tLet  \[Rho][x,t] \
 =  plankton concentration\n\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "\[Rho]", ")"}]}], "  ", "==", "  ", 
   RowBox[{
    RowBox[{"-", "  ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", " ", "\[Mu]"}], "*", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], " ", 
         RowBox[{"(", "\[Rho]", ")"}]}]}], ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k1", "[", " ", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"b0828cb7-9d31-429c-a45e-01fd93e02ec5"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "\[Rho]", ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", "\[Rho]", ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k1", "[", " ", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"2b0a34d0-8f3b-4d7e-b0ca-23dbc1e38a10"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k1", "[", " ", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"107c5a0b-b345-4a48-860f-6945a94a1311"],
 "\n \n\tLet  h[x,t]  =  crustacean concentration\n\n",
 StyleBox["  \t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "h", ")"}]}], "  ", "==", " ", 
   RowBox[{
    RowBox[{"-", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", " ", "\[Nu]"}], "*", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], " ", 
         RowBox[{"(", "h", ")"}]}]}], ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k2", "[", " ", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"529fd93d-9bc6-46e4-9939-fa992a1cf86a"],
 StyleBox["\n \t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "h", ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Nu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", "h", ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k2", "[", " ", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"52b091d4-636d-4532-89fb-adb1bd9e7345"],
 StyleBox["\n \t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", 
     RowBox[{"h", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Nu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", 
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k2", "[", " ", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"6530cae6-1cd5-4dfa-93fe-a0bc464e0ca3"],
 "\n"
}], "Text",ExpressionUUID->"019c5740-bbd1-4027-a0f7-ea4679902584"],

Cell[CellGroupData[{

Cell["Plankton conservation PDE:", "Subsubsection",ExpressionUUID->"464db0ba-83ce-43cd-9a1d-de951777edb8"],

Cell[TextData[{
 "The source and sink term for the plankton should correspond to its \
population growth and also its loss because it is consumed by the \
crustaceans.\n\nThe plankton population growth model could be unlimited \
growth, logistic limited growth, or another growth model.  For our case, \
consider a quadratic growth model for the plankton source term:\n\n\t",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{"source", " ", "=", " ", 
    RowBox[{"r", "*", "\[Rho]", "*", 
     RowBox[{"(", " ", 
      RowBox[{"1", " ", "+", " ", 
       FractionBox["\[Rho]", "k"]}], " ", ")"}], " "}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"1db891fa-19c1-4125-af00-d8b8abe20efc"],
 "\n\nObserve that the above expression has a \"+\" rather than a \"-\" (so \
that the plankton is autocatalytic).\nThe plankton sink term will correspond \
to the plankton being consumed by the crustaceans.  Consider a simple \
plankton-crustacean interaction model to be proportional to the plankton and \
crustacean densities:\n\n\tsink =  -  \[Alpha] \[Rho] h\n\nTherefore, the \
total source and sink term for the plankton is:\n\n\t",
 Cell[BoxData[
  RowBox[{
   RowBox[{"k1", "[", 
    RowBox[{"\[Rho]", ",", "h"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"r", "*", "\[Rho]", "*", 
     RowBox[{"(", " ", 
      RowBox[{"1", " ", "+", " ", 
       FractionBox["\[Rho]", "k"]}], " ", ")"}]}], " ", "-", "  ", 
    RowBox[{"\[Alpha]", "*", "\[Rho]", "*", "h"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"0a4f9edc-8a23-45d1-9927-d99c00ab1263"],
 "\n"
}], "Text",ExpressionUUID->"0532664b-2a3f-4d53-8baf-81942fff0cee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"k1", "[", 
   RowBox[{"\[Rho]_", ",", "h_"}], "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"r", "*", "\[Rho]", "*", 
    RowBox[{"(", " ", 
     RowBox[{"1", " ", "+", " ", 
      FractionBox["\[Rho]", "k"]}], " ", ")"}]}], " ", "-", "  ", 
   RowBox[{"\[Alpha]", "*", "\[Rho]", "*", "h"}]}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"e1ceb3c7-cd3d-4f36-aac1-f7251a6ac0ea"],

Cell[TextData[{
 "Determine the condition so that the plankton will be autocatalytic:\n\n\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"k1", "[", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "5fac021a-7d99-4ea5-bb6d-5daa6237ae25"],
 " > 0\n"
}], "Text",ExpressionUUID->"f296b2ea-e3fd-4247-a441-8175ecaac3ce"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "\[Rho]"], 
  RowBox[{"(", " ", 
   RowBox[{"k1", "[", 
    RowBox[{"\[Rho]", ",", "h"}], "]"}], ")"}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"222e5b2d-9e2e-4aae-928a-e5529c58c895"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Simplify", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], 
    RowBox[{"(", " ", 
     RowBox[{"k1", "[", 
      RowBox[{"\[Rho]", ",", "h"}], "]"}], ")"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985302620623055`*^9, 3.3985302633591805`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"82c66776-2047-4e02-8d51-1734afc92a28"],

Cell[TextData[{
 "Therefore, the following inequality must be satisfied in order for the \
plankton to be autocatalytic:\n\n\t",
 Cell[BoxData[
  RowBox[{"r", "-", 
   RowBox[{"h", " ", "\[Alpha]"}], "+", 
   FractionBox[
    RowBox[{"2", " ", "r", " ", "\[Rho]"}], "k"]}]],
  FontWeight->"Bold",ExpressionUUID->"a6847122-411f-4ce3-9e65-6c14fd6c64d5"],
 " > 0",
 "\n"
}], "Text",ExpressionUUID->"82fe392d-b9dc-47bf-8090-2547e8fff075"],

Cell[TextData[{
 "Thus, the resulting conservation PDE with diffusion flux,  quadratic growth \
model and competition sink model is:\n\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "\[Rho]", ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", "\[Rho]", ")"}]}]}], "   ", "+", "   ", 
    RowBox[{"r", "*", "\[Rho]", "*", 
     RowBox[{"(", " ", 
      RowBox[{"1", " ", "+", " ", 
       FractionBox["\[Rho]", "k"]}], " ", ")"}]}], " ", "-", "  ", 
    RowBox[{"\[Alpha]", "*", "\[Rho]", "*", "h"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"66593b21-1312-4aed-924e-f1de17731c95"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ")"}]}]}], "   ", "+", "   ", 
    RowBox[{"r", "*", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], "*", 
     RowBox[{"(", " ", 
      RowBox[{"1", " ", "+", " ", 
       FractionBox[
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}], "k"]}], " ", ")"}]}], " ", "-", "  ", 
    RowBox[{"\[Alpha]", "*", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], "*", 
     RowBox[{"h", "[", 
      RowBox[{"x", ",", "t"}], "]"}]}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"a101627c-7a7e-41f2-9125-17d89fad207f"],
 "\n"
}], "Text",ExpressionUUID->"57fb318e-e259-4387-a65a-2039f8ad6d25"]
}, Closed]],

Cell[CellGroupData[{

Cell["Crustacean conservation PDE:", "Subsubsection",ExpressionUUID->"cb3e957b-af4d-4b22-af2b-f6414c320a2f"],

Cell[TextData[{
 "The source and sink terms for the crustacean can take many forms.  However \
for our purposes, assume that the source term corresponds to unlimited growth \
related to the amount of food (i.e. plankton) and the crustacean density.  \
Thus, a reasonable model for growth of the crustaceans is:\n\n\t",
 "source = ",
 "+ \[Beta] \[Rho] h\n\nHowever, assume that the crustaceans die out rapidly \
in the absence of food, and that this sink term is quadratic:\n\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"sink", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "c"}], "*", 
    SuperscriptBox["h", "2"]}]}]],
  FontWeight->"Bold",ExpressionUUID->"e4b83ecf-bca3-4f98-896e-14be76b84c0d"],
 "\n\nTherefore, the total source and sink term for the crustacean is:\n\n\t",
 Cell[BoxData[
  RowBox[{
   RowBox[{"k2", "[", 
    RowBox[{"\[Rho]", ",", "h"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "c"}], "*", 
     SuperscriptBox["h", "2"]}], " ", "+", " ", 
    RowBox[{"\[Beta]", "*", "\[Rho]", "*", "h"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"796df139-f235-47fb-ac22-babb375451ac"],
 "\n"
}], "Text",ExpressionUUID->"0eaaf793-be2b-45f7-bdea-f320e391f277"],

Cell[BoxData[
 RowBox[{
  RowBox[{"k2", "[", 
   RowBox[{"\[Rho]_", ",", "h_"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "c"}], "*", 
    SuperscriptBox["h", "2"]}], " ", "+", " ", 
   RowBox[{"\[Beta]", "*", "\[Rho]", "*", "h"}]}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"f85d3d95-af0c-4a2d-b794-4bcb9358ada0"],

Cell[TextData[{
 "Thus, the resulting conservation PDE with diffusion flux, competition \
growth model and quadratic sink model is:\n\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "h", ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", "h", ")"}]}]}], "   ", "-", "   ", 
    RowBox[{"c", "*", 
     SuperscriptBox["h", "2"]}], " ", "+", " ", 
    RowBox[{"\[Beta]", "*", "\[Rho]", "*", "h"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"ee8e23b3-ab0d-4a6d-98b5-4a5553c4c524"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", 
     RowBox[{"h", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", 
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ")"}]}]}], "   ", "-", "   ", 
    RowBox[{"c", "*", 
     SuperscriptBox[
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}], "2"]}], " ", "+", " ", 
    RowBox[{"\[Beta]", "*", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], "*", 
     RowBox[{"h", "[", 
      RowBox[{"x", ",", "t"}], "]"}]}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"feb69837-3583-4712-b49b-5fae8c925bbc"],
 "\n"
}], "Text",ExpressionUUID->"6297436f-7bd9-4264-962a-9290ce3ae26a"]
}, Closed]],

Cell[CellGroupData[{

Cell["Boundary conditions:", "Subsubsection",ExpressionUUID->"d85687fe-7357-4c3d-af9a-48d2b26549c4"],

Cell[TextData[{
 "Assume that the slice of ocean has a constant width L from shore to shore.  \
Since neither the plankton nor the crustaceans can migrate on shore, then the \
flux of plankton and the crustaceans at the boundaries will be zero.  Since \
the flux is proportional to the negative of the density gradient, then the \
boundary conditions translate to:\n\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"0", ",", "t"}], "]"}]}], " ", "=", " ", "0"}]],
  FontWeight->"Bold",ExpressionUUID->"588f94fc-ce32-4998-bd08-f003e7d32db4"],
 "   \t(i.e.  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "\[Rho]"], TraditionalForm]],ExpressionUUID->
  "bb494af0-4484-47be-88e5-0ad97678ca9a"],
 "[0,t]   \[Alpha]   ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"0", ",", "t"}], "]"}]}]}], " "}]],
  FontWeight->"Bold",ExpressionUUID->"d5410c5e-a03f-4b49-87e6-706816841a34"],
 ")\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"L", ",", "t"}], "]"}]}], " ", "=", " ", "0"}]],
  FontWeight->"Bold",ExpressionUUID->"3f164f9b-01d7-415f-867f-860471bff57f"],
 "   \t(i.e.  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "\[Rho]"], TraditionalForm]],ExpressionUUID->
  "e4a79219-64b5-42b1-914e-92f000c08c2b"],
 "[L,t]   \[Alpha]   ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"L", ",", "t"}], "]"}]}]}], " "}]],
  FontWeight->"Bold",ExpressionUUID->"0fa3ff2f-edbc-44f3-b213-c91200940028"],
 ")\n\t\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"h", "[", 
     RowBox[{"0", ",", "t"}], "]"}]}], " ", "=", " ", "0"}]],
  FontWeight->"Bold",ExpressionUUID->"9a676451-1ae3-445d-af49-507361c23c3e"],
 "   \t(i.e.  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "h"], TraditionalForm]],ExpressionUUID->
  "8bfb4195-8698-4336-bb81-8f1c8b561c80"],
 "[0,t]   \[Alpha]   ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"h", "[", 
      RowBox[{"0", ",", "t"}], "]"}]}]}], " "}]],
  FontWeight->"Bold",ExpressionUUID->"7bfe4f22-207b-4254-af98-a13bb9c3e367"],
 ")\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", 
    RowBox[{"h", "[", 
     RowBox[{"L", ",", "t"}], "]"}]}], " ", "=", " ", "0"}]],
  FontWeight->"Bold",ExpressionUUID->"1d348b95-28b2-4e2f-b2e3-5cbb788f6504"],
 "   \t(i.e.  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "h"], TraditionalForm]],ExpressionUUID->
  "475f22c1-9d81-4009-a8eb-e751034cbc8f"],
 "[L,t]   \[Alpha]   ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"h", "[", 
      RowBox[{"L", ",", "t"}], "]"}]}]}], " "}]],
  FontWeight->"Bold",ExpressionUUID->"ec435b96-8edc-438e-b91a-d38cfbc62011"],
 ")\n"
}], "Text",ExpressionUUID->"8b25aad6-9e13-480c-b13b-bbe7b3621aa6"]
}, Closed]],

Cell[CellGroupData[{

Cell["Plankton-crustacean uniform equilibrium solution:", "Subsubsection",ExpressionUUID->"f120a2c5-9d30-405f-823d-8a6caf04039a"],

Cell["\<\
Consider the special case where both the plankton and crustaceans are in \
steady-state equilibrium.  For steady-state conditions the time derivatives \
are all zero.  Furthermore, consider the special case of a uniform plankton \
and crustacean density distribution (therefore the spatial derivatives will \
also be zero).

Solve for the equilibrium and uniform values for the plankton and crustaceans:\
\>", "Text",ExpressionUUID->"b55d782e-4618-44bf-9b20-6a461f887c55"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"k1", "[", 
        RowBox[{"\[Rho]", ",", "h"}], "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k2", "[", 
        RowBox[{"\[Rho]", ",", "h"}], "]"}], "==", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "h"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "TableForm"}]], "Input",
 CellChangeTimes->{{3.3985285507341805`*^9, 3.3985285589998055`*^9}, {
  3.3985302749373055`*^9, 3.3985302772966805`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"9f1aaddd-3a38-42e9-b780-658a83c7af36"],

Cell["\<\
We are not interested in the solutions which have either zero or negative \
density distributions.  Therefore, only the final uniform steady-state \
solution will be examined.\
\>", "Text",ExpressionUUID->"b5f1e083-0077-4572-bb8a-78afd1b1824c"]
}, Closed]],

Cell[CellGroupData[{

Cell["Define values:", "Subsubsection",ExpressionUUID->"96d21f74-b09b-44b8-9f49-2a20b89644e3"],

Cell["\<\
Consider a small strip of water ten units wide.  We will assume some \
reasonable values for the diffusion coefficients \[Mu] and \[Nu].  \
Specifically, to insure that the crustaceans spread out faster than the \
plankton, we will assume that the diffusion coefficient for the crustacean is \
twice is large as the diffusion coefficient for the plankton.

\t\[Mu]  =  .01
\t\[Nu]  =  .02
\
\>", "Text",ExpressionUUID->"60e26da8-9580-4295-b1ec-40e1cb1dec0d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]", "  ", "=", "  ", ".01"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Nu]", "  ", "=", "  ", ".02"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", " ", "=", " ", ".04"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]", "  ", "=", "  ", ".1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Beta]", "  ", "=", "  ", ".03"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "  ", "=", "  ", ".2"}], ";"}]}], "InputOnly",
 CellLabel->"In[10]:=",ExpressionUUID->"cd6bb51d-26f0-4413-bda5-e98ae227498a"],

Cell["\<\
Before we begin, examine the inequality that we derived above which will \
insure that the plankton will be autocatalytic.\
\>", "Text",ExpressionUUID->"ca7bc78f-9b77-4e4e-b7bf-889e69104b75"],

Cell[BoxData[
 RowBox[{"r", "-", 
  RowBox[{"h", " ", "\[Alpha]"}], "+", 
  FractionBox[
   RowBox[{"2", " ", "r", " ", "\[Rho]"}], "k"]}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"9353809f-40e2-487d-bbe3-8d999e7c9094"],

Cell["\<\
The above inequality depends upon the current plankton and crustacean \
densities.  Although our solutions will cover a range of densities, consider \
the value of this inequality for our equilibrium conditions.

The plankton and crustacean densities for uniform steady-state equilibrium \
are:\
\>", "Text",ExpressionUUID->"0b0a8ff4-18a7-461c-ad60-0e7620aad0cd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[Rho]", "\[Rule]", 
    FractionBox[
     RowBox[{"c", " ", "k", " ", "r"}], 
     RowBox[{
      RowBox[{
       RowBox[{"-", "c"}], " ", "r"}], "+", 
      RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}], ",", 
   RowBox[{"h", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"k", " ", "r", " ", "\[Beta]"}], 
      RowBox[{
       RowBox[{"c", " ", "r"}], "-", 
       RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}]}]}], 
  "}"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"6597be41-1797-4fab-9951-937297c6cc27"],

Cell["\<\
Substituting the equilibrium densities into the inequality yields:\
\>", "Text",ExpressionUUID->"49f59297-ecf4-494e-8dc1-dd34e6d4170b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r", "-", 
   RowBox[{"h", " ", "\[Alpha]"}], "+", 
   FractionBox[
    RowBox[{"2", " ", "r", " ", "\[Rho]"}], "k"]}], " ", "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]", "\[Rule]", 
     FractionBox[
      RowBox[{"c", " ", "k", " ", "r"}], 
      RowBox[{
       RowBox[{
        RowBox[{"-", "c"}], " ", "r"}], "+", 
       RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}], ",", 
    RowBox[{"h", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"k", " ", "r", " ", "\[Beta]"}], 
       RowBox[{
        RowBox[{"c", " ", "r"}], "-", 
        RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}]}]}], 
   "}"}]}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"bf3bcb20-487e-43e7-85f0-f03131c05661"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"r", "-", 
     RowBox[{"h", " ", "\[Alpha]"}], "+", 
     FractionBox[
      RowBox[{"2", " ", "r", " ", "\[Rho]"}], "k"]}], " ", ">", " ", "0"}], 
   ")"}], "   ", "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]", "\[Rule]", 
     FractionBox[
      RowBox[{"c", " ", "k", " ", "r"}], 
      RowBox[{
       RowBox[{
        RowBox[{"-", "c"}], " ", "r"}], "+", 
       RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}], ",", 
    RowBox[{"h", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"k", " ", "r", " ", "\[Beta]"}], 
       RowBox[{
        RowBox[{"c", " ", "r"}], "-", 
        RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}]}]}], 
   "}"}]}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"72d2559a-ebb2-4c42-96fd-10321e58e2cc"]
}, Closed]],

Cell[CellGroupData[{

Cell["Solve the PDE for uniform equilibrium solution:", "Subsubsection",ExpressionUUID->"90c7b0a8-e627-4ebe-bdc4-2942bd65f95c"],

Cell["\<\
Setup and solve our system of PDEs.  We will assume that the initial and \
boundary conditions all correspond to steady-state uniform \
plankton-crustacean conditions.\
\>", "Text",ExpressionUUID->"497abb44-9098-4065-8b83-4e6733394515"],

Cell[BoxData[
 RowBox[{"SolutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Mu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"k1", "[", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"h", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Nu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"k2", "[", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       FractionBox[
        RowBox[{"c", " ", "k", " ", "r"}], 
        RowBox[{
         RowBox[{
          RowBox[{"-", "c"}], " ", "r"}], "+", 
         RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", "\[InvisibleSpace]", 
         RowBox[{"x", "\[Rule]", "0"}]}], ")"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", "\[InvisibleSpace]", 
         RowBox[{"x", "\[Rule]", "L"}]}], ")"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"k", " ", "r", " ", "\[Beta]"}], 
         RowBox[{
          RowBox[{"c", " ", "r"}], "-", 
          RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", "\[InvisibleSpace]", 
         RowBox[{"x", "\[Rule]", "0"}]}], ")"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", "\[InvisibleSpace]", 
         RowBox[{"x", "\[Rule]", "L"}]}], ")"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3985285685154305`*^9, 3.3985285746091805`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"9c51e98c-18ca-4536-8f52-0ae4415a3ff0"],

Cell["\<\
Plot the concentration of the plankton for five units of time:\
\>", "Text",ExpressionUUID->"6482898b-58a6-40c8-b78a-7335a6429684"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "SolutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<\[Rho][x,t]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "3"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985285783748055`*^9, 3.3985285824060555`*^9}, {
  3.3985288442341805`*^9, 3.3985288461560555`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"a90324a6-3926-49af-9b3c-745e89fd1f2c"],

Cell["\<\
Plot the concentration of the crustacean for five units of time:\
\>", "Text",ExpressionUUID->"ecb03846-4f17-4e02-abe4-3bb825d5ae1f"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "SolutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<h[x,t]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<h  \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985285851248055`*^9, 3.3985285918435555`*^9}, {
  3.3985289574216805`*^9, 3.3985289590154305`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"ff307877-45c9-4a2b-a315-8fe4946eb7fa"]
}, Closed]],

Cell[CellGroupData[{

Cell["Solve the PDE for non-uniform plankton density profile:", \
"Subsubsection",ExpressionUUID->"a35ae66b-b185-4e6a-936a-17f53bcf6c76"],

Cell["\<\
Consider an initial plankton density profile that has a small excess \
concentration of plankton in the center of our strip of ocean:\
\>", "Text",ExpressionUUID->"df3b6a79-50b1-467a-a883-6dd726cb2538"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", "[", "x_", "]"}], " ", "=", 
  RowBox[{
   FractionBox[
    RowBox[{"c", " ", "k", " ", "r"}], 
    RowBox[{
     RowBox[{
      RowBox[{"-", "c"}], " ", "r"}], "+", 
     RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]], "+", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{".4", "*", "L"}], "<", "x", "<", 
      RowBox[{".6", "*", "L"}]}], ",", 
     RowBox[{"Cos", "[", 
      RowBox[{
       FractionBox["\[Pi]", 
        RowBox[{".2", "*", "L"}]], 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         RowBox[{".5", "*", "L"}]}], ")"}]}], "]"}], ",", "0"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"e78657cc-7ad3-477d-8b9b-1e2b67ce152f"],

Cell["Plot the initial plankton density:", "Text",ExpressionUUID->"7973a368-7d45-44f4-9831-3c4ef2717ad2"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Rho]0", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "4"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<\[Rho]0\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985285971716805`*^9, 3.3985286058591805`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"c5340bec-f0a6-48ba-bc20-49cc9d74820b"],

Cell["\<\
The above initial plankton density profile is out of equilibrium near the \
center.  We expect that the crustaceans will respond by increasing their \
production and subsequently suppressing the production of plankton.
\
\>", "Text",ExpressionUUID->"27b34d2f-0234-4e9b-b923-735b5dc9a26a"]
}, Closed]],

Cell[CellGroupData[{

Cell["Solve the PDE for 70 units of time:", "Subsubsection",ExpressionUUID->"ad07c3ff-dd83-4caa-9ee8-d5fff1a59f3b"],

Cell["\<\
Solve for the plankton-crustacean concentrations for 70 units of time:\
\>", "Text",ExpressionUUID->"0a66b935-e42f-4f52-b492-e2de29ad9701"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", "70"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]", "  ", "=", "  ", ".01"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Nu]", "  ", "=", "  ", ".02"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", " ", "=", " ", ".04"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]", "  ", "=", "  ", ".1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Beta]", "  ", "=", "  ", ".03"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "  ", "=", "  ", ".2"}], ";"}]}], "InputOnly",
 CellLabel->"In[28]:=",ExpressionUUID->"4bf9704e-f3ea-4f2f-9d53-ba903424adf7"],

Cell["\<\
Setup and solve our system of PDEs.  We will assume that the initial and \
boundary conditions all correspond to steady-state uniform \
plankton-crustacean conditions.\
\>", "Text",ExpressionUUID->"db9d3a89-32dd-4780-98a5-2a832337f223"],

Cell[BoxData[{
 RowBox[{"SolutionRule", "=", "\[IndentingNewLine]", "\n", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\n", "\t\t", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], " ", 
        RowBox[{"(", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "==", "   ", 
       RowBox[{
        RowBox[{"\[Mu]", "*", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], " ", 
          RowBox[{"(", 
           RowBox[{"\[Rho]", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ")"}]}]}], "   ", "+", 
        RowBox[{"k1", "[", " ", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", "\n", "\t\t", 
      "\n", "\t", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], " ", 
        RowBox[{"(", 
         RowBox[{"h", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "==", "   ", 
       RowBox[{
        RowBox[{"\[Nu]", "*", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], " ", 
          RowBox[{"(", 
           RowBox[{"h", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ")"}]}]}], "   ", "+", 
        RowBox[{"k2", "[", " ", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", "\n", "\t\t", 
      "\n", "\t", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], " ", "==", 
       RowBox[{"\[Rho]0", "[", "x", "]"}]}], ",", "\n", "\n", " \t", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], " ", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", 
         RowBox[{"x", "->", "0"}]}], ")"}], " ", "==", " ", "0"}], ",", "\n", 
      "\t ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], " ", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", 
         RowBox[{"x", "->", "L"}]}], ")"}], " ", "==", " ", "0"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "     ", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "0"}], "]"}], " ", "==", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"k", " ", "r", " ", "\[Beta]"}], 
         RowBox[{
          RowBox[{"c", " ", "r"}], "-", 
          RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}]}], ",", "\n", 
      "\n", " \t", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], " ", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", 
         RowBox[{"x", "->", "0"}]}], ")"}], " ", "==", " ", "0"}], ",", "\n", 
      "\t ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], " ", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "/.", 
         RowBox[{"x", "->", "L"}]}], ")"}], " ", "==", " ", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\n", "\t", "\n", "\t", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "}"}], ",", "\n", "\t", "\n", "\t", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\n", "\t", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"600", ",", "600"}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"AccuracyGoal", "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
   "]"}]}], "\n", 
 RowBox[{"\t\t"}]}], "Input",
 CellChangeTimes->{{3.3985286122966805`*^9, 3.3985286462185555`*^9}, {
  3.466532477614683*^9, 3.466532488145731*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"959010c2-6512-4832-859a-6fa9847ba65f"],

Cell["Plot the concentration of the plankton for 70 units of time:", "Text",ExpressionUUID->"28ca3c31-5b9e-4e56-b0ad-138ca6f2d528"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "SolutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<\[Rho][x,t]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "4"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "30"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho] \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985286504529305`*^9, 3.3985286548748055`*^9}, {
  3.3985288641404305`*^9, 3.3985288655779305`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"198ecd9f-cbd7-4dcf-8eda-59024bdec0c1"],

Cell["\<\
Plot the concentration of the crustaceans for 70 units of time:\
\>", "Text",ExpressionUUID->"934ef47e-4f0e-4d0c-8a6b-b2f62f667026"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "SolutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<h[x,t]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{".4", ",", ".5"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "30"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<h  \>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985286572029305`*^9, 3.3985286630310555`*^9}, {
  3.3985289675310555`*^9, 3.3985289692654305`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"d7353a3a-082a-47bc-a641-6b31cae6ff2e"],

Cell["\<\
The above two graphs clearly illustrate that for these specific values that \
the competition between plankton and crustaceans will return to the \
equilibrium conditions as time progresses.  However, for other values and for \
other sub models, the model will predict different behaviors.\
\>", "Text",ExpressionUUID->"a02fb548-8011-4c61-b3da-c4e7b0489c8d"]
}, Closed]],

Cell[CellGroupData[{

Cell["Animation:", "Subsubsection",ExpressionUUID->"75264c42-e4ba-4899-817b-b7aa9c67ae7d"],

Cell["\<\
It may be easier to visualize the above plankton-crustacean interaction if \
animation is used.

In order to more easily fit both the crustacean and plankton densities onto \
one graph, re-scale the crustacean density.\
\>", "Text",ExpressionUUID->"5ff42f9e-0c75-4443-b965-2359609d395d"],

Cell[BoxData[
 RowBox[{"scale", "=", 
  RowBox[{
   FractionBox["\[Rho]", "h"], "      ", "/.", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Rho]", "\[Rule]", 
      FractionBox[
       RowBox[{"c", " ", "k", " ", "r"}], 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c"}], " ", "r"}], "+", 
        RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}], ",", 
     RowBox[{"h", "\[Rule]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"k", " ", "r", " ", "\[Beta]"}], 
        RowBox[{
         RowBox[{"c", " ", "r"}], "-", 
         RowBox[{"k", " ", "\[Alpha]", " ", "\[Beta]"}]}]]}]}]}], 
    "}"}]}]}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"7932e970-c284-4612-834f-298f34b6174a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]1", "[", 
       RowBox[{"x_", ",", "t_"}], "]"}], ",", 
      RowBox[{"h1", "[", 
       RowBox[{"x_", ",", "t_"}], "]"}]}], "}"}], "=", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"Flatten", "[", "SolutionRule", "]"}]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"Flatten", "[", "SolutionRule", "]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]1", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", 
       RowBox[{"scale", "*", 
        RowBox[{"h1", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotPoints", "\[Rule]", "30"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".007", "]"}], ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0", ",", "0"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".007", "]"}], ",", 
          RowBox[{"Dashing", "[", 
           RowBox[{"{", 
            RowBox[{".03", ",", ".03"}], "}"}], "]"}], ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0", ",", "0", ",", "1"}], "]"}]}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<x-Distance\>\"", ",", 
        "\"\<\!\(\*StyleBox[\"\[Rho]\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"x\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\",\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[1, 0, 0]]\)   and   \
\!\(\*StyleBox[\"h\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"x\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\",\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[0, 0, 1]]\)\>\""}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AnimationRate", "\[Rule]", "2"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.3985286688904305`*^9, 3.3985286789998055`*^9}, {
   3.3985303982966805`*^9, 3.3985304475154305`*^9}, {3.3985305481091805`*^9, 
   3.3985305550466805`*^9}, 3.3985307449998055`*^9, {3.3985308367966805`*^9, 
   3.3985309131560555`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"ed5de908-514e-4541-ac77-33e3a3a22980"]
}, Closed]]
}, Closed]]
