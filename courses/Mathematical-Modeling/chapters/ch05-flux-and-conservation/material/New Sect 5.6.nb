Cell[BoxData[
 RowBox[{"SolutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Mu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"k1", "[", 
         RowBox[{
