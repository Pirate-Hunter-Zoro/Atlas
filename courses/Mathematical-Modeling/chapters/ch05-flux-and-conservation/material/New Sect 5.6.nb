Notebook[{

Cell[CellGroupData[{
Cell[" Section 5.6", "Title",ExpressionUUID->"7d4b35c1-03fe-427c-b900-d421a76b90b8"],

Cell[TextData[StyleBox["  Morphogenesis",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"aec98b06-2a33-435a-b96a-a616f80c02b0"],

Cell["", "Text",ExpressionUUID->"fe380e8e-6996-4fd7-9969-cd5b6f829239"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Off", "[", 
    RowBox[{"NDSolve", "::", "\"\<mxsst\>\""}], "]"}]}]}]], "InputOnly",
 CellChangeTimes->{
  3.3985283018591805`*^9, {3.46653226713435*^9, 3.4665322710092754`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"378c6785-61ae-4185-8221-32df100fc851"],

Cell[CellGroupData[{

Cell["\<\
Morphogenesis
Reaction-diffusion equations:\
\>", "Section",ExpressionUUID->"ebc7d97b-8ea0-4b77-9f46-369b296c9d6e"],

Cell[TextData[{
 "The process whereby form and pattern evolve in a biological system is \
called morphogenesis.\n\nWe are given a one-dimensional strip of tissue \
consisting of a homogeneous aggregate of living cells.  Each cell has the \
same chemicals within it, and these diffuse through the tissue and react with \
one another.  For simplicity we will consider only two such chemical agents:\n\
\nOne agent is called a morphogen because in certain high enough \
concentrations it activates a change in cell structure and these altered \
cells are then induced to grow.  The differentiated cells give rise to such \
recognizable features as hair follicles or skin etc..\n\nThe other chemical \
agent is called an inhibitor because it tends to dampen the growth of the \
morphogen.\n\nIt is the interplay between the two chemicals and their \
respective movement that is responsible for the change in their \
concentrations.\n\n\tLet  \[Rho][x,t]  =  morphogen concentration\n\n\tLet  \
h[x,t]  =  inhibitor concentration\n\nOur model will be a conservation model \
for morphogen, where the flux term will be through diffusion only:\n\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "\[Rho]", ")"}]}], "  ", "==", "  ", 
   RowBox[{
    RowBox[{"-", "  ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", " ", "\[Mu]"}], "*", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], " ", 
         RowBox[{"(", "\[Rho]", ")"}]}]}], ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k1", "[", " ", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"1b1f6e82-4a72-4fb4-b64b-b7d679d09a2c"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "\[Rho]", ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", "\[Rho]", ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k1", "[", " ", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"35973dee-253f-4832-9e25-e6d2286aff9b"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k1", "[", " ", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"8cc9cd8e-c778-4fa7-b66d-62a4cac41c9a"],
 "\n\n and inhibitor, where the flux term will be through diffusion only:\n \n\
",
 StyleBox["  \t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "h", ")"}]}], "  ", "==", " ", 
   RowBox[{
    RowBox[{"-", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", " ", "\[Nu]"}], "*", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], " ", 
         RowBox[{"(", "h", ")"}]}]}], ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k2", "[", " ", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"85501e15-39fc-4166-a4e3-bc54f0ecc40f"],
 StyleBox["\n \t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", "h", ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Nu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", "h", ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k2", "[", " ", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"a02a1a69-4e21-4e84-99fd-532f879ce929"],
 StyleBox["\n \t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"(", 
     RowBox[{"h", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ")"}]}], "  ", "==", "   ", 
   RowBox[{
    RowBox[{"\[Nu]", "*", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], " ", 
      RowBox[{"(", 
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ")"}]}]}], "   ", "+", "  ", 
    RowBox[{"k2", "[", " ", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"b9e291b3-238a-41fa-95f9-79d3243970b9"],
 "\n\nThe source and sink terms for both morphogen and inhibitor depend upon \
their respective concentrations.  Consider the following examples for source \
and sink terms for the morphogen:"
}], "Text",ExpressionUUID->"29939e15-64b9-4831-bf98-dc2a3474af92"],

Cell[BoxData[
 RowBox[{
  RowBox[{"k1", "[", 
   RowBox[{"\[Rho]_", ",", "h_"}], "]"}], "=", 
  RowBox[{
   FractionBox[
    RowBox[{"a", "*", 
     SuperscriptBox["\[Rho]", "2"]}], "h"], "  ", "-", " ", "a"}]}]], "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"536ed7a7-9b9e-4e3c-b4d1-fdee8025e4dc"],

Cell["And for the inhibitor:", "Text",ExpressionUUID->"d10faaf0-ec6a-4018-a0fb-bf39776e411b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"k2", "[", 
   RowBox[{"\[Rho]_", ",", "h_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"c", "*", 
    SuperscriptBox["\[Rho]", "2"]}], " ", "-", "c"}]}]], "Input",
 CellLabel->"In[67]:=",ExpressionUUID->"3eb7a0d5-2681-421b-b7ab-af0d2eb74bb0"],

Cell[TextData[{
 "The precise form of the sink and source terms depends upon the specific \
biological system under study.  However, some common characteristics are \
required to insurer that the inhibitor-morphogen relationship behaves as \
expected.  \n\nFirst, the growth of the morphogen must be autocatalytic, \
which is to say that it stimulates its own production.  This means that the \
source term for the morphogen must produce more morphogen.  I.e.\n\n\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"k1", "[", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "e8e29244-9818-4625-bb2c-08883ec8177e"],
 " > 0\n\t"
}], "Text",ExpressionUUID->"1ea28675-cdb3-4315-9ba2-4e7a97a9bd5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
   RowBox[{"k1", "[", 
    RowBox[{"\[Rho]", ",", "h"}], "]"}]}], ">", "0"}]], "Input",
 CellChangeTimes->{{3.7507036368515253`*^9, 3.750703637449585*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"1f4d7dc0-f562-45f3-a4d0-c360f49684b1"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", ">", "0"}], "\[And]", 
    RowBox[{"h", ">", "0"}], "\[And]", 
    RowBox[{"\[Rho]", ">", "0"}]}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", "a", " ", "\[Rho]"}], "h"], ">", "0"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.750703665390379*^9, 3.75070388552639*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"89eb0a79-8a1e-40bd-a759-210239ef0e62"],

Cell[TextData[{
 "Second, the level of the inhibitor rises with an increase in morphogen:\n\n\
\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
    RowBox[{"k2", "[", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "b2f3ae5d-e42b-4673-ad1b-5a13b5435e07"],
 " > 0\n"
}], "Text",ExpressionUUID->"f9fcc8e0-9ad2-455d-9d51-a510ccae873c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", "\[Rho]"], " ", 
   RowBox[{"k2", "[", 
    RowBox[{"\[Rho]", ",", "h"}], "]"}]}], ">", "0"}]], "Input",
 CellChangeTimes->{{3.750703893741212*^9, 3.7507038942192593`*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"c333a23d-64bc-4168-8ac5-3fb64697e2d9"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"c", ">", "0"}], "\[And]", 
    RowBox[{"\[Rho]", ">", "0"}]}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"2", " ", "c", " ", "\[Rho]"}], ">", "0"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.7507039163984776`*^9, 3.7507039355923967`*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"e688e359-5b83-4211-950b-9805a5c8478f"],

Cell[TextData[{
 "Finally, the inhibitor suppress is the production of morphogen:\n\n\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "h"], " ", 
    RowBox[{"k1", "[", 
     RowBox[{"\[Rho]", ",", "h"}], "]"}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "49a54cb5-c650-4429-8033-7fe6ee1a3221"],
 " < 0\n"
}], "Text",ExpressionUUID->"4e60c0f2-8894-4474-8b04-7980117a0d33"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", "h"], " ", 
   RowBox[{"k1", "[", 
    RowBox[{"\[Rho]", ",", "h"}], "]"}]}], "<", "0"}]], "Input",
 CellChangeTimes->{{3.75070394312615*^9, 3.7507039488627234`*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"0a07ee34-e597-4d78-bd8c-371529636ae3"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", ">", "0"}], "\[And]", 
    RowBox[{"h", ">", "0"}], "\[And]", 
    RowBox[{"\[Rho]", ">", "0"}]}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"a", " ", 
        SuperscriptBox["\[Rho]", "2"]}], 
       SuperscriptBox["h", "2"]]}], "<", "0"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{3.7507039876656036`*^9},
 CellLabel->"In[73]:=",ExpressionUUID->"ae257079-bd00-4583-9724-ff7459e674ca"],

Cell[CellGroupData[{

Cell["Special case: morphogen-inhibitor equilibrium:", "Subsubsection",ExpressionUUID->"284fda64-71c3-425a-95c9-cda4ec91e85b"],

Cell[TextData[{
 "Consider the special case where the morphogen and inhibitor are both in \
steady-state equilibrium.  For steady-state conditions, the time derivatives \
are zero.  Furthermore, consider the special case of a uniform morphogen and \
inhibitor density distribution (therefore the spatial derivatives will also \
be zero).\n\nSolve for the ",
 StyleBox["equilibrium",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["uniform",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " values of morphogen and inhibitor:"
}], "Text",ExpressionUUID->"788f1875-563e-4b08-8ae4-5779154a11f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"k1", "[", 
        RowBox[{"\[Rho]", ",", "h"}], "]"}], "==", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k2", "[", 
        RowBox[{"\[Rho]", ",", "h"}], "]"}], "==", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "h"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "TableForm"}]], "Input",
 CellChangeTimes->{{3.3985283373123055`*^9, 3.3985283515779305`*^9}, {
   3.750704209889824*^9, 3.750704216866521*^9}, 3.7507042503308673`*^9},
 CellLabel->"In[78]:=",ExpressionUUID->"32009782-359d-4a07-8ed4-bf055df3d7df"]
}, Closed]],

Cell[CellGroupData[{

Cell["PDE Solution:", "Subsubsection",ExpressionUUID->"3b29eff6-68b3-4b45-a977-12d083397e23"],

Cell["\<\
Consider a biological strip of tissue ten units wide.  We will assume some \
reasonable values for the diffusion coefficients \[Mu] and \[Nu].  \
Specifically, to insure that the inhibitor spreads out faster than the \
morphogen, we will assume that the diffusion coefficient for the inhibitor is \
twice is large as the diffusion coefficient of the morphogen.

\t\[Mu]  =  .01
\t\[Nu]  =  .02
\
\>", "Text",ExpressionUUID->"d7798577-1e1d-4afd-b25a-74b59e495d2c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]", "  ", "=", "  ", ".01"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Nu]", "  ", "=", "  ", ".02"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "  ", "=", "  ", ".1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "  ", "=", "  ", ".2"}], ";"}]}], "InputOnly",
 CellLabel->"In[80]:=",ExpressionUUID->"69efdf52-c6ef-4580-9b79-f0015593876a"],

Cell["\<\
Setup and solve our system of PDEs.  We will assume that the initial and \
boundary conditions all correspond to steady-state uniform \
morphogen-inhibitor conditions.\
\>", "Text",ExpressionUUID->"02cc539f-1a0d-4638-aee1-b71bcc41e450"],

Cell[BoxData[
 RowBox[{"SolutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Mu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"k1", "[", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"h", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Nu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"k2", "[", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", "1"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3985283652966805`*^9, 3.3985283691873055`*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"dd043f51-112a-45a4-b594-2992a4dbf302"],

Cell["\<\
Plot the concentration of the morphogen for five units of time:\
\>", "Text",ExpressionUUID->"7590ccbb-9b92-46ac-86a6-8d23155b0ab7"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "SolutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<\[Rho][x,t]\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "2"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x-Distance\>\"", ",", "\"\<time\>\"", ",", "\"\<\[Rho]\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3985283782029305`*^9, 3.3985284247029305`*^9, {3.3985287563435555`*^9, 
   3.3985287577498055`*^9}},
 CellLabel->"In[87]:=",ExpressionUUID->"8ee687be-f9e8-49bc-b25b-75429e11794e"],

Cell["\<\
Plot the concentration of the inhibitor for five units of time:\
\>", "Text",ExpressionUUID->"8ce604dd-b806-4f58-bc94-03fcade4a0c2"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "SolutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
