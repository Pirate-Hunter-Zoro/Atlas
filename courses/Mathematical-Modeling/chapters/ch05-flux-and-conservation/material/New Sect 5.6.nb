          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"\[Rho]0", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
