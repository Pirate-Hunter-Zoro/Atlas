Cell["\<\
To illustrate the changing density profile, consider animating a density plot \
for 0 \[LessEqual] x \[LessEqual]10 for different times ti = 200, 300, \
400,...
(Our problem is one-dimensional, however DensityPlot is two-dimensional.  \
Therefore, we will introduce a \"Fake\" y-coordinate to give our \
one-dimensional slice some width.)\
\>", "Text",ExpressionUUID->"8195efa1-3c51-4153-9061-638a311ea7fd"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"DensityPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "ti"}], "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"Flatten", "[", "solutionRule", "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FrameTicks", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"True", ",", "False"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"ColorFunction", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", "#1", ")"}], "/", "3"}], ",", "1"}], "]"}], ",", 
          "0", ",", "0"}], "]"}], "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ColorFunctionScaling", "\[Rule]", "False"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"ti", ",", "0", ",", "2500"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.398495325835*^9, 3.398495346902*^9}, 
   3.398495408618*^9, {3.3984954685690002`*^9, 3.398495482792*^9}, {
   3.3984955364779997`*^9, 3.398495539002*^9}, {3.39849560101*^9, 
   3.39849560152*^9}, {3.398495772435*^9, 3.398495776617*^9}, {
   3.3984960984440002`*^9, 3.3984961251540003`*^9}, {3.39849616259*^9, 
   3.398496192138*^9}, {3.398496281225*^9, 3.3984963507679996`*^9}, {
   3.398496626968*^9, 3.398496641712*^9}, {3.398496690382*^9, 
   3.398496798226*^9}},
 CellLabel->
  "In[1532]:=",ExpressionUUID->"6b9eb486-563e-43d7-b574-312e5dbff2fd"],

Cell["\<\
However, it may be easier to visualize the changes in density using standard \
plots for different times ti = 100, 200, 300, 400,... :\
\>", "Text",ExpressionUUID->"b54f4c35-c634-4d86-a0f6-c462b29ba7ad"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "ti"}], "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ti", ",", "100", ",", "tStop", ",", "100"}], "}"}]}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<\[Rho]\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{3.398496858451*^9},
 CellLabel->
  "In[1533]:=",ExpressionUUID->"d62c4fc9-739b-49ef-8b06-fe2baa0fe08c"],

Cell["\<\
The above graph indicates that the non-equilibrium algae bloom problem (for \
these conditions and boundary conditions) will approach a steady state \
solution.

It is also possible to study the influence of other variables.  For example, \
increase the population growth rate term from .1 to .2:\
\>", "Text",ExpressionUUID->"bd1fbed9-7059-46b2-90bc-2f456aca409d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "  ", "=", "  ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Nu]", "  ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "  ", "=", "  ", ".20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "  ", "=", "  ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}]}], "InputOnly",
 CellChangeTimes->{{3.465151900920911*^9, 3.465151903608755*^9}, 
   3.750424965971772*^9},
 CellLabel->
  "In[1539]:=",ExpressionUUID->"bc249445-099c-4f43-a59a-53d4cca20455"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Nu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"r", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "k"]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
