 CellLabel->
  "In[1503]:=",ExpressionUUID->"472d06d3-f830-4511-8e61-95da4f4add23"],

Cell["\<\
Observe that eventually the growth over powers the diffusion.  This is a \
consequence of using the unlimited growth population model.\
\>", "Text",ExpressionUUID->"a02c5793-31dc-47b3-9bc2-64bb4df87aa7"],

Cell["\<\

However, what happens if the reproductive rate is increased even more (from \
.1 to .15):\
\>", "Text",ExpressionUUID->"2df5a720-c451-4c0d-a70a-a0218536598f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "  ", "=", "  ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Nu]", "  ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "  ", "=", "  ", ".15"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}]}], "InputOnly",
 CellChangeTimes->{{3.4651517048645687`*^9, 3.46515170756804*^9}},
 CellLabel->
  "In[1504]:=",ExpressionUUID->"213b1aac-f01f-4f0e-bd6a-c48df467efe8"],

Cell[BoxData[
