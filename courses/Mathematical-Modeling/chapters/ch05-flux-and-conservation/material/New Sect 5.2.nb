 CellChangeTimes->{{3.398494708113*^9, 3.39849471284*^9}},
 CellLabel->
  "In[1509]:=",ExpressionUUID->"74546c6c-acee-493c-8581-351afc407ad6"],

Cell["\<\
We can see from the above plot that the the algae bloom will grow without \
bound.  

The above three cases support our analysis that a steady state equilibrium \
solution for an algae bloom can exist only for extremely specific \
combinations of size, diffusion rate and reproductive rate (assuming that the \
unlimited growth model is used).  

The unrealistic behavior of the unlimited growth model suggests that a \
limited growth model might be more appropriate.\
\>", "Text",ExpressionUUID->"cd15dce3-d4d8-4df2-8f55-8cfcc7c70daf"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" Limited Growth Model:", "Section",ExpressionUUID->"1a068e29-2d4c-4890-a833-03acadef151f"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",E\
xpressionUUID->"8751dcfd-31cc-49d3-80b8-d62ac8edd50a"],

Cell[TextData[{
 "If we use limited growth for our source term, then be PDE model becomes:\n\n\
 \t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"(", " ", "\[Rho]", " ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"e438f539-0620-44e5-8af6-e5d82ef26325"],
 "  =   \[Nu] ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "xx"], 
     RowBox[{"(", " ", 
      FormBox[
       RowBox[{"\[Rho]", ")"}],
       TraditionalForm], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "18f8a7fe-96d9-4aeb-a8a2-6dedc99f538e"],
 "  +  k\n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"(", " ", "\[Rho]", " ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"2c427a41-5424-47f4-8dcd-7de0b41dece1"],
 "  =   \[Nu] ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "xx"], 
     RowBox[{"(", " ", 
      FormBox[
       RowBox[{"\[Rho]", ")"}],
       TraditionalForm], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "8ff35c10-75eb-4831-aad3-cf2df886ba57"],
 "  +  r \[Rho] (1  -  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["\[Rho]", "k"],
    FontSize->16,
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e6379183-4966-46c9-b035-7fb7d2b45d01"],
 ")\n"
}], "Text",ExpressionUUID->"6fbf9683-f5c1-47eb-9551-58968e82f4a1"],

Cell["\<\
The analysis for this model can proceed along two different lines:

\tLooking for steady state solutions.
\tLooking for non-equilibrium solutions.\
\>", "Text",ExpressionUUID->"4a784496-5d36-4ca6-8d62-43b660a10844"],

Cell[CellGroupData[{

Cell["\<\
 Steady state solutions:
\
\>", "Subsubsection",
 CellChangeTimes->{{3.4651517251952963`*^9, 
  3.465151729727126*^9}},ExpressionUUID->"39ba8c0b-10c8-4dd0-9c52-\
f424bde32f43"],

Cell[TextData[{
 "First, let's look at the behavior of steady state solutions.  For this \
case:\n\n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"(", " ", "\[Rho]", " ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"49a4349f-fd78-4f4b-98d4-5ef851f84e1b"],
 "  =  0\n \t\nThus, the PDE reduces to a non-linear ODE:\n\n \t\[Nu] ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "xx"], 
     RowBox[{"(", " ", 
      FormBox[
       RowBox[{"\[Rho]", ")"}],
       TraditionalForm], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "1f70cba8-16dc-4a6e-8bd5-c5142a3d1a46"],
 "  +  r \[Rho] (1  -  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["\[Rho]", "k"],
    FontSize->16,
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "528e9d2a-c5fd-45a5-a37d-01474c341af3"],
 ")  =  0\n \t"
}], "Text",ExpressionUUID->"3baab454-f7f2-4e59-a475-b75718eb1050"],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Nu]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]", "'"}], "'"}], "[", "x", "]"}]}], " ", "+", " ", 
     RowBox[{"r", " ", 
      RowBox[{"\[Rho]", "[", "x", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        FractionBox[
         RowBox[{"\[Rho]", "[", "x", "]"}], "k"]}], ")"}]}]}], "==", "0"}], 
   ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"\[Rho]", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{{3.398494727568*^9, 3.3984947411879997`*^9}},
 CellLabel->
  "In[1510]:=",ExpressionUUID->"aa4ebf0a-dc15-4b53-b346-f36c5cafff21"],

Cell[TextData[{
 "The above solution is not very useful.  Therefore, we will follow the \
direction of the book and examine the behavior of the vector field in the \
phase plane.\n\nSpecific numeric values must be assigned to the coefficients \
in the ODE in order that a graph can be generated:\n\n\tL  =  10;\n\t\[Nu]  = \
1;\n\tr  =  .10;\n\tk  =  100;\n\t\n\t\[Rho]1  =  \[Rho]\n\t\[Rho]1'  =  \
\[Rho]2\n\t\[Rho]2'  =  \[Rho]1''  =  \[Rho]''\n\t       =  -  ",
 Cell[BoxData[
  FormBox[
   FractionBox["r", "\[Nu]"], TraditionalForm]],ExpressionUUID->
  "09c17b39-da0e-4cdf-b5b2-d3117483156e"],
 " \[Rho]1 (1  -  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["\[Rho]1", "k"],
    FontSize->16,
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "8971e1e2-1a10-4019-bfa4-3837607e848f"],
 ")\n"
}], "Text",ExpressionUUID->"6a79c89a-67eb-4e0c-abe3-5799d1dfe5ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "  ", "=", "  ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Nu]", "  ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "  ", "=", "  ", ".10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "  ", "=", "  ", "100"}], ";"}]}], "InputOnly",
 CellChangeTimes->{{3.4651517441664743`*^9, 3.465151746604286*^9}},
 CellLabel->
  "In[1511]:=",ExpressionUUID->"00fa6c35-aab1-4ac2-a453-096fad07fc53"],

Cell[BoxData[
 RowBox[{"graph1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]2", ",", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"r", " ", "\[Rho]1", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox["\[Rho]1", "k"]}], ")"}]}], "\[Nu]"]}]}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", 
      RowBox[{"-", "200"}], ",", "200"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Rho]2", ",", 
      RowBox[{"-", "100"}], ",", "100"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<\[Rho]1\>\"", ",", "\"\<\[Rho]2\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3984947777869997`*^9, 3.398494848922*^9}, {
  3.4651517534957933`*^9, 3.4651517734514723`*^9}},
 CellLabel->
  "In[1515]:=",ExpressionUUID->"c45790d5-0a09-4edc-a26f-e1541a0d1054"],

Cell["\<\
The above vector field displays solution orbits in the phase plane.  Observe \
that we have allowed negative values for the density.  In our real physical \
problem, the density must start at 0 (i.e. the left boundary condition) and \
stop at 0 (i.e. the right boundary condition).  In order to help clarify the \
starting and stopping boundary conditions, the vertical line corresponding to \
0 density will be superimposed on the above graph.\
\>", "Text",ExpressionUUID->"1b423a97-2170-43a8-a4d1-4c0d56abf395"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"graph1", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Blue", ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "100"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "100"}], "}"}]}], "}"}], "]"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.398494890903*^9, 3.3984949447279997`*^9}},
 CellLabel->
  "In[1516]:=",ExpressionUUID->"12e38f9e-0076-42d6-b930-6884e74f5353"],

Cell["\<\
The above vector field clearly indicates (at least for steady state \
solutions) that there is only a limited range for the density which will \
result in a stable system. 

It is now possible to determine the largest possible internal density:\
\>", "Text",ExpressionUUID->"f3bccaf6-496b-491c-baf8-1e2bac67890e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]2", ",", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"r", " ", "\[Rho]1", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            FractionBox["\[Rho]1", "k"]}], ")"}]}], "\[Nu]"]}]}], "}"}], "==", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", "\[Rho]2"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "TableForm"}]], "Input",
 CellChangeTimes->{{3.398495003767*^9, 3.398495037751*^9}},
 CellLabel->
  "In[1517]:=",ExpressionUUID->"761bb74e-8d54-4c93-b267-15dc119f05a4"],

Cell["\<\
We see that this density corresponds to the maximum allowable density in our \
limited growth model (i.e.  =  k).\
\>", "Text",ExpressionUUID->"c408ae06-4bad-4436-b03e-7a75ad3d225a"],

Cell["Indicate the maximum density on the vector field as well:", "Text",ExpressionUUID->"458e0a3c-e8aa-4bbe-9715-8e6929fbfd55"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"graph1", ",", "\[IndentingNewLine]", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Blue", ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "100"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "100"}], "}"}]}], "}"}], "]"}]}], "}"}], "]"}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Blue", ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"-", "100"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "100"}], "}"}]}], "}"}], "]"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.398495083505*^9, 3.398495096764*^9}},
 CellLabel->
  "In[1518]:=",ExpressionUUID->"1f95f570-5523-4b7f-8833-c14b0aac03ed"],

Cell["\<\
Observe that only solutions that orbit between these two lines will generate \
a steady state solution.

It is possible to zoom in to better visualize the behavior:\
\>", "Text",ExpressionUUID->"469a6b42-8df2-4913-9d7a-a0faf6412742"],

Cell[BoxData[
 RowBox[{"graph1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]2", ",", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"r", " ", "\[Rho]1", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox["\[Rho]1", "k"]}], ")"}]}], "\[Nu]"]}]}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Rho]1", ",", "0", ",", "100"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Rho]2", ",", 
      RowBox[{"-", "25"}], ",", "25"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", ".9"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<\[Rho]1\>\"", ",", "\"\<\[Rho]2\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.398495116208*^9, 3.398495183533*^9}, {
  3.4651518115032167`*^9, 3.465151819051058*^9}},
 CellLabel->
  "In[1519]:=",ExpressionUUID->"d5daba71-d0b2-4677-9037-4422e4f46bca"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 Non-equilibrium solutions:
\
\>", "Subsubsection",
 CellChangeTimes->{
  3.465151730524103*^9},ExpressionUUID->"7e61d409-ec77-4241-b764-\
69550c110dbd"],

Cell[TextData[{
 "Some of the more interesting behavior of our model would correspond to \
non-equilibrium solutions.  However, the complexity of the solution for the \
PDE necessitates the use of numerical methods.  Therefore, specific values \
corresponding to the physical process will be assigned:\n\n \t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"(", " ", "\[Rho]", " ", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"ed92b7a3-d553-44e2-8c7b-db17a6f3f8db"],
 "  =   \[Nu] ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "xx"], 
     RowBox[{"(", " ", 
      FormBox[
       RowBox[{"\[Rho]", ")"}],
       TraditionalForm], " "}]}]}], TraditionalForm]],ExpressionUUID->
  "8dc6a7fa-be2e-4333-96d0-225060acfb51"],
 "  +  r \[Rho] (1  -  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["\[Rho]", "k"],
    FontSize->16,
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "1aec9159-24b3-4b79-b0f5-b957ff268da2"],
 ")\n \t\[Rho][x,0]  =  x*(10-x)\n \t\[Rho][0,t]  =  0\n\t\[Rho][L,t]  =  0\n\
\t\n The following values are identical to those used above:\n\tL  =  10\n\t\
\[Nu]  = 1\n\tr  =  .10\n\tk  =  100\n\ttStop = 50\n\t"
}], "Text",ExpressionUUID->"6ad2fb68-1ea9-4117-a8db-164d13c51c26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "  ", "=", "  ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Nu]", "  ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "  ", "=", "  ", ".10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "  ", "=", "  ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "50"}], ";"}]}], "InputOnly",
 CellChangeTimes->{{3.4651518324902782`*^9, 3.465151835350019*^9}, 
   3.750424896646841*^9},
 CellLabel->
  "In[1520]:=",ExpressionUUID->"78c5cd72-7b03-4611-81aa-ae6a10ee2845"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Nu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"r", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "k"]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"x", " ", 
        RowBox[{"(", 
         RowBox[{"10", "-", "x"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[Rho]", ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.398495202672*^9, 3.398495217495*^9}},
 CellLabel->
  "In[1525]:=",ExpressionUUID->"ece4b91b-5e27-4313-b27a-b627e462dfd1"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<t\>\"", ",", "\"\<\[Rho]\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",\

 CellChangeTimes->{{3.3984952255550003`*^9, 3.398495228678*^9}},
 CellLabel->
  "In[1526]:=",ExpressionUUID->"4139ea74-5e0c-42ee-86d2-a1f8ba89528c"],

Cell["\<\
We can see from the above plot that the diffusion exceeds the increase in \
population due to reproduction.  For these specific values the algae bloom \
density will decline.  In order to better see this, increase the time:\
\>", "Text",ExpressionUUID->"24a400fe-cd3c-46dc-b0f9-cd7b8867ce2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "500"}], ";"}]], "InputOnly",
 CellLabel->
  "In[1527]:=",ExpressionUUID->"27933fc1-830d-4946-a67e-af1747b3c58c"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Nu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"r", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "k"]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"x", " ", 
        RowBox[{"(", 
         RowBox[{"10", "-", "x"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[Rho]", ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3984952400699997`*^9, 3.398495254601*^9}},
 CellLabel->
  "In[1528]:=",ExpressionUUID->"98540569-ecda-481d-95b1-a91546e30012"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"Flatten", "[", "solutionRule", "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<t\>\"", ",", "\"\<\[Rho]\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",\

 CellChangeTimes->{{3.398495261007*^9, 3.39849526488*^9}},
 CellLabel->
  "In[1529]:=",ExpressionUUID->"79fcffb2-a637-4d66-9761-c4b8c3e37892"],

Cell["\<\
By increasing the time even further, it is possible to determine the \
asymptotic time behavior of the solution:\
\>", "Text",ExpressionUUID->"5b0ade97-7f6b-4c5d-bed2-2d2fb3a24069"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", " ", "=", " ", "5000"}], ";"}]], "InputOnly",
 CellLabel->
  "In[1530]:=",ExpressionUUID->"df665fc2-63ce-4230-bc9d-606fd6e6fba3"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Nu]", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        RowBox[{"r", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "t"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "t"}], "]"}], "k"]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"x", " ", 
        RowBox[{"(", 
         RowBox[{"10", "-", "x"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"L", ",", "t"}], "]"}], "\[Equal]", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[Rho]", ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
