 CellChangeTimes->{{3.3982921542813997`*^9, 3.3982921670694*^9}, {
  3.3982922018473997`*^9, 3.3982922301284*^9}, {3.4637649937109747`*^9, 
  3.4637649983515105`*^9}},
 CellTags->"S5.43.1",
 CellLabel->
  "In[1010]:=",ExpressionUUID->"f50b73d1-3259-41fc-9df3-7be842e46f32"],

Cell["\<\
Observe that the solutions to this ODE will always be stable.\
\>", "Text",
 CellChangeTimes->{
  3.3982908935724*^9},ExpressionUUID->"3a2e42c4-0f64-49ec-838f-da011e80614f"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 Imaginary Exponents With A Negative Real Part and
 One Negative Real Exponent\
\>", "Subsubsection",ExpressionUUID->"373500ee-7b6b-4100-870a-7bdb2ba9199e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a11", "=", 
   RowBox[{"-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a12", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a13", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a21", "=", 
   RowBox[{"-", "3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a22", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a23", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a31", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a32", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a33", "=", 
   RowBox[{"-", "1"}]}], ";"}]}], "InputOnly",
 CellLabel->
  "In[1011]:=",ExpressionUUID->"37f212c9-e6c6-4b3c-8cbd-cd611e2104cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", " ", "=", " ", 
    RowBox[{"(", GridBox[{
       {"a11", "a12", "a13"},
       {"a21", "a22", "a23"},
       {"a31", "a32", "a33"}
      }], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"A", " ", "//", " ", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.7487798087854586`*^9, 3.748779811511731*^9}},
 CellLabel->
  "In[1020]:=",ExpressionUUID->"5e4f593d-f552-4506-b45b-88d471f1564c"],

Cell["Determine the corresponding eigenvalues for this matrix:", "Text",ExpressionUUID->"92333ad7-fd4a-4537-8cc2-75ccc3e42bbe"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Det", "[", "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"A", "  ", "-", "  ", 
    RowBox[{"\[Lambda]", " ", "*", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "  ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982922472164*^9, 3.3982922506574*^9}},
 CellLabel->
  "In[1022]:=",ExpressionUUID->"88da6005-3292-4a65-88ad-9af7da482076"],

Cell[BoxData[
 RowBox[{"Solve", "[", "   ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Det", "[", "  ", 
     RowBox[{"A", "  ", "-", "  ", 
      RowBox[{"\[Lambda]", " ", "*", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "  ", "]"}], " ", "==", 
    "  ", "0"}], ",", "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[Lambda]"}], "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3982922570414*^9, 3.3982922653444*^9}},
 CellLabel->
  "In[1023]:=",ExpressionUUID->"a08abb9f-0f8b-4469-a687-c3d19e269ced"],

Cell["\<\
Therefore, two of the eigenvalues are complex with negative real parts, and \
one eigenvalues is both real and negative.  Observe that the three solutions \
correspond to both real and complex values of \[Lambda].  
Look at the corresponding vector field.\
\>", "Text",
 CellChangeTimes->{
  3.3982908989644003`*^9},ExpressionUUID->"df436eec-f3ff-45e0-acc3-\
587d3f307aac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"u1_", ",", "u2_", ",", "u3_"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a11", " ", "u1"}], "+", 
     RowBox[{"a12", " ", "u2"}], "+", 
     RowBox[{"a13", " ", "u3"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a21", " ", "u1"}], "+", 
     RowBox[{"a22", " ", "u2"}], "+", 
     RowBox[{"a23", " ", "u3"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a31", " ", "u1"}], "+", 
     RowBox[{"a32", " ", "u2"}], "+", 
     RowBox[{"a33", " ", "u3"}]}]}], "\[IndentingNewLine]", 
   "}"}]}]], "InputOnly",
 CellChangeTimes->{{3.3982922753194*^9, 3.3982922793594*^9}},
 CellLabel->
  "In[1024]:=",ExpressionUUID->"ef272fce-5cae-4549-ae40-88c69fe400aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.3982916547644*^9, 3.3982916712804003`*^9}},
 CellLabel->
  "In[1025]:=",ExpressionUUID->"223d05d4-91e8-4f12-81f9-1276744bf5f5"],

Cell[BoxData[
 RowBox[{"VectorPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f1", "[", 
    RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"u1", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"u2", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"u3", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Axes", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<u1\>\"", ",", "\"\<u2\>\"", ",", "\"\<u3\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982922928444*^9, 3.3982923222024*^9}, {
  3.4637650183042526`*^9, 3.463765022444798*^9}},
 CellTags->"S5.43.1",
 CellLabel->
  "In[1026]:=",ExpressionUUID->"bb5547bc-da4c-4ee4-9a02-6cd29830105d"],

Cell["\<\
Observe that the solutions to this ODE will always be stable. Also observe \
that the solutions orbit the equilibrium point.

To better visualize the stability of the above problem, re-plot the vector \
field with a highly restricted range for the component u3.\
\>", "Text",
 CellChangeTimes->{
  3.3982909028634*^9, {3.748780017168295*^9, 
   3.7487800796795454`*^9}},ExpressionUUID->"52a875e8-5d7a-4167-b16c-\
732a2a845e8d"],

Cell[BoxData[
 RowBox[{"VectorPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f1", "[", 
    RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"u1", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
