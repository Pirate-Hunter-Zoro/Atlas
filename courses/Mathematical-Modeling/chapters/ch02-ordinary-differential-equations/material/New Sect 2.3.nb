   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<u1\>\"", ",", "\"\<u2\>\"", ",", "\"\<u3\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3982904207024*^9, {3.3982917560624*^9, 3.3982918027274*^9}, {
   3.3982918973274*^9, 3.3982919316874*^9}, 3.3982921833904*^9, {
   3.463764913431266*^9, 3.4637649514930353`*^9}},
 CellTags->"S5.43.1",
 CellLabel->
  "In[993]:=",ExpressionUUID->"3118115c-1207-48dc-b4cb-8abc7dbea2ce"],

Cell[TextData[{
 "Observe that the solutions to this ODE will always be ",
 StyleBox["unstable",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "."
}], "Text",
 CellChangeTimes->{
  3.3982908802594*^9},ExpressionUUID->"cbe9a424-94ad-4ff3-807a-fadf35f0b5d9"]
}, Closed]],

Cell[CellGroupData[{

Cell["Three Negative Real Exponents", "Subsubsection",ExpressionUUID->"66da2a7f-6dff-41ce-bb80-5ae4233ffcc0"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}]], "InputOnly",
 CellLabel->
  "In[994]:=",ExpressionUUID->"784e9956-4d55-4e24-bd6b-8a26631e77ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a11", "=", 
   RowBox[{"-", "3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a12", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a13", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a21", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a22", "=", 
   RowBox[{"-", "4"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a23", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a31", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a32", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a33", "=", 
   RowBox[{"-", "5"}]}], ";"}]}], "InputOnly",
 CellLabel->
  "In[995]:=",ExpressionUUID->"2caaf411-9901-4d72-b0ae-fda0d2281b6d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", " ", "=", " ", 
    RowBox[{"(", GridBox[{
       {"a11", "a12", "a13"},
       {"a21", "a22", "a23"},
       {"a31", "a32", "a33"}
      }], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"A", " ", "//", " ", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.7487797616157417`*^9, 3.748779762973878*^9}},
 CellLabel->
  "In[1004]:=",ExpressionUUID->"4274b8ef-396e-40a4-a31a-389ab6368bd8"],

Cell["Determine the corresponding eigenvalues for this matrix:", "Text",ExpressionUUID->"e8e005f1-4257-41c7-8ff0-f072dc2ebf29"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Det", "[", "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"A", "  ", "-", "  ", 
    RowBox[{"\[Lambda]", " ", "*", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "  ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982920475854*^9, 3.3982920528264*^9}},
 CellLabel->
  "In[1006]:=",ExpressionUUID->"f4701738-d25a-410b-96dc-d76257c3b289"],

Cell[BoxData[
 RowBox[{"Solve", "[", "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "60"}], "-", 
     RowBox[{"47", " ", "\[Lambda]"}], "-", 
     RowBox[{"12", " ", 
      SuperscriptBox["\[Lambda]", "2"]}], "-", 
     SuperscriptBox["\[Lambda]", "3"]}], " ", "==", "  ", "0"}], ",", "  ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[Lambda]"}], "  ", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982920587564*^9, 3.3982920746834*^9}},
 CellLabel->
  "In[1007]:=",ExpressionUUID->"05e842ae-41c2-4109-b988-cc56a43e986d"],

Cell["Therefore, the eigenvalues are both real and negative.", "Text",
 CellChangeTimes->{
  3.3982908880044003`*^9},ExpressionUUID->"4c8123c1-8dc1-4ea5-b4e1-\
b10e8965c3e4"],

Cell["\<\
Observe that the three solutions correspond to real values of \[Lambda] which \
are negative.  Look at the corresponding vector field.\
\>", "Text",
 CellChangeTimes->{
  3.3982908891074*^9},ExpressionUUID->"7c07d02b-a9f3-4fcf-8088-5f4a767d3f50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"u1_", ",", "u2_", ",", "u3_"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"{", "\[IndentingNewLine]", 
