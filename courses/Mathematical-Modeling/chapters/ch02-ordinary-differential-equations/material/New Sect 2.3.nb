Notebook[{

Cell[CellGroupData[{
Cell[" Section 2.3", "Title",ExpressionUUID->"72781343-43a9-47df-8be2-87c89205a483"],

Cell[TextData[StyleBox["  What is the Behavior of an ODE System?\n  Three ODE \
Equations",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"4eecef5c-d496-4d20-a5fd-\
b32c39281374"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellChangeTimes->{3.3982903794024*^9, 3.3982905148854*^9},
 CellLabel->
  "In[959]:=",ExpressionUUID->"f96fea9a-2553-496d-9575-d479675c2424"],

Cell[CellGroupData[{

Cell[" Introduction", "Section",ExpressionUUID->"772367fa-4285-425f-b963-85adf097db7f"],

Cell[TextData[{
 "In order to illustrate stability, consider the simple case of 3 first-order \
constant coefficient homogeneous differential equations.  Also, assume that \
the ODE system is independent of time (i.e. autonomous).  Therefore, this ODE \
system can be expressed as:\n\n\t\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"u1", "'"}], "[", "t", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"a11", "*", 
       RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
      RowBox[{"a12", "*", 
       RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
      RowBox[{"a13", "*", 
       RowBox[{"u3", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"u2", "'"}], "[", "t", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"a21", "*", 
       RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
      RowBox[{"a22", "*", 
       RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
      RowBox[{"a23", "*", 
       RowBox[{"u3", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"u3", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"a31", "*", 
      RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
     RowBox[{"a32", "*", 
      RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
     RowBox[{"a33", "*", 
      RowBox[{"u3", "[", "t", "]"}]}]}]}], TraditionalForm]}],ExpressionUUID->
  "3b117edb-1c20-46ce-9143-937b93950ab7"],
 "\n\nThe general form as a matrix equation is:\n \n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"U", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{"A", "*", 
     RowBox[{"U", "[", "t", "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "c68cf4db-b125-404a-98c8-fc7a19677546"],
 "\n \nwhere:\n  \n\t\t  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "[", "t", "]"}], "="}], TraditionalForm]],ExpressionUUID->
  "1bff5413-aedd-41bd-bb67-f6f4902491d5"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {GridBox[{
         {
          RowBox[{"u1", "[", "t", "]"}]},
         {
          RowBox[{"u2", "[", "t", "]"}]}
        }]},
      {
       RowBox[{"u3", "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "e95e2a0f-3a8c-4594-8019-43d22b0c3dce"],
 "\n  \n\t\t  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " ", "="}], TraditionalForm]],ExpressionUUID->
  "91b7bb0c-4860-4ae3-bf89-0997ead7d84a"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"a11", "a12", "a13"},
      {"a21", "a22", "a23"},
      {"a21", "a32", "a33"}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "1d203aea-9d86-4eab-a7aa-ee335cdcd32f"],
 "\n  \nThe behavior of the solutions to the ODE will depend in this specific \
case upon the matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "d4e14ae1-9ab0-48bc-b1f9-2054a1803835"],
 ". "
}], "Text",
 CellChangeTimes->{{3.3982905218124*^9, 3.3982905919594*^9}, {
   3.3982906676054*^9, 3.3982907135604*^9}, {3.3982909906834*^9, 
   3.3982909940954*^9}, {3.3982911594314003`*^9, 3.3982911625573997`*^9}, 
   3.3982913652544003`*^9},ExpressionUUID->"72c0376f-df3e-4355-aeea-\
89005a8b7303"],

Cell[CellGroupData[{

Cell[" Exact Solution", "Subsubsection",ExpressionUUID->"22d0097e-21fa-40cc-80c2-1d29ca438aa0"],

Cell["\<\
The exact solution to this purely symbolic problem would be extremely \
complicated (see the previous section for 2 dependent variables).  Therefore, \
no symbolic solution will be attempted here. 
\
\>", "Text",
 CellChangeTimes->{
  3.3982907178094*^9},ExpressionUUID->"fe233c92-882d-4d7f-829d-c7354328ff59"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" Equilibrium Point", "Section",ExpressionUUID->"48af51da-ab78-4b5a-9836-05ebf2b01403"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}]], "InputOnly",
 CellLabel->
  "In[960]:=",ExpressionUUID->"e3ad6e63-d274-44e0-b2c9-883e4f18cedb"],

Cell[TextData[{
 "The equilibrium point corresponds to a case where there is no dynamic \
motion (i.e. each of the derivatives in the ODE system is 0).\nIt is possible \
to solve for the equilibrium point by defining a function which corresponds \
to the right hand side of the two ordinary differential equations:\n \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"u1", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"a11", "*", 
        RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a12", "*", 
        RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a13", "*", 
        RowBox[{"u3", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]", "\n", 
     "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"u2", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"a21", "*", 
        RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a22", "*", 
        RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a23", "*", 
        RowBox[{"u3", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]", "\n", 
     "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"u3", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"a31", "*", 
        RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a32", "*", 
        RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a33", "*", 
        RowBox[{"u3", "[", "t", "]"}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"ddab9784-aab6-4718-ad9d-e26568f3dd22"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.3982908280744*^9, 3.3982908290514*^9}, {
   3.3982909663084*^9, 3.3982909794774*^9}, 
   3.3982910122014*^9},ExpressionUUID->"a127021b-56de-4e38-aaa7-1e62085dfa2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"u1_", ",", "u2_", ",", "u3_"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a11", " ", "u1"}], "+", 
     RowBox[{"a12", " ", "u2"}], "+", 
     RowBox[{"a13", " ", "u3"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a21", " ", "u1"}], "+", 
     RowBox[{"a22", " ", "u2"}], "+", 
     RowBox[{"a23", " ", "u3"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a31", " ", "u1"}], "+", 
     RowBox[{"a32", " ", "u2"}], "+", 
     RowBox[{"a33", " ", "u3"}]}]}], "\[IndentingNewLine]", 
   "}"}]}]], "InputOnly",
 CellChangeTimes->{{3.3982910180544*^9, 3.3982910218194*^9}},
 CellLabel->
  "In[961]:=",ExpressionUUID->"1413ab98-1ee1-48a1-b6c3-0227f37ada6b"],

Cell["\<\
The equilibrium point corresponds to zero values for the derivatives in the \
left-hand side.
Find the rest points for this equation:\
\>", "Text",
 CellChangeTimes->{{3.3982908230224*^9, 
  3.3982908237944*^9}},ExpressionUUID->"531cc589-a502-4895-8629-7599b60ecb6e"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0"}], "}"}], "==", 
    RowBox[{"f1", "[", 
     RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2", ",", "u3"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982907300824003`*^9, 3.3982907302514*^9}, {
  3.3982910309524*^9, 3.3982910389104*^9}},
 CellLabel->
  "In[962]:=",ExpressionUUID->"18349e07-4af4-4b21-af7f-3d0b80228c19"],

Cell[TextData[{
 "As expected, the solution of a homogeneous linear equation would be the \
origin (as long as the matrix is non-singular).  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "*", 
     RowBox[{"U", "[", "t", "]"}]}], " ", "="}], TraditionalForm]],
  ExpressionUUID->"489f18a6-11fa-43a8-92b7-0268f9dfdd91"],
 " ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    RowBox[{"0", "  "}], "\[Rule]"], TraditionalForm]],ExpressionUUID->
  "3e978c85-0052-43d9-bba5-df42bbda8f3d"],
 "  \[DoubleLongRightArrow]   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "[", "t", "]"}], " ", "="}], TraditionalForm]],
  ExpressionUUID->"07c310e0-7d10-4cbf-8121-9726abefd40c"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "3e62056f-1808-4e5e-835b-c1580d6ce7c8"],
 "* ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["0", "\[Rule]"], TraditionalForm]],ExpressionUUID->
  "80a185e2-eb55-4ce0-b4ac-efc5d74d535b"],
 " = ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["0", "\[Rule]"], TraditionalForm]],ExpressionUUID->
  "c3ecec69-7984-4ff6-9280-74a24eb3f212"]
}], "Text",
 CellChangeTimes->{
  3.3982908210254*^9, {3.3982911161064*^9, 
   3.3982911368784*^9}},ExpressionUUID->"df5c667a-63f4-4e88-8061-\
5da3f0316b7f"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Use Linear Algebra to Find the Solution", "Section",ExpressionUUID->"9cd4c20a-2136-4d23-b3d1-3e785b9f1d2a"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
  "A", ",", "U", ",", "u1", ",", "u2", ",", "c1", ",", "c2", ",", "\[Lambda]",
    ",", "a11", ",", "a12", ",", "a13", ",", "a21", ",", "a22", ",", "a23", 
   ",", "a31", ",", "a32", ",", "a33"}], "]"}]], "InputOnly",
 CellLabel->
  "In[963]:=",ExpressionUUID->"e6299e65-1b1d-4a21-b456-8d23c6fe9d29"],

Cell[TextData[{
 "It is also possible to use linear algebra to find the above solution \
directly.  The idea is essentially the same as was presented above.  \nFirst, \
write the system of linear equations:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"u1", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"a11", "*", 
        RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a12", "*", 
        RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a13", "*", 
        RowBox[{"u3", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]", "\n", 
     "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"u2", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"a21", "*", 
        RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a22", "*", 
        RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a23", "*", 
        RowBox[{"u3", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]", "\n", 
     "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"u3", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"a31", "*", 
        RowBox[{"u1", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a32", "*", 
        RowBox[{"u2", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{"a33", "*", 
        RowBox[{"u3", "[", "t", "]"}]}]}]}], "\n"}]}], TraditionalForm]],
  ExpressionUUID->"652c2f42-d8c9-4962-875d-07a64d4b7286"],
 "\nThe general form as a matrix equation is:\n \n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"U", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{"A", "*", 
     RowBox[{"U", "[", "t", "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "6f169201-b236-4877-9146-bb86e2ff748a"],
 "\n \nwhere:  \n\t\t  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "[", "t", "]"}], "="}], TraditionalForm]],ExpressionUUID->
  "0a22eb17-2550-4ded-8cd4-75a666353469"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {GridBox[{
         {
          RowBox[{"u1", "[", "t", "]"}]},
         {
          RowBox[{"u2", "[", "t", "]"}]}
        }]},
      {
       RowBox[{"u3", "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "b7efdc8e-83b8-45cc-af86-24c42d33c42b"],
 "\n  \n\t\t  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " ", "="}], TraditionalForm]],ExpressionUUID->
  "5c6b5718-cfb9-4b6f-875a-93f04f71b8de"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"a11", "a12", "a13"},
      {"a21", "a22", "a23"},
      {"a21", "a32", "a33"}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "4a678852-ad15-4bf4-af00-642fd41c32fb"]
}], "Text",
 CellChangeTimes->{{3.3982908122223997`*^9, 3.3982908172804003`*^9}, {
  3.3982910505544*^9, 3.3982910916214*^9}, {3.3982911759624*^9, 
  3.3982911815404*^9}},ExpressionUUID->"b7732b55-02b4-4613-b838-8bce1705c2a9"],

Cell[BoxData[
 RowBox[{"A", " ", "=", " ", 
  RowBox[{"(", GridBox[{
     {"a11", "a12", "a13"},
     {"a21", "a22", "a23"},
     {"a31", "a32", "a33"}
    }], ")"}]}]], "InputOnly",
 CellChangeTimes->{3.7487795967352557`*^9},
 CellLabel->
  "In[964]:=",ExpressionUUID->"59c841c6-7054-4723-9ce0-7d54f9019c99"],

Cell[TextData[{
 "The usual procedure is to search for solutions of the type:   ",
 Cell[BoxData[
  SuperscriptBox["E", 
   RowBox[{"\[Lambda]", "*", "t"}]]],
  FontWeight->"Bold",ExpressionUUID->"9f0aa4f7-78cd-4884-ad76-1bca3c84d967"],
 "\nSpecifically,\n\t\t",
 Cell[BoxData[{
  StyleBox[
   RowBox[{
    RowBox[{"u1", "[", "t", "]"}], "=", 
    RowBox[{"c1", "*", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Lambda]", "*", "t"}]]}]}],
   FontWeight->"Bold"], "\n", 
  StyleBox[
   RowBox[{
    RowBox[{"u2", "[", "t", "]"}], "=", 
    RowBox[{"c2", "*", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Lambda]", "*", "t"}]]}]}],
   FontWeight->"Bold"], "\n", 
  StyleBox[
   RowBox[{
    RowBox[{"u3", "[", "t", "]"}], "=", 
    RowBox[{"c3", "*", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Lambda]", "*", "t"}]]}]}],
   FontWeight->"Bold"]}],ExpressionUUID->
  "0da2873e-78f6-44c6-b274-578586240a4f"]
}], "Text",
 CellChangeTimes->{
  3.3982911843354*^9},ExpressionUUID->"76220959-0097-47aa-9fe7-f6e200247f80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"u1", "[", "t_", "]"}], ":=", 
  RowBox[{"c1", "*", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Lambda]", "*", "t"}]]}]}], "\n", 
 RowBox[{
  RowBox[{"u2", "[", "t_", "]"}], ":=", 
  RowBox[{"c2", "*", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Lambda]", "*", "t"}]]}]}], "\n", 
 RowBox[{
  RowBox[{"u3", "[", "t_", "]"}], ":=", 
  RowBox[{"c3", "*", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Lambda]", "*", "t"}]]}]}]}], "InputOnly",
 CellLabel->
  "In[965]:=",ExpressionUUID->"545ba7b0-e9b9-45b1-b704-01faa0e70f6a"],

Cell[TextData[{
 "Therefore:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "[", "t", "]"}], " ", "="}], TraditionalForm]],
  ExpressionUUID->"a2a9ac4c-720b-4cba-b732-ccb071f4744d"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {GridBox[{
         {
          RowBox[{"u1", "[", "t", "]"}]},
         {
          RowBox[{"u2", "[", "t", "]"}]}
        }]},
      {
       RowBox[{"u3", "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "746ab8a8-c7eb-45be-8f83-5377cf94a6d4"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {GridBox[{
         {
          RowBox[{"c1", "*", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[Lambda]", "*", "t"}]]}]},
         {
          RowBox[{"c2", "*", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[Lambda]", "*", "t"}]]}]}
        }]},
      {
       RowBox[{"c3", "*", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[Lambda]", "*", "t"}]]}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "9dd21dfd-90c5-415d-9fac-d1b162a81ec3"],
 " \n\t  "
}], "Text",
 CellChangeTimes->{{3.3982912037194*^9, 
  3.3982912108914003`*^9}},ExpressionUUID->"115ace32-4bbe-40ac-8685-\
8bf83b753303"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"U", "[", "t_", "]"}], "=", "  ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"u1", "[", "t", "]"}]},
      {
       RowBox[{"u2", "[", "t", "]"}]},
      {
       RowBox[{"u3", "[", "t", "]"}]}
     }], ")"}]}], "   "}]], "Input",
 CellLabel->
  "In[968]:=",ExpressionUUID->"7cd1aaa7-e50b-4559-9362-d211d007f589"],

Cell[TextData[{
 "The general form as a matrix equation is:\n \n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"U", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{"A", "*", 
     RowBox[{"U", "[", "t", "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "065ab780-8d25-4e18-add8-829b3632ea36"],
 "\n\t \nOr:\n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"A", "*", 
      RowBox[{"U", "[", "t", "]"}]}], "  ", "-", "  ", 
     RowBox[{
      RowBox[{"U", "'"}], "[", "t", "]"}]}], "  ", "=", "  "}], 
   TraditionalForm]],ExpressionUUID->"5b3c14f7-770e-460d-8bd1-75b3f3b0a2da"],
 Cell[BoxData[
  RowBox[{"(", GridBox[{
     {GridBox[{
        {"0"},
        {"0"}
       }]},
     {"0"}
    }], ")"}]],
  FontWeight->"Bold",ExpressionUUID->"db39d22f-91ff-4bf1-af00-d9af1c158305"],
 "\n\t \nTherefore, display the left-hand side of the above matrix equation:"
}], "Text",
 CellChangeTimes->{
  3.3982908057084*^9, {3.3982912152664003`*^9, 
   3.3982912376264*^9}},ExpressionUUID->"0dcece86-2f5f-4420-8c9d-\
c5073c9a24c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"A", ".", 
    RowBox[{"U", "[", "t", "]"}]}], "  ", "-", "  ", 
   RowBox[{
    RowBox[{"U", "'"}], "[", "t", "]"}]}], "   ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->
  "In[969]:=",ExpressionUUID->"a1237926-745c-4a61-808a-72bb2be2641f"],

Cell["\<\
In order to simplify the calculation of the coefficient matrix for our ODE \
system, construct the following function which takes both a list of equations \
and a list of coefficients and extracts the coefficient matrix:\
\>", "Text",ExpressionUUID->"ee98dde6-b19f-455a-8c1d-d1f9967bba70"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coefMatrix", "[", 
   RowBox[{"equations_", ",", "coefficients_"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Outer", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Coefficient", ",", "\[IndentingNewLine]", 
    RowBox[{"Flatten", "[", "equations", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Flatten", "[", "coefficients", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellLabel->
  "In[970]:=",ExpressionUUID->"edc4c6d0-fb14-40f4-b661-5979167c66b3"],

Cell["\<\
Determine the coefficient matrix for our specific ODE system in terms of the \
solution vector:\
\>", "Text",
 CellChangeTimes->{
  3.3982907985783997`*^9},ExpressionUUID->"dc42d8ca-1b89-481e-b7bd-\
3d14c38f2abd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coefMatrix", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"A", ".", 
      RowBox[{"U", "[", "t", "]"}]}], "  ", "-", "  ", 
     RowBox[{
      RowBox[{"U", "'"}], "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"U", "[", "t", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "   ", "//", " ", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.3982914561844*^9, 3.3982914674124002`*^9}},
 CellLabel->
  "In[971]:=",ExpressionUUID->"0ff56f20-635b-4747-be7f-eb2f2edce393"],

Cell[TextData[{
 "It is clear that the above coefficient matrix can be expressed in terms of \
both \"A\" and the \"IdentityMatrix\" as:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "  ", "-", "  ", 
    RowBox[{"\[Lambda]", " ", "I"}]}], TraditionalForm]],ExpressionUUID->
  "46a4fe30-0d0d-4635-8306-411e522278ea"],
 " :"
}], "Text",
 CellChangeTimes->{3.3982907967914*^9, 
  3.3982914819274*^9},ExpressionUUID->"3fd7279d-d2b5-4095-bbb4-1ebbbe5679fd"],

Cell[BoxData[
 RowBox[{"A", "    ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->
  "In[972]:=",ExpressionUUID->"5b77d931-e2b1-4b87-9f42-36f393519f9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IdentityMatrix", "[", "3", "]"}], "   ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->
  "In[973]:=",ExpressionUUID->"ef6f2168-829f-4e5e-ad1c-3a28499b22f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "  ", "-", "  ", 
   RowBox[{"\[Lambda]", " ", "*", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->
  "In[974]:=",ExpressionUUID->"c0096a20-5f16-426c-ab90-f32f1c7fa300"],

Cell[TextData[{
 "Recall that the equation we are dealing with is:\n\n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"A", "*", 
      RowBox[{"U", "[", "t", "]"}]}], "  ", "-", "  ", 
     RowBox[{
      RowBox[{"U", "'"}], "[", "t", "]"}]}], "  ", "=", " "}], 
   TraditionalForm]],ExpressionUUID->"e807afdc-1307-4dbb-979d-cbef01b0f178"],
 Cell[BoxData[
  RowBox[{"(", GridBox[{
     {"0"},
     {"0"},
     {"0"}
    }], ")"}]],
  FontWeight->"Bold",ExpressionUUID->"5bc1c7a6-39f4-400d-861f-9672c20b9736"],
 "\nOr:\n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", "  ", "-", "  ", 
       RowBox[{"\[Lambda]", " ", "I"}]}], " ", ")"}], 
     RowBox[{"U", "[", "t", "]"}]}], " ", "=", " "}], TraditionalForm]],
  ExpressionUUID->"2dcca10a-d645-40ec-bba7-a8075ac6fd3d"],
 Cell[BoxData[
  RowBox[{"(", GridBox[{
     {"0"},
     {"0"},
     {"0"}
    }], ")"}]],
  FontWeight->"Bold",ExpressionUUID->"62131caf-9b27-4c3c-b3db-e9461e3b02c9"],
 " \nTo have non-trivial solutions, then the coefficient matrix must be \
non-singular:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "[", " ", 
     RowBox[{"A", "  ", "-", "  ", 
      RowBox[{"\[Lambda]", " ", "I"}]}], " ", "]"}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"06421f04-a568-4d16-b562-b335d89676a8"],
 "\n\t\nTherefore, the solutions \"\[Lambda]\" that we are looking for \
correspond to the case where:"
}], "Text",
 CellChangeTimes->{{3.3982907791043997`*^9, 3.3982907902774*^9}, {
  3.3982912554904003`*^9, 3.3982912639444*^9}, {3.3982913160544*^9, 
  3.3982913326714*^9}},ExpressionUUID->"721d611c-20bc-4e09-81c6-01b5857990b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Det", "[", 
   RowBox[{"A", "  ", "-", "  ", 
    RowBox[{"\[Lambda]", " ", "*", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}], "==", 
  "0"}]], "Input",
 CellLabel->
  "In[975]:=",ExpressionUUID->"dffce91e-94ea-4deb-98e1-d33473f9f720"],

Cell["Solve for the corresponding values of \"\[Lambda]\":", "Text",
 CellChangeTimes->{
  3.3982907745944*^9},ExpressionUUID->"0f6659bc-0ec6-4ad4-b9fb-0aff86d53210"],

Cell[BoxData[
 RowBox[{"Solve", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Det", "[", 
     RowBox[{"A", "  ", "-", "  ", 
      RowBox[{"\[Lambda]", " ", "*", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}], "==", "0"}], 
   "  ", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "\[Lambda]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982915160874*^9, 3.3982915228154*^9}},
 CellLabel->
  "In[976]:=",ExpressionUUID->"178183dd-40c8-477b-a6fb-70b5d053d7ea"],

Cell["\<\
The above symbolic solution is quite complicated and cannot be simplified \
very much.  Therefore, an analysis that will indicate the behavior of the \
system will require some specific numeric examples.\
\>", "Text",
 CellChangeTimes->{
  3.3982907710864*^9},ExpressionUUID->"3b7731e1-816e-48b3-8951-a7ccfda751ee"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Analysis of the Symbolic Solution", "Section",ExpressionUUID->"1c4e15e1-ae6e-4b23-b1b2-f43556278dca"],

Cell[TextData[{
 "It appears that an analysis can be made by using the procedure developed in \
the previous section.  There are now three eigenvalues.  Either all \
eigenvalues are real or there is one real root and two complex conjugate \
eigenvalues.\nConsider just a ",
 StyleBox["few",
  FontVariations->{"Underline"->True}],
 " of the possible cases: "
}], "Text",
 CellChangeTimes->{
  3.3982908678504*^9},ExpressionUUID->"d71c8719-1cf1-4cc8-8f6e-a4028f9779a2"],

Cell[CellGroupData[{

Cell["Three Positive Real Exponents", "Subsubsection",ExpressionUUID->"33ffc7b6-598f-4aa8-9404-97c6453959c0"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}]], "InputOnly",
 CellLabel->
  "In[977]:=",ExpressionUUID->"c4ed95db-7f9a-468c-baaa-cc6e09537e3f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a11", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a12", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a13", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a21", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a22", "=", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a23", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a31", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a32", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a33", "=", "1"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[978]:=",ExpressionUUID->"ddbac791-a388-4884-b349-922d297d148a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", " ", "=", " ", 
    RowBox[{"(", GridBox[{
       {"a11", "a12", "a13"},
       {"a21", "a22", "a23"},
       {"a31", "a32", "a33"}
      }], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"A", " ", "//", " ", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.74877971559114*^9, 3.748779717332314*^9}},
 CellLabel->
  "In[987]:=",ExpressionUUID->"f0b5bc46-1473-413f-98b1-e482da8fcd57"],

Cell["Determine the corresponding eigenvalues for this matrix:", "Text",ExpressionUUID->"2e9ffb3b-9e2a-48a9-befc-ac67204b26fa"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Det", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"A", "  ", "-", "  ", 
    RowBox[{"\[Lambda]", " ", "*", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "  ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982915997714*^9, 3.3982916037223997`*^9}},
 CellLabel->
  "In[989]:=",ExpressionUUID->"5d645d67-97a3-4d2d-aed0-f5fcd4dbe44d"],

Cell[BoxData[
 RowBox[{"Solve", "[", "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"12", "-", 
     RowBox[{"19", " ", "\[Lambda]"}], "+", 
     RowBox[{"8", " ", 
      SuperscriptBox["\[Lambda]", "2"]}], "-", 
     SuperscriptBox["\[Lambda]", "3"]}], "  ", "==", "  ", "0"}], ",", "  ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[Lambda]"}], "  ", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982916094174*^9, 3.3982916193134003`*^9}},
 CellLabel->
  "In[990]:=",ExpressionUUID->"00be917a-5c48-4049-a175-56dcc4c7b27b"],

Cell["Therefore, the eigenvalues are both real and positive.", "Text",
 CellChangeTimes->{
  3.3982908739463997`*^9},ExpressionUUID->"802adb84-a135-44a8-bbe7-\
4c51419d46b1"],

Cell["\<\
Observe that the three solutions correspond to real values of \[Lambda] which \
are positive.  Look at the corresponding vector field.\
\>", "Text",
 CellChangeTimes->{
  3.3982908749653997`*^9},ExpressionUUID->"b17c34e7-54c2-4fb4-82a7-\
f0be5fd9b377"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"u1_", ",", "u2_", ",", "u3_"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a11", " ", "u1"}], "+", 
     RowBox[{"a12", " ", "u2"}], "+", 
     RowBox[{"a13", " ", "u3"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a21", " ", "u1"}], "+", 
     RowBox[{"a22", " ", "u2"}], "+", 
     RowBox[{"a23", " ", "u3"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a31", " ", "u1"}], "+", 
     RowBox[{"a32", " ", "u2"}], "+", 
     RowBox[{"a33", " ", "u3"}]}]}], "\[IndentingNewLine]", 
   "}"}]}]], "InputOnly",
 CellChangeTimes->{{3.3982916348184*^9, 3.3982916384314003`*^9}},
 CellLabel->
  "In[991]:=",ExpressionUUID->"59812da2-76d1-4d6c-9372-32334b93a9a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.3982916547644*^9, 3.3982916712804003`*^9}},
 CellLabel->
  "In[992]:=",ExpressionUUID->"beaa0b63-de65-418b-8181-16b0ec3fff58"],

Cell[BoxData[
 RowBox[{"VectorPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f1", "[", 
    RowBox[{"u1", ",", "u2", ",", "u3"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
