Notebook[{

Cell[CellGroupData[{
Cell["Exercises 2.4 ", "Title",ExpressionUUID->"e1bc9dd3-8197-4336-bd97-bb057028e3cd"],

Cell[CellGroupData[{

Cell["2.4.3 pg 26 (with modifications)", "Section",ExpressionUUID->"0481a84a-c06f-48e2-bf8b-029554579245"],

Cell[TextData[{
 "Part 1:  Using the \"DSolve\" command, find the symbolic replacement rule \
solution to:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"u1", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"u1", "[", "t", "]"}]}], " ", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"u2", "'"}], "[", "t", "]"}], " ", "=", "            ", 
      RowBox[{
       RowBox[{"u2", "[", "t", "]"}], "  ", "-", "   ", 
       RowBox[{"u3", "[", "t", "]"}]}]}], "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"u3", "'"}], "[", "t", "]"}], " ", "=", "            ", 
      RowBox[{
       RowBox[{"u2", "[", "t", "]"}], "  ", "+", "  ", 
       RowBox[{"u3", "[", "t", "]"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c5ba5fca-6b55-4831-a164-8731dfc1b6dc"],
 "\n\t\nWith initial conditions:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{"u1", "[", "0", "]"}], " ", "=", " ", "\[Alpha]1"}], ",", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"u2", "[", "0", "]"}], " ", "=", " ", "\[Alpha]2"}], ",", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"u3", "[", "0", "]"}], " ", "=", " ", "\[Alpha]3"}]}]}], 
   TraditionalForm]],ExpressionUUID->"f397922b-f4d8-4a46-8435-0b15c1d7fdc3"]
}], "Text",
 CellChangeTimes->{{3.3983300691540003`*^9, 
  3.398330087083*^9}},ExpressionUUID->"8902338b-0891-4d5f-bac1-64ee25ca5a3f"],

Cell[TextData[{
 "Part 2:   Assign the initial conditions to:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"\[Alpha]1", " ", "=", " ", "1"}], "\n", "\t", 
     RowBox[{"\[Alpha]2", " ", "=", " ", "2"}], "\n", "\t", 
     RowBox[{"\[Alpha]3", " ", "=", " ", "3"}]}]}], TraditionalForm]],
  ExpressionUUID->"2575868f-10d8-421c-803c-4dd3f1b46993"],
 "\n and determine the symbolic replacement rule solution."
}], "Text",
 CellChangeTimes->{{3.398330099777*^9, 
  3.3983301048900003`*^9}},ExpressionUUID->"d96d72c6-346f-4ece-ba88-\
b3a53279633e"],

Cell[TextData[{
 "Part 3:     Extract the three solutions from the replacement rule and plot \
a 2-Dimensional graph containing all three solutions for:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "7"}], 
   TraditionalForm]],ExpressionUUID->"5dd001cb-0cbc-4cc6-9a5c-24d456afe3f5"],
 "."
}], "Text",
 CellChangeTimes->{
  3.3983301212019997`*^9},ExpressionUUID->"8c3aa037-d839-49a6-8b04-\
15bdb7de7b69"],

Cell[TextData[{
 "Part 4:\tGenerate a 3-Dimensional ",
 StyleBox["parametric",
  FontVariations->{"Underline"->True}],
 " plot of the above solution for:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "2"}], 
   TraditionalForm]],ExpressionUUID->"993504eb-301c-4060-ba60-1909db0bc034"],
 " \n\t(Remember: set the PlotRange to All, also Thickness[.007] and color \
Blue)\n\tGenerate a 3-Dimensional vector field plot for the right hand side \
of the ODE system.\n\t(Carefully read the range for u1, u2 and u3 from the \
parametric plot)\n\t(Remember: set the ",
 "VectorScale \[Rule] .03, or what looks good",
 ")\n\tShow both of the above plots together."
}], "Text",
 CellChangeTimes->{
  3.3983301484040003`*^9, {3.398332695097*^9, 3.3983327246140003`*^9}, 
   3.4637657957893243`*^9, {3.4637658918499804`*^9, 
   3.463765906115331*^9}},ExpressionUUID->"0d7cc719-d30b-41dc-b90a-\
88cfb548fd7e"],

Cell[TextData[{
 "Part 5:\tGenerate a 3-Dimensional parametric plot of the above solution \
for:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "3", " "}], 
   TraditionalForm]],ExpressionUUID->"8546ebd6-0901-4f2c-abfa-2b3ee3ea649b"],
 "\n\t(Remember: set the PlotRange to All, also Thickness[.007] and color \
Red)\n\tGenerate a 3-Dimensional vector field plot for the right hand side of \
the ODE system.\n\tShow both of the above plots together."
}], "Text",
 CellChangeTimes->{
  3.3983301789309998`*^9, {3.398332872131*^9, 
   3.398332876967*^9}},ExpressionUUID->"e4fc9eb1-9978-4852-9a86-c7ddb030ebca"],

Cell[TextData[{
 "Part 6:\tGenerate a 3-Dimensional parametric plot of the above solution \
for:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "6"}], 
   TraditionalForm]],ExpressionUUID->"c5b7ce31-a595-4b9d-8953-9100be1815ea"],
 " \n\t(Remember: set the PlotRange to All, also Thickness[.007] and color \
Green)\n\tGenerate a 3-Dimensional vector field plot for the right hand side \
of the ODE system.\n\tShow both of the above plots together."
}], "Text",
 CellChangeTimes->{
  3.3983301939049997`*^9, {3.398332884105*^9, 
   3.398332888807*^9}},ExpressionUUID->"c0f70324-a46c-4b45-9a11-1759177c6fca"],

Cell["\<\
Part 7:\tWhat are the coordinates of the equilibrium point?
\tIs the solution stable or unstable?
\tDescribe the behavior of the solution as time increases using the above \
plots.\
\>", "Text",ExpressionUUID->"d3e55e1b-e9ae-4f8e-a79a-ff2c0bea5135"]
}, Closed]],

Cell[CellGroupData[{

Cell["2.4.4 pg 26 (with modifications)", "Section",ExpressionUUID->"3dc8f407-774e-4f2f-a3ce-ed8410d30132"],

Cell[TextData[{
 "Part 1:\tSolve for the equilibrium point for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "63a74d5b-315b-40fd-9903-1a41bbbb825b"],
 ".\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"n", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"r", " ", 
      RowBox[{"n", "[", "t", "]"}], " ", 
      RowBox[{"(", " ", 
       RowBox[{"1", "  ", "-", "  ", 
        RowBox[{
         RowBox[{"n", "[", "t", "]"}], "/", "k"}]}], ")"}]}], "  ", "-", "  ", 
     RowBox[{"b", " ", 
      RowBox[{"n", "[", "t", "]"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "79e56648-e675-4f9c-be1c-9440aec54842"],
 " \n\t\nWith initial condition:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "[", "0", "]"}], " ", "=", " ", "\[Alpha]1"}], 
   TraditionalForm]],ExpressionUUID->"dbd41380-7965-4bea-a66f-7b05b579cb71"],
 "\n\t"
}], "Text",
 CellChangeTimes->{{3.398330203668*^9, 
  3.3983302302060003`*^9}},ExpressionUUID->"67b37a48-19f9-4df4-b3d7-\
5ae955035a94"],

Cell[TextData[{
 "Part 2:   Assign the initial condition and model parameters to:   \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"\[Alpha]1", " ", "=", " ", "100"}], "\n", "\t", 
     RowBox[{"r", " ", "=", " ", ".05"}], "\n", "\t", 
     RowBox[{"k", " ", "=", " ", "300"}], "\n", "\t", 
     RowBox[{"b", " ", "=", " ", ".02"}]}]}], TraditionalForm]],
  ExpressionUUID->"c6310bf2-f8bb-4573-8efd-0665681f2e06"],
 "\n Using the \"NDSolve\" command, find the symbolic replacement rule \
solution to the above problem."
}], "Text",
 CellChangeTimes->{{3.398330239528*^9, 
  3.398330243293*^9}},ExpressionUUID->"3c3f51e7-636f-4c8c-952b-dddc29e3598f"],

Cell[TextData[{
 "Part 3:\t Extract the solution and:\n\t Plot a 2-Dimensional graph \
containing the solution for:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "200"}], 
   TraditionalForm]],ExpressionUUID->"1a15c9e9-c2b0-422e-9f2d-460845d1e69c"],
 ".\n\t Calculate the equilibrium point."
}], "Text",
 CellChangeTimes->{
  3.3983302538599997`*^9},ExpressionUUID->"d0f22c1d-bbe4-4ab1-ae9b-\
e24f871e4f43"],

Cell[TextData[{
 "Part 4:\t Change the value of  b  to .06\n\t Plot a 2-Dimensional graph \
containing the solution for:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "200"}], 
   TraditionalForm]],ExpressionUUID->"a9331c2d-ca5d-453d-8750-4612db58754a"],
 ".\n\t Calculate the equilibrium point."
}], "Text",
 CellChangeTimes->{
  3.398330263727*^9},ExpressionUUID->"6c20a613-53d7-49f7-a528-f89c129a307b"],

Cell["\<\
Part 5:\tExplain what is happening as the \"outflow\" parameter changes.\
\>", "Text",ExpressionUUID->"f6d6b01f-6d38-4c64-b90e-86e1e48306ac"]
}, Closed]],

Cell[CellGroupData[{

Cell["2.4.5 pg 27 (with modifications)", "Section",ExpressionUUID->"301bad3b-d969-40cc-a9da-a6b069bbe808"],

Cell[TextData[{
 "Recall Example 1.2 of Chapter 1.  This problem involves a spring-mass \
system which also included Coulomb friction (i.e. dry friction).  \
Experimentation with the physical problem indicates that when the force and \
velocity become small enough, then the mass will tend to \"stick\" (i.e. stay \
at rest).  Therefore, in some sense there are an infinite number of possible \
equilibrium points, each corresponding to a different physical condition \
where the resulting force produced by the spring is smaller than the minimal \
amount required to produce an acceleration.  The equation describing this \
physical system is:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"mx", "''"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", "k"}], "*", "x"}], " ", "-", " ", 
     RowBox[{"k1", "*", 
      RowBox[{"Sign", "[", 
       RowBox[{"x", "'"}], "]"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "cd6c61a2-253b-4af7-b0c7-9b08bff4a58d"],
 "\n\t\t\nThe values of the physical constants are:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"k", "=", "1.3"}], "\n", "\t", 
     RowBox[{"k1", "=", "1"}], "\n", "\t", 
     RowBox[{"m", "=", "1"}]}]}], TraditionalForm]],ExpressionUUID->
  "8fe2f632-e990-4cca-9ed0-6c093cf41001"],
 "\nPart 1: Convert the above second order ODE into a first-order system in \
the variables u1 and u2:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{"u1", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"x", "[", "t", "]"}]}], "\n", "\t", 
     RowBox[{
      RowBox[{"u2", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"f1e1e4d2-07f5-4b54-85f7-a83af2250500"]
}], "Text",
 CellChangeTimes->{{3.398330274192*^9, 3.398330318777*^9}, {3.398330857666*^9,
   3.3983308764960003`*^9}},ExpressionUUID->"63619f60-f1eb-491c-85a3-\
dbeecc335529"],

Cell[TextData[{
 "Part 2:\tSolve the ODE system for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "20"}], 
   TraditionalForm]],ExpressionUUID->"b2b19bba-53ce-4dd5-b11f-d3bdd1fce139"],
 " to obtain the solution rules.\n\tUse initial conditions:\n\t\t Initial \
displacement",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{"=", "  ", "10"}]}], TraditionalForm]],ExpressionUUID->
  "65ec70db-546b-4cfe-b8e4-85e3723ef93e"],
 "\n\t\t Initial velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"i", ".", "e", ".", " ", 
      RowBox[{
       RowBox[{"x", "'"}], "[", "0", "]"}]}], ")"}], "  ", "=", "  ", "2.5"}],
    TraditionalForm]],ExpressionUUID->"54a1a1fc-445b-45e3-87e7-0d97e8a2cca7"]
}], "Text",
 CellChangeTimes->{{3.398330348117*^9, 
  3.398330386981*^9}},ExpressionUUID->"e903e84b-8070-4c87-be00-c0b1d1f49836"],

Cell[TextData[{
 "Part 3:\t Extract the solution functions u1 and u2 from the solution rules.\
\n\t Generate a 2-dimensional plot of both functions over the time domain.\n\t\
 Generate a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2"}], "}"}], TraditionalForm]],ExpressionUUID->
  "e22d74c2-f29a-45af-8250-f98abec9d6c5"],
 " parametric plot over the time domain."
}], "Text",
 CellChangeTimes->{
  3.3983303978599997`*^9},ExpressionUUID->"611bf321-fcd8-49b6-b9c4-\
c9eace2a9d4c"],

Cell[TextData[{
 "Part 4:\t Plot the vector field corresponding to our first-order ODE \
system.\n\t Use the above ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2"}], "}"}], TraditionalForm]],ExpressionUUID->
  "8265c4e3-6160-4b7c-bfeb-9c7d4bb3290f"],
 " ",
 StyleBox["parametric",
  FontVariations->{"Underline"->True}],
 " plot to determine the plotting range for both u1 andu2.\n\t Set: Frame \
\[Rule] True"
}], "Text",
 CellChangeTimes->{{3.398330407672*^9, 3.398330421116*^9}, 
   3.463766977094768*^9},ExpressionUUID->"526f6081-f0a9-463a-8440-\
d172a7e447f0"],

Cell[TextData[{
 "Part 5:\tShow both the parametric and vector field plots together.\n\tPlot \
the parametric plot first and the vector field plot second.\n\tPlot the \
vector field plot first and the parametric plot second.\n\ti: Observe that \
the combined appearance of the final plot using the Show command is governed \
by the ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " plot and not the second plot.  (This is how ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "resolves which graphing appearance options are to be used when they are \
different for each plot.)\n\tii: Describe the apparent behavior of the \
spring-mass system corresponding to these initial conditions using these \
plots.\n\tiii: What are the apparent ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2"}], "}"}], TraditionalForm]],ExpressionUUID->
  "9fb04415-4e0f-4c4b-8d73-f7a3aaebeaa6"],
 " coordinates for the equilibrium point for this system? \n\t(Use these \
plots.)"
}], "Text",
 CellChangeTimes->{
  3.398330438414*^9},ExpressionUUID->"abadcee2-2a9b-4a29-a389-1bc42cbf2d4e"],

Cell["\<\
Part 6:\tIn order to better visualize the specific behavior of the \
mass-spring system when it comes to a halt:
\tSolve the ODE system for  0 \[LessEqual] t \[LessEqual] 20 to obtain the \
solution rules.
\tUse initial conditions:
\t\t Initial displacement  =   2
\t\t Initial velocity (i.e. x'[0])  =   2.5\
\>", "Text",
 CellChangeTimes->{{3.398332188158*^9, 
  3.398332193552*^9}},ExpressionUUID->"8e8ddb06-5939-4136-a9d3-fd308835eb4e"],

Cell[TextData[{
 "Part 7:\t Extract the solution functions from the solution rules.\n\t \
Generate a 2-dimensional plot of both functions over the time domain.\n\t \
Generate a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2"}], "}"}], TraditionalForm]],ExpressionUUID->
  "96866672-47a7-459d-952a-96a57c361d57"],
 " parametric plot over the time domain."
}], "Text",
 CellChangeTimes->{
  3.398330510021*^9},ExpressionUUID->"0c788e74-9049-424b-9b17-6d8a5274f3b4"],

Cell[TextData[{
 "Part 8:\t Plot the vector field corresponding to our first-order ODE \
system.\n\t Use the above {u1,u2} ",
 StyleBox["parametric",
  FontVariations->{"Underline"->True}],
 " plot to determine the plotting range for both u1 andu2.\n\t Set: Frame \
\[Rule] True"
}], "Text",
 CellChangeTimes->{3.398330532892*^9, 
  3.463767083045859*^9},ExpressionUUID->"44999556-c71c-4deb-9280-\
40f5d473ddb0"],

Cell[TextData[{
 "Part 9:\tShow both the parametric and vector field plots together.\n\tPut \
the vector field plot first and the parametric plot second.\n\ti: Describe \
the apparent behavior of the spring-mass system corresponding to these \
initial conditions using these plots.\n\tii: What are the apparent ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2"}], "}"}], TraditionalForm]],ExpressionUUID->
  "72fb0643-6e4c-410d-8d6c-7a48b61667da"],
 " coordinates for the equilibrium point for this system? \n\t(Use these \
plots.)"
}], "Text",
 CellChangeTimes->{
  3.398330559229*^9},ExpressionUUID->"e3c8c6b9-025e-4072-868e-1352cc110a8f"]
}, Closed]],

Cell[CellGroupData[{

Cell["2.4.8  (Not in the book)", "Section",ExpressionUUID->"7b8afdfd-a396-45bd-9790-fde145e3dd55"],

Cell[TextData[{
 "For many physical problems, it is natural that the coefficients in the ODE \
system will also change with time.  Such a system will not be autonomous.  \
Therefore, some of the above simple solution procedures cannot be applied.  \
To give you a sense of how this situation might arise, consider the following \
example.\n\nIf a pendulum is operating on a lubricated hinge, it will \
experience essentially zero friction.  However, as time passes the lubricant \
may break down and increase the overall level of friction.  Therefore, the \
problem will have an equilibrium point which attracts more and more strongly \
as time passes.  Assume that the ODE system that describes the behavior of \
this situation is given by the following ODE system:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t ", 
    RowBox[{
     RowBox[{
      RowBox[{"u1", "'"}], "  ", "=", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "t"}], "  ", "u1"}], "   ", "+", "    ", "u2"}]}], "\n", 
     " \t", 
     RowBox[{
      RowBox[{"u2", "'"}], "  ", "=", "    ", 
      RowBox[{
       RowBox[{"-", " ", "u1"}], "   ", "-", "   ", 
       RowBox[{"t", " ", "u2"}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "21a45e30-9982-436d-8c23-627965a0c8c0"],
 "\nPart 1: Calculate the u1, u2 location of any equilibrium point that this \
system might have."
}], "Text",
 CellChangeTimes->{{3.398330570902*^9, 3.398330603524*^9}, 
   3.398335189481*^9},ExpressionUUID->"296e79eb-76ed-4d35-8634-804c8859687f"],

Cell["\<\
Part 2: We would now like to generate plots of the time dependent vector \
field generated by this ODE.  There are many ways of doing this, however the \
following procedure is often very useful.  Evaluate the following code (one \
line at a time) to generate 2-dimensional vector field plots from t = 0 to t \
= 4:

Needs[\"VectorFieldPlots`\"]
\t...\t
vectorPlot[t_] :=
 
 VectorPlot[
  
  {-t u1 + u2, -u1 - t u2},
  
  {u1, -10, 10},
  {u2, -10, 10},
  
  Frame \[Rule] True,
  FrameLabel \[Rule] {\"u1\", \"u2\"}
  
  ]
  \t...
Animate[
\t vectorPlot[t],
\t {t, 0, 4}
 ]\
\>", "Text",
 CellChangeTimes->{{3.398330607166*^9, 3.39833060866*^9}, {3.39833114871*^9, 
   3.3983311666429996`*^9}, 3.398331252972*^9, 3.398331289734*^9, {
   3.3983338703710003`*^9, 3.398333964921*^9}, {3.398333997741*^9, 
   3.3983340148599997`*^9}, {3.398334846132*^9, 3.39833484774*^9}, {
   3.3983349147939997`*^9, 3.398334967078*^9}, 3.398335182817*^9, 
   3.463767194028103*^9},ExpressionUUID->"f2d11bf1-44b8-4829-9b4e-\
0523c6dba016"],

Cell["\<\
Part 3: Animate the above vector field plots to obtain a feeling of how \
strong the attractor becomes (i.e. how much the friction increases) as a \
function of time.  (Remember, the speed of animation can be slowed using the \
controls in the upper right corner of this window after the animation has \
started.)
(When you hand in your results, stop the animation before you print.)

Describe in general terms the behavior of the solutions for this ODE system \
as time increases using the information contained in the above vector fields.\
\>", "Text",
 CellChangeTimes->{
  3.398331311038*^9, {3.398334198625*^9, 3.398334208663*^9}, {
   3.398334247076*^9, 3.3983342481619997`*^9}, {3.3983351632790003`*^9, 
   3.3983351765150003`*^9}},ExpressionUUID->"254528f4-2be8-442a-9eb8-\
a35fe1a078d4"],

Cell[TextData[{
 " Part 4: Numerically solve the above ODE system starting with initial \
conditions:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t \t", 
    RowBox[{
     RowBox[{
      RowBox[{"u1", "'"}], "  ", "=", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "t"}], "  ", "u1"}], "   ", "+", "    ", "u2"}]}], "\n", 
     " \t\t", 
     RowBox[{
      RowBox[{"u2", "'"}], "  ", "=", "    ", 
      RowBox[{
       RowBox[{"-", " ", "u1"}], "   ", "-", "   ", 
       RowBox[{"t", " ", "u2"}]}]}], "\n", " \t\t", 
     RowBox[{
      RowBox[{"u1", "[", "0", "]"}], " ", "=", " ", "10"}], "\n", " \t\t", 
     RowBox[{
      RowBox[{"u2", "[", "0", "]"}], " ", "=", " ", "0"}]}]}], 
   TraditionalForm]],ExpressionUUID->"5186d820-702f-4ace-b3de-e614bb3576d0"],
 "\nfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "4"}], 
   TraditionalForm]],ExpressionUUID->"d67d6650-938b-4d07-a559-d835663d605c"],
 " to obtain the corresponding solution rules.   Extract the \"New\" solution \
functions from the solution rules (for this case use immediate assignment ",
 Cell[BoxData[
  FormBox["\<\"=\"\>", TraditionalForm]],ExpressionUUID->
  "a1ae473e-8358-4276-94d7-2cad5ad9e1b6"],
 " rather than ",
 Cell[BoxData[
  FormBox["\<\":=\"\>", TraditionalForm]],ExpressionUUID->
  "f31ba4bf-2159-4e80-af9a-516c1fbf8553"],
 " because of how we are going to use these functions later (also remember to \
clear t)).  Next, generate a regular ",
 StyleBox["plot",
  FontVariations->{"Underline"->True}],
 " of the ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " functions vs. time for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "4"}], 
   TraditionalForm]],ExpressionUUID->"964c6203-9492-4756-a1d2-5691f2f77cc9"],
 ", and finally generate a ",
 StyleBox["parametric",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["plot",
  FontVariations->{"Underline"->True}],
 " of the ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " solution functions for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", " ", "4"}], 
   TraditionalForm]],ExpressionUUID->"2df7e408-b532-4724-bd5c-5a7402aec1f4"],
 ":\n\n\t",
 "plot2 =\n \n\t\t ParametricPlot[\n  \n\t\t  {u1New[t], u2New[t]},\n  \n\t\t \
 {t, 0, 4},\n  \n\t\t  AxesLabel \[Rule] {\"u1\", \"u2\"},\n\t\t  PlotStyle \
\[Rule] Thickness[.01]\n\t  ]",
 "\n\nDescribe in general terms the behavior of this specific solution as \
time increases using the information contained in the above two plots."
}], "Text",
 CellChangeTimes->{{3.398331320059*^9, 3.3983313749449997`*^9}, {
   3.398335054719*^9, 3.398335130936*^9}, 3.398335204001*^9, {
   3.39833533365*^9, 
   3.398335371677*^9}},ExpressionUUID->"aae922e7-0f67-4b23-ada8-a45175da27f7"],

Cell[TextData[{
 "Part 5: Because the above vector field changes with time, we can not \
superimpose the plots of our solution on top of a single vector field.  \
However, there are several ways in which we can illustrate the dynamic \
behavior of this system.  The first method is to use the above plot of our \
two solutions vs. time and display two points (one point on each of the ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " graphs) that traces the motion of the solutions vs. time.  The first step \
in accomplishing this task is to be able to generate a graph which contains \
our two points at the desired locations at the corresponding time t.  \
Although there are several ways to do this, the ListPlot command will plot \
our two points automatically.  This can be accomplished using the following \
code (at first just for the initial time  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "045f02f7-6da8-4d8a-bf4d-7ad5dd4704db"],
 ", later in Part 6 we replace ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "f94a5ed2-6914-4e35-9a58-011ea1c539cc"],
 " with ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "764745ce-2e17-40ee-92d0-499d42952875"],
 "): \n\n\ttemp =\n \n\t ListPlot[\n  \n\t\t  {\n\t\t   {0, u1New[0]},\n\t\t  \
 {0, u2New[0]}\n\t\t   },\n  \n\t\t  PlotStyle \[Rule] {PointSize[0.03]}\n\t  \
]\n\t  \nThe output of the Graphics command can be displayed using:      \n\t\
\t?temp\nThe actual graph of the two points can be shown using:               \
       \n\t\tShow[temp]\nor just by evaluating temp again."
}], "Text",
 CellChangeTimes->{
  3.39833138485*^9, {3.398331431715*^9, 3.398331520793*^9}, 
   3.398335205417*^9, {3.3983355052609997`*^9, 3.398335516958*^9}, {
   3.398335547157*^9, 3.398335561091*^9}, {3.398335638542*^9, 
   3.3983356849230003`*^9}, {3.398335894252*^9, 3.398336003571*^9}, {
   3.398336293332*^9, 
   3.398336294498*^9}},ExpressionUUID->"5c607ea3-26a0-4b88-a1c5-cf1ab906e3e0"],

Cell[TextData[{
 "Part 6: Generate an ",
 StyleBox["animation",
  FontVariations->{"Underline"->True}],
 " of ",
 StyleBox["2-dimensional plots",
  FontVariations->{"Underline"->True}],
 " by showing ",
 StyleBox["both",
  FontVariations->{"Underline"->True}],
 " the plot of the ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " solutions vs. time ",
 StyleBox["and",
  FontVariations->{"Underline"->True}],
 " the ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " points at each time t, for times ranging from t = 0 to t = 4.   The \
following ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands should be used:\n\tAnimate[...]\n\tShow\t[...]\nAnimate these \
plots to understand how the coordinates move vs. time and describe in general \
terms what these graphs display. \n(The two points should move from left to \
right on top of their corresponding solution curves during the animation.)\n\
(When you hand in your results, stop the animation before you print.)"
}], "Text",
 CellChangeTimes->{{3.398331528104*^9, 3.398331530204*^9}, 
   3.398335215123*^9, {3.398335744153*^9, 3.398335755362*^9}, {
   3.3983357868570004`*^9, 3.398335797859*^9}, {3.398335858646*^9, 
   3.398335872199*^9}, {3.3983361082060003`*^9, 3.39833610927*^9}, {
   3.398336188781*^9, 
   3.398336195881*^9}},ExpressionUUID->"53897d68-9e34-4a6b-8d79-0aa53b112240"],

Cell[TextData[{
 "Part 7: Generate an animation of 2-dimensional ",
 StyleBox["parametric",
  FontVariations->{"Underline"->True}],
 " plot by showing ",
 StyleBox["both",
  FontVariations->{"Underline"->True}],
 " the plot of the ",
 StyleBox["parametric",
  FontVariations->{"Underline"->True}],
 " solution vs. time (from Part 4) and the ",
 StyleBox["single",
  FontVariations->{"Underline"->True}],
 " point at time t for times ranging from t = 0 to t = 4.   \nAnimate these \
plots to understand how the coordinates move in the ",
 StyleBox["phase",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["plane",
  FontVariations->{"Underline"->True}],
 " and describe in general terms what these graphs display.  What happens to \
the solution in the phase plane as t \[Rule] \[Infinity] ?\n(The point should \
be on top of the parametric curve and move clockwise from right to left as \
the animation progresses.)\n(When you hand in your results, stop the \
animation before you print.)"
}], "Text",
 CellChangeTimes->{
  3.3983315616140003`*^9, 3.398335219039*^9, {3.398336407495*^9, 
   3.398336411483*^9}, {3.398336480455*^9, 3.398336490113*^9}, {
   3.3983366587939997`*^9, 3.398336704476*^9}, 3.398336794929*^9, 
   3.4637674654916406`*^9},ExpressionUUID->"1173ca02-671d-47cd-bf77-\
c90886dc564f"],

Cell[TextData[{
 "Part 8: Generate an animation of 2-dimensional vector field plots by \
showing the plot of the vector field at time t and the ",
 StyleBox["single",
  FontVariations->{"Underline"->True}],
 " point at time t for times ranging from t = 0 to t = 4. \nAccomplish this \
task by:\n\t Using the \"Animate\" command\n\t Using the \"Show\" command \n\t\
 Using the \"vectorPlot[t]\"  function from Part 2\n\t Using the \"ListPlot\" \
command\t  \nAnimate these plots to understand how the coordinates move in \
the vector field phase plane and describe in general terms what these graphs \
display.  What happens to the solution in the phase plane as t \[Rule] \
\[Infinity] ?\n(When you hand in your results, stop the animation before you \
print.)"
}], "Text",
 CellChangeTimes->{
  3.398331571139*^9, 3.398335221816*^9, {3.398336912707*^9, 
   3.3983369674049997`*^9}, 3.398337020274*^9, 
   3.463767475725819*^9},ExpressionUUID->"a457b663-c139-4153-92ea-\
70883fcbc43d"]
}, Closed]]
}, Open  ]]
},
WindowSize->{1065, 558},
WindowMargins->{{2, Automatic}, {Automatic, 5}},
PrintingCopies->1,
PrintingPageRange->{Automatic, Automatic},
