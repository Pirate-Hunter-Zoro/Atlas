Cell[TextData[{
 "This case could be stable i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", "+", 
      OverscriptBox["\[Omega]", "_"]}], ")"}], ">", "0", " "}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e5e18c83-7aa0-4f27-bdf9-3c651a78bff8"],
 "and approaches the origin as seen by taking the limit."
}], "Text",
