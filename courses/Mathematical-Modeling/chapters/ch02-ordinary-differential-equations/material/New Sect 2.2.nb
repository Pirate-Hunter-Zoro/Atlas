Cell[TextData[{
 "or unstable i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", "+", 
      OverscriptBox["\[Omega]", "_"]}], ")"}], "<", "0"}], TraditionalForm]],
