          SuperscriptBox["r", "2"], "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["\[Omega]", "2"]}]}], "<", "0"}], "\[And]", 
        RowBox[{"r", "\[Equal]", "0"}]}]}], "]"}], "//", "ExpToTrig"}], "//", 
    "Simplify"}], "//", " ", "Transpose"}], "//", " ", "TableForm"}]], "Input",
 CellChangeTimes->{{3.7487080447104797`*^9, 3.7487080514274797`*^9}, {
   3.7487080840864797`*^9, 3.7487080889294796`*^9}, {3.7487081342254796`*^9, 
