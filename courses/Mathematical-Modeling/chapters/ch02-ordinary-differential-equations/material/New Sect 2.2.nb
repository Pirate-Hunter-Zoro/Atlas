   3.7487124346474795`*^9}},ExpressionUUID->"00838bf1-9a1c-45b7-ac22-\
65aac3a77ecc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
