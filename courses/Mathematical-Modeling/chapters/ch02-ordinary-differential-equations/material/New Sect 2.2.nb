  "In[666]:=",ExpressionUUID->"b7bec963-e369-4ea7-a591-4c234d4aea1f"],

Cell[TextData[{
 "Notice only the Sin and Cos in the above expression.\n\nIf the quantity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Omega]", "_"], ">", 
    RowBox[{
     RowBox[{"0", " ", "where", " ", 
      SuperscriptBox["r", "2"]}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["\[Omega]", "2"]}]}], "\[Equal]", 
    SuperscriptBox[
     OverscriptBox["\[Omega]", "_"], "2"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "27fe9596-f965-41fc-907c-f65a102e2e20"],
 ", then the exponent will be real and the solution will not orbit the \
origin.  "
}], "Text",
 CellChangeTimes->{
  3.3982967334564*^9, {3.3982982675824003`*^9, 3.3982982766884003`*^9}, 
   3.3982999334444*^9, {3.7487089724094796`*^9, 3.74870897361648*^9}, 
