Notebook[{

Cell[CellGroupData[{
Cell[" Section 7.2", "Title",ExpressionUUID->"038bba5f-9ff8-4c59-8eec-374bd83d8811"],

Cell[TextData[StyleBox["  Bifurcation and Catastrophe\n  (The Pumping Heart)",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"abb2d1c1-41fb-4dec-bc69-\
1fe8b9c5ae3b"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellChangeTimes->{3.3985436723123055`*^9},
 CellLabel->
  "In[289]:=",ExpressionUUID->"8d8a6d60-89bf-40e5-813c-2c66a4a4c377"],

Cell[CellGroupData[{

Cell["The Pumping Heart Model", "Section",ExpressionUUID->"71b752de-2de4-4000-a9fb-94b8e1951349"],

Cell[TextData[{
 "A simple model of the pumping heart includes the following characteristics: \
muscle fiber length and stimulus level\n\t1: Initially, the heart muscle \
fiber is in a relaxed state, called diastole.\n\t2: A contraction of the \
muscle fibers, is called systole.\n\t\tI: Systole occurs slowly a first, then\
\n\t\tII: occurs suddenly (producing a high volume of blood).\n\t3: Diastole \
(the relaxing of the muscle fibers) occurs:\n\t\tI: Slowly at first, then\n\t\
\tII: rapidly (allowing the heart to fill with blood).\nThe diastole-systole \
cycle occurs in response to a stimulus within the heart tissue.  ",
 StyleBox["A model of the heart must include both the time response of the \
muscle fiber length and the corresponding stimulus level.",
  FontWeight->"Bold"],
 "  Also, it is known that the fully relaxed state of the heart muscle fibers \
must be an attractor for the stimulus response.\nDefine the variables for our \
model:\n\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{
    "time", " ", "in", " ", "tenths", " ", "of", " ", "a", " ", "second"}]}], 
   TraditionalForm]],ExpressionUUID->"d58a6413-c139-41a2-a005-0e210b8d9b75"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "="}], TraditionalForm]],ExpressionUUID->
  "feff482c-bcd5-4299-b7e5-b3a8bca1f820"],
 " Heart muscle fiber length\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["x", "^"], "="}], TraditionalForm]],ExpressionUUID->
  "06acbdb3-a2b0-40fb-8fdd-493655ef651a"],
 " Diastolic equilibrium\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Beta]", "[", "t", "]"}], "="}], TraditionalForm]],
  ExpressionUUID->"3d111b56-4f7f-4722-9402-0d0bbc964124"],
 " Stimulus level \n\nTherefore, one possible set of equations that \
incorporates the above conditions includes the heart muscle fiber length, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "88355024-3ff7-4a63-a020-21f6f19a0633"],
 ", the stimulus level ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "57a8b644-f260-456c-8d80-7a80c627be66"],
 ", along with 2 model parameters \[Alpha] and \[Mu]."
}], "Text",ExpressionUUID->"89977981-2a0c-489d-936a-cc3d3fe7d2e1"],

Cell[BoxData[
 RowBox[{"ODE1", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}]}]}]], "Input",
 CellLabel->
  "In[290]:=",ExpressionUUID->"c9bc8f70-f38a-47ed-800d-b12eb71d3005"],

Cell[BoxData[
 RowBox[{"ODE2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Beta]", "'"}], "[", "t", "]"}], "\[Equal]", 
   FractionBox[
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "-", 
     OverscriptBox["x", "^"]}], "\[Mu]"]}]}]], "Input",
 CellLabel->
  "In[291]:=",ExpressionUUID->"8eaabf7c-f94c-4d55-8232-b0867594eb80"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Equilibrium Conditions for Both ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "c4fefc34-d1e2-47d0-b363-25635ee84b37"],
 " and ",
 Cell[BoxData[
  FormBox["\[Beta]", TraditionalForm]],ExpressionUUID->
  "fc1148c6-4e7a-45ee-a43a-9a28366f351a"],
 ":"
}], "Section",ExpressionUUID->"881b7bcd-2489-4a5f-b39e-4020de8f5cb0"],

Cell[TextData[{
 "It is possible to determine the equilibrium conditions for our model:\n\n",
 "the first ODE with ",
 StyleBox["constant",
  FontVariations->{"Underline"->True}],
 " stimulus level ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "bc6b2cc1-54fd-404f-9b27-478edf083748"],
 ":\n\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
     RowBox[{"\[Mu]", "(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}], 
    "\[IndentingNewLine]"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "[", "t", "]"}], " ", "is", " ", "constant"}], 
    "\[IndentingNewLine]"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"\[Alpha]", " ", "is", " ", "a", " ", "parameter"}], 
   TraditionalForm]}],ExpressionUUID->"012839cd-9b66-4f19-b81a-662534a52f1b"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.4669562073007216`*^9, 
  3.466956260049709*^9}},ExpressionUUID->"3d282303-863a-4fde-9098-\
6c5fcc903b42"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"0", "==", 
        RowBox[{"\[Mu]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"0", "==", 
        FractionBox[
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], "-", 
          OverscriptBox["x", "^"]}], "\[Mu]"]}]}], "\[IndentingNewLine]", 
      "}"}], ",", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", 
       RowBox[{"\[Beta]", "[", "t", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "//", "Transpose"}], "//", 
  "TableForm"}]], "Input",
 CellChangeTimes->{{3.3985438488748055`*^9, 3.3985439153904305`*^9}},
 CellLabel->
  "In[292]:=",ExpressionUUID->"5a5a8f6f-b8ef-4de4-9ee5-77fc95aaad74"],

Cell[TextData[{
 "As expected, the heart fiber length approaches an equilibrium ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    OverscriptBox["x", "^"]}], TraditionalForm]],ExpressionUUID->
  "45971f07-243c-4f94-be91-55a7950ecec9"],
 " when the stimulus level approaches ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Beta]", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "3"]}], " ", 
     OverscriptBox["x", "^"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "3"}], " ", "\[Alpha]"}], "+", 
       SuperscriptBox[
        OverscriptBox["x", "^"], "2"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"3d8d84cb-6f2d-4078-bf1d-490af9630eee"]
}], "Text",ExpressionUUID->"81fc45ba-1ade-43af-babf-3815c8d94942"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Equilibrium Conditions for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "3dba6a95-f022-4d9c-a7ee-10e3717a22dc"],
 " Only:\n\n             Both ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "37e630c8-30d9-4c74-b2e7-b9531582f6c4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "0dd512ba-9603-4630-b73a-b6fb40321d4d"],
 " are Constant:\n"
}], "Section",
 CellChangeTimes->{{3.4669445318663692`*^9, 
  3.4669445590521293`*^9}},ExpressionUUID->"368629ee-cd0b-468f-84bd-\
ef13693aa62e"],

Cell[TextData[{
 "We will start our analysis by considering the special case of examining the \
equilibrium conditions for the first ODE with ",
 StyleBox["constant",
  FontVariations->{"Underline"->True}],
 " stimulus level ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "3e5cac3b-8ea5-4078-904b-312ef9a6c906"],
 ":\n\n\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
     RowBox[{"\[Mu]", "(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}], 
    "\[IndentingNewLine]"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "[", "t", "]"}], " ", "is", " ", "constant"}], 
    "\[IndentingNewLine]"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"\[Alpha]", " ", "is", " ", "a", " ", "parameter"}], 
   TraditionalForm]}],ExpressionUUID->"0248f94b-6c4d-4308-a406-63721c290add"],
 "\n\t\nHowever, please keep in mind that in a ",
 StyleBox["real",
  FontVariations->{"Underline"->True}],
 " heart, the stimulus level ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "3f2a1b95-c575-4679-9937-50c758b766c7"],
 " will ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " be constant."
}], "Text",
 CellChangeTimes->{{3.466956091537319*^9, 3.466956123380458*^9}, {
  3.4669562814711723`*^9, 
  3.4669562988614635`*^9}},ExpressionUUID->"9abeda68-8052-4ef4-9b93-\
bc800aefaa45"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"0", "\[Equal]", 
    RowBox[{"\[Mu]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], "-", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SuperscriptBox["x", "3"], "3"], "-", 
         RowBox[{"\[Alpha]", " ", "x"}]}], ")"}]}], ")"}]}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[Beta]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985439261716805`*^9, 3.3985439294529305`*^9}},
 CellLabel->
  "In[293]:=",ExpressionUUID->"5268f29c-09c0-4574-8fe8-ec71209a156b"],

Cell[BoxData[
 RowBox[{"plot1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
  "ParametricPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", 
      RowBox[{
       FractionBox["1", "3"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["x", "3"]}], "+", 
         RowBox[{"3", " ", "x", " ", "\[Alpha]"}]}], ")"}]}], ",", "x"}], 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", 
      RowBox[{"-", ".5"}], ",", "1.5"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<\[Beta]\>\"", ",", "\"\<x\>\""}], 
      "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", ".5"}], ",", "1.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{
  3.3985439355466805`*^9, {3.3985443132029305`*^9, 3.3985443284685555`*^9}, 
   3.3985444325779305`*^9},
 CellLabel->
  "In[294]:=",ExpressionUUID->"343cd837-6464-41d3-8767-97df6759c24a"],

Cell[TextData[{
 "The one-dimensional gradient field (along with the two dimensions \
corresponding to the parameters \[Alpha] and \[Beta]) can be generated as \
follows:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{
      RowBox[{"-", "\[Beta]"}], "-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox["x", "3"], "3"], "-", 
        RowBox[{"\[Alpha]", " ", "x"}]}], ")"}]}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"70606745-6d3f-4186-8f7d-cd976b26f7b6"],
 "\n\t\n(Observe that the scaling of the vector lengths has been adjusted for \
better visibility.)"
}], "Text",
 CellChangeTimes->{{3.4669565286070523`*^9, 
  3.4669565333569613`*^9}},ExpressionUUID->"7fa74166-2ae5-4252-92b3-\
acbf343feafe"],

Cell[BoxData[
 RowBox[{"plot2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"VectorPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], "-", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SuperscriptBox["x", "3"], "3"], "-", 
         RowBox[{"\[Alpha]", " ", "x"}]}], ")"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", 
      RowBox[{"-", "0.5"}], ",", "1.5"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Beta]", ",", 
      RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"VectorScale", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", ".2", ",", "Automatic"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"VectorPoints", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985439551873055`*^9, 3.3985440044841805`*^9}, {
   3.3985443378591805`*^9, 3.3985443512498055`*^9}, 3.3985444429060555`*^9, {
   3.3985476350310555`*^9, 3.3985476435779305`*^9}, {3.4668745181756253`*^9, 
   3.4668745235978475`*^9}, {3.466874615525605*^9, 3.4668746668726416`*^9}, 
   3.466874721405982*^9, {3.466874757499963*^9, 3.4668749979858656`*^9}},
 CellLabel->
  "In[295]:=",ExpressionUUID->"e9654d72-3258-4548-94e0-2e13d5cd4984"],

Cell["\<\
It is possible to superimpose the surface corresponding to the equilibrium \
points along with the one-dimensional vector field:\
\>", "Text",ExpressionUUID->"21b9df05-916e-445f-b49a-93dd4456d7b3"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
  "plot1", ",", "\[IndentingNewLine]", "plot2", ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"-", ".5"}], ",", " ", "1.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.5"}], ",", " ", "1.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2.5"}], ",", " ", "2.5"}], "}"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->
  "In[296]:=",ExpressionUUID->"1a11f96e-b4e9-4f55-a5f6-aeab7e118418"],

Cell[TextData[{
 "Again, the above one-dimensional vector field and the surface corresponding \
to the equilibrium points is difficult to interpret.  Therefore, segment the \
above plot into thin slices corresponding to small steps in the parameter \
\[Alpha]:\n\n",
 StyleBox["Warning!", "Subsection"],
 " The following calculation may take some time."
}], "Text",
 CellChangeTimes->{{3.3985966551465807`*^9, 3.3985966972247057`*^9}, {
  3.4669429947070026`*^9, 
  3.4669429965799146`*^9}},ExpressionUUID->"ba06f4da-c96c-401c-a1be-\
ba8068af248f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "modelPlot1", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"modelPlot1", "[", "\[Alpha]", "]"}], "=", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "ParametricPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]2", ",", 
           RowBox[{
            FractionBox["1", "3"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["x", "3"]}], "+", 
              RowBox[{"3", " ", "x", " ", "\[Alpha]2"}]}], ")"}]}], ",", 
           "x"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]2", ",", 
           RowBox[{"\[Alpha]", "-", ".1"}], ",", 
           RowBox[{"\[Alpha]", "-", ".00"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\[Alpha]\>\"", ",", "\"\<\[Beta]\>\"", ",", "\"\<x\>\""}], 
           "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Alpha]", "-", ".25"}], ",", 
              RowBox[{"\[Alpha]", "+", ".25"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Mesh", "\[Rule]", "None"}]}], "\[IndentingNewLine]", "]"}], 
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
       "VectorPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
