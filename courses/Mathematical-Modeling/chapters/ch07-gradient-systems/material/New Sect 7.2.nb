Cell[TextData[{
 "\nManipulate the above plots to see the influence of the parameter \
\[Alpha].\n\nAlso, move the slider bar to see the formation of a bifurcation \
arround ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "0.2"}], TraditionalForm]],ExpressionUUID->
  "4642cafc-f2e3-434f-9ad6-c2ddcedc851d"],
