   3.466944680669345*^9, 3.4669446988400574`*^9}},
 CellLabel->
  "In[303]:=",ExpressionUUID->"673472e9-d822-4fb6-8f20-0b2166788cbe"],

Cell["\<\
It is possible to superimpose the surface corresponding to the equilibrium \
points along with the two-dimensional vector field:\
\>", "Text",ExpressionUUID->"d05beac0-3e16-4f3d-9c8b-26079503126a"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
  "plot1", ",", "\[IndentingNewLine]", "plot3", ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", ".5"}], ",", "1.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->
  "In[304]:=",ExpressionUUID->"e3466313-850a-4906-a2c5-a2567f477733"],

Cell[TextData[{
 "Again, the above two-dimensional vector field and the surface corresponding \
to the equilibrium points is difficult to interpret.  Therefore, segment the \
above plot into thin slices corresponding to small steps in the parameter \
\[Alpha]:\n\n",
 StyleBox["Warning!", "Subsection"],
 " The following calculation may take some time to calculate."
}], "Text",
 CellChangeTimes->{
  3.3985972092090807`*^9, {3.466956628339513*^9, 
   3.466956637995577*^9}},ExpressionUUID->"041572e4-1ea1-402a-bfbe-\
3d2945c0454e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "modelPlot2", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"modelPlot2", "[", "\[Alpha]", "]"}], "=", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "ParametricPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]2", ",", 
           RowBox[{
            FractionBox["1", "3"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["x", "3"]}], "+", 
              RowBox[{"3", " ", "x", " ", "\[Alpha]2"}]}], ")"}]}], ",", 
           "x"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]2", ",", 
           RowBox[{"\[Alpha]", "-", ".1"}], ",", 
           RowBox[{"\[Alpha]", "-", ".00"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\[Alpha]\>\"", ",", "\"\<\[Beta]\>\"", ",", "\"\<x\>\""}], 
           "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Alpha]", "-", ".25"}], ",", 
              RowBox[{"\[Alpha]", "+", ".25"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Mesh", "\[Rule]", "None"}]}], "\[IndentingNewLine]", "]"}], 
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
       "VectorPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            FractionBox[
             RowBox[{"x", "-", 
              OverscriptBox["x", "^"]}], "\[Mu]"], ",", 
            RowBox[{"\[Mu]", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "\[Beta]"}], "-", 
               RowBox[{"(", 
                RowBox[{
                 FractionBox[
                  SuperscriptBox["x", "3"], "3"], "-", 
                 RowBox[{"\[Alpha]1", " ", "x"}]}], ")"}]}], ")"}]}]}], "}"}],
           "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]1", ",", "\[Alpha]", ",", 
           RowBox[{"\[Alpha]", "+", ".05"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[Beta]", ",", 
           RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"VectorScale", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", ".04", ",", "Automatic"}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VectorPoints", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "10", ",", "15"}], "}"}]}]}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"ViewPoint", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"6.384", ",", 
          RowBox[{"-", "0.0400"}], ",", 
          RowBox[{"-", "0.0400"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Chop", "[", 
            RowBox[{"N", "[", "\[Alpha]", "]"}], "]"}], ",", 
           "\"\< \[LessEqual] \[Alpha] \[LessEqual] \>\"", ",", 
           RowBox[{"Chop", "[", 
            RowBox[{"\[Alpha]", "+", ".1"}], "]"}]}], "}"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", 
      RowBox[{
       RowBox[{"-", "5"}], "/", "10"}], ",", 
      RowBox[{"14", "/", "10"}], ",", 
      RowBox[{"1", "/", "10"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]}], "Input",
