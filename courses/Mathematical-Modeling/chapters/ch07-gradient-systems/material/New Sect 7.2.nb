Cell[TextData[{
 " \nFor example when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1.1"}], TraditionalForm]],ExpressionUUID->
  "21c77656-6d32-48ed-b288-92f54b46011a"],
 ":"
}], "Text",
