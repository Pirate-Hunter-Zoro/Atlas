Cell[TextData[{
 "\nwe can Manipulate the above plots to see the influence of the parameter \
\[Alpha].\n\nAlso, move the slider bar to see the formation of a bifurcation \
arround ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "0.2"}], TraditionalForm]],ExpressionUUID->
  "0180fe19-28db-47d0-b148-00379296e827"],
 "."
}], "Text",
 CellChangeTimes->{{3.3985967569903307`*^9, 3.3985967944434557`*^9}, {
  3.4669437380190806`*^9, 3.4669437562971334`*^9}, {3.4669438302284822`*^9, 
  3.4669438496487412`*^9}, {3.4669438814585943`*^9, 3.4669438827553616`*^9}, {
  3.46694420436145*^9, 3.4669442816558514`*^9}, {3.466956724322045*^9, 
  3.466956726509503*^9}},ExpressionUUID->"ee6be98f-85db-4f8a-afdd-\
6da579cc9ca6"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"modelPlot2", "[", "\[Alpha]", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", 
     RowBox[{
      RowBox[{"-", "5"}], "/", "10"}], ",", 
     RowBox[{"14", "/", "10"}], ",", 
     RowBox[{"1", "/", "10"}]}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985911486622057`*^9, 3.3985911761309557`*^9}, 
   3.3985912913965807`*^9, 3.3985913414122057`*^9, {3.3985914607872057`*^9, 
   3.3985914641309557`*^9}, {3.3985915284747057`*^9, 
   3.3985915555840807`*^9}, {3.3985919518809557`*^9, 
   3.3985919533184557`*^9}, {3.3985930247247057`*^9, 
   3.3985930286778307`*^9}, {3.4669452749655595`*^9, 3.466945289340376*^9}},
 CellLabel->
  "In[308]:=",ExpressionUUID->"687d88d6-7ce8-4118-af94-f4ff05d70e3d"],

Cell["\<\
Animate to see each step if your computer is fast enough (try slowing down \
the animation until your computer can keep up).\
\>", "Text",
 CellChangeTimes->{{3.3985967569903307`*^9, 3.3985967944434557`*^9}, {
  3.4669436877953153`*^9, 3.4669437192417974`*^9}, {3.466943945734496*^9, 
  3.4669439930899305`*^9}},ExpressionUUID->"d626d2bc-dcef-4720-b91c-\
5173fe793ca1"],

Cell[TextData[{
 StyleBox["Observations",
  FontWeight->"Bold"],
 ": Careful examination of the above graphs demonstrates that for negative \
values of the parameter \[Alpha], that the equilibrium point corresponding to \
a constant \[Beta] will be stable (i.e. a stable heart is constant in time \
and is therefore not beating).  However as the parameter \[Alpha] becomes \
positive, then the behavior of the model is to jump from a stable equilibrium \
point right past an unstable equilibrium point until it reaches the next \
stable equilibrium point."
}], "Text",
 CellChangeTimes->{{3.466945434322895*^9, 3.466945455244502*^9}, {
  3.466956811119488*^9, 
  3.466956845222184*^9}},ExpressionUUID->"f3bcbac6-6306-46f0-85d3-\
ae17008f434a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Solutions for Both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "09253eb8-7291-4296-8eff-a4f3200f9eaf"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "72904dec-bfe9-4623-b762-8784df0046ae"],
 " \n\n             With one Parameter \[Alpha]:\n            "
}], "Section",
 CellChangeTimes->{{3.4669456089932365`*^9, 3.4669456244931374`*^9}, 
   3.466958005780546*^9, {3.466958040139921*^9, 
   3.466958046983671*^9}},ExpressionUUID->"42977298-badd-499f-82a5-\
bb68f8cdbb29"],

Cell["\<\
Consider a family of solutions for different values of the parameter \[Alpha] \
using our model:\
\>", "Text",ExpressionUUID->"da73c844-06f9-47ee-bb74-fe684dd03eaf"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{
    "time", " ", "in", " ", "tenths", " ", "of", " ", "a", " ", "second"}]}], 
   TraditionalForm]],ExpressionUUID->"5c6395e2-653c-47d4-b8ac-f44ea1e65b7a"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
    RowBox[{"\[Mu]", "(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"85d8ac49-c2a0-4c80-a93c-51dad1556dbf"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "'"}], "[", "t", "]"}], "\[Equal]", 
    FractionBox[
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "-", 
      OverscriptBox["x", "^"]}], "\[Mu]"]}], TraditionalForm]],
  ExpressionUUID->"3c16161a-f753-4a5d-b240-9467f66d3fc0"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", " ", "is", " ", 
    StyleBox["a",
     FontSlant->"Plain"], " ", "parameter"}], TraditionalForm]],
  ExpressionUUID->"c4a22a31-01c4-488f-b406-91afabb5618c"]
}], "Text",
 CellChangeTimes->{{3.4669568736202593`*^9, 3.466956879074815*^9}, {
  3.466956968645187*^9, 
  3.466956970942665*^9}},ExpressionUUID->"641af279-6506-4418-8843-\
109b089cbcab"],

Cell[TextData[{
 "With arbitrary initial conditions of:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], TraditionalForm]],
  ExpressionUUID->"c060c47e-01f7-4721-b57f-be6ba0fd90c1"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Beta]", "[", "0", "]"}], "\[Equal]", "2"}], TraditionalForm]],
  ExpressionUUID->"2095e17f-f771-40da-bb1e-0054e3c1730b"]
}], "Text",ExpressionUUID->"d463c16c-f4a1-482f-b5bd-720570c96749"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Mu]", "=", "3.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   OverscriptBox["x", "^"], "=", "1.0"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[309]:=",ExpressionUUID->"538979d9-9988-46ca-b1a4-352b91ce578a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solns", "[", 
   RowBox[{"\[Alpha]_", ",", "tMax_"}], "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Flatten", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["x", "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Beta]", "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
        FractionBox[
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], "-", 
          OverscriptBox["x", "^"]}], "\[Mu]"]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "0", "]"}], "\[Equal]", "2"}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", 
       RowBox[{"\[Beta]", "[", "t", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"MaxSteps", "\[Rule]", "10000"}]}], "\[IndentingNewLine]", "]"}],
    "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3985445462498055`*^9, 3.3985445496248055`*^9}},
 CellLabel->
  "In[311]:=",ExpressionUUID->"7bccaea3-40fb-49ee-9651-a09ae7394cb4"],

Cell[TextData[{
 "We can plot this solution (starting long after the initial conditions have \
damped out by taking ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", ">", "tMin"}], TraditionalForm]],ExpressionUUID->
  "745bee64-e219-45b7-8061-51cde853b4bd"],
 ") as follows:"
}], "Text",
 CellChangeTimes->{{3.4669569235239754`*^9, 
  3.4669569326513696`*^9}},ExpressionUUID->"eef8c9a2-ab4c-4543-a5bd-\
da1717701506"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plot\[Alpha]", "[", 
   RowBox[{"\[Alpha]_", ",", "tMin_", ",", "tMax_"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "t", "]"}], ",", 
        RowBox[{"x", "[", "t", "]"}]}], "}"}], "/.", "\[InvisibleSpace]", 
      RowBox[{"solns", "[", 
       RowBox[{"\[Alpha]", ",", "tMax"}], "]"}]}], "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<\[Beta][t]\>\"", ",", "\"\<x[t]\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotLabel", "\[Rule]", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Alpha] = \>\"", ",", "\[Alpha]"}], "}"}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", "Thick"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3985437932810555`*^9, 3.3985437996873055`*^9}, 
   3.3985445583279305`*^9, {3.3985446509998055`*^9, 3.3985446588904305`*^9}},
 CellLabel->
  "In[312]:=",ExpressionUUID->"ec1299e5-b168-4984-bf9d-f0dea05c5036"],

Cell[TextData[{
 "For example, consider the single value of the parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1.1"}], TraditionalForm]],ExpressionUUID->
  "73375db3-f3e6-4f44-b9cd-fe663798083b"],
 ":"
}], "Text",
 CellChangeTimes->{{3.4669458409292526`*^9, 
  3.4669458934289165`*^9}},ExpressionUUID->"ec944b16-d745-4914-afac-\
5e513150550b"],

Cell[BoxData[
 RowBox[{"plot\[Alpha]", "[", 
  RowBox[{"1.1", ",", "50", ",", "100"}], "]"}]], "Input",
 CellChangeTimes->{{3.46694574841422*^9, 3.466945772695314*^9}, {
  3.4669458107106957`*^9, 3.466945819257516*^9}},
 CellLabel->
  "In[313]:=",ExpressionUUID->"f70291be-85aa-41e5-867e-1054b1613aac"],

Cell[TextData[{
 "By using the above graph, we can see the solution of the two ODEs for each \
fixed value of the parameter \[Alpha]:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
    RowBox[{"\[Mu]", "(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"31d5f092-f343-4b6d-ba75-9fd11b925b12"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "'"}], "[", "t", "]"}], "\[Equal]", 
    FractionBox[
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "-", 
      OverscriptBox["x", "^"]}], "\[Mu]"]}], TraditionalForm]],
  ExpressionUUID->"ba8ee6a4-180b-4903-b72d-577f41bae1b2"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", " ", "is", " ", 
    StyleBox["a",
     FontSlant->"Plain"], " ", "parameter"}], TraditionalForm]],
  ExpressionUUID->"ddc728fe-10fe-4d3d-94ba-cc5a33cc0e52"]
}], "Text",
 CellChangeTimes->{{3.4669459331474123`*^9, 3.466945960522237*^9}, 
   3.4669569891974535`*^9, {3.4669570218779016`*^9, 
   3.466957083700411*^9}},ExpressionUUID->"8fd66c27-2277-4332-baa2-\
887af28e05ad"],

Cell[TextData[{
 "Consider the following family of solutions for different values of the \
parameter \[Alpha]:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", ".5"}], "<", "\[Alpha]", "<", "1.5"}], TraditionalForm]],
  ExpressionUUID->"5e4bfa0a-23df-410e-b379-9b3b18eb96c2"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{
     "time", " ", "in", " ", "tenths", " ", "of", " ", "a", " ", "second"}]}],
     ",", " ", 
    RowBox[{"50", "\[LessEqual]", "t", "\[LessEqual]", "100", " "}]}], 
   TraditionalForm]],ExpressionUUID->"3b4d05c5-e77b-45ac-a846-cdf55f7dd3cb"]
}], "Text",
 CellChangeTimes->{{3.3985447604685555`*^9, 3.3985447623904305`*^9}, {
  3.3985448732966805`*^9, 
  3.3985448745466805`*^9}},ExpressionUUID->"74b5d536-31cf-4318-963f-\
0237e6bf37dd"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plot\[Alpha]", "[", 
    RowBox[{"\[Alpha]", ",", "50", ",", "100"}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "1.1"}], "}"}], ",", 
     RowBox[{"-", ".5"}], ",", "1.5"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985445786560555`*^9, 3.3985446012498055`*^9}, {
  3.3985447978591805`*^9, 3.3985447985623055`*^9}, {3.3985448801091805`*^9, 
  3.3985448813591805`*^9}, {3.466957224322385*^9, 3.466957284874685*^9}},
 CellLabel->
  "In[314]:=",ExpressionUUID->"bdbf1694-a176-47af-aeaf-edb92e59815f"],

Cell[TextData[{
 "The above behavior (as expected) goes to a bifurcation or catastrophe for \
certain values of the parameter \[Alpha].  Therefore, consider a restricted \
range of the parameter \[Alpha]:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.9", "<", "\[Alpha]", "<", "1.1"}], TraditionalForm]],
  ExpressionUUID->"1d69b3e7-edb7-4072-b1fb-51cb3617d68c"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{
     "time", " ", "in", " ", "tenths", " ", "of", " ", "a", " ", "second"}]}],
     ",", " ", 
    RowBox[{"50", "\[LessEqual]", "t", "\[LessEqual]", "100", " "}]}], 
   TraditionalForm]],ExpressionUUID->"639b986b-36df-4c66-9274-16d592707ee1"]
}], "Text",ExpressionUUID->"d58e4392-e599-445b-bd69-8909dc18f4e5"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plot\[Alpha]", "[", 
    RowBox[{"\[Alpha]", ",", "50", ",", "100"}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "1.1"}], "}"}], ",", "0.9", ",", "1.1"}], 
    "}"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985448395935555`*^9, 3.3985448524685555`*^9}, {
   3.3985448960935555`*^9, 3.3985448975466805`*^9}, {3.466957326034622*^9, 
   3.466957333238393*^9}, 3.4669573779904695`*^9},
 CellLabel->
  "In[315]:=",ExpressionUUID->"45c4c8e6-b2cc-485c-89df-d5f57a4725da"],

Cell[TextData[{
 "Observe that the above family of solutions experiences a catastrophe for \
values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "\[TildeEqual]", "1.025"}], TraditionalForm]],
  ExpressionUUID->"155918fe-06fe-47a6-b6c7-31a5ccaa8e7c"],
 ".\nAgain, consider a more restricted range of the parameter \[Alpha]:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"1.028", "<", "\[Alpha]", "<", "1.032"}], TraditionalForm]],
  ExpressionUUID->"525e9a50-876f-41c0-b355-28e93300da24"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{
     "time", " ", "in", " ", "tenths", " ", "of", " ", "a", " ", "second"}]}],
     ",", " ", 
    RowBox[{"50", "\[LessEqual]", "t", "\[LessEqual]", "100", " "}]}], 
   TraditionalForm]],ExpressionUUID->"582ff487-7902-4479-b604-ac7945d6e0f0"]
}], "Text",
 CellChangeTimes->{{3.3985451327654305`*^9, 3.3985451327654305`*^9}, {
  3.3985451764373055`*^9, 3.3985451764373055`*^9}, {3.466957434148157*^9, 
  3.4669574352731857`*^9}},ExpressionUUID->"57e841a0-c5fb-4dd1-b05e-\
ab9efc53035d"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plot\[Alpha]", "[", 
    RowBox[{"\[Alpha]", ",", "50", ",", "100"}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "1.028", ",", "1.032"}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985449305154305`*^9, 3.3985449898123055`*^9}, {
   3.3985450709685555`*^9, 3.3985450732185555`*^9}, 3.3985451277185555`*^9, 
   3.3985451736560555`*^9, {3.4669574450703115`*^9, 3.4669574497579317`*^9}},
 CellLabel->
  "In[316]:=",ExpressionUUID->"1a6fd84f-870b-409a-96fa-e28fff6f2186"],

Cell[TextData[{
 "Observe that after the catastrophe (that occurs for values of the parameter \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "\[TildeEqual]", "1.0293"}], TraditionalForm]],
  ExpressionUUID->"57151814-202a-41ae-8846-1c7cc6d41152"],
 ") that the behavior of the solution is not an equilibrium point, but a \
limit cycle."
}], "Text",ExpressionUUID->"b31aa07f-1b15-46e9-ad72-b9ac8a7cf9ac"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Further Solutions for Both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "48407c6c-0492-4a30-ba1a-2156b5a71561"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "1cccce28-5cec-4448-b264-4dd4c6226628"],
 " with one parameter \[Alpha]:"
}], "Section",ExpressionUUID->"eb6c599a-3c8a-4b57-945f-c04f5725675f"],

Cell[TextData[{
 "Normally, a heart monitor will only monitor the blood pressure of a \
patient.  In our case, we can infer the blood pressure indirectly from the \
heart muscle length ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "170fb4f9-3303-44f0-810a-724af55a23b3"],
 ".  Remember, the shorter the heart muscle, the higher the blood pressure.  \
We will assume a linear relationship between blood pressure and heart muscle \
length.  This assumption is poor at best, but not totally unrealistic.\n\n\t\t\
blood pressure ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "18"}], 
      RowBox[{"x", "[", "t", "]"}]}], "+", "120"}]}], TraditionalForm]],
  ExpressionUUID->"1a872a22-ada4-4a8e-bb0c-6ab176d9d693"],
 "\n\n If we graph a family of solutions corresponding to a fixed value of \
the parameter \[Alpha] corresponding to a healthy heart, we generate a \
traditional plot of a heart patient's blood pressure."
}], "Text",ExpressionUUID->"109015d5-1af0-45c3-987b-0813f6e585e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotSoln", "[", 
   RowBox[{"\[Alpha]_", ",", "tMin_", ",", "tMax_"}], "]"}], ":=", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "18"}], 
        RowBox[{"x", "[", "t", "]"}]}], "+", "120"}], "/.", 
      "\[InvisibleSpace]", 
      RowBox[{"solns", "[", 
       RowBox[{"\[Alpha]", ",", "tMax"}], "]"}]}], "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tMin", ",", "tMax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "3"}], ",", "200"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<t (\!\(\*SuperscriptBox[\(10\), \(-1\)]\) sec)\>\"", ",", 
       "\"\<p[t]\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLabel", "\[Rule]", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Alpha] = \>\"", ",", "\[Alpha]"}], "}"}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Axes", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", "Thick"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3985438186560555`*^9, 3.3985438243904305`*^9}, {
  3.3985452901248055`*^9, 3.3985452970935555`*^9}},
 CellLabel->
  "In[317]:=",ExpressionUUID->"685ec02b-8e1b-4511-b0f8-ae367bab99a4"],

Cell[TextData[{
 "For example, consider the interval of time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "50"}], 
   TraditionalForm]],ExpressionUUID->"bc09f026-2070-46fa-a948-94a2d7be2575"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "1.5"}], TraditionalForm]],ExpressionUUID->
  "953dcaef-ae5e-430c-950b-0e5beee9ee65"],
 ":"
}], "Text",
 CellChangeTimes->{{3.4669575810894184`*^9, 
  3.46695763485642*^9}},ExpressionUUID->"05052938-9b41-4e5a-a86b-\
8449a200f535"],

Cell[BoxData[
 RowBox[{"plotSoln", "[", 
  RowBox[{"1.5", ",", "0", ",", "50"}], "]"}]], "Input",
 CellChangeTimes->{{3.466957555995026*^9, 3.466957570636026*^9}},
 CellLabel->
  "In[318]:=",ExpressionUUID->"66f61044-0fac-4a6d-be5e-1c4ae068a393"],

Cell[TextData[{
 "   \nWhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{
     "time", " ", "in", " ", "tenths", " ", "of", " ", "a", " ", "second"}]}],
     ",", " ", 
    RowBox[{"50", "\[LessEqual]", "t", "\[LessEqual]", "100", " "}]}], 
   TraditionalForm]],ExpressionUUID->"3c28e07c-7078-4697-bf96-18973b82554d"],
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["10", 
       RowBox[{"-", "1"}]], " ", "sec"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"723e2fa7-e3f6-436d-a6d7-8dca5d7548b3"],
 "\n\nNext, amimate the above plot over time:"
}], "Text",
 CellChangeTimes->{{3.4669576609349604`*^9, 3.4669576794194536`*^9}, {
  3.466957742701109*^9, 
  3.466957747294888*^9}},ExpressionUUID->"5d93fbf5-144d-4db4-bbcf-\
cc33ded71695"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plotSoln", "[", 
    RowBox[{"1.5", ",", "time", ",", 
     RowBox[{"time", "+", "50"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"time", ",", "25", ",", "50"}], "}"}], ",", "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "4"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985452367185555`*^9, 3.3985452678123055`*^9}, {
  3.3986846310657024`*^9, 3.3986846679111032`*^9}},
 CellLabel->
  "In[319]:=",ExpressionUUID->"eca55c49-ac70-42e1-b267-6792c468373d"],

Cell[TextData[{
 "When the neurochemical balance within a patient's heart becomes \
sufficiently unbalanced, the heart will tend to enter a state of \
fibrillation.  This corresponds to a continued state of heart muscle \
relaxation without allowing for a sufficient interval of time to allow the \
stimulus level ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "cb8396f6-dc94-41df-9d04-377e114b5176"],
 " to decline sufficiently to produce a contraction.  In our example, this \
condition occurs for lower values of the parameter: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "\[LessEqual]", "1.029"}], TraditionalForm]],
  ExpressionUUID->"22ca2144-b107-4c80-9e45-c5f4161ea1ad"],
 ".\n\nThe following animation uses a value of the parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "\[TildeEqual]", "1.01"}], TraditionalForm]],
  ExpressionUUID->"95e2f41f-e226-48c2-b26c-387a810dad8c"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.39868550744584*^9, {3.3986857812930946`*^9, 3.398685821324857*^9}, {
   3.3986858605441093`*^9, 
   3.3986858810130987`*^9}},ExpressionUUID->"68f9123b-d99a-4e9f-a3cc-\
eaddfb4f81c0"],

Cell[TextData[{
 "   \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{
     "time", " ", "in", " ", "tenths", " ", "of", " ", "a", " ", "second"}]}],
     ",", " ", 
    RowBox[{"50", "\[LessEqual]", "t", "\[LessEqual]", "100", " "}]}], 
   TraditionalForm]],ExpressionUUID->"d58b6fe6-449a-44e3-907d-6418037203e7"]
}], "Text",ExpressionUUID->"4c158da2-e0c7-4062-9c4b-f13232fbcfd3"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plotSoln", "[", 
    RowBox[{"1.01", ",", "time", ",", 
     RowBox[{"time", "+", "50"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"time", ",", "25", ",", "50"}], "}"}], ",", "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "4"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985453239216805`*^9, 3.3985453403904305`*^9}, {
  3.3986846988968663`*^9, 3.3986847098192306`*^9}},
 CellLabel->
  "In[320]:=",ExpressionUUID->"d5033fb2-c60e-4d1e-b4a4-190c2943c44b"],

Cell["\<\
Finally, consider the following animation that allows you to adjust the \
parameter \[Alpha] dynamically.\
\>", "Text",
 CellChangeTimes->{{3.3986856105409093`*^9, 3.398685611634673*^9}, {
  3.3986858943100595`*^9, 
  3.3986859272008944`*^9}},ExpressionUUID->"69f7af21-b1a9-4de2-af09-\
11b90e214d95"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plotSoln", "[", 
    RowBox[{"\[Alpha]", ",", "time", ",", 
     RowBox[{"time", "+", "50"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"time", ",", "25", ",", "50", ",", 
     RowBox[{"AppearanceElements", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<ProgressSlider\>\"", ",", "\"\<PlayPauseButton\>\"", ",", 
        "\"\<FasterSlowerButtons\>\""}], "}"}]}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "1.033"}], "}"}], ",", "1.02", ",", "1.04", 
     ",", 
     RowBox[{"AppearanceElements", "\[Rule]", 
      RowBox[{"{", "\"\<ProgressSlider\>\"", "}"}]}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "4"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AnimationRunning", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3986847401955914`*^9, 3.3986847654467225`*^9}, {
   3.3986848369030485`*^9, 3.3986849129209633`*^9}, {3.3986850422515717`*^9, 
   3.398685094315071*^9}, {3.398685229114152*^9, 3.39868526450523*^9}, {
   3.3986852985837913`*^9, 3.398685315537133*^9}, {3.3986859434197483`*^9, 
   3.3986859471853976`*^9}, {3.3986859967482147`*^9, 3.3986859968732157`*^9}, 
   3.4669578945302052`*^9},
 CellLabel->
  "In[321]:=",ExpressionUUID->"2b7166b4-297f-458f-b26b-1bb4d703f4ac"],

Cell[TextData[{
 "Step 1: Activate the above animation by clicking the \"play\" button (keep ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", " ", "1.033"}], TraditionalForm]],ExpressionUUID->
  "56cdcc6a-de5a-472b-afef-2bb48e8668ed"],
 ").\n\tThis condition corresponds to normal heart action. Observe that \
normal heart\n\tfunction occurs over a very wide interval of the parameter \
\[Alpha].\nStep 2: While the animation is running, decrease the value of \
\[Alpha] below 1.0295.\n\tThis condition corresponds to heart fibrillation. \
Observe that fibrillation \n\toccurs over a very wide interval of the \
parameter \[Alpha].\nStep 3: While the animation is running, increase and \
decrease the value of \[Alpha]\n\tto study how heart action depends upon the \
value of \[Alpha]. Observe that\n\tthe transition between normal heart \
function and fibrillation is narrow.\nStep 4: Turn the animation off by \
clicking the \"pause\" button. Starting at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", " ", "1.0295"}], TraditionalForm]],
  ExpressionUUID->"6cb0353a-22f4-4b05-9ef1-036ac3bc31f4"],
 ",\n\tincrease the value of \[Alpha] to show that heart rate quickens (i.e. \
the time interval\n\tbetween heartbeats decreases) as the parameter \[Alpha] ",
 StyleBox["increases",
  FontVariations->{"Underline"->True}],
 " above this value.\n\tThis would occur during increased activity.\nStep 5: \
With the animation off, and starting at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", " ", "1.0295"}], TraditionalForm]],
  ExpressionUUID->"8be92493-5b3b-487f-a527-a620039f3fa0"],
 ", decrease the value of \[Alpha] \n\tto show that heart rate also quickens \
in fibrillation (i.e. the time interval \n\tbetween heartbeats decreases) as \
the parameter \[Alpha] ",
 StyleBox["decreases",
  FontVariations->{"Underline"->True}],
 " below this \n\tvalue.\nStep 6: Activate the above animation by clicking \
the \"play\" button. Assume that\n\tyour patient's heart is in fibrillation \
and set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", " ", "1.02"}], TraditionalForm]],ExpressionUUID->
  "f76e2bc0-f766-498b-b5e4-34c155e2395a"],
 ".  You respond by\n\tinjecting \[Alpha] directly into the heart muscle \
thereby increasing \[Alpha] to 1.035.\n\tSimulate this action in the above \
animation."
}], "Text",
 CellChangeTimes->{{3.398686042420382*^9, 3.39868616318678*^9}, {
  3.39868619912451*^9, 3.3986866240998197`*^9}, {3.398686656021899*^9, 
  3.3986866832408233`*^9}, {3.3986870533681917`*^9, 3.3986872900415816`*^9}, {
  3.398687353464041*^9, 3.3986873630110383`*^9}, {3.3986874103710194`*^9, 
  3.398687621670599*^9}},ExpressionUUID->"034e03db-1e0a-41fa-9452-\
c7a0ea27e923"]
}, Closed]]
}, Open  ]]
},
WindowSize->{921, 562},
WindowMargins->{{0, Automatic}, {Automatic, 0}},
Magnification:>1.5 Inherited,
FrontEndVersion->"11.3 for Microsoft Windows (64-bit) (March 6, 2018)",
StyleDefinitions->FrontEnd`FileName[{"Creative"}, "NaturalColor.nb", 
  CharacterEncoding -> "UTF-8"]
]
