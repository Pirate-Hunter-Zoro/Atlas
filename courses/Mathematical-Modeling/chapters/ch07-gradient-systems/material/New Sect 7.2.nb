Cell["\<\
Animate to see each step if your computer is fast enough (try slowing down \
the animation until your computer can keep up).\
\>", "Text",
 CellChangeTimes->{{3.3985967569903307`*^9, 3.3985967944434557`*^9}, {
  3.4669436877953153`*^9, 3.4669437192417974`*^9}, {3.466943945734496*^9, 
  3.4669439930899305`*^9}},ExpressionUUID->"3d27f802-e7ec-453b-9688-\
d0dc417c153a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Equilibrium Conditions for Both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "7d9825b9-70ca-4de5-985d-332cdfe42265"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "77f08933-0bf3-4802-a64e-cbc07a237bbb"],
 ":\n\n             Only ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "3be82ae4-94a6-4707-bf74-38e9ce706750"],
 " is Constant:\n           "
}], "Section",
 CellChangeTimes->{{3.4669445868940973`*^9, 3.4669445989402013`*^9}, {
  3.466958002327421*^9, 
  3.466958003530546*^9}},ExpressionUUID->"d04f3e54-be8d-46c6-b74c-\
bd18d4e99c94"],

Cell[TextData[{
 "Our model for a \"real\" heart is:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
    RowBox[{"\[Mu]", "(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"1fa5971f-3f6f-4d27-beb8-83b90bad1d73"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "'"}], "[", "t", "]"}], "\[Equal]", 
    FractionBox[
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "-", 
      OverscriptBox["x", "^"]}], "\[Mu]"]}], TraditionalForm]],
  ExpressionUUID->"99c82a91-4196-468f-823a-fe1d99e7f021"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", " ", "is", " ", "a", " ", "parameter"}], 
   TraditionalForm]],ExpressionUUID->"899e0eda-2b3d-4ef7-ae3d-30f22485c7b6"],
 "\n\t\nHowever, please keep in mind that the stimulus level ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "0b7c956c-f4b3-41f2-935f-eaec13823c65"],
 " is ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " constant when we use the equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "'"}], "[", "t", "]"}], "\[Equal]", 
    FractionBox[
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "-", 
      OverscriptBox["x", "^"]}], "\[Mu]"]}], TraditionalForm]],
  ExpressionUUID->"8ce28fd2-fec1-48a7-94ae-c20830701ea6"],
 "."
}], "Text",
 CellChangeTimes->{{3.466956400156394*^9, 3.466956452514764*^9}, {
  3.4669565638095016`*^9, 
  3.4669565752780313`*^9}},ExpressionUUID->"6af61f35-6e21-4814-a66c-\
7761a5808ec3"],

Cell[TextData[{
 "The two-dimensional gradient field (along with the 1 dimension \
corresponding to the parameter \[Alpha]) can be generated as follows:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", 
     FractionBox[
      RowBox[{"x", "-", 
       OverscriptBox["x", "^"]}], "\[Mu]"], ",", 
     RowBox[{"\[Mu]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], "-", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           SuperscriptBox["x", "3"], "3"], "-", 
          RowBox[{"\[Alpha]", " ", "x"}]}], ")"}]}], ")"}]}]}], "}"}], 
   TraditionalForm]],ExpressionUUID->"4da9ec02-85bf-48bd-b929-f235903686da"],
 "\n\t\n(Observe that the scaling of the vector lengths has been adjusted for \
better visibility.)\n"
}], "Text",
 CellChangeTimes->{{3.466956474201847*^9, 
  3.466956488982813*^9}},ExpressionUUID->"fbea1479-5c96-4c9f-ac44-\
35ce31d55582"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Mu]", "=", "3.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   OverscriptBox["x", "^"], "=", "1.0"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[301]:=",ExpressionUUID->"37b5d09b-ddec-4c91-a4fd-769e4d398ad4"],

Cell[BoxData[
 RowBox[{"plot3", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"VectorPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox[
        RowBox[{"x", "-", 
         OverscriptBox["x", "^"]}], "\[Mu]"], ",", 
       RowBox[{"\[Mu]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], "-", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             SuperscriptBox["x", "3"], "3"], "-", 
            RowBox[{"\[Alpha]", " ", "x"}]}], ")"}]}], ")"}]}]}], "}"}], 
     "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", 
      RowBox[{"-", "0.5"}], ",", "1.5"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Beta]", ",", 
      RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"VectorScale", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", ".2", ",", "Automatic"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"VectorPoints", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985437449373055`*^9, 3.3985437579216805`*^9}, {
   3.3985460170310555`*^9, 3.3985460654998055`*^9}, 3.3985461271091805`*^9, 
   3.3985462533435555`*^9, {3.3985472898748055`*^9, 3.3985473153279305`*^9}, {
   3.3985476668123055`*^9, 3.3985476738748055`*^9}, {3.3985478872498055`*^9, 
