(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[" Exercises 7.5", "Title",
 CellChangeTimes->{{3.3986013233340807`*^9, 
  3.3986013281778307`*^9}},ExpressionUUID->"03b62dc5-b57f-4cf5-891d-\
071cb906b453"],

Cell[TextData[{
 "7.5.3 page 182  \n(Do not use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ")\n(Also, correct minus sign ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
    RowBox[{"\[Mu]", "(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"caa4d388-3682-4cd8-8e89-1dbd53140715"],
 ")"
}], "Section",
 FontSize->18,ExpressionUUID->"508bbdc9-22a7-457d-a3ab-630c83ac289c"],

Cell[CellGroupData[{

Cell[TextData[{
 "Special case for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "1fb63825-dfa3-4717-97a4-8d6a4089de18"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "ab26ec81-94b4-4a7f-ad96-97a9222f75b2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "40b412e4-455d-4fbc-adc3-9c2522ef203f"],
 ":"
}], "Section",ExpressionUUID->"2ce973ac-d987-4045-83b4-d1d4734874fa"],

Cell[TextData[{
 "Consider a situation in which the parameter \[Alpha] is also a function of \
time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "99ffba28-9067-4117-a957-72ede1fdb1db"],
 ".  Specifically, consider the situation where the heart has essentially \
stopped beating and the initial conditions correspond to:"
}], "Text",ExpressionUUID->"8f2bdad3-c237-4952-a4ed-4db0549d3f8e"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "[", "0", "]"}], "\[Equal]", "1.0"}], TraditionalForm]],
  ExpressionUUID->"b1f72075-1b61-473c-95fd-c00a2506b2e2"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Beta]", "[", "0", "]"}], "\[Equal]", "0.56666"}], 
   TraditionalForm]],ExpressionUUID->"a4b82b99-d961-4af9-b874-1d4019304ca1"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", "[", "0", "]"}], "\[Equal]", "0.9"}], 
   TraditionalForm]],ExpressionUUID->"fefb8e2e-1172-4756-b086-15974bb75be8"]
}], "Text",ExpressionUUID->"febd7118-e6e5-4c64-aefc-1e355604b768"],

Cell[TextData[{
 "A medication is injected directly into the heart starting at time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "b49675fc-bc48-4a2e-ba2b-b8ff5dcee622"],
 ".  The purpose of this medication is to increase the level of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "94909e41-549e-4895-8a21-9a28e1fb5243"],
 " as time increases.  The rate of increase of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "c748af63-0ed4-4da5-924d-29ae47dfe1f4"],
 " is given by the following differential equation:"
}], "Text",ExpressionUUID->"d995979f-4f5d-46fb-86e8-d499d44a2f5e"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]", "'"}], "[", "t", "]"}], "\[Equal]", 
    RowBox[{".01", 
     RowBox[{"(", 
      RowBox[{"1.5", "-", 
       RowBox[{"\[Alpha]", "[", "t", "]"}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"ebc09207-a72b-43e6-a2fc-ec472ad50572"]
}], "Text",ExpressionUUID->"bc5e04d7-19c6-4b80-a30d-c7bec9006a41"],

Cell["\<\
Assume that the model for the pumping heart remains the same:\
\>", "Text",ExpressionUUID->"5d9c6e29-bddf-4356-a590-e2df4486c0cf"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", "=", "3.0"}], TraditionalForm]],ExpressionUUID->
  "687d43e1-7434-466e-becb-959c0486e5b3"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["x", "^"], "=", "1.0"}], TraditionalForm]],ExpressionUUID->
  "3311b1e8-17a6-4dd0-9159-b9fbeaca4ee5"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
    RowBox[{"\[Mu]", "(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Beta]", "[", "t", "]"}]}], "-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"x", "[", "t", "]"}], "3"], "3"], "-", 
        RowBox[{
         RowBox[{"\[Alpha]", "[", "t", "]"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], ")"}]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"f0eaaf77-6897-44b8-a88c-2c75f9c1c817"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "'"}], "[", "t", "]"}], "\[Equal]", 
    FractionBox[
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "-", 
      OverscriptBox["x", "^"]}], "\[Mu]"]}], TraditionalForm]],
  ExpressionUUID->"72dbe0bd-9d6e-4cca-a40d-1a08c2a8f22e"]
}], "Text",ExpressionUUID->"0530e673-dea6-4457-a18a-a73fa9b0a3ef"],

Cell[TextData[{
 "Then solve the above system of differential equations for:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "100"}], 
   TraditionalForm]],ExpressionUUID->"6ba9f600-916c-4bfb-8107-3642d342f5cf"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{
    "time", " ", "in", " ", "tenths", " ", "of", " ", "a", " ", "second", 
     " "}]}], TraditionalForm]],ExpressionUUID->
  "52a9666b-df8c-4080-8d10-e882bf234cf7"],
 "\nand plot the resulting solution ",
 StyleBox["parametrically",
  FontVariations->{"Underline"->True}],
 " in ",
 StyleBox["three",
  FontVariations->{"Underline"->True}],
 "-dimensional space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Alpha]", "[", "t", "]"}], ",", " ", 
       RowBox[{"\[Beta]", "[", "t", "]"}], ",", 
       RowBox[{"x", "[", "t", "]"}]}], "}"}], " ", "for", " ", "0"}], 
    "\[LessEqual]", "t", "\[LessEqual]", "100"}], TraditionalForm]],
  ExpressionUUID->"6f3e59fc-2322-42a3-8663-62bef941168a"],
 ".\n\nHint: Include the following options in your plot:\n\n\t",
 "PlotRange \[Rule] All,\n\tBoxRatios \[Rule] {1, 1, 1},\n\tAxesLabel \[Rule] \
{\"\[Alpha][t]\", \"\[Beta][t]\", \"x[t]\"},\n\tPlotStyle \[Rule] {Red, \
Thick}",
 "\n\nInterpret the meaning of the above three-dimensional plot.\n\nFinally, \
determine the approximate time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "71a11717-48e0-487f-8b28-d31c521fc9c1"],
 " at which the heart starts beating again."
}], "Text",
 CellChangeTimes->{{3.3986008552715807`*^9, 
  3.3986008636778307`*^9}},ExpressionUUID->"a2ee0f78-d864-4075-85a5-\
d55cb7334724"]
}, Closed]]
}, Open  ]]
},
WindowSize->{723, 463},
WindowMargins->{{-1, Automatic}, {Automatic, 7}},
Magnification->1.5,
FrontEndVersion->"11.3 for Microsoft Windows (64-bit) (March 6, 2018)",
StyleDefinitions->FrontEnd`FileName[{"Creative"}, "NaturalColor.nb", 
  CharacterEncoding -> "UTF-8"]
]
