Cell[TextData[StyleBox["  What happens when we displace the spring by 2 units \
(not 10)?", "Subtitle"]], "Subsection",
 CellChangeTimes->{
  3.3982897468694*^9},ExpressionUUID->"7f3dab3d-add2-43f3-98e2-336a26a8d4d4"],

Cell[BoxData[
 RowBox[{"sol2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"m", " ", 
        RowBox[{
         SuperscriptBox[
          SuperscriptBox["x", "\[Prime]",
           MultilineFunction->None], "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}]}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "k"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}], "-", 
        RowBox[{"k1", " ", 
         FractionBox[
          RowBox[{
           SuperscriptBox["x", "\[Prime]",
            MultilineFunction->None], "[", "t", "]"}], 
          RowBox[{"Abs", "[", 
           RowBox[{
            SuperscriptBox["x", "\[Prime]",
             MultilineFunction->None], "[", "t", "]"}], "]"}]]}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "2."}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "==", "0.00001"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"x", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0.", ",", 
      RowBox[{"6", " ", "\[Pi]"}]}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3982789370524*^9, 3.3982789400544*^9}, {
