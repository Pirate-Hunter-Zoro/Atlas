Cell[CellGroupData[{

Cell[TextData[StyleBox[" Validate the model:", "Subtitle"]], "Subsection",ExpressionUUID->"d3a85a4c-47d3-4ada-9302-a8f6290310f8"],

Cell["\<\
 Confidence in a model can only be achieved by proper validation with \
measured data.
\
\>", "Text",ExpressionUUID->"7ac2f6f4-aa67-446f-a10e-5015059a128e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Improve the model:", "Subtitle"]], "Subsection",ExpressionUUID->"8171d649-d475-4305-9490-403cd4d5db59"],

Cell["\<\
 The current model must be measured against our objectives, if it falls short \
of the objectives in one or more ways, then the model should be improved.\
\>", "Text",ExpressionUUID->"ec27a7eb-ff64-45f4-ab72-62c9283efc6a"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" Example 1.1 continued:   Improve the model", "Section",ExpressionUUID->"6955d5de-6cd4-4195-ac9b-6ef94e1985ca"],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" State the new objective:", "Subtitle"]], "Subsection",
 CellChangeTimes->{
  3.3982846836694*^9},ExpressionUUID->"30726b06-aa96-4198-b996-d2e903d02dc5"],

Cell[TextData[{
 "Experiments were performed on our problem.  It was observed that our spring \
is not an ideal spring.  Specifically, our spring is one that loses its \
restoring force as x increases.  One possible formula that captures this \
specific behavior is:  \n\n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"restoring", " ", "force"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", "k"}], " ", "x"}], " ", "+", " ", 
     RowBox[{"a", " ", 
      SuperscriptBox["x", "3"]}]}]}], TraditionalForm]],ExpressionUUID->
  "5d540f24-6ee5-4a48-883e-565b93d5c3dd"],
 "\n\t "
}], "Text",
 CellChangeTimes->{{3.3982776618314*^9, 3.3982776844524*^9}, {
  3.3982777304844*^9, 
  3.3982777464684*^9}},ExpressionUUID->"77168ba5-68ae-47d3-a0ac-92a29cc08b8d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Restate the problem:", "Subtitle"]], "Subsection",
 CellChangeTimes->{
  3.3982846873684*^9},ExpressionUUID->"b5062aa6-64ce-4061-86d4-a562b995ca8b"],

Cell[TextData[{
 StyleBox["In this example we will consider a loss of the spring's restoring \
force.  \n\n\tThe equation becomes:        mx'' = - k*x + a ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "3"], "Subsubsection"], TraditionalForm]],
  ExpressionUUID->"1d0d6415-fd9a-4621-944e-475aae3f275b"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.3982777341684*^9, 
  3.3982777484983997`*^9}},ExpressionUUID->"cbadb8f4-6e26-4050-a68a-\
d62160aea4e2"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Solve the new problem:", "Subtitle"]], "Subsection",ExpressionUUID->"f6b7eab9-f838-4511-a11a-1e9bae3a43db"],

Cell["First, look at the symbolic solution:", "Text",ExpressionUUID->"1725169a-3dca-49e3-b50b-5623509cffc2"],

Cell[BoxData[
 RowBox[{"sol1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{
       SuperscriptBox[
        SuperscriptBox["x", "\[Prime]",
         MultilineFunction->None], "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "==", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "k"}], " ", 
       RowBox[{"x", "[", "t", "]"}]}], "+", 
      RowBox[{"a", " ", 
       SuperscriptBox[
        RowBox[{"x", "[", "t", "]"}], "3"]}]}]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"x", "[", "t", "]"}], ",", "\[IndentingNewLine]", "t"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982894495034*^9, 3.3982894496703997`*^9}},
 CellLabel->
  "In[117]:=",ExpressionUUID->"07b7f538-53b8-46a2-b38f-57d7ce1d8728"],

Cell["\<\
 Although the above replacement rules represent the solution to our new \
problem, it may be very hard to visualize what is happening.

Therefore, choose some specific values for our operating conditions and \
calculate a numerical solution:\
\>", "Text",ExpressionUUID->"111bfe91-b071-4df4-ba2c-bbcc052717fe"],

Cell[BoxData[
 RowBox[{"sol1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{
         SuperscriptBox[
          SuperscriptBox["x", "\[Prime]",
           MultilineFunction->None], "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}]}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}], "+", 
        RowBox[{"1", " ", 
         SuperscriptBox[
          RowBox[{"x", "[", "t", "]"}], "3"]}]}]}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "==", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"x", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3982777941514*^9, 3.3982778018304*^9}, {
  3.3982894569894*^9, 3.3982894631493998`*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"f2cc2775-2407-46b7-8cd6-9ec2f4fba206"],

Cell["\<\
 The above numerical solution is given as a replacement rule and \
interpolating function.

Extract the new solution:\
\>", "Text",ExpressionUUID->"ba5190f9-5903-4ab8-be43-ff8b28b1de8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newX", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], " ", "/.", "sol1"}]}]], "InputOnly",
 CellChangeTimes->{3.7481038866009846`*^9},
 CellLabel->
  "In[120]:=",ExpressionUUID->"ecf47300-04e7-40f1-a4de-97d0e0bb27c7"],

Cell[" Plot the new solution:", "Text",ExpressionUUID->"87f4002a-b59c-4dca-93cf-a9a5fb3f4fd3"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"newX", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".01", "]"}], "}"}]}]}], "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{3.3982778165344*^9},
 CellLabel->
  "In[121]:=",ExpressionUUID->"5c7d45f1-e024-43c0-aa84-4e02359d5ae1"],

Cell["\<\
 It would be possible to further analyze the above problem using different \
values for the system parameters.\
\>", "Text",ExpressionUUID->"2ea73bf5-96e2-46ad-a5e5-99a760adeeac"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" Example 1.2   Improve the model:", "Section",ExpressionUUID->"f3b9a4e8-54b5-422a-9a31-e80b7663f749"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  State the new objective:", "Subtitle"]], \
"Subsection",ExpressionUUID->"b2457ae4-54c0-4a72-a0ab-e8b669c37386"],

Cell["\<\
 Experiments were performed on our problem.   It was observed that friction \
between the mass and the table top significantly contributed to the dynamics \
of the problem.  Thus, our list of important factors must be augmented to \
include dry friction  (Coulomb friction).  Our objective is to find a simple, \
approximate description of the dynamic behavior of the spring-mass system \
with dry friction.  No emphasis at this point is placed on other physical \
behaviors.\
\>", "Text",ExpressionUUID->"4cc9e11b-59ae-414a-a4e9-83f88b85776e"],

Cell["\<\
 Experiments and study of dry friction are required before the modeling \
process can continue.\
\>", "Text",ExpressionUUID->"6103084d-2ee3-4670-9aad-1e9f8a64544b"],

Cell[" Understand the new problem:", "Text",ExpressionUUID->"c6a69b48-67c9-4636-9207-7802a1416558"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Restate the problem:", "Subtitle"]], "Subsection",ExpressionUUID->"c5ccd84d-57a1-487d-9f23-996265a7de49"],

Cell[TextData[{
 StyleBox[" In this example we will consider frictional forces.  \
Specifically, we will consider dry friction.\nFor dry friction, the \
frictional force is approximately constant and in the direction opposite to \
the motion (  - x ' [t]).\n\n\t\tThe equation becomes:        ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"mx", "''"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", "k"}], "*", "x"}], " ", "-", " ", 
     RowBox[{"k1", "*", 
      FractionBox[
       RowBox[{
        SuperscriptBox["x", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], 
       RowBox[{"Abs", "[", 
        RowBox[{
         SuperscriptBox["x", "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}], "]"}]]}]}]}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "c689fb32-1568-4f92-ae09-a32f5bc008e5"],
 StyleBox["\n", "Subsubsection"]
}], "Text",
 CellChangeTimes->{{3.3982779960383997`*^9, 3.3982780004723997`*^9}, {
  3.7481043590562253`*^9, 
  3.7481043718014994`*^9}},ExpressionUUID->"7c622e51-6d01-47b0-b4d7-\
61e5c9646287"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  What happens when we displace the spring by 10 \
units?\n  Consider some sample values for the constants in the equation.", \
"Subtitle"]], "Subsection",
 CellChangeTimes->{{3.3982897038634*^9, 
  3.3982897064304*^9}},ExpressionUUID->"ce677e9c-5f22-42e4-a73d-20298bce27b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "=", "1.3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k1", "=", "1."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "1."}], ";"}]}], "InputOnly",
 CellLabel->
  "In[122]:=",ExpressionUUID->"a67783c5-82e0-4334-9c14-f0b2f6a6487e"]
}, Closed]],

