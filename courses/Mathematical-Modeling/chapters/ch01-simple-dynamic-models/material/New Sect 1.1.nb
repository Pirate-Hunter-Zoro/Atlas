Cell[CellGroupData[{

Cell[" Dynamic Visualization:", "Subsubsection",
 CellChangeTimes->{{3.463757243042723*^9, 
  3.463757245183307*^9}},ExpressionUUID->"5f788913-3695-4902-b490-\
7e61e37a5e64"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], "/.", 
        RowBox[{"Flatten", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"m", " ", 
             RowBox[{
              SuperscriptBox[
               SuperscriptBox["x", "\[Prime]",
                MultilineFunction->None], "\[Prime]",
               MultilineFunction->None], "[", "t", "]"}]}], "==", 
            RowBox[{
             RowBox[{"-", "k"}], " ", 
             RowBox[{"x", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"x", "[", "t", "]"}], ",", "\[IndentingNewLine]", "t"}], 
          "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"C", "[", "1", "]"}], "\[Rule]", " ", "0"}], ",", 
         RowBox[{
          RowBox[{"C", "[", "2", "]"}], "\[Rule]", " ", "1"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "\[Rule]", 
