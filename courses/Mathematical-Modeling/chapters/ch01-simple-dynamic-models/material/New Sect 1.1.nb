Cell[CellGroupData[{

Cell[" Example 1.3  Vertical mass-spring system", "Section",ExpressionUUID->"ae016416-8bf7-4809-9575-7e571955b7e4"],

Cell[TextData[StyleBox["Consider the example of a mass on the end of a \
vertical spring.  The forces acting on the mass include the restoring force \
of the spring, vicious friction (which will be assumed to be proportional to \
the velocity) and the downward force of gravity.\n\n\tThe equation becomes:   \
      m*y''[t]\[Equal] - k*y[t] - k1*y'[t] - m*g\n", "Subsubsection"]], "Text",
 CellChangeTimes->{
  3.3982790880573997`*^9, {3.3982807195053997`*^9, 3.3982808145494003`*^9}, 
   3.3982810485304003`*^9},ExpressionUUID->"f7983e4c-3495-4f73-b8f4-\
43194ea1c8c7"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Polygon", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], "]"}], 
       "\[IndentingNewLine]", "}"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{".5", 
          RowBox[{"Cos", "[", 
           RowBox[{"50", "t"}], "]"}]}], ",", 
         RowBox[{".5", 
          RowBox[{"Sin", "[", 
           RowBox[{"50", "t"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "6"}], "+", 
            RowBox[{".5", 
             RowBox[{"Sin", "[", "spring", " ", "]"}]}]}], ")"}], " ", 
          "t"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
       RowBox[{"PlotPoints", "\[Rule]", "40"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Thickness", "[", "0.01", "]"}], "}"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"Sphere", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          RowBox[{
           RowBox[{"-", "6"}], "+", 
           RowBox[{".5", 
            RowBox[{"Sin", "[", "spring", " ", "]"}]}]}]}], "}"}], ",", "1"}],
        "]"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "7.3"}], ",", "0"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Boxed", "\[Rule]", "False"}]}], "\[IndentingNewLine]", "]"}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"spring", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3908618795422*^9, 3.3908619859982*^9}, {
   3.3908620465682*^9, 3.3908620589362*^9}, {3.3908621085692*^9, 
   3.3908621154652*^9}, {3.3908622984392*^9, 3.3908623225892*^9}, {
   3.3908623527712*^9, 3.3908623571082*^9}, {3.3908624397752*^9, 
