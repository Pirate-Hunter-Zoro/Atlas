Cell[TextData[{
 "Look ",
 StyleBox["very",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " carefully at the above dynamic process.\n\nWhat additional influences ",
 StyleBox["could",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " be included in our assumptions for the above dynamic process?\n\n",
 StyleBox["Where",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " do we draw the line on what influence should and should not be included?\n"
}], "Text",
 CellChangeTimes->{{3.3982808428914003`*^9, 3.3982809190044003`*^9}, {
  3.3982811116893997`*^9, 
  3.3982812205434*^9}},ExpressionUUID->"ce589429-d112-4aea-91db-5c3360af6bc2"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Find an analytic solution to this equation:", \
"Subsubsection"]], "Subsection",ExpressionUUID->"8e81d4ac-cc09-4899-b9c5-\
7406d497e0df"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], "  "}]], "InputOnly",
 CellLabel->
  "In[184]:=",ExpressionUUID->"3f91ccab-f9d8-46dd-9268-dd0bffd49caa"],

Cell[BoxData[
 RowBox[{"sol4", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{
       SuperscriptBox[
        SuperscriptBox["y", "\[Prime]",
         MultilineFunction->None], "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "==", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "k"}], " ", 
       RowBox[{"y", "[", "t", "]"}]}], "-", 
      RowBox[{"k1", " ", 
       RowBox[{
        SuperscriptBox["y", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], "-", 
      RowBox[{"m", " ", "g"}]}]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"y", "[", "t", "]"}], ",", "\[IndentingNewLine]", "t"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982895547964*^9, 3.3982895549434*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"f5a1a944-16f0-40f3-a87c-26b7602b4940"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 " ",
 StyleBox[" Consider some typical values for the constants", "Subsubsection"]
}], "Subsection",ExpressionUUID->"968e32f5-49c8-4c01-86c9-b73f761d2c28"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", 
    RowBox[{"13", "/", "10"}]}], ";"}], "   ", 
  RowBox[{"(*", "  ", 
   RowBox[{"i", ".", "e", ".", "  ", "1.3"}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"k1", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "=", 
    RowBox[{"98", "/", "10"}]}], ";"}], "   ", 
  RowBox[{"(*", "  ", 
   RowBox[{"i", ".", "e", ".", "  ", "9.8"}], "  ", "*)"}]}]}], "InputOnly",
 CellLabel->
  "In[187]:=",ExpressionUUID->"fea86449-ec71-42f1-878f-7b220244b125"],

Cell["\<\
 Displace the spring by  +2 units (i.e. compress the spring by 2 units) and \
let go with  0  velocity:\
\>", "Text",ExpressionUUID->"04ef7d94-350a-4d51-906f-dd623c2d07a5"],

Cell[BoxData[
 RowBox[{"sol4", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"m", " ", 
        RowBox[{
         SuperscriptBox[
          SuperscriptBox["y", "\[Prime]",
           MultilineFunction->None], "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}]}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "k"}], " ", 
         RowBox[{"y", "[", "t", "]"}]}], "-", 
        RowBox[{"k1", " ", 
         RowBox[{
          SuperscriptBox["y", "\[Prime]",
           MultilineFunction->None], "[", "t", "]"}]}], "-", 
        RowBox[{"m", " ", "g"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "2"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["y", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "==", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"y", "[", "t", "]"}], ",", "\[IndentingNewLine]", "t"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982895603803997`*^9, 3.3982895840864*^9}},
 CellLabel->
  "In[191]:=",ExpressionUUID->"b5957403-034e-4029-8e7f-3b8b0bb473fe"],

Cell["\<\
  The above solution was calculated using rational rather than real numbers.

  However, if you want the approximate real solution it can be obtained as:\
\>", "Text",ExpressionUUID->"818ebe16-bdec-4946-93cc-4d18556dad61"],

Cell[BoxData[
 RowBox[{"N", "[", "sol4", "]"}]], "Input",
 CellLabel->
  "In[192]:=",ExpressionUUID->"60b08b44-71e8-43f4-8a07-972e004f6f21"],

Cell["\<\
 
 Extract the solution from the replacement rule as a formula:\
\>", "Text",ExpressionUUID->"5d06b472-14f6-4701-a0a4-c07cda1707bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"y4", "[", "t_", "]"}], "=", " ", 
  RowBox[{
   RowBox[{"y", "[", "t", "]"}], " ", "/.", " ", "sol4"}]}]], "Input",
 CellLabel->
  "In[193]:=",ExpressionUUID->"ef614471-ab46-47a5-9653-bfa347d5b0f5"],

Cell[" Plot the solution over an appropriate range of  t:", "Text",ExpressionUUID->"b746cf3d-05f7-4023-9cbe-392749f4d25f"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"y4", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", 
     RowBox[{"8", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "10"}], ",", "2"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellLabel->
  "In[194]:=",ExpressionUUID->"4ce0bbee-177e-4586-af09-e0597f0321e9"],

Cell["\<\
 Notice that the rest position for the mass is at negative 7.5 units ( i.e. \
the spring is stretched 7.5 units) (approximately).
 This behavior is expected for a vertical spring in a gravitational field.
 
We can further study the rest position for the mass by assigning both the \
acceleration and velocity to 0 in the force balance equation:\
\>", "Text",
 CellChangeTimes->{{3.3982813007414*^9, 
  3.3982813030914*^9}},ExpressionUUID->"9fc29017-7010-43ab-91d3-e12b3c076c28"],

Cell[BoxData[
 RowBox[{"restSolution", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"m", "\[Times]", "0"}], "==", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "k"}], " ", 
       RowBox[{"y", "[", "t", "]"}]}], "-", 
      RowBox[{"k1", "\[Times]", "0"}], "-", 
      RowBox[{"m", " ", "g"}]}]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"y", "[", "t", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982813295313997`*^9, 3.3982813375424*^9}, {
  3.3982895920864*^9, 3.3982895922754*^9}},
 CellLabel->
  "In[195]:=",ExpressionUUID->"d25703dc-a017-44ac-aaa2-08e8d46c5eb7"],

Cell[BoxData[
 RowBox[{"N", "[", "restSolution", "]"}]], "Input",
 CellLabel->
  "In[196]:=",ExpressionUUID->"c69cd6d7-5087-4012-8a76-bc39cd4ee4a6"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" Example 1.4   Simple pendulum problem", "Section",ExpressionUUID->"89f4a0c5-fa2c-4ea1-ae83-30aed6fb6a32"],

Cell["\<\
 A simple and historically important example of a non linear ODE is the \
pendulum problem.
The pendulum consist of a small bob of mass m attached to a slim, rigid \
massless rod of length l, which is connected to a pivot.  Thus, the motion of \
the mass will be restricted to a circular arc about the pivot as its center.  \
When the pendulum is displaced from a rest point the forces acting on the \
mass will be the force of gravity and a force of viscous damping.  For this \
discussion we will assume that the viscous damping will correspond to laminar \
flow which will generate a force opposite to the motion of the mass and \
proportional to the velocity (to the first power).
Because the rigid motion is restricted to be in a circular arc, then it is \
reasonable to express the position (arc length) as a function of a parameter \
(angle  \[Theta]).\
\>", "Text",
 CellChangeTimes->{
  3.3982826984634*^9},ExpressionUUID->"650ae277-3c31-49cb-ba1f-9633d81a5c41"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"t3", "=", 
     RowBox[{".2", 
      RowBox[{"Sin", "[", "t2", "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Cylinder", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"5", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Sin", "[", "t3", "]"}], ",", "0", ",", 
               RowBox[{"-", 
                RowBox[{"Cos", "[", "t3", "]"}]}]}], "}"}]}]}], "}"}], ",", 
          ".1"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Sphere", "[", 
         RowBox[{
          RowBox[{"5", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sin", "[", "t3", "]"}], ",", "0", ",", 
             RowBox[{"-", 
              RowBox[{"Cos", "[", "t3", "]"}]}]}], "}"}]}], ",", ".5"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "6"}], ",", "0"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Boxed", "\[Rule]", "False"}]}], "\[IndentingNewLine]", "]"}]}],
    ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t2", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "2"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3982819176454*^9, 3.3982820687444*^9}, {
   3.3982820999393997`*^9, 3.3982821864604*^9}, {3.3982822281324*^9, 
   3.3982823401344*^9}, {3.3982824400954*^9, 3.3982824558584003`*^9}, {
   3.3982824963864*^9, 3.3982825672743998`*^9}, 3.3982826207084*^9, {
   3.3982832614484*^9, 3.3982832752474003`*^9}, {3.3986769494337225`*^9, 
   3.398676956855645*^9}},
 CellLabel->
  "In[197]:=",ExpressionUUID->"a93bc024-aa26-4b2a-a88c-ff209e42f5d0"],

Cell[TextData[{
 "Look ",
 StyleBox["very",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " carefully at the above dynamic process.\n\nWhat additional influences ",
 StyleBox["could",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " be included in our assumptions for the above dynamic process?\n\n",
 StyleBox["Where",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " do we draw the line on what influence should and should not be included?\n"
}], "Text",
 CellChangeTimes->{{3.3982808428914003`*^9, 3.3982809190044003`*^9}, {
  3.3982811116893997`*^9, 
  3.3982812205434*^9}},ExpressionUUID->"12ec7370-d9c0-4194-b059-a54fe80552af"],

Cell[TextData[{
 "\nUnder the assumptions making up our model:\n\nThe ODE is generated as a \
force balance on the mass:\n\n\ts[t] = L*\[Theta] [t]\n\ts'[t] = L*\[Theta] \
'[t]\n\ts''[t] = L*\[Theta] ''[t]\n\tm*a[t] = - k1*v[t]  - \
m*g*Sin[\[Theta][t]]\n\n\tm*L*\[Theta]''[t] = - k1*L*\[Theta]'[t] - m*g*Sin[\
\[Theta][t]]\n\n\t\[Theta]''[t] = -",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{" ", "k1"}], "m"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "f9bdea19-21cf-4cf2-b936-4768a3cc5a63"],
 "*\[Theta]'[t] - ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["g", "L"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "1f0aacba-ff7f-435b-9675-6b855be7e6d8"],
 "*Sin[\[Theta][t]]\t\n\t\nObserve that the above equation is nonlinear in \
the variable \[Theta].\nTherefore, we do not expect a simple closed form for \
the solution.\n \nBecause our pendulum problem includes damping, then the \
pendulum will eventually come to rest at an equilibrium point.  The angles \
\[Theta] corresponding to equilibrium occur when both the velocity and the \
acceleration are 0. \nSearch for the rest points for this system by \
substituting \[Theta] ' = 0 and \[Theta] '' = 0 into the force balance \
equation:"
}], "Text",
 CellChangeTimes->{{3.3982826984634*^9, 3.3982827150174*^9}, {
  3.3982827733494*^9, 
  3.3982828199894*^9}},ExpressionUUID->"38f2b4b0-f5da-4532-9830-0e7f3c312bfd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", " ", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"0", " ", "==", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FormBox[
        StyleBox[
         FractionBox[
          RowBox[{" ", "k1"}], "m"],
         FontWeight->"Bold"],
        TraditionalForm]}], "*", "0"}], " ", "-", " ", 
     RowBox[{
      FormBox[
       StyleBox[
        FractionBox["g", "L"],
        FontWeight->"Bold"],
       TraditionalForm], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}]}], ",", "     ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Sin", "[", 
    RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.3982828285364*^9, 3.3982828467974*^9}, {
   3.3982830940334*^9, 3.3982831240573997`*^9}, 3.3982839691644*^9},
 CellLabel->
  "In[198]:=",ExpressionUUID->"c0b33283-e9ec-4cb9-8a70-58a50e5d1efa"],

Cell[TextData[{
 " The above solution indicates that:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"\[Theta]", "[", "t", "]"}], "]"}], "\[Rule]", "0"}], 
   TraditionalForm]],ExpressionUUID->"83fb8d3c-efa5-49e6-9416-1bd62cb31059"],
 " at the rest points.\n\n  If we solve for the corresponding angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "c08242e3-16f8-451a-81dd-b300e3324e55"],
 ", we get:"
}], "Text",
 CellChangeTimes->{{3.3982813812014*^9, 
  3.3982813886604*^9}},ExpressionUUID->"2b76eeed-c9c8-467d-83bb-47dc51e70558"],

Cell[BoxData[
 RowBox[{"Solve", "[", "     ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"0", " ", "==", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FormBox[
        StyleBox[
         FractionBox[
          RowBox[{" ", "k1"}], "m"],
         FontWeight->"Bold"],
        TraditionalForm]}], "*", "0"}], " ", "-", " ", 
     RowBox[{
      FormBox[
       StyleBox[
        FractionBox["g", "L"],
        FontWeight->"Bold"],
       TraditionalForm], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}]}], ",", "    ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"\[Theta]", "[", "t", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982831128304*^9, 3.3982831356724*^9}},
 CellLabel->
  "In[200]:=",ExpressionUUID->"6415c78b-28b7-44b9-b682-89b1b73ddd2b"],

Cell[TextData[{
 " Remember, that the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command \"Solve\" is for algebraic equations only.  Therefore, it is \
unlikely that it will find all of the angles \[Theta] that correspond to the \
trigonometric solutions.  Note that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " did find the rest angles corresponding to \[Theta]  = \[Pi], -\[Pi], \
2\[Pi], -2\[Pi], ...\n\n Also, because the ODE is nonlinear, we do not expect \
a simple close form of the analytic solution if we attempt to evaluate:\n \n \
\t",
 Cell[BoxData[
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "'"}], "'"}], "[", "t", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FormBox[
         StyleBox[
          FractionBox[
           RowBox[{" ", "k1"}], "m"],
          FontWeight->"Bold"],
         TraditionalForm]}], "*", 
       RowBox[{
        RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}], " ", "-", " ", 
      RowBox[{
       FormBox[
        StyleBox[
         FractionBox["g", "L"],
         FontWeight->"Bold"],
        TraditionalForm], "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}]}], ",", 
    RowBox[{"\[Theta]", "[", "t", "]"}], ",", "t"}], "]"}]],
  FontWeight->"Bold",ExpressionUUID->"110680b1-0d4d-4028-8230-d9287c5c8c77"],
 "\n \t\n In fact, no such solution exists.\n \n Therefore, consider some \
numerical solutions:"
}], "Text",
 CellChangeTimes->{{3.748106039192222*^9, 
  3.7481060397832813`*^9}},ExpressionUUID->"93ed6c4e-1167-4e0e-b490-\
4b6cf8a09007"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"k1", "=", ".8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", "   ", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "   ", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "   ", "=", "9.8"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[201]:=",ExpressionUUID->"bf56d18f-527e-41bb-9b6a-087cc6ade3d2"],

Cell["\<\
 Displace the pendulum by setting the angle  \[Theta]  =  .8  radians and let \
go with 0 angular velocity:\
\>", "Text",ExpressionUUID->"f0ea92cf-c7e7-43b2-b2df-353237f62b45"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["\[Theta]", "\[Prime]",
          MultilineFunction->None], "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"k1", " ", 
           RowBox[{
            SuperscriptBox["\[Theta]", "\[Prime]",
             MultilineFunction->None], "[", "t", "]"}]}], "m"]}], "-", 
        FractionBox[
         RowBox[{"g", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], "L"]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Theta]", "[", "0", "]"}], "==", ".8"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "==", "0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Theta]", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "12"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3982848660914*^9, 3.3982848694944*^9}, {
  3.3982849289084*^9, 3.3982849291184*^9}, {3.3982896087944*^9, 
  3.3982896147764*^9}},
 CellLabel->
  "In[205]:=",ExpressionUUID->"dad4ae75-0a3b-49f6-ba62-c6c909610047"],

Cell["\<\
 
 Extract the solution from the replacement rule as an interpolating function:\
\>", "Text",ExpressionUUID->"a10ca98b-369a-469f-99fa-bc1f160e84e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]5", "[", "t_", "]"}], "=", " ", 
  RowBox[{
   RowBox[{"\[Theta]", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"solutionRule", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[206]:=",ExpressionUUID->"566067ac-7802-4fb1-b4e9-ca992f5c3bdb"],

Cell[" Plot the solution \[Theta][t] over an appropriate range of  t:", "Text",ExpressionUUID->"399bf4f5-4bd2-450f-a5e8-f8a9cb06f715"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Theta]5", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{3.3982849405394*^9},
 CellLabel->
  "In[207]:=",ExpressionUUID->"078f2cb9-5c67-4e88-a2b3-c56d254a9608"],

Cell["\<\
 The above graph of angle vs. time may not be the best way to visualize the \
motion of the pendulum.

 Therefore, construct a Module which will animate the motion of the pendulum:\
\>", "Text",ExpressionUUID->"1c4df0ce-8155-4dc5-baf9-1d1356729031"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pendulum", "[", 
   RowBox[{"\[Theta]_", ",", "L_"}], "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "xyPoint", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xyPoint", "=", 
      RowBox[{"L", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"3", " ", "\[Pi]"}], "2"], "+", "\[Theta]"}], "]"}], ",", 
         RowBox[{"Sin", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"3", " ", "\[Pi]"}], "2"], "+", "\[Theta]"}], "]"}]}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", ".01", "]"}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}], ",", "xyPoint"}], "}"}], "]"}], 
          ",", 
          RowBox[{"PointSize", "[", ".05", "]"}], ",", 
          RowBox[{"Point", "[", "xyPoint", "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"Axes", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"True", ",", "False"}], "}"}]}], ",", 
       RowBox[{"Ticks", "\[Rule]", "None"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1.05"}], " ", "L"}], ",", 
            RowBox[{"1.05", " ", "L"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1.05"}], " ", "L"}], ",", 
            RowBox[{"1.05", " ", "L"}]}], "}"}]}], "}"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellLabel->
  "In[208]:=",ExpressionUUID->"e2b825e8-c611-48ec-aa21-e261c7ca4e69"],

Cell["\<\
 Display the graph for one angle corresponding to our initial condition of \
\[Theta]5[0] = .8 radians:\
\>", "Text",ExpressionUUID->"46ab9683-d7d6-457f-ac60-f03e504964d0"],

Cell[BoxData[
 RowBox[{"pendulum", " ", "[", 
  RowBox[{
   RowBox[{"\[Theta]5", "[", "0", "]"}], ",", " ", "L"}], " ", "]"}]], "Input",
 CellLabel->
  "In[209]:=",ExpressionUUID->"927b3b7b-149f-4a93-8062-56a27c586fcf"],

Cell[" Display our solution from  t = 0  to  t = 12:", "Text",
 CellChangeTimes->{{3.3982849666734*^9, 
  3.3982849724814*^9}},ExpressionUUID->"ebb481e2-a036-424f-ac4b-da8aac22103e"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"pendulum", " ", "[", 
    RowBox[{
     RowBox[{"\[Theta]5", "[", "t", "]"}], ",", " ", "L"}], " ", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "12"}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"DefaultDuration", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982849854484*^9, 3.3982850134604*^9}, {
  3.398676984215195*^9, 3.398676995543393*^9}},
 CellLabel->
  "In[210]:=",ExpressionUUID->"7f98528d-045f-478c-aa2a-9a66bf26cb56"],

Cell["\<\
You can slow down or speed up the above animation by using the  \"\[And]\"  \
and  \"\[Or]\"  arrows located at the upper right margin of this window.\
\>", "Text",
 CellChangeTimes->{{3.3982844708984003`*^9, 
  3.3982845207344*^9}},ExpressionUUID->"660df7ad-9245-47b9-aeb7-16c7919a46d5"],

Cell["\<\
 ____________________________________________________________________

Next, displaced the pendulum by setting the initial angle  \[Theta]  =  .8  \
radians and set it in motion with an angular velocity of 11.5 radians/sec:\
\>", "Text",
 CellChangeTimes->{{3.3982850818894*^9, 
  3.3982850913254004`*^9}},ExpressionUUID->"b01e2c1c-3875-49aa-b276-\
a775a52ca720"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["\[Theta]", "\[Prime]",
          MultilineFunction->None], "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"k1", " ", 
           RowBox[{
            SuperscriptBox["\[Theta]", "\[Prime]",
             MultilineFunction->None], "[", "t", "]"}]}], "m"]}], "-", 
        FractionBox[
         RowBox[{"g", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], "L"]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Theta]", "[", "0", "]"}], "==", ".8"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]", "\[Prime]",
         MultilineFunction->None], "[", "0", "]"}], "==", "11.5"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Theta]", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "12"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.3982842961694*^9, {3.3982848055973997`*^9, 3.3982848095744*^9}, {
   3.3982896270754004`*^9, 3.3982896328814*^9}},
 CellLabel->
  "In[211]:=",ExpressionUUID->"545149bb-9c74-4900-aade-0178f4415685"],

Cell["\<\
 
 Extract the solution from the replacement rule as an interpolating function:\
\>", "Text",ExpressionUUID->"5ca9a9b9-7633-42a6-b0b8-1b956632b712"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]6", "[", "t_", "]"}], "=", " ", 
  RowBox[{
   RowBox[{"\[Theta]", "[", "t", "]"}], " ", "/.", 
   RowBox[{"solutionRule", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[212]:=",ExpressionUUID->"4d67193b-8e3e-43c8-9e2f-3a3cd1b467ec"],

Cell[" Plot the solution over an appropriate range of  t:", "Text",ExpressionUUID->"1be5ae85-fc40-406c-a4f3-8e7c0e2293df"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Theta]6", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "Automatic"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".01", "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{3.3982842840014*^9},
 CellLabel->
  "In[213]:=",ExpressionUUID->"6ff4952d-608f-4c68-9e29-a239a4b5b0c3"],

Cell["\<\
 The above graph of angle vs. time may not be the best way to visualize the \
motion of the pendulum.

  Display our solution from  t = 0  to  t = 12:\
\>", "Text",
 CellChangeTimes->{3.3982841732584*^9, 
  3.3982843124344*^9},ExpressionUUID->"245d1cb3-ab54-4831-b7ca-01d08bc45e6e"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pendulum", " ", "[", 
     RowBox[{
      RowBox[{"\[Theta]6", "[", "t", "]"}], ",", " ", "L"}], " ", "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", ",", " ", "12"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"DefaultDuration", "\[Rule]", "12"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982840530254*^9, 3.3982840693104*^9}, {
   3.3982841888283997`*^9, 3.3982842379904003`*^9}, 3.3982843157824*^9, {
   3.3982844081563997`*^9, 3.3982844227334003`*^9}, {3.3986770223873143`*^9, 
   3.3986770678719807`*^9}},
 CellLabel->
  "In[214]:=",ExpressionUUID->"607ea9b9-def9-42dd-b6ac-47bb9428fb85"],

Cell["\<\
You can slow down or speed up the above animation by using the  \"\[And]\"  \
