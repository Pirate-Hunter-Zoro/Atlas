eaf814aed3d7"],

Cell[BoxData[
 RowBox[{"TimeConstrained", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"m", " ", 
         RowBox[{
          SuperscriptBox[
           SuperscriptBox["x", "\[Prime]",
            MultilineFunction->None], "\[Prime]",
           MultilineFunction->None], "[", "t", "]"}]}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "k"}], " ", 
          RowBox[{"x", "[", "t", "]"}]}], "-", 
         RowBox[{"k1", " ", 
          FractionBox[
           RowBox[{
            SuperscriptBox["x", "\[Prime]",
             MultilineFunction->None], "[", "t", "]"}], 
           RowBox[{"Abs", "[", 
            RowBox[{
             SuperscriptBox["x", "\[Prime]",
              MultilineFunction->None], "[", "t", "]"}], "]"}]]}]}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "10"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         SuperscriptBox["x", "\[Prime]",
          MultilineFunction->None], "[", "0", "]"}], "==", "0"}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"x", "[", "t", "]"}], ",", "\[IndentingNewLine]", "t"}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", ",", "10", ",", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
     "\"\<\\nDSolve[  ...  ] was unable to find a symbolic solution after 10 \
sec.\>\"", ",", "Red", ",", "Bold"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
