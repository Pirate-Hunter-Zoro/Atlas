   3.3982805473924*^9, 3.3982805482964*^9}, {3.3982806023304*^9, 
   3.3982806051884003`*^9}, {3.3982810726754*^9, 3.3982810745243998`*^9}, {
   3.3982838763024*^9, 3.3982838831594*^9}, {3.398676916839764*^9, 
   3.3986769194022803`*^9}},
 CellLabel->
