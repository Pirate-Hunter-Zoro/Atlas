  3.463756396558976*^9, 3.463756440214388*^9}, {3.463756471260667*^9, 
  3.463756479807378*^9}, {3.4637565369469056`*^9, 3.4637565392593613`*^9}, {
  3.4637565714462433`*^9, 3.463756778332896*^9}, {3.463756841503558*^9, 
  3.463756853128335*^9}, {3.4637568940650487`*^9, 3.4637569137521706`*^9}, {
  3.463757096233042*^9, 3.4637571463727045`*^9}},
