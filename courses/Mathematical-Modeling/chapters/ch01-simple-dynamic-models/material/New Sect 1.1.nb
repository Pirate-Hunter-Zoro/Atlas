Cell[CellGroupData[{

Cell[" Example 1.1", "Section",ExpressionUUID->"c2590412-c2e6-421a-953f-3c9b96a2cac9"],

Cell[TextData[{
 StyleBox["Example 1.1\tConsider a body of mass m lying on a very smooth \
table (along the x axis).  It is attached to a spring that is attached to the \
wall.  The rest position for the mass-spring system is at x = 0. ", 
  "Subsubsection"],
 "\n\n ",
 StyleBox[" \t\tSee Fig. 1.1 on page 5\n", "Subsubsection"]
}], "Text",
 CellChangeTimes->{
  3.3908618527632*^9, {3.3908685514952*^9, 3.3908685578092003`*^9}},
 TextAlignment->Left,
 TextJustification->0,ExpressionUUID->"9c8c94dd-80ef-46a5-ac4b-650dabdfde1d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tMax", "=", "60"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"springThick0", "=", ".1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spring", "=", ".1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xMax", "=", 
   RowBox[{
    RowBox[{"tMax", "*", "springThick0"}], "+", "2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Animate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Polygon", "[", 
