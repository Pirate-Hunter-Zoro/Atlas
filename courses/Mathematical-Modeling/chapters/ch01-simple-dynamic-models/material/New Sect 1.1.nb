 RowBox[{"sol3", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"m", " ", 
        RowBox[{
         SuperscriptBox[
          SuperscriptBox["x", "\[Prime]",
           MultilineFunction->None], "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}]}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "k"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}], "-", 
        RowBox[{"k1", " ", 
         FractionBox[
          RowBox[{
           SuperscriptBox["x", "\[Prime]",
            MultilineFunction->None], "[", "t", "]"}], 
          RowBox[{"Abs", "[", 
           RowBox[{
            SuperscriptBox["x", "\[Prime]",
             MultilineFunction->None], "[", "t", "]"}], "]"}]]}]}]}], ",", 
      "\[IndentingNewLine]", 
