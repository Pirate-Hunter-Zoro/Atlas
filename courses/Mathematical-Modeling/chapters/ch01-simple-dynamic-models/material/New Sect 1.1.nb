\>", "Text",
 CellChangeTimes->{{3.3982844708984003`*^9, 
  3.3982845207344*^9}},ExpressionUUID->"312d70c1-afa8-4890-a7b5-17491215f8f6"]
}, Closed]]
}, Open  ]]
},
