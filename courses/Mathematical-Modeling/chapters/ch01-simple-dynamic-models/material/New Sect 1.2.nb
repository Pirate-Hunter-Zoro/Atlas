   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".01", "]"}], ",", "Red"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".01", "]"}], ",", "Green"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".01", "]"}], ",", "Blue"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".01", "]"}], ",", "Cyan"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".01", "]"}], ",", "Magenta"}], "}"}]}], 
     "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Style", "[", 
     RowBox[{
     "\"\<\!\(\*StyleBox[\"c1\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[1, 0, \
0]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[1, 0, 0]]\),  \
\!\(\*StyleBox[\"p1\",FontColor->RGBColor[0, 1, \
0]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[0, 1, \
0]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[0, 1, \
0]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[0, 1, 0]]\),  \
\!\(\*StyleBox[\"s1\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[0, 0, 1]]\),  \
\!\(\*StyleBox[\"e1\",FontColor->RGBColor[0, 1, \
1]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[0, 1, \
1]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[0, 1, \
1]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[0, 1, 1]]\),  \
\!\(\*StyleBox[\"dead1\",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[1, 0, 1]]\)\>\"", ",", "16", 
      ",", "Bold"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982883838384*^9, 3.3982885342784*^9}},
 CellLabel->
  "In[256]:=",ExpressionUUID->"1b56ef6a-632e-48b3-9e95-d4731a1b534e"],

