         RowBox[{"{", 
          RowBox[{".01", ",", ".0"}], "}"}], "]"}], ",", "Red"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".007", "]"}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".01", ",", ".01"}], "}"}], "]"}], ",", "Green"}], "}"}], 
      ",", 
