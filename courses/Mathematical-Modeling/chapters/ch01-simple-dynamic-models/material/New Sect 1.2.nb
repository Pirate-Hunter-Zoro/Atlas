         RowBox[{"{", 
          RowBox[{".01", ",", ".02"}], "}"}], "]"}], ",", "Blue"}], "}"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".007", "]"}], ",", 
        RowBox[{"Dashing", "[", 
         RowBox[{"{", 
          RowBox[{".01", ",", ".03"}], "}"}], "]"}], ",", "Cyan"}], "}"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", ".007", "]"}], ",", 
