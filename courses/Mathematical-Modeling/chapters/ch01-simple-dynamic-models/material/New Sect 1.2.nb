\!\(\*StyleBox[\"x2New\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"[\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"t\",FontColor->RGBColor[0, 0, \
1]]\)\!\(\*StyleBox[\"]\",FontColor->RGBColor[0, 0, 1]]\)\>\"", ",", "14", 
      ",", "Bold"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3982872507184*^9, {3.3982881095894003`*^9, 3.3982881596754*^9}, {
   3.3982883695193996`*^9, 3.3982883715964003`*^9}},
 CellLabel->
  "In[238]:=",ExpressionUUID->"112de5b6-207a-4ddd-8b24-2f56e8dc9ba7"],

