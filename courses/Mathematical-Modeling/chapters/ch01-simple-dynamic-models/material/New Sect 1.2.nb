Cell[CellGroupData[{

Cell[" Example 1.7", "Section",ExpressionUUID->"2ae3c342-f472-4602-b849-ba28bdb1a975"],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Biochemical Reactions", "Subtitle"]], "Subsection",ExpressionUUID->"248fd1ec-74cc-4ab3-9591-15a7e0680102"],

Cell[TextData[{
 " A number of biochemical reactions involve a substrate and enzyme, whose \
concentrations are denoted by S and E respectively.  These interact to form a \
complex whose concentration is C.  This is a reversible reaction that occurs \
at a rate proportional to the product of S and E, with a rate constant kC, \
and which can then dissociate back into its constituents at a rate \
proportional to C itself, with rate constant kES.  When the reaction energy \
is high enough, however, the enzyme can cleave the substrate to form a new \
product of concentration P.  When this happens, the enzyme is released and \
becomes available again.  This is an irreversible reaction that occurs at a \
rate proportional to C, with rate constant k.  Finally, P will be inactivated \
into form D (for \"dead\") at a rate proportional to its own concentration, \
at a rate of k1.\n\nThis sequence of reactions can be summarized by the \
following diagram:\n  \n",
 StyleBox["\te + s ",
  FontSize->16,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   UnderscriptBox[
    FormBox[
     OverscriptBox["\[RightArrowLeftArrow]", "kc"],
     TraditionalForm], "kes"], TraditionalForm]],
  FontSize->16,
  FontWeight->"Bold",ExpressionUUID->"d364e5ba-7119-4126-a584-491ee77fd288"],
 StyleBox[" c ",
  FontSize->16,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[LongRightArrow]", "k"], TraditionalForm]],
  FontSize->16,
  FontWeight->"Bold",ExpressionUUID->"ebdd0a39-cafc-4a48-8335-87d034660d75"],
 StyleBox[" p + e ",
  FontSize->16,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[LongRightArrow]", "k1"], TraditionalForm]],
  FontSize->16,
  FontWeight->"Bold",ExpressionUUID->"23be7e57-b988-44bc-9e3a-229f9a1ca436"],
 StyleBox[" dead",
  FontSize->16,
  FontWeight->"Bold"],
 "  \n   ",
 "\n",
 "Choose some reasonable numerical values to study the behavior of this \
system:"
}], "Text",ExpressionUUID->"99a9db25-ee47-4900-a6d8-7d23f5c9cbda"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"c", ",", "e", ",", "s", ",", "p", ",", "dead"}], 
  "]"}]], "InputOnly",
 CellLabel->
  "In[240]:=",ExpressionUUID->"8795018f-c78b-48f7-af6e-ce7a08e2662e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kc", "=", ".3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kes", "=", ".2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", ".15"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k1", "=", ".05"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c0", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e0", "=", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p0", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s0", "=", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dead0", "=", "40"}], ";"}]}], "InputOnly",
 CellLabel->
  "In[241]:=",ExpressionUUID->"23dc0dc2-9054-4c0b-ab30-59d66d3c3695"],

Cell["Find the numerical solution of the ODE system:", "Text",ExpressionUUID->"06768f0e-06eb-4d10-8df0-1bd6d05f3ab1"],

Cell[BoxData[
 RowBox[{"solutionRule", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["c", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"kc", " ", 
         RowBox[{"e", "[", "t", "]"}], " ", 
         RowBox[{"s", "[", "t", "]"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"k", "+", "kes"}], ")"}], " ", 
         RowBox[{"c", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"k", " ", 
         RowBox[{"c", "[", "t", "]"}]}], "-", 
        RowBox[{"k1", " ", 
         RowBox[{"p", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["s", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "kc"}], " ", 
         RowBox[{"e", "[", "t", "]"}], " ", 
         RowBox[{"s", "[", "t", "]"}]}], "+", 
        RowBox[{"kes", " ", 
         RowBox[{"c", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["e", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"-", 
        RowBox[{
         SuperscriptBox["c", "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["dead", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"k1", " ", 
        RowBox[{"p", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"c", "[", "0", "]"}], "==", "c0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"p", "[", "0", "]"}], "==", "p0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"s", "[", "0", "]"}], "==", "s0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"e", "[", "0", "]"}], "==", "e0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dead", "[", "0", "]"}], "==", "dead0"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "[", "t", "]"}], ",", 
      RowBox[{"p", "[", "t", "]"}], ",", 
      RowBox[{"s", "[", "t", "]"}], ",", 
      RowBox[{"e", "[", "t", "]"}], ",", 
      RowBox[{"dead", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3982892731514*^9, 3.3982893025504*^9}},
 CellLabel->
  "In[250]:=",ExpressionUUID->"71c61a95-c927-4a76-ab3a-46633671cf34"],

Cell["Extract the five solutions from the replacement rule:", "Text",ExpressionUUID->"8c7e34b1-8cc8-4589-99d3-818723f16e1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c1", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"c", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"Flatten", "[", "solutionRule", "]"}]}]}]], "Input",
 CellChangeTimes->{3.3982882957144003`*^9},
 CellLabel->
  "In[251]:=",ExpressionUUID->"54dbcb78-cde4-4636-af1f-678e21e8dea6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p1", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"p", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"Flatten", "[", "solutionRule", "]"}]}]}]], "Input",
 CellChangeTimes->{3.3982883002264*^9},
 CellLabel->
  "In[252]:=",ExpressionUUID->"19c76b61-3d52-4698-9340-961d7af0a43e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"s1", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"s", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"Flatten", "[", "solutionRule", "]"}]}]}]], "Input",
 CellChangeTimes->{3.3982883045464*^9},
 CellLabel->
  "In[253]:=",ExpressionUUID->"1531e3e5-2f61-464f-9153-113ea19b5cac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"e1", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"e", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"Flatten", "[", "solutionRule", "]"}]}]}]], "Input",
 CellChangeTimes->{3.3982883165193996`*^9},
 CellLabel->
  "In[254]:=",ExpressionUUID->"366c3274-c14d-4b9b-8f79-a9e97747ed5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dead1", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{"dead", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"Flatten", "[", "solutionRule", "]"}]}]}]], "Input",
 CellChangeTimes->{3.3982883210704*^9},
 CellLabel->
  "In[255]:=",ExpressionUUID->"9fecf3f0-f379-4fb2-86cb-e46d076f3986"],

