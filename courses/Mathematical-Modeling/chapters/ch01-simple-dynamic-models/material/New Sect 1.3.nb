Notebook[{

Cell[CellGroupData[{
Cell[" Dynamical Systems", "Title",ExpressionUUID->"01dd9ffa-6c5c-4c8e-9233-ca975727a7ac"],

Cell[TextData[StyleBox["  Section 1.3 ",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"25418b7a-6999-40d8-86cf-538e275b09ec"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellChangeTimes->{3.3982928975903997`*^9},
 CellLabel->
  "In[292]:=",ExpressionUUID->"758a4de8-5a0d-475c-9648-c3e5196c65a0"],

Cell[CellGroupData[{

Cell[" Introduction: ", "Section",ExpressionUUID->"19d0bc5e-8aa6-42f5-9e00-387b6929a983"],

Cell[TextData[{
 "As you know from ODEs it is possible to write a higher order equation as a \
first order system.  As an example, consider a typical second order ODE of \
the type that was generated by our previous examples.  \n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"z", "''"}], "[", "t", "]"}], " ", "+", " ", 
     RowBox[{"r", "*", 
      RowBox[{
       RowBox[{"z", "'"}], "[", "t", "]"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"\[Omega]", "^", "2"}], 
      RowBox[{"z", "[", "t", "]"}]}]}], " ", "=", " ", 
    RowBox[{"g", "[", "t", "]"}]}], TraditionalForm]],ExpressionUUID->
  "6baeb7af-0acd-478e-b136-4606943ca6b7"],
 "\n\nLet:\t\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"z", "[", "t", "]"}]}], ",", "  ", "\n", "\t", 
     RowBox[{
      RowBox[{"x2", "[", "t", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"z", " ", "'"}], " ", "[", "t", "]"}]}], ",", " "}]}], 
   TraditionalForm]],ExpressionUUID->"0fc5d6a5-26bd-4b23-9b15-aa2805534b16"],
 "\n\t\nThus:\n\t\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x1", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{"x2", "[", "t", "]"}]}], TraditionalForm], "\n", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x2", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", "r"}], "*", 
       RowBox[{
        RowBox[{"z", "'"}], "[", "t", "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"\[Omega]", "^", "2"}], 
       RowBox[{"z", "[", "t", "]"}]}], " ", "+", " ", 
      RowBox[{"g", "[", "t", "]"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", "r"}], "*", 
       RowBox[{"x2", "[", "t", "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"\[Omega]", "^", "2"}], 
       RowBox[{"x1", "[", "t", "]"}]}], " ", "+", " ", 
      RowBox[{"g", "[", "t", "]"}]}]}]}], TraditionalForm]}],ExpressionUUID->
  "ef7a60df-5b18-44f4-81eb-8b67dc1c5f45"],
 "\n\nIn matrix notation:\n \n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        RowBox[{"x1", "'"}], "[", "t", "]"}]},
      {
       RowBox[{
        RowBox[{"x2", "'"}], "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "e5cebc53-364a-4586-9f60-bb7bbadd0032"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", 
        SuperscriptBox["\[Omega]", "2"]}], 
       RowBox[{"-", "r"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "0a421829-3007-49b9-b49c-b790fa5b61d3"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"x1", "[", "t", "]"}]},
      {
       RowBox[{"x2", "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "6cdac6c2-a083-4db1-b955-888cfd78f152"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"0"},
      {
       RowBox[{"g", "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "487b9530-6d29-4f17-ac14-ad38d9fa24d1"],
 "\n \nOr: \n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"X", "[", "t", "]"}], " ", "="}], TraditionalForm]],
  ExpressionUUID->"d9c4ef37-05b1-4017-9b0d-c68fd3d16783"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"x1", "[", "t", "]"}]},
      {
       RowBox[{"x2", "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "0f328644-a1e1-4398-8c3b-49f6d395fb8b"],
 "\n \n\t\t ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["X", "\[Rule]"], TraditionalForm]],ExpressionUUID->
  "16935d21-1e52-4fa1-87fd-4faf6efc5ed2"],
 "'",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", "t", "]"}], " ", "="}], TraditionalForm]],ExpressionUUID->
  "36d45274-8ec4-48b3-af9b-d5900ad99146"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        RowBox[{"x1", "'"}], "[", "t", "]"}]},
      {
       RowBox[{
        RowBox[{"x2", "'"}], "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "9849e525-4304-41de-b450-efc88b3b069b"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", 
        SuperscriptBox["\[Omega]", "2"]}], 
       RowBox[{"-", "r"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "3bd5f424-e76e-4920-be8a-0bb15158fdef"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"x1", "[", "t", "]"}]},
      {
       RowBox[{"x2", "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "f0e06504-91d8-4d06-a509-ace8419a90e4"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"0"},
      {
       RowBox[{"g", "[", "t", "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "be64cbc7-a03a-4ee3-b421-a8dca4e32a2c"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"f1", "[", 
        RowBox[{"x1", ",", "x2", ",", "t"}], "]"}]},
      {
       RowBox[{"f2", "[", 
        RowBox[{"x1", ",", "x2", ",", "t"}], "]"}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "e2f18622-acb4-49ef-90f7-3c5cc5514ef2"],
 " = ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["F", "\[Rule]"], TraditionalForm]],ExpressionUUID->
  "0bed0b24-d5fc-41a2-b5f5-1cf6a19fbbd6"],
 "[X,t] \n i.e.\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      RowBox[{
       OverscriptBox["X", "\[Rule]"], "'"}], "[", "t", "]"}], " ", "=", " ", 
     RowBox[{
      OverscriptBox["F", "\[Rule]"], "[", 
      RowBox[{"X", ",", "t"}], "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "cdc4543f-1470-476d-80c1-a0658fa5d577"],
 "\n \nUnlike a second order equation, a first order equation has a simple \
interpretation as a vector field.  To see this, observe the definition of the \
first derivative (from this point on we will drop the arrow from the vector \
notation):\n \n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{
      RowBox[{"X", "[", 
       RowBox[{"t", " ", "+", "\[CapitalDelta]t"}], "]"}], " ", "-", " ", 
      RowBox[{"X", "[", "t", "]"}]}], "\[CapitalDelta]t"], "Text",
    FontSize->16], TraditionalForm]],ExpressionUUID->
  "d35e7bc7-4632-4410-ba83-22103a51cb3a"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rule]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"X", "'"}], "[", "t", "]"}], "    ", "as", "    ", 
      "\[CapitalDelta]t"}], "\[Rule]", " ", "0"}]}], TraditionalForm]],
  ExpressionUUID->"b26936ae-037c-4626-9f3c-12e2d1067223"],
 "\n \n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"X", "[", 
      RowBox[{"t", " ", "+", "\[CapitalDelta]t"}], "]"}], " ", "-", " ", 
     RowBox[{"X", "[", "t", "]"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"X", ",", "t"}], "]"}], " ", "\[CapitalDelta]t"}]}], 
   TraditionalForm]],ExpressionUUID->"f35071ef-aa1a-433e-939f-14d2a075a25d"],
 "   (approximately)\n \n",
 StyleBox["Definition:",
  FontWeight->"Bold"],
 " The vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "[", 
    RowBox[{"X", ",", "t"}], "]"}], TraditionalForm]],ExpressionUUID->
  "1a261d9d-edb3-452f-8333-430cc774136e"],
 "  of the ODE defines a ",
 StyleBox["vector field",
  FontWeight->"Bold"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", " ", "\[Element]", " ", "U"}], TraditionalForm]],
  ExpressionUUID->"3e957ed0-b150-4d17-a0cc-b0f666340b7c"],
 ", where ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],ExpressionUUID->
  "dde01ad9-2dc3-46df-bcda-a22b2bd2f211"],
 " is some open subset of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", 
    RowBox[{" ", "2"}]], TraditionalForm]],ExpressionUUID->
  "43d1119d-1d92-4ec8-8757-4de7fd65e643"],
 ".\n\n",
 StyleBox["Definition:",
  FontWeight->"Bold"],
 " The ",
 StyleBox["trajectory, or orbit",
  FontWeight->"Bold"],
 " is a solution of the ODE in the plane whose tangent at ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "b7bb7df5-4e02-408e-ac1e-3392b0604dde"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "[", 
    RowBox[{"X", ",", "t"}], "]"}], TraditionalForm]],ExpressionUUID->
  "3ad08366-2ac2-4204-a9df-a0414c33f281"],
 ".\n\n",
 StyleBox["Definition:",
  FontWeight->"Bold"],
 " The ",
 StyleBox["states",
  FontWeight->"Bold"],
 " of the dynamical system are the values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", "[", "t", "]"}], TraditionalForm]],ExpressionUUID->
  "c865a178-8f0e-4963-9581-6f59ac10a989"],
 " as ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "579da352-2346-4682-9ffc-a629d1cd4c42"],
 " varies and the states and ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],ExpressionUUID->
  "cc5f1f94-f638-4b25-9343-25a4042347e2"],
 " are called the ",
 StyleBox["state space",
  FontWeight->"Bold"],
 ".\n",
 StyleBox["Definition:",
  FontWeight->"Bold"],
 " Any orbit along which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"X", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"X", ",", "t"}], "]"}], " ", "="}]}], TraditionalForm]],
  ExpressionUUID->"a4a6fa17-6117-48ab-ab4a-3eda6c7d08f9"],
 " ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["0", "\[Rule]"], TraditionalForm]],ExpressionUUID->
  "d753dc35-4835-4cec-8e53-8c1c90197c96"],
 " is called a",
 StyleBox[" fixed point",
  FontWeight->"Bold"],
 " or ",
 StyleBox["equilibrium point",
  FontWeight->"Bold"],
 " or ",
 StyleBox["critical point",
  FontWeight->"Bold"],
 " of the motion and is referred to as an ",
 StyleBox["equilibrium state",
  FontWeight->"Bold"],
 "  (For a second order ODE the equilibrium states corresponding to a first \
order system correspond to a situation in which there is no motion, i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"X", "'"}], "[", "t", "]"}], " ", "="}], TraditionalForm]],
  ExpressionUUID->"504dfa2f-a042-4256-8231-9eae56078e19"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["0", "\[Rule]"], " "}], TraditionalForm]],ExpressionUUID->
  "999d8585-1091-49c4-bf14-d7cac561ad91"],
 "implies that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x1", "'"}], "[", "t", "]"}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"1f4aa2a3-5fbe-4248-a371-dc95bf6c92a4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x2", "'"}], "[", "t", "]"}], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"f2dee141-115b-4cb6-8188-eef4cf1d758f"],
 "   (i.e. velocity = 0 and acceleration = 0),  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x2", "'"}], "[", "t", "]"}], " ", "=", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "''"}], "[", "t", "]"}], " ", "=", " ", "0"}]}], 
   TraditionalForm]],ExpressionUUID->"5a07920f-d48c-4bba-bc46-e90eb998c59a"],
 " (acceleration)).\n   \n",
 StyleBox["For this chapter we will assume:",
  FontWeight->"Bold"],
 " that the vector field is independent of time (which simplifies \
tremendously the interpretation of the vector fields and the orbits).\n    \t \
   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"X", "'"}], "[", "t", "]"}], " ", "=", " ", 
    RowBox[{"F", "[", "X", "]"}]}], TraditionalForm]],ExpressionUUID->
  "53104ae7-d57d-40d8-b055-616d554329c0"],
 "\n  \n",
 StyleBox["Stability", "Subsubsection"],
 ": Consider a physical system which is in an equilibrium state.  If ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["X", "-"], TraditionalForm]],ExpressionUUID->
  "aacfc8a0-4e1f-49a7-95b9-c2e9d3c1634e"],
 " is disturbed out of that equilibrium state does the solution:\n    \n\t    \
 tend back to that equilibrium state or \n\t     tend to orbit in the \
vicinity of the equilibrium state or\n\t     tend away from the equilibrium \
state?\n     \n",
 StyleBox["Definition:",
  FontWeight->"Bold"],
 "   Suppose that for every open neighborhood ",
 Cell[BoxData[
  FormBox["\[CapitalOmega]", TraditionalForm]],ExpressionUUID->
  "1cd6cf1f-153e-4b13-96b4-95f74bc72204"],
 " of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["X", "-"], TraditionalForm]],ExpressionUUID->
  "b7a87f5d-3a76-49e5-a522-91cd5734880a"],
 "  in ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],ExpressionUUID->
  "f1bd0c55-472b-475f-90d3-00609f4b9c31"],
 " the orbit remains in ",
 Cell[BoxData[
  FormBox["\[CapitalOmega]", TraditionalForm]],ExpressionUUID->
  "ae804d95-dce2-41e2-a94e-16a2dc24326e"],
 " for all",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"t", "\[GreaterEqual]", "0"}]}], TraditionalForm]],
  ExpressionUUID->"35adc292-b9f0-4f50-a0db-feb10371c7de"],
 " whenever the orbit starts close enough to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["X", "-"], TraditionalForm]],ExpressionUUID->
  "f0d70792-c9cd-4267-9462-f4414b18d4a5"],
 " (then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["X", "-"], " "}], TraditionalForm]],ExpressionUUID->
  "d832f3e2-b636-4732-bbe7-299ab9461f1f"],
 " is stable).  Otherwise, it is unstable.  In addition, if there is some \
open neighborhood ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "0"], TraditionalForm]],ExpressionUUID->
  "3de491ee-6438-4f59-8621-5abe47f694c4"],
 " containing ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["X", "-"], TraditionalForm]],ExpressionUUID->
  "27970608-84d5-4cef-8331-86007109bbbc"],
 " for which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"X", "[", "t", "]"}], "\[Rule]"}], TraditionalForm]],
  ExpressionUUID->"ad6288fb-24a8-4d46-a9e1-0a2ff0d56120"],
 Cell[BoxData[
  FormBox[
   OverscriptBox["X", "-"], TraditionalForm]],ExpressionUUID->
  "afddc93b-b149-4582-80ce-41a70051f52a"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[Rule]", "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "b4b6e9e8-2720-4013-9761-5ce4cd3a9803"],
 " whenever the orbit starts in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "0"], TraditionalForm]],ExpressionUUID->
  "b57f1bec-70da-4867-a0c9-6a84e5627a65"],
 ", then ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["X", "-"], TraditionalForm]],ExpressionUUID->
  "8d3b70af-840a-4ef0-aaa8-4edb85c1d42f"],
 " is called asymptotically stable (abbreviated a.s.) or, more commonly, an \
attractor.  The largest possible open neighborhood ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "0"], TraditionalForm]],ExpressionUUID->
  "0bf0f00e-5f34-4c45-9b8e-578877bbd145"],
 " that satisfies this property is called the basin of attraction of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["X", "-"], TraditionalForm]],ExpressionUUID->
  "a6a71bc2-fc88-4f7c-bcdb-b8984e4c5570"],
 ".  In the event that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "0"], TraditionalForm]],ExpressionUUID->
  "bc6fb069-414a-4825-bcba-f7d209ec5dae"],
 "  is the entire state space U, than we say it is globally asymptotically \
stable.\n  "
}], "Text",
 CellChangeTimes->{{3.3982930617024*^9, 3.3982930983344*^9}, {
  3.3982936044554*^9, 3.3982936163914003`*^9}, {3.3982936471703997`*^9, 
  3.3982937971324*^9}, {3.3982938383794003`*^9, 3.3982940373864*^9}, {
  3.3982940724224*^9, 3.3982941402534*^9}, {3.3982941740544*^9, 
  3.3982941750764*^9}},ExpressionUUID->"844cc998-4e30-49f1-ac0a-d38331c94355"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Examples: ", "Section",ExpressionUUID->"475b5603-f447-4a1b-8c03-1fc72e32ea0a"],

Cell[TextData[{
 "\"",
 Cell[BoxData[
  FormBox[
   RowBox[{"VectorPlot", "[", 
    RowBox[{"f", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "x0", ",", " ", "x1", ",", " ", 
       RowBox[{"(", "xu", ")"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "y0", ",", " ", "y1", ",", " ", 
       RowBox[{"(", "yu", ")"}]}], "}"}], ",", " ", 
     RowBox[{"(", "options", ")"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"39625b12-d161-4f66-a48d-6bd019e583c5"],
 " produces a vector field plot of the two-dimensional vector function f.\""
}], "Text",
 CellChangeTimes->{
  3.3982943514414*^9, {3.46376371898545*^9, 
   3.46376371898545*^9}},ExpressionUUID->"1601b0ac-830c-4560-aa15-\
4c9382a17646"],

Cell[TextData[{
 StyleBox["Example:", "Subsubsection"],
 " Consider the following extremely simple vector field corresponding to the \
first order differential system:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x1", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"x1", "[", "t", "]"}]}], "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"x2", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"x2", "[", "t", "]"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "7ef5b531-0aee-4fc5-ae63-d575aa3c55aa"],
 "\n\t"
}], "Text",
 CellChangeTimes->{{3.3982943633914003`*^9, 
  3.3982943660824003`*^9}},ExpressionUUID->"7b798ab9-ee04-4e18-8eb7-\
1f7eafe58cef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"x1_", ",", "x2_"}], "]"}], "=", 
  RowBox[{"{", 
   RowBox[{"x1", ",", "x2"}], "}"}]}]], "Input",
 CellLabel->
  "In[293]:=",ExpressionUUID->"f4cc21fe-0876-4657-8b0b-fc1f368f4545"],

Cell["Find the equilibrium points for this vector field:", "Text",ExpressionUUID->"dc512e2c-7e3e-44d5-98e6-b956a35cd159"],

Cell[BoxData[
 RowBox[{"Solve", "[", "   ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f1", "[", 
     RowBox[{"x1", ",", "x2"}], "]"}], "\[Equal]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}]}], ",", "  ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982943805704*^9, 3.3982943911054*^9}},
 CellLabel->
  "In[294]:=",ExpressionUUID->"a9ed32e0-4c03-449b-aeac-0bfc996a38cf"],

Cell["Plot the associated vector field:", "Text",ExpressionUUID->"1a14fbd0-c118-4ef7-ba53-b93b952d23b2"],

Cell[BoxData[
 RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f1", "[", 
    RowBox[{"x1", ",", "x2"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x1", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x2", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3982933712304*^9, {3.3982944156104*^9, 3.3982944389164*^9}, 
   3.463763697532737*^9},
 CellLabel->
  "In[295]:=",ExpressionUUID->"b09b5547-9329-4fcc-ba8d-38ab938be935"],

Cell[TextData[{
 "Note that the equilibrium point at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", " ", "0"}], ")"}], TraditionalForm]],ExpressionUUID->
  "db438599-50eb-4c37-a8ef-0c66c334b102"],
 " is unstable.\n"
}], "Text",
 CellChangeTimes->{{3.3982931934764*^9, 3.3982931938274*^9}, 
   3.3982944495264*^9},ExpressionUUID->"fded656b-1e09-4e9d-aa39-7550506423f8"],

Cell[TextData[{
 StyleBox["Example: ", "Subsubsection"],
 " Next, consider the following extremely simple vector field corresponding \
to the first order differential system:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x1", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"-", " ", 
       RowBox[{"x1", "[", "t", "]"}]}]}], "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"x2", "'"}], "[", "t", "]"}], " ", "=", " ", 
      RowBox[{"-", " ", 
       RowBox[{"x2", "[", "t", "]"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"532fe40b-f386-47e4-96ad-5bf160bb1204"],
 "\n\t"
}], "Text",
 CellChangeTimes->{{3.3982944574414*^9, 
  3.3982944603654003`*^9}},ExpressionUUID->"7689e1c5-3c2b-448d-ad7c-\
e76b1cf9475c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{"x1_", ",", "x2_"}], "]"}], "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"-", "x1"}], ",", 
    RowBox[{"-", "x2"}]}], "}"}]}]], "Input",
 CellLabel->
  "In[296]:=",ExpressionUUID->"3dec6785-ad9f-4893-a078-9ac245ff5f0d"],

Cell["Find the equilibrium points for this vector field:", "Text",ExpressionUUID->"8e4bd588-aeb7-4a6e-9362-a1670d1da001"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f2", "[", 
     RowBox[{"x1", ",", "x2"}], "]"}], "\[Equal]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982944700424*^9, 3.3982944784574003`*^9}},
 CellLabel->
  "In[297]:=",ExpressionUUID->"fd8637e9-95e6-4c65-9a0e-817bb91e3b29"],

Cell["Plot the associated vector field:", "Text",ExpressionUUID->"5189db71-8ac5-43b7-8c0a-1ce6f2759168"],

Cell[BoxData[
 RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f2", "[", 
    RowBox[{"x1", ",", "x2"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x1", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x2", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3982933797734003`*^9, {3.3982944847014*^9, 3.3982945049054003`*^9}, 
   3.4637638534672427`*^9},
 CellLabel->
  "In[298]:=",ExpressionUUID->"88e9e520-6f9a-42e7-aac3-9c821a43ba7a"],

Cell[TextData[{
 "Note that this equilibrium point at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]],ExpressionUUID->
  "d6acde94-fd6f-47a9-ae1f-0eed23f165c6"],
 " is stable, as well as asymptotically stable and the basin of attraction \
for this function is all of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "7e3b73ac-4a7d-4b8f-90d0-6bcd5b71f9e2"],
 ".\n"
}], "Text",
 CellChangeTimes->{{3.3982931999034*^9, 3.3982932001784*^9}, 
   3.3982945177044*^9},ExpressionUUID->"49f7f226-862e-47c9-a314-c3f109eca0ce"],

Cell[TextData[{
 StyleBox["Example:", "Subsubsection"],
 " Next, consider a more complicated vector field corresponding to the first \
order differential system:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x1", " ", "'"}], " ", "="}], TraditionalForm]],ExpressionUUID->
  "1c03d3d0-dfbb-48a9-a794-7ccd688e8ec9"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "x1", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      SuperscriptBox["x1", "2"], "+", 
      SuperscriptBox["x2", "2"]}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "4d5bd66b-e527-41cc-bb16-62c33141963b"],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x2", " ", "'"}], " ", "=", " "}], TraditionalForm]],
  ExpressionUUID->"62f80295-764f-42fb-bac6-f9968545b582"],
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "x2", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      SuperscriptBox["x1", "2"], "+", 
      SuperscriptBox["x2", "2"]}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "7c5be69c-3241-4f74-9db8-22026cd069f6"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.3982945307714*^9, 
  3.3982945419594*^9}},ExpressionUUID->"12e98ef5-ebf9-4eb2-b377-5b40d0bab1c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f3", "[", 
   RowBox[{"x1_", ",", "x2_"}], "]"}], "=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"2", " ", "x1", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       SuperscriptBox["x1", "2"], "+", 
       SuperscriptBox["x2", "2"]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"2", " ", "x2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       SuperscriptBox["x1", "2"], "+", 
       SuperscriptBox["x2", "2"]}], "]"}]}]}], "\[IndentingNewLine]", 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.3982945489184*^9, 3.3982945597454*^9}},
 CellLabel->
  "In[299]:=",ExpressionUUID->"287a4922-2f41-45ad-b09b-deaa2821b1c9"],

Cell["Look at a plot of this vector field.", "Text",
 CellChangeTimes->{{3.3982932037714*^9, 
  3.3982932040424*^9}},ExpressionUUID->"2d85ad3a-0575-42cb-b999-03e3314a0aa8"],

Cell[BoxData[
 RowBox[{"plot1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f3", "[", 
     RowBox[{"x1", ",", "x2"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x1", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x2", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982933942974*^9, 3.3982933978764*^9}, {
   3.3982945658543997`*^9, 3.3982945812384*^9}, 3.463763864951397*^9},
 CellLabel->
  "In[300]:=",ExpressionUUID->"2bc152f7-4f56-46b9-bace-0a584bfc7d9d"],

Cell["Find the equilibrium points for this field.", "Text",
 CellChangeTimes->{{3.3982932059094*^9, 
  3.3982932061794*^9}},ExpressionUUID->"c00e7ed5-c3fa-436a-9cb7-c95caa1284f4"],

Cell[BoxData[
 RowBox[{"solns", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"f3", "[", 
       RowBox[{"x1", ",", "x2"}], "]"}], "\[Equal]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2"}], "}"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "//", "TableForm"}]}]], "Input",
 CellChangeTimes->{{3.3982945896624002`*^9, 3.3982946499314003`*^9}},
 CellLabel->
  "In[301]:=",ExpressionUUID->"24446f1b-14cf-4500-b921-4463e7c128c2"],

Cell[TextData[{
 "We found the equilibrium point at the origin ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]],ExpressionUUID->
  "ef393a2d-52dd-483b-b51a-e6cec4d86b5d"],
 " and many other points.  Specifically, if we select only the equilibrium \
points with ",
 StyleBox["real",
  FontVariations->{"Underline"->True}],
 " coordinates then we obtain:"
}], "Text",
 CellChangeTimes->{3.3982932077534*^9, 3.3982946762483997`*^9, 
  3.5272693625349016`*^9},ExpressionUUID->"66b55f59-c78e-4e6b-93b1-\
cf9c68e5b6ce"],

Cell[BoxData[
 RowBox[{"solns", "=", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "\[Rule]", "0"}], ",", 
      RowBox[{"x2", "\[Rule]", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "\[Rule]", 
       RowBox[{"-", 
        SqrtBox[
         FractionBox["\[Pi]", "2"]]}]}], ",", 
      RowBox[{"x2", "\[Rule]", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "\[Rule]", 
       SqrtBox[
        FractionBox["\[Pi]", "2"]]}], ",", 
      RowBox[{"x2", "\[Rule]", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x2", "\[Rule]", 
       RowBox[{"-", 
        SqrtBox[
         FractionBox["\[Pi]", "2"]]}]}], ",", 
      RowBox[{"x1", "\[Rule]", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x2", "\[Rule]", 
       SqrtBox[
        FractionBox["\[Pi]", "2"]]}], ",", 
      RowBox[{"x1", "\[Rule]", "0"}]}], "}"}]}], "\[IndentingNewLine]", 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.3982947311294003`*^9, 3.3982947468324003`*^9}},
 CellLabel->
  "In[302]:=",ExpressionUUID->"a2a73064-b38f-4c12-936c-717a8799ee8c"],

Cell[TextData[{
 "Use the above five solutions to generate the coordinates for five \
additional equilibrium points  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}], TraditionalForm]],ExpressionUUID->
  "2eba30a8-a474-46e0-9fd2-0d903860503e"],
 "."
}], "Text",
 CellChangeTimes->{{3.3982932097293997`*^9, 
  3.3982932133143997`*^9}},ExpressionUUID->"4b0dbeee-0d8f-4267-896c-\
5ee58528616d"],

Cell[BoxData[
 RowBox[{"pts", "=", 
  RowBox[{
   RowBox[{"Point", "[", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2"}], "}"}], "]"}], "/.", "solns"}]}]], "Input",
 CellLabel->
  "In[303]:=",ExpressionUUID->"ed4f61a5-5899-4dd1-a02d-179290396537"],

Cell["Generate a simple graph of the five equilibrium points.", "Text",ExpressionUUID->"7a9c2f2b-8634-4dd5-9888-a64db91da801"],

Cell[BoxData[
 RowBox[{"plot2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"PointSize", "[", ".03", "]"}], ",", "pts"}], "}"}], 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3982950298374*^9, 3.3982950818824*^9}},
 CellLabel->
  "In[304]:=",ExpressionUUID->"afcb6829-a3a6-4675-bad1-f1f5c94905d4"],

Cell["\<\
It is now possible to superimpose the plot of the equilibrium points and the \
vector field.\
\>", "Text",ExpressionUUID->"aac0a5b6-d5d9-4802-8c05-34a47711cb36"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"plot1", ",", "plot2"}], "]"}]], "Input",
 CellLabel->
  "In[305]:=",ExpressionUUID->"1a57cbe2-e345-48e6-9cf9-3fcbdf04e54b"],

Cell["\<\
A visual examination of the above vector field and the five equilibrium \
points suggests that the equilibrium point located at the origin will be \
unstable, and the other equilibrium points will be stable. \
\>", "Text",ExpressionUUID->"38352a71-d63a-47db-b111-90f0a507d051"],

Cell[TextData[{
 "Also, from the above solution it appears that there are ",
 StyleBox["non",
  FontVariations->{"Underline"->True}],
 "isolated equilibrium points along the line:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "\[Rule]", 
    SqrtBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], "-", 
      SuperscriptBox["x2", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "dd228c4d-0ee9-4119-90f9-8a859fff7361"],
 "\t(there are several other lines as well)\n\t\t\nLet's examine just this \
\"line\" of equilibrium points.  This can be accomplished by generating a \
parametric plot in the coordinate system ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}], TraditionalForm]],ExpressionUUID->
  "b8cab16f-69d6-4379-bee8-a533549f9efb"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "\[Rule]", 
    SqrtBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], "-", 
      SuperscriptBox["x2", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "75729e07-04f3-4861-8fe8-ccc921416cc9"],
 "."
}], "Text",ExpressionUUID->"87611392-d0a2-49cb-9d6c-bdc5a889ac82"],

Cell[BoxData[
 RowBox[{"plot3", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SqrtBox[
       RowBox[{
        FractionBox["\[Pi]", "2"], "-", 
        SuperscriptBox["x2", "2"]}]], ",", " ", "x2"}], "}"}], ",", " ", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x2", ",", " ", 
      RowBox[{"-", "1.2"}], ",", " ", "1.2"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Thickness", "[", ".007", "]"}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982951269684*^9, 3.3982952231154003`*^9}},
 CellLabel->
  "In[306]:=",ExpressionUUID->"5ea9dae3-a7e4-4765-95ff-cf3efcc6b8b2"],

Cell["\<\
It is now possible to superimpose the plot of the equilibrium points and the \
vector field.\
\>", "Text",ExpressionUUID->"369ca9b9-e5dd-44b2-8f17-d1b1a7d80a85"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"plot1", ",", "plot3"}], "]"}]], "Input",
 CellLabel->
  "In[307]:=",ExpressionUUID->"dc25a60a-82af-429b-a641-329bd7452310"],

Cell[TextData[{
 "For clarity, let's zoom in by restricting the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.5"}], "}"}]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"01db352a-fd16-47a5-84c1-2b73f8f2a6ac"],
 ":"
}], "Text",ExpressionUUID->"2fec205c-f75f-422e-8dae-d12638548311"],

Cell[BoxData[
 RowBox[{"plot4", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f3", "[", 
     RowBox[{"x1", ",", "x2"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "0", ",", "1.5"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x2", ",", "0", ",", "1.5"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3982934119904003`*^9, 3.3982934152574*^9}, {
  3.3982952897404003`*^9, 3.3982953160894003`*^9}, {3.4644624057805347`*^9, 
  3.4644624067180223`*^9}},
 CellLabel->
  "In[308]:=",ExpressionUUID->"684a8b92-32c2-47ba-b26b-7dbe5002bb49"],

Cell["\<\
As before, it is now possible to superimpose the plot of the equilibrium \
points and the vector field.\
\>", "Text",ExpressionUUID->"b2f96ee1-54f7-4c64-b81e-43f37cdf9c09"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
  "plot4", ",", "\[IndentingNewLine]", "plot3", ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.5"}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
