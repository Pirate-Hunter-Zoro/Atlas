Cell[TextData[{
 "It appears that there is another \"line\" of equilibrium points near ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1.5"}], ",", 
     RowBox[{"-", "1.5"}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "f7363b5e-0830-4560-b02f-9ece4be39302"],
 "  (and at each corresponding location in the other three quadrants) that \
was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " found by the above procedure. Recall that the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command Solve is for algebraic equations, and only has limited use for \
non-algebraic equations.  Therefore, we will try a numerical procedure to \
locate ",
 StyleBox["some",
  FontVariations->{"Underline"->True}],
 " other roots using the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command FindRoot:"
}], "Text",
 CellChangeTimes->{
  3.3982955184624*^9},ExpressionUUID->"a38fd8af-9f0f-460a-bc50-8cc7f68e2ab4"],

Cell[TextData[{
 "\"",
 Cell[BoxData[
  FormBox[
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{"lhs", "==", "rhs"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "x0"}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"05dad3c2-969f-4352-9df6-79f94d108d8e"],
 " searches for a numerical solution to the equation lhs==rhs, starting with \
x=x0.\""
}], "Text",
 CellChangeTimes->{
  3.3982955466554003`*^9},ExpressionUUID->"2ff58651-9429-40d6-b969-\
a739f0d1d106"],

