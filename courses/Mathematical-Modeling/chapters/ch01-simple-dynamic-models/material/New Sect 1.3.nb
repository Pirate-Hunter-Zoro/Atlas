Cell[TextData[{
 StyleBox["Example: ", "Subsubsection"],
 "Next, consider the following vector field corresponding to the first order \
differential system:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x1", " ", "'"}], " ", "="}], TraditionalForm]],ExpressionUUID->
  "f1301594-e2e7-462c-9b7c-c1bc488c8b70"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", 
    RowBox[{"x1", "*", "x2"}], "]"}], TraditionalForm]],ExpressionUUID->
  "a7c11abc-2dfd-40a2-a7ff-83c3e8cdf077"],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x2", " ", "'"}], " ", "="}], TraditionalForm]],ExpressionUUID->
  "52330366-4fe1-41a1-97e5-5395b1410868"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Cos", "[", 
    RowBox[{"x1", "*", "x2"}], "]"}], TraditionalForm]],ExpressionUUID->
  "e6e507da-f29c-4b69-a544-e7c7b1123afe"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.3982958473034*^9, 3.3982958526774*^9}, {
  3.3982959085104*^9, 
  3.3982959096224003`*^9}},ExpressionUUID->"0d17618d-5bac-4fa3-b5a9-\
6227ed02cbb5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f4", "[", 
   RowBox[{"x1_", ",", "x2_"}], "]"}], "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"x1", "*", "x2"}], "]"}], ",", 
    RowBox[{"Cos", "[", 
     RowBox[{"x1", "*", "x2"}], "]"}]}], "}"}]}]], "Input",
 CellLabel->
  "In[325]:=",ExpressionUUID->"260dbedb-dcf9-4e6d-8825-31a3d2fa1f43"],

Cell["Find the equilibrium points for this vector field.", "Text",
 CellChangeTimes->{
  3.3982932609364*^9},ExpressionUUID->"d132eabf-22a8-4eee-b941-8c2ae81bbe0b"],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f4", "[", 
     RowBox[{"x1", ",", "x2"}], "]"}], "\[Equal]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3982958623613997`*^9, 3.3982958735214*^9}},
 CellLabel->
  "In[326]:=",ExpressionUUID->"a7877919-819f-447a-8012-36195f2a1392"],

Cell[TextData[{
 "It appears that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " can not find an equilibrium point for this vector field using the \
algebraic Solve command. This might be the result of the non-algebraic \
structure of the vector field.  To understand this vector field better, look \
at the corresponding graph of the vector field."
}], "Text",
 CellChangeTimes->{{3.3982932636884003`*^9, 
  3.3982932641314*^9}},ExpressionUUID->"883d88e2-3619-42ad-a0db-5612d2f3c51e"],

Cell[BoxData[
 RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f4", "[", 
    RowBox[{"x1", ",", "x2"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "0", ",", "\[Pi]"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x2", ",", "0", ",", "\[Pi]"}], "}"}], ",", "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.3982934797344*^9, {3.3982958822804003`*^9, 3.3982958946804*^9}, 
   3.463763972402459*^9},
 CellLabel->
  "In[327]:=",ExpressionUUID->"9f49dd99-aae0-4324-bb0a-5c01730dac77"],

Cell["\<\
It is clear from this graph that there are no equilibrium points (at least \
within the range of this graph).\
\>", "Text",
 CellChangeTimes->{{3.3982932666774*^9, 
  3.3982932668924*^9}},ExpressionUUID->"4b526850-c1be-40d8-85ca-442e45d07fdc"]
