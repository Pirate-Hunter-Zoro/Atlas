 CellChangeTimes->{{3.3985324262966805`*^9, 3.3985324338435555`*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"2e7e437b-2987-4f9b-9985-7718c0f05d86"],

Cell["\<\


It is possible to understand the global behavior of this limit cycle by \
examining the corresponding vector field for the system of two ODEs.\
\>", "Text",ExpressionUUID->"eba6ce06-454f-444e-bc94-b618f8cf2323"],

Cell[BoxData[
 RowBox[{"graph3", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"VectorPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x2", "+", 
       RowBox[{"x1", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x1", "2"], "+", 
            SuperscriptBox["x2", "2"]}], ")"}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{"-", "x1"}], "+", 
       RowBox[{"x2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x1", "2"], "+", 
            SuperscriptBox["x2", "2"]}], ")"}]}], ")"}]}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x1", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x2", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"VectorScale", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Small", ",", "0.6", ",", "None"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3985324448279305`*^9, 3.3985324841716805`*^9}, {
  3.46677153783539*^9, 3.4667715542257004`*^9}, {3.466771616005764*^9, 
  3.466771697582323*^9}, {3.466771815533183*^9, 3.4667718267517176`*^9}, {
  3.466771900109684*^9, 3.4667719232186155`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"7e3d2e06-e59c-47fe-b650-e172551d09d9"],

Cell["Superimpose the two orbits onto the vector field:", "Text",ExpressionUUID->"d916b5a7-649a-4e8f-85bc-6a5c1adcb96f"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"graph3", ",", "graph1", ",", "graph2", ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.3985325337029305`*^9, 3.3985325841404305`*^9}, {
