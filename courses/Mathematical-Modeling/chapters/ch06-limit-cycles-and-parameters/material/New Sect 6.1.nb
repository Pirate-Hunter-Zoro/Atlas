Notebook[{

Cell[CellGroupData[{
Cell[" Section 6.1", "Title",ExpressionUUID->"d8a8ed4d-3a42-4408-89ab-f97103b86803"],

Cell[TextData[StyleBox["  Cycles and Bifurcation",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"ea87e785-4ef5-49d6-a720-\
0ea1e7adac4a"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellChangeTimes->{3.3985321323591805`*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"f89265ff-8c09-4864-a9e2-bdee92179875"],

Cell[CellGroupData[{

Cell["Introduction: ", "Section",ExpressionUUID->"94298bd9-eab9-400e-bc31-c5bd0c104617"],

Cell[TextData[{
 StyleBox["Linear dynamical systems:", "Subsubsection"],
 "\nWe have been able to categorize stable and unstable equilibrium points \
for ",
 StyleBox["linear",
  FontVariations->{"Underline"->True}],
 " systems.  Basically, the behavior in the vicinity of the equilibrium point \
is the same as the global behavior far away from the equilibrium.\n\n",
 StyleBox["Nonlinear dynamical systems:", "Subsubsection"],
 "\nHowever, ",
 StyleBox["non",
  FontVariations->{"Underline"->True}],
 "linear systems can exhibit a much greater range of behavior.  We have been \
able to better understand the behavior of a nonlinear system in the vicinity \
of the equilibrium point by performing a linear stability analysis.  If the \
corresponding linear system is asymptotically stable, then the nonlinear \
system will be stable as well.  However if the equilibrium point of the \
nonlinear system is unstable, then the situation is less obvious.\n\nA \
non-stable equilibrium forces most orbits to move away within the vicinity of \
the rest point.  If an orbit is repelled by an unstable equilibrium point, \
what happens to it?  It is possible that the orbit can migrate outward to \
infinity.  However, it is also possible that the orbit can tend to a new and \
stable configuration.  In this case, it is possible for the orbit to approach \
a closed cycle that surrounds the unstable equilibrium point."
}], "Text",ExpressionUUID->"e84128aa-465b-4bd1-965a-3881271c8e6a"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example of a Limit Cycle:", "Section",ExpressionUUID->"a1be2231-a14a-4869-8f23-d6addd05dad8"],

Cell[TextData[{
 "The following system of ODEs generates an example of a limit cycle in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "91565833-af57-4398-a0ed-53f5765bd8ce"],
 ".\n\n\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{"      ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x1", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"x2", "[", "t", "]"}], "+", 
       RowBox[{
        RowBox[{"x1", "[", "t", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}], 
     "\n", "      ", 
     RowBox[{
      RowBox[{
       RowBox[{"x2", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"x1", "[", "t", "]"}]}], "+", 
       RowBox[{
        RowBox[{"x2", "[", "t", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}]}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "6433613e-02fc-4866-ad9c-db7283fa1ba0"],
 "\t\n\t"
}], "Text",ExpressionUUID->"7857bd87-12ff-4490-a4e2-3fd5edb5fb62"],

Cell["Solve for the equilibrium point:", "Text",ExpressionUUID->"d8f48181-2a4e-4561-96a8-b50d4c8a2ad2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"0", "\[Equal]", 
       RowBox[{
        RowBox[{"x2", "[", "t", "]"}], "+", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"0", "\[Equal]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x1", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"x2", "[", "t", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
      RowBox[{"x2", "[", "t", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "TableForm"}]], "Input",
 CellChangeTimes->{{3.3985323170623055`*^9, 3.3985323714060555`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"70e1c72d-d529-4f09-8cff-5beac650ec99"],

Cell["\<\
Observe that the equilibrium point corresponds to the origin.

Next, consider an orbit that starts close to the equilibrium point.\
\>", "Text",ExpressionUUID->"735bb23f-f16a-4eda-95c2-72e88ac0d34a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tStop", "=", "10"}], ";"}]], "InputOnly",
 CellLabel->"In[45]:=",ExpressionUUID->"c380ddc0-ba41-4d0f-b380-bfea4c753a77"],

Cell[BoxData[
 RowBox[{"solutionRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"x2", "[", "t", "]"}], "+", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x1", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"x2", "[", "t", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "\[Equal]", ".01"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", "[", "0", "]"}], "\[Equal]", ".05"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
      RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{3.3985323799216805`*^9},
 CellLabel->"In[46]:=",ExpressionUUID->"5612a9c5-8e51-44ee-ab08-40f276c85925"],

Cell[BoxData[
 RowBox[{"graph1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], ",", 
