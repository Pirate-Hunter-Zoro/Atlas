}, Closed]],

Cell[CellGroupData[{

Cell["Example of a Parameter:", "Section",ExpressionUUID->"d8e9baa0-f017-4965-8c63-bc44c18c3c0d"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellLabel->"In[53]:=",ExpressionUUID->"78a779b4-3240-4037-a5fe-557ae00838a2"],

Cell[TextData[{
 "The following system of ODEs generates an example of a limit cycle in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "2aaa85dd-48f5-411f-8862-b0f089cfd8f4"],
 " that comes and goes as a function of a parameter \[Alpha].\n\n\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{"      ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x1", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"x2", "[", "t", "]"}], "+", 
       RowBox[{
        RowBox[{"x1", "[", "t", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}], 
     "\n", "      ", 
     RowBox[{
      RowBox[{
       RowBox[{"x2", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"x1", "[", "t", "]"}]}], "+", 
       RowBox[{
        RowBox[{"x2", "[", "t", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"\[Alpha]", "*", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}]}], 
         ")"}]}]}]}]}]}],
   FontWeight->"Bold"]],ExpressionUUID->
  "c6916eb8-4610-4f21-8718-4287c881c04b"],
 "\n\t\nThe equilibrium point corresponds to the origin."
}], "Text",ExpressionUUID->"f6337be2-74bd-4ae5-b1ab-d6a5fb692401"],

Cell["\<\

In order to visualize the influence of the parameter \[Alpha] on the solution \
orbits, define a function whose argument is the parameter \[Alpha]:\
\>", "Text",ExpressionUUID->"c25c1686-34d3-45fa-afc9-bb33daa5347b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"displayOrbit", "[", 
   RowBox[{
   "\[Alpha]_", ",", "x1Min_", ",", "x1Max_", ",", "x2Min_", ",", "x2Max_"}], 
   "]"}], ":=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tStop", "=", "100"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"solutionRules", "=", "\[IndentingNewLine]", 
      RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox["x1", "\[Prime]",
             MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
           RowBox[{
            RowBox[{"x2", "[", "t", "]"}], "+", 
            RowBox[{
             RowBox[{"x1", "[", "t", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}],
           ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            SuperscriptBox["x2", "\[Prime]",
             MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"x1", "[", "t", "]"}]}], "+", 
            RowBox[{
             RowBox[{"x2", "[", "t", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"\[Alpha]", " ", 
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
                  SuperscriptBox[
                   RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}]}], 
              ")"}]}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x1", "[", "0", "]"}], "\[Equal]", ".01"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x2", "[", "0", "]"}], "\[Equal]", ".05"}]}], 
         "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x1", "[", "t", "]"}], ",", 
          RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"MaxSteps", "\[Rule]", "20000"}]}], "\[IndentingNewLine]", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x1", "[", "t", "]"}], ",", 
          RowBox[{"x2", "[", "t", "]"}]}], "}"}], "/.", "\[InvisibleSpace]", 
        "solutionRules"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"Thickness", "[", ".01", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x1Min", ",", "x1Max"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x2Min", ",", "x2Max"}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Epilog", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", ".03", "]"}], ",", 
            RowBox[{"Point", "[", 
             RowBox[{"{", 
              RowBox[{".01", ",", ".05"}], "}"}], "]"}]}], "}"}], ",", 
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<\[Alpha] = \>\"", ",", "\[Alpha]"}], "}"}], "]"}], 
            ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x1Min", "+", 
               RowBox[{".85", 
                RowBox[{"(", 
                 RowBox[{"x1Max", "-", "x1Min"}], ")"}]}]}], ",", 
              RowBox[{"x2Min", "+", 
               RowBox[{".1", 
                RowBox[{"(", 
                 RowBox[{"x2Max", "-", "x2Min"}], ")"}]}]}]}], "}"}]}], 
           "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3985322650779305`*^9, 3.3985322740310555`*^9}, 
   3.3985326114841805`*^9},
 CellLabel->"In[54]:=",ExpressionUUID->"e94188c6-0bf4-4727-9bf7-61b0d5c9bd8f"],

Cell[TextData[{
 "Consider the following range of values for the parameter: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "6"}], "\[LessEqual]", "\[Alpha]", "\[LessEqual]", "6"}], 
   TraditionalForm]],ExpressionUUID->"d15d5d7f-6ccd-4d1f-a3bb-8d98d3ae82ea"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3985328083279305`*^9, 
  3.3985328294216805`*^9}},ExpressionUUID->"3638d602-4df7-4fa2-84c5-\
f69881383e8d"],

Cell["\<\
Generate a sequence of plots that illustrates the orbit behavior for the \
above values of the parameter \[Alpha]:\
\>", "Text",ExpressionUUID->"a0669e33-6114-4f79-bde8-b3836130a6da"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"displayOrbit", "[", 
    RowBox[{
     RowBox[{"2", "^", "\[Alpha]"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", 
     RowBox[{"-", "6."}], ",", "6"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3985326778904305`*^9, 3.3985326840779305`*^9}, {
  3.3985327360310555`*^9, 3.3985327614373055`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"fac1aadf-1c73-4b4d-a6db-3f5825bd8297"],

Cell["\<\
Observe that for values of the parameter \[Alpha] close to 1, that the \
unstable equilibrium point generates a limit cycle.  However, for \
sufficiently small and sufficiently large values of the parameter \[Alpha], \
the limit cycle suddenly fails to form.

The textbook contains some theory that offers guidance on when limit cycles \
will exist.\
\>", "Text",ExpressionUUID->"74923ce7-472e-404a-bf0a-9872bd4d641e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Summary:", "Section",ExpressionUUID->"875bc75c-7c05-4649-846b-6cf1fe08e7a1"],

Cell["\<\
The implication of the above graphs on the successful formulation of models \
is extremely important.  All models contain parameters specific to their \
formulation.  It is quite possible that the global behavior of a model can \
suddenly and dramatically change as the parameters range over acceptable \
values.  If these sudden changes are consistent with the behavior of the \
physical system which is being modeled, then all is okay.  On the other hand, \
if the sudden changes are inconsistent with the behavior the physical system, \
then this indicates a substantial failing in the model's correct formulation.

The next section will illustrate this behavior for a specific model.\
\>", "Text",ExpressionUUID->"7d6707da-f25c-40df-8a50-116b4e8c2b56"]
}, Closed]]
}, Open  ]]
},
