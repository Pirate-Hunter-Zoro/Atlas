          RowBox[{"1", "-", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "\[Equal]", "10"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "10"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
