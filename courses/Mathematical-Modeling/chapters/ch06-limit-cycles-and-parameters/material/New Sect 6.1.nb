    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3985324124529305`*^9, 3.3985324196091805`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"635d65a6-c389-4a6c-8d05-5958fbabc16b"],

Cell[BoxData[
 RowBox[{"graph2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
