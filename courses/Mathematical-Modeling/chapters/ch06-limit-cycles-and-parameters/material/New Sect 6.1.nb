            RowBox[{
             SuperscriptBox[
              RowBox[{"x1", "[", "t", "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"x2", "[", "t", "]"}], "2"]}], ")"}]}], ")"}]}]}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x1", "[", "t", "]"}]}], "+", 
        RowBox[{
