Notebook[{

Cell[CellGroupData[{
Cell[" Section 8.1", "Title",ExpressionUUID->"e6873c34-9769-43a3-81d5-9f95be6aca07"],

Cell[TextData[StyleBox["  Chaos",
 FontWeight->"Bold"]], "Subtitle",ExpressionUUID->"b177c7dd-f7fc-4822-8e8f-e5f135956c26"],

Cell[CellGroupData[{

Cell["Not all Attractors are Limit Cycles or Equilibria", "Section",ExpressionUUID->"e9ffab3d-63e6-428a-9cc2-5a984a0e4f5b"],

Cell[TextData[{
 "Our analysis of the long-term behavior of orbits has been restricted to \
limit sets that are either equilibria or closed orbits.  In the plane ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "ef828c23-e2bd-4f04-a52b-020eb034b759"],
 ", this is essentially all that can occur.  However in higher dimensional \
spaces, other kinds of limiting behavior may appear, some of it quite \
complicated.  Only one example will be given below to illustrate what this \
behavior might look like for a special case.\n\nConsider a system of ODEs \
which represents a dynamic system in a three-dimensional space (the ",
 "Lorenz equations)",
 ".  Specific values will be assigned to the model parameters.  It should be \
mentioned that tiny variations in the model parameters or in the initial \
starting conditions will produce significantly different orbits."
}], "Text",
 CellChangeTimes->{{3.3986275356195655`*^9, 
  3.3986275418226905`*^9}},ExpressionUUID->"b27272d8-f61b-4ce3-b5eb-\
8a2fbc13616e"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly",
 CellChangeTimes->{3.398610425254178*^9},
 CellLabel->
  "In[322]:=",ExpressionUUID->"cfd0fb4e-3bbf-460f-9551-368c8bdc26be"],

Cell["Consider the following parameter values:", "Text",
 CellChangeTimes->{{3.3986275783851905`*^9, 
  3.3986275860101905`*^9}},ExpressionUUID->"14bc6182-e3a0-4d0a-89a1-\
114ca4b59fab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Mu]", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStop", "=", "1000"}], ";"}]}], "InputOnly",
 CellChangeTimes->{3.3986154179789405`*^9},
 CellLabel->
  "In[323]:=",ExpressionUUID->"7262ac98-368e-4a08-8f9e-e844694ff5ca"],

Cell[TextData[{
 "and calculate a solution orbit corresponding to the initial conditions:\n\n\
\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{"x1", "[", "0", "]"}], "\[Equal]", ".15452897"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "0.29279127"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"x3", "[", "0", "]"}], "\[Equal]", "1.57789784"}], 
   TraditionalForm]}],ExpressionUUID->"5c505547-4170-4b74-9b10-a4a1d2ee2d84"]
}], "Text",
 CellChangeTimes->{{3.3986276511508155`*^9, 
  3.3986276787133155`*^9}},ExpressionUUID->"383b1101-783d-4c0a-85f4-\
19cd6c77aa4d"],

Cell[BoxData[
 RowBox[{"solutionRules", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"x3", "[", "t", "]"}], " ", 
         RowBox[{"x2", "[", "t", "]"}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"x1", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x3", "[", "t", "]"}], "-", "\[Gamma]"}], ")"}], " ", 
         RowBox[{"x1", "[", "t", "]"}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"x2", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x3", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], " ", 
         RowBox[{"x2", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "\[Equal]", ".15452897"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "0.29279127"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x3", "[", "0", "]"}], "\[Equal]", "1.57789784"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
      RowBox[{"x2", "[", "t", "]"}], ",", 
      RowBox[{"x3", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tStop"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", "30000"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3986104549422483`*^9, 3.3986104561766467`*^9}},
 CellLabel->
  "In[326]:=",ExpressionUUID->"7cf1bcbd-d6e4-4be0-bea5-1f08832d24ac"],

Cell["Plot the resulting parametric equations:", "Text",
 CellChangeTimes->{
  3.3986276982758155`*^9},ExpressionUUID->"6cf143c1-bbff-42de-a013-\
7fc623d4acb2"],

Cell[BoxData[
 RowBox[{"plot1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
  "ParametricPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], ",", 
       RowBox[{"x2", "[", "t", "]"}], ",", 
       RowBox[{"x3", "[", "t", "]"}]}], "}"}], "/.", "\[InvisibleSpace]", 
     RowBox[{"Flatten", "[", "solutionRules", "]"}]}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{".15", " ", "tStop"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotPoints", "\[Rule]", "5000"}], ",", "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\"", ",", "\"\<x3\>\""}], "}"}]}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", "  ", "Red"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.3986104633642845`*^9, {3.3986145842289405`*^9, 3.3986145845883155`*^9}, {
   3.3986162484633155`*^9, 3.3986162785101905`*^9}},
 CellLabel->
  "In[327]:=",ExpressionUUID->"c787de8f-991a-450b-b8b9-0520d0439382"],

Cell["\<\
The above graph illustrates a single orbit which oscillates back and forth \
around two attractors.

Use your mouse to rotate the above graph slightly upward to create a new \
viewpoint.

Continue to rotate the graph upwards (to view it slightly from below):\
\>", "Text",
 CellChangeTimes->{{3.3986146237289405`*^9, 3.3986146516664405`*^9}, {
  3.3986146826195655`*^9, 
  3.3986146899008155`*^9}},ExpressionUUID->"9c98c2a1-2ae0-4541-932a-\
653691603035"],

Cell[CellGroupData[{

Cell["\<\
Let's see if we can gather some information about the attractors:\
\>", "Subsection",
 CellChangeTimes->{{3.3986147926820655`*^9, 
  3.3986148099633155`*^9}},ExpressionUUID->"d8fb5ef1-8f31-4d49-8052-\
e28ee94908ec"],

Cell["\<\
Start by performing a standard linear stability of analysis (see Section 3.2).

For our nonlinear system of equations:\
\>", "Text",
 CellChangeTimes->{{3.3986148565726905`*^9, 3.3986148665101905`*^9}, {
   3.3986149861039405`*^9, 3.3986149891195655`*^9}, {3.3986152177289405`*^9, 
   3.3986152259320655`*^9}, {3.3986156054476905`*^9, 3.3986156222445655`*^9}, 
   3.3986164593851905`*^9},ExpressionUUID->"122df9d4-10ae-4a54-8a0b-\
c1b9210d4247"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["x1", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
     RowBox[{
      RowBox[{
       RowBox[{"x3", "[", "t", "]"}], " ", 
       RowBox[{"x2", "[", "t", "]"}]}], "-", 
      RowBox[{"\[Mu]", " ", 
       RowBox[{"x1", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x2", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x3", "[", "t", "]"}], "-", "\[Gamma]"}], ")"}], " ", 
       RowBox[{"x1", "[", "t", "]"}]}], "-", 
      RowBox[{"\[Mu]", " ", 
       RowBox[{"x2", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x3", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], " ", 
       RowBox[{"x2", "[", "t", "]"}]}]}]}]}], "\[IndentingNewLine]", "}"}], "//",
   "Column"}]], "Input",
 CellChangeTimes->{{3.3986156542445655`*^9, 3.3986156637914405`*^9}},
 CellLabel->
  "In[328]:=",ExpressionUUID->"0fcb019d-93c9-4bad-adc0-1be7afd9ffe2"],

Cell["\<\
 Define the right-hand side functions for each differential equation:\
\>", "Text",
 CellChangeTimes->{{3.3986156299633155`*^9, 3.3986156324008155`*^9}, {
  3.3986156718851905`*^9, 
  3.3986157220883155`*^9}},ExpressionUUID->"27e92749-df19-468f-aa87-\
c79090d8c020"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"x3", "  ", "x2"}], "-", 
   RowBox[{"\[Mu]", " ", "x1"}]}]}]], "Input",
 CellChangeTimes->{{3.3986155164476905`*^9, 3.3986155233539405`*^9}},
 CellLabel->
  "In[329]:=",ExpressionUUID->"efcb80e0-92c4-4c3e-8465-fd8697915eda"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x3", "-", "\[Gamma]"}], ")"}], " ", "x1"}], "-", 
   RowBox[{"\[Mu]", " ", "x2"}]}]}]], "Input",
 CellChangeTimes->{{3.3986154781664405`*^9, 3.3986154879633155`*^9}, {
  3.3986155259633155`*^9, 3.3986155304164405`*^9}},
 CellLabel->
  "In[330]:=",ExpressionUUID->"8466deb0-e54c-47c0-8f1d-57ce32143215"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f3", "[", 
   RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}], "=", 
  RowBox[{"1", "-", 
   RowBox[{"x1", "  ", "x2"}]}]}]], "Input",
 CellChangeTimes->{{3.3986154996039405`*^9, 3.3986155340726905`*^9}},
 CellLabel->
  "In[331]:=",ExpressionUUID->"694b77a0-849e-42a0-8fd2-216d5ac05327"],

Cell["Generate a plot of the \"3-D phase space\" for the 3 ODEs:", "Text",
 CellChangeTimes->{{3.3986156299633155`*^9, 3.3986156324008155`*^9}, {
  3.3986156718851905`*^9, 3.3986156856664405`*^9}, {3.3986158174633155`*^9, 
  3.3986158277758155`*^9}, {3.3986164047758155`*^9, 
  3.3986164067758155`*^9}},ExpressionUUID->"87260b6a-d8d6-44b9-9116-\
5dd7d6de8c26"],

Cell[BoxData[
 RowBox[{"plot2", " ", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"VectorPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f1", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}], ",", 
      RowBox[{"f2", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}], ",", 
      RowBox[{"f3", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x1", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x2", ",", 
      RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x3", ",", "0", ",", "5"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Axes", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\"", ",", "\"\<x3\>\""}], "}"}]}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.398348189611*^9, 3.398348225016*^9}, {
   3.3986157423383155`*^9, 3.3986157835883155`*^9}, {3.3986158458070655`*^9, 
   3.3986158645883155`*^9}, {3.3986159319633155`*^9, 3.3986160139164405`*^9}, 
   3.3986161887914405`*^9, {3.3986163117289405`*^9, 3.3986163229008155`*^9}, 
   3.3986164378851905`*^9, {3.3986164766664405`*^9, 3.3986164770570655`*^9}, {
   3.466958610637599*^9, 3.466958620731284*^9}},
 CellLabel->
  "In[332]:=",ExpressionUUID->"2746da71-93e6-4e50-9f65-66815a835669"],

Cell[TextData[{
 "Show both the ",
 StyleBox["specific",
  FontVariations->{"Underline"->True}],
 " solution attained above using the ",
 StyleBox["specific",
  FontVariations->{"Underline"->True}],
 " initial conditions:\n\n\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{"x1", "[", "0", "]"}], "\[Equal]", ".15452897"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "0.29279127"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"x3", "[", "0", "]"}], "\[Equal]", "1.57789784"}], 
   TraditionalForm]}],ExpressionUUID->"60d6cdb6-1282-4aaa-81fd-625771f054a9"],
 " \n\t\nsuperimposed with the 3-D phase space:"
}], "Text",
 CellChangeTimes->{{3.3986164955726905`*^9, 3.3986165182445655`*^9}, {
  3.3986166014633155`*^9, 
  3.3986166496976905`*^9}},ExpressionUUID->"5414e8bb-d53a-4d41-b5ba-\
cbab5fea06ba"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{"plot1", ",", "\[IndentingNewLine]", "plot2"}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3986163345726905`*^9, 3.3986163527289405`*^9}},
 CellLabel->
  "In[333]:=",ExpressionUUID->"3ff86d14-1a68-49c5-92e3-02244395fb33"],

Cell["\<\
The above plot is all but impossible to decipher in a meaningful fashion.

However, we will continue to determine the nature of the 2 attractors.\
\>", "Text",
 CellChangeTimes->{{3.3986165330570655`*^9, 3.3986165526351905`*^9}, {
  3.3986166691820655`*^9, 3.3986167251351905`*^9}, {3.3986263390726905`*^9, 
  3.3986263523226905`*^9}},ExpressionUUID->"c8702981-ac55-4fc7-beba-\
a4947eae7a54"],

Cell["Find the equilibrium points:", "Text",
 CellChangeTimes->{{3.3986265454633155`*^9, 
  3.3986265457601905`*^9}},ExpressionUUID->"20b79818-1717-4788-9886-\
154a8f16ae03"],

Cell[BoxData[
 RowBox[{"TableForm", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"equilibriumPts", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"f1", "[", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}], "\[Equal]", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"f2", "[", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}], "\[Equal]", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"f3", "[", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}], "\[Equal]", "0"}]}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3983489562130003`*^9, 3.398348959394*^9}, {
  3.3986170753695655`*^9, 3.3986171095414405`*^9}, {3.3986174317914405`*^9, 
  3.3986174752601905`*^9}},
 CellLabel->
  "In[334]:=",ExpressionUUID->"b1f115ec-0c01-4308-947b-8f5437c51b1a"],

Cell["\<\
The last two solutions correspond to the real valued equilibrium points.\
\>", "Text",
 CellChangeTimes->{{3.3986184713695655`*^9, 
  3.3986184870570655`*^9}},ExpressionUUID->"39d5fb0e-19bd-4b75-9399-\
9b883bb233f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"equilibriumPtsReal", "=", 
    RowBox[{"Take", "[", 
     RowBox[{"equilibriumPts", ",", 
      RowBox[{"-", "2"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"equilibriumPtsReal", "//", "TableForm"}]}], "Input",
 CellChangeTimes->{{3.3986174902133155`*^9, 3.3986174989476905`*^9}, {
  3.3986185161195655`*^9, 3.3986185374164405`*^9}},
 CellLabel->
  "In[335]:=",ExpressionUUID->"69dc4099-a1ef-440c-be69-d050364e7ede"],

Cell["Or more conveniently:", "Text",
 CellChangeTimes->{{3.3986185648226905`*^9, 
  3.3986185676820655`*^9}},ExpressionUUID->"97d12795-6d7f-4e36-a5f2-\
f779bdf63799"],

Cell[BoxData[
 RowBox[{
  RowBox[{"equilibriumPtsReal", "//", "N"}], "//", "TableForm"}]], "Input",
 CellChangeTimes->{{3.3986175125570655`*^9, 3.3986175234633155`*^9}, 
   3.3986185524476905`*^9},
 CellLabel->
  "In[337]:=",ExpressionUUID->"26a2cc8a-c90b-4647-8f7f-109ebb6b43de"],

Cell["We can now plot the location of the two equilibrium points:", "Text",
 CellChangeTimes->{{3.3986263805726905`*^9, 3.3986264175414405`*^9}, {
  3.3986265606820655`*^9, 
  3.3986265607758155`*^9}},ExpressionUUID->"7eab12d6-bc12-41a2-983e-\
1bdc7bf186a8"],

Cell[BoxData[
 RowBox[{"eqPlot", "=", "\[IndentingNewLine]", 
  RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Blue", ",", 
      RowBox[{"PointSize", "[", ".03", "]"}], ",", 
      RowBox[{"Point", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], "/.", 
        "equilibriumPtsReal"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "5"}], "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Axes", "\[Rule]", "  ", "True"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3986186379789405`*^9, 3.3986187465726905`*^9}, {
   3.3986188139945655`*^9, 3.3986188140570655`*^9}, {3.3986188940883155`*^9, 
   3.3986189495414405`*^9}, 3.3986282632601905`*^9},
 CellLabel->
  "In[338]:=",ExpressionUUID->"4185a012-cd5a-4f2c-89b6-67d24f1cec30"],

Cell["\<\
And we can see how the two equilibrium points relate to the solution \
calculated above:\
\>", "Text",
 CellChangeTimes->{{3.3986264320414405`*^9, 3.3986264513851905`*^9}, {
  3.3986265724789405`*^9, 
  3.3986265725726905`*^9}},ExpressionUUID->"af887024-fae1-419d-b6ee-\
0e1c168605b5"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"plot1", ",", "eqPlot"}], "]"}]], "Input",
 CellChangeTimes->{{3.3986187502758155`*^9, 3.3986187628070655`*^9}, 
   3.3986187994008155`*^9},
 CellLabel->
  "In[339]:=",ExpressionUUID->"555e370b-6727-4df8-a4b7-5954e0080a7b"],

Cell[TextData[{
 "The above plot suggests that the equilibrium points will ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " be stable.\n\nIn order to verify this, start by calculating the Jacobian \
matrix:"
}], "Text",
 CellChangeTimes->{{3.3986265879789405`*^9, 
  3.3986266311664405`*^9}},ExpressionUUID->"9bd17d8b-e973-4ae0-bef9-\
bb1c1c6a73bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", "=", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{
         SubscriptBox["\[PartialD]", "x1"], " ", 
         RowBox[{"f1", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x2"], " ", 
         RowBox[{"f1", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x3"], " ", 
         RowBox[{"f1", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}]},
       {
        RowBox[{
         SubscriptBox["\[PartialD]", "x1"], " ", 
         RowBox[{"f2", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x2"], " ", 
         RowBox[{"f2", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x3"], " ", 
         RowBox[{"f2", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}]},
       {
        RowBox[{
         SubscriptBox["\[PartialD]", "x1"], " ", 
         RowBox[{"f3", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x2"], " ", 
         RowBox[{"f3", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x3"], " ", 
         RowBox[{"f3", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}]}
      }], "\[NoBreak]", ")"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"A", "//", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.3986182112758155`*^9, 3.3986182395726905`*^9}, {
  3.3986182822758155`*^9, 3.3986183017601905`*^9}, {3.3986183404164405`*^9, 
  3.3986183722133155`*^9}, {3.3986268855258155`*^9, 3.3986268893539405`*^9}},
 CellLabel->
  "In[340]:=",ExpressionUUID->"6d4e861a-f170-47f8-97d0-41eac7cc4e1f"],

Cell[TextData[{
 "Evaluate the Jacobian matrix at the ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " equilibrium points."
}], "Text",
 CellChangeTimes->{{3.3986266519945655`*^9, 
  3.3986266574476905`*^9}},ExpressionUUID->"fdd5fbf1-5c0a-44f1-9a61-\
95abc74150f0"],

Cell[BoxData[
 RowBox[{"Map", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"MatrixForm", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"A", " ", "/.", "equilibriumPtsReal"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3986266904476905`*^9, 3.3986267467445655`*^9}, {
  3.3986268089008155`*^9, 3.3986268132601905`*^9}, {3.3986268982445655`*^9, 
  3.3986269516039405`*^9}},
 CellLabel->
  "In[342]:=",ExpressionUUID->"3f1b82a9-bc70-49cf-90d6-1ee1bf2d9a63"],

Cell["Or more conveniently:", "Text",
 CellChangeTimes->{{3.3986267755726905`*^9, 
  3.3986267756508155`*^9}},ExpressionUUID->"0cf550bb-2f1a-4351-b771-\
cda2c950e554"],

Cell[BoxData[
 RowBox[{"Map", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"MatrixForm", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", " ", "/.", "equilibriumPtsReal"}], "//", "N"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3986267889945655`*^9, 3.3986268045101905`*^9}, {
  3.3986269733226905`*^9, 3.3986269774789405`*^9}},
 CellLabel->
  "In[343]:=",ExpressionUUID->"aaf3cfb8-4c5d-451e-8655-4de537b3d0de"],

Cell[TextData[{
 "We can now calculate the ",
 StyleBox["three",
  FontVariations->{"Underline"->True}],
 " eigenvalues for each of the ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " equilibrium points:"
}], "Text",
 CellChangeTimes->{{3.3986270497133155`*^9, 3.3986270760570655`*^9}, {
  3.3986278219320655`*^9, 
  3.3986278242445655`*^9}},ExpressionUUID->"fc8c297e-d251-48ee-9fd2-\
4bbc01b542e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Map", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Eigenvalues", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"A", " ", "/.", "equilibriumPtsReal"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.3986268467445655`*^9, 3.3986268709320655`*^9}, {
  3.3986270035726905`*^9, 3.3986270087601905`*^9}},
 CellLabel->
  "In[344]:=",ExpressionUUID->"b9425871-375c-4b61-b9c5-88df4a69a521"],

Cell["\<\
We can see above that some of the eigenvalues have real part equal to 0.  \
Therefore, we are not guaranteed stability.

When we re-examine the equilibrium points and the solution calculated above, \
it appears that the solution orbits the equilibrium points forever in a \
chaotic fashion, but without approaching them.\
\>", "Text",
 CellChangeTimes->{{3.3986271046351905`*^9, 3.3986271548070655`*^9}, {
  3.3986272040101905`*^9, 3.3986272867758155`*^9}, {3.3986278634789405`*^9, 
  3.3986278791508155`*^9}},ExpressionUUID->"a4423e9d-dbe1-4fc4-98d2-\
ee908ddd5930"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"plot1", ",", "eqPlot"}], "]"}]], "Input",
 CellChangeTimes->{{3.3986187502758155`*^9, 3.3986187628070655`*^9}, 
   3.3986187994008155`*^9},
 CellLabel->
  "In[345]:=",ExpressionUUID->"2765c687-efb7-40b1-b248-2ccf0f0f487d"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Are there solutions which get very very close to the two equilibrium points?\
\>", "Subsection",
 CellChangeTimes->{{3.3986272974320655`*^9, 3.3986274353851905`*^9}, {
  3.3986880013918047`*^9, 
  3.3986880286419787`*^9}},ExpressionUUID->"b408882b-c048-46b8-b063-\
8a19642adc8e"],

Cell[TextData[{
 "We might ask ourselves, are there solutions which might get very very close \
to the two equilibrium points?  If so, how might we find them?\n\nOne \
procedure might be to calculate a solution with an initial condition \
extremely close to our equilibrium points and calculate the solution that \
would get there by integrating ",
 StyleBox["backwards",
  FontVariations->{"Underline"->True}],
 " in time:"
}], "Text",
 CellChangeTimes->{{3.3986272974320655`*^9, 
  3.3986274353851905`*^9}},ExpressionUUID->"ca09d6dd-11d6-4123-bd63-\
23fe263c5210"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solutionRulesBackward", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x10_", ",", "x20_", ",", "x30_"}], "}"}], ",", "t0_"}], "]"}], ":=",
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"x3", "[", "t", "]"}], " ", 
         RowBox[{"x2", "[", "t", "]"}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"x1", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x3", "[", "t", "]"}], "-", "\[Gamma]"}], ")"}], " ", 
         RowBox[{"x1", "[", "t", "]"}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"x2", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x3", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"x1", "[", "t", "]"}], " ", 
         RowBox[{"x2", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "\[Equal]", "x10"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "x20"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x3", "[", "0", "]"}], "\[Equal]", "x30"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "[", "t", "]"}], ",", 
      RowBox[{"x2", "[", "t", "]"}], ",", 
      RowBox[{"x3", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"-", "t0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", "100000"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3986283869789405`*^9, 3.3986284842758155`*^9}, {
  3.3986285195101905`*^9, 3.3986285377601905`*^9}, {3.3986290597133155`*^9, 
  3.3986290851664405`*^9}, {3.3986292085570655`*^9, 3.3986292261976905`*^9}},
 CellLabel->
  "In[346]:=",ExpressionUUID->"ff81a806-db4d-443d-ac60-b8cd23d8d20b"],

Cell["\<\

We will calculate two solutions located very close to one of the two \
equilibrium points.

One solution starts to one side of the equilibrium point:\
\>", "Text",
 CellChangeTimes->{{3.3986297174476905`*^9, 
  3.3986297878383155`*^9}},ExpressionUUID->"b6fd06dc-e0d9-4fbf-b225-\
e27c6a641fab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"soln1", "[", "t_", "]"}], "=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", "[", "t", "]"}], ",", 
     RowBox[{"x2", "[", "t", "]"}], ",", 
     RowBox[{"x3", "[", "t", "]"}]}], "}"}], "/.", "\[IndentingNewLine]", 
   RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
    RowBox[{"solutionRulesBackward", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "1.553771559816475", ",", "0.6435952529055827", ",", 
        "2.414213562373095"}], "}"}], ",", "\[IndentingNewLine]", "10"}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.3986287299789405`*^9, 3.3986287398695655`*^9}, {
  3.3986288161508155`*^9, 3.3986288646820655`*^9}, {3.3986292498851905`*^9, 
  3.3986292535570655`*^9}, {3.3986293017445655`*^9, 3.3986293047445655`*^9}, {
  3.3986298299476905`*^9, 3.3986298426195655`*^9}},
 CellLabel->
  "In[347]:=",ExpressionUUID->"948e07ee-63b8-4f61-a552-569d0837a2a9"],

Cell["\<\
and the other solution starts at an equal and opposite direction from the \
other solution:\
\>", "Text",
 CellChangeTimes->{{3.3986298671976905`*^9, 
  3.3986298897914405`*^9}},ExpressionUUID->"eff218f5-d0e3-495e-a543-\
9396a4ca3898"],

Cell[BoxData[
 RowBox[{
  RowBox[{"soln2", "[", "t_", "]"}], "=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", "[", "t", "]"}], ",", 
     RowBox[{"x2", "[", "t", "]"}], ",", 
     RowBox[{"x3", "[", "t", "]"}]}], "}"}], "/.", "\[IndentingNewLine]", 
   RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
    RowBox[{"solutionRulesBackward", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "1.5537763882435998", ",", "0.6435932529055827", ",", 
        "2.414213562373095"}], "}"}], ",", "\[IndentingNewLine]", "10"}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.3986288960101905`*^9, 3.3986289057601905`*^9}, {
  3.3986292670414405`*^9, 3.3986292675883155`*^9}, {3.3986293094476905`*^9, 
  3.3986293101664405`*^9}, {3.3986298472758155`*^9, 3.3986298556039405`*^9}},
 CellLabel->
  "In[348]:=",ExpressionUUID->"2fb7fce7-afaf-41ae-a77f-b182a8b7a53f"],

Cell["\<\
We can examine these two solutions (originating very close, but on opposite \
sides of one of the equilibrium points):\
\>", "Text",
 CellChangeTimes->{{3.3986300138070655`*^9, 
  3.3986300441351905`*^9}},ExpressionUUID->"f8f4d5c7-eda7-4cfa-82a2-\
35e95049a73c"],

Cell[BoxData[
 RowBox[{"plot4", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
  "ParametricPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"soln1", "[", "t", "]"}], ",", 
      RowBox[{"soln2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"-", "10"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.01", "]"}], ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"1", ",", "1", ",", "0"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.01", "]"}], ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0", ",", "1", ",", "0"}], "]"}]}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", "  ", "25"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.3986289524164405`*^9, 3.3986289650258155`*^9}, {
   3.3986290073851905`*^9, 3.3986290386820655`*^9}, {3.3986291208539405`*^9, 
   3.3986291718695655`*^9}, {3.3986292811195655`*^9, 
   3.3986293200726905`*^9}, {3.3986293705414405`*^9, 3.3986294049945655`*^9}, 
   3.3986295136039405`*^9, {3.3986299356664405`*^9, 3.3986299508539405`*^9}},
 CellLabel->
  "In[349]:=",ExpressionUUID->"d6ab1fd9-3bd9-4243-bb41-958c296f6f50"],

Cell["\<\
Finally, we can examine our solution orbit, the two equilibrium points and \
two solutions that would approach (but not touch) one of the two equilibrium \
points (from opposite sides):\
\>", "Text",
 CellChangeTimes->{{3.3986300738226905`*^9, 3.3986301411820655`*^9}, {
  3.3986301999320655`*^9, 
  3.3986302051195655`*^9}},ExpressionUUID->"10fad25b-7918-491c-b76b-\
8c24231f6620"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
  "plot1", ",", "\[IndentingNewLine]", "plot4", ",", "\[IndentingNewLine]", 
   "eqPlot", ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "5"}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3986187502758155`*^9, 3.3986187628070655`*^9}, 
   3.3986187994008155`*^9, {3.3986294325414405`*^9, 3.3986294351351905`*^9}, {
   3.3986294891664405`*^9, 3.3986294905883155`*^9}, {3.3986295282601905`*^9, 
   3.3986295576508155`*^9}, {3.3986301453383155`*^9, 3.3986301507601905`*^9}},
 CellLabel->
  "In[350]:=",ExpressionUUID->"50dc7719-e316-4da3-a787-b911d933f197"],

Cell["\<\
Use your mouse to rotate the above figure and examine it closely.

The following figure displays the convoluted path that the two solutions \
would take in order to approach one of the equilibrium points:\
\>", "Text",
 CellChangeTimes->{{3.3986302230883155`*^9, 
  3.3986302769008155`*^9}},ExpressionUUID->"0196c741-43c0-413a-add8-\
4ba3a2329bb4"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
  "plot1", ",", "\[IndentingNewLine]", "plot4", ",", "\[IndentingNewLine]", 
   "eqPlot", ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4"}], ",", "5"}], "}"}]}], ",", 
      RowBox[{"2", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "3"}], ",", "3"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "6"}], ",", "10"}], "}"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3986187502758155`*^9, 3.3986187628070655`*^9}, 
   3.3986187994008155`*^9, {3.3986294325414405`*^9, 3.3986294351351905`*^9}, {
   3.3986294891664405`*^9, 3.3986294905883155`*^9}, {3.3986295282601905`*^9, 
   3.3986295576508155`*^9}, {3.3986296033851905`*^9, 
   3.3986296512914405`*^9}, {3.3986302840101905`*^9, 3.3986302911039405`*^9}},
 CellLabel->
  "In[351]:=",ExpressionUUID->"ff041539-e07f-4940-b6fe-ab9fc6d88fe0"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["A Chaotic Circuit ", "Section",ExpressionUUID->"15f710f8-af49-4b0b-8558-f57fac36e937"],

Cell[TextData[{
 "Analysis of a simple electric circuit that displays chaotic behavior\nThis \
example is from the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " Help."
}], "Text",
 CellChangeTimes->{{3.3986105584596043`*^9, 
  3.398610559928363*^9}},ExpressionUUID->"e0625362-8491-41e3-87f3-\
08f8790a31c3"],

Cell[TextData[{
 "Here is a simple circuit containing a sinusoidal voltage source:  \[Nu] \
Sin[2 \[Pi] \[ScriptF] t], a resistor: ",
 Cell[BoxData[
  SubscriptBox["R", "1"]],
  FontWeight->"Bold",ExpressionUUID->"1ad98a4a-1468-452a-99a7-c33ecf75a187"],
 ", inductor: ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox["L", "1"],
   FontWeight->"Bold"]],ExpressionUUID->
  "46b4e4ad-8fc6-445b-a789-d79abc4134b4"],
 ", and diode: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "1"], TraditionalForm]],ExpressionUUID->
  "158ace55-7b74-4e79-b862-557ae24943b6"],
 ". The presence of the diode introduces nonlinearity and allows for the \
possibility of complex behavior."
}], "Text",ExpressionUUID->"784fb267-3535-4d81-b893-16791fa32bf0"],

