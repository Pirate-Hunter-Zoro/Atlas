Cell[TextData[{
 "We model the diode as having a piecewise\[Dash]linear capacitance from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "5c275bc9-9a7a-4eea-9c2a-626204123eaf"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "12ed6a58-be2a-440b-94f3-4c99b90efdf2"],
 " with a small offset voltage: ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox["E", "0"],
   FontWeight->"Bold"]],ExpressionUUID->
  "b430cae7-b077-4244-ad8e-879bd39ef70a"],
 ". "
}], "Text",ExpressionUUID->"f3879183-bd8d-492c-b8ba-8c0896930af2"],

Cell[TextData[{
 "The ODEs and initial conditions for the charge and current in the diode can \
be written directly in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "."
}], "Text",ExpressionUUID->"34e7432f-0dc8-414a-8609-69adfb850f4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eqns", "=", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["q", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"i", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       SubscriptBox["L", "1"], " ", 
       RowBox[{
        SuperscriptBox["i", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], "\[Equal]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["R", "1"]}], " ", 
        RowBox[{"i", "[", "t", "]"}]}], "-", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["C", "2"], "-", 
             SubscriptBox["C", "1"]}], ")"}], " ", 
           RowBox[{"Abs", "[", 
            RowBox[{"q", "[", "t", "]"}], "]"}]}], 
          RowBox[{"2", " ", 
           SubscriptBox["C", "1"], " ", 
           SubscriptBox["C", "2"]}]], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["C", "1"], "+", 
             SubscriptBox["C", "2"]}], ")"}], " ", 
           RowBox[{"q", "[", "t", "]"}]}], 
          RowBox[{"2", " ", 
           SubscriptBox["C", "1"], " ", 
           SubscriptBox["C", "2"]}]], "+", 
         SubscriptBox["\[ExponentialE]", "0"]}], ")"}], "+", 
       RowBox[{"\[ScriptCapitalV]", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", " ", "\[Pi]", " ", "\[ScriptF]", " ", "t"}], 
         "]"}]}]}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"i", "[", "0", "]"}], "\[Equal]", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "InputOnly",
 CellChangeTimes->{
  3.398610574553457*^9, {3.466958846068567*^9, 3.4669588488493896`*^9}},
 AspectRatioFixed->True,
 CellLabel->
  "In[352]:=",ExpressionUUID->"ecf58f05-fbcc-49ff-b6bc-945c2de803cc"],

Cell["This substitutes values for parameters into the equations.", "Text",ExpressionUUID->"d4b549f9-ceaf-4b62-8c94-f7b241d9d426"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eqns", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"eqns", "/.", "\[InvisibleSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["C", "1"], "\[Rule]", 
        FractionBox["0.1", 
         SuperscriptBox["10", "6"]]}], ",", 
       RowBox[{
        SubscriptBox["C", "2"], "\[Rule]", 
        FractionBox["400.", 
         SuperscriptBox["10", "12"]]}], ",", 
       RowBox[{
        SubscriptBox["R", "1"], "\[Rule]", "60."}], ",", 
       RowBox[{
        SubscriptBox["L", "1"], "\[Rule]", 
        FractionBox["100.", 
         SuperscriptBox["10", "6"]]}], ",", 
       RowBox[{"\[ScriptF]", "\[Rule]", "700000."}], ",", 
       RowBox[{
        SubscriptBox["\[ExponentialE]", "0"], "\[Rule]", "0.1"}]}], "}"}]}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"eqns", "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3986881951899195`*^9, 3.398688203080595*^9}},
 AspectRatioFixed->True,
 CellLabel->
  "In[353]:=",ExpressionUUID->"c9531293-8790-4a25-a3f1-c14979a15c2e"],

Cell[TextData[{
 "It is possible to solve the equations by using the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function ",
 StyleBox["NDSolve", "InlineInput"],
 "."
}], "Text",ExpressionUUID->"8ea70a6d-c9c5-48a4-8f52-5c54983d7be8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sol", "[", "v_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqns", "/.", "\[InvisibleSpace]", 
     RowBox[{"\[ScriptCapitalV]", "\[Rule]", "v"}]}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"q", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      FractionBox["1.4", 
       SuperscriptBox["10", "4"]]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"MaxSteps", "\[Rule]", 
     SuperscriptBox["10", "4"]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.398610605131778*^9, 3.398610606288035*^9}},
 CellLabel->
  "In[355]:=",ExpressionUUID->"0e031fa7-b108-4015-9e81-e761c1b46f74"],

Cell["\<\
Here are the solutions for the charge as a function of time for values of the \
driving voltage \[ScriptCapitalV].\
\>", "Text",ExpressionUUID->"e98be4ab-0d84-41e5-bab1-f10b856ff323"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"q", "[", "t", "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"sol", "[", "\[ScriptCapitalV]", "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       FractionBox["1.2", 
        SuperscriptBox["10", "4"]], ",", 
       FractionBox["1.4", 
        SuperscriptBox["10", "4"]]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLabel", "\[Rule]", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
        "\"\<time vs. Charge for Voltage = \>\"", ",", "\[ScriptCapitalV]"}], 
        "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "\[Rule]", "Thick"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["10", 
          RowBox[{"-", "9"}]]}], ",", 
        RowBox[{"2", " ", 
         SuperscriptBox["10", 
          RowBox[{"-", "9"}]]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\[ScriptCapitalV]", ",", "0.1", ",", "0.6"}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"AnimationRate", "\[Rule]", ".01"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.398610388815978*^9, 3.398610395441106*^9}, 
   3.398610613850583*^9, {3.398610655694601*^9, 3.3986107032574053`*^9}, {
   3.398610767835944*^9, 3.3986109153681383`*^9}, 3.398610968134101*^9, {
   3.398611113166279*^9, 3.3986111187444396`*^9}, 3.3986117002133155`*^9},
 CellLabel->
  "In[356]:=",ExpressionUUID->"cad6b071-6cee-43fc-a587-b89507c86695"],

Cell["\<\
Here are the parametric plots of the charge versus current for the same \
values of the driving voltage \[ScriptCapitalV].\
\>", "Text",ExpressionUUID->"bfbd659d-a691-4153-84a9-f5531f4251be"],

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
   "ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
