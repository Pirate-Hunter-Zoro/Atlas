Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \nAdvanced Lesson 2\n\nInteger, Rational and Real numbers\nN[...]\n\nDr. \
Dale R. Doty\nUniversity of Tulsa"
}], "Title",
 CellChangeTimes->{{3.390791651448*^9, 3.390791666573*^9}, {
  3.523182261156912*^9, 3.5231822636061115`*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Exact Numbers", "Subtitle"]], "Section"],

Cell[TextData[{
 "Evaluate",
 " (",
 StyleBox[" ", "Subsubtitle"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Shift\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], "-", 
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Enter\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"]}]],
  CellChangeTimes->{{3.3902570408182*^9, 3.3902570426292*^9}},
  FontSize->14],
 " ) ",
 "the following Input Cell to clear and remove any existing definitions from \
memory before you start this lesson."
}], "Text",
 CellChangeTimes->{{3.3907793381137037`*^9, 3.3907794823047037`*^9}, {
   3.3907795655947037`*^9, 3.3907795802237043`*^9}, 3.43906014503125*^9}],

Cell[BoxData[
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]], "InputOnly",
 CellChangeTimes->{3.390781505206704*^9}],

Cell[TextData[{
 StyleBox["\nMathematica",
  FontSlant->"Italic"],
 " has several representations for numbers: \n\n\tExact (i.e. \
\[Infinity]-digit) numbers including ",
 StyleBox["integer",
  FontWeight->"Bold"],
 " and ",
 StyleBox["rational",
  FontWeight->"Bold"],
 " numbers, and exact complex numbers.\n\t\n\tApproximate numbers represented \
as ",
 StyleBox["real",
  FontWeight->"Bold"],
 " (i.e. finite-digit) and approximate complex numbers \n\t(i.e. decimal \
approximations).  \n\n",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will ",
 StyleBox["always",
  FontVariations->{"Underline"->True}],
 " attempt to keep a number in exact form (i.e. \[Infinity]-digit) unless: \n\
\n\teither real or approximate complex numbers are used or ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is specifically instructed \n\t(by using  ",
 StyleBox["N[ ... ]",
  FontWeight->"Bold"],
 ") to replace an exact number (i.e. \[Infinity]-digit) with an approximation \
(i.e. finite-digit).\n\nEvaluate the following arithmetic expressions \
involving ",
 StyleBox["exact",
  FontVariations->{"Underline"->True}],
 " (i.e. \[Infinity]-digit) ",
 StyleBox["integer",
  FontWeight->"Bold"],
 " and ",
 StyleBox["rational",
  FontWeight->"Bold"],
 " arithmetic:"
}], "Text",
 CellChangeTimes->{{3.390129124559*^9, 3.3901291579119997`*^9}, {
   3.3901698143076*^9, 3.3901698170615997`*^9}, 3.390781526366704*^9, {
   3.3907878470179996`*^9, 3.39078794017*^9}, {3.390787977352*^9, 
   3.39078797985*^9}, {3.390788011333*^9, 3.390788017039*^9}, {
   3.390788281234*^9, 3.390788425328*^9}, 3.4390601860625*^9, {
   3.439061725765625*^9, 3.439061728640625*^9}}],

Cell[BoxData[
 RowBox[{"34", " ", "+", " ", "55"}]], "Input"],

Cell[BoxData[
 RowBox[{"34", "/", "55"}]], "Input"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", "+", " ", 
   RowBox[{"4", " ", "\[ImaginaryI]"}]}], 
  RowBox[{"5", " ", "+", " ", 
   RowBox[{"6", " ", "\[ImaginaryI]"}]}]]], "Input"],

Cell[BoxData[
 RowBox[{"2", "+", 
  RowBox[{"3", "/", "4"}]}]], "Input",
 CellChangeTimes->{{3.3901689300276003`*^9, 3.3901689356046*^9}}],

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{
   FractionBox["3", "4"], "*", 
   RowBox[{"(", 
    RowBox[{"12", "+", 
     FractionBox["1", "3"]}], ")"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.3901696999955997`*^9, 3.3901697287946*^9}}],

Cell[BoxData[
 RowBox[{"Expand", "[", 
  FractionBox[
   RowBox[{"3", "+", 
    RowBox[{"2", 
     RowBox[{"Sin", "[", "2", "]"}]}]}], "4"], "]"}]], "Input",
 CellChangeTimes->{{3.3901689507746*^9, 3.3901690821636*^9}}],

Cell[BoxData[
 SqrtBox[
  SqrtBox[
   SqrtBox["2"]]]], "Input",
 CellChangeTimes->{{3.3901691129105997`*^9, 3.3901691370086*^9}}],

Cell[TextData[{
 "\nObserve that in ",
 StyleBox["all",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " cases the above expressions are maintained in ",
 StyleBox["exact",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " (i.e. \[Infinity]-digit) form.  "
}], "Text",
 CellChangeTimes->{{3.3901697620726*^9, 3.3901697890536003`*^9}, 
   3.4390602620625*^9}],

Cell["\<\
Some irrational real numbers are stored as exact (i.e. \[Infinity]-digit) \
constants, thereby allowing them to be maintained in exact (i.e. \
\[Infinity]-digit) form.  Evaluate the following:\
\>", "Text",
 CellChangeTimes->{{3.3901698670425997`*^9, 3.3901698699245996`*^9}, 
   3.3907886515959997`*^9}],

Cell[BoxData["\[Pi]"], "Input"],

Cell[BoxData["\[ExponentialE]"], "Input"],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  RowBox[{"\[Pi]", "/", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.3901692422855997`*^9, 3.3901692590576*^9}}],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", "2"], "*", 
  SuperscriptBox["\[ExponentialE]", "3"]}]], "Input",
 CellChangeTimes->{{3.3901691631506*^9, 3.3901691831696*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Log", "[", 
   SuperscriptBox["\[ExponentialE]", 
    SqrtBox["2"]], "]"}]}]], "Input",
 CellChangeTimes->{{3.3901692723366003`*^9, 3.3901692981736*^9}, 
   3.3901699151816*^9}],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  RowBox[{"\[Pi]", "/", "3"}], "]"}]], "Input",
 CellChangeTimes->{{3.3901693046356*^9, 3.3901693143206*^9}}],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  RowBox[{"\[Pi]", "/", "7"}], "]"}]], "Input",
 CellChangeTimes->{{3.3901693344736*^9, 3.3901693447005997`*^9}}],

Cell[TextData[{
 "\nThe numbers 2, 3/4, 3+4\[ImaginaryI], ",
 Cell[BoxData[
  FormBox[
   SqrtBox["2"], TraditionalForm]]],
 ", Sin[2], \[Pi]/2, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", "2"], TraditionalForm]]],
 " etc. all have \[Infinity]-digit precision"
}], "Text",
 CellChangeTimes->{{3.3901680161566*^9, 3.3901681798176003`*^9}, 
   3.3901693761786003`*^9, {3.3901699412446003`*^9, 3.3901699417076*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Approximate Real and Complex Numbers   N[...]", \
"Subtitle"]], "Section",
 CellChangeTimes->{{3.390129516724*^9, 3.390129522637*^9}, 
   3.439133442296875*^9}],

Cell[CellGroupData[{

Cell["Approximate Numbers:", "Subsection",
 CellChangeTimes->{{3.43906166421875*^9, 3.439061672*^9}}],

Cell[TextData[{
 "Operations in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " can be ",
 StyleBox["forced",
  FontVariations->{"Underline"->True}],
 " into a finite-digit decimal approximation:"
}], "Text",
 CellChangeTimes->{{3.390788704567*^9, 3.390788741874*^9}, 
   3.43906155521875*^9}],

Cell[BoxData[{
 RowBox[{
  StyleBox[
   RowBox[{"N", "[", "expr", "]"}],
   FontSize->14], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["gives",
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  StyleBox["the",
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  StyleBox["numerical",
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  StyleBox["value",
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  StyleBox["of",
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  StyleBox["expr",
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  StyleBox["to",
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  StyleBox["machine",
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  RowBox[{
   StyleBox["precision",
    FontWeight->"Bold"], 
   StyleBox[".",
    FontWeight->"Bold"], 
   StyleBox[Cell[""],
    FontWeight->"Plain"]}]}]}], "Item",
 CellChangeTimes->{
  3.390130492855*^9, {3.439061570765625*^9, 3.439061581640625*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"34", " ", "+", " ", "55"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"34", "/", "55"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"N", "[", "\[Pi]", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"N", "[", "\[ExponentialE]", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"N", "[", 
  FractionBox[
   RowBox[{"3", " ", "+", " ", 
    RowBox[{"4", " ", "\[ImaginaryI]"}]}], 
   RowBox[{"5", " ", "+", " ", 
    RowBox[{"6", " ", "\[ImaginaryI]"}]}]], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"N", "[", 
  SqrtBox["2"], "]"}]], "Input",
 CellChangeTimes->{{3.3901694046666*^9, 3.3901694113816*^9}}],

Cell[BoxData[
 RowBox[{"N", "[", 
  SuperscriptBox["\[ExponentialE]", "5"], "]"}]], "Input",
 CellChangeTimes->{{3.3901695526426*^9, 3.3901695558306*^9}}],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"Sin", "[", 
   RowBox[{"\[Pi]", "/", "7"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.3901694500116*^9, 3.3901694538306*^9}}],

Cell[TextData[{
 "\nUsually you do ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " have to worry about the arithmetical form that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " uses.  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will ",
 StyleBox["always",
  FontVariations->{"Underline"->True}],
 " try to hold an integer (i.e. \[Infinity]-digit) as an integer until ",
 StyleBox["forced",
  FontVariations->{"Underline"->True}],
 " to use a rational (i.e. \[Infinity]-digit).  A rational (i.e. \
\[Infinity]-digit) will be held as a rational until ",
 StyleBox["forced",
  FontVariations->{"Underline"->True}],
 " into a real (i.e. finite-digit) etc..  \n\nThere are certain circumstances \
where doing ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " computations in exact arithmetic is computationally excessive.  For \
example, using exact arithmetic to generate a graph is undesirable.  You can ",
 StyleBox["force",
  FontVariations->{"Underline"->True}],
 " the arithmetical computation to be real (i.e. approximate) by using the \"",
 StyleBox["N[....]",
  FontWeight->"Bold"],
 "\" command or the corresponding numerical form of a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command.  For example, you can integrate exactly using the \"",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Integrate", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\" command or approximately (and therefore faster) by using the numerical \
\"",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"NIntegrate", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\" command.  You can also ",
 StyleBox["force",
  FontVariations->{"Underline"->True}],
 " real valued (i.e. finite-digit) computation by entering some or all of \
your numbers as real numbers rather than exact integer or rational numbers.  "
}], "Text",
 CellChangeTimes->{
  3.390788911983*^9, {3.3907890926429996`*^9, 3.39078911602*^9}, {
   3.390789168406*^9, 3.390789170105*^9}, {3.3907892458570004`*^9, 
   3.3907892845629997`*^9}, {3.390789571097*^9, 3.3907896718929996`*^9}, {
   3.3907897044630003`*^9, 3.390789760942*^9}, 3.390789812594*^9, {
   3.3907917820179996`*^9, 3.390791782468*^9}, 3.4390629581875*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Example:", "Subsection"],

Cell["For example, consider the two functions: ", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"funcReal", "[", "x_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"3.0", "*", 
    SuperscriptBox["x", "2"]}], " ", "+", " ", 
   RowBox[{"x", "/", "4.0"}]}]}]], "Input",
 CellChangeTimes->{{3.390129537833*^9, 3.390129542653*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"funcRational", "[", "x_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"3", "*", 
    SuperscriptBox["x", "2"]}], " ", "+", " ", 
   RowBox[{"x", "/", "4"}]}]}]], "Input"],

Cell[TextData[{
 "\nThe above two functions differ because one contains approximate real \
numbers  ",
 StyleBox["3.0",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["1/4.0",
  FontWeight->"Bold"],
 "  while the other contains exact numbers  ",
 StyleBox["3",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["1/4",
  FontWeight->"Bold"],
 ".\n\nEvaluate these two functions using ",
 StyleBox["exact",
  FontVariations->{"Underline"->True}],
 " integer and rational numbers along with ",
 StyleBox["exact",
  FontVariations->{"Underline"->True}],
 " real numbers:"
}], "Text",
 CellChangeTimes->{{3.3901295641429996`*^9, 3.390129568152*^9}, {
  3.439060457921875*^9, 3.439060484578125*^9}}],

Cell[BoxData[
 RowBox[{"funcReal", "[", "7", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"funcRational", "[", "7", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"funcReal", "[", 
  RowBox[{"5", "/", "11"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"funcRational", "[", 
  RowBox[{"5", "/", "11"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"funcReal", "[", 
  SqrtBox["2"], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"funcRational", "[", 
  SqrtBox["2"], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"funcReal", "[", "\[Pi]", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"funcRational", "[", "\[Pi]", "]"}]], "Input"],

Cell[TextData[{
 "\nObserve that the function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"funcReal", "[", "x_", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"3.0", "*", 
       SuperscriptBox["x", "2"]}], " ", "+", " ", 
      RowBox[{"x", "/", "4.0"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  ",
 StyleBox["forces",
  FontVariations->{"Underline"->True}],
 " the results to be approximate real numbers because the approximate real \
numbers ",
 StyleBox["3.0",
  FontWeight->"Bold"],
 " and ",
 StyleBox["1/4.0",
  FontWeight->"Bold"],
 " appear within the definition of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"funcReal", "[", "x_", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".  \n\nHowever, observe that the function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"funcRational", "[", "x_", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"3", "*", 
       SuperscriptBox["x", "2"]}], " ", "+", " ", 
      RowBox[{"x", "/", "4"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  forces the results to be exact numbers as long as  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  is also exact because of the exact numbers ",
 StyleBox["3",
  FontWeight->"Bold"],
 " and ",
 StyleBox["1/4",
  FontWeight->"Bold"],
 " appearing within the definition of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"funcRational", "[", "x_", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " (however using an approximate value for  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  will override this and will force an approximate result)."
}], "Text",
 CellChangeTimes->{{3.390129620785*^9, 3.3901296630369997`*^9}, {
   3.390789907358*^9, 3.390789907885*^9}, {3.390789940531*^9, 
   3.390789988718*^9}, {3.390790061218*^9, 3.390790218045*^9}, 
   3.439060502625*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Increasing the degree of numerical accuracy ", "Subsection",
 CellChangeTimes->{{3.3901677348886003`*^9, 3.3901677437746*^9}}],

Cell[TextData[{
 "Finally, all computations ",
 StyleBox["can",
  FontVariations->{"Underline"->True}],
 " be carried out to \"any\" desired degree of numerical accuracy:"
}], "Text",
 CellChangeTimes->{{3.3901677664386*^9, 3.3901677721026*^9}}],

Cell[TextData[{
 StyleBox["N[expr, n]",
  FontWeight->"Bold"],
 "\n\nattempts to give a result with  n - digit  precision."
}], "Item",
 CellChangeTimes->{{3.390130464217*^9, 3.3901304663120003`*^9}, {
  3.3901677831916*^9, 3.3901677872136*^9}}],

Cell[BoxData[
 RowBox[{"N", "[", " ", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"\[Pi]", "/", "7"}], "]"}], ",", "50"}], " ", "]"}]], "Input",
 CellChangeTimes->{{3.3901708619166*^9, 3.3901708847186003`*^9}}],

Cell[BoxData[
 RowBox[{"N", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", "2"], "+", 
     SqrtBox["2"], "+", 
     RowBox[{"Sin", "[", 
      RowBox[{"\[Pi]", "/", "7"}], "]"}]}], 
    RowBox[{"Log", "[", 
     RowBox[{"8", "+", 
      RowBox[{"Tan", "[", 
       RowBox[{"1", "/", "3"}], "]"}]}], "]"}]], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "50"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901707520326*^9, 3.3901708338646*^9}, {
  3.3901709038585997`*^9, 3.3901709582056*^9}}],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"\[Pi]", ",", "500"}], "]"}]], "Input"],

Cell[TextData[{
 "\nHowever, you need to be aware that a computation ",
 StyleBox["will degenerate to the ",
  FontVariations->{"Underline"->True}],
 StyleBox["least",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True},
  FontColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],
 StyleBox[" accurate number contained within the expression",
  FontVariations->{"Underline"->True}],
 ".  \n\nReal numbers entered without the \n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"N", "[", " ", 
     RowBox[{"...", " ", ",", " ", 
      RowBox[{"n", " ", "digits"}]}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " \n\t\ncommand are all assumed to have the ",
 StyleBox["same",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " degree of accuracy, i.e. machine precision.  "
}], "Text",
 CellChangeTimes->{
  3.390129728409*^9, 3.3901298249519997`*^9, {3.390129953023*^9, 
   3.390129972724*^9}, 3.3901677967236*^9, 3.3901678552306004`*^9, {
   3.3901710057296*^9, 3.3901710150996*^9}, 3.439060618078125*^9, 
   3.439062976296875*^9}],

Cell[TextData[{
 StyleBox["$MachinePrecision",
  FontWeight->"Bold"],
 "\n\ngives the number of decimal digits of precision used for \
machine-precision numbers. "
}], "Item",
 CellChangeTimes->{{3.390129796242*^9, 3.390129798575*^9}}],

Cell[TextData[{
 "A typical value of ",
 StyleBox["$MachinePrecision",
  FontWeight->"Bold"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"53", 
    SubscriptBox["log", "10"], "2"}], TraditionalForm]], "InlineFormula"],
 " or approximately 16 base 10 digits. \n\nTherefore, the real numbers   ",
 StyleBox["2.",
  FontWeight->"Bold"],
 ", ",
 StyleBox["2.0",
  FontWeight->"Bold"],
 ", ",
 StyleBox["2.00",
  FontWeight->"Bold"],
 ", ",
 StyleBox["3.0/4.0",
  FontWeight->"Bold"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SqrtBox["2.0"],
    FontWeight->"Bold"], TraditionalForm]]],
 ", ",
 StyleBox["N[2]",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Sin[2.0]",
  FontWeight->"Bold"],
 " etc. are all assumed to have machine precision.  The machine precision for \
your computer is:"
}], "Text",
 CellChangeTimes->{{3.3901299212320004`*^9, 3.390129941854*^9}, {
  3.3901679086466*^9, 3.3901679613596*^9}, {3.439060634765625*^9, 
  3.439060683875*^9}}],

Cell[BoxData["$MachinePrecision"], "Input"],

Cell[TextData[{
 "Therefore, the expression:\n\n\t\t",
 StyleBox["1.12 + 2.3475 + 4.6423463244234",
  FontWeight->"Bold"],
 "\n\t\t\nwill be calculated and stored to the number of digits allowed by \
the machine precision (and will not be limited to 3 decimal places as \
suggested by the number ",
 StyleBox["1.12",
  FontWeight->"Bold"],
 ").\n\nOne consequence is that answer for the expression:\n\n\t",
 StyleBox["N[\[Pi],500] + 2.0 + 3/4",
  FontWeight->"Bold"],
 "  \n\t\nhas the minimum of 500 digits for ",
 StyleBox["N[\[Pi],500]",
  FontWeight->"Bold"],
 " and 16 digits (machine precision) for ",
 StyleBox["2.0",
  FontWeight->"Bold"],
 " and \[Infinity] digits for ",
 StyleBox["3/4",
  FontWeight->"Bold"],
 " will degenerate to machine precision:   \n\n\t",
 StyleBox["16 digits  ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{"Min", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"500", " ", "digits"}], ",", " ", 
       RowBox[{"16", " ", "digits"}], ",", " ", 
       RowBox[{"\[Infinity]", " ", "digits"}]}], "}"}]}]}], TraditionalForm]],
  FontWeight->"Bold"],
 ".\n\t\nWhile the expression:\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      StyleBox["N",
       FontSlant->"Plain"], "[", 
      RowBox[{"\[ExponentialE]", ",", "200"}], "]"}], " ", "+", 
     RowBox[{
      StyleBox["N",
       FontSlant->"Plain"], "[", 
      RowBox[{"\[Pi]", ",", "500"}], "]"}], " ", "+", " ", 
     SqrtBox["2"]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  \n\t\nproduces an answer that has the minimum of 200 digits for ",
 StyleBox["N[\[ExponentialE],200]",
  FontWeight->"Bold"],
 ", 500 digits for ",
 StyleBox["N[\[Pi],500]",
  FontWeight->"Bold"],
 " and \[Infinity] digits for  ",
 Cell[BoxData[
  FormBox[
   SqrtBox["2"], TraditionalForm]]],
 "  \n\t\t\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"200", " ", "digits"}], "=", 
     RowBox[{"Min", 
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"200", " ", "digits"}], ",", " ", 
        RowBox[{"500", " ", "digits"}], ",", " ", 
        RowBox[{"\[Infinity]", " ", "digits"}]}], "}"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ". "
}], "Text",
 CellChangeTimes->{{3.390130531764*^9, 3.39013071177*^9}, {3.3901676155056*^9,
    3.3901677190996*^9}, {3.3901710896916*^9, 3.3901710947316*^9}, {
   3.390790371856*^9, 3.39079041471*^9}, {3.390790470679*^9, 
   3.390790499778*^9}, {3.439060777703125*^9, 3.439061222359375*^9}, {
   3.43906125690625*^9, 3.439061301234375*^9}, 3.43913359734375*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
What is the difference between \"what you see\" and \"what you get\"?\
\>", "Subsection",
 CellChangeTimes->{{3.3901700700685997`*^9, 3.3901701008246*^9}, 
   3.3901705134226*^9}],

Cell[TextData[{
 "When you have a 16-digit ",
 StyleBox["machine",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["precision",
  FontVariations->{"Underline"->True}],
 " real number that ends in repeated  0s  like:"
}], "Text",
 CellChangeTimes->{{3.3901702236286*^9, 3.3901702970206003`*^9}, {
  3.3901705252496*^9, 3.3901705263506002`*^9}, {3.390790798288*^9, 
  3.390790814105*^9}}],

Cell[BoxData["2.500000000000000"], "Input",
 CellChangeTimes->{{3.3901701344946003`*^9, 3.3901701723255997`*^9}, {
  3.3901703465896*^9, 3.3901703535676003`*^9}, {3.3907906481400003`*^9, 
  3.39079068235*^9}, {3.39079075495*^9, 3.390790762245*^9}}],

Cell[TextData[{
 "\nit ",
 StyleBox["always",
  FontVariations->{"Underline"->True}],
 " drops the repeated  0s and only ",
 StyleBox["displays",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "  the leading digits (even though there are 16 digits actually there \
internally within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "). The reason is to make the displayed output of a computation more \
readable and less bulky on your computer screen.\n"
}], "Text",
 CellChangeTimes->{{3.3901703084386*^9, 3.3901704903156*^9}, {
   3.3901705443156*^9, 3.3901706457236*^9}, {3.3901706793896*^9, 
   3.3901706808646*^9}, {3.3907905314300003`*^9, 3.390790542876*^9}, 
   3.390790689109*^9, {3.390790830023*^9, 3.390790889867*^9}, {
   3.390790954916*^9, 3.390790956462*^9}, {3.390791035817*^9, 
   3.390791106334*^9}, {3.390791145156*^9, 3.3907911454709997`*^9}, 
   3.439061499703125*^9}],

Cell[TextData[{
 "When you have a 20-digit ",
 StyleBox["non",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "-machine precision real number that ends in repeated  0s  like:"
}], "Text",
 CellChangeTimes->{{3.3901702236286*^9, 3.3901702970206003`*^9}, {
  3.3901705252496*^9, 3.3901705263506002`*^9}, {3.390790798288*^9, 
  3.390790814105*^9}, {3.390791167567*^9, 3.390791175184*^9}}],

Cell[BoxData["2.5000000000000000000"], "Input",
 CellChangeTimes->{{3.390790963132*^9, 3.390790974384*^9}}],

Cell[TextData[{
 "\nit ",
 StyleBox["always",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["displays",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["all",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " the digits. \n\nWhen you have a 16-digit machine precision real number \
like:"
}], "Text",
 CellChangeTimes->{{3.3901702236286*^9, 3.3901702970206003`*^9}, {
   3.3901705252496*^9, 3.3901705263506002`*^9}, {3.3907912054110003`*^9, 
   3.390791271349*^9}, 3.439061501953125*^9}],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"1", "/", "3"}], "]"}]], "Input",
 CellChangeTimes->{{3.3901701344946003`*^9, 3.3901701723255997`*^9}, {
  3.3901703465896*^9, 3.3901703535676003`*^9}}],

Cell[TextData[{
 "\nit only ",
 StyleBox["displays",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "  6 of the 16 digits that are actually there internally within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". The reason is to make the displayed output of a computation more readable \
and less bulky on your computer screen.\n\nYou can always ask to ",
 StyleBox["see",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " all of the internal digits as follows:"
}], "Text",
 CellChangeTimes->{{3.3901703084386*^9, 3.3901704903156*^9}, {
   3.3901705443156*^9, 3.3901706457236*^9}, {3.3901706793896*^9, 
   3.3901706808646*^9}, {3.3907905314300003`*^9, 3.390790542876*^9}, 
   3.43906150978125*^9, 3.5230291679679585`*^9}],

Cell[BoxData[
 RowBox[{"InputForm", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"N", "[", 
   RowBox[{"1", "/", "3"}], "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901701883396*^9, 3.3901702057506*^9}}],

Cell["\<\
Now examine how a 20 digit number is displayed:\
\>", "Text",
 CellChangeTimes->{{3.5230292882279835`*^9, 3.5230293325484147`*^9}}],

Cell[BoxData[
 RowBox[{"InputForm", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"1", "/", "3"}], ",", "20"}], "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.5230292410742683`*^9, 3.5230292674429045`*^9}}],

Cell[TextData[{
 "Note that the number is COMPUTED to 58 digits (because 4 full floating \
point numbers is computationally more ",
 "efficient",
 "):\n\n\t",
 Cell[BoxData[
  FormBox[
  "3333333333333333333333333333333333333333333333333333333333", 
   TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\n      \nHowever, it contains a restriction that only the first 20 are to \
be considered significant (note the ",
 Cell[BoxData[
  FormBox["`", TraditionalForm]],
  FormatType->"TraditionalForm"],
 "):\n\n\t",
 Cell[BoxData[
  FormBox["`20", TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\n\t\nCombining numbers of differing accuracy causes the answer to degrade \
to the lowest accuracy.\n\nConsider combining two numbers with 20 and 30 \
digits respectively:"
}], "Text",
 CellChangeTimes->{{3.523032668595091*^9, 3.523032889292158*^9}, {
  3.523032925359765*^9, 3.5230330063848667`*^9}, {3.52303313223145*^9, 
  3.523033169296156*^9}, {3.523033641372359*^9, 3.523033713839605*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"1", "/", "3"}], ",", "20"}], "]"}], "+", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"1", "/", "3"}], ",", "30"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5230330738616133`*^9, 3.523033075013729*^9}}],

Cell["\<\
The answer is rounded to 20 digits.

Where the internal representation is:\
\>", "Text",
 CellChangeTimes->{{3.5230330985340805`*^9, 3.5230331169179187`*^9}, {
  3.523033190617288*^9, 3.5230332070019264`*^9}}],

Cell[BoxData[
 RowBox[{"InputForm", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"1", "/", "3"}], ",", "20"}], "]"}], "+", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"1", "/", "3"}], ",", "30"}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.5230292410742683`*^9, 3.5230292674429045`*^9}, {
  3.5230332169969254`*^9, 3.523033221484374*^9}}],

Cell[TextData[{
 "Where, because of the rounding, the answer is accurate to\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"`20", ".301029995620556"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\n\t\ndigits.\n\nNote that:"
}], "Text",
 CellChangeTimes->{{3.5230333258868136`*^9, 3.5230334244986734`*^9}}],

Cell[BoxData[
 SuperscriptBox["10", "20.301029995620556"]], "Input",
 CellChangeTimes->{{3.523033264624688*^9, 3.523033275416767*^9}, {
  3.523033438725096*^9, 3.523033448054029*^9}}],

Cell["\<\
Which is slightly better than 20.\
\>", "Text",
 CellChangeTimes->{{3.523033479014125*^9, 3.5230335012223454`*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" A brief introduction to ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox["'s evaluation procedure", "Subtitle"]
}], "Section",
 CellChangeTimes->{{3.3901842638556004`*^9, 3.3901842691266003`*^9}}],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"x", ",", "y", ",", "f", ",", "g", ",", "h", ",", "k"}], 
  "]"}]], "InputOnly"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Atomic expressions",
  FontVariations->{"Underline"->True}],
 " within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "."
}], "Subsection"],

Cell[TextData[{
 "\tInteger:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"...", ",", " ", 
    RowBox[{"-", "2"}], ",", " ", 
    RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "1", ",", " ", "2", ",", " ", 
    RowBox[{"...", " ", 
     RowBox[{"etc", "."}]}]}], TraditionalForm]]],
 "\n\n\tRational:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"...", ",", " ", 
    RowBox[{
     RowBox[{"-", "3"}], "/", "4"}], ",", " ", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}], ",", " ", 
    RowBox[{"1", "/", "2"}], ",", " ", 
    RowBox[{"3", "/", "4"}], ",", " ", 
    RowBox[{"...", " ", 
     RowBox[{"etc", "."}]}]}], TraditionalForm]]],
 "\n\t\n\tReal:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"...", ",", " ", 
    RowBox[{"-", "2.3836747"}], ",", " ", 
    RowBox[{"-", "2.0"}], ",", " ", "0.0", ",", " ", "0.35428", ",", " ", 
    "1.0", ",", " ", "3.89734", ",", " ", 
    RowBox[{"...", " ", 
     RowBox[{"etc", "."}]}]}], TraditionalForm]]],
 "\n\t\n\tComplex:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"...", ",", " ", 
    RowBox[{"3", "+", 
     RowBox[{"4", "\[ImaginaryI]"}]}], ",", " ", 
    RowBox[{"2.22", "-", 
     RowBox[{"4.23", "\[ImaginaryI]"}]}], ",", " ", 
    FormBox[
     RowBox[{
      RowBox[{
       FractionBox["2", "3"], "+", 
       RowBox[{
        FractionBox["7", "4"], "\[ImaginaryI]"}]}], ",", " ", 
      RowBox[{"...", " ", 
       RowBox[{"etc", "."}]}]}],
     TraditionalForm], " "}], TraditionalForm]]],
 "\n\t\n\tLogical:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"True", ",", " ", "False", " "}], TraditionalForm]]],
 "\n\t\n\tString:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "...", ",", " ", "\"\<abc\>\"", ",", " ", "\"\<character string\>\"", ",", 
    RowBox[{"...", " ", 
     RowBox[{"etc", "."}]}]}], TraditionalForm]]],
 "\n\t\n\tSymbol:\t..., a, b, x, abc, temp, \[ExponentialE], \[Pi], ... etc.\n\
\t\n\tetc."
}], "Text",
 CellChangeTimes->{{3.3901711913396*^9, 3.3901712159026003`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Every",
  FontVariations->{"Underline"->True}],
 " non-atomic expression within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is a ",
 StyleBox["function",
  FontVariations->{"Underline"->True}],
 ". "
}], "Subsection"],

Cell[TextData[{
 "Functions can be either those supplied internally by ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "(a total of several thousand functions): \n\n\t\t",
 Cell[BoxData[{
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{"Sin", "[", "x", "]"}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{
    FormBox[
     SuperscriptBox["\[ExponentialE]", "x"],
     TraditionalForm], "\[IndentingNewLine]", "  "}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"y", "\[Equal]", 
        RowBox[{
         RowBox[{"2", "x"}], "+", "3"}]}], ",", " ", "x"}], "]"}],
     TraditionalForm], "\[IndentingNewLine]", "  "}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", "1"}], ")"}], 
       RowBox[{"\[DifferentialD]", "x"}]}]}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   FormBox[
    RowBox[{"etc", "."}],
    TraditionalForm], "Text"]}]],
 " \n\t\nor user-defined functions:\n\n\t\t",
 Cell[BoxData[{
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{
      RowBox[{"f", "[", "x_", "]"}], "=", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", "1"}]}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{" ", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}]}]}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   FormBox[
    RowBox[{"etc", "."}],
    TraditionalForm], "Text"]}]],
 " \n\t\t\nFor example, consider the simple user-defined function:"
}], "Text",
 CellChangeTimes->{3.390130748541*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{
   SuperscriptBox["x", "2"], "+", "1"}]}]}], "Input"],

Cell[TextData[{
 "Find out all information associated with the function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["Notation used to define a simple user-defined function:", "Subsection"],

Cell[TextData[{
 "Components of a user-defined function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     StyleBox[
      RowBox[{
       StyleBox["x",
        FontSlant->"Italic"], "_"}]], "]"}], "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "1"}]}], TraditionalForm]]],
 ":  \n\n\tits Head (i.e. name):   ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 "\n\tnotation that contains the arguments:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "  ", "...", "  ", "]"}], TraditionalForm]]],
 "\n\tthe actual argument (i.e. variable expression):   ",
 Cell[BoxData[
  FormBox["_", TraditionalForm]]],
 "\n\tthe argument's local name for use in the rhs: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", "x"}], TraditionalForm]]],
 "\n\timmediate assignment:   ",
 Cell[BoxData[
  FormBox["=", TraditionalForm]]],
 "\n\tthe right hand side:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "+", "1"}], TraditionalForm]]],
 "\n\t\nFor example:"
}], "Text",
 CellChangeTimes->{{3.3901713052916*^9, 3.3901714053046*^9}}],

Cell[BoxData[
 RowBox[{"Head", "[", 
  RowBox[{"h", "[", 
   RowBox[{"x", ",", "y"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Head", "[", 
  RowBox[{"Sin", "[", "x", "]"}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["Compound functions:", "Subsection"],

Cell[TextData[{
 "Most functions in ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "(both user-defined functions and internal ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " functions) are built-up from the composition of many different functions \
as well as atomic forms.\n\nFor example:\t\t\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Log", "[", 
    RowBox[{
     RowBox[{
      SqrtBox["3"], 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"3", 
      RowBox[{"Sin", "[", "x", "]"}]}]}], "]"}], TraditionalForm]]],
 "\n\t\nis constructed from internal ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " functions."
}], "Text",
 CellChangeTimes->{{3.390130843916*^9, 3.390130865014*^9}, {
  3.3901714401696*^9, 3.3901714568746*^9}}],

Cell[BoxData[
 RowBox[{"TreeForm", "[", 
  RowBox[{"Log", "[", 
   RowBox[{
    RowBox[{
     SqrtBox["3"], 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"3", 
     RowBox[{"Sin", "[", "x", "]"}]}]}], "]"}], "]"}]], "Input"],

Cell[TextData[{
 "\nFor example:\t\t\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"h", "[", 
       RowBox[{"k", "[", "x", "]"}], "]"}], 
      RowBox[{"g", "[", "x", "]"}]], "+", 
     RowBox[{"k", "[", 
      RowBox[{
       RowBox[{"g", "[", "x", "]"}], ",", 
       RowBox[{"h", "[", "x", "]"}]}], "]"}]}]}], TraditionalForm]]],
 "\t\n\t\nis constructed from user-defined functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "[", "x", "]"}], ",", " ", 
    RowBox[{
     RowBox[{"h", "[", "x", "]"}], " ", "and", " ", 
     RowBox[{"k", "[", "x", "]"}]}]}], TraditionalForm]]],
 ")"
}], "Text",
 CellChangeTimes->{{3.390130897565*^9, 3.390130978664*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f", ",", "h", ",", "g", ",", "k"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"h", "[", 
     RowBox[{"k", "[", "x", "]"}], "]"}], 
    RowBox[{"g", "[", "x", "]"}]], "+", 
   RowBox[{"k", "[", 
    RowBox[{
     RowBox[{"g", "[", "x", "]"}], ",", 
     RowBox[{"h", "[", "x", "]"}]}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.390130984895*^9, 3.390130990875*^9}}],

Cell[BoxData[
 RowBox[{"TreeForm", "[", 
  RowBox[{"f", "[", "x", "]"}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "General form of a function:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     SubscriptBox["arg", "1"], ",", 
     SubscriptBox["arg", "2"], ",", 
     SubscriptBox["arg", "3"], ",", "...", " ", ",", 
     SubscriptBox["arg", "n"]}], "]"}], TraditionalForm]]]
}], "Subsection"],

Cell[TextData[{
 StyleBox["All",
  FontVariations->{"Underline"->True}],
 " functions (both user-defined and internally defined functions) viewed from \
the top level have the following representation:\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     SubscriptBox["arg", "1"], ",", 
     SubscriptBox["arg", "2"], ",", 
     SubscriptBox["arg", "3"], ",", "...", " ", ",", 
     SubscriptBox["arg", "n"]}], "]"}], TraditionalForm]]],
 "\n\t\t\nwhere the head (i.e. name) of the function is  ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 "  and the arguments are  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["arg", "1"], ",", 
    SubscriptBox["arg", "2"], ",", 
    SubscriptBox["arg", "3"], ",", "...", " ", ",", 
    SubscriptBox["arg", "n"]}], TraditionalForm]]],
 ".  The arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["arg", "1"], ",", 
    SubscriptBox["arg", "2"], ",", 
    SubscriptBox["arg", "3"], ",", "...", " ", ",", 
    SubscriptBox["arg", "n"]}], TraditionalForm]]],
 " themselves can have arbitrary structure and be either numbers, symbols or \
more complicated functions."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Internal ",
 StyleBox["representation",
  FontVariations->{"Underline"->True}],
 " for ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " functions:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     SubscriptBox["arg", "1"], ",", 
     SubscriptBox["arg", "2"], ",", 
     SubscriptBox["arg", "3"], ",", "...", " ", ",", 
     SubscriptBox["arg", "n"]}], "]"}], TraditionalForm]]]
}], "Subsection"],

Cell[TextData[{
 "No matter how you typeset a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function to create its appearance within the Front End, internally it has \
the standard representation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     SubscriptBox["arg", "1"], ",", 
     SubscriptBox["arg", "2"], ",", 
     SubscriptBox["arg", "3"], ",", "...", " ", ",", 
     SubscriptBox["arg", "n"]}], "]"}], TraditionalForm]]],
 ".\n\nFor example, the full form of the following functions are as follows:\n\
\n\t\t\t",
 Cell[BoxData[GridBox[{
    {
     RowBox[{"    ", 
      StyleBox["Appearance", "Text"], 
      StyleBox["       ", "Text"]}], 
     RowBox[{"       ", 
      StyleBox[
       RowBox[{"Internal", " ", "Representation"}], "Text"]}]},
    {
     StyleBox[
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], 
        RowBox[{"\[DifferentialD]", "x"}]}]}], "Text"], 
     StyleBox[
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}], "Text",
      ShowSpecialCharacters->False,
      ShowStringCharacters->True,
      NumberMarks->True]},
    {
     StyleBox[
      SuperscriptBox["\[ExponentialE]", "x"], "Text"], 
     StyleBox[
      RowBox[{
       StyleBox["Power", "Text",
        ShowSpecialCharacters->False,
        ShowStringCharacters->True,
        NumberMarks->True], 
       StyleBox["[", "Text",
        ShowSpecialCharacters->False,
        ShowStringCharacters->True,
        NumberMarks->True], 
       RowBox[{"\[ExponentialE]", 
        StyleBox[",", "Text",
         ShowSpecialCharacters->False,
         ShowStringCharacters->True,
         NumberMarks->True], 
        StyleBox["x", "Text",
         ShowSpecialCharacters->False,
         ShowStringCharacters->True,
         NumberMarks->True]}], 
       StyleBox["]", "Text",
        ShowSpecialCharacters->False,
        ShowStringCharacters->True,
        NumberMarks->True]}], "Text"]},
    {
     StyleBox[
      RowBox[{"1", "+", 
       SuperscriptBox["x", "2"]}], "Text"], 
     StyleBox[
      TagBox[
       StyleBox[
        RowBox[{"Plus", "[", 
         RowBox[{"1", ",", 
          RowBox[{"Power", "[", 
           RowBox[{"x", ",", "2"}], "]"}]}], "]"}],
        ShowSpecialCharacters->False,
        ShowStringCharacters->True,
        NumberMarks->True],
       FullForm], "Text"]}
   },
   GridBoxDividers->{
    "Columns" -> {True, {False}, True}, "ColumnsIndexed" -> {}, 
     "Rows" -> {{True}}, "RowsIndexed" -> {}}]]]
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"InputForm", "[", 
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.3901310530559998`*^9, 3.390131056165*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Do different evaluation procedures always yield the same result?\
\>", "Subsection",
 CellChangeTimes->{{3.3901725103676*^9, 3.3901725604746*^9}}],

Cell["\<\
For a simple symbolic expression or almost any numerical expression, you will \
get the same result no matter how you evaluate the expression.

However, when you mix symbolic and numerical expressions you may get \
different results by following different evaluation procedures! At first this \
may sound impossible, but it happens all the time!\
\>", "Text",
 CellChangeTimes->{{3.3901725781906*^9, 3.3901728240996*^9}, {
  3.3901729112216*^9, 3.3901729342665997`*^9}, {3.3901729794175997`*^9, 
  3.3901735816466*^9}, {3.3901736143445997`*^9, 3.3901739268726*^9}, {
  3.3901739674765997`*^9, 3.3901740506275997`*^9}, {3.3901741053016*^9, 
  3.3901741101356*^9}}],

Cell[TextData[{
 "Consider the following very simple illustration:\n\n\tSay you have the \
function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{
     RowBox[{"2", 
      SuperscriptBox["x", "2"]}], "+", "1"}]}], TraditionalForm]]],
 "  and you want the slope at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "3"}], TraditionalForm]]],
 ".\n\t\n\tYou have been ",
 StyleBox["trained",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " in Calculus that you ",
 StyleBox["must",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 ":\n\t\n\t\tDifferentiate first\n\t\t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["d", 
      StyleBox["dx",
       FontSlant->"Italic"]], " ", 
     RowBox[{"f", "[", "x", "]"}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["d", 
       StyleBox["dx",
        FontSlant->"Italic"]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", 
         SuperscriptBox["x", "2"]}], "+", "1"}], ")"}]}], " ", "=", " ", 
     RowBox[{"4", "x"}]}]}], TraditionalForm]]],
 "\n\t\t\t\n\t\tand substitute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "3"}], TraditionalForm]]],
 " second\n\t\t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"4", "x", "  ", "at", "  ", "x"}], "=", 
    RowBox[{"3", "    ", "\[Rule]", "   ", 
     RowBox[{
      RowBox[{"4", "*", "3"}], "   ", "\[Rule]", "   ", "12"}]}]}], 
   TraditionalForm]]],
 "\n\t\t\t\n\tBut what if you forgot your Calculus training and you \
mistakenly\n\t\n\t\tSubstituted ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "3"}], TraditionalForm]]],
 " first \n\t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", 
      RowBox[{"1", "    ", "at", "    ", "x"}]}], "=", 
     RowBox[{"3", "     ", "\[Rule]", "    ", 
      RowBox[{
       RowBox[{"f", "[", "3", "]"}], "    ", "\[Rule]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "*", 
          SuperscriptBox["3", "2"]}], "+", "1"}], "    ", "\[Rule]", "    ", 
        "19"}]}]}]}]}], TraditionalForm]]],
 "\n\t\n\t\tAnd differentiated second\n\t\t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["d", 
      StyleBox["dx",
       FontSlant->"Italic"]], 
     RowBox[{"(", "19", " ", ")"}]}], "   ", "\[Rule]", "    ", "0"}], 
   TraditionalForm]]],
 "\n\t\t\t\n\tThe correct answer is  12   not   0!"
}], "Text",
 CellChangeTimes->{{3.3901725781906*^9, 3.3901728240996*^9}, {
   3.3901729112216*^9, 3.3901729342665997`*^9}, {3.3901729794175997`*^9, 
   3.3901735816466*^9}, {3.3901736143445997`*^9, 3.3901739268726*^9}, {
   3.3901739674765997`*^9, 3.3901740506275997`*^9}, 3.3901741053016*^9}],

Cell[TextData[{
 "So how do you train ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "? Please note that there is no universally correct evaluation procedure! \
Each evaluation ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " be evaluated by its own required procedure. So it is your ",
 StyleBox["responsibly",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " to program the correct procedure into ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". This is not as hard as it may first appear, because all evaluation \
procedures fundamental reduce to two choices:\n\n\tEvaluation Procedure I \
(Standard Evaluation Procedure)\n\t\n\t\tSubstitute First\n\t\tEvaluate \
Second\n\t\t\n\tEvaluation Procedure II (Non-Standard Evaluation Procedure)\n\
\t\n\t\tEvaluate First\t\n\t\tSubstitute Second\n\t\t\nNote that the above \
example would require Evaluation Procedure II: differentiate first and ",
 "substitute 3 second."
}], "Text",
 CellChangeTimes->{{3.3901741960706*^9, 3.3901745775246*^9}, {
  3.3901746184245996`*^9, 3.3901748110486*^9}, {3.5230969647114973`*^9, 
  3.5230970368397093`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s ",
 StyleBox["Standard Evaluation Procedure",
  FontVariations->{"Underline"->True}],
 " for a function:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     SubscriptBox["arg", "1"], ",", 
     SubscriptBox["arg", "2"], ",", 
     SubscriptBox["arg", "3"], ",", "...", " ", ",", 
     SubscriptBox["arg", "n"]}], "]"}], TraditionalForm]]],
 "\n\n\tSubstitute First\n\tEvaluate Second"
}], "Subsection",
 CellChangeTimes->{{3.3901749471246*^9, 3.3901749636196003`*^9}}],

Cell[TextData[{
 "Except as illustrated in the section on Attributes, ",
 StyleBox["every",
  FontVariations->{"Underline"->True}],
 " function (both the user-defined functions and ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internally defined functions) follow exactly the ",
 StyleBox["same",
  FontVariations->{"Underline"->True}],
 " step-by-step ",
 StyleBox["standard",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " evaluation procedure.  The following is a brief outline of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s ",
 StyleBox["standard",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " evaluation procedure.\n\nExample:\n\tGiven the following assignments:\n\t\t\
\t\t\t\t\t",
 Cell[BoxData[{
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{
      RowBox[{"x", "=", "xValue"}], ";"}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", "x_", "]"}], "=", "gValue"}], ";"}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{
      RowBox[{
       RowBox[{"h", "[", "x_", "]"}], "=", "hValue"}], ";"}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{
      RowBox[{"f", "=", "F"}], ";"}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   "Text"], "\[IndentingNewLine]", 
  StyleBox[
   FormBox[
    RowBox[{
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}],
    TraditionalForm], "Text"]}]],
 "\n\t\t\n\tEvaluate the following compound function:\t\n\n\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"x", ",", 
     RowBox[{"g", "[", "x", "]"}], ",", 
     RowBox[{"h", "[", "x", "]"}]}], "]"}], TraditionalForm]]],
 "\n\t\t\t\t\t\t\t"
}], "Text",
 CellChangeTimes->{{3.3901749969666*^9, 3.3901750045666*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "x", ",", "f", ",", "g", ",", "h", ",", "F", ",", "fValue", ",", "gValue",
      ",", "hValue"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", "xValue"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], "=", "gValue"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], "=", "hValue"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", "F"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"f", "[", 
  RowBox[{"x", ",", 
   RowBox[{"g", "[", "x", "]"}], ",", 
   RowBox[{"h", "[", "x", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{3.390131091098*^9}],

Cell["\<\
Trace the step-by-step evaluation procedure for the above expression:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"f", "[", 
    RowBox[{"x", ",", 
     RowBox[{"g", "[", "x", "]"}], ",", 
     RowBox[{"h", "[", "x", "]"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.390131117666*^9, 3.3901311275360003`*^9}}],

Cell[TextData[{
 "You may have to \"read between the lines\" of the above trace because the \
Trace command does not display the procedure being used to generate each line \
of the trace, it only displays the initial and final results. \nHowever, the \
above simple example is sufficient to illustrate some of the important \
evaluation steps.\n\n",
 StyleBox["Substitute First:", "Subsubsection"],
 "\n\n\tStep 1: Evaluate the head of the function:\n\t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", ",", 
      RowBox[{"g", "[", "x", "]"}], ",", 
      RowBox[{"h", "[", "x", "]"}]}], "]"}], "  ", "\[Rule]", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", " ", "\[Rule]", " ", "F"}], "}"}], "\[Rule]", " ", 
     RowBox[{"F", "[", 
      RowBox[{"x", ",", 
       RowBox[{"g", "[", "x", "]"}], ",", 
       RowBox[{"h", "[", "x", "]"}]}], "]"}]}]}], TraditionalForm]]],
 "\n\n\tStep 2: Evaluate the arguments from left to right:\t\n\t\t Evaluate \
the first argument (i.e. leftmost argument): \t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "  ", "\[Rule]", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", " ", "\[Rule]", " ", "xValue"}], "}"}], "\[Rule]", " ", 
     RowBox[{"F", "[", 
      RowBox[{"xValue", ",", 
       RowBox[{"g", "[", "x", "]"}], ",", 
       RowBox[{"h", "[", "x", "]"}]}], "]"}]}]}], TraditionalForm]]],
 "\n\t\t Evaluate the second argument: \t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "[", "x", "]"}], "  ", "\[Rule]", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", " ", "\[Rule]", " ", "xValue"}], "}"}], " ", "\[Rule]", 
     " ", 
     RowBox[{
      RowBox[{"g", "[", "xValue", "]"}], " ", "\[Rule]", " ", 
      RowBox[{"gValue", "\[Rule]", " ", 
       RowBox[{"F", "[", 
        RowBox[{"xValue", ",", "gValue", ",", 
         RowBox[{"h", "[", "x", "]"}]}], "]"}]}]}]}]}], TraditionalForm]]],
 "\n\t\t Evaluate the third argument: \t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "[", "x", "]"}], "  ", "\[Rule]", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", " ", "\[Rule]", " ", "xValue"}], "}"}], " ", "\[Rule]", 
     " ", 
     RowBox[{
      RowBox[{"h", "[", "xValue", "]"}], " ", "\[Rule]", " ", 
      RowBox[{"hValue", "\[Rule]", " ", 
       RowBox[{"F", "[", 
        RowBox[{"xValue", ",", "gValue", ",", "hValue"}], "]"}]}]}]}]}], 
   TraditionalForm]]],
 "\n\t\t All arguments have been evaluated.\n\n",
 StyleBox["Evaluate Second:", "Subsubsection"],
 "\n\n\tStep 3: Look up assignments for the function ",
 Cell[BoxData[
  FormBox["F", TraditionalForm]]],
 ": \t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], " ", "}"}], "\[Rule]", " ", 
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"xValue", ",", "gValue", ",", "hValue"}], "]"}], " ", "\[Rule]",
      " ", 
     RowBox[{"{", 
      RowBox[{"xValue", ",", "gValue", ",", "hValue"}], "}"}]}]}], 
   TraditionalForm]]],
 "\n\t\t\t\n\tStep 4: Continue this process recursively until no more \
substitutions and evaluations can be made.\n\t\n\tStep 5: Return the final \
result.\t\t"
}], "Text",
 CellChangeTimes->{{3.3901750607566*^9, 3.3901750612736*^9}, {
  3.3901750969175997`*^9, 3.3901751121236*^9}, {3.3901751769695997`*^9, 
  3.3901751836846*^9}, {3.3901752327146*^9, 3.3901752636106*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Attributes: HoldAll, HoldFirst, HoldRest",
 StyleBox["\nControlling",
  FontVariations->{"Underline"->True}],
 " the step-by-step evaluation of a function: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     SubscriptBox["arg", "1"], ",", 
     SubscriptBox["arg", "2"], ",", 
     SubscriptBox["arg", "3"], ",", "...", " ", ",", 
     SubscriptBox["arg", "n"]}], "]"}], TraditionalForm]]],
 "\n\t\n\tEvaluate First\t\n\tSubstitute Second"
}], "Subsection",
 CellChangeTimes->{
  3.3901752883546*^9, {3.3901838391516*^9, 3.3901838431076*^9}, {
   3.3901839530106*^9, 3.3901839720355997`*^9}}],

Cell[TextData[{
 "The step-by-step evaluation of a function is controlled by a function's \
attributes.\n\nCurrently, our user-defined function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 " has no ",
 StyleBox["attributes",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 ":"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{
   SuperscriptBox["x", "2"], "+", "1"}]}]}], "Input"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "f", "]"}]], "Input"],

Cell[TextData[{
 "but, the user-defined function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 " does have an ",
 StyleBox["assignment",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " on the right hand side:"
}], "Text"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[TextData[{
 "However, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internally defined functions usually have additional attributes:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Sin", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Solve", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Plot", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "If", "]"}]], "Input"],

Cell[TextData[{
 "The most important attributes control ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s step-by-step evaluation procedure for that function.  These attributes \
include (but are not limited to):\n\n\t\"no attributes\"\t(",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " substitutes all available values for all functional arguments,\n\t\t\t \
i.e. ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s ",
 StyleBox["Standard",
  FontVariations->{"Underline"->True}],
 " Evaluation Procedure)\n\n\tHoldAll\t\t(prevents ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " from substituting values into ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " functional arguments)\n\n\tHoldFirst\t(prevents ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " from substituting values into a function's ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " argument ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 ")\n\n\tHoldRest\t(prevents ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " from substituting values for ",
 StyleBox["all but",
  FontVariations->{"Underline"->True}],
 " a function's ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " argument)"
}], "Text",
 CellChangeTimes->{{3.3901753751646*^9, 3.3901753851656*^9}, 
   3.5230973585338755`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Example: ",
 StyleBox["No",
  FontVariations->{"Underline"->True}],
 " Attributes for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     SubscriptBox["arg", "1"], ",", 
     SubscriptBox["arg", "2"], ",", 
     SubscriptBox["arg", "3"], ",", "...", " ", ",", 
     SubscriptBox["arg", "n"]}], "]"}], TraditionalForm]]],
 "\n\t(",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Standard Evaluation Procedure)\n\n\tSubstitute First\n\tEvaluate Second"
}], "Subsection",
 CellChangeTimes->{3.3901754684746*^9, 3.3901842089706*^9}],

Cell["\<\
First, begin by giving the function an assignment on the right hand side, but \
without setting any attributes:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "y", ",", "z", ",", "g"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], "=", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"x", "+", "z"}], ")"}], "y"]}]}], "Input"],

Cell[TextData[{
 "Find out all information associated with the function ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"?", "g"}]], "Input"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "g", "]"}]], "Input"],

Cell[TextData[{
 "Assign some values to the symbols ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"x", "=", "1"}]], "Input"],

Cell[BoxData[
 RowBox[{"y", "=", "2"}]], "Input"],

Cell[TextData[{
 "Evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"g", "[", 
  RowBox[{"x", ",", "y"}], "]"}]], "Input"],

Cell["\<\
Trace the above evaluation procedure step-by-step to determine exactly how it \
was achieved:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"g", "[", 
    RowBox[{"x", ",", "y"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.390131384851*^9, 3.390131392659*^9}}],

Cell[TextData[{
 "Remember, the user-defined function ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]]],
 " does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " have attributes that hold any of the function's arguments from \
substitution and evaluation.\n\n",
 StyleBox["Substitute First:", "Subsubsection"],
 " \nObserve that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " first replaced the function's ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]],
 " arguments with their values to obtain ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", 
    RowBox[{"1", ",", "2"}], "]"}], TraditionalForm]]],
 ".  \n\n",
 StyleBox["Evaluate Second:", "Subsubsection"],
 "\nThen, the assigned formula ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "z"}], ")"}], "y"]}], TraditionalForm]]],
 " was used to obtain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"1", ",", "2"}], "]"}], "\[Rule]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}], "2"]}], TraditionalForm]]],
 ".\n\nStated simply: \t",
 StyleBox["No",
  FontVariations->{"Underline"->True}],
 " \"hold\" attributes:\n\t\t\t",
 StyleBox["Standard",
  FontVariations->{"Underline"->True}],
 " Evaluation Procedure\n\t\t\tSubstitute values for all arguments ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 ", use the right hand side formula ",
 StyleBox["second",
  FontVariations->{"Underline"->True}],
 "."
}], "Text",
 CellChangeTimes->{{3.3901314334110003`*^9, 3.39013143624*^9}, {
  3.3901758088136*^9, 3.3901758364256*^9}, {3.3901759253366003`*^9, 
  3.3901759325256*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Example: Using the attribute ",
 StyleBox["HoldAll",
  FontVariations->{"Underline"->True}],
 " for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     SubscriptBox["arg", "1"], ",", 
     SubscriptBox["arg", "2"], ",", 
     SubscriptBox["arg", "3"], ",", "...", " ", ",", 
     SubscriptBox["arg", "n"]}], "]"}], TraditionalForm]]],
 "\n\t(",
 StyleBox["Non",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "Standard Evaluation Procedure)\n\t\n\tEvaluate First\t\n\tSubstitute Second"
}], "Subsection",
 CellChangeTimes->{
  3.3901755507446003`*^9, {3.3901838497586*^9, 3.3901838505046*^9}, 
   3.3901842054886*^9}],

Cell[TextData[{
 "First, begin by giving the user-defined function an assignment, but ",
 StyleBox["without",
  FontVariations->{"Underline"->True}],
 " any attributes:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "y", ",", "z", ",", "g"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], "=", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"x", "+", "z"}], ")"}], "y"]}]}], "Input"],

Cell[TextData[{
 "Next, set the attribute HoldAll to the function ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"g", ",", " ", 
   RowBox[{"{", "HoldAll", "}"}]}], "]"}]], "InputOnly"],

Cell[TextData[{
 "Find out all information associated with the function ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"?", "g"}]], "Input"],

Cell[TextData[{
 "Observe that the function ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]]],
 " has both the attribute HoldAll and the assignment ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "z"}], ")"}], "y"]}], TraditionalForm]]],
 ".\n\nAssign some values to the symbols ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.523097542973318*^9}],

Cell[BoxData[
 RowBox[{"x", "=", "1"}]], "Input"],

Cell[BoxData[
 RowBox[{"y", "=", "2"}]], "Input"],

Cell[TextData[{
 "Evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"g", "[", 
  RowBox[{"x", ",", "y"}], "]"}]], "Input"],

Cell["\<\
This is exactly what we got before. So is there a difference in the \
evaluation procedures?

Trace the above evaluation procedure step-by-step to determine exactly how it \
was achieved:\
\>", "Text",
 CellChangeTimes->{{3.3901756067436*^9, 3.3901756704376*^9}}],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"g", "[", 
    RowBox[{"x", ",", "y"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901315003719997`*^9, 3.390131504984*^9}}],

Cell[TextData[{
 "Observe that the step-by-step order of evaluation is ",
 StyleBox["different",
  FontVariations->{"Underline"->True}],
 " with the attribute HoldAll then without the attribute. \n\n",
 StyleBox["Evaluate First:", "Subsubsection"],
 "\nRemember, the user-defined function ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]]],
 " has the attribute HoldAll and therefore neither the value for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "1"}], TraditionalForm]]],
 " or the value for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "2"}], TraditionalForm]]],
 " was substituted into ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]]],
 " before the right hand side assignment ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "z"}], ")"}], "y"]}], TraditionalForm]]],
 " was used.\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"x", ",", "y"}], "]"}], " ", "\[Rule]", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "z"}], ")"}], "y"]}], TraditionalForm]]],
 "\n\n",
 StyleBox["Substitute Second:", "Subsubsection"],
 "\nOnce we have moved beyond the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]]],
 " and we have instead the formula ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "z"}], ")"}], "y"], TraditionalForm]]],
 ", which does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " hold its arguments, then substitution for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "1"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "2"}], TraditionalForm]]],
 " is allowed.\n\nStated simply:\tThe attribute HoldAll:\n\t\t\t",
 StyleBox["Non",
  FontVariations->{"Underline"->True}],
 "standard Evaluation Procedure\n\t\t\tUse the right hand side formula ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 ", substitute for arguments ",
 StyleBox["second",
  FontVariations->{"Underline"->True}],
 ".\n\nFinally, notice that ",
 StyleBox["in this case",
  FontVariations->{"Underline"->True}],
 " we obtained the ",
 StyleBox["same",
  FontVariations->{"Underline"->True}],
 " final result both with and without the attribute HoldAll. However, there \
are circumstances in which having the attribute HoldAll changes both the \
order of the evaluation and the final result."
}], "Text",
 CellChangeTimes->{{3.3901760122195997`*^9, 3.3901760511166*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Example: Using the attribute ",
 StyleBox["HoldRest",
  FontVariations->{"Underline"->True}],
 " for  ",
 Cell[BoxData[
  FormBox["\"\<If[condition, t, f]\>\"", TraditionalForm]]],
 "\n\t(",
 StyleBox["Non",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "Standard Evaluation Procedure)\n\t\n\tEvaluate First\t\n\tSubstitute Second"
}], "Subsection",
 CellChangeTimes->{
  3.3901757489486*^9, {3.3901838530296*^9, 3.3901838535636*^9}, 
   3.3901841958106003`*^9}],

Cell[TextData[{
 "First, begin by checking the attributes of the function: \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{"condition", ",", " ", "t", ",", " ", "f"}], "]"}], 
   TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3901315689379997`*^9, 3.390131579505*^9}}],

Cell[BoxData[
 RowBox[{"??", "If"}]], "Input"],

Cell["Observe that it has attribute HoldRest. ", "Text"],

Cell[TextData[{
 "Assign some values to the symbols ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"x", "=", "1"}]], "Input"],

Cell[BoxData[
 RowBox[{"y", "=", "2"}]], "Input"],

Cell[TextData[{
 "Evaluate the command  \n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"If", "[", 
     RowBox[{"condition", ",", " ", "t", ",", " ", "f"}], "]"}], "Text"], 
   TraditionalForm]]],
 "\n\t\nusing the current assignments  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     RowBox[{"1", "  ", "and", "  ", "y"}], "=", "2"}]}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.390131606774*^9, 3.39013161362*^9}, {3.3901761274566*^9,
   3.3901761642995996`*^9}}],

Cell[BoxData[
 RowBox[{"If", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "+", "z"}], ">", "y"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   FractionBox["1", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "z"}], ")"}], "y"]], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "z"}], ")"}], "y"]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901316188719997`*^9, 3.390131634859*^9}}],

Cell[TextData[{
 "Note that both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     RowBox[{"1", " ", "and", " ", "y"}], "=", "2"}]}], TraditionalForm]]],
 " were substituted into the 1st argument.\nNote that both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     RowBox[{"1", " ", "and", " ", "y"}], "=", "2"}]}], TraditionalForm]]],
 " were ",
 StyleBox["not",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " substituted into the 2nd and 3rd arguments (",
 "attribute is HoldRest",
 ").\n\nTrace the above evaluation procedure step-by-step to determine \
exactly how it was evaluated:"
}], "Text",
 CellChangeTimes->{{3.3901798204456*^9, 3.3901799384526*^9}, {
  3.3901799769896*^9, 3.3901799874966*^9}}],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "+", "z"}], ">", "y"}], ",", 
     FractionBox["1", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "z"}], ")"}], "y"]], ",", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "+", "z"}], ")"}], "y"]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901316456029997`*^9, 3.390131654659*^9}}],

Cell[TextData[{
 "Remember, the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "-defined function \n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"If", "[", 
     RowBox[{
      StyleBox["condition",
       FontColor->RGBColor[1, 0, 0]], ",", " ", 
      StyleBox["t",
       FontColor->RGBColor[0, 0, 1]], ",", " ", 
      StyleBox["f",
       FontColor->RGBColor[0, 0, 1]]}], "]"}], "Text"], TraditionalForm]]],
 "\n\nhas the attribute ",
 StyleBox["HoldRest",
  FontColor->RGBColor[0, 0, 1]],
 " and therefore:\n\n",
 StyleBox["Substitute into First Argument Only:", "Subsubsection"],
 "\n\tboth ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "=", "1"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"y", "=", "2"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 " were substituted into the ",
 StyleBox["first",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" argument ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "+", "z"}], ">", "y"}], TraditionalForm]],
  FontColor->RGBColor[1, 0, 0]],
 " to obtain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "+", "z"}], ">", "2"}], TraditionalForm]],
  FontColor->RGBColor[1, 0, 0]],
 ",\n\t\n\tbut ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " into either the ",
 StyleBox["second",
  FontVariations->{"Underline"->True}],
 " or ",
 StyleBox["third",
  FontVariations->{"Underline"->True}],
 " arguments.\n\t\n",
 StyleBox["Evaluate Second:", "Subsubsection"],
 "\n\t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     StyleBox[
      RowBox[{
       RowBox[{"1", "+", "z"}], ">", "2"}],
      FontColor->RGBColor[1, 0, 0]], ",", 
     StyleBox[
      FractionBox["1", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "+", "z"}], ")"}], "y"]],
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[",",
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "z"}], ")"}], "y"],
      FontColor->RGBColor[0, 0, 1]]}], "]"}], TraditionalForm]]],
 "\n\t\nThe purpose of this attribute when used with ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"If", "[", 
     RowBox[{"condition", ",", " ", "t", ",", " ", "f"}], "]"}], "Text"], 
   TraditionalForm]]],
 " is to guarantee that no substitution will be made into the two formulas ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "+", "z"}], ")"}], "y"]], " ", "and", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "z"}], ")"}], "y"]}], TraditionalForm]]],
 " until the \"condition\" in ",
 Cell[BoxData[
  FormBox["\"\<If[condition, t, f]\>\"", TraditionalForm]]],
 " can be successfully tested yielding either True or False."
}], "Text",
 CellChangeTimes->{{3.390131756208*^9, 3.390131763013*^9}, {3.390131823974*^9,
   3.390131831712*^9}, {3.3901319194300003`*^9, 3.390131941862*^9}, {
  3.3901761970996*^9, 3.3901763723686*^9}, {3.3901807456886*^9, 
  3.3901807519206*^9}}],

Cell[TextData[{
 "For example, if we assign the number \[Pi] to the symbol ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]]],
 ", then:"
}], "Text"],

Cell[BoxData[
 RowBox[{"z", "=", "\[Pi]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "+", "z"}], ">", "y"}], ",", 
     FractionBox["1", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "z"}], ")"}], "y"]], ",", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "+", "z"}], ")"}], "y"]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901317125959997`*^9, 3.390131724575*^9}}],

Cell[TextData[{
 "Observe that:\n\n\t",
 StyleBox["Substitute into First Argument Only:", "Subsubsection"],
 "\n\t\tOnly the first argument had substitutions and was evaluated:\n\t\n\t\t\
 ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "\[Pi]"}], "}"}], ",", 
      RowBox[{"1", "+", "\[Pi]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "2"}], "}"}], ",", 
    RowBox[{
     RowBox[{"1", "+", "\[Pi]"}], ">", "2"}], ",", "True"}], 
   TraditionalForm]]],
 "\n\t\t \n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{"True", ",", 
     FractionBox["1", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "z"}], ")"}], "y"]], ",", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "+", "z"}], ")"}], "y"]}], "]"}], TraditionalForm]]],
 "  (the second and third arguments did not have substitutions)\n\t\t \n\t\t \
producing the intermediate result ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "z"}], ")"}], "y"]], TraditionalForm]]],
 ".\n\n\t",
 StyleBox["Evaluate Second:", "Subsubsection"],
 "\t \n\tAfter evaluation, we have moved beyond the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\"\<If[condition, t, f]\>\"", ","}], TraditionalForm]]],
 " we are no longer constrained \n\tby the attribute HoldRest:\n\t\n\t\t\
Therefore, the expression ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "z"}], ")"}], "y"]], TraditionalForm]]],
 " \n\t\t\n\t\thas substitutions and is evaluated to yield\n\t\t \n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "\[Pi]"}], "}"}], ",", 
        RowBox[{"1", "+", "\[Pi]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "2"}], "}"}], ",", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Pi]"}], ")"}], "2"]}], "}"}], ",", 
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Pi]"}], ")"}], "2"]]}], TraditionalForm]]],
 ".\n\t\t\nObserve that for this specific example, we would get the same \
results both with and without the attribute HoldRest.  However, there are \
cases in which the attribute generates different results and you have to be \
aware of what results you want ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to obtain."
}], "Text",
 CellChangeTimes->{{3.390131994882*^9, 3.390132011936*^9}, {
  3.3901800855986*^9, 3.3901800873866*^9}, {3.3901801261436*^9, 
  3.3901801357855997`*^9}, {3.3901801840456*^9, 3.3901801964786*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Problems",
  FontVariations->{"Underline"->True}],
 " caused by using the Standard Evaluation Procedure.\n\tExample: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      SubscriptBox["arg", "1"], ",", 
      SubscriptBox["arg", "2"], ",", 
      SubscriptBox["arg", "3"], ",", "...", " ", ",", 
      SubscriptBox["arg", "n"]}], "]"}], "   ", "is", "  ", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]]],
 "\n\n\tSubstitute First\n\tEvaluate Second"
}], "Subsection",
 CellChangeTimes->{3.3901802830066*^9, 3.3901841924546003`*^9}],

Cell[TextData[{
 "Observe that the function ",
 Cell[BoxData[
  FormBox["\"\<Integrate[f[x], x]\>\"", TraditionalForm]]],
 " does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " have an attribute that holds its arguments."
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Integrate", "]"}]], "Input",
 CellChangeTimes->{{3.3901803114806004`*^9, 3.3901803204126*^9}}],

Cell[TextData[{
 "Assign a value to the symbol ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and define our function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"x", "=", "5"}]}], "Input"],

Cell["Evaluate:", "Text"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell["\<\
This generated an error messages!  Why?
Trace the above evaluation procedure step-by-step to determine exactly how it \
was achieved:\
\>", "Text",
 CellChangeTimes->{{3.523097881052122*^9, 3.523097881387156*^9}}],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.39013209081*^9, 3.390132100793*^9}}],

Cell[TextData[{
 "Remember, the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "-defined function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]]],
 " does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " hold its arguments and therefore:\n\n",
 StyleBox["Substitute First:", "Subsubsection"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "5", "]"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["5", "2"], "+", "\[Pi]"}], " ", "\[Rule]", " ", 
     RowBox[{"25", "+", "\[Pi]"}]}]}], TraditionalForm]]],
 " was substituted into the ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " argument \n\t\n\tand ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]]],
 " was substituted into the ",
 StyleBox["second",
  FontVariations->{"Underline"->True}],
 " argument ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " integration was attempted:\n\t\n\ti.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], " ", "\[Rule]", " ", 
    RowBox[{
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{"f", "[", "5", "]"}], 
       RowBox[{"\[DifferentialD]", "x"}]}]}], " ", "\[Rule]", " ", 
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["5", "2"], "+", "\[Pi]"}], ")"}], 
        RowBox[{"\[DifferentialD]", "x"}]}]}], " ", "\[Rule]", " ", 
      RowBox[{
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"25", "+", "\[Pi]"}], ")"}], 
         RowBox[{"\[DifferentialD]", "x"}]}]}], " ", "\[Rule]", " ", 
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"25", "+", "\[Pi]"}], ")"}], 
         RowBox[{"\[DifferentialD]", "5"}]}]}]}]}]}]}], TraditionalForm]]],
 ",\n\t\n",
 StyleBox["Evaluate Second:", "Subsubsection"],
 "\n\tand the number 5 ",
 StyleBox["cannot",
  FontVariations->{"Underline"->True}],
 " be a variable of integration (therefore the error message was generated).\n\
\nNote that this problem would ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " have occurred if the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]]],
 " had the attribute HoldAll."
}], "Text",
 CellChangeTimes->{{3.3901803703696003`*^9, 3.3901804008356*^9}, {
  3.3901804657636003`*^9, 3.3901804728426*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Fixing problems",
  FontVariations->{"Underline"->True}],
 " caused by using the Standard Evaluation Procedure.\n\tExample: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      SubscriptBox["arg", "1"], ",", 
      SubscriptBox["arg", "2"], ",", 
      SubscriptBox["arg", "3"], ",", "...", " ", ",", 
      SubscriptBox["arg", "n"]}], "]"}], "   ", "is", "  ", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]]],
 "\n\n\tSubstitute First\n\tEvaluate Second\n\t\n\tMethod: Clear[ ... ] all \
variables used by f[ ... ] before evaluating ",
 "f[ ... ]"
}], "Subsection",
 CellChangeTimes->{{3.3901805355146*^9, 3.3901806270776*^9}, 
   3.3901838719926*^9, 3.3901841886666*^9}],

Cell[TextData[{
 "In this case, you must ",
 StyleBox["explicitly protect",
  FontVariations->{"Underline"->True}],
 " the function from the undesired substitution by clearing the value \
assigned to ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " the integral is evaluated."
}], "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", "x", "]"}]], "InputOnly"],

Cell["\<\

Once more evaluate:\
\>", "Text",
 CellChangeTimes->{{3.390132251584*^9, 3.390132257176*^9}}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell["\<\
Trace the above evaluation procedure step-by-step to determine exactly how it \
was achieved:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{
  "Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.390132270579*^9, 3.3901322811429996`*^9}}],

Cell[TextData[{
 StyleBox["\tSubstitute First:", "Subsubsection"],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     TagBox[
      RowBox[{"f", "[", "x", "]"}],
      HoldForm], ",", 
     TagBox[
      RowBox[{"\[Pi]", "+", 
       SuperscriptBox["x", "2"]}],
      HoldForm]}], "}"}], TraditionalForm]]],
 "\n\t\tx  has been cleared (Clear[x]) and therefore there is nothing to \
substitute!\n\t\tSo NO PROBLEM!\n\t\n\t",
 StyleBox["Evaluate Second:", "Subsubsection"],
 "\n\t\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      TagBox[
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Pi]", "+", 
           SuperscriptBox["x", "2"]}], ")"}], 
         RowBox[{"\[DifferentialD]", "x"}]}]}],
       HoldForm]},
     {
      TagBox[
       RowBox[{
        RowBox[{"\[Pi]", " ", "x"}], "+", 
        FractionBox[
         SuperscriptBox["x", "3"], "3"]}],
       HoldForm]}
    },
    ColumnsEqual->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
    RowsEqual->False], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3901808152556*^9, 3.3901808208016*^9}, {
  3.3901808514156*^9, 3.3901810836176*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Example: Using the attribute ",
 StyleBox["HoldAll",
  FontVariations->{"Underline"->True}],
 " \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      SubscriptBox["arg", "1"], ",", 
      SubscriptBox["arg", "2"], ",", 
      SubscriptBox["arg", "3"], ",", "...", " ", ",", 
      SubscriptBox["arg", "n"]}], "]"}], "   ", "is", "  ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
   TraditionalForm]]],
 "\n\t(",
 StyleBox["Non",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "Standard Evaluation Procedure)\n\t\n\tEvaluate First\t\n\tSubstitute Second"
}], "Subsection",
 CellChangeTimes->{
  3.3901807731415997`*^9, {3.3901838915226*^9, 3.3901838922366*^9}, {
   3.3901841420586*^9, 3.3901841566796*^9}}],

Cell[TextData[{
 "This example uses the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 " where the attribute HoldAll ",
 StyleBox["helps",
  FontVariations->{"Underline"->True}],
 " the evaluation process proceed as desired:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Plot", "]"}]], "Input",
 CellChangeTimes->{{3.3901810977846003`*^9, 3.3901811058976*^9}}],

Cell[TextData[{
 "Observe that the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 " ",
 StyleBox["does",
  FontVariations->{"Underline"->True}],
 " have the attribute HoldAll."
}], "Text"],

Cell[TextData[{
 "Assign a value to the symbol ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and define our function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"x", "=", "5"}]}], "Input"],

Cell["Evaluate:", "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", "1"}], "}"}]}], "]"}]], "Input"],

Cell[TextData[{
 "Remember, the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "-defined function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "  ",
 StyleBox["does",
  FontVariations->{"Underline"->True}],
 " hold its arguments with attribute HoldAll and therefore:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "5", "]"}], TraditionalForm]]],
 " was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " substituted into the ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " argument \n\t\n\tand ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]]],
 " was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " substituted into the ",
 StyleBox["second",
  FontVariations->{"Underline"->True}],
 " argument.\n\t\n\t",
 StyleBox["If",
  FontVariations->{"Underline"->True}],
 " this substitution had occurred, we would have obtained the ",
 StyleBox["un",
  FontVariations->{"Underline"->True}],
 "desired result: \n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"f", "[", "5", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "0", ",", "1"}], "}"}]}], "]"}], " ", "\[Rule]",
     " ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["5", "2"], "+", "\[Pi]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "0", ",", "1"}], "}"}]}], "]"}]}], 
   TraditionalForm]]],
 "\n\t\n\tthat would generate an error message because of the fact that the \
number 5 cannot be a plotting variable.  \n\n",
 StyleBox["Evaluate First:", "Subsubsection"],
 "\nHowever, the Plot command has attribute HoldAll and therefore the command \
that was evaluated was:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "\n\t\neven though ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]]],
 ".\n\n",
 StyleBox["Substitute Second:", "Subsubsection"],
 "\nAfter the plot was generated and displayed, there is no \"x\" remaining \
for substitution. So nothing happens!\n\nIn this specific case, the attribute \
HoldAll automatically protected this function from the undesirable \
substitution of the variable ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{
  3.3901811714386*^9, {3.3901812516236*^9, 3.3901812540706*^9}, {
   3.3901812947265997`*^9, 3.3901814364486*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Problems",
  FontVariations->{"Underline"->True}],
 " caused by using the attribute HoldAll\n\tExample: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      SubscriptBox["arg", "1"], ",", 
      SubscriptBox["arg", "2"], ",", 
      SubscriptBox["arg", "3"], ",", "...", " ", ",", 
      SubscriptBox["arg", "n"]}], "]"}], "   ", "is", "  ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
   TraditionalForm]]],
 "\n\t\n\tEvaluate First\t\n\tSubstitute Second"
}], "Subsection",
 CellChangeTimes->{
  3.3901812105806*^9, {3.3901838978686*^9, 3.3901839001716003`*^9}, 
   3.3901841674306*^9}],

Cell[TextData[{
 "This example uses the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 " where the attribute HoldAll causes the code to ",
 StyleBox["fail",
  FontVariations->{"Underline"->True}],
 "."
}], "Text"],

Cell[TextData[{
 "As before, observe that the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 " ",
 StyleBox["does",
  FontVariations->{"Underline"->True}],
 " have the attribute HoldAll."
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Plot", "]"}]], "Input"],

Cell[TextData[{
 "Assign a formula to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{
   SuperscriptBox["x", "2"], "+", "\[Pi]"}]}]}], "Input"],

Cell[TextData[{
 "Evaluate the derivative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "x"], 
  RowBox[{"f", "[", "x", "]"}]}]], "Input"],

Cell[TextData[{
 "Next, attempt to plot the derivative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 " expressed as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"f", "[", "x", "]"}]}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3901814831196003`*^9, 3.3901814847406*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", " ", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"f", "[", "x", "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", "1"}], "}"}]}], "]"}]], "Input"],

Cell[TextData[{
 "This code failed!  Why?\n\nRemember, the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "-defined function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"f", "[", "x", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", "1"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "  ",
 StyleBox["does",
  FontVariations->{"Underline"->True}],
 " hold its arguments with attribute HoldAll and therefore all of its \
arguments are held from ",
 StyleBox["both",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["substitution",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["evaluation",
  FontVariations->{"Underline"->True}],
 ". Therefore, the following substitution and evaluation was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " made in the first argument:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"f", "[", "x", "]"}]}], TraditionalForm]]],
 " was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " replaced by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", "\[Pi]"}], ")"}]}], " ", "\[Rule]", " ", 
    RowBox[{"2", "x"}]}], TraditionalForm]]],
 ",\n\t\n",
 StyleBox["If",
  FontVariations->{"Underline"->True}],
 " this substitution and evaluation ",
 StyleBox["had",
  FontVariations->{"Underline"->True}],
 " occurred, then we would have obtained:\n\t\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"2", "x"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", "1"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "\n\t\nwhich is exactly what we wanted (and it would have worked correctly).\
\n\t\nRather, the attribute HoldAll forces the holding of the first (along \
with the second) argument.  This attribute causes ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "to evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"f", "[", "x", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", "1"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 " by plugging in roughly twenty ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " values from 0 to 1 into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"f", "[", "x", "]"}]}], TraditionalForm]]],
 " starting with the value something like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"2.04", "\[Times]", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]}], TraditionalForm]]],
 " in an attempt to generate the plot.  Therefore, the ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " point out of 20 points ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " attempts to plot is  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"2.04", "\[Times]", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]}], TraditionalForm]]],
 ". This yields the first step in the evaluation procedure for the plot:\n\n\t\
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"f", "[", "x", "]"}]}], "\[Rule]", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"2.04", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}]], 
     RowBox[{"f", "[", 
      RowBox[{"2.04", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}]}]}], TraditionalForm]]],
 "  \n\t\ni.e.  \n\t\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d", 
     RowBox[{"d", "(", 
      RowBox[{"2.04", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], ")"}]], 
    RowBox[{"(", 
     RowBox[{"f", "[", 
      RowBox[{"2.04", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}], "]"}], ")"}]}], TraditionalForm]]],
 "\n\nThis, of course, generates an error message because you cannot \
differentiate with respect to the number ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2.04", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], TraditionalForm]]],
 " (because a number is ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " a variable, i.e. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", 
    RowBox[{"2.04", "\[Times]", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}]], TraditionalForm]]],
 " makes no sense)."
}], "Text",
 CellChangeTimes->{{3.390132494803*^9, 3.3901325787609997`*^9}, 
   3.3901825311736*^9, {3.3901826344416*^9, 3.3901826646596003`*^9}, {
   3.3901827162726*^9, 3.3901828177986*^9}}],

Cell[TextData[{
 "The above example illustrates a situation in which ",
 StyleBox["substitution",
  FontVariations->{"Underline"->True}],
 " into and ",
 StyleBox["evaluation",
  FontVariations->{"Underline"->True}],
 " of the first argument of the Plot function is necessary in order for the \
code to work."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Fixing problems",
  FontVariations->{"Underline"->True}],
 " caused by the attribute HoldAll.\n\tExample: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      SubscriptBox["arg", "1"], ",", 
      SubscriptBox["arg", "2"], ",", 
      SubscriptBox["arg", "3"], ",", "...", " ", ",", 
      SubscriptBox["arg", "n"]}], "]"}], "   ", "is", "  ", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", "1"}], "}"}]}], "]"}]}], 
   TraditionalForm]]],
 "\n\t\n\tEvaluate First\t\n\tSubstitute Second\n\t\t\n\tMethod:  Force \
evaluation with Evaluate[ ... ]"
}], "Subsection",
 CellChangeTimes->{{3.3901828840366*^9, 3.3901829283496*^9}, {
   3.3901839026776*^9, 3.3901839055926*^9}, 3.3901841737265997`*^9}],

Cell[TextData[{
 "Once we understand the behavior of the attribute HoldAll, we can ",
 StyleBox["force",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["substitution",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["evaluation",
  FontVariations->{"Underline"->True}],
 " of the ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " argument of the Plot function explicitly as follows:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"f", "[", "x", "]"}]}], "]"}], ",", " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", "1"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901325996280003`*^9, 3.390132609715*^9}}],

Cell["\<\
Trace the above evaluation procedure step-by-step to determine exactly how it \
was achieved:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"f", "[", "x", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{{3.3901326156289997`*^9, 3.3901326227980003`*^9}}],

Cell[TextData[{
 "The relevant steps are associated with the first argument of:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", " ", 
    RowBox[{
     StyleBox[
      RowBox[{"Evaluate", "[", 
       RowBox[{
        SubscriptBox["\[PartialD]", "x"], 
        RowBox[{"f", "[", "x", "]"}]}], "]"}],
      FontColor->RGBColor[1, 0, 0]], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", "1"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "\n\t\nthat is forced to be evaluated:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"f", "[", "x", "]"}]}], "]"}], " ", "\[Rule]", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", "x", "]"}], ",", 
       RowBox[{"\[Pi]", "+", 
        SuperscriptBox["x", "2"]}]}], "}"}], " ", "\[Rule]", " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"(", 
        RowBox[{"\[Pi]", "+", 
         SuperscriptBox["x", "2"]}], ")"}]}], " ", "\[Rule]", 
      RowBox[{"2", " ", "x", " "}]}]}]}], TraditionalForm]]],
 "\n\t\nand therefore the Plot function with its first argument evaluated \
becomes:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"2", " ", "x"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], TraditionalForm]]],
 "\n\t\nthat plots the desired graph without problem."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Using the ",
 "attribute ",
 StyleBox["HoldRest",
  FontVariations->{"Underline"->True}],
 " in ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " assignment  \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "1"}]}], TraditionalForm]]],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Set", "[", 
      RowBox[{"lhs", ",", " ", "rhs"}], "]"}], "      ", 
     RowBox[{"i", ".", "e", ".", "    ", "lhs"}]}], "=", "rhs"}], 
   TraditionalForm]]],
 "\n\n\t(",
 StyleBox["Non",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "Standard Evaluation Procedure)"
}], "Subsection",
 CellChangeTimes->{{3.3901830459126*^9, 3.3901830545806*^9}, 
   3.3901839133326*^9, {3.3901840792546*^9, 3.3901840798556004`*^9}}],

Cell[TextData[{
 "First, verify that the full form of the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " expression  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "=", "rhs"}], TraditionalForm]]],
 "  for ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " assignment is indeed  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\"\<Set\>\"", "[", 
    RowBox[{"lhs", ",", "rhs"}], "]"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"lhs", ",", "rhs"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"lhs", "=", "rhs"}], ")"}], "//", "Hold"}], "//", 
  "TreeForm"}]}], "Input"],

Cell[TextData[{
 "Second, determine the attributes of the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command Set  (i.e. ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " assignment \"=\"):"
}], "Text",
 CellChangeTimes->{{3.3901831417665997`*^9, 3.3901831455596*^9}}],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Set", "]"}]], "Input",
 CellChangeTimes->{{3.3901831113456*^9, 3.3901831168866*^9}, {
  3.3901831553796*^9, 3.3901831641596003`*^9}}],

Cell[TextData[{
 "Observe that the Set command has attribute HoldFirst.  Therefore, we know \
that ",
 StyleBox["every",
  FontVariations->{"Underline"->True}],
 " possible substitution (and evaluation) that can be made into the the \
second argument (i.e. the right hand side) ",
 StyleBox["will",
  FontVariations->{"Underline"->True}],
 " be performed ",
 StyleBox["befor",
  FontVariations->{"Underline"->True}],
 " the assignment to the left hand side is made.\n\nAs an example, assign a \
value to the symbol ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and define our function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 "  using ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " assignment \"=\":\n\n\t\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], TraditionalForm]]],
 "   i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Set", "[", 
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ",", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], "]"}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3901831862176*^9, 3.3901832415875998`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", "5"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{
   SuperscriptBox["x", "2"], "+", "\[Pi]"}]}]}], "Input"],

Cell[TextData[{
 "Verify that the assignment to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 " has been made:"
}], "Text"],

Cell[BoxData[
 RowBox[{"??", "f"}]], "Input"],

Cell["\<\
Trace the above evaluation procedure step-by-step to determine exactly how it \
was achieved:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901832640526*^9, 3.3901832725306*^9}}],

Cell[TextData[{
 "Observe that ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " the right hand side (i.e. second argument of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Set", "[", 
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ",", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], "]"}], TraditionalForm]]],
 ") was evaluated:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", " ", "\[Rule]", " ", "5"}], "}"}], " ", "\[Rule]", " ", 
      RowBox[{
       SuperscriptBox["5", "2"], " ", "\[Rule]", " ", "25"}]}], "}"}], "   ", 
    "\[Rule]", "   ", 
    RowBox[{"25", "+", "\[Pi]"}]}], TraditionalForm]]],
 "\n\t\t\n\tthen the assignment was made to the left hand side:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "    ", "\[Rule]", "    ", 
    RowBox[{"25", "+", "\[Pi]"}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3901832970746*^9, 3.3901833263246*^9}, {
  3.3901833716306*^9, 3.3901833875156*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Using the attribute ",
 StyleBox["HoldAll",
  FontVariations->{"Underline"->True}],
 " in ",
 StyleBox["delayed",
  FontVariations->{"Underline"->True}],
 " assignment  \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "1"}]}], TraditionalForm]]],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"SetDelayed", "[", 
      RowBox[{"lhs", ",", " ", "rhs"}], "]"}], "       ", 
     RowBox[{"i", ".", "e", ".", "    ", "lhs"}]}], ":=", "rhs"}], 
   TraditionalForm]]],
 "\n\t\n\t(",
 StyleBox["Non",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "Standard Evaluation Procedure)"
}], "Subsection",
 CellChangeTimes->{{3.3901834114876003`*^9, 3.3901834298606*^9}, 
   3.3901839182916*^9, {3.3901840677406*^9, 3.3901840697076*^9}}],

Cell[TextData[{
 "First, verify that the full form of the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " expression  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", ":=", "rhs"}], TraditionalForm]]],
 "  for ",
 StyleBox["delayed",
  FontVariations->{"Underline"->True}],
 " assignment is indeed  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\"\<Set\>\"", 
    RowBox[{"Delayed", "[", 
     RowBox[{"lhs", ",", "rhs"}], "]"}]}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"lhs", ",", "rhs"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"lhs", ":=", "rhs"}], ")"}], "//", "Hold"}], "//", 
  "TreeForm"}]}], "Input"],

Cell[TextData[{
 "Second, determine the attributes of the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command SetDelayed  (i.e. ",
 StyleBox["delayed",
  FontVariations->{"Underline"->True}],
 " assignment):"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "SetDelayed", "]"}]], "Input",
 CellChangeTimes->{{3.3901834488526*^9, 3.3901834611966*^9}}],

Cell[TextData[{
 "Observe that the SetDelayed command has attribute ",
 StyleBox["HoldAll",
  FontVariations->{"Underline"->True}],
 ".  Therefore, we know that ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " substitutions (and ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " evaluations) will be made for ",
 StyleBox["either",
  FontVariations->{"Underline"->True}],
 " the first or second arguments (i.e. the both the left-hand side and the \
right-hand side ",
 StyleBox["will",
  FontVariations->{"Underline"->True}],
 " remained ",
 StyleBox["un",
  FontVariations->{"Underline"->True}],
 "evaluated).\n\nAs an example, assign a value to the symbol ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and define our function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 "  using ",
 StyleBox["delayed",
  FontVariations->{"Underline"->True}],
 " assignment \"",
 Cell[BoxData[
  FormBox[":=", TraditionalForm]]],
 "\":\n\n\t\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], TraditionalForm]]],
 "   i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"SetDelayed", "[", 
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ",", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], "]"}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3901834828866*^9, 3.3901834941956*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "f"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", "5"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox["x", "2"], "+", "\[Pi]"}]}]}], "InputOnly"],

Cell[TextData[{
 "Verify that the assignment to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 " has been made:"
}], "Text"],

Cell[BoxData[
 RowBox[{"??", "f"}]], "Input"],

Cell["\<\
Trace the above evaluation procedure step-by-step to determine exactly how it \
was achieved:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", "5"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.3901835144175997`*^9, 3.3901835253585997`*^9}}],

Cell[TextData[{
 "Observe that ",
 StyleBox["neither",
  FontVariations->{"Underline"->True}],
 " the left-hand side (i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x_", "]"}], TraditionalForm]]],
 ") or  the right-hand side (i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "+", "\[Pi]"}], TraditionalForm]]],
 ") of the SetDelayed command  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "\[Pi]"}]}], TraditionalForm]]],
 "  was evaluated, even though we have the assignment  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]]],
 "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Summary
\tFunctions both with and without \"hold\" attributes:\
\>", "Subsection",
 CellChangeTimes->{3.3901839231666*^9}],

Cell[TextData[{
 "Often, as illustrated above, whether a function holds or does not hold its \
arguments generates exactly the same result (even though the step-by-step \
procedure is different for the two procedures).  Therefore, you only need to \
worry about this when your code unexpectedly fails or gives unexpected \
results.  The procedure used to correct the problem is to examine the \
attributes of your function and determine if you need to ",
 StyleBox["clear",
  FontVariations->{"Underline"->True}],
 " values for arguments entering functions that do ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " hold their arguments, or, if you need to explicitly ",
 StyleBox["evaluate",
  FontVariations->{"Underline"->True}],
 " arguments in functions that ",
 StyleBox["hold",
  FontVariations->{"Underline"->True}],
 " one or more of their arguments.  In either case, the analysis begins with \
determining the attributes of a function either by:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "If", "]"}]], "Input",
 CellChangeTimes->{{3.3901836222486*^9, 3.3901836226576*^9}}],

Cell["Or by using the information request:", "Text"],

Cell[BoxData[
 RowBox[{"??", "If"}]], "Input",
 CellChangeTimes->{{3.3901836273096*^9, 3.3901836275596*^9}}],

Cell["\<\

Remember, always cleanup the assignments and attributes you give to functions \
when you are done.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"x", ",", "y", ",", "f", ",", "g", ",", "h", ",", "k"}], 
  "]"}]], "InputOnly"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Exercises ", "Title"],
 "  Advanced Lesson 2"
}], "Section",
 CellChangeTimes->{{3.390375117367*^9, 3.390375117499*^9}, 
   3.3907918372790003`*^9, {3.460216356171318*^9, 3.460216360061943*^9}}],

Cell["\<\
Your Name:

Your Math Class:\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.460216512952568*^9},
 FontSize->16,
 FontWeight->"Bold"],

Cell[TextData[{
 "Remember to clear all variables that you will use below:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Clear", "[", 
    RowBox[{
    "a", ",", "b", ",", "c", ",", "d", ",", "i", ",", "n", ",", "f", ",", "g",
      ",", "h"}], "]"}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.390692597644142*^9, 3.3906926408551426`*^9}, {
  3.3907193082234*^9, 3.3907193127434*^9}}],

Cell[TextData[{
 "1: ",
 StyleBox["After",
  FontVariations->{"Underline"->True}],
 " evaluation, how many digits of numerical accuracy do each of the following \
expressions have?\n\t\[GrayCircle] 3/7\n\t\[GrayCircle] 2+3/7\n\t\
\[GrayCircle] 2.0+3.0/7.0\t\t(Hint: You can use   InputForm[2.0 + 3.0/7.0]   \
to see all digits.)\n\t\[GrayCircle] 1.23+1.2345/1.234567   (See the Hint.)\n\
\t\[GrayCircle] 1.2+1.2345678901234567890+1.23456789012345678901234567890\n\t\
\[GrayCircle] 1.2345678901234567890+1.23456789012345678901234567890\n\t\
\[GrayCircle] N[2/7]   (See the Hint.)\n\t\[GrayCircle] N[2/7,100]\n\t\
\[GrayCircle] After evaluation, why does ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " leave ",
 Cell[BoxData[
  FormBox[
   SqrtBox["2"], TraditionalForm]]],
 " as ",
 Cell[BoxData[
  FormBox[
   SqrtBox["2"], TraditionalForm]]],
 " and not as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["2"], " ", "\[Rule]"}], TraditionalForm]]],
 " 1.4142135623730951"
}], "Text",
 CellChangeTimes->{{3.3901682233866*^9, 3.3901683123806*^9}, {
   3.3901683604096003`*^9, 3.3901684386886*^9}, {3.3901685090556*^9, 
   3.3901685116586*^9}, {3.3901685442546*^9, 3.3901686127556*^9}, {
   3.3901686481116*^9, 3.3901686663236*^9}, {3.3901687012906*^9, 
   3.3901687735986*^9}, {3.3901688095025997`*^9, 3.3901688705226*^9}, {
   3.3901696512806*^9, 3.3901696669666*^9}, {3.3903800783529997`*^9, 
   3.390380444362*^9}, {3.390380492519*^9, 3.390380512209*^9}, {
   3.390380704762*^9, 3.390380717965*^9}, {3.3907169137994003`*^9, 
   3.3907169226434*^9}, {3.3907172612584*^9, 3.3907172774354*^9}, {
   3.3907174533264*^9, 3.3907176276734*^9}, 3.3907177293473997`*^9, {
   3.3907178189244003`*^9, 3.3907178415464*^9}, {3.3907178845004*^9, 
   3.3907179061684*^9}, 3.3907187126784*^9, {3.390773931276*^9, 
   3.390773941097*^9}}],

Cell[TextData[{
 "2: \[GrayCircle] i: Evaluate exactly: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "100"], " ", 
    FractionBox["1", "n"]}],
   FontWeight->"Bold"]],
  FontSize->16],
 "  \n    \[GrayCircle] ii: Evaluate: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "100"], " ", 
    FractionBox["1.0", "n"]}],
   FontWeight->"Bold"]],
  FontSize->16],
 "  \n    \[GrayCircle] iii: Evaluate: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "100"], " ", 
    RowBox[{"N", "[", 
     FractionBox["1", "n"], "]"}]}],
   FontWeight->"Bold"]],
  FontSize->16],
 "  \n    \[GrayCircle] iv: Evaluate: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"N", "[", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "1"}], "100"], " ", 
     FractionBox["1", "n"]}], "]"}],
   FontWeight->"Bold"]],
  FontSize->16],
 "  \n    \[GrayCircle] v: Evaluate:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox[
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["n",
         FontSlant->"Plain"], "=", "1"}], "100"],
      FontSize->14], " ", 
     FractionBox["1", 
      StyleBox["n",
       FontSlant->"Plain"]]}],
    FontWeight->"Bold"], TraditionalForm]]],
 " to 50 digit accuracy\n    \[GrayCircle] vi: ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " to evaluate:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox[
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["n",
         FontSlant->"Plain"], "=", "1"}], "100"],
      FontSize->14], " ", 
     FractionBox["1.0", 
      StyleBox["n",
       FontSlant->"Plain"]]}],
    FontWeight->"Bold"], TraditionalForm]]],
 " to 50 digit accuracy using ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox["N",
      FontSlant->"Plain"], "[", 
     RowBox[{
      RowBox[{
       StyleBox[
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "1"}], "100"],
        FontSize->14], 
       FractionBox["1.0", 
        StyleBox["n",
         FontSlant->"Plain"]]}], ",", " ", "50"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n            (Keep the 1.0)\n            (Why did it ",
 StyleBox["fail",
  FontVariations->{"Underline"->True}],
 " to give 50 digit accuracy?)"
}], "Text",
 CellChangeTimes->{{3.390375182149*^9, 3.390375218159*^9}, {3.390375281145*^9,
    3.39037544659*^9}, {3.390375479126*^9, 3.390375694005*^9}, 
   3.390380514932*^9, {3.4390618478125*^9, 3.43906186890625*^9}, {
   3.439061900265625*^9, 3.43906192634375*^9}}],

Cell[TextData[{
 " 3: \[GrayCircle] Evaluate to 500 significant digits: ",
 Cell[BoxData[
  StyleBox[
   FormBox[
    SuperscriptBox["\[ExponentialE]", 
     StyleBox["\[Pi]",
      FontWeight->"Bold"]],
    TraditionalForm],
   FontWeight->"Bold"]],
  FontSize->16],
 "  (Remember to use ",
 StyleBox["\[ExponentialE]",
  FontWeight->"Bold"],
 " from the palette and not ",
 StyleBox["e",
  FontWeight->"Bold"],
 ")\n     \[GrayCircle] Evaluate exactly: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   FormBox[
    SuperscriptBox["\[ExponentialE]", 
     StyleBox["\[Pi]",
      FontWeight->"Bold"]],
    TraditionalForm],
   FontWeight->"Bold"]],
  FontSize->16],
 "          Why did it remain the same?"
}], "Text",
 CellChangeTimes->{{3.390375244703*^9, 3.390375258473*^9}, {3.390377116962*^9,
    3.390377138668*^9}, 3.390380520752*^9, 3.3907187545234003`*^9, {
   3.439061964453125*^9, 3.4390619919375*^9}}],

Cell[TextData[{
 " 4: \[GrayCircle] Evaluate the complex number exactly: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "1"}], "10"], " ", 
     FractionBox["1", 
      RowBox[{"n", " ", "+", " ", 
       RowBox[{"2", "\[ImaginaryI]"}]}]]}], "  "}],
   FontWeight->"Bold"]],
  FontSize->16],
 "\n        (Use the Basic Math Input Palette to enter \"\[ImaginaryI]\".)\n  \
   \[GrayCircle] Evaluate to 50 significant digits: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "10"], " ", 
    FractionBox["1", 
     RowBox[{"n", " ", "+", " ", 
      RowBox[{"2", "\[ImaginaryI]"}]}]]}],
   FontWeight->"Bold"]],
  FontSize->16],
 "    \n     \[GrayCircle] Try to evaluate ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "10"], " ", 
    FractionBox["1", 
     RowBox[{"n", " ", "+", " ", 
      RowBox[{"2.0", "\[ImaginaryI]"}]}]]}],
   FontWeight->"Bold"]],
  FontSize->16],
 " to 50 significant digits\n            (Keep the 2.0)\n            (Why did \
it ",
 StyleBox["fail",
  FontVariations->{"Underline"->True}],
 " to give 50 digit accuracy?)   "
}], "Text",
 CellChangeTimes->{{3.390375809803*^9, 3.390375957906*^9}, {3.390376004941*^9,
    3.390376070615*^9}, 3.390380524234*^9, {3.3903807380880003`*^9, 
   3.390380738672*^9}, {3.390774010609*^9, 3.390774034644*^9}, {
   3.390774098611*^9, 3.390774139307*^9}}],

Cell[TextData[{
 " 5: \[GrayCircle] Evaluate exactly: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", "6", "]"}],
   FontWeight->"Bold"]],
  FontSize->16],
 "  \n     \[GrayCircle] Evaluate: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", "6.0", "]"}],
   FontWeight->"Bold"]],
  FontSize->16],
 "  \n     \[GrayCircle] Evaluate to 50 significant digits: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", "6", "]"}],
   FontWeight->"Bold"]],
  FontSize->16],
 "  \n     \[GrayCircle] ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " to evaluate to 50 significant digits: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", "6.0", "]"}],
   FontWeight->"Bold"]],
  FontSize->16],
 "  Why does it fail to get 50 digits?\n     \[GrayCircle] ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " to evaluate to 50 significant digits: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", 
    RowBox[{"N", "[", 
     RowBox[{"6", ",", "20"}], "]"}], "]"}],
   FontWeight->"Bold"]],
  FontSize->16],
 "   Why does it fail to get 50 digits?"
}], "Text",
 CellChangeTimes->{{3.390376177741*^9, 3.3903761953269997`*^9}, {
   3.390376251955*^9, 3.390376254749*^9}, {3.3903763031470003`*^9, 
   3.390376315616*^9}, 3.3903805299820004`*^9, {3.439062054671875*^9, 
   3.439062098640625*^9}}],

Cell[TextData[{
 "6: \[GrayCircle] Define a user function:  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox["f",
      FontSlant->"Plain"], " ", "[", "nTerms_", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  using the formula  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], 
     StyleBox["nTerms",
      FontWeight->"Bold"]], " ", 
    FractionBox["1", "n"]}],
   FontWeight->"Bold"]],
  FontSize->16],
 "   which will evaluate exactly.\n    \[GrayCircle] Evaluate:  ",
 StyleBox["f [1]",
  FontWeight->"Bold"],
 ",  ",
 StyleBox["f [10]",
  FontWeight->"Bold"],
 ", ",
 StyleBox["f [100]",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.390376345012*^9, 3.39037649308*^9}, 3.390380533752*^9, {
   3.3906926310831423`*^9, 3.3906926313461423`*^9}, {3.43906211659375*^9, 
   3.439062186671875*^9}}],

Cell[TextData[{
 "7: It is possible to determine the name associated with every system \
function using:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Names", "[", " ", "\"\<System`*\>\"", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "     (Remember the \"wild card\" ",
 Cell[BoxData[
  FormBox[
   StyleBox["*",
    FontSize->14,
    FontWeight->"Bold"], TraditionalForm]]],
 " and use ",
 StyleBox["`",
  FontSize->14,
  FontWeight->"Bold"],
 " and not ",
 StyleBox["' ",
  FontSize->14,
  FontWeight->"Bold"],
 ")\n\t\t\n    \[GrayCircle] Evaluate the above expression to determine which \
system functions are available.\n       Please ",
 StyleBox["delete",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " this list of system functions ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " you print your notebook because\n       the list is too long to print!\n   \
 \[GrayCircle] Determine the total number of system functions available:\n    \
\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Length", "[", " ", 
     RowBox[{"Names", "[", " ", "\"\<System`*\>\"", " ", "]"}], " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{
  3.390377770832*^9, 3.39037817377*^9, 3.3903794742790003`*^9, {
   3.3903795045629997`*^9, 3.390379554225*^9}, {3.3903795853789997`*^9, 
   3.3903796185109997`*^9}, 3.390380546866*^9, 3.390380754752*^9, {
   3.390774419283*^9, 3.390774614369*^9}, 3.390791909118*^9, {
   3.390792030663*^9, 3.390792030829*^9}, 3.397919936120927*^9, {
   3.439062257953125*^9, 3.4390623019375*^9}, {3.439062400609375*^9, 
   3.439062459578125*^9}}],

Cell[TextData[{
 "8: \[GrayCircle] Part 1:  Define a function (name it ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff1", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ") that differentiates a function  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  with respect \n                      to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " assignment (i.e. \"",
 Cell[BoxData[
  FormBox[Cell[TextData[StyleBox["=",
    FontWeight->"Bold"]]], TraditionalForm]]],
 "\")\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"x", ",", "f"}], "]"}], ";"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"myDiff1", "[", "f_", "]"}], "=", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", "f"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\n     \[GrayCircle] Part 2:  Evaluate the following lines of code:\n\t\t\
\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff1", "[", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      RowBox[{"3", "x"}], "+", "4"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff1", "[", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"2", "x"}], "+", "3"}]], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff1", "[", 
     RowBox[{"f", "[", "x", "]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"?", "myDiff1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n                     Explain (in a Text Cell) why you did NOT get the \
correct answers for differentiation.\n\t\n     \[GrayCircle] Part 3:  Define \
a function (name it ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ") that differentiates a function  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  with respect \n                     to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using ",
 StyleBox["delayed",
  FontVariations->{"Underline"->True}],
 " assignment (i.e. \"",
 StyleBox[":",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["=", TraditionalForm]],
  FontWeight->"Bold"],
 "\")\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"myDiff2", "[", "f_", "]"}], ":=", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", "f"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\n     \[GrayCircle] Part 4:  Evaluate the following lines of code:\n\t\t\
\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      RowBox[{"3", "x"}], "+", "4"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"2", "x"}], "+", "3"}]], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", 
     RowBox[{"f", "[", "x", "]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"?", "myDiff2"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n                     Explain (in a Text Cell) why you DID get the correct \
answers.\n\n     \[GrayCircle] Part 5:  Explain (in a Text Cell) why you ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " (for this case) use ",
 StyleBox["delayed",
  FontVariations->{"Underline"->True}],
 " assignment (i.e.  \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\") \n                     to define your function ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " so that it will work properly."
}], "Text",
 CellChangeTimes->{
  3.390378440027*^9, 3.390379486467*^9, {3.3903796319639997`*^9, 
   3.390379670763*^9}, {3.390379701064*^9, 3.390379785216*^9}, {
   3.390380552295*^9, 3.390380614347*^9}, {3.390726463576*^9, 
   3.3907266942139997`*^9}, {3.3907267401210003`*^9, 3.390726750259*^9}, {
   3.390726795407*^9, 3.390726833645*^9}, {3.39072686962*^9, 
   3.3907269371029997`*^9}, {3.390727009285*^9, 3.390727026301*^9}, {
