 RowBox[{"N", "[", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", "\[Pi]"], ",", "500"}], "]"}]], "Input",E\
xpressionUUID->"dffb722e-5c59-4a84-ac7f-d719b8fe3e0d"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", "\[Pi]"]], "Input",ExpressionUUID->"c7c5d89d-8d64-4191-b644-364b0f6b2dee"],

Cell["\<\
N[E^Pi, 500] prints 500 digits. Evaluated on its own, E^Pi stays as E^Pi \
because it is exact, and Mathematica never converts an exact expression to a \
decimal unless asked.\
\>", "Text",ExpressionUUID->"31d65fbb-7ab9-4a5f-8272-998a38c15da4"],

