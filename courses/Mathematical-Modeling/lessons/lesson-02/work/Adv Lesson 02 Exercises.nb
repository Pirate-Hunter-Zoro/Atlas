Cell[BoxData[
 RowBox[{
  UnderoverscriptBox["\[Sum]", 
   RowBox[{"n", "=", "1"}], "10"], 
  FractionBox["1", 
   RowBox[{"n", "+", 
    RowBox[{"2", " ", "\[ImaginaryI]"}]}]]}]], "Input",ExpressionUUID->\
"e65612d4-eea2-409d-9f50-c1569fffa833"],

