Cell["\<\
Exact numbers carry infinite precision, so 3/7 and 2 + 3/7 stay as fractions. \
A number written with a decimal point is a machine number carrying about 16 \
digits, so 2.0 + 3.0/7.0 and 1.23 + 1.2345/1.234567 have about 16. When \
precisions are mixed the answer is only as good as the worst input: adding \
1.2 to the 19-digit and 29-digit numbers drops the result to machine \
precision, while the 19- and 29-digit numbers on their own give 19. N[2/7] \
gives about 16 digits and N[2/7, 100] gives 100. Sqrt[2] stays as Sqrt[2] \
because it is exact; Mathematica only turns it into a decimal when asked with \
N.\
\>", "Text",ExpressionUUID->"32475f20-a3ed-470d-8bfd-232f0b64fb8b"],

Cell[TextData[{
 "2: \[GrayCircle] i: Evaluate exactly: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "100"], " ", 
    FractionBox["1", "n"]}],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"d88b7ce3-e1ba-4294-8871-07da8a7baa7c"],
 "  \n    \[GrayCircle] ii: Evaluate: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "100"], " ", 
    FractionBox["1.0", "n"]}],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"de81ed91-5046-49d7-b00d-310c7c834975"],
 "  \n    \[GrayCircle] iii: Evaluate: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "100"], " ", 
    RowBox[{"N", "[", 
     FractionBox["1", "n"], "]"}]}],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"b507fedc-de63-4048-a137-159f1745734f"],
 "  \n    \[GrayCircle] iv: Evaluate: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"N", "[", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "1"}], "100"], " ", 
     FractionBox["1", "n"]}], "]"}],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"5d9bd4c9-5450-4d1b-820e-b1327497cacf"],
 "  \n    \[GrayCircle] v: Evaluate:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox[
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["n",
         FontSlant->"Plain"], "=", "1"}], "100"],
      FontSize->14], " ", 
     FractionBox["1", 
      StyleBox["n",
       FontSlant->"Plain"]]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "8e17e41f-ef7e-43c1-a2a2-29d5da12e521"],
 " to 50 digit accuracy\n    \[GrayCircle] vi: ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " to evaluate:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox[
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["n",
         FontSlant->"Plain"], "=", "1"}], "100"],
      FontSize->14], " ", 
     FractionBox["1.0", 
      StyleBox["n",
       FontSlant->"Plain"]]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "771d3133-621a-4872-b02e-e5aec4555d0a"],
 " to 50 digit accuracy using ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox["N",
      FontSlant->"Plain"], "[", 
     RowBox[{
      RowBox[{
       StyleBox[
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "1"}], "100"],
        FontSize->14], 
       FractionBox["1.0", 
        StyleBox["n",
         FontSlant->"Plain"]]}], ",", " ", "50"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "d5f92562-85c2-4bbd-a61d-f76141b7d065"],
 "\n            (Keep the 1.0)\n            (Why did it ",
 StyleBox["fail",
  FontVariations->{"Underline"->True}],
 " to give 50 digit accuracy?)"
}], "Text",
