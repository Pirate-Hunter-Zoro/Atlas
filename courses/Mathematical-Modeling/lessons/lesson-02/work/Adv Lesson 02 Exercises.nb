Cell["6: The partial sums as a user function", "Section",ExpressionUUID->"7699424a-e140-49ce-9357-6653894a8d66"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "n", ",", "nTerms"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "nTerms_", "]"}], ":=", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"n", "=", "1"}], "nTerms"], 
   FractionBox["1", "n"]}]}]}], "Input",ExpressionUUID->"d3a00ddb-1f33-46d5-\
a510-d91e250c0af8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "1", "]"}], ",", 
   RowBox[{"f", "[", "10", "]"}], ",", 
   RowBox[{"f", "[", "100", "]"}]}], "}"}]], "Input",ExpressionUUID->\
"00ea5514-ef18-4775-81af-ac0e7211ab62"],

Cell["7: How many system functions are there?", "Section",ExpressionUUID->"7a9c5e0a-d532-4916-8cc8-cd8ba62ecd66"],

Cell["\<\
Names[\"System`*\"] returns the whole list of built-in names. It is far too
long to print in a submitted notebook, so only its length is evaluated
below; the list itself is computed and discarded.\
\>", "Text",ExpressionUUID->"d13f29b0-88c1-4063-912e-11599564d8a2"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Names", "[", "\"\<System`*\>\"", "]"}], "]"}]], "Input",ExpressionU\
UID->"dd10e5fc-6c7c-4fb0-a236-471fd5835764"],

Cell["\<\
8: myDiff1 and myDiff2 - why differentiation needs delayed assignment\
\>", "Section",ExpressionUUID->"5b828371-8718-4cb9-ba5c-da616cf0985e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "f"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myDiff1", "[", "f_", "]"}], "=", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], "f"}]}]}], "Input",ExpressionUUID->\
"92224ebc-4675-4bbf-b0b3-d75c1d0a656b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"myDiff1", "[", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"3", " ", "x"}], "+", "4"}], "]"}], ",", 
   RowBox[{"myDiff1", "[", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], "+", "3"}], "]"}], ",", 
   RowBox[{"myDiff1", "[", 
    RowBox[{"f", "[", "x", "]"}], "]"}]}], "}"}]], "Input",ExpressionUUID->\
"f827b027-66af-4e32-98c7-1f7cb7646d3e"],

