Cell["\<\
The exact sum is a single complex fraction, and N of it prints 50 digits. \
Writing 2.0 I instead of 2 I makes every term approximate, so the answer \
stops at about 16 digits no matter how many are requested.\
\>", "Text",ExpressionUUID->"2402e421-7c7c-457d-aaab-87db9ffe1c2b"],

Cell[TextData[{
 " 5: \[GrayCircle] Evaluate exactly: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", "6", "]"}],
