  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", "6", "]"}],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"20a192b6-2014-47de-bb07-5295c7528e42"],
 "  \n     \[GrayCircle] ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " to evaluate to 50 significant digits: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", "6.0", "]"}],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"81e3104f-5acc-4a58-aaf1-a6f8083d8124"],
 "  Why does it fail to get 50 digits?\n     \[GrayCircle] ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " to evaluate to 50 significant digits: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   RowBox[{"Sin", "[", 
    RowBox[{"N", "[", 
     RowBox[{"6", ",", "20"}], "]"}], "]"}],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"0086a93c-9383-4f62-89a8-ac7e08ed3592"],
 "   Why does it fail to get 50 digits?"
}], "Text",
 CellChangeTimes->{{3.390376177741*^9, 3.3903761953269997`*^9}, {
   3.390376251955*^9, 3.390376254749*^9}, {3.3903763031470003`*^9, 
   3.390376315616*^9}, 3.3903805299820004`*^9, {3.439062054671875*^9, 
   3.439062098640625*^9}},ExpressionUUID->"08203725-4974-43d8-8a4c-\
76b51fff9c3f"],

Cell[BoxData[
 RowBox[{"Sin", "[", "6", "]"}]], "Input",ExpressionUUID->"5b44772d-4793-4f8f-a434-e108903be9b9"],

Cell[BoxData[
 RowBox[{"Sin", "[", "6.`", "]"}]], "Input",ExpressionUUID->"410261df-1660-41e0-b1f3-7f6a4c76eab3"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "6", "]"}], ",", "50"}], "]"}]], "Input",ExpressionUUID\
->"ef100ad7-c2e1-400e-a505-5cd6027f5785"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "6.`", "]"}], ",", "50"}], "]"}]], "Input",ExpressionUU\
ID->"5bd85412-c301-45b0-b832-f08ab90c6b42"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"N", "[", 
     RowBox[{"6", ",", "20"}], "]"}], "]"}], ",", "50"}], "]"}]], "Input",Expr\
essionUUID->"447b0836-1b35-4c99-8e6e-d5ff9a6f405a"],

Cell["\<\
Sin[6] stays as Sin[6]: 6 is exact and the sine has no simpler exact form. \
Sin[6.0] is -0.279415. N[Sin[6], 50] gives 50 correct digits because it \
starts from the exact form. N[Sin[6.0], 50] cannot, because 6.0 carries only \
about 16 digits, and N[Sin[N[6, 20]], 50] stops near 19 digits for the same \
reason. An answer can never be more precise than its input.\
\>", "Text",ExpressionUUID->"fac13aad-e641-4e4f-be2d-3cae6813e1c6"],

Cell[TextData[{
 "6: \[GrayCircle] Define a user function:  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox["f",
      FontSlant->"Plain"], " ", "[", "nTerms_", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "4adc6a1b-0709-4df2-aef7-363a0cde432d"],
 "  using the formula  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], 
     StyleBox["nTerms",
      FontWeight->"Bold"]], " ", 
    FractionBox["1", "n"]}],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"b7bc0e62-d991-4c14-b69e-124c2a44eb7f"],
 "   which will evaluate exactly.\n    \[GrayCircle] Evaluate:  ",
 StyleBox["f [1]",
  FontWeight->"Bold"],
 ",  ",
 StyleBox["f [10]",
  FontWeight->"Bold"],
 ", ",
 StyleBox["f [100]",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.390376345012*^9, 3.39037649308*^9}, 3.390380533752*^9, {
   3.3906926310831423`*^9, 3.3906926313461423`*^9}, {3.43906211659375*^9, 
   3.439062186671875*^9}},ExpressionUUID->"03a12685-b706-48b1-b063-\
ac23ecd4c23c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "n", ",", "nTerms"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "nTerms_", "]"}], ":=", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"n", "=", "1"}], "nTerms"], 
   FractionBox["1", "n"]}]}]}], "Input",ExpressionUUID->"d3a00ddb-1f33-46d5-\
a510-d91e250c0af8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "1", "]"}], ",", 
   RowBox[{"f", "[", "10", "]"}], ",", 
   RowBox[{"f", "[", "100", "]"}]}], "}"}]], "Input",ExpressionUUID->\
"00ea5514-ef18-4775-81af-ac0e7211ab62"],

Cell[TextData[{
 "7: It is possible to determine the name associated with every system \
function using:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Names", "[", " ", "\"\<System`*\>\"", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "efce373b-6bfe-4c89-8b0e-1ac4db74f9ec"],
 "     (Remember the \"wild card\" ",
 Cell[BoxData[
  FormBox[
   StyleBox["*",
    FontSize->14,
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "7b0b0746-4696-4b8c-94e6-75dcade2d5c2"],
 " and use ",
 StyleBox["`",
  FontSize->14,
  FontWeight->"Bold"],
 " and not ",
 StyleBox["' ",
  FontSize->14,
  FontWeight->"Bold"],
 ")\n\t\t\n    \[GrayCircle] Evaluate the above expression to determine which \
system functions are available.\n       Please ",
 StyleBox["delete",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " this list of system functions ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " you print your notebook because\n       the list is too long to print!\n   \
 \[GrayCircle] Determine the total number of system functions available:\n    \
\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Length", "[", " ", 
     RowBox[{"Names", "[", " ", "\"\<System`*\>\"", " ", "]"}], " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "2db40101-9128-42c3-a805-2a09387d2ebe"]
}], "Text",
 CellChangeTimes->{
  3.390377770832*^9, 3.39037817377*^9, 3.3903794742790003`*^9, {
   3.3903795045629997`*^9, 3.390379554225*^9}, {3.3903795853789997`*^9, 
   3.3903796185109997`*^9}, 3.390380546866*^9, 3.390380754752*^9, {
   3.390774419283*^9, 3.390774614369*^9}, 3.390791909118*^9, {
   3.390792030663*^9, 3.390792030829*^9}, 3.397919936120927*^9, {
   3.439062257953125*^9, 3.4390623019375*^9}, {3.439062400609375*^9, 
   3.439062459578125*^9}},ExpressionUUID->"9a3a0f3a-5942-410b-afb6-\
efd65e2f3217"],

Cell[BoxData[
 TagBox[
  RowBox[{"Names", "[", "\"\<System`*\>\"", "]"}],
  HoldForm]], "Input",ExpressionUUID->"77dde81a-a7d1-4488-bb55-67b6bf003cd8"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Names", "[", "\"\<System`*\>\"", "]"}], "]"}]], "Input",ExpressionU\
UID->"dd10e5fc-6c7c-4fb0-a236-471fd5835764"],

Cell[TextData[{
 "8: \[GrayCircle] Part 1:  Define a function (name it ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff1", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "cee2096d-e622-4abb-a0f9-83920537c1f7"],
 ") that differentiates a function  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  with respect \n                      to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " assignment (i.e. \"",
 Cell[BoxData[
  FormBox[Cell[TextData[StyleBox["=",
    FontWeight->"Bold"]],ExpressionUUID->
    "7dad8a5b-e456-40af-a4c1-4a202d786c1d"], TraditionalForm]],ExpressionUUID->
  "f892aba0-109b-49a2-9c29-4d1354e86032"],
 "\")\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"x", ",", "f"}], "]"}], ";"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b27538c0-e5ae-4bd0-bb56-3847f17a41e0"],
 "\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"myDiff1", "[", "f_", "]"}], "=", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", "f"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b4e0219d-9509-4c3a-9173-3cc1de008ca5"],
 "\n\n     \[GrayCircle] Part 2:  Evaluate the following lines of code:\n\t\t\
\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff1", "[", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      RowBox[{"3", "x"}], "+", "4"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "f094c940-f44e-413e-8b7a-c29a7565c838"],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff1", "[", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"2", "x"}], "+", "3"}]], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "ceafea8e-590d-4fc1-b64d-2f9375abf7ea"],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff1", "[", 
     RowBox[{"f", "[", "x", "]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "54e65ed2-e93f-4f5a-b7b6-db38ce43496f"],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"?", "myDiff1"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "a4a63063-7243-4aac-8ae7-85a14dd0845b"],
 "\n                     Explain (in a Text Cell) why you did NOT get the \
correct answers for differentiation.\n\t\n     \[GrayCircle] Part 3:  Define \
a function (name it ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "ee83972c-082c-4065-a736-d188b8608661"],
 ") that differentiates a function  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  with respect \n                     to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using ",
 StyleBox["delayed",
  FontVariations->{"Underline"->True}],
 " assignment (i.e. \"",
 StyleBox[":",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["=", TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"fa3e5878-8029-4b87-afc6-4222ad56127c"],
 "\")\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"myDiff2", "[", "f_", "]"}], ":=", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], " ", "f"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "4070a04a-564b-4ca1-a9dc-0ea88a51e58a"],
 "\n\n     \[GrayCircle] Part 4:  Evaluate the following lines of code:\n\t\t\
\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      RowBox[{"3", "x"}], "+", "4"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "850aa1a7-ae5c-4408-bb62-67f7eaeb12da"],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"2", "x"}], "+", "3"}]], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "29e658f1-43b4-4f86-a953-3a0b1f7f0aa4"],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", 
     RowBox[{"f", "[", "x", "]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "7e9167a0-e94b-4829-94ca-b5e0a74d69e6"],
 "\n\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"?", "myDiff2"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "4b388bb0-9de6-4fa5-8b57-c180d1f1ccd3"],
 "\n                     Explain (in a Text Cell) why you DID get the correct \
answers.\n\n     \[GrayCircle] Part 5:  Explain (in a Text Cell) why you ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " (for this case) use ",
 StyleBox["delayed",
  FontVariations->{"Underline"->True}],
 " assignment (i.e.  \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e5c171c7-774e-4d09-b3e3-8eb2e3da5366"],
 "\") \n                     to define your function ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myDiff2", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "fc206b94-4aac-49b8-b475-e70d49e10205"],
 " so that it will work properly."
}], "Text",
 CellChangeTimes->{
  3.390378440027*^9, 3.390379486467*^9, {3.3903796319639997`*^9, 
   3.390379670763*^9}, {3.390379701064*^9, 3.390379785216*^9}, {
   3.390380552295*^9, 3.390380614347*^9}, {3.390726463576*^9, 
   3.3907266942139997`*^9}, {3.3907267401210003`*^9, 3.390726750259*^9}, {
   3.390726795407*^9, 3.390726833645*^9}, {3.39072686962*^9, 
   3.3907269371029997`*^9}, {3.390727009285*^9, 3.390727026301*^9}, {
   3.3907270603120003`*^9, 3.390727080098*^9}, {3.3907271164779997`*^9, 
   3.390727129764*^9}, {3.390727180031*^9, 3.390727226979*^9}, {
   3.390727278085*^9, 3.3907274149309998`*^9}, {3.390727496291*^9, 
   3.390727533027*^9}, {3.3907277922530003`*^9, 3.390727858658*^9}, {
   3.390727920907*^9, 3.390728256959*^9}, {3.390728316027*^9, 
   3.390728347784*^9}, {3.390729380947*^9, 3.390729384506*^9}, {
   3.390729464335*^9, 3.3907294817*^9}, {3.390729694454*^9, 
   3.3907297441219997`*^9}, {3.3907753707279997`*^9, 3.390775377894*^9}, {
   3.39077540848*^9, 3.3907755372939997`*^9}, 3.390791974908*^9, {
   3.39079201401*^9, 3.3907920141289997`*^9}, {3.390792044208*^9, 
   3.390792045718*^9}, {3.43906251159375*^9, 3.439062529546875*^9}, 
   3.439062592015625*^9, 
   3.439062648328125*^9},ExpressionUUID->"99166308-c421-4f3e-92ba-\
eb63142bb2e3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "f"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myDiff1", "[", "f_", "]"}], "=", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], "f"}]}]}], "Input",ExpressionUUID->\
"92224ebc-4675-4bbf-b0b3-d75c1d0a656b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"myDiff1", "[", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"3", " ", "x"}], "+", "4"}], "]"}], ",", 
   RowBox[{"myDiff1", "[", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], "+", "3"}], "]"}], ",", 
   RowBox[{"myDiff1", "[", 
    RowBox[{"f", "[", "x", "]"}], "]"}]}], "}"}]], "Input",ExpressionUUID->\
"f827b027-66af-4e32-98c7-1f7cb7646d3e"],

Cell["?myDiff1", "Input",ExpressionUUID->"96cb4359-d936-4b8e-a01a-a7ddcb4a66fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "f"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myDiff2", "[", "f_", "]"}], ":=", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], "f"}]}]}], "Input",ExpressionUUID->\
"e706d0e6-d575-43b0-a2ae-ffad6e54658e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"myDiff2", "[", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"3", " ", "x"}], "+", "4"}], "]"}], ",", 
   RowBox[{"myDiff2", "[", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], "+", "3"}], "]"}], ",", 
   RowBox[{"myDiff2", "[", 
    RowBox[{"f", "[", "x", "]"}], "]"}]}], "}"}]], "Input",ExpressionUUID->\
"c4cf910c-05a5-4285-9e88-23e70d3e6c7e"],

Cell["?myDiff2", "Input",ExpressionUUID->"c6cde272-87ff-4bc5-a81e-a9417ca03ca1"],

Cell["\<\
Part 2: myDiff1 was defined with =, so the right-hand side was worked out \
once, at definition time, when f was still an empty symbol. The derivative of \
the symbol f with respect to x is 0, so 0 is what got stored, and myDiff1 \
returns 0 for every input. Part 4: myDiff2 was defined with :=, which stores \
the right-hand side unevaluated. The derivative is taken when the function is \
called, on the expression actually passed in, so the answers are correct. \
Part 5: whenever the right-hand side only makes sense once the argument has a \
value, the definition must be delayed. Immediate assignment computes on an \
empty symbol and freezes that answer.\
\>", "Text",ExpressionUUID->"b83dbbd4-3923-4b50-adf0-8680d705888f"]
},
