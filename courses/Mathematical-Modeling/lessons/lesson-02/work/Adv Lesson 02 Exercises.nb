Cell["\<\
All six are the same sum. Written exactly it is one large fraction. Writing \
1.0/n makes every term approximate, so that version carries only about 16 \
digits. Asking for 50 digits works from the exact sum, because Mathematica \
can go back to the fraction and recompute. It fails for the 1.0 version: \
those digits never existed, and N cannot invent them.\
\>", "Text",ExpressionUUID->"eb2e7a61-2d96-467b-a6c6-4320b27583cd"],

Cell[TextData[{
 " 3: \[GrayCircle] Evaluate to 500 significant digits: ",
 Cell[BoxData[
  StyleBox[
   FormBox[
    SuperscriptBox["\[ExponentialE]", 
     StyleBox["\[Pi]",
      FontWeight->"Bold"]],
    TraditionalForm],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"aab16a2d-c671-487a-a172-d00b89d12803"],
 "  (Remember to use ",
 StyleBox["\[ExponentialE]",
  FontWeight->"Bold"],
 " from the palette and not ",
 StyleBox["e",
  FontWeight->"Bold"],
 ")\n     \[GrayCircle] Evaluate exactly: ",
 StyleBox[" ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   FormBox[
    SuperscriptBox["\[ExponentialE]", 
     StyleBox["\[Pi]",
      FontWeight->"Bold"]],
    TraditionalForm],
   FontWeight->"Bold"]],
  FontSize->16,ExpressionUUID->"d7addd00-4c20-40f2-a7bc-223d9679df07"],
 "          Why did it remain the same?"
}], "Text",
 CellChangeTimes->{{3.390375244703*^9, 3.390375258473*^9}, {3.390377116962*^9,
    3.390377138668*^9}, 3.390380520752*^9, 3.3907187545234003`*^9, {
