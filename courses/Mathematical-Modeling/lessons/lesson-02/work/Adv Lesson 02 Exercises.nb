Cell["2: Six ways to sum 1/n from 1 to 100", "Section",ExpressionUUID->"63af7fda-f1a1-45c2-b4b3-124cc68c15b2"],

Cell[BoxData[
 RowBox[{
  UnderoverscriptBox["\[Sum]", 
   RowBox[{"n", "=", "1"}], "100"], 
  FractionBox["1", "n"]}]], "Input",ExpressionUUID->"9a593722-00a6-40e3-9b8f-\
cb23843a8f64"],

