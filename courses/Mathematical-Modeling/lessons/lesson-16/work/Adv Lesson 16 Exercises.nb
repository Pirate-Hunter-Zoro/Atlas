 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"16cc7739-b029-41a9-b3c8-cb3e0bf559d6"],

Cell["\<\
1:  Load all of the functions contained in: ComputerArithmetic`\
\>", "Text",
 CellChangeTimes->{{3.3900490099714003`*^9, 3.3900490122094*^9}, {
  3.3900490930854*^9, 
  3.3900490952743998`*^9}},ExpressionUUID->"734f1738-3b11-4f4c-8fc2-\
3dc74fe72586"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<ComputerArithmetic`\>\"", "]"}]], "Input",Expressi\
onUUID->"27d0439b-14bf-4d40-a490-6d9957904ea8"],

Cell["\<\
2:  Display all of the packages contained in the current context path.\
\>", "Text",ExpressionUUID->"8c1b5824-de65-49ef-af2e-6310aa608a36"],

Cell[BoxData["$ContextPath"], "Input",ExpressionUUID->"84b9c95e-2f6f-4e0f-9529-7e1e38e4b938"],

Cell[BoxData[
 RowBox[{"Length", "[", "$Packages", "]"}]], "Input",ExpressionUUID->"2f9e830f-5024-4140-b07e-9b0a0cd936f6"],

Cell[BoxData[
 RowBox[{"Sort", "[", 
  RowBox[{"Select", "[", 
   RowBox[{"$Packages", ",", 
    RowBox[{
     RowBox[{"StringFreeQ", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"\"\<`\>\"", "~~", "__", "~~", "\"\<`\>\""}]}], "]"}], "&"}]}],
    "]"}], "]"}]], "Input",ExpressionUUID->"d7d28437-daee-49a9-ada8-\
b7871a6f4ce2"],

Cell["\<\
3:  Obtain information on all primary functions in:  ComputerArithmetic`.\
\>", "Text",
