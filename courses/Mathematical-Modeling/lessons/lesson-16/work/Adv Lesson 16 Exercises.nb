Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\"\<ComputerArithmetic`MicroscopicErrorPlot\>\"", ",", 
   RowBox[{"LongForm", "\[Rule]", "False"}]}], "]"}]], "Input",ExpressionUUID->\
"29ada208-c85b-460c-926d-0335449e5f31"],

Cell[BoxData[
 RowBox[{"FindFile", "[", "\"\<ComputerArithmetic`\>\"", "]"}]], "Input",Expre\
ssionUUID->"559b66ed-574b-4f7b-b2be-f0a78552d45a"]
