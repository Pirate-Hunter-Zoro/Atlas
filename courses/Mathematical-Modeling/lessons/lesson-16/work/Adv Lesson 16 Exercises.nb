 RowBox[{"Names", "[", "\"\<ComputerArithmetic`*\>\"", "]"}]], "Input",Express\
ionUUID->"91e7e762-2b16-4773-8232-49d7f497674e"],

Cell["?ComputerArithmetic`*", "Input",ExpressionUUID->"1a480a3d-4323-48dd-8418-cd8798ba7e70"],

Cell["\<\
4:  Obtain what information there is on: MicroscopicErrorPlot[...].\
\>", "Text",
 CellChangeTimes->{{3.3900492140364*^9, 
  3.3900492177164*^9}},ExpressionUUID->"af4b7e04-4c93-4c1f-927c-0ef3d561900f"],

