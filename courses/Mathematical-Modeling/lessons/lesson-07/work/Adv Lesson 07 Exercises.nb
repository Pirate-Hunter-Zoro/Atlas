  "ecdb31cc-dbc0-4945-887d-b346a45b1f26"],
 " \n Part 8: Evaluate the following code and relate what you see to the \
previous parts:\n \tClear[x, y, u, v]\n \t",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "+", " ", 
         RowBox[{
          FormBox[
           SuperscriptBox["y", "2"],
           TraditionalForm], " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}]}], ")"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], "//", "TreeForm"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}], "//", "TableForm"}]],
  
  FontWeight->"Bold",ExpressionUUID->"27cba7c2-72bc-48bf-b919-be78cd2a0be4"],
 "\n \t",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "+", " ", 
         RowBox[{
          FormBox[
           SuperscriptBox["y", "2"],
           TraditionalForm], " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}]}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "//", "TreeForm"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}], "//", "TableForm"}]],
  
  FontWeight->"Bold",ExpressionUUID->"36d1ea4d-2b1f-4acc-9d81-aaf56556293d"],
 "\n Part 9: Evaluate the following code one line at a time and relate what \
you see to the previous parts:",
 StyleBox["\n\t ",
  FontWeight->"Bold"],
 Cell[BoxData[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "+", 
      RowBox[{"u", " ", 
