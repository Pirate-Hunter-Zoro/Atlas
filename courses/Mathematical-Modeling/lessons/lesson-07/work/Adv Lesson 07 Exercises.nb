Cell[TextData[{
 "6: Using Boolean functions, define a function \"f\" such that:\n\tf(x) = +1 \
  when  x  is positive,\n\tf(0) = 0     (do not use a Boolean function here),\
\n\tf(x) = -1   when  x  is negative.\n\tUse ?? to determine the assignments \
made to \"f\" (note the order from top down).\n\tEvaluate:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"-", "2"}], "]"}], ",", " ", 
    RowBox[{"f", "[", "0.023", "]"}], ",", " ", 
    RowBox[{"f", "[", "0", "]"}], ",", " ", 
    RowBox[{"f", "[", "0.0", "]"}], ",", " ", 
    RowBox[{"f", "[", "\[Pi]", "]"}], ",", " ", 
    RowBox[{"f", "[", " ", 
     RowBox[{"3", " ", "+", " ", 
      RowBox[{"4", "*", "I"}]}], " ", "]"}], ",", " ", 
    RowBox[{"f", "[", "a", "]"}]}], TraditionalForm]],ExpressionUUID->
  "b916611c-2115-4e32-8a2e-bf627f16c0e7"],
 "\n\tPlot the function  f(x)  for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", 
    " ", 
    RowBox[{"+", "2"}]}], TraditionalForm]],ExpressionUUID->
  "8c3a047b-f48d-40cd-929b-8d366cfbf4f1"]
}], "Text",
 CellChangeTimes->{{3.390426167578*^9, 
  3.390426179777*^9}},ExpressionUUID->"27c6fef8-8521-41d3-9013-64bf5ebbbc15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"+", "1"}], "/;", 
    RowBox[{"Positive", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "0", "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "1"}], "/;", 
   RowBox[{"Negative", "[", "x", "]"}]}]}]}], "Input",ExpressionUUID->\
"c478d629-beed-4b6c-872d-577b89259a78"],

