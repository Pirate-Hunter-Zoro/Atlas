Cell[TextData[{
 "7: Check the Attributes of the Plot and Integrate commands.\nAttempt to \
evaluate:  \n\tx = 2\n\tPlot[  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "6267c97d-724e-449c-95f0-9268123f97a5"],
 ",    {x, 0, 1} ]\n\tPlot[  \[Integral] Sin[x] \[DifferentialD]x,    {x, 0, \
1} ]\nWhy did the first Plot command work?\nWhat must be done and why must it \
be done so that the second Plot command will work?\nWhy did the assignment x \
= 2 have no effect on the Plot command, but did have an effect on the \
Integrate command?"
}], "Text",ExpressionUUID->"5790c431-4c0b-48f7-92f9-42af636e98af"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Plot", "]"}]], "Input",ExpressionUUID->"7116259d-6ded-4479-92b2-b41020ff6d28"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Integrate", "]"}]], "Input",ExpressionUUID->"231a813b-49e7-48a1-8313-571b1e9d66c6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "Input",ExpressionUUI\
D->"aeae5013-d404-4a4f-bde4-e64c1cc9c895"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",ExpressionUUID\
->"5532b2a6-c82d-41bd-9d98-41ff3ee142cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "Input",ExpressionUUI\
D->"5b31ddb8-f7fc-4193-9e2b-01dd01fdb1d4"],

Cell["\<\
Plot holds its first argument and uses its own local x, so the global x = 2 \
never reaches it. That is why the first Plot works. Integrate does not hold \
its arguments, so inside the second Plot the integral is handed to Integrate \
with x already equal to 2, making it an integral with respect to the number \
2, which fails at every sample point. The fix is to force the integral to be \
worked out first, with Plot[Evaluate[...]], after clearing x. Note that in \
this version Attributes[Plot] reports only Protected and ReadProtected, but \
the holding behaviour is still there.\
\>", "Text",ExpressionUUID->"abf5b136-6430-4852-8f07-e791b6460210"],

Cell["\<\
8: Part 1:  Check the Attributes of the Table and Integrate commands.
Part 2:  Attempt to evaluate:  
\tx = 2
\tn = 3
\tTable[  \[Integral] Sin[ n  x ] \[DifferentialD]x,  {n, 0, 10}]
Part 3:  Make this code work!
Part 4:  Explain at what point in the construction of the table were the \
integrals evaluated, and how this relates to the attributes of the table \
command.
Part 5:  Explain how the integrals were evaluated (when x = 2) and how this \
relates to the attributes of the integrate command.
Part 6:  Why did the assignment x = 2 have no effect on the Table command but \
did have an effect on the Integrate command?
Part 7:  Why did the assignment n = 3 have no effect on the Table command?\
\>", "Text",ExpressionUUID->"4cda3568-a47d-412b-9c22-a3bbbb2e4cdb"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Table", "]"}]], "Input",ExpressionUUID->"5d3c27de-c1a4-4902-997f-f40bd5fe5f71"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Integrate", "]"}]], "Input",ExpressionUUID->"11f0f066-cd66-4e24-903d-493099f42b8d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "n"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"n", " ", "x"}], "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "0", ",", "10"}], "}"}]}], "]"}]}], "Input",ExpressionUU\
ID->"df9279f4-0581-4bc3-9ec9-9c655f98bdb7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"n", " ", "x"}], "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "0", ",", "10"}], "}"}]}], "]"}]}], "Input",ExpressionUU\
ID->"7932f9bf-0d73-4886-b946-2dacabccf66d"],

Cell["\<\
Table has the attribute HoldAll, so it does not evaluate its body in advance: \
it substitutes each n and evaluates then. Integrate holds nothing, so its \
arguments are evaluated before it sees them. With x = 2 the integration \
variable became the number 2 and every integral in the table was left \
unevaluated. Clearing x makes the table work. The assignment n = 3 caused no \
trouble, because Table holds its body and supplies its own n from the \
iterator.\
\>", "Text",ExpressionUUID->"edc2675f-d892-4b6f-a34e-b038575c3c46"],

Cell[TextData[{
