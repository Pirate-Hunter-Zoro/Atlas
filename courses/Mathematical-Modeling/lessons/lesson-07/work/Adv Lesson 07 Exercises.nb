Cell["6: A sign function built from Boolean tests", "Section",ExpressionUUID->"271c1f00-7b6c-4941-9437-0403f2326af1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"+", "1"}], "/;", 
    RowBox[{"Positive", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "0", "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "1"}], "/;", 
   RowBox[{"Negative", "[", "x", "]"}]}]}]}], "Input",ExpressionUUID->\
"c478d629-beed-4b6c-872d-577b89259a78"],

Cell["??f", "Input",ExpressionUUID->"cbd19fde-4544-4b2b-bf67-5833ba0f4fa1"],

