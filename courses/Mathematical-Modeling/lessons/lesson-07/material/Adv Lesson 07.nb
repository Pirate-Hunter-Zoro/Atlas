Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \n",
 "Advanced Lesson 7\n\n",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Internal Structure\n\nDr. Dale R. Doty\nUniversity of Tulsa"
}], "Title"],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Atomic Forms:", "Subtitle"]], "Section"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly"],

Cell[TextData[{
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " stores the following data types as \"atomic\" forms (i.e. all constructs \
in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " are expressed as a combination of one or more of these atomic types).\n\n \
Integer\t 3\n Rational\t 3/4\n Real\t\t 3.4\n Complex\t 3 + 4 I\n String\t\t\
\"String\"\n Symbol\t x"
}], "Text",
 CellChangeTimes->{{3.5231825085729113`*^9, 3.5231825199141116`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", "3", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   FractionBox["3", "4"], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", "3.4", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"3", " ", "+", " ", 
    RowBox[{"4", " ", "I"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", " ", "\"\<This is a String\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.5231824807425117`*^9, 3.5231824825365114`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", "[", "x", "]"}]}]], "Input",
 CellChangeTimes->{{3.5231824866705112`*^9, 3.5231825018025117`*^9}}],

Cell[TextData[{
 " There is no need to declare data types in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  The data type is determined by the form of the input: i.e. if you type 3 \
you will automatically gets an Integer and if you type 3.456 you will \
automatically get a Real number."
}], "Text",
 CellChangeTimes->{{3.389785235696*^9, 3.3897852495769997`*^9}}],

Cell[BoxData["3"], "Input"],

Cell[BoxData[
 RowBox[{"3", "/", "4"}]], "Input"],

Cell[BoxData[
 RowBox[{"3.", "/", "4"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Other Types of Expressions:", "Subtitle"]], "Section"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " can recognize many other types of expressions (constructed from atomic \
expressions).  For example, a vector is a list of objects (maybe a list of \
numbers).\n\nA number is either an integer, rational, real or complex number. \
 It is possible to use a Boolean function to determine which type an \
expression is:"
}], "Text",
 CellChangeTimes->{3.523182391838112*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", "[", 
   RowBox[{"3", " ", "+", " ", 
    RowBox[{"4", " ", 
     RowBox[{"\[ImaginaryI]", "/", "7"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.389785319682*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"NumberQ", "[", 
   RowBox[{"3", " ", "+", " ", 
    RowBox[{"4", " ", 
     RowBox[{"\[ImaginaryI]", "/", "7"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.389785334908*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"NumberQ", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4", ",", "5"}], "}"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4", ",", "5"}], "}"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"ListQ", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", "4", ",", "5"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"VectorQ", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4", ",", "5"}], "}"}], "]"}]}]], "Input"],

Cell["\<\
 The following Boolean functions are available, and all end in the letter \" \
... Q\":\
\>", "Text",
 CellChangeTimes->{{3.3900057000444*^9, 3.3900057229034*^9}}],

Cell["?? *Q", "Program",
 CellChangeTimes->{{3.3900055789764*^9, 3.3900055803814*^9}}],

Cell["\<\
ArgumentCountQ
AtomQ
DigitQ
EllipticNomeQ
EvenQ
ExactNumberQ
FreeQ
HypergeometricPFQ
InexactNumberQ
IntegerQ
IntervalMemberQ
InverseEllipticNomeQ
LegendreQ
LetterQ
LinkConnectedQ
LinkReadyQ
ListQ
LowerCaseQ
MachineNumberQ
MatchLocalNameQ
MatchQ
MatrixQ
MemberQ
NameQ
NumberQ
NumericQ
OddQ
OptionQ
OrderedQ
PartitionsQ
PolynomialQ
PrimeQ
SameQ
StringMatchQ
StringQ
SyntaxQ
TrueQ
UnsameQ
UpperCaseQ
ValueQ
VectorQ\
\>", "Item",
 CellChangeTimes->{{3.3900055789764*^9, 3.3900055803784*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"LowerCaseQ", " ", "[", "\"\<a\>\"", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"LowerCaseQ", " ", "[", "\"\<A\>\"", "]"}]], "Input"],

Cell[" Some Boolean functions do not end in the letter Q.", "Text"],

Cell["\<\
Positive[x] gives True if x is a positive number.
Negative[x] gives True if x is a negative number.
NonPositive[x] gives True if x is a non-positive number.
NonNegative[x] gives True if x is a non-negative number.\
\>", "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900056532454*^9, 3.3900056871004*^9}},
 FontWeight->"Bold"],

Cell["\<\
 Boolean functions are commonly used to determine the data type as input to a \
function (much more on this later):\
\>", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", "f", "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "   ", "EvenQ"}], "]"}], ":=", " ", 
  "\"\< Even Integer\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "  ", "PrimeQ"}], "]"}], ":=", " ", 
  "\"\< Prime Number\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", " ", "ListQ"}], "]"}], ":=", " ", 
  "\"\< A List\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Table", " ", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "17"}], "}"}]}], "]"}], "        ", "//", 
   "TableForm"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"{", "3", "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "3.4", "]"}]], "Input"],

Cell["\<\
 Note that f[1], f[9], f[15] and f[3.4] have no assigned values for the \
function \"f\".  Since no assigned value exists, they remain unevaluated.\
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox[" as a Functional Language:", "Subtitle"]
}], "Section"],

Cell[TextData[{
 "Mathematica is a functional based language (i.e. ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " internal expressions within Mathematica are expressed as compositions of \
functions).  \nThe basic form for ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " expressions within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is  f[x,y,x, ...] where f is a function and x,y,z, ... are arguments.  The \
arguments (and even the functions) can be arbitrary expressions.  The \
arguments for a function ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " be enclosed in square brackets and the arguments ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " be a sequence.  The actual arguments can be any ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " expression of any type.\n"
}], "Text"],

Cell[CellGroupData[{

Cell[" Internal Representation:", "Subsection"],

Cell[TextData[{
 "It is extremely useful to understand how ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " represents its expressions internally.  This can usually be accomplished \
by using the FullForm and TreeForm commands."
}], "Text"],

Cell[BoxData[
 RowBox[{"FullForm", "[", 
  RowBox[{"2", "/", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"FullForm", "[", 
  RowBox[{"x", " ", "+", " ", 
   RowBox[{"y", "*", 
    SuperscriptBox["z", "2"]}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"TreeForm", "[", 
   RowBox[{"x", " ", "+", " ", 
    RowBox[{"y", "*", 
     SuperscriptBox["z", "2"]}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"FullForm", "[", 
  RowBox[{"Sin", "[", "x", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"FullForm", "[", 
  RowBox[{"3", " ", "+", " ", 
   RowBox[{"4", "\[ImaginaryI]"}]}], "]"}]], "Input",
 CellChangeTimes->{3.389785542776*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"FullForm", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Hold", "[", "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Pi]", " ", "x"}], "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "  ", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.5231827866273117`*^9, 3.5231828107761116`*^9}}],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"TreeForm", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Hold", "[", "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Pi]", " ", "x"}], "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "  ", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3897855535030003`*^9, 3.38978557248*^9}}],

Cell["\<\

The following function will be used to display a list of unevaluated \
functions and their corresponding TreeForms:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", "myTree", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"myTree", ",", 
     RowBox[{"{", 
      RowBox[{"Listable", ",", "HoldAll"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myTree", "[", "x_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"HoldForm", "[", "x", "]"}], ",", 
    RowBox[{"HoldForm", "[", 
     RowBox[{"FullForm", "[", "x", "]"}], "]"}], ",", 
    RowBox[{"HoldForm", "[", 
     RowBox[{"TreeForm", "[", "x", "]"}], "]"}]}], "}"}]}]}], "InputOnly",
 CellChangeTimes->{{3.38978582384*^9, 3.389785836782*^9}, {
  3.3897858693380003`*^9, 3.389785872199*^9}}],

Cell[TextData[{
 "Analyze how ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " internally represents each of the following expressions:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myTree", "[", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"1", "+", "2", "+", "3"}], ",", "\[IndentingNewLine]", 
     RowBox[{"5", "*", "6", "*", "7"}], ",", "\[IndentingNewLine]", 
     RowBox[{"-", "7"}], ",", "\[IndentingNewLine]", 
     RowBox[{"-", "a"}], ",", "\[IndentingNewLine]", 
     SuperscriptBox["a", "4"], ",", "\[IndentingNewLine]", 
     FractionBox["a", "b"], ",", "\[IndentingNewLine]", 
     RowBox[{"a", "*", 
      RowBox[{"(", 
       RowBox[{"b", "+", "c"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Sin", "[", "x", "]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "x", "]"}], "2"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "a", "b"], 
      RowBox[{
       RowBox[{"Sin", "[", "x", "]"}], 
       RowBox[{"\[DifferentialD]", "x"}]}]}], ",", "\[IndentingNewLine]", 
     FractionBox["1", 
      RadicalBox["x", "3"]]}], "\[IndentingNewLine]", "}"}], 
   "\[IndentingNewLine]", "]"}], "                              ", "//", 
  "TableForm"}]], "Input",
 CellChangeTimes->{{3.389785621201*^9, 3.389785671691*^9}, {
  3.3897857321730003`*^9, 3.389785733376*^9}}],

Cell[TextData[{
 "Observe that every expression has a functional representation.  Sometimes \
this representation may be a little surprising.  Of special interest might be \
the expressions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "a"}], ",", 
    RowBox[{
     FractionBox["a", "b"], " ", "and", " ", 
     FractionBox["1", 
      RadicalBox["x", "3"]]}]}], TraditionalForm]]],
 "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Not Evaluating or Forcing Evaluation:", "Subsection"],

Cell[TextData[{
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " normally attempts to perform as much evaluation as is possible (or allowed \
by the absence of  Hold) as soon as possible.  Therefore, there may be \
special circumstances for which a delayed evaluation is desired, or \
circumstances for which an evaluation must be forced."
}], "Text"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"\[Pi]", " ", "x"}], "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell["\<\
Note that the attributes of FullForm does not hold its argument.  \
\>", "Text",
 CellChangeTimes->{3.389786022506*^9, {3.389786064266*^9, 3.389786068526*^9}}],

Cell[BoxData[
 RowBox[{"Attributes", "[", "FullForm", "]"}]], "Input",
 CellChangeTimes->{{3.389786072611*^9, 3.389786074859*^9}}],

Cell[TextData[{
 "Therefore, if we attempt to display the InputForm of \[Integral]Sin[\[Pi] \
x]\[DifferentialD]x, it will evaluate the expression to get ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Cos", "[", 
       RowBox[{"\[Pi]", " ", "x"}], "]"}], "\[Pi]"]}], " "}],
   FontWeight->"Bold"]]],
 "before FullForm can be applied:"
}], "Text",
 CellChangeTimes->{
  3.389786037226*^9, {3.389786083201*^9, 3.389786099259*^9}, {
   3.389786180585*^9, 3.389786192415*^9}, {3.5231828965449114`*^9, 
   3.5231828982141113`*^9}}],

Cell[BoxData[
 RowBox[{"FullForm", "[", "  ", 
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}], "  ", "]"}]], "Input",
 CellChangeTimes->{{3.389786104442*^9, 3.389786106508*^9}, {3.389786162159*^9,
    3.389786169832*^9}, 3.523182912581712*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"FullForm", "[", "  ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"\[Pi]", " ", "x"}], "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "  ", "]"}], "==", "  ", 
  RowBox[{"FullForm", "[", "  ", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"Cos", "[", 
      RowBox[{"\[Pi]", " ", "x"}], "]"}], "\[Pi]"]}], "  ", "]"}]}]], "Input",
 CellChangeTimes->{{3.389786119727*^9, 3.389786131144*^9}, {3.389786197667*^9,
   3.389786208283*^9}, {3.5231829241725116`*^9, 3.5231829271989117`*^9}}],

Cell[TextData[{
 "The way around this difficulty is to ",
 StyleBox["hold",
  FontVariations->{"Underline"->True}],
 " the argument for FullForm:"
}], "Text",
 CellChangeTimes->{{3.3897861500039997`*^9, 3.389786152611*^9}}],

Cell[BoxData[
 RowBox[{"FullForm", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Hold", "[", "  ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"\[Pi]", " ", "x"}], "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "  ", "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.38978621546*^9, 3.389786252165*^9}, 
   3.5231829369333115`*^9}],

Cell[TextData[{
 " Many of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal functions have \"all\" of their arguments automatically held \
(to prevent evaluation until evaluation is forced).  "
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", "  ", "Plot", " ", "]"}]], "Input",
 CellChangeTimes->{{3.389786268875*^9, 3.389786270778*^9}}],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", "  ", "Table", " ", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", " ", "Do", " ", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", " ", "Which", " ", "]"}]], "Input"],

Cell[TextData[{
 " Many of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal functions have only  \"some\" of their arguments automatically \
held."
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", " ", "If", " ", "]"}]], "Input"],

Cell["\<\
 Many of Mathematica's internal functions have \"none\" of their arguments \
automatically held, and these functions will therefore attempt to replace \
their arguments with their assigned values immediately (making subsequent \
reassignment of their argument values impossible).  \
\>", "Text"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", "Cos", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", " ", "Limit", "]"}]], "Input"],

Cell[" As an example, consider the attributes of: Integrate.  ", "Text"],

Cell["\<\
Integrate[f, x] gives the indefinite integral of f with respect to x. \
\>", "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900058526373997`*^9, 3.3900058577764*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", " ", "Integrate", "]"}]], "Input"],

Cell[TextData[{
 "Observe that none of the arguments of integrate are held from evaluation.   \
Integrate has two basic arguments, \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}], TraditionalForm]]],
 "\n\t\nthe function to be integrated and the variable of integration.  Since \
neither of these arguments are held from evaluation, they will be EVALUATED \
AND REPLACED BEFORE the integral is evaluated.  Consider the following \
assignment to the function variable and integration variable \"z\":"
}], "Text",
 CellChangeTimes->{{3.38978634535*^9, 3.389786368775*^9}}],

Cell[BoxData[
 RowBox[{"z", "=", "5"}]], "Input"],

Cell[" Evaluate the integral:", "Text"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["z", "2"], 
   RowBox[{"\[DifferentialD]", "z"}]}]}]], "Program"],

Cell["\<\
Integrate::\"ilim\" : \"Invalid integration variable or limit(s) in 5 .\"\
\>", "Program",
 CellChangeTimes->{3.3900059227604*^9}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{"25", 
   RowBox[{"\[DifferentialD]", "5"}]}]}]], "Program"],

Cell[TextData[{
 " Observe that the symbol \"z\" was replaced immediately with the assigned \
value \"5\" yielding the expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{"25", 
     RowBox[{"\[DifferentialD]", "5"}]}]}], TraditionalForm]]],
 ", which is ",
 StyleBox["im",
  FontVariations->{"Underline"->True}],
 "proper.  However, if we clear the assignment to the symbol \"z\", then no \
assignment for \"z\" can be made within ",
 Cell[BoxData[
  RowBox[{"\[Integral]", 
   RowBox[{
    SuperscriptBox["z", "2"], 
    RowBox[{"\[DifferentialD]", "z"}]}]}]],
  FontWeight->"Bold"],
 ", allowing the integration to proceed as desired."
}], "Text",
 CellChangeTimes->{3.389786473439*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", "z", "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["z", "2"], 
   RowBox[{"\[DifferentialD]", "z"}]}]}]], "Input"],

Cell[" As a second example, consider the attributes of:  Plot.  ", "Text"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", " ", "Plot", "]"}]], "Input"],

Cell["\<\
 Observe that Plot has all of its arguments held from evaluation.  Therefore, \
even if assignments have been made to the arguments used in Plot, they will \
not affect the result.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"z", "=", "2"}]], "Input"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   SuperscriptBox["z", "2"], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", "0", ",", "3"}], "}"}]}], "]"}]], "Input"],

Cell["\<\
 It is possible to force evaluation (even though the arguments of a function \
may be held from evaluation) by using the Evaluate[...] command.
Consider the Plot[...] command which has all of its arguments held:\
\>", "Text",
 CellChangeTimes->{{3.38978654566*^9, 3.389786555027*^9}}],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"Attributes", " ", "[", "  ", "Plot", " ", "]"}]}]], "Input"],

Cell[TextData[{
 "Attempt to plot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], " ", 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]]],
 " without evaluating the integral first:"
}], "Text",
 CellChangeTimes->{3.389786573053*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], " ", 
     RowBox[{"\[DifferentialD]", "x"}]}]}], ",", " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389786616709*^9, 3.389786623651*^9}}],

Cell[TextData[{
 "Observe the resulting error messages because the function Sin[x] was ",
 StyleBox["never",
  FontVariations->{"Underline"->True}],
 " generated.\n\nThe desired plot can be generated by forcing the evaluation \
of the integral:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"Cos", "[", "x", "]"}], " ", 
      RowBox[{"\[DifferentialD]", "x"}]}]}], " ", "]"}], ",", " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389786592389*^9, 3.389786601861*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[" The Head of an Expression:", "Subsection"],

Cell[BoxData[
 RowBox[{
  RowBox[{"head", "[", 
   RowBox[{"b", "[", 
    RowBox[{"l", ",", 
     RowBox[{"b", "[", 
      RowBox[{"b", "[", 
       RowBox[{
        RowBox[{"l", "[", "x", "]"}], ",", 
        RowBox[{"r", "[", "x", "]"}]}], "]"}], "]"}], ",", "r"}], "]"}], 
   "]"}], "//", "TreeForm"}]], "Input",
 CellChangeTimes->{{3.3900061578644*^9, 3.3900061643264*^9}, {
  3.3900062337864*^9, 3.3900064142984*^9}}],

Cell[TextData[{
 " You have seen that all expressions in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " are stored as functions (atomic as well as composition of functions).  The \
name of the outer most function is stored as the head of the expression."
}], "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"2", "/", "3"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"Sin", "[", "x", "]"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"Sin", "[", 
    RowBox[{"Cos", "[", "x", "]"}], "]"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"a", "+", "b"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"a", "*", "b"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   SuperscriptBox["a", "b"], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "a", "}"}], ",", 
     RowBox[{"{", "b", "}"}], ",", 
     RowBox[{"{", "c", "}"}]}], "}"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"FullForm", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "a", "}"}], ",", 
    RowBox[{"{", "b", "}"}], ",", 
    RowBox[{"{", "c", "}"}]}], "}"}], "]"}]], "Input"],

Cell["\<\
 Many times it is desirable to replace the head of an expression with another \
head.\
\>", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"FullForm", "[", 
  RowBox[{"{", 
   RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"a", "+", "b", "+", "c"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"FullForm", "[", 
  RowBox[{"a", "+", "b", "+", "c"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "b", ",", "c"}], "}"}], " ", "/.", " ", 
  RowBox[{"List", " ", "\[Rule]", "  ", "Plus"}]}]], "Input"],

Cell["\<\
  However, the usual procedure is to use the Apply[...] function rather than \
the replacement rules.\
\>", "Text",
 CellChangeTimes->{{3.3900059485034*^9, 3.3900059548094*^9}}],

Cell[TextData[StyleBox["Apply[f, expr] or f @@ expr replaces the head of expr \
by f.\nApply[f, expr, levelspec] replaces heads in parts of expr specified by \
levelspec.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900058371154003`*^9, 3.3900058448943996`*^9}}],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"Apply", " ", "[", 
   RowBox[{"Plus", ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "]"}]}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Referencing Parts of Expressions:", "Subsection"],

Cell["\<\
 It is possible to reference any part at any level of an expression by using \
the same notation used to reference a part of a list.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "y", ",", "z"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"FullForm", "[", 
  RowBox[{"x", " ", "+", "  ", 
   RowBox[{"Cos", "[", 
    RowBox[{"Log", "[", 
     RowBox[{"y", "*", 
      SuperscriptBox["z", "2"]}], "]"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"TreeForm", "[", 
  RowBox[{"x", " ", "+", "  ", 
   RowBox[{"Cos", "[", 
    RowBox[{"Log", "[", 
     RowBox[{"y", "*", 
      SuperscriptBox["z", "2"]}], "]"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "=", 
  RowBox[{"x", " ", "+", "  ", 
   RowBox[{"Cos", "[", 
    RowBox[{"Log", "[", 
     RowBox[{"y", "*", 
      SuperscriptBox["z", "2"]}], "]"}], "]"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", "0", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", "2", "]"}], "]"}]], "Input"],

Cell[" Note the following:", "Text"],

Cell["temp[[3]]", "Program"],

Cell[TextData[{
 "Part::\"partw\" : \"Part 3 of ",
 Cell[BoxData[
  RowBox[{"x", "+", 
   RowBox[{"Cos", "[", 
    RowBox[{"Log", "[", 
     RowBox[{"y", " ", 
      SuperscriptBox["z", "2"]}], "]"}], "]"}]}]],
  CellChangeTimes->{3.3900060132363997`*^9}],
 " does not exist.\""
}], "Program",
 CellChangeTimes->{3.3900060039844*^9, 3.3900060408324003`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"x", "+", 
    RowBox[{"Cos", "[", 
     RowBox[{"Log", "[", 
      RowBox[{"y", " ", 
       SuperscriptBox["z", "2"]}], "]"}], "]"}]}], ")"}], 
  "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]], "Program"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", 
   RowBox[{"2", ",", "1"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", 
   RowBox[{"2", ",", "1", ",", "1"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", 
   RowBox[{"2", ",", "1", ",", "1", ",", "1"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", 
   RowBox[{"2", ",", "1", ",", "1", ",", "2"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", 
   RowBox[{"2", ",", "1", ",", "1", ",", "2", ",", "1"}], "]"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"temp", "[", 
  RowBox[{"[", 
   RowBox[{"2", ",", "1", ",", "1", ",", "2", ",", "2"}], "]"}], 
  "]"}]], "Input"],

Cell["\<\
  It is also possible to determine the relative positions where a symbol is \
found in an expression using the Position command.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"TreeForm", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], "+", 
   RowBox[{"2", " ", "x", " ", "y"}], "+", 
   SuperscriptBox["y", "2"]}], "]"}]], "Input"],

Cell[" Find the relative positions containing the symbol \"x\":", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Position", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"2", " ", "x", " ", "y"}], "+", 
     SuperscriptBox["y", "2"]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3897867946540003`*^9, 3.389786801234*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"2", " ", "x", " ", "y"}], "+", 
    SuperscriptBox["y", "2"]}], " ", ")"}], "[", 
  RowBox[{"[", 
   RowBox[{"1", ",", "1"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"2", " ", "x", " ", "y"}], "+", 
    SuperscriptBox["y", "2"]}], " ", ")"}], "[", 
  RowBox[{"[", 
   RowBox[{"2", ",", "2"}], "]"}], "]"}]], "Input"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Exercises:", "Title"],
 "  Advanced Lesson 7 "
}], "Section",
 CellChangeTimes->{{3.3900066666334*^9, 3.3900066689174*^9}}],

Cell["\<\
Your Name:

Your Math Class:\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold"],

Cell[TextData[{
 "1: Determine the Head and FullForm of the expressions:  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", "x"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "\[ExponentialE]"], TraditionalForm]]]
}], "Text"],

Cell[TextData[{
 "2: Determine the Head FullForm and TreeForm of the expression:    x + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]]],
 " {u, v, w}   then evaluate the expression."
}], "Text",
 CellChangeTimes->{{3.390425951645*^9, 3.390425960841*^9}}],

Cell[TextData[{
 "3: Use the Head command to determine if \[Pi] is stored internally as an \
integer, a rational number, an approximate real number, etc.  Using a Boolean \
function, determine if ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal representation of \[Pi] is designated as a numeric type.  Using \
a Boolean function, determine if \[Pi] is positive."
}], "Text",
 CellChangeTimes->{{3.390426066775*^9, 3.390426085284*^9}}],

Cell["\<\
4: Using Boolean functions, determine if  \"This is a string\" is a list or \
is a string. \
\>", "Text"],

Cell["\<\
5: Using Boolean functions, determine if  3 is  a member of {1, 2, 3, 4, 5}.\
\>", "Text"],

Cell[TextData[{
 "6: Using Boolean functions, define a function \"f\" such that:\n\tf(x) = +1 \
  when  x  is positive,\n\tf(0) = 0     (do not use a Boolean function here),\
\n\tf(x) = -1   when  x  is negative.\n\tUse ?? to determine the assignments \
made to \"f\" (note the order from top down).\n\tEvaluate:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"-", "2"}], "]"}], ",", " ", 
    RowBox[{"f", "[", "0.023", "]"}], ",", " ", 
    RowBox[{"f", "[", "0", "]"}], ",", " ", 
    RowBox[{"f", "[", "0.0", "]"}], ",", " ", 
    RowBox[{"f", "[", "\[Pi]", "]"}], ",", " ", 
    RowBox[{"f", "[", " ", 
     RowBox[{"3", " ", "+", " ", 
      RowBox[{"4", "*", "I"}]}], " ", "]"}], ",", " ", 
    RowBox[{"f", "[", "a", "]"}]}], TraditionalForm]]],
 "\n\tPlot the function  f(x)  for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", 
    " ", 
    RowBox[{"+", "2"}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.390426167578*^9, 3.390426179777*^9}}],

Cell[TextData[{
 "7: Check the Attributes of the Plot and Integrate commands.\nAttempt to \
evaluate:  \n\tx = 2\n\tPlot[  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]]],
 ",    {x, 0, 1} ]\n\tPlot[  \[Integral] Sin[x] \[DifferentialD]x,    {x, 0, \
1} ]\nWhy did the first Plot command work?\nWhat must be done and why must it \
be done so that the second Plot command will work?\nWhy did the assignment x \
= 2 have no effect on the Plot command, but did have an effect on the \
Integrate command?"
}], "Text"],

Cell["\<\
8: Part 1:  Check the Attributes of the Table and Integrate commands.
Part 2:  Attempt to evaluate:  
\tx = 2
\tn = 3
\tTable[  \[Integral] Sin[ n  x ] \[DifferentialD]x,  {n, 0, 10}]
Part 3:  Make this code work!
Part 4:  Explain at what point in the construction of the table were the \
integrals evaluated, and how this relates to the attributes of the table \
command.
Part 5:  Explain how the integrals were evaluated (when x = 2) and how this \
relates to the attributes of the integrate command.
Part 6:  Why did the assignment x = 2 have no effect on the Table command but \
did have an effect on the Integrate command?
Part 7:  Why did the assignment n = 3 have no effect on the Table command?\
\>", "Text"],

Cell[TextData[{
 "9:  Part 1:  Evaluate:   ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", " ", "+", " ", 
    RowBox[{
     FormBox[
      SuperscriptBox["y", "2"],
      TraditionalForm], " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v"}], "}"}]}]}],
   FontWeight->"Bold"]]],
 " and observe the final form.   \n                 Observe that it is \
different than the initial form.\n Part 2:  Evaluate: ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{"TreeForm", "[", 
    RowBox[{"x", " ", "+", " ", 
     RowBox[{
      FormBox[
       SuperscriptBox["y", "2"],
       TraditionalForm], " ", 
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "v"}], "}"}]}]}], " ", "]"}]}]],
  FontWeight->"Bold"],
 " and reconcile this expression with the first part.\n Part 3: Locate the \
relative position of  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "+", 
    RowBox[{"u", " ", 
     SuperscriptBox["y", "2"]}]}],
   FontWeight->"Bold"]]],
 "  in  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", " ", "+", " ", 
    RowBox[{
     FormBox[
      SuperscriptBox["y", "2"],
      TraditionalForm], " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v"}], "}"}]}]}],
   FontWeight->"Bold"]]],
 " \n Part 4: Locate the relative position of  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"u", " ", 
    SuperscriptBox["y", "2"]}],
   FontWeight->"Bold"]]],
 "  in  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", " ", "+", " ", 
    RowBox[{
     FormBox[
      SuperscriptBox["y", "2"],
      TraditionalForm], " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v"}], "}"}]}]}],
   FontWeight->"Bold"]]],
 "  \n Part 5: Locate the relative position of  ",
 Cell[BoxData[
  StyleBox[
   SuperscriptBox["y", "2"],
   FontWeight->"Bold"]]],
 "  in  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", " ", "+", " ", 
    RowBox[{
     FormBox[
      SuperscriptBox["y", "2"],
      TraditionalForm], " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v"}], "}"}]}]}],
   FontWeight->"Bold"]]],
 " \n Part 6: Locate the relative position of  ",
 Cell[BoxData[
  StyleBox["u",
   FontWeight->"Bold"]]],
 "  in  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", " ", "+", " ", 
    RowBox[{
     FormBox[
      SuperscriptBox["y", "2"],
      TraditionalForm], " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v"}], "}"}]}]}],
   FontWeight->"Bold"]]],
 " \n Part 7: Locate the relative position of  ",
 Cell[BoxData[
  StyleBox["y",
   FontWeight->"Bold"]]],
 "  in  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", " ", "+", " ", 
    RowBox[{
     FormBox[
      SuperscriptBox["y", "2"],
      TraditionalForm], " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "v"}], "}"}]}]}],
   FontWeight->"Bold"]]],
 " \n Part 8: Evaluate the following code and relate what you see to the \
previous parts:\n \tClear[x, y, u, v]\n \t",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "+", " ", 
         RowBox[{
          FormBox[
           SuperscriptBox["y", "2"],
           TraditionalForm], " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}]}], ")"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], "//", "TreeForm"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}], "//", "TableForm"}]],
  FontWeight->"Bold"],
 "\n \t",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "+", " ", 
         RowBox[{
          FormBox[
           SuperscriptBox["y", "2"],
           TraditionalForm], " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}]}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "//", "TreeForm"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}], "//", "TableForm"}]],
  FontWeight->"Bold"],
 "\n Part 9: Evaluate the following code one line at a time and relate what \
you see to the previous parts:",
 StyleBox["\n\t ",
  FontWeight->"Bold"],
 Cell[BoxData[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "+", 
      RowBox[{"u", " ", 
       SuperscriptBox["y", "2"]}]}], ",", 
     RowBox[{"x", "+", 
      RowBox[{"v", " ", 
       SuperscriptBox["y", "2"]}]}]}], "}"}], " ", "//", 
   "TreeForm"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "+", 
      RowBox[{"u", " ", 
       SuperscriptBox["y", "2"]}]}], ",", 
     RowBox[{"x", "+", 
      RowBox[{"v", " ", 
       SuperscriptBox["y", "2"]}]}]}], "}"}], " ", "[", 
   RowBox[{"[", "0", "]"}], "]"}], "\n", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "+", 
      RowBox[{"u", " ", 
       SuperscriptBox["y", "2"]}]}], ",", 
     RowBox[{"x", "+", 
      RowBox[{"v", " ", 
       SuperscriptBox["y", "2"]}]}]}], "}"}], " ", "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "0"}], "]"}], "]"}], "\n", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "+", 
      RowBox[{"u", " ", 
       SuperscriptBox["y", "2"]}]}], ",", 
     RowBox[{"x", "+", 
      RowBox[{"v", " ", 
       SuperscriptBox["y", "2"]}]}]}], "}"}], " ", "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "2", ",", "0"}], "]"}], "]"}], "\n", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "+", 
