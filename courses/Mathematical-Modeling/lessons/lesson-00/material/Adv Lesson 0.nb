Cell[TextData[{
 StyleBox["4: Within the new window, click on the button to Make a ", 
  "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Matrix",
     FontSize->14]], TraditionalForm]]],
 StyleBox[".\n5: Enter the number of rows and columns (i.e. ", "Subsubtitle"],
 StyleBox["3", "Subsubtitle",
  FontColor->GrayLevel[0]],
 StyleBox[" rows and ", "Subsubtitle"],
 StyleBox["3", "Subsubtitle",
  FontColor->GrayLevel[0]],
 StyleBox[" columns).\n6: Make sure other choices have not been selected and \
click ", "Subsubtitle"],
 StyleBox["OK", "Subsubtitle",
  FontSlant->"Plain",
  FontColor->GrayLevel[0]],
 StyleBox[".\n7: Enter information into each box ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   StyleBox["\[Square]",
    FontSize->18,
    FontWeight->"Bold"], TraditionalForm]],
  FontSize->16],
 StyleBox[" of the matrix:  ", "Subsubtitle"],
 Cell[BoxData[
  StyleBox[
   RowBox[{"(", GridBox[{
      {"1", "2", "3"},
      {"4", "\[Placeholder]", "\[Placeholder]"},
      {"\[Placeholder]", "\[Placeholder]", "\[Placeholder]"}
     }], ")"}],
   FontWeight->"Bold"]]],
 StyleBox["\n8: Evaluate the input cell (The Output Cell will contain a list \
of lists.).\n\n", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.390214854001*^9, 3.390214857958*^9}, {3.390214888174*^9,
    3.3902149498719997`*^9}, {3.390215144949*^9, 3.390215200039*^9}, {
