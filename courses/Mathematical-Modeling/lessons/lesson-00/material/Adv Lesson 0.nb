Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["  \n",
  FontSize->18],
 "Notebook cells:"
}], "Subtitle",
 CellChangeTimes->{3.439031241796875*^9}],

Cell[TextData[{
 StyleBox["Information within a ", "Subsubtitle"],
 StyleBox["Mathematica", "Subsubtitle",
  FontSlant->"Italic"],
 StyleBox[" notebook is contained within cells.  Different types of cells \
have different properties.  The default cell type is \"Input\".  When an \
input cell is evaluated it produces an \"Output\" cell.", "Subsubtitle"],
 " ",
 StyleBox[" \n\nEvaluate the following Input cell and observe the \
corresponding Output cell", "Subsubtitle"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.390217461594*^9, {3.3905132508534*^9, 3.3905132571703997`*^9}, {
   3.439032010546875*^9, 3.43903204215625*^9}},
 FontSize->14],

Cell[BoxData[
 RowBox[{"2", "+", 
  RowBox[{"3", "*", "6"}]}]], "Input"],

Cell[TextData[{
 StyleBox["\n", "Subsubtitle"],
 StyleBox["Cell Basics:", "Subsubtitle",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["    ", "Subsubtitle"],
 StyleBox["To create a new Input cell:", "Subtitle",
  FontSize->18],
 StyleBox["\n1: Move the mouse cursor into the space between two cells (or \
below the last cell within your notebook) and the cursor becomes horizontal. \
\n2: Click and a black horizontal cell insertion line will appear.\n3: Start \
typing (by default, an Input cell will be created).\n\nCreate a new Input \
cell between this line:\t", "Subsubtitle"],
 StyleBox["--- ", "Subsubtitle",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["\[DoubleDownArrow] -- \[DoubleDownArrow] -- \[DoubleDownArrow] -- \
\[DoubleDownArrow] -- \[DoubleDownArrow] ---", "Subsubtitle",
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.3902163165480003`*^9, 3.3902163174700003`*^9}, {
  3.3902590658672*^9, 3.3902590677072*^9}, {3.439031903109375*^9, 
  3.439031910390625*^9}, {3.4390320750625*^9, 3.439032094484375*^9}, {
  3.439032164859375*^9, 3.439032167765625*^9}}],

Cell[TextData[{
 StyleBox["and this line:\t\t\t\t\t", "Subsubtitle"],
 StyleBox["--- ", "Subsubtitle",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["\[DoubleUpArrow] -- \[DoubleUpArrow] -- \[DoubleUpArrow] -- \
\[DoubleUpArrow] -- \[DoubleUpArrow] ---", "Subsubtitle",
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["\n\nType    ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"2", "+", 
     RowBox[{"3", "*", "6"}]}],
    FontSize->16], TraditionalForm]]],
 StyleBox["    into the above cell and evaluate the newly created input cell. \
", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.390216123443*^9, 3.390216131899*^9}, {
  3.3902590875062*^9, 3.3902590992822*^9}}],

Cell[TextData[{
 " \n",
 StyleBox["Cell Basics:", "Subsubtitle",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["    ", "Subsubtitle"],
 StyleBox["To create a Text cell:", "Subtitle",
  FontSize->18],
 StyleBox["\n1: Move the mouse cursor between two cells until it becomes \
horizontal\n2: Click and a black horizontal cell insertion line will appear\n\
3: Click on the menu item: ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Format",
     FontSize->14]], TraditionalForm]]],
 StyleBox["\n4: Select: ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Style",
     FontSize->14]], TraditionalForm]]],
 StyleBox["\n5: Select: ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Text",
     FontSize->14]], TraditionalForm]]],
 " ",
 StyleBox["(a Text cell appears)", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.390216301608*^9, 3.39021630288*^9}, {3.390216346782*^9, 
   3.3902163821689997`*^9}, {3.390216442381*^9, 3.390216443698*^9}, {
