Cell[CellGroupData[{

Cell[" Group of Cells", "Section",
 CellChangeTimes->{3.439131889484375*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubscriptBox["a", "1"], "=", "2"}]], "Input"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.439037623046875*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubscriptBox["b", "1"], "=", "3", "\t\t"}]], "Input"],

Cell[BoxData["3"], "Output",
 CellChangeTimes->{3.439037671671875*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 FractionBox[
  SubscriptBox["a", "1"], 
  SubscriptBox["b", "1"]]], "Input"],

