Cell[TextData[{
 StyleBox["By clicking a button within the palette, you can enter \
mathematical notation within your notebook cells.\n\n", "Subsubtitle"],
 "\n",
 StyleBox["Enter Notation:", "Subsubtitle",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["  ", "Subsubtitle"],
 StyleBox[" ", "Subtitle"],
 StyleBox["2 ", "Subtitle",
  FontSize->18],
 StyleBox["\[Pi] ", "Subtitle"],
 "\n",
 StyleBox["1: Click your mouse cursor at the exact location that you want the \
mathematical symbol located.  For example, click just to the right of the ", 
  "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"2", "*"}],
    FontSize->16], TraditionalForm]]],
 StyleBox[" in the input cell below. (It will look like ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"2", "*"}], 
     AdjustmentBox["|",
      BoxMargins->{{-0.1764705882352941, 0.1764705882352941}, {0., 0.}}]}],
    FontSize->16], TraditionalForm]]],
 StyleBox["with a blinking cursor \"", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   StyleBox["|",
    FontSize->14], TraditionalForm]]],
 StyleBox["\".) ", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{
  3.3902138182860003`*^9, {3.390213851707*^9, 3.39021385954*^9}, 
   3.390213900383*^9, {3.3902579607092*^9, 3.3902579723171997`*^9}, {
