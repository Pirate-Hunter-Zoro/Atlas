Cell[TextData[{
 StyleBox["\n", "Subsubtitle"],
 StyleBox["Note:", "Subtitle"],
 StyleBox[" There are a number of different palettes available for entering \
information into ", "Subsubtitle"],
 StyleBox["Mathematica", "Subsubtitle",
  FontSlant->"Italic"],
 StyleBox[".  They can be located as follows:\n\n\t1: Click on menu item \
\"Palettes\"\n\t2: Select desired palette.\n \nOf special interest is the ", 
  "Subsubtitle"],
 StyleBox["Basic Math Assistant", "Subtitle",
  FontSize->18],
 StyleBox[" palette.  Examine it closely because it has just about everything \
you might ever want.  ", "Subsubtitle"]
}], "Text",
