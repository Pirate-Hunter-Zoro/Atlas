Cell[TextData[{
 " \n\nWhen you want to evaluate an input cell, it must be selected before \
the evaluation.  The desired cell is selected by clicking your mouse cursor \
at ",
 StyleBox["any",
  FontVariations->{"Underline"->True}],
 " point within the cell. The cell is evaluated by pressing the",
 StyleBox[" ", "Subsubtitle"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Shift\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], "-", 
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Enter\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"]}]],
  CellChangeTimes->{{3.3902570408182*^9, 3.3902570426292*^9}},
  FontSize->14],
 " keys.  Input cells can be evaluated in any order using this procedure.  \
However, the values assigned to variables will correspond to the most recent \
evaluations.\n"
}], "Text",
 CellChangeTimes->{{3.3902573071591997`*^9, 3.3902573606242*^9}, 
   3.3902573942581997`*^9, {3.3905129060234003`*^9, 3.3905129235014*^9}, {
