Cell[TextData[{
 StyleBox["\nChange the following   ", "Subsubtitle"],
 StyleBox["Input cell", "Subsubtitle",
  FontSlant->"Plain",
  FontColor->GrayLevel[0]],
 StyleBox["   into a   ", "Subsubtitle"],
 StyleBox["Text cell", "Subsubtitle",
  FontSlant->"Plain",
  FontColor->GrayLevel[0]],
 StyleBox[":", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.390216687881*^9, 3.390216705642*^9}, {
   3.3902593637202*^9, 3.3902595093712*^9}, {3.3902595572342*^9, 
   3.3902597431902*^9}, 3.3903039740462*^9, {3.3905138405973997`*^9, 
   3.3905138489284*^9}, 3.439031930765625*^9, {3.439033123953125*^9, 
   3.439033174625*^9}, {3.439033211375*^9, 3.43903324653125*^9}, 
   3.439033703734375*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
  "You", " ", "are", " ", "converting", " ", "this", " ", "Input", " ", 
   "cell", " ", "into", " ", "a", " ", "Text", " ", "cell"}]}]], "Input",
 CellChangeTimes->{{3.3905137925144*^9, 3.3905138089744*^9}}],

Cell[TextData[{
 StyleBox["\nAfter converting the Input cell into a Text cell, attempt to \
evaluate the above Text cell and observe that the Text cell can not be \
evaluated.  Therefore, Text cells are convenient for documenting your Input \
cell code (Input cells are intended to be evaluated and Text cells are not).  \
Also, observe that almost every cell type other than Input can ", 
  "Subsubtitle"],
 StyleBox["not", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" be evaluated, these include the cell types:  Title, Subtitle, ... \
Section, Subsection ... Text ... Output ... etc.  For example, this cell that \
you are reading is a Text cell that has been reformatted to have this \
appearance.", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{
  3.390216773709*^9, {3.3905138858574*^9, 3.3905139050364*^9}, {
   3.3905139388814*^9, 3.3905139943494*^9}, {3.3905140618354*^9, 
   3.3905141340204*^9}, {3.3905142102483997`*^9, 3.3905142440313997`*^9}, {
   3.439034391734375*^9, 3.439034426*^9}},
 FontSize->14,
 FontSlant->"Italic"],

Cell[TextData[{
 " \n",
 StyleBox["Cell Basics:", "Subsubtitle",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["    ", "Subsubtitle"],
 StyleBox["To ", "Subtitle",
  FontSize->18],
 StyleBox["close", "Subtitle",
  FontSize->18,
  FontVariations->{"Underline"->True}],
 StyleBox[" a group of cells:", "Subtitle",
  FontSize->18],
 StyleBox["\nObserve that several cells may be grouped together in a nested \
manner like:\n\t\t  ", "Subsubtitle"],
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    FontSize->1], 
   StyleBox[GridBox[{
      {
       StyleBox["\[RightModified]", "Subsubtitle",
        FontSize->24,
        FontSlant->"Plain",
        FontColor->RGBColor[0, 0, 1]]},
      {
       StyleBox["\[RightModified]", "Subsubtitle",
        FontSize->24,
        FontSlant->"Plain",
        FontColor->RGBColor[0, 0, 1]]}
     }],
    SpanMaxSize->Infinity], 
   StyleBox["]",
    SpanMaxSize->Infinity,
    FontColor->RGBColor[0, 0, 1]]}]], "Text"],
 "       ",
 StyleBox["or", "Subsubtitle",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox["     ",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox["  ", "Subsubtitle"],
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    FontSize->1], 
   StyleBox[GridBox[{
      {
       StyleBox["\[RightModified]", "Subsubtitle",
        FontSize->24,
        FontSlant->"Plain",
        FontColor->RGBColor[0, 0, 1]]},
      {
       StyleBox["\[RightModified]", "Subsubtitle",
        FontSize->24,
        FontSlant->"Plain",
        FontColor->RGBColor[0, 0, 1]]},
      {
       StyleBox["\[RightModified]", "Subsubtitle",
        FontSize->24,
        FontSlant->"Plain",
        FontColor->RGBColor[0, 0, 1]]}
     }],
    SpanMaxSize->Infinity], 
   StyleBox["]",
    SpanMaxSize->Infinity,
    FontColor->RGBColor[0, 0, 1]]}]], "Text"],
 "  ",
 StyleBox["      etc.  \nTypical examples include an Input-Output pair of \
cells or cells grouped naturally using the cell types of:   Section, \
Subsection etc.\n\n\nTo ", "Subsubtitle"],
 StyleBox["close", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" a group of cells:\n\n1: Move the mouse cursor until it becomes \
vertical on the 2nd OUTER cell bracket as shown below (cell brackets are \
located to the far right), then click ", "Subsubtitle"],
 StyleBox["once", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" and it would look like:", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.3902168808050003`*^9, 3.3902169034230003`*^9}, {
   3.3902599680612*^9, 3.3902599703562*^9}, {3.3902600609231997`*^9, 
   3.3902600945741997`*^9}, {3.3903040257321997`*^9, 3.3903040314222*^9}, {
