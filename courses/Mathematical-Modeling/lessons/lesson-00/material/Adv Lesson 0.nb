Cell[TextData[{
 "To evaluate the contents of an input cell:\n\n 1: Click your mouse cursor \
on the ",
 StyleBox["2",
  FontColor->GrayLevel[0]],
 " below\t\t\n 2: Hold down the ",
 Cell[BoxData[
  ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Shift\\\",\\nFontColor->GrayLevel[0]\
]\\)\"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3902568748942003`*^9, 3.3902569155852003`*^9}],
 " key\n 3: Press the ",
