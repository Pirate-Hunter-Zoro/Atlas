   3.3905424162144003`*^9}, {3.3905424722363997`*^9, 3.3905427517384*^9}, 
   3.3905429872594*^9, 3.3905430353704*^9, {3.3905430937324*^9, 
   3.3905430982654*^9}, 3.3905431453543997`*^9, {3.3905432598034*^9, 
   3.3905434886904*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", "\[Pi]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"1", "+", "x", "+", "y"}]}], "Input",
 CellChangeTimes->{{3.3893964440956*^9, 3.3893965058126*^9}, {
   3.3893966096056004`*^9, 3.3893966122586*^9}, {3.3893967019726*^9, 
   3.3893967041046*^9}, {3.3905174436504*^9, 3.3905174489594*^9}, 
   3.3905176758264*^9, {3.3905993341963997`*^9, 3.3905993353784*^9}}],

Cell[TextData[{
 "Note that at this moment in time (after the evaluation),  y  still has ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " assigned value and is therefore colored ",
 StyleBox["blue",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " in ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Input",
  FontVariations->{"Underline"->True}],
 " Cells.\n\nAlso note that at this moment in time (after the evaluation),  x \
 now ",
 StyleBox["has",
  FontVariations->{"Underline"->True}],
 " an assigned value of  \[Pi]  and is therefore colored ",
 StyleBox["black",
  FontWeight->"Bold"],
 " in ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Input",
  FontVariations->{"Underline"->True}],
 " Cells.\n\nEvaluate the following Input Cell that assigns  \[ExponentialE] \
+ x  to  y  (remember,  x  already ",
 StyleBox["has",
  FontVariations->{"Underline"->True}],
 " an assigned value of  \[Pi]):"
}], "Text",
 CellChangeTimes->{{3.3893965715926*^9, 3.3893966615526*^9}, {
   3.3893967152486*^9, 3.3893967311865997`*^9}, {3.3893968504926*^9, 
   3.3893968625326*^9}, 3.3893988508676*^9, {3.389661841542*^9, 
   3.389661848218*^9}, {3.389662678176*^9, 3.389662680225*^9}, {
   3.389662716439*^9, 3.389662803328*^9}, 3.389662844648*^9, {
   3.3905177122704*^9, 3.3905177471524*^9}, {3.3905178175694*^9, 
   3.3905178686604*^9}, {3.3905179624664*^9, 3.3905179960704*^9}, {
   3.3905435264554*^9, 3.3905435551514*^9}, {3.3905436084284*^9, 
   3.3905437748494*^9}, {3.3905567851286*^9, 3.3905568135875998`*^9}}],

Cell[BoxData[
 RowBox[{"y", "=", 
  RowBox[{"\[ExponentialE]", "+", "x"}]}]], "Input",
 CellChangeTimes->{{3.3893966821156*^9, 3.3893966925256*^9}, {
  3.3905177631284*^9, 3.3905177695364*^9}, {3.3905178007114*^9, 
  3.3905178020724*^9}}],

Cell[TextData[{
 "Note that ",
 StyleBox["after",
  FontVariations->{"Underline"->True}],
 " evaluating the above Input Cell, that ALL occurrences of the variable  y  \
in EVERY ",
 StyleBox["Input",
  FontVariations->{"Underline"->True}],
 " Cell are no longer ",
 StyleBox["blue",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " but are now ",
 StyleBox["black",
  FontWeight->"Bold"],
 ".  \n\nYou have observed that the consequence of assigning a value to a \
variable in one Input Cell is automatically reflected in EVERY Input Cell \
within your notebook.\n\nClear all assignments to both  x  and  y  by \
evaluating:"
}], "Text",
 CellChangeTimes->{{3.3893967569486*^9, 3.3893968365666*^9}, {
   3.3893968843476*^9, 3.3893969158436003`*^9}, 3.3893988619576*^9, 
   3.389662853637*^9, {3.389662887014*^9, 3.3896629571029997`*^9}, {
   3.3905438351563997`*^9, 3.3905438483954*^9}, {3.3905438827153997`*^9, 
   3.3905438980814*^9}, {3.3905439295573997`*^9, 3.3905439726014*^9}, {
   3.3905440085944*^9, 3.3905440229284*^9}, {3.3905570563316*^9, 
   3.3905570573156*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x", ",", "y"}], "]"}]], "InputOnly",
 CellChangeTimes->{
  3.3905432513064003`*^9, {3.3905570977686*^9, 3.3905570982016*^9}}],

Cell[TextData[{
 "Note that ",
 StyleBox["after",
  FontVariations->{"Underline"->True}],
 " Clearing, every occurrence of both  x  and  y  within an Input Cell is now \
",
 StyleBox["blue",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 ".\n\n\n",
 StyleBox["The following example illustrates the use of coloring to help you \
avoid programming syntax errors:", "Subsubsection"],
 "\n\nConsider the following Input Cell that currently contains a syntax \
error. \n\n",
 StyleBox["Before",
  FontVariations->{"Underline"->True}],
 " you evaluate the Input Cell, note the ",
 StyleBox["purple",
  FontColor->RGBColor[0.5, 0, 0.5]],
 " coloring corresponding to the incomplete ",
 Cell[BoxData[
  FormBox[
   StyleBox["\"\<\!\(\*
StyleBox[\"[\",
FontWeight->\"Bold\",
FontColor->RGBColor[0.5, 0, 0.5]]\)\>\"",
    FontSize->16], TraditionalForm]]],
 " syntax error:"
}], "Text",
 CellChangeTimes->{{3.3893970675536003`*^9, 3.3893971928986*^9}, {
   3.3893973237626*^9, 3.3893974569396*^9}, {3.3893975371156*^9, 
   3.3893976242396*^9}, {3.3893977578306*^9, 3.3893977631516*^9}, {
   3.3893979423146*^9, 3.3893980179476*^9}, {3.3893981131396*^9, 
   3.3893981849336*^9}, {3.3893982560526*^9, 3.3893982667396*^9}, {
   3.3893983572785997`*^9, 3.3893984547876*^9}, {3.3893985237066*^9, 
   3.3893985706486*^9}, {3.3893986684146*^9, 3.3893986803616*^9}, 
   3.3893988714586*^9, {3.3893993273656*^9, 3.3893993275495996`*^9}, 
   3.3894098746244*^9, {3.389661911435*^9, 3.389661935968*^9}, {
   3.389661973799*^9, 3.389661984439*^9}, {3.38966206409*^9, 
   3.389662125975*^9}, {3.3905440794944*^9, 3.3905441342553997`*^9}, {
   3.3905444988534*^9, 3.3905445579044*^9}, {3.3905446313414*^9, 
   3.3905448230534*^9}, {3.3905448985783997`*^9, 3.3905448991904*^9}, {
   3.3905450676524*^9, 3.3905450881664*^9}, {3.3905994453073997`*^9, 
   3.3905994465123997`*^9}, 3.3905994787964*^9, 3.439040893421875*^9}],

Cell[BoxData[
 RowBox[{"f", "[", "x"}]], "Input",
 CellChangeTimes->{{3.5230139376848164`*^9, 3.523013940399234*^9}}],

Cell[TextData[{
 "\nNext: Evaluate the above Input Cell containing this error and note the \
consequences:\n\n\tThe red and yellow highlighted error ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{" ", 
     RowBox[{"[", " "}]}],
    FontSize->16,
    FontWeight->"Bold",
    FontColor->RGBColor[1, 0, 0],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 " within the Input Cell\n\tThe ",
 StyleBox["red cell bracket:",
  FontColor->RGBColor[1, 0, 0]],
 " ",
 StyleBox["]",
  FontSize->24,
  FontColor->RGBColor[1, 0, 0]],
 " located to the right, and\n\tThe orange information button ",
 Cell[BoxData[
  FormBox[
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"+\\\",\\nFontSize->18]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    Background->RGBColor[1, 0.5, 0],
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], TraditionalForm]]],
 " :\n\t\nClick the orange information button ",
 Cell[BoxData[
  FormBox[
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"+\\\",\\nFontSize->18]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    Background->RGBColor[1, 0.5, 0],
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], TraditionalForm]]],
 " to display the error Messages.\n\nNext: \n\n\tCorrect the syntax error  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "[", "x"}],
    FontSize->14,
    FontWeight->"Bold"], TraditionalForm]]],
 "  in the above Input Cell by adding the closing  ",
 Cell[BoxData[
  FormBox[
   StyleBox["]",
    FontSize->14,
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n\t\n\tThen evaluate again and observe the results."
}], "Text",
 CellChangeTimes->{{3.3893988903936*^9, 3.3893989150886*^9}, {
   3.3893989537706003`*^9, 3.3893990051446*^9}, {3.3896622796400003`*^9, 
   3.3896624302460003`*^9}, {3.389662464605*^9, 3.389662528583*^9}, {
   3.389662578769*^9, 3.38966257967*^9}, {3.3896630096099997`*^9, 
   3.389663025889*^9}, {3.3896632681540003`*^9, 3.3896632862860003`*^9}, {
   3.389663350561*^9, 3.389663401579*^9}, {3.3905449311184*^9, 
   3.3905449940164003`*^9}, {3.3905451405654*^9, 3.3905451421754*^9}, {
   3.3905452184124002`*^9, 3.3905452470104*^9}, {3.3905571395875998`*^9, 
   3.3905571434296*^9}, {3.439038873328125*^9, 3.43903890378125*^9}, {
   3.43903895315625*^9, 3.439038957234375*^9}, 3.43904091125*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" ", "Subtitle"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "*", "y"}], "Subtitle"], TraditionalForm]], "None"],
 StyleBox["  and  ", "Subtitle"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "y"}], "Subtitle"], TraditionalForm]], "None"],
 StyleBox["  Are Not the Same as  ", "Subtitle"],
 StyleBox["xy", "Subtitle",
  FontSlant->"Italic"]
}], "Section",
 CellChangeTimes->{{3.439124777390625*^9, 3.439124782796875*^9}, {
  3.439124820109375*^9, 3.439124866890625*^9}, {3.439124909484375*^9, 
  3.439124940609375*^9}}],

Cell[TextData[{
 "Often a very frustrated student will complain that their ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code does not work and they can not understand why. The \"conversation\" \
goes something like:\n\nStudent: \"",
 StyleBox["Stupid stupid ",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox[" does not like me!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"  and  \"",
 StyleBox["I hate ",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\".\n\nInstructor: Calm down and consider ",
 StyleBox["WHY",
  FontVariations->{"Underline"->True}],
 " the following code does not work:"
}], "Text",
 CellChangeTimes->{{3.3902638864282*^9, 3.3902639045811996`*^9}, {
   3.3902642024402*^9, 3.3902642236071997`*^9}, 3.3902642602892*^9, {
   3.390778689551704*^9, 3.390778799475704*^9}, {3.439039606703125*^9, 
   3.439039607859375*^9}, {3.439125386890625*^9, 3.439125403875*^9}, {
   3.439125435484375*^9, 3.439125559875*^9}, {3.43912561446875*^9, 
   3.43912564871875*^9}, {3.4391259660625*^9, 3.43912602971875*^9}, {
   3.4391273898125*^9, 3.439127390203125*^9}, {3.439128408078125*^9, 
   3.4391284191875*^9}, {3.439128465875*^9, 3.43912849140625*^9}, {
   3.439128534140625*^9, 3.43912854175*^9}, {3.523014046401913*^9, 
   3.523014047103918*^9}},
 FontSize->14],

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "xy", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "\[Pi]"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.43912506340625*^9, 3.439125151796875*^9}, {
  3.43912676221875*^9, 3.4391267731875*^9}}],

Cell[TextData[{
 "\nInstructor: Now you evaluate the above code and see that the 3-d plot is \
empty! \n\nStudent: \"",
 StyleBox["See!!!  I told you it wouldn't work!!!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nStudent: \"",
 StyleBox["Stupid stupid ",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["!!!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nInstructor: But if you look closely at the current coloring of the \
symbols (",
 StyleBox["xy",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 "  and  ",
 StyleBox["x",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 "  and  ",
 StyleBox["y",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 ") you will see:\n\n\tDark blue indicating that  ",
 StyleBox["xy",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 "  is undefined, and\n\tDark green indicating that  ",
 StyleBox["x",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 "  and  ",
 StyleBox["y",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 "  are local variables used to generate the plot.\n\tAnd that the colors for \
 ",
 StyleBox["xy",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 "  and  ",
 StyleBox["x",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 "  and  ",
 StyleBox["y",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 "  are not the same!\n\tSo, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has NO way to generate your plot.\n\nStudent: \"",
 StyleBox["So -- I told you that ",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox[" hates me!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\t\nInstructor: Looking closely, you see that  ",
 StyleBox["xy",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 "  is a ",
 StyleBox["single",
  FontVariations->{"Underline"->True}],
 " 2-letter symbol and NOT the product of  ",
 StyleBox["x",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 "  and  ",
 StyleBox["y",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 ". \n\nStudent:  \"",
 StyleBox["So -- ",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox[" doesn't understand me either!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nInstructor: ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is trying to tell you (in its own gentle and nurturing way) that you code \
will not work and is also trying to help you fix your problem (if you would \
only listen).  See, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " loves you after all.  It's all just a communication difficulity.\n\n\
Student: \"",
 StyleBox["I don't feel loved!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nStudent: \"",
 StyleBox["And my code doesn't work!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nStudent: \"",
 StyleBox["Stupid stupid ",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nInstructor:  So, correct the syntax in the above code as either  ",
 StyleBox["x  y",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 "  or  ",
 StyleBox["x",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 Cell[BoxData[
  FormBox[
   UnderoverscriptBox[
    StyleBox["*",
     FontSize->18], " ", " "], TraditionalForm]]],
 StyleBox["y",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 "  and re-evaluate the plot.  Go on, you can do it. \n\nStudent: \"",
 StyleBox["You actually want me to put in that stupid \"space\" between  x  \
and  y ?",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nInstructor:  Yes.  And it's not a stupid \"space\", it's syntax.  \
Proper communication -- remember?  Don't forget to ",
 "reevaluate",
 " the code while you are at it.\n\nStudent: \"",
 StyleBox["Wow!  It actually worked!",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nInstructor: Also notice that the color of  ",
 StyleBox["xy",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 "  ",
 StyleBox["immediately",
  FontVariations->{"Underline"->True}],
 " changed to  ",
 StyleBox["x",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 Cell[BoxData[
  FormBox[
   UnderoverscriptBox[
    StyleBox["*",
     FontSize->18], " ", " "], TraditionalForm]]],
 StyleBox["y",
  FontSize->18,
  FontColor->RGBColor[0, 1, 0]],
 ",  indicating that the local plot variables are being used correctly.\n\n\
Student:  ",
 StyleBox["Sigh... ",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5],
  Background->None],
 StyleBox["\[HappySmiley]\[HappySmiley]\[HappySmiley]",
  FontSize->24,
  FontColor->RGBColor[0.5, 0, 0.5],
  Background->None],
 StyleBox[" ",
  FontSize->18,
  FontColor->RGBColor[0.5, 0, 0.5],
  Background->None],
 StyleBox["--- \"I now see the flowering of a long and beautiful relationship \
with ",
  FontColor->RGBColor[0.5, 0, 0.5],
  Background->None],
 StyleBox["Mathematica ",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5],
  Background->None],
 StyleBox["\[HeartSuit]\[HeartSuit]\[HeartSuit] ",
  FontSize->24,
  FontColor->RGBColor[0.5, 0, 0.5],
  Background->None],
 StyleBox["!\"",
  FontColor->RGBColor[0.5, 0, 0.5],
  Background->None],
 StyleBox["\n",
  Background->RGBColor[0.94, 0.88, 0.94]],
 "\nStudent:  \"",
 StyleBox["Thank you for restoring my faith in ",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->RGBColor[0.5, 0, 0.5]],
 StyleBox[".",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\"\n\nInstructor: Your welcome, always gald to solve relationship problems \
in addition to math problems."
}], "Text",
 CellChangeTimes->{{3.3902638864282*^9, 3.3902639045811996`*^9}, {
   3.3902642024402*^9, 3.3902642236071997`*^9}, 3.3902642602892*^9, {
   3.390778689551704*^9, 3.390778799475704*^9}, {3.439039606703125*^9, 
   3.439039607859375*^9}, {3.439125386890625*^9, 3.439125403875*^9}, {
   3.43912558465625*^9, 3.43912559984375*^9}, {3.43912566346875*^9, 
   3.439125686984375*^9}, {3.439125777171875*^9, 3.439125928578125*^9}, {
   3.439126074125*^9, 3.43912672253125*^9}, {3.439126785765625*^9, 
   3.439126908546875*^9}, {3.439126983453125*^9, 3.439126984265625*^9}, {
   3.4391270265625*^9, 3.439127102046875*^9}, {3.439127135015625*^9, 
   3.43912728965625*^9}, {3.439127346484375*^9, 3.439127365515625*^9}, {
   3.439127437828125*^9, 3.43912752096875*^9}, {3.43912762471875*^9, 
   3.439127626296875*^9}, {3.439127666734375*^9, 3.439127683328125*^9}, {
   3.439127794765625*^9, 3.43912792*^9}, {3.439128059359375*^9, 
   3.43912815375*^9}, {3.439128208578125*^9, 3.43912822259375*^9}, {
   3.43912827628125*^9, 3.43912831475*^9}, 3.439128513328125*^9, {
   3.439128610734375*^9, 3.4391290345*^9}, {3.439129093578125*^9, 
   3.439129120015625*^9}, {3.439129163734375*^9, 3.43912955271875*^9}, {
   3.439129667171875*^9, 3.4391300401875*^9}, {3.43913010834375*^9, 
   3.43913015196875*^9}, {3.439130230875*^9, 3.439130233921875*^9}, {
   3.439130318640625*^9, 3.439130429515625*^9}, {3.4391306289375*^9, 
   3.439130662625*^9}, {3.43913074134375*^9, 3.439130748828125*^9}, {
   3.43913079290625*^9, 3.43913081446875*^9}, {3.439130890921875*^9, 
   3.43913095384375*^9}, {3.439130991203125*^9, 3.43913108053125*^9}, {
   3.439131491046875*^9, 3.439131502921875*^9}, 3.5230141509381833`*^9},
 FontSize->14]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Style Sheets ", "Subtitle"]], "Section"],

Cell[TextData[{
 "It is extremely easy to choose a useful and attractive style for a \
notebook.  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has a number of preexisting styles to choose from.  Style sheets can be \
located using the menu item:   \n\n\t\t",
 StyleBox["Format  \[DoubleLongRightArrow]  Style Sheet  \
\[DoubleLongRightArrow]  select a style that you like...",
  FontWeight->"Bold"],
 "\n\n",
 StyleBox["To illustrate how different style sheets look for this ", 
  "Subsubtitle"],
 StyleBox["Mathematica", "Subsubtitle",
  FontSlant->"Italic"],
 StyleBox[" notebook, \nyou should select a different style sheet from the \
above menu and see the result.\n\nNow try ", "Subsubtitle"],
 StyleBox["several", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" different style sheet selections and see the results.\n", 
  "Subsubtitle"],
 "\nDifferent style sheets have different properties, and you should examine \
a style sheet closely to see if it fits your needs.  \n\n",
 StyleBox["Return to the ",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox["original",
  FontSize->14,
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[" style sheet for this notebook: \n\n\t\t",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox["Format  \[DoubleLongRightArrow]  Style Sheet  \
\[DoubleLongRightArrow]  Creative  \[DoubleLongRightArrow]  Pastel Color",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{
  3.3902619793462*^9, {3.3902620249852*^9, 3.3902621140532*^9}, {
   3.439039040375*^9, 3.439039123703125*^9}, {3.439039180625*^9, 
   3.439039254234375*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Copying ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox[" into Microsoft Word ", "Subtitle"]
}], "Section",
 CellChangeTimes->{3.43913212875*^9}],

Cell[TextData[{
 "Eventually, you will want the ability to copy and paste ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " content into a Microsoft Word document.  The procedure is extremely \
straightforward.  Fundamentally, you will be copying either text, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " formulas or ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " graphics into a Microsoft Word document.  The following example \
illustrates all three procedures.\n\n",
 StyleBox["Open Microsoft Word and create a simple Microsoft Word document \
consisting of several short lines of text.  Leave some space between the \
lines in which you wish to copy text, formulas and graphics.\n\n",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[" Copying Text ", "Subtitle"],
 StyleBox["\n1:  Copy and paste some text from Mathematica into Microsoft \
Word:\n",
  FontSize->14,
  FontSlant->"Italic"],
 "\n\t\tHighlight this text with your mouse.\n\n",
 StyleBox["2:  \"Copy\" it either by selecting:\n\n\tEdit  \
\[DoubleLongRightArrow]  Copy   (From the Mathematica toolbar)\n\tEdit  \
\[DoubleLongRightArrow]  Copy as  \[DoubleLongRightArrow]   Plain Text  \nor\n\
\tRight click the mouse and select \"Copy\"\n\t\n3:  Switch to the Microsoft \
Word window.\n4:  Select an insertion point for your text in the Microsoft \
Word document by clicking your mouse at the desired location.\n5:  \"Paste\" \
the text into Microsoft Word either by selecting:\n\n\tEdit  \
\[DoubleLongRightArrow]  Paste   (From the Microsoft Word toolbar)\nor\n\t\
Right click the mouse and select \"Paste\"\n\t\n6:  You may now edit this \
text within Microsoft Word as you normally would.\n",
  FontSize->14,
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.3902623289082003`*^9, 3.3902623338322*^9}, {
  3.3902623780582*^9, 3.3902623810072002`*^9}, {3.3902624244302*^9, 
  3.3902624272242002`*^9}, {3.3902625143962*^9, 3.3902625419122*^9}}],

Cell[TextData[{
 StyleBox[" Copying Formulas ", "Subtitle"],
 StyleBox["\n1:  Copy and paste some formulas from Mathematica into Microsoft \
Word.  Highlight the following formula with your mouse:",
  FontSize->14,
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{3.3902626040962*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "a", "b"], 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", "x"], "*", 
    RowBox[{"Sin", "[", "x", "]"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]}]], "Input",
 CellChangeTimes->{{3.3902626168342*^9, 3.3902626330332003`*^9}}],

Cell[TextData[{
 "\n",
 StyleBox["2:  \"Copy\" it either by selecting:\n\n\tEdit  \
\[DoubleLongRightArrow]  Copy   (From the Mathematica toolbar)\nor\n\tRight \
click the mouse and select \"Copy\"\n\t\n3:  Switch to the Microsoft Word \
window.\n4:  Select an insertion point for your formula in the Microsoft Word \
document by clicking your mouse at the desired location.\n5:  \"Paste\" the \
formula into Microsoft Word either by selecting:\n\n\tEdit  \
\[DoubleLongRightArrow]  Paste   (From the Microsoft Word toolbar)\nor\n\t\
Right click the mouse and select \"Paste\"\n\t\n6:  You may now resize and \
reposition this formula within Microsoft Word (i.e. click on the formula in \
Microsoft Word to resize and reshape).    \nNote, you will not only copy and \
paste the formula, but also the background color and other style issues \
associated with the Mathematica notebook.  Therefore, it is usually better to \
select a Style Sheet for your notebook which has the desired background color \
and font type before you copy the formula into Microsoft Word.\n",
  FontSize->14,
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{
  3.3902626040962*^9, {3.3902626585182*^9, 3.3902626616921997`*^9}, {
   3.3902627384902*^9, 3.3902627678982*^9}}],

Cell[TextData[{
 StyleBox[" Copying Graphics ", "Subtitle"],
 StyleBox["\n1:  Copy and paste some graphics from Mathematica into Microsoft \
Word by evaluating the following Plot command and clicking your mouse once on \
the resulting graphic output (the graphic indicates it has been selected when \
it is surrounded by an orange box):  ",
  FontSize->14,
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.3902628329502*^9, 3.3902628444902*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]], "Input"],

Cell[TextData[StyleBox["\n2:  \"Copy\" it either by selecting:\n\tEdit  \
\[DoubleLongRightArrow]  Copy   (From the Mathematica toolbar)\nor\n\tRight \
click the mouse and select \"Copy\"\n3:  Switch to the Microsoft Word window.\
\n4:  Select an insertion point for your graphic in the Microsoft Word \
document by clicking your mouse at the desired location.\n5:  \"Paste\" the \
graphic into Microsoft Word either by selecting:\n\tEdit  \
\[DoubleLongRightArrow]  Paste   (From the Microsoft Word toolbar)\nor\n\t\
Right click the mouse and select \"Paste\"\n6:  You may now resize and \
reposition this graphic within Microsoft Word (i.e. click on the graphic in \
Microsoft Word to resize and reshape).  \nNote, you will not only copy and \
paste the graphic, but also the background color and other style issues \
associated with the Mathematica notebook.  Therefore, it is usually better to \
select a Style Sheet for your notebook which has the desired background color \
and font type before you copy the graphic into Microsoft Word.",
 FontSize->14,
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{3.3902629649472*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Interrupt Evaluation ", "Subtitle"]], "Section"],

Cell[TextData[{
 "  As you begin to program in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", eventually you will enter a command that produces an infinite loop, or a \
command which involves a massive amount of computation beyond the capability \
of your machine.  \n\nIn such a case, you will want to ",
 StyleBox["Abort",
  FontWeight->"Bold"],
 " or ",
 StyleBox["Interrupt",
  FontWeight->"Bold"],
 " the evaluation.  This can be accomplished by clicking on the above \
sequence of menu items:\n\n\t\t Evaluation \[DoubleLongRightArrow] Interrupt \
Evaluation... \[DoubleLongRightArrow] Abort \n\tor\n\t\t Evaluation \
\[DoubleLongRightArrow] Abort Evaluation \n\t\t \n",
 StyleBox["To illustrate how this is done, evaluate the following input cell \
which produces a loop that will continue for 50 seconds.  \n\nThen  ", 
  "Subsubtitle"],
 StyleBox["Abort",
  FontSize->16],
 StyleBox["  the evaluation:", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.3902638864282*^9, 3.3902639045811996`*^9}, {
   3.3902642024402*^9, 3.3902642236071997`*^9}, 3.3902642602892*^9, {
   3.390778689551704*^9, 3.390778799475704*^9}, {3.439039606703125*^9, 
   3.439039607859375*^9}},
 FontSize->14],

Cell[BoxData[
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\[IndentingNewLine]", 
     RowBox[{
     "\"\<\\n\\nAbort by selecting window menu items:\\nEvaluation \
\[DoubleLongRightArrow] Abort Evaluation      \>\"", ",", 
      "\[IndentingNewLine]", "i"}], "\[IndentingNewLine]", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Pause", "[", "0.5", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "100"}], "}"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3903041289681997`*^9, 3.3903041928232*^9}, {
  3.3903042237562*^9, 3.3903042756842003`*^9}, {3.3905572094386*^9, 
  3.3905572405906*^9}}],

Cell[TextData[{
 "\n",
 StyleBox["Do this ", "Subsubtitle"],
 StyleBox["several", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" times so that you will not forget how it is done.", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.3902638864282*^9, 3.3902639045811996`*^9}, {
   3.3902642024402*^9, 3.3902642236071997`*^9}, 3.3902642602892*^9, {
   3.390778689551704*^9, 3.390778799475704*^9}, {3.439039541484375*^9, 
   3.43903959659375*^9}},
 FontSize->14]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Delete All Output ", "Subtitle"]], "Section"],

Cell[TextData[{
 "As your ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebooks grow in size (especially if they contain extensive use of \
graphics or sound), it may be necessary or possibly desirable to delete the \
Output Cells from a notebook when you save it.  This command can be located \
in menu item: \n\n\t\t",
 StyleBox["Cell  \[DoubleLongRightArrow]  Delete All Output",
  FontWeight->"Bold"],
 "\n\t\t\n\t\tAnswer ",
 StyleBox["Yes",
  FontWeight->"Bold"],
 " to Delete All Output as you can recreate the Output Cell by reevaluating \
your notebook.\n\t\t\n",
 StyleBox["Now is a good time to perform the \"Delete All Output\" command.  \
Reexamine your notebook to see the effect.  The notebook now has a much \
smaller size then before.",
  FontSize->14,
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.3903043480192003`*^9, 3.3903044085832*^9}, {
  3.3905572886136*^9, 3.3905573230866003`*^9}, {3.3907788312317038`*^9, 
  3.3907789088517036`*^9}}]
}, Closed]]
}, Open  ]],

Cell[TextData[{
 StyleBox["  \nIf you experience difficulty using ",
  FontSize->18],
 StyleBox["Mathematica",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[" in the future, then rework this notebook again.  Keep at it until \
you are proficient.\n\n",
  FontSize->18],
 "Congratulations, you are now a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " user!!!"
}], "Subtitle",
 CellChangeTimes->{
  3.439031241796875*^9, {3.439039816734375*^9, 3.439039864828125*^9}, {
   3.439124568484375*^9, 3.4391246644375*^9}, {3.43913160659375*^9, 
   3.439131635390625*^9}}]
}, Open  ]]
},
WindowSize->{981, 585},
WindowMargins->{{-2, Automatic}, {Automatic, 1}},
Magnification->1.25,
