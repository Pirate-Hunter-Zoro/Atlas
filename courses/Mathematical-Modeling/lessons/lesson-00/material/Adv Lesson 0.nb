Cell[TextData[{
 StyleBox["6: Start typing your text within the Text cell.\n\nCreate a new \
TEXT cell between this cell:\t", "Subsubtitle"],
 StyleBox["--- ", "Subsubtitle",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["\[DoubleDownArrow] -- \[DoubleDownArrow] -- \[DoubleDownArrow] -- \
\[DoubleDownArrow] -- \[DoubleDownArrow] ---", "Subsubtitle",
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.390216301608*^9, 3.39021630288*^9}, {3.390216346782*^9, 
   3.3902163821689997`*^9}, {3.390216442381*^9, 3.390216443698*^9}, {
   3.3902591234402*^9, 3.3902591461292*^9}, {3.3902591787722*^9, 
   3.3902592379432*^9}, {3.3905134263524*^9, 3.3905134419154*^9}, 
   3.439031921578125*^9, 3.439032182484375*^9, 3.43903268671875*^9, {
   3.439032808390625*^9, 3.439032820296875*^9}}],

Cell[TextData[{
 StyleBox["and this cell:\t\t\t\t\t", "Subsubtitle"],
 StyleBox["--- ", "Subsubtitle",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["\[DoubleUpArrow] -- \[DoubleUpArrow] -- \[DoubleUpArrow] -- \
\[DoubleUpArrow] -- \[DoubleUpArrow] ---", "Subsubtitle",
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["\n\nType:     ", "Subsubtitle"],
 StyleBox["This is a text cell\n", "Subsubtitle",
  FontSlant->"Plain",
  FontColor->GrayLevel[0]],
 StyleBox["\n", "Subsubtitle"],
 StyleBox["Try", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" to evaluate the newly created Text cell and note that a ", 
  "Subsubtitle"],
 StyleBox["Text", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" cell can ", "Subsubtitle"],
 StyleBox["not", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" be evaluated.\n(If the cell ", "Subsubtitle"],
 StyleBox["did", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" evaluate, then it was an Input cell and you did ", "Subsubtitle"],
 StyleBox["not", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" properly create a Text cell.  If this happened, then try again to \
create a Text cell at the above location.)", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{
  3.390216250123*^9, {3.3902592560271997`*^9, 3.3902592996482*^9}, {
   3.3905133547534*^9, 3.3905133591724*^9}, {3.3905134614084*^9, 
   3.3905136356794*^9}, {3.3905136705374002`*^9, 3.3905137135854*^9}, {
   3.439032856390625*^9, 3.43903288015625*^9}}],

Cell[TextData[{
 " \n",
 StyleBox["Cell Basics:", "Subsubtitle",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["    ", "Subsubtitle"],
 StyleBox["To change the cell style:", "Subtitle",
  FontSize->18],
 StyleBox["\n1: Move the mouse cursor to the right until it becomes vertical \
on a cell bracket. Brackets are located to the far right and appear as  ", 
  "Subsubtitle"],
 StyleBox["\[RightModified] ", "Subsubtitle",
  FontSize->24,
  FontSlant->"Plain",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[".  Observe that there are small variations at the top of each cell \
bracket  ", "Subsubtitle"],
 StyleBox["\[RightModified]", "Subsubtitle",
  FontSize->24,
  FontSlant->"Plain",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["  which allow visual distinction between:  Input, Output and Text \
cells.\n2: Click on the ", "Subsubtitle"],
 StyleBox["first", "Subsubtitle",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox[" cell bracke (the ", "Subsubtitle"],
 StyleBox["shortest left most", "Subsubtitle",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox[" cell bracket) and the bracket will be highlighted as   ", 
  "Subsubtitle"],
 StyleBox["\[RightModified]", "Subsubtitle",
  FontSize->24,
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[1, 1, 0],
  Background->GrayLevel[0]],
 StyleBox[" . \n3: Click on the menu item: ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Format",
     FontSize->14]], TraditionalForm]]],
 StyleBox["\n4: Select:  ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Style",
     FontSize->14]], TraditionalForm]]],
 StyleBox["\n5: Select:  Any style from the list i.e.   ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Title",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Subtitle",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", ... ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Text",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", ... ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Input",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", ... etc. \n6: Repeat the above steps making ", "Subsubtitle"],
 StyleBox["many", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" different choices for  ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Style",
     FontSize->14]], TraditionalForm]]],
 StyleBox[".\nHint: Starting at step 2, you may also right click the mouse \
button, select:  ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Style",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", then select any style from the list i.e.  ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Title",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Subtitle",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", ... ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Text",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", ... ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Input",
     FontSize->14]], TraditionalForm]]],
 StyleBox[", ... etc.", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.390216687881*^9, 3.390216705642*^9}, {
