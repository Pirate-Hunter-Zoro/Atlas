  FontSize->14,
  FontWeight->"Plain",
  FontSlant->"Italic"],
 "\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    OverscriptBox[
     RowBox[{"Group", " ", "of", " ", "cells", "              "}], "_"], 
    "Section"], TraditionalForm]]],
 StyleBox["\[RightModified]\[RightModified]", "Subsubtitle",
  FontSize->24,
  FontSlant->"Plain",
  FontColor->RGBColor[0, 0, 1]]
}], "Text",
 CellChangeTimes->{{3.43912056840625*^9, 3.439120609859375*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Cell Basics:", "Subsubtitle",
  FontSize->18],
 StyleBox["    ", "Subsubtitle"],
 StyleBox["To ", "Subtitle",
  FontSize->18],
 StyleBox["open", "Subtitle",
  FontSize->18,
  FontVariations->{"Underline"->True}],
 StyleBox[" a group of cells:", "Subtitle",
  FontSize->18]
}], "Section",
 CellChangeTimes->{3.4390319549375*^9}],

Cell[TextData[{
 StyleBox["1: Move the mouse cursor until it becomes vertical on the 2nd \
closed OUTER cell bracket. Note the downward pointing arrow on the 2nd cell \
bracket indicating that it is currently closed. T", "Subsubtitle"],
 StyleBox["hen click ", "Subsubtitle",
  FontWeight->"Plain",
  FontSlant->"Italic"],
 StyleBox["once", "Subsubtitle",
  FontWeight->"Plain",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[".  It should look like: ", "Subsubtitle",
  FontWeight->"Plain",
  FontSlant->"Italic"],
 StyleBox["\n", "Text",
  FontSize->14,
  FontWeight->"Plain",
  FontSlant->"Italic"],
 "\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    OverscriptBox[
     RowBox[{"Group", " ", "of", " ", "cells", "              "}], "_"], 
    "Section"], TraditionalForm]]],
 StyleBox["\[RightModified]", "Subsubtitle",
  FontSize->24,
  FontSlant->"Plain",
  FontColor->RGBColor[0, 0, 1]],
 " ",
 StyleBox["\[RightModified]", "Subsubtitle",
  FontSize->24,
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[1, 1, 0],
  Background->GrayLevel[0]],
 StyleBox["\n\n2: ", "Subsubtitle"],
 StyleBox["Double", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox["-Click the 2nd cell bracket and the bracket will open. \n\n\n\n", 
  "Subsubtitle"],
 StyleBox["Open", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" the above group of cells (It should look the same as when you \
started.):\n\nRepeatedly ", "Subsubtitle"],
 StyleBox["Select", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" and then ", "Subsubtitle"],
 StyleBox["Close", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" and ", "Subsubtitle"],
 StyleBox["Open", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" the above group of cells to get use to the process:\n", 
  "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.3902604001622*^9, 3.3902605237032003`*^9}, {
  3.3902605863192*^9, 3.3902606816552*^9}, {3.3905147720154*^9, 
  3.3905147768224*^9}, {3.43903532075*^9, 3.43903546746875*^9}, {
  3.43903771446875*^9, 3.43903772*^9}, {3.439120684796875*^9, 
  3.43912068684375*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Cell Basics:", "Subsubtitle",
  FontSize->18],
 StyleBox["    ", "Subsubtitle"],
 StyleBox["To Cut, Copy or Paste a ", "Subtitle",
  FontSize->18],
 StyleBox["group", "Subtitle",
  FontSize->18,
  FontVariations->{"Underline"->True}],
 StyleBox[" of cells:", "Subtitle",
  FontSize->18]
}], "Section",
 CellChangeTimes->{3.43903196196875*^9, 3.4391319065625*^9}],

Cell[TextData[{
 StyleBox["1: Move the mouse cursor to the right until it becomes vertical on \
a cell bracket (or a group of cell brackets). Brackets are located to the far \
right and appear as  ", "Subsubtitle"],
 StyleBox["\[RightModified] ", "Subsubtitle",
  FontSize->24,
  FontSlant->"Plain",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[". \n2: Click once on the cell bracket (the bracket will be \
highlighted as   ", "Subsubtitle"],
 StyleBox["\[RightModified]", "Subsubtitle",
  FontSize->24,
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[1, 1, 0],
  Background->GrayLevel[0]],
 StyleBox["  ). \n3: Click on the menu item:  ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Edit",
     FontSize->14]], TraditionalForm]]],
 StyleBox["   (or right click your mouse)\n4: Select:  ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Cut",
     FontSize->14]], TraditionalForm]]],
 StyleBox[" or ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Copy",
     FontSize->14]], TraditionalForm]]],
 StyleBox[" \n5: Select:  A location to Paste the  cell or group of cells by \
moving the mouse cursor between two cells until it becomes horizontal and \
click once to produce a black horizontal line.\n6: Click on the menu item:  ",
   "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Edit",
     FontSize->14]], TraditionalForm]]],
 StyleBox["   (or right click your mouse)\n4: Select:  ", "Subsubtitle"],
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox["Paste",
     FontSize->14]], TraditionalForm]]],
 StyleBox[" \n\n", "Subsubtitle"],
 StyleBox["Select", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" the following  Input cell:\n", "Subsubtitle"],
 StyleBox["Copy", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" the Input cell:\nThen ", "Subsubtitle"],
 StyleBox["Paste", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" the copy immediately below this cell:", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.390217143799*^9, 3.390217195701*^9}, {3.390217233817*^9,
    3.390217276925*^9}, {3.3902607585732*^9, 3.3902608194681997`*^9}, {
   3.3902608512212*^9, 3.3902608735271997`*^9}, {3.439035508453125*^9, 
   3.43903556821875*^9}, {3.43903561825*^9, 3.439035650078125*^9}, {
   3.439120751328125*^9, 3.439120752703125*^9}, 3.439131930546875*^9}],

Cell[BoxData["\"\<Copy and Paste this Input Cell\>\""], "InputOnly",
 CellChangeTimes->{3.390772892922*^9}],

Cell[TextData[{
 StyleBox["Then ", "Subsubtitle"],
 StyleBox["Delete", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" this newly created cell:\n\nRepeatedly ", "Subsubtitle"],
 StyleBox["Select", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" and then ", "Subsubtitle"],
 StyleBox["Copy", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" , ", "Subsubtitle"],
 StyleBox["Paste", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox["  and ", "Subsubtitle"],
 StyleBox["Delete", "Subsubtitle",
  FontVariations->{"Underline"->True}],
 StyleBox[" the above Input cell to get use to the process:\n", "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.439035583328125*^9, 3.43903560453125*^9}, {
  3.439035666046875*^9, 3.439035698625*^9}, {3.439037729328125*^9, 
  3.43903775003125*^9}, {3.439120812515625*^9, 3.43912082821875*^9}, {
  3.439131938609375*^9, 3.439131947046875*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Cell Basics: ", "Subsubtitle",
  FontSize->18],
 StyleBox["   ", "Subsubtitle"],
 StyleBox["To organize several sections of cells:", "Subtitle",
  FontSize->18]
}], "Section",
 CellChangeTimes->{3.439031972546875*^9}],

Cell[TextData[StyleBox["Eventually, you will want to organize your notebooks \
into separate sections.  This can be accomplished easily by inserting a \
Section cell at each desired location.  To illustrate this concept, open up \
each of the following sections (i.e. a group of cells headed by a Section \
cell) and evaluate the contents.  Also notice the distinction between a \
Section Cell, Text Cell and an Input Cell:", "Subsubtitle"]], "Text",
 CellChangeTimes->{{3.3905156032344*^9, 3.3905156080304003`*^9}, {
  3.3905156381493998`*^9, 3.3905156503873997`*^9}, {3.439131956578125*^9, 
  3.439131960046875*^9}},
 FontSize->14]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Section 1,   Plot the Sin[x]\t\t\t\t(This is a typical Section cell.)\
\>", "Section",
 CellChangeTimes->{{3.3905149457514*^9, 3.3905149677674*^9}, {
   3.3905158800193996`*^9, 3.3905158994364*^9}, 3.3905159512124*^9, 
   3.3979200237464876`*^9}],

Cell[TextData[{
 "This is a typical ",
 StyleBox["Text",
  FontWeight->"Bold"],
 " cell.  \n\nWe can plot the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", "x", "]"}], TraditionalForm]]],
 " using the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command Pot[ ... ]:"
}], "Text",
 CellChangeTimes->{{3.3905149715494003`*^9, 3.3905149721054*^9}, {
   3.3905154267664003`*^9, 3.3905154385764*^9}, 3.390772917148*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]], "Input"],

Cell[TextData[{
 "\nEvaluate the above ",
 StyleBox["Input",
  FontWeight->"Bold"],
 " cell to generate the plot in an ",
 StyleBox["Output",
  FontWeight->"Bold"],
 " cell.\nObserve how the ",
 StyleBox["Input",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Output",
  FontWeight->"Bold"],
 " cells are grouped together as indicated by their cell brackets."
}], "Text",
 CellChangeTimes->{{3.3905153318984003`*^9, 3.3905153651443996`*^9}, {
   3.3905154119634*^9, 3.3905154124754*^9}, {3.3905154693464003`*^9, 
   3.3905155482623997`*^9}, 3.439035782265625*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Section 2,   Differentiate the Sin[x]\t\t(This is a typical Section cell.)\
\>", "Section",
 CellChangeTimes->{
  3.3905150005664*^9, {3.3905158915774*^9, 3.3905159066703997`*^9}, 
   3.3905159464404*^9}],

Cell[TextData[{
 "This is a typical ",
 StyleBox["Text",
  FontWeight->"Bold"],
 " cell. \n\nDifferentiate the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", "x", "]"}], TraditionalForm]]],
 " function with respect to x, i.e. find  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{"d", " ", 
      RowBox[{"Sin", "[", "x", "]"}]}], 
     RowBox[{"d", " ", "x"}]],
    FontWeight->"Bold"], TraditionalForm]]],
 ". \nWe can differentiate the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", "x", "]"}], TraditionalForm]]],
 " using the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \
\\(\[Placeholder]\\)]\\) \[FilledSquare] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3905152438044*^9}],
 "  located on the ",
 StyleBox["Basic Math Input Palette",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3902610402712*^9, 3.3902610424952*^9}, {
   3.3905150856454*^9, 3.3905151204723997`*^9}, {3.3905152568084*^9, 
   3.3905153020294*^9}, 3.43903586884375*^9}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "x"], " ", 
  RowBox[{"Sin", "[", "x", "]"}]}]], "Input"],

Cell[TextData[{
 "\nEvaluate the above ",
 StyleBox["Input",
  FontWeight->"Bold"],
 " cell to generate the answer in an ",
 StyleBox["Output",
  FontWeight->"Bold"],
 " cell."
}], "Text",
 CellChangeTimes->{{3.3905153318984003`*^9, 3.3905153651443996`*^9}, 
   3.43903585003125*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Section 3,   Plot the Sin[x] and the Cos[x]\t\t(This is a typical Section \
cell.)\
\>", "Section",
 CellChangeTimes->{
  3.3905150051904*^9, {3.3905159125964003`*^9, 3.3905159150214*^9}, {
   3.3905984902164*^9, 3.3905984960364*^9}, 3.3979200216995993`*^9}],

Cell[TextData[{
 "This is a typical ",
 StyleBox["Text",
  FontWeight->"Bold"],
 " cell. \n\nPlot both the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", "x", "]"}], TraditionalForm]]],
 " and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Cos", "[", "x", "]"}], TraditionalForm]]],
 " functions together:"
}], "Text",
 CellChangeTimes->{{3.3902610604892*^9, 3.3902610621012*^9}, 
   3.439035883625*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], ",", 
     RowBox[{"Cos", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]], "Input"],

Cell[TextData[{
 "\nEvaluate the above ",
 StyleBox["Input",
  FontWeight->"Bold"],
 " cell to generate the plot in an ",
 StyleBox["Output",
  FontWeight->"Bold"],
 " cell."
}], "Text",
 CellChangeTimes->{{3.3905153318984003`*^9, 3.3905153651443996`*^9}, {
   3.3905153954704*^9, 3.3905153959834003`*^9}, 3.43903589053125*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Section 4,   Solve:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"2", "x"}], "+", 
     RowBox[{"3", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"4", 
      SuperscriptBox["x", "3"]}]}], "\[Equal]", "1"}], TraditionalForm]]],
 "\t\t(This is a typical Section cell.)"
}], "Section",
 CellChangeTimes->{
  3.3905150005664*^9, {3.3905158915774*^9, 3.3905159066703997`*^9}, 
   3.3905159464404*^9, {3.3905985044764*^9, 3.3905985046314*^9}, {
   3.3905990631164*^9, 3.3905991227784*^9}}],

Cell[TextData[{
 "This is a typical ",
 StyleBox["Text",
  FontWeight->"Bold"],
 " cell. \n\nFind the 3 solutions (one real solution and two complex \
solutions) to the cubic equation:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"2", "x"}], "+", 
     RowBox[{"3", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"4", 
      SuperscriptBox["x", "3"]}]}], "\[Equal]", "1"}], TraditionalForm]]],
 "  (Note that equations require \"",
 Cell[BoxData[
  FormBox[
   StyleBox["==",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" and not \"",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\")\n\nusing the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command Solve[ ... ].\n\nEvaluate the following ",
 StyleBox["Input",
  FontWeight->"Bold"],
 " cell to generate the three answers in an ",
 StyleBox["Output",
  FontWeight->"Bold"],
 " cell."
}], "Text",
 CellChangeTimes->{{3.3902610402712*^9, 3.3902610424952*^9}, {
   3.3905150856454*^9, 3.3905151204723997`*^9}, {3.3905152568084*^9, 
   3.3905153020294*^9}, {3.3905985651034*^9, 3.3905986897464*^9}, {
   3.3905987446674*^9, 3.3905987667614*^9}, {3.3905989746563997`*^9, 
   3.3905989851454*^9}, 3.4390359065625*^9, {3.439120970828125*^9, 
   3.43912105184375*^9}}],

Cell[BoxData[
 RowBox[{"answers", "=", 
  RowBox[{"Solve", "[", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"2", "x"}], "+", 
      RowBox[{"3", 
       SuperscriptBox["x", "2"]}], "+", 
      RowBox[{"4", 
       SuperscriptBox["x", "3"]}]}], "\[Equal]", "1"}], ",", "  ", "x"}], 
   "  ", "]"}]}]], "Input",
 CellChangeTimes->{{3.3905983645474*^9, 3.3905984070674*^9}, {
   3.3905984380504*^9, 3.3905984670243998`*^9}, {3.3905985178084*^9, 
   3.3905985371174*^9}, {3.3905987867164*^9, 3.3905988044184*^9}, 
   3.3905988755224*^9}],

Cell["\<\

Display the three answers in a table:\
\>", "Text",
 CellChangeTimes->{{3.3905988235744*^9, 3.3905988473434*^9}, {
   3.3905989292354*^9, 3.3905989336804*^9}, 3.43903592959375*^9}],

Cell[BoxData[
 RowBox[{"TableForm", "[", " ", "answers", " ", "]"}]], "Input",
 CellChangeTimes->{{3.3905988581264*^9, 3.3905988714244003`*^9}, 
   3.3905989475564003`*^9}]
}, Closed]],

Cell[TextData[StyleBox["\nOpen the Section Cell for Each of the Following \
Topics:", "Subtitle"]], "Section",
 CellChangeTimes->{{3.3905157524264*^9, 3.3905157598044*^9}, {
  3.3906018243004*^9, 3.3906018408473997`*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Notebooks ", "Subtitle"]], "Section"],

Cell[TextData[{
 "Notebooks store the input and output corresponding to a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " program.  The disk file format for a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebook name is:    ",
 StyleBox["name.nb\n",
  FontWeight->"Bold"],
 "\nThe file name of this notebook is: ",
 StyleBox[" Lesson 0.nb",
  FontWeight->"Bold"],
 "\n\nIn MS Windows, double clicking on the filename:    ",
 StyleBox["name.nb",
  FontWeight->"Bold"],
 "    will load ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " along with the selected notebook (however, this may not work as expected \
if you are running over a network connection).\nAlternatively, it is possible \
to load ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " first, then select an existing notebook. \nThis can be accomplished by:\n\n\
\tUsing menu item:   ",
 StyleBox["File \[DoubleLongRightArrow] Open... \[DoubleLongRightArrow] \
navagate to proper subdirectory \[DoubleLongRightArrow] name.nb",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.390217866448*^9, 3.3902178842790003`*^9}, {
   3.43903607990625*^9, 3.4390361418125*^9}, {3.439121128921875*^9, 
   3.43912115778125*^9}, {3.4391212025625*^9, 3.439121248921875*^9}, 
   3.523012050899522*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Magnification ", "Subtitle"]], "Section"],

Cell[TextData[{
 "If your computer screen supports higher resolutions, then the appearance of \
a notebook may be too small.  It is possible to change the size of notebook \
fonts by using the Magnification setting.  This command can be located in \
menu item: \n\n\t ",
 StyleBox[" Window \[DoubleLongRightArrow] Magnification \
\[DoubleLongRightArrow] 50%  75%  ...  300%",
  FontWeight->"Bold"],
 ".  \n\t  \nAlso, the magnification can be changed by using the \"drop box\" \
located at the bottom-right of your notebook window.\n\nChange the current \
Magnification setting to 50% and then to 200% to see the effect. \n\nThen \
choose a Magnification setting that works well for you.\n\nHint:  Using a \
very large magnification (i.e. 200% or 300%) is often very useful when \
editing the small text boxes generated in complicated equations."
}], "Text",
 CellChangeTimes->{{3.390217978546*^9, 3.390217985837*^9}, {
  3.4069163231086793`*^9, 3.406916324030548*^9}, {3.439036186484375*^9, 
  3.43903618821875*^9}, {3.43912127353125*^9, 3.439121277203125*^9}, {
  3.43912131275*^9, 3.43912131325*^9}, {3.439121344109375*^9, 
  3.439121453875*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Toolbar ", "Subtitle"]], "Section",
 CellChangeTimes->{{3.4391217533125*^9, 3.439121757671875*^9}}],

Cell[TextData[{
 "An extremely useful feature of the notebook interface is to display the ",
 StyleBox["Toolbar",
  FontWeight->"Bold"],
 " at the top of each individual notebook window.  It allows you to quickly \
access : cell style, save notebook, print and text justification.  This \
command can be located in menu item : \n      \n      \t\t ",
 StyleBox[" Window \[DoubleLongRightArrow] Show Toolbar",
  FontWeight->"Bold"],
 "\n\t\t  \nLoad the ",
 StyleBox["Toolbar",
  FontWeight->"Bold"],
 " into the top of this notebook. \n      \nThen select ",
 StyleBox["this",
  FontVariations->{"Underline"->True}],
 " Text Cell (Select ",
 StyleBox["ONLY",
  FontWeight->"Bold"],
 " this single cell and ",
 StyleBox["NOT",
  FontWeight->"Bold"],
 " a cell group).\n\nFor each of the following steps, do  ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 "  un-select this cell, just click the drop arrow in the Toolbar \"drop \
box\".\n\nThe Toolbar \"drop box\" at the upper left should show ",
 StyleBox["Text",
  FontWeight->"Bold"],
 ". (If not, then you have not properly selected this cell.)\n\nUse the \
Toolbar \"drop box\" at the upper left to change the style of ",
 StyleBox["this",
  FontVariations->{"Underline"->True}],
 " cell to: ",
 StyleBox["Subsection",
  FontWeight->"Bold"],
 "\n\nUse the Toolbar \"drop box\" at the upper left to change the style of ",
 StyleBox["this",
  FontVariations->{"Underline"->True}],
 " cell to: ",
 StyleBox["SubSubsection",
  FontWeight->"Bold"],
 "\n\t\nUse the Toolbar \"drop box\" at the upper left to change the style of \
",
 StyleBox["this",
  FontVariations->{"Underline"->True}],
 " cell to: ",
 StyleBox["Text\n",
  FontWeight->"Bold"],
 "\n\tNote that in each case, the text formatting (colors and bold) was \
maintained.\n\t\nUse the Toolbar \"drop box\" at the upper left to change the \
style of ",
 StyleBox["this",
  FontVariations->{"Underline"->True}],
 " cell to: ",
 StyleBox["Input",
  FontWeight->"Bold"],
 "\n\n",
 StyleBox["\tNote the difference in appearance between a ",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["Text",
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" cell and an ",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["Input",
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" cell!\n\t\n\tDo NOT, and I repeat, do NOT mistake an ",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["Input",
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" cell for a ",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["Text",
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" cell ever again!\n\t\n\tRemember, an ",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["Input",
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" cell is intended for evaluation but a ",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["Text",
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" cell is not!",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 "\n\nUse the Toolbar \"drop box\" at the upper left to change the style of ",
 StyleBox["this",
  FontVariations->{"Underline"->True}],
 " cell back to: ",
 StyleBox["Text\n\n\tNote that the Text formatting (colors, bold and some tab \
keys) have been lost.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{
  3.390218024215*^9, {3.3902180597139997`*^9, 3.39021808758*^9}, {
   3.43912149728125*^9, 3.4391216128125*^9}, {3.439121788390625*^9, 
   3.439121815296875*^9}, {3.439121895484375*^9, 3.43912190040625*^9}, {
   3.439122011546875*^9, 3.439122300203125*^9}, {3.43912233340625*^9, 
   3.439122337078125*^9}, {3.439122379703125*^9, 3.439122396359375*^9}, {
   3.439122499765625*^9, 3.43912259471875*^9}, {3.43912263496875*^9, 
   3.43912269953125*^9}, {3.439122770546875*^9, 3.439122855796875*^9}, 
   3.4391228869375*^9, {3.439122930265625*^9, 3.43912294228125*^9}, {
   3.439123010921875*^9, 3.4391232789375*^9}, {3.439123361546875*^9, 
   3.4391233728125*^9}, {3.43912341084375*^9, 3.439123422265625*^9}, {
   3.439123501515625*^9, 3.439123592359375*^9}, {3.43912362915625*^9, 
   3.439123633546875*^9}, {3.439123687453125*^9, 3.4391236886875*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Useful Hints ", "Subtitle"]], "Section"],

Cell[TextData[{
 StyleBox["\[ControlKey]-k ", "Subtitle"],
 "\nOne of the most useful keyboard shortcuts is the ",
 StyleBox[" \[ControlKey]-", "Subtitle"],
 StyleBox["k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " command.  It is used to offer a selection of commands that start with the \
first few letters that you have typed.  This is useful for entering extremely \
long commands as well as determining the name of a command that you do not \
recall.\nFor example, say that you want to program a 3-dimensional plot, but \
you do not remember the correct name of the command.  You know that ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "attempts to name all commands that are related to each other with a common \
root name.  Therefore, since the command name that generates a 2-dimensional \
plot is:\n\n\t\tPlot[...]\n\t\t\nyou know that the command name for a \
3-dimensional plot should start with the letters \"Plot\" as well.  \n\nTo \
illustrate the ",
 StyleBox[" \[ControlKey]", "Subtitle"],
 StyleBox["-k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " shortcut, use the following \"Input cell\" containing \"Plot\":\n\t1:  Use \
your mouse to highlight \"Plot\" as \"",
 StyleBox["Plot",
  FontColor->GrayLevel[1],
  Background->GrayLevel[0]],
 "\".\n\t2:  Press and hold down the ",
 StyleBox[" \[ControlKey] ", "Subtitle"],
 " key followed by pressing the ",
 StyleBox[" ", "Subtitle"],
 StyleBox["k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " key.\n\t3:  Click your mouse to select \"Plot3D\" from the resulting list \
of commands.\n\t     \"Plot3D\" will automatically be pasted into the \"Input \
cell\"."
}], "Text",
 CellChangeTimes->{
  3.390218135657*^9, {3.390218227674*^9, 3.390218234949*^9}, 
   3.439036837515625*^9}],

Cell[BoxData["Plot"], "InputOnly",
 Evaluatable->False,
 CellChangeTimes->{{3.439036297203125*^9, 3.4390363060625*^9}}],

Cell[TextData[{
 "\nVariation of the procedure:\nYou do not need to explicitly highlight the \
typed command when you use the ",
 StyleBox[" \[ControlKey]", "Subtitle"],
 StyleBox["-k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " keyboard shortcut.  The keyboard shortcut will examine the letters \
immediately to the left of the current insertion point if you do not \
explicitly highlight the text.\nTo illustrate this procedure, enter the \
command \"ParametricPlot3D\" into the following empty \"Input cell\" by:\n\t\
1:  Typing the 4 letters \"",
 StyleBox["Para",
  FontWeight->"Bold"],
 "\" (without the quotation marks)\n\t2:  Then using the ",
 StyleBox[" \[ControlKey]", "Subtitle"],
 StyleBox["-k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " keyboard shortcut to select \"",
 StyleBox["ParametricPlot3D",
  FontWeight->"Bold"],
 "\"."
}], "Text"],

Cell[BoxData[""], "InputOnly",
 Evaluatable->False,
 CellChangeTimes->{{3.4390375188125*^9, 3.439037535578125*^9}, {
  3.439123832734375*^9, 3.43912384696875*^9}}],

Cell[TextData[{
 "\n\n",
 StyleBox["Text", "Subtitle",
  FontSize->18,
  FontVariations->{"Underline"->True}],
 StyleBox[" Cell Dictionary:", "Subtitle",
  FontSize->18],
 "\nThe ",
 StyleBox[" \[ControlKey]", "Subtitle"],
 StyleBox["-k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " keyboard shortcut is sensitive to the type of cell that you are working \
within.  For example, only ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands or user defined symbols will be offered as selections within \"",
 StyleBox["Input",
  FontWeight->"Bold"],
 "\" cells.  However, within \"",
 StyleBox["Text",
  FontWeight->"Bold"],
 "\" based cells, a spelling dictionary will be offered (similar to what \
would be used in a word processor).\nTo illustrate this procedure, correct \
the incorrectly spelled word \"speelling\" located below by:\n\t1:  First \
observing that the word \"speelling\" is contained within a \"",
 StyleBox["Text",
  FontWeight->"Bold"],
 "\" cell.\n\t2:  Use your mouse to highlight \"speelling\" as \"",
 StyleBox["speelling",
  FontColor->GrayLevel[1],
  Background->GrayLevel[0]],
 "\".\n\t3:  Use the ",
 StyleBox[" \[ControlKey]", "Subtitle"],
 StyleBox["-k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " keyboard shortcut to correct \"speelling\" to \"spelling\".\n\t\t\n\t\tNow \
",
 StyleBox["you",
  FontVariations->{"Underline"->True}],
 " correct the following incorrectly spelled word:   speelling\n\t\t\t"
}], "Text",
 CellChangeTimes->{
  3.390778309960704*^9, 3.390778544661704*^9, 3.4390364111875*^9, {
   3.439036493265625*^9, 3.4390365575*^9}, {3.43912387115625*^9, 
   3.439123915171875*^9}, {3.4391239750625*^9, 3.439123988125*^9}, {
   3.439124038546875*^9, 3.43912406796875*^9}}],

Cell[TextData[{
 StyleBox["\[ControlKey]-\[ShiftKey]-", "Subtitle"],
 StyleBox["k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 "\nOnce you have entered the name of a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ",
 "command",
 " into an \"",
 StyleBox["Input",
  FontWeight->"Bold"],
 "\" cell, then it would be handy to have a template to follow that would \
guide you in filling out the required arguments as well as supplying the \
required syntax.  For example, say that you have forgotten how to enter the \
arguments required for the ",
 StyleBox["Plot[...]",
  FontWeight->"Bold"],
 " command.  A template for these arguments along with the associated syntax \
can be automatically generated using the ",
 StyleBox[" \[ControlKey]-\[ShiftKey]", "Subtitle"],
 StyleBox["-k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " keyboard shortcut:\n\t1:  Use your mouse to position the insertion point \
immediately after the \"",
 StyleBox["Plot",
  FontWeight->"Bold"],
 "\" command or select the \"",
 StyleBox["Plot",
  FontWeight->"Bold"],
 "\" command by highlighting it.\n\t2:  Press and hold down the ",
 StyleBox[" \[ControlKey]-\[ShiftKey] ", "Subtitle"],
 " keys followed by pressing the ",
 StyleBox[" ", "Subtitle"],
 StyleBox["k", "Subtitle",
  FontSize->18],
 StyleBox[" ", "Subtitle"],
 " key. Then,\n\t\n\t    \t \t",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     TagBox[
      FrameBox["f"],
      "Placeholder"], ",", 
     RowBox[{"{", 
      RowBox[{
       TagBox[
        FrameBox["x"],
        "Placeholder"], ",", 
       TagBox[
        FrameBox[
         SubscriptBox["x", "min"]],
        "Placeholder"], ",", 
       TagBox[
        FrameBox[
         SubscriptBox["x", "max"]],
        "Placeholder"]}], "}"}]}], "]"}],
   FontWeight->"Bold"]],
  Evaluatable->False,
  CellChangeTimes->{3.390218563106*^9, 3.439036629828125*^9}],
 "\n\t     \t\n\t      will automatically be pasted into the selected \"",
 StyleBox["Input",
  FontWeight->"Bold"],
 "\" cell.\n\t3:  Inside each box:\n\t\n\t\t\t ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    FrameBox["f"],
    "Placeholder"], ",", 
   RowBox[{"{", 
    RowBox[{
     TagBox[
      FrameBox["x"],
      "Placeholder"], ",", 
     TagBox[
      FrameBox[
       SubscriptBox["x", "min"]],
      "Placeholder"], ",", 
     TagBox[
      FrameBox[
       SubscriptBox["x", "max"]],
      "Placeholder"]}], "}"}]}]],
  Evaluatable->False,
  CellChangeTimes->{3.390218563106*^9, 3.439036629828125*^9}],
 "  \n\t\t\t \n\t      type in your information ",
 StyleBox["Sin[t]",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[", {",
  FontWeight->"Bold"],
 StyleBox["t",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[", ",
  FontWeight->"Bold"],
 StyleBox["0",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[", ",
  FontWeight->"Bold"],
 StyleBox["2\[Pi]",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["}",
  FontWeight->"Bold"],
 " within the template \"",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     TagBox[
      FrameBox["f"],
      "Placeholder"], ",", 
     RowBox[{"{", 
      RowBox[{
       TagBox[
        FrameBox["x"],
        "Placeholder"], ",", 
       TagBox[
        FrameBox[
         SubscriptBox["x", "min"]],
        "Placeholder"], ",", 
       TagBox[
        FrameBox[
         SubscriptBox["x", "max"]],
        "Placeholder"]}], "}"}]}], "]"}],
   FontWeight->"Bold"]],
  Evaluatable->False,
  CellChangeTimes->{3.390218563106*^9, 3.439036629828125*^9}],
 "\" to produce:\n\t\n\t\t\t",
 StyleBox["Plot[",
  FontWeight->"Bold"],
 StyleBox["Sin[t]",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[", {",
  FontWeight->"Bold"],
 StyleBox["t",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[", ",
  FontWeight->"Bold"],
 StyleBox["0",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[", ",
  FontWeight->"Bold"],
 StyleBox["2\[Pi]",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["}]",
  FontWeight->"Bold"],
 " \n\t\t\t\n\t      thereby preserving the syntax."
}], "Text",
 CellChangeTimes->{{3.390218528678*^9, 3.390218556506*^9}, {
   3.439036645421875*^9, 3.439036660953125*^9}, {3.439036692921875*^9, 
   3.43903679009375*^9}, 3.4390368270625*^9, {3.439037023640625*^9, 
   3.43903711528125*^9}, {3.439037198484375*^9, 3.43903728259375*^9}, {
   3.439124109546875*^9, 3.43912411584375*^9}, {3.439124173234375*^9, 
   3.4391241889375*^9}, {3.523013229736678*^9, 3.5230132360079184`*^9}}],

Cell[BoxData[
 RowBox[{" ", "Plot"}]], "Input",
 CellChangeTimes->{{3.439037439875*^9, 3.439037488875*^9}}],

Cell[TextData[{
 "\nFill out and evaluate the above ",
 StyleBox["Input",
  FontWeight->"Bold"],
 " cell and evaluate it to see your plot."
}], "Text",
 CellChangeTimes->{{3.439037348234375*^9, 3.439037370109375*^9}, 
   3.439037466859375*^9, {3.4390375031875*^9, 3.43903750690625*^9}, {
   3.439124319203125*^9, 3.4391243234375*^9}}],

Cell[TextData[{
 StyleBox["\nGetting Help With ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox[" Functions ", "Subtitle"],
 "\nWhen programming in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", it would be extremely convenient to be able to automatically obtain \
helpful information on any commands that you are using.  For example, say \
that you want retrieve information on the \"",
 StyleBox["Plot",
  FontWeight->"Bold"],
 "\" command from ",
 StyleBox["Mathematica'",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["s Help Documentation Center",
  FontWeight->"Bold"],
 ".\n\t1:  Use your mouse to position the insertion point immediately after \
the \"",
 StyleBox["Plot",
  FontWeight->"Bold"],
 "\" command (but before \"",
 StyleBox["[Sin[x],{x,0,1}]",
  FontWeight->"Bold"],
 "\") or select the \"",
 StyleBox["Plot",
  FontWeight->"Bold"],
 "\" command by highlighting it.\n\t2:  Right click your mouse and select ",
 StyleBox[" Get Help ", "Subtitle",
  FontSize->16],
 StyleBox[" ",
  FontSize->16],
 "from the list.\n\t     ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s ",
 StyleBox["Help Documentation Center",
  FontWeight->"Bold"],
 " will be automatically launched and the \"",
 StyleBox["Plot",
  FontWeight->"Bold"],
 "\" command will be selected."
}], "Text",
 CellChangeTimes->{
  3.390778398685704*^9, 3.3907784959887037`*^9, 3.439037855671875*^9, {
   3.43903793075*^9, 3.439038010421875*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Why the Coloring? ", "Subtitle"]], "Section",
 CellChangeTimes->{{3.3905171627584*^9, 3.3905171987254*^9}}],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " color codes the variables contained within ",
 StyleBox["Input",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " Cells. As you learn what each color code means, it will help you to \
program more efficiently and to avoid many programming pitfalls."
}], "Text",
 CellChangeTimes->{{3.3905414774694*^9, 3.3905416056934*^9}, {
  3.3905441793234*^9, 3.3905442015854*^9}, {3.3905442507844*^9, 
  3.3905442516504*^9}}],

Cell[TextData[{
 "Look at any ",
 StyleBox["Input",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " Cell and notice that some of the variables are colored.  You may determine \
the meaning of each color code by the following procedure:\n\nStep 1: Choose \
an ",
 StyleBox["Input",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " Cell that you want ",
 StyleBox["Help with the Coloring",
  FontWeight->"Bold"],
 " by:\n\n\t\tClicking on the blue Cell bracket located to the right.\n\t\t\
(When the Cell bracket is selected it is highlighted.)\n\nStep 2:  From the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " main window ",
 StyleBox["menu",
  FontWeight->"Bold"],
 " select:\n\n\t\t",
 StyleBox["Help",
  FontWeight->"Bold"],
 " ",
 StyleBox["\[FilledRightTriangle]", "MenuPointer"],
 " ",
 StyleBox["Why the Coloring?...",
  FontWeight->"Bold"],
 "\n\t\t"
}], "Text",
 CellChangeTimes->{{3.3893958372376003`*^9, 3.3893958808915997`*^9}, {
  3.3893959132216*^9, 3.3893961188476*^9}, {3.3893961561146*^9, 
  3.3893961959086*^9}, {3.3893991660986*^9, 3.3893991830346003`*^9}, {
  3.389663062686*^9, 3.389663066875*^9}, {3.3905175131734*^9, 
  3.3905175133613997`*^9}, {3.3905416527774*^9, 3.3905417953724003`*^9}, {
  3.3905418417374*^9, 3.3905418843854*^9}, {3.3905442553724003`*^9, 
  3.3905442559274*^9}, {3.439038226859375*^9, 3.439038228046875*^9}}],

