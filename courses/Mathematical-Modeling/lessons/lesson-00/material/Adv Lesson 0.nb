Cell[TextData[{
 "Note that there are MANY different colors used to illustrate different \
types of information (most are not needed for a beginner).\n\nHowever, I \
would like to point out the following two colors: \n\n\t\t",
 StyleBox["blue",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " and ",
 StyleBox["black",
  FontWeight->"Bold"],
 ".\n\nNote that:\n\n\t\t ",
 StyleBox["black",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " variables ",
 StyleBox["currently",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["have",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " assigned values, and \n\t\t ",
 StyleBox["blue",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0, 0, 1]],
 " variables ",
 StyleBox["currently",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0, 0, 1]],
 " do ",
 StyleBox["not",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0, 0, 1]],
 "  have assigned values.\n\t\t \nThis is very helpful in ",
 StyleBox["automatically",
  FontVariations->{"Underline"->True}],
 " keeping track of which variables do and do not have assigned values.  \n\n\
Please note the use of the word ",
 StyleBox["currently",
  FontVariations->{"Underline"->True}],
 ". Your interaction with a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebook is a dynamic process.  The current color of a variable will \
change dynamically whenever you either assign a value or clear a value.\n\n\
Begin by ",
 StyleBox["clearing",
  FontWeight->"Bold"],
 " all assignments to  x  and  y  by evaluating:"
}], "Text",
 CellChangeTimes->{{3.3893962844356003`*^9, 3.3893964363966*^9}, {
   3.3893969315456*^9, 3.3893969941275997`*^9}, {3.3893987154486*^9, 
   3.3893987200736*^9}, {3.3893992160615997`*^9, 3.3893992201226*^9}, {
   3.3893992684286003`*^9, 3.3893992996736*^9}, {3.389661330347*^9, 
   3.389661367941*^9}, {3.3896616215559998`*^9, 3.3896616501809998`*^9}, 
   3.38966168296*^9, {3.389661723586*^9, 3.389661804533*^9}, {
   3.3896626467130003`*^9, 3.3896626512679996`*^9}, {3.3905172726594*^9, 
   3.3905174227454*^9}, 3.3905174587054*^9, {3.3905175973724003`*^9, 
   3.3905176689084*^9}, {3.3905419783073997`*^9, 3.3905421107074003`*^9}, {
   3.3905422085424*^9, 3.3905423546924*^9}, {3.3905423960084*^9, 
   3.3905424162144003`*^9}, {3.3905424722363997`*^9, 3.3905427517384*^9}, 
   3.3905429872594*^9, 3.3905430353704*^9, {3.3905430937324*^9, 
   3.3905430982654*^9}, {3.3905431453543997`*^9, 3.3905431987074003`*^9}, {
   3.3905443235864*^9, 3.3905443474884*^9}, {3.3905566587976*^9, 
   3.3905567261136*^9}, 3.3905992751734*^9, {3.4390385046875*^9, 
   3.4390385061875*^9}, {3.43903853896875*^9, 3.439038578203125*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "y"}], "]"}]], "InputOnly",
 CellChangeTimes->{3.3905432513064003`*^9}],

Cell[TextData[{
 "\nObserve the ",
 StyleBox["current",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["blue",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " coloring of the variables  x  and  y  in ",
 StyleBox["every",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Input",
  FontVariations->{"Underline"->True}],
 " Cell that contains either  x  and/or  y.\n\t\nEvaluate the following ",
 StyleBox["Input",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " Cell that ",
 StyleBox["assigns",
  FontVariations->{"Underline"->True}],
 " the number  \[Pi]  to  x:"
}], "Text",
 CellChangeTimes->{{3.3893962844356003`*^9, 3.3893964363966*^9}, {
