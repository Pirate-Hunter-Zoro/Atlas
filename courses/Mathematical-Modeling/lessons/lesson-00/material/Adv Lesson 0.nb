 FractionBox["2", "3"]], "Output",
 CellChangeTimes->{3.439037673140625*^9}]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["When you are done closing the above cells, it should \
look like: ", "Subsubtitle",
 FontWeight->"Plain",
 FontSlant->"Italic"]], "Section"],

Cell[TextData[{
 "\t\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    OverscriptBox[
     RowBox[{"Group", " ", "of", " ", "cells", "             "}], "_"], 
    "Section"], TraditionalForm]]],
 StyleBox["\[RightModified]", "Subsubtitle",
  FontSize->24,
  FontSlant->"Plain",
  FontColor->RGBColor[0, 0, 1]],
 " ",
 StyleBox["\[RightModified]\n", "Subsubtitle",
  FontSize->24,
  FontWeight->"Bold",
  FontSlant->"Plain",
  FontColor->RGBColor[1, 1, 0],
  Background->GrayLevel[0]],
 StyleBox["or", "Subsubtitle"],
