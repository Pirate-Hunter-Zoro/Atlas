Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \nAdvanced Lesson 12\n\nPure (Anonymous) Functions\n\nDr. Dale R. Doty\n\
University of Tulsa"
}], "Title",
 CellChangeTimes->{{3.399803471144396*^9, 3.3998034729256573`*^9}}],

Cell[TextData[{
 "A knowledge of the use of anonymous functions is very important to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  It allows the user to use a function without defining and storing it \
internally.  As such, the use of anonymous functions is very convenient.  \
There are two notations for anonymous functions.  The first involves the use \
of the \"Function\" command (and is not often used), and the second involves \
a more complicated notation."
}], "Text",
 CellChangeTimes->{{3.3898407297696557`*^9, 3.3898407564816556`*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Notation For Pure Functions:", "Subtitle"]], \
"Section"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly"],

Cell[CellGroupData[{

Cell["   The \"Function\" Command:", "Subsection"],

Cell["\<\
Function[body] or body& is a pure function. 
The formal parameters are # (or #1), #2, etc. 
Function[x, body] is a pure function with a single formal parameter x. 
Function[{x1, x2, ... }, body] is a pure function with a list of formal \
parameters.\
\>", "Item",
 CellChangeTimes->{{3.3900440200434*^9, 3.3900440236963997`*^9}},
 FontWeight->"Bold"],

Cell["Examples:", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Function", " ", "[", 
    SuperscriptBox["#", "2"], "]"}], "[", "2", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Function", " ", "[", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "2"]}], "]"}], "[", "2", "]"}]}]], "Input"],

Cell["\<\

Note that the variables used in \"Function\" are local to Function (and \
therefore can not be assigned).\
\>", "Text",
 CellChangeTimes->{3.5232906779172134`*^9}],

Cell[BoxData[
 RowBox[{"x", "=", "2"}]], "Input"],

Cell[BoxData[
 RowBox[{"Function", " ", "[", 
  SuperscriptBox["#", "2"], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Function", " ", "[", 
   RowBox[{"x", ",", 
    SuperscriptBox["x", "2"]}], "]"}]}]], "Input"],

Cell["\<\

Examples:\
\>", "Text",
 CellChangeTimes->{3.5232906918473525`*^9}],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"Function", " ", "[", 
    RowBox[{"{", 
     RowBox[{"#1", ",", 
      SqrtBox["#2"], ",", 
      RowBox[{"Sin", "[", "#3", "]"}]}], "}"}], "]"}], " ", "[", 
   RowBox[{"1", ",", "2", ",", "3"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Function", " ", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       SqrtBox["y"], ",", 
       RowBox[{"Sin", "[", "z", "]"}]}], "}"}]}], "]"}], " ", "[", 
   RowBox[{"1", ",", "2", ",", "3"}], "]"}]}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "   The \"",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["#1", "2"], "&"}]]],
 "\" Notation for a Pure Function:"
}], "Subsection"],

Cell[TextData[{
 "The argument for a pure function is denoted as  \"#\"  or  \"#1\".\nThe \
primary symbol that designates the expression as a pure function is \"&\".\n",
 "Consider the following pure function which squares its first argument:  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SuperscriptBox["#", "2"], "&"}],
   FontWeight->"Bold"]]]
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["#", "2"], "&"}], ")"}], "[", "2", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["#", "2"], "&"}], ")"}], "[", "z", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["#", "2"], "&"}], ")"}], "[", "\"\<anything\>\"", 
  "]"}]], "Input"],

Cell["\<\

Consider the pure function with three arguments, which returns the first \
argument, takes the square root of the second argument and takes the Sine of \
the third argument.  Evaluate this function at  \"[1,2,3]\":\
\>", "Text",
 CellChangeTimes->{3.5232907278677125`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#1", ",", 
      SqrtBox["#2"], ",", 
      RowBox[{"Sin", "[", "#3", "]"}]}], "}"}], "&"}], ")"}], "[", 
  RowBox[{"1", ",", "2", ",", "3"}], "]"}]], "Input"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Examples:", "Subtitle"]], "Section"],

Cell["\<\
Consider the notation used to evaluate a pure function of one or more \
arguments:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Sin", "[", "#", "]"}], "&"}], ")"}], "[", "z", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Sin", "[", "#", "]"}], "&"}], " ", "[", "z", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"#", ",", 
     RowBox[{"Sin", "[", "#", "]"}]}], "}"}], "&"}], "[", "z", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"#1", ",", 
     RowBox[{"Sin", "[", "#2", "]"}]}], "}"}], "&"}], "[", 
  RowBox[{"z1", ",", "z2"}], "]"}]], "Input"],

Cell["\<\

Say you want to map a function onto a list:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", 
    RowBox[{
    "4", ",", "65", ",", "12", ",", "4", ",", "8", ",", "21", ",", "4"}], 
    "}"}]}], ";"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Map", " ", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "#", "]"}], "&"}], ",", " ", "data"}], 
   "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Map", " ", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "#", "]"}], "&"}], ",", " ", "data"}], 
   "]"}]}]], "Input"],

Cell["\<\

Say you want to select only data points \[GreaterEqual] 10\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", 
    RowBox[{
    "4", ",", "65", ",", "12", ",", "4", ",", "8", ",", "21", ",", "4"}], 
    "}"}]}], ";"}]], "InputOnly"],

Cell["\<\
Select[list, crit] picks out all elements ei of list for which crit[ei] is \
True.\
\>", "Item",
 CellChangeTimes->{{3.3900440058894*^9, 3.3900440127664003`*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Select", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"data", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "\[GreaterEqual]", "10"}], ")"}], "&"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3898409670316553`*^9, 3.3898409766506557`*^9}}],

Cell["\<\

Say that you want to determine if you have at least 10 data points.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "65", ",", "12", ",", "4"}], "}"}]}], 
  ";"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"If", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"#1", "\[GreaterEqual]", "10"}], "&"}], ")"}], "[", 
    RowBox[{"Length", "[", "data", "]"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<At least 10 data points\>\"", ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\"\<Less than 10 data points\>\""}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898410126666555`*^9, 3.3898410305736556`*^9}}],

Cell["\<\
 
Say you want to replace only those data elements \[GreaterEqual]10 with 0.\
\>", "Text",
 CellChangeTimes->{{3.3898410473686557`*^9, 3.3898410484686556`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", 
    RowBox[{
    "4", ",", "65", ",", "12", ",", "4", ",", "8", ",", "21", ",", "4"}], 
    "}"}]}], ";"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"Map", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"#", "\[GreaterEqual]", "10"}], ",", "0", ",", "#"}], "]"}], 
     ")"}], "&"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "data"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898410559336557`*^9, 3.3898410631186557`*^9}}],

Cell["\<\
 
Say you want a pure function that calculates the length of a data set and the \
average of its elements.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", 
    RowBox[{
    "4", ",", "65", ",", "12", ",", "4", ",", "8", ",", "21", ",", "4"}], 
    "}"}]}], ";"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"Length", " ", "[", "#", "]"}], ",", " ", 
      FractionBox[
       RowBox[{" ", 
        RowBox[{"Apply", " ", "[", " ", 
         RowBox[{"Plus", ",", "#"}], "]"}]}], 
       RowBox[{" ", 
        RowBox[{"Length", " ", "[", "#", "]"}]}]]}], "}"}], "&"}], ")"}], "[",
   " ", "data", "]"}]], "Input"],

Cell["\<\

Next, use pure functions to define a piece-wise function:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", "f", "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"1.", "   ", "/;", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "<", "#"}], " ", "&&", " ", 
        RowBox[{"#", "<", "1"}]}], ")"}], "&"}], ")"}], "[", "x", 
    "]"}]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"0.", "   ", "/;", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", " ", "\[LessEqual]", 
         RowBox[{"-", "1"}]}], "||", " ", 
        RowBox[{"1", "\[LessEqual]", "#"}]}], ")"}], "&"}], ")"}], "[", "x", 
    "]"}]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", "  ", 
    RowBox[{"Thickness", " ", "[", ".02", "]"}]}]}], "]"}]], "Input"],

Cell["\<\
 
Say you want to select those data points where the first coordinate is \
\[LessEqual] the second coordinate.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newData", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "5"}], "}"}]}], "}"}]}], ";"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Select", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"newData", ",", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3898411317276554`*^9, 3.3898411437296553`*^9}}],

Cell["\<\

Say you want to multiply the first and second coordinates for each point in a \
data set.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newData", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "5"}], "}"}]}], "}"}]}], ";"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"Map", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
      RowBox[{"#", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "newData"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898411634926558`*^9, 3.389841176103656*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Conversion Between Pure and Regular Functions:", \
"Subtitle"]], "Section"],

Cell[TextData[{
 "It may appear on the surface that there is a sharp distinction between pure \
and regular functions.  However, this is not the case.  \nIn ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", a function definition:   \n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]]],
 " \nactually corresponds to two parts:\n\t\t",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 "  which is the name of the pure function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["#1", "2"], "&"}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "x", "]"}], TraditionalForm]]],
 " which corresponds to the argument ",
 Cell[BoxData[
  FormBox["#1", TraditionalForm]]],
 " \n\t\t\nThe correspondence is:\n\n\t\t      f\t[x]\n\t\t     \
\[DoubleUpDownArrow]\t \[DoubleUpDownArrow]\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["#1", "2"], "&"}], TraditionalForm]]],
 "\t[x]\nFor example, consider a simple pure function.  It can be made to \
behave just like a regular function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3898412450576553`*^9, 3.3898413909796553`*^9}, {
  3.3898414653436556`*^9, 3.389841470759656*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"f", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"f", "=", 
  RowBox[{
   SuperscriptBox["#", "2"], "&"}]}]}], "Input"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"f", "[", "x", "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
    "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.3898414915886555`*^9, 3.3898415241426554`*^9}}],

Cell[BoxData[
 RowBox[{"f", "'"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "'"}], "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "'"}], "[", "x", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.3898415443716555`*^9, 3.3898415713376555`*^9}}],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input",
 CellChangeTimes->{{3.3898416881826553`*^9, 3.3898416899796553`*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "'"}], "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input"],

Cell["\<\

Likewise, consider a regular function.  It can be made to behave like a pure \
function:\
\>", "Text",
 CellChangeTimes->{3.523290865449088*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "f", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  SuperscriptBox["x", "2"]}]}], "InputOnly"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x", "]"}], "/.", 
  RowBox[{"x", "\[Rule]", "#"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "'"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"f", "'"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "//",
   "Column"}]], "Input",
 CellChangeTimes->{{3.389841625391656*^9, 3.3898416527466555`*^9}}],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input",
 CellChangeTimes->{{3.389841751759656*^9, 3.389841753577656*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "'"}], "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input"],

Cell[CellGroupData[{

Cell["Example:", "Subsection"],

Cell[TextData[{
 "Consider solving a differential equation using DSolve[...].  \nYou have two \
choices:\n\t\tReturn the answer as a function of the argument ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]]],
 ":  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "[", "t", "]"}], TraditionalForm]]],
 " \n\t\t\ti.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", "eqns", "}"}], ",", 
     StyleBox[
      RowBox[{"y", "[", "t", "]"}],
      FontColor->RGBColor[1, 0, 0]], ",", "t"}], "]"}], TraditionalForm]]],
 "\n\t\tReturn the answer as a named pure function:  ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]],
 "\n\t\t\ti.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", "eqns", "}"}], ",", 
     StyleBox["y",
      FontColor->RGBColor[1, 0, 0]], ",", "t"}], "]"}], TraditionalForm]]],
 "\n\t\t\t\nThe decision as to which method to use is purely a matter of \
preference.  However, the functional form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "[", "t", "]"}], TraditionalForm]]],
 " is much more restrictive than the pure function form ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]],
 ".\n\nIf you use the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "[", "t", "]"}], TraditionalForm]]],
 ", then you ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " use ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "[", "t", "]"}], TraditionalForm]]],
 " in all of your subsequent applications:"
}], "Text"],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"3", "*", 
       RowBox[{"y", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "\[Equal]", "2"}]}], 
    "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"y", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "t"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{{3.3898418024986553`*^9, 3.3898418149536552`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"y", "[", "t", "]"}], " ", "/.", 
  RowBox[{
   RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
   RowBox[{"2", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"3", " ", "t"}]]}]}]}]], "Input"],

Cell[TextData[{
 "\nHowever, the substitution for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "[", "t", "]"}], TraditionalForm]]],
 " must always be made first before any subsequent operation can be \
performed.\nFor example, the following procedure works correctly (i.e. ",
 StyleBox["substitute",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["differentiate",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["second",
  FontVariations->{"Underline"->True}],
 "):"
}], "Text",
 CellChangeTimes->{3.5232909194496284`*^9}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "t"], " ", 
  RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], " ", "/.", " ", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"3", " ", "t"}]]}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.3898418604156556`*^9, 3.389841871728656*^9}}],

Cell[TextData[{
 "\nWhile the following procedure will ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " work correctly (i.e. differentiate first and substitute second):"
}], "Text",
 CellChangeTimes->{3.523290935819792*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", "t"], 
   RowBox[{"(", 
    RowBox[{"y", "[", "t", "]"}], ")"}]}], " ", "/.", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
   RowBox[{"2", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"3", " ", "t"}]]}]}]}]], "Input",
 CellChangeTimes->{{3.3898418887776556`*^9, 3.3898418890226555`*^9}}],

Cell[TextData[{
 "\nOn the other hand, consider solving the ODE using a named pure function: ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.5232909610400443`*^9}],

Cell[BoxData[
 RowBox[{"soln2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"3", 
        RowBox[{"y", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "\[Equal]", "2"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "y", ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "t"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3898419157706556`*^9, 3.3898419359926558`*^9}}],

Cell[TextData[{
 "\nThe answer appears to be in a more complicated form.  \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"3", " ", "t"}]]}]}], "]"}]}], TraditionalForm]]],
 "\n\t\nHowever, it is actually much easier to work with.\n\nFor example, the \
name of the argument is arbitrary:"
}], "Text",
 CellChangeTimes->{{3.3898419651506557`*^9, 3.3898419819706554`*^9}, 
   3.523290968320117*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"y", "[", "t", "]"}], " ", "/.", " ", 
  RowBox[{"y", "\[Rule]", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "t", "}"}], ",", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"3", " ", "t"}]]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.3898420054746556`*^9, 3.3898420284356556`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"y", "[", "z", "]"}], " ", "/.", " ", 
  RowBox[{"y", "\[Rule]", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "t", "}"}], ",", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"3", " ", "t"}]]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{3.3898420429916553`*^9}],

Cell["\<\
The order in which you substitute and differentiate is irrelevant.
Substitute first and differentiate second:\
\>", "Text",
 CellChangeTimes->{{3.389842072563656*^9, 3.3898421201796556`*^9}}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "t"], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], " ", "/.", "  ", 
    RowBox[{"y", "\[Rule]", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", "t", "}"}], ",", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"3", " ", "t"}]]}]}], "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{3.389842060384656*^9}],

Cell["\<\

Differentiate first and substitute second:\
\>", "Text",
 CellChangeTimes->{{3.389842126858656*^9, 3.389842168794656*^9}, 
   3.523291008220516*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", "t"], 
   RowBox[{"(", 
    RowBox[{"y", "[", "t", "]"}], ")"}]}], " ", "/.", "  ", 
  RowBox[{"y", "\[Rule]", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "t", "}"}], ",", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"3", " ", "t"}]]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{3.389842178077656*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"y", "'"}], "[", "t", "]"}], " ", "/.", "  ", 
  RowBox[{"y", "\[Rule]", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "t", "}"}], ",", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"3", " ", "t"}]]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{3.3898421869336557`*^9}],

Cell[TextData[{
 "As a consequence, advanced ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " programmers almost always prefer to work with the pure function like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "t", "}"}], ",", 
        RowBox[{"2", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"3", " ", "t"}]]}]}], "]"}], "   ", "or", "   ", "2", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"3", " ", "#"}]]}], "&"}]}], TraditionalForm]]],
 "  rather than a function of a specific argument ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "[", "t", "]"}], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{{3.389842232077656*^9, 3.3898423141146555`*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Exercises:", "Title"],
 "  Advanced Lesson 12 "
}], "Section"],

Cell["\<\
Your Name:

Your Math Class:\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold"],

Cell[TextData[{
 "1:\t Evaluate:\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["#", "2"], "&"}], ")"}],
   FontWeight->"Bold"]]],
 "\t\t for the value 3\n\t Evaluate:\tSin[ # ]&\t\t for the value \[Pi]/2\n\t \
Evaluate:\t{ #,  Sin[ # ] }&\t for the value \[Pi]/2\n\t Evaluate:\t{ #1,  \
Sin[ #2 ] }&\t for the value (1, \[Pi]/2)\n\t Evaluate:\t\
(#\[GreaterEqual]10)&\t\t for the value 12\n\t Evaluate:\t\
(#\[GreaterEqual]10)&\t\t for the value 8\n\t Evaluate:\t\
(#1\[GreaterEqual]#2)&\t\t for the value (12, 8)\n\t Evaluate:\t(#1\
\[GreaterEqual]#2)&\t\t for the value (8, 12)"
}], "Text"],

Cell["\<\
2:  Write the commands necessary to select all of the points from the data set:
\tdata={4, 65, 12, 4, 8, 21, 4};
 that satisfy the criterion of being \[LessEqual] 20 using a pure function \
and the Select command.\
\>", "Text"],

Cell["\<\
3:  Write the commands necessary to select all of the points from the data set:
\tdata={4, 65, 12, 4, 8, 21, 4};
 that satisfy the criteria of being \[GreaterEqual] 5 and \[LessEqual] 20 \
using a pure function and the Select command.\
\>", "Text"],

Cell["\<\
4:  Write the commands necessary to map a pure function onto the set of data \
points:
\tdata={4, 65, 12, 4, 8, 21, 4};
 that evaluates the ordered pairs:  {x, f[x]}.\
\>", "Text"],

Cell["\<\
5:  Write the commands necessary to select all of the points from the data set:
\tnewData={{1,4},{3,2},{2,2},{5,1},{2,5}}; 
 that satisfy the criterion of having its first coordinate squared being \
\[LessEqual] the second coordinate using a pure function and the Select \
command.\
\>", "Text"],

Cell[TextData[{
 "6:  Evaluate the following lines one line at a time.\n\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{"Clear", "[", 
    RowBox[{"f", ",", "x"}], "]"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], "[", "x", "]"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"f", "'"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"Sin", "'"}], "[", "x", "]"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"Sin", "'"}], TraditionalForm]}]],
 " "
}], "Text"],

Cell[TextData[{
 StyleBox["Print",
  FontSize->14,
  FontWeight->"Bold"],
 StyleBox[" your homework exercises",
  FontSize->14],
 ".\n",
 StyleBox["But do ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["NOT",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" print the above lesson along with the exercises!",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.3903491193324003`*^9, 3.3903491706104*^9}, {
   3.3903492171244*^9, 3.3903492363613997`*^9}, {3.3903493057854*^9, 
