Notebook[{
Cell["\<\
Advanced Lesson 12 - Exercises: Pure Functions
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"567ec1b8-a2ec-4a7b-85a7-e6c257b65c2e"],

Cell["1: Applying pure functions to values", "Section",ExpressionUUID->"563a4f51-c2cf-4ac2-8fdd-acfad8b83f30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "f", ",", "data", ",", "newData"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["#1", "2"], "&"}], ")"}], "[", "3", "]"}]}], "Input",Expres\
sionUUID->"48d306c2-4ba6-4665-ab7b-7735f2440429"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Sin", "[", "#1", "]"}], "&"}], ")"}], "[", 
  FractionBox["\[Pi]", "2"], "]"}]], "Input",ExpressionUUID->"656fbfad-eb75-\
4084-b27f-85f3bf8b2127"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#1", ",", 
      RowBox[{"Sin", "[", "#1", "]"}]}], "}"}], "&"}], ")"}], "[", 
  FractionBox["\[Pi]", "2"], "]"}]], "Input",ExpressionUUID->"0fffd94b-d5a3-\
4215-b0b5-eac2e6c1c533"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#1", ",", 
      RowBox[{"Sin", "[", "#2", "]"}]}], "}"}], "&"}], ")"}], "[", 
  RowBox[{"1", ",", 
   FractionBox["\[Pi]", "2"]}], "]"}]], "Input",ExpressionUUID->"974d7a3a-\
0723-4631-a893-b71b9febd0a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"#1", "\[GreaterEqual]", "10"}], "&"}], ")"}], "[", "12", 
  "]"}]], "Input",ExpressionUUID->"67ca2f71-55a9-421c-9f75-b26c2901c9bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"#1", "\[GreaterEqual]", "10"}], "&"}], ")"}], "[", "8", 
  "]"}]], "Input",ExpressionUUID->"7831352d-3163-4fc4-9129-10b0b3d42b3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"#1", "\[GreaterEqual]", "#2"}], "&"}], ")"}], "[", 
  RowBox[{"12", ",", "8"}], "]"}]], "Input",ExpressionUUID->"162c35f2-578c-\
40d4-b475-2213e18726f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"#1", "\[GreaterEqual]", "#2"}], "&"}], ")"}], "[", 
  RowBox[{"8", ",", "12"}], "]"}]], "Input",ExpressionUUID->"334e254d-137b-\
4218-8f53-1ae359a98dc7"],

Cell["2: Selecting the points at most 20", "Section",ExpressionUUID->"790c6969-c1e8-4ae2-b756-c9a5c719a171"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", 
    RowBox[{
    "4", ",", "65", ",", "12", ",", "4", ",", "8", ",", "21", ",", "4"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Select", "[", 
  RowBox[{"data", ",", 
   RowBox[{
    RowBox[{"#1", "\[LessEqual]", "20"}], "&"}]}], "]"}]}], "Input",Expression\
UUID->"ee82c060-afa5-434e-a7fc-9882d73bcb48"],

Cell["3: Selecting the points between 5 and 20 inclusive", "Section",ExpressionUUID->"60b18105-77bf-48f7-815b-608bdfe6707b"],

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{"data", ",", 
   RowBox[{
    RowBox[{"5", "\[LessEqual]", "#1", "\[LessEqual]", "20"}], "&"}]}], 
  "]"}]], "Input",ExpressionUUID->"219b3a04-3d81-44bb-a48b-10d1ad1c8511"],

Cell["4: Mapping to ordered pairs", "Section",ExpressionUUID->"e5fe5915-fec6-418f-a3c7-1e2af0f9bb38"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "f", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#1", ",", 
      RowBox[{"f", "[", "#1", "]"}]}], "}"}], "&"}], ")"}], "/@", 
  "data"}]}], "Input",ExpressionUUID->"2522bcbb-9d34-427c-9dcf-f6845581e2ce"],

Cell["\<\
5: Selecting points whose first coordinate squared is at most the second\
\>", "Section",ExpressionUUID->"aaead16d-cf0a-45d2-b27d-3eb07624ec8a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"newData", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "5"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Select", "[", 
  RowBox[{"newData", ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
      "2"], "\[LessEqual]", 
     RowBox[{"#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
    "&"}]}], "]"}]}], "Input",ExpressionUUID->"8495bb3b-24ee-4927-8b0c-\
a2dc11c1e394"],

Cell["6: Derivatives as pure functions", "Section",ExpressionUUID->"801e6855-b442-488b-83a7-f6626c16c542"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  SuperscriptBox["f", "\[Prime]",
   MultilineFunction->None], "[", "x", "]"}]}], "Input",ExpressionUUID->\
"7cc1a015-c6ed-4195-bb59-dca15acdb649"],

Cell[BoxData[
 SuperscriptBox["f", "\[Prime]",
  MultilineFunction->None]], "Input",ExpressionUUID->"7641d3db-525e-4235-b550-\
93f2777dd921"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["Sin", "\[Prime]",
   MultilineFunction->None], "[", "x", "]"}]], "Input",ExpressionUUID->\
"d5bd4915-061d-4549-96ca-5a0fafba54a9"],

Cell[BoxData[
 SuperscriptBox["Sin", "\[Prime]",
  MultilineFunction->None]], "Input",ExpressionUUID->"7aea3ce6-800d-46d9-a331-\
86e8f1a1f4af"]
},
