Notebook[{
Cell["\<\
Advanced Lesson 5 - Exercises: Lists
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"db76645c-815c-4640-8335-ba4c8a463b84"],

Cell["\<\
Every list produced below is named, so that later exercises can refer to the
list built in an earlier exercise instead of rebuilding it.\
\>", "Text",ExpressionUUID->"533d58ff-0cdb-42cb-aabc-bd45dc51e3a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "a", ",", "x", ",", "i", ",", "j", ",", "list3", ",", "list4", ",", "mat5",
     ",", "courseNumbers", ",", "courseNames", ",", "me"}], "]"}], 
  ";"}]], "Input",ExpressionUUID->"100793d6-3836-4c90-8c93-d304d77ac177"],

Cell["\<\
1: A list holding a name (string), an age (integer) and a major (symbols)\
\>", "Section",ExpressionUUID->"055bc00e-bad4-46ce-aae5-5b6e99c2cce5"],

Cell[BoxData[
 RowBox[{"me", "=", 
  RowBox[{"{", 
   RowBox[{"\"\<Mikey Ferguson\>\"", ",", "27", ",", "mathematics"}], 
   "}"}]}]], "Input",ExpressionUUID->"53068fd9-8e0c-4790-9dcf-d8fa38dd419c"],

Cell["\<\
2: A list of lists - course numbers (integers) and course names (symbols)\
\>", "Section",ExpressionUUID->"8062acb7-2853-4666-bd41-7500cf56b4c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"courseNumbers", "=", 
   RowBox[{"{", 
    RowBox[{"7013", ",", "7023", ",", "7113"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"courseNames", "=", 
   RowBox[{"{", 
    RowBox[{
    "advancedMathematicalModeling", ",", "realAnalysis", ",", 
     "numericalAnalysis"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"{", 
   RowBox[{"courseNumbers", ",", "courseNames"}], "}"}], "]"}]}], "Input",Expr\
essionUUID->"1e3f2b41-8953-4fd1-9e66-8778b8d486ad"],

Cell["3: The integers from 0 to 20, via Table", "Section",ExpressionUUID->"36053c43-6ad3-42f8-ab15-e5ef3e6ca891"],

Cell[BoxData[
 RowBox[{"list3", "=", 
  RowBox[{"Table", "[", 
   RowBox[{"i", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "20"}], "}"}]}], "]"}]}]], "Input",Expression\
UUID->"846e00c7-7943-4282-9942-4343d4d97b22"],

Cell["4: The even integers from 0 to 20, via Table", "Section",ExpressionUUID->"a085c8ed-409e-40cd-ac9f-b54eb6662fdb"],

Cell[BoxData[
 RowBox[{"list4", "=", 
  RowBox[{"Table", "[", 
   RowBox[{"i", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "20", ",", "2"}], "}"}]}], "]"}]}]], "Input",\
ExpressionUUID->"b035b5c4-e963-4023-a51f-38e331cb1871"],

Cell["\<\
5: A 4x5 matrix with entries Sin[i] Cos[j], displayed with MatrixForm\
\>", "Section",ExpressionUUID->"7e01e049-402d-431f-a9aa-241f38294cde"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mat5", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "i", "]"}], " ", 
      RowBox[{"Cos", "[", "j", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "mat5", "]"}]}], "Input",ExpressionUUID->\
"bb8fd7d2-6f79-4b57-889a-565ed83cd482"],

Cell["6: Sorting the course numbers and the course names", "Section",ExpressionUUID->"4f08744b-88d6-4d7d-a4b8-31076cb4cc7b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Sort", "[", "courseNumbers", "]"}], ",", 
   RowBox[{"Sort", "[", "courseNames", "]"}]}], "}"}]], "Input",ExpressionUUID\
->"40eb6be4-fd13-49ca-a429-fa1a9c4de899"],

Cell["7: Reverse of the list from Exercise 3", "Section",ExpressionUUID->"904ef1af-2308-479c-a0e0-425aec74344f"],

Cell[BoxData[
 RowBox[{"Reverse", "[", "list3", "]"}]], "Input",ExpressionUUID->"cec6b4de-c8b5-4902-a0f3-8bc1ce8ca572"],

Cell["\<\
8: Drop the first three, then the last three, elements of the Exercise 3 list\
\
\>", "Section",ExpressionUUID->"637f0786-3b44-47eb-9728-691699ce02a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Drop", "[", 
    RowBox[{"list3", ",", "3"}], "]"}], ",", 
   RowBox[{"Drop", "[", 
    RowBox[{"list3", ",", 
     RowBox[{"-", "3"}]}], "]"}]}], "}"}]], "Input",ExpressionUUID->"9a5d17ab-\
65b4-4f54-a2e7-4de1e339282e"],

Cell["\<\
9: Take the first three, the last three, and elements 3, 4 and 11\
\>", "Section",ExpressionUUID->"5c215b96-0946-4d5a-ab1e-fad46fcd4cd3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{"list3", ",", "3"}], "]"}], ",", 
   RowBox[{"Take", "[", 
    RowBox[{"list3", ",", 
     RowBox[{"-", "3"}]}], "]"}], ",", 
   RowBox[{"list3", "\[LeftDoubleBracket]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4", ",", "11"}], "}"}], "\[RightDoubleBracket]"}]}], 
  "}"}]], "Input",ExpressionUUID->"13841ecf-db9d-4f38-a283-ef40d8a58cec"],

Cell["\<\
10: Insert \"Fun and games\" as the second element of the course-name list\
\>", "Section",ExpressionUUID->"a598756e-b227-4117-a7fe-d9951004a2f3"],

Cell[BoxData[
 RowBox[{"Insert", "[", 
  RowBox[{"courseNames", ",", "\"\<Fun and games\>\"", ",", "2"}], 
  "]"}]], "Input",ExpressionUUID->"70495d11-c3e8-4b88-9993-6ed89878708f"],

Cell["11: Replace the second course name with \"Fun and games\"", "Section",ExpressionUUID->"7b1bd886-3666-4f38-b5be-21ef3deeeb18"],

Cell[BoxData[
 RowBox[{"ReplacePart", "[", 
  RowBox[{"courseNames", ",", 
   RowBox[{"2", "\[Rule]", "\"\<Fun and games\>\""}]}], "]"}]], "Input",Expres\
sionUUID->"e927c2ee-1cd0-4fb2-9b98-858120cc2a1d"],

Cell["12: Length of the Exercise 4 list", "Section",ExpressionUUID->"a53bee88-8d27-41b6-8875-42cab798ab18"],

Cell[BoxData[
 RowBox[{"Length", "[", "list4", "]"}]], "Input",ExpressionUUID->"b64b6b2b-8318-4e9e-b67f-653546556119"],

Cell["13: Dimensions of the Exercise 5 list of lists", "Section",ExpressionUUID->"608d2bb2-4b9f-46b1-af4f-afc194f56c23"],

Cell[BoxData[
 RowBox[{"Dimensions", "[", "mat5", "]"}]], "Input",ExpressionUUID->"dd1179af-26c1-4473-aa82-1f49494274cf"],

Cell["\<\
14: Intersection of the Exercise 3 and Exercise 4 lists, in ColumnForm\
\>", "Section",ExpressionUUID->"aa39f971-3a4f-4eb1-b1ff-3985da57ed7f"],

Cell[BoxData[
 RowBox[{"ColumnForm", "[", 
  RowBox[{"list3", "\[Intersection]", "list4"}], "]"}]], "Input",ExpressionUUI\
D->"4ea9c5d4-378e-4d20-8367-6c88af2866f4"],

Cell["\<\
15: Join of the Exercise 3 and Exercise 4 lists, in ColumnForm\
\>", "Section",ExpressionUUID->"92cbf355-be2b-4799-9609-b2b0dddbd1d6"],

Cell[BoxData[
 RowBox[{"ColumnForm", "[", 
  RowBox[{"Join", "[", 
   RowBox[{"list3", ",", "list4"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"caf8de27-6fb1-46ee-bc21-a669583a3443"],

Cell["16: Partition the Exercise 3 list into sublists of length 4", "Section",ExpressionUUID->"ad95ef31-228d-46ec-9db9-02bb4a9552d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"list16", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{"list3", ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", "list16", "]"}]}], "Input",ExpressionUUID->\
"2d8531ff-09c7-449f-917a-bd384801fc03"],

Cell["\<\
17: Partition into three sublists, each holding sublists of length 2\
\>", "Section",ExpressionUUID->"1b1a554d-f116-4330-a641-d9217367245c"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"Partition", "[", 
   RowBox[{
    RowBox[{"Partition", "[", 
     RowBox[{"list3", ",", "2"}], "]"}], ",", "3"}], "]"}], "]"}]], "Input",Ex\
pressionUUID->"0e28bf3a-aec2-4403-9cc8-8f66bf3bf45b"],

Cell["\<\
18: Part extraction - third element of Exercise 3, second element of Exercise \
16\
\>", "Section",ExpressionUUID->"b145a1fc-e8a6-41a5-8d9b-8d831d058997"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"list3", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", 
   RowBox[{"list16", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
   "}"}]], "Input",ExpressionUUID->"723e2b74-90de-43a7-ab58-b635801a1d78"],

Cell["19: The entry in row 2, column 3 of the Exercise 5 matrix", "Section",ExpressionUUID->"14c7035f-cc6e-4367-882b-57a1b5701ae7"],

Cell[BoxData[
 RowBox[{"mat5", "\[LeftDoubleBracket]", 
  RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}]], "Input",ExpressionUUID->\
"1b367722-f4d1-4c74-bf0f-460f038a3d8c"],

Cell["20: The second row of the Exercise 5 matrix", "Section",ExpressionUUID->"5abc4ce8-2157-4859-9b55-de80e6f3677e"],

Cell[BoxData[
 RowBox[{"mat5", "\[LeftDoubleBracket]", "2", 
  "\[RightDoubleBracket]"}]], "Input",ExpressionUUID->"97002a6a-69a2-4bd4-\
bf3c-6668380da4da"],

Cell["\<\
21: The second column of the Exercise 5 matrix, using Part alone\
\>", "Section",ExpressionUUID->"acd449fa-6549-4792-8049-0ebd00ae4673"],

Cell[BoxData[
 RowBox[{"mat5", "\[LeftDoubleBracket]", 
  RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]], "Input",ExpressionUUI\
D->"87782d1f-6af8-4667-8bae-ae3e6cb0cdab"],

Cell["22: Exp applied directly to a mixed list", "Section",ExpressionUUID->"3b56cde9-c757-4bec-adc5-d6673f56bd0d"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  RowBox[{"{", 
   RowBox[{
   "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", "\[Pi]"}], 
   "}"}]]], "Input",ExpressionUUID->"0c572edf-5e63-4c53-9de8-7f49fedc9499"],

Cell["\<\
23: Log over the same list via Map, then N applied to the result\
\>", "Section",ExpressionUUID->"04eb543a-0889-45b8-b8e8-ea2eb90eebfb"],

Cell[BoxData[
 RowBox[{"logs", "=", 
  RowBox[{"Log", "/@", 
   RowBox[{"{", 
    RowBox[{
    "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", "\[Pi]"}], 
    "}"}]}]}]], "Input",ExpressionUUID->"9076c701-9c09-4bcf-8a28-\
469d83d925fb"],

Cell[BoxData[
 RowBox[{"N", "[", "logs", "]"}]], "Input",ExpressionUUID->"a67c3fa6-d74e-4d01-9dec-63e5eabca656"],

Cell["24: Apply Plus to the Exercise 4 list", "Section",ExpressionUUID->"500087b1-408a-4183-bba1-2f1a70c536d9"],

Cell[BoxData[
 RowBox[{"Plus", "@@", "list4"}]], "Input",ExpressionUUID->"bebab79d-8a7c-4a90-8670-832e7341151d"],

Cell["25: Flatten the Exercise 5 matrix", "Section",ExpressionUUID->"e1bd5e88-a134-4f10-9870-eed0c38f1e60"],

Cell[BoxData[
 RowBox[{"Flatten", "[", "mat5", "]"}]], "Input",ExpressionUUID->"6724bbee-369c-4df2-9a82-11f28cbb19d4"]
},
WindowSize->{1100, 850},
