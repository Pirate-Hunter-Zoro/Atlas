Notebook[{
Cell[TextData[{
 StyleBox[" Exercises:", "Title"],
 "  Advanced Lesson 5 "
}], "Section",ExpressionUUID->"f4271d72-2c24-4063-a0a5-9c65c072c181"],

Cell["\<\
Your Name:  Mikey Ferguson

Your Math Class:  MATH 7013 - Advanced Mathematical Modeling\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"0e42fc6f-f0b9-4248-aa65-43d4b5a67442"],

Cell[TextData[{
 StyleBox["Note: Some of the following exercises are expressed in every day \
mathematical notation rather than proper ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation.  You ", "Subsubsection"],
 StyleBox["MUST", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" convert every day notation into ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation for your code to work properly.  For example:\n\n\t\
Equations ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be changed from  \"=\"  to  \"==\"  to work correctly (i.e. ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "\[Equal]", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]],ExpressionUUID->
  "53f54aef-a8d5-41e1-a304-24b25d1d9ea8"],
 StyleBox["  not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "=", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]],ExpressionUUID->
  "3d43bec2-9084-4832-8af3-7586bf3a7977"],
 StyleBox["  ).  \n\tFunctions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be expressed as  f[x]  and  not  f(x)  to work correctly.  \n\t\
Functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be defined using  \"_\"  to work correctly (i.e.  ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]],ExpressionUUID->"d6a92f65-6cb7-40da-83a5-f8d9c7fc4568"],
 StyleBox["  and not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]],ExpressionUUID->"31b2be2d-ace9-4c47-8b67-ad9d93bb8729"],
 StyleBox[").\n\t", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" start with a capital (i.e.  Sin[x]  not  sin[x]).\n\t", 
  "Subsubsection"],
 StyleBox["Your", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" functions should start with a lower case letter (i.e.  f[x]  not  \
F[x]).\n\tSpecial symbols ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be entered correctly (i.e.  ", "Subsubsection"],
 StyleBox["\[ExponentialE]", "Subsection"],
 StyleBox["  from the palette and not  e ).\n\t\nThese exercises begin your \
training in making this conversion automatically.\n", "Subsubsection"]
}], "Text",
 CellChangeTimes->{{3.39064873246*^9, 3.390649069177*^9}, {3.390649104818*^9, 
   3.390649156885*^9}, {3.390649215119*^9, 3.39064939362*^9}, {
   3.390649427467*^9, 3.390649437834*^9}, {3.3906856676331425`*^9, 
   3.3906858924611425`*^9}, {3.3906859679691424`*^9, 3.390686080823142*^9}, {
   3.390686138196142*^9, 3.390686244913142*^9}, 3.390686344335142*^9, {
   3.3906897169261427`*^9, 3.3906898397271423`*^9}, {3.3906898702421427`*^9, 
   3.3906898773081427`*^9}, {3.3906929625171423`*^9, 
   3.3906929634941425`*^9}},ExpressionUUID->"9faecef8-9934-4e79-ad5d-\
92eb8561e5df"],

Cell[TextData[{
 "Remember to clear all variables that you will use below:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Clear", "[", "          ", "...", "             ", "]"}], 
   TraditionalForm]],ExpressionUUID->"eb9f5fb7-31ad-4431-9208-f5ebd7e09e5b"]
}], "Text",
 CellChangeTimes->{{3.3906923197301426`*^9, 3.3906923812721424`*^9}, {
  3.3906924809361424`*^9, 3.3906924908791423`*^9}, {3.3906927825761423`*^9, 
  3.3906927911761427`*^9}},ExpressionUUID->"7c4bba67-85fd-4aa8-9703-\
1a0d670f8d70"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "a", ",", "x", ",", "i", ",", "j", ",", "list3", ",", "list4", ",", "mat5",
     ",", "courseNumbers", ",", "courseNames", ",", "me"}], "]"}], 
  ";"}]], "Input",ExpressionUUID->"100793d6-3836-4c90-8c93-d304d77ac177"],

Cell["\<\
  1:  Type in a list that contains your name (as a string), your age (as an \
integer) and your major (as symbols i.e. variables).  Evaluate this \
expression.\
\>", "Text",ExpressionUUID->"e3a8c76f-9a72-485a-b5f4-e6f12a71a3a9"],

Cell[BoxData[
 RowBox[{"me", "=", 
  RowBox[{"{", 
   RowBox[{"\"\<Mikey Ferguson\>\"", ",", "27", ",", "mathematics"}], 
   "}"}]}]], "Input",ExpressionUUID->"53068fd9-8e0c-4790-9dcf-d8fa38dd419c"],

Cell["\<\
  2:  Type in a list of lists which contains a list of the course numbers \
that you are taking this semester (as integers), a list of the corresponding \
course names (as symbols i.e. variables).  Display this list using: \
TableForm.  Evaluate this expression.\
\>", "Text",ExpressionUUID->"d5ad0e77-4918-4bd2-96ea-b4018be7a52d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"courseNumbers", "=", 
   RowBox[{"{", 
    RowBox[{"7013", ",", "7023", ",", "7113"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"courseNames", "=", 
   RowBox[{"{", 
    RowBox[{
    "advancedMathematicalModeling", ",", "realAnalysis", ",", 
     "numericalAnalysis"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"{", 
   RowBox[{"courseNumbers", ",", "courseNames"}], "}"}], "]"}]}], "Input",Expr\
essionUUID->"1e3f2b41-8953-4fd1-9e66-8778b8d486ad"],

Cell["\<\
  3:  Generate a list of integers from 0 to 20 using the Table command.\
\>", "Text",ExpressionUUID->"80247eae-b8d7-4ccd-9b65-3f33d56eff21"],

Cell[BoxData[
 RowBox[{"list3", "=", 
  RowBox[{"Table", "[", 
   RowBox[{"i", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "20"}], "}"}]}], "]"}]}]], "Input",Expression\
UUID->"846e00c7-7943-4282-9942-4343d4d97b22"],

Cell["\<\
  4:  Generate a list of EVEN integers from 0 to 20 using the Table command.\
\>", "Text",ExpressionUUID->"50a6a358-c854-4a8c-8610-d56f487dc935"],

Cell[BoxData[
 RowBox[{"list4", "=", 
  RowBox[{"Table", "[", 
   RowBox[{"i", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "20", ",", "2"}], "}"}]}], "]"}]}]], "Input",\
ExpressionUUID->"b035b5c4-e963-4023-a51f-38e331cb1871"],

Cell["\<\
  5:  Part 1:  Generate a list of lists using the Table command which \
represents a 4x5 matrix containing the elements Sin[i]*Cos[j].  
       Part 2:  Display this list of lists using:  MatrixForm.  Evaluate this \
expression.\
\>", "Text",ExpressionUUID->"4465b06a-c8a7-4c02-8db8-1f52d630c362"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mat5", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "i", "]"}], " ", 
      RowBox[{"Cos", "[", "j", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "mat5", "]"}]}], "Input",ExpressionUUID->\
"bb8fd7d2-6f79-4b57-889a-565ed83cd482"],

Cell["\<\
  6:  Sort the list containing your course numbers.  Sort the list containing \
the corresponding course names.\
\>", "Text",ExpressionUUID->"dbf998b7-6b6d-49ca-af3e-6328fa960d37"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Sort", "[", "courseNumbers", "]"}], ",", 
   RowBox[{"Sort", "[", "courseNames", "]"}]}], "}"}]], "Input",ExpressionUUID\
->"40eb6be4-fd13-49ca-a429-fa1a9c4de899"],

Cell["  7:  Reverse the list generated in Exercise 3.", "Text",ExpressionUUID->"0a5f6e29-054b-4b21-b58b-be9eb25f0eb8"],

Cell[BoxData[
 RowBox[{"Reverse", "[", "list3", "]"}]], "Input",ExpressionUUID->"cec6b4de-c8b5-4902-a0f3-8bc1ce8ca572"],

Cell["\<\
  8:  Drop the first three elements from the list generated in Exercise 3.  \
Drop the last three elements from the list generated in Exercise 3.\
\>", "Text",ExpressionUUID->"f3efa551-adf8-4838-a27f-fd02d08edd6d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Drop", "[", 
    RowBox[{"list3", ",", "3"}], "]"}], ",", 
   RowBox[{"Drop", "[", 
    RowBox[{"list3", ",", 
     RowBox[{"-", "3"}]}], "]"}]}], "}"}]], "Input",ExpressionUUID->"9a5d17ab-\
65b4-4f54-a2e7-4de1e339282e"],

Cell["\<\
  9:  Take the first three elements from the list generated in Exercise 3.  \
Take the last three elements from the list generated in Exercise 3.  Take \
elements  3, 4, and 11 from the list generated in Exercise 3.\
\>", "Text",ExpressionUUID->"506ed966-802c-48da-b98c-f00bbc816160"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{"list3", ",", "3"}], "]"}], ",", 
   RowBox[{"Take", "[", 
    RowBox[{"list3", ",", 
     RowBox[{"-", "3"}]}], "]"}], ",", 
   RowBox[{"list3", "\[LeftDoubleBracket]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4", ",", "11"}], "}"}], "\[RightDoubleBracket]"}]}], 
  "}"}]], "Input",ExpressionUUID->"13841ecf-db9d-4f38-a283-ef40d8a58cec"],

Cell["\<\
10:  Insert a second element \"Fun and games\" into the list of your course \
names in Exercise 2. \
\>", "Text",ExpressionUUID->"255bf9bc-15d5-41df-8656-9c58da3b37e7"],

Cell[BoxData[
 RowBox[{"Insert", "[", 
  RowBox[{"courseNames", ",", "\"\<Fun and games\>\"", ",", "2"}], 
  "]"}]], "Input",ExpressionUUID->"70495d11-c3e8-4b88-9993-6ed89878708f"],

Cell["\<\
11:  Replace the second course name in the list of your course names in \
Exercise 2 with \"Fun and games\". \
\>", "Text",ExpressionUUID->"b0b8ec48-6c41-4fa0-9ac5-f908063e58c9"],

Cell[BoxData[
 RowBox[{"ReplacePart", "[", 
  RowBox[{"courseNames", ",", 
   RowBox[{"2", "\[Rule]", "\"\<Fun and games\>\""}]}], "]"}]], "Input",Expres\
sionUUID->"e927c2ee-1cd0-4fb2-9b98-858120cc2a1d"],

Cell["12:  Determine the length of the list in Exercise 4:", "Text",ExpressionUUID->"d0ff1501-3156-4941-8908-f61bf8740ee7"],

Cell[BoxData[
 RowBox[{"Length", "[", "list4", "]"}]], "Input",ExpressionUUID->"b64b6b2b-8318-4e9e-b67f-653546556119"],

Cell["\<\
13:  Determine the dimensions of the list of lists in Exercise 5:\
\>", "Text",ExpressionUUID->"1804cdd4-c0dc-44ff-bdde-98f33f01dd4b"],

Cell[BoxData[
 RowBox[{"Dimensions", "[", "mat5", "]"}]], "Input",ExpressionUUID->"dd1179af-26c1-4473-aa82-1f49494274cf"],

Cell["\<\
14:  Part 1:  Take the intersection of the lists in exercises 3 and 4.  
       Part 2:  Display this list using: ColumnForm.  Evaluate this \
expression.\
\>", "Text",ExpressionUUID->"e89176b0-5aa0-4edd-a763-710bdd899294"],

Cell[BoxData[
 RowBox[{"ColumnForm", "[", 
  RowBox[{"list3", "\[Intersection]", "list4"}], "]"}]], "Input",ExpressionUUI\
D->"4ea9c5d4-378e-4d20-8367-6c88af2866f4"],

Cell["\<\
15:  Join the lists in exercises 3 and 4.  Display this list using: \
ColumnForm.  Evaluate this expression.\
\>", "Text",ExpressionUUID->"8e5be297-6ca4-4d95-b2e2-52c0c8f08738"],

Cell[BoxData[
 RowBox[{"ColumnForm", "[", 
  RowBox[{"Join", "[", 
   RowBox[{"list3", ",", "list4"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"caf8de27-6fb1-46ee-bc21-a669583a3443"],

Cell["\<\
16:  Partition the list in Exercise 3 to contain lists of length 4.   Display \
this list of lists using: TableForm.  Evaluate this expression.\
\>", "Text",ExpressionUUID->"65629554-2bd1-4add-8060-5b36eb3c4bfb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"list16", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{"list3", ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", "list16", "]"}]}], "Input",ExpressionUUID->\
"2d8531ff-09c7-449f-917a-bd384801fc03"],

Cell["\<\
17:  Partition the list in Exercise 3 to contain lists of length three which \
each contain lists of length 2.   Display this list of lists of lists using:  \
MatrixForm.  Evaluate this expression.\
\>", "Text",ExpressionUUID->"1f78fb54-791a-49bf-a052-fad03c4b38d7"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"Partition", "[", 
   RowBox[{
    RowBox[{"Partition", "[", 
     RowBox[{"list3", ",", "2"}], "]"}], ",", "3"}], "]"}], "]"}]], "Input",Ex\
pressionUUID->"0e28bf3a-aec2-4403-9cc8-8f66bf3bf45b"],

Cell["\<\
18:  Using the [[...]] notation, extract the third element from the list in \
Exercise 3 and the second element from the list of lists in Exercise 16.\
\>", "Text",ExpressionUUID->"725efaf3-10e9-4f75-b523-6261801adbd0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"list3", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", 
   RowBox[{"list16", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
   "}"}]], "Input",ExpressionUUID->"723e2b74-90de-43a7-ab58-b635801a1d78"],

Cell["\<\
19:  Using the [[...]] notation, extract the element corresponding to the \
second row and third column from the list of lists in Exercise 5.\
\>", "Text",ExpressionUUID->"e730538b-642f-4ca5-939a-53420667399f"],

Cell[BoxData[
 RowBox[{"mat5", "\[LeftDoubleBracket]", 
  RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}]], "Input",ExpressionUUID->\
"1b367722-f4d1-4c74-bf0f-460f038a3d8c"],

Cell["\<\
20:  Using the [[...]] notation, extract the second row from the list of \
lists in Exercise 5.\
\>", "Text",ExpressionUUID->"11843fbf-fd5b-41f9-bbc4-a7d8adc6b867"],

Cell[BoxData[
 RowBox[{"mat5", "\[LeftDoubleBracket]", "2", 
  "\[RightDoubleBracket]"}]], "Input",ExpressionUUID->"97002a6a-69a2-4bd4-\
bf3c-6668380da4da"],

Cell["\<\
21:  It is possible to use JUST the [[...]] notation to extract the second \
column from the list of lists in Exercise 5.  You may have to look up the \
Part command in Help.\
\>", "Text",ExpressionUUID->"bce6ba74-c482-4639-9669-c32d163d8956"],

Cell[BoxData[
 RowBox[{"mat5", "\[LeftDoubleBracket]", 
  RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]], "Input",ExpressionUUI\
D->"87782d1f-6af8-4667-8bae-ae3e6cb0cdab"],

Cell[TextData[{
 "22:  Evaluate directly:",
 StyleBox[" ",
  FontSize->14],
 Cell[BoxData[
  RowBox[{" ", 
   StyleBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", 
       "\[Pi]"}], "}"}]],
    FontWeight->"Bold"]}]],
  FontSize->16,ExpressionUUID->"19b0227a-1f9b-4853-8c27-4538e748da70"]
}], "Text",ExpressionUUID->"4c8be698-583d-44f4-b199-9e57ef3bc7b9"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  RowBox[{"{", 
   RowBox[{
   "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", "\[Pi]"}], 
   "}"}]]], "Input",ExpressionUUID->"0c572edf-5e63-4c53-9de8-7f49fedc9499"],

Cell[TextData[{
 "23:  Evaluate:  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Log", "[", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", "\[Pi]"}],
      "}"}], "]"}],
   FontWeight->"Bold"]],ExpressionUUID->
  "1c3d8a51-c591-4852-b659-1fb97086b624"],
 "   ",
 StyleBox["indirectly",
  FontVariations->{"Underline"->True}],
 " by using the Map command.  Next, directly obtain the list of approximate \
real numerical values for the previous result using the  N Command."
}], "Text",ExpressionUUID->"5b241ed9-29a2-4696-9e4f-3171feed179b"],

Cell[BoxData[
 RowBox[{"logs", "=", 
  RowBox[{"Log", "/@", 
   RowBox[{"{", 
    RowBox[{
    "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", "\[Pi]"}], 
    "}"}]}]}]], "Input",ExpressionUUID->"9076c701-9c09-4bcf-8a28-\
469d83d925fb"],

Cell[BoxData[
 RowBox[{"N", "[", "logs", "]"}]], "Input",ExpressionUUID->"a67c3fa6-d74e-4d01-9dec-63e5eabca656"],

Cell[TextData[{
 "24:  ",
 StyleBox["Apply",
  FontVariations->{"Underline"->True}],
 " Plus to the list in Exercise 4."
}], "Text",ExpressionUUID->"4407e8e3-7b79-443e-95cd-0b5ec5c8056f"],

Cell[BoxData[
 RowBox[{"Plus", "@@", "list4"}]], "Input",ExpressionUUID->"bebab79d-8a7c-4a90-8670-832e7341151d"],

Cell[TextData[{
 "25:  ",
 StyleBox["Flatten",
  FontVariations->{"Underline"->True}],
 " out the list of lists in Exercise 5."
}], "Text",ExpressionUUID->"f33d5a8a-13cc-4905-9360-ccbdbe08f67e"],

Cell[BoxData[
 RowBox[{"Flatten", "[", "mat5", "]"}]], "Input",ExpressionUUID->"6724bbee-369c-4df2-9a82-11f28cbb19d4"]
},
