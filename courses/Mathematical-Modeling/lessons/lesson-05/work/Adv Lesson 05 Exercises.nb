Notebook[{Cell["Advanced Lesson 5 - Exercises: Lists\nMikey Ferguson\nMATH 7013 - Advanced Mathematical Modeling", "Title"], Cell["Every list produced below is named, so that later exercises can refer to the\nlist built in an earlier exercise instead of rebuilding it.", "Text"], Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"a", ",", "x", ",", "i", ",", "j", ",", "list3", ",", "list4", ",", "mat5", ",", "courseNumbers", ",", "courseNames", ",", "me"}], "]"}], ";"}]], "Input"], Cell["1: A list holding a name (string), an age (integer) and a major (symbols)", "Section"], Cell[BoxData[RowBox[{"me", "=", RowBox[{"{", RowBox[{"\"Mikey Ferguson\"", ",", "27", ",", "mathematics"}], "}"}]}]], "Input"], Cell["The string carries quotation marks, the age is an exact integer, and\n\"mathematics\" is an undefined symbol, so it simply stays as itself.", "Text"], Cell["2: A list of lists - course numbers (integers) and course names (symbols)", "Section"], Cell[BoxData[RowBox[{RowBox[{"courseNumbers", "=", RowBox[{"{", RowBox[{"7013", ",", "7023", ",", "7113"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"courseNames", "=", RowBox[{"{", RowBox[{"advancedMathematicalModeling", ",", "realAnalysis", ",", "numericalAnalysis"}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"TableForm", "[", RowBox[{"{", RowBox[{"courseNumbers", ",", "courseNames"}], "}"}], "]"}]}]], "Input"], Cell["3: The integers from 0 to 20, via Table", "Section"], Cell[BoxData[RowBox[{"list3", "=", RowBox[{"Table", "[", RowBox[{"i", ",", RowBox[{"{", RowBox[{"i", ",", "0", ",", "20"}], "}"}]}], "]"}]}]], "Input"], Cell["4: The even integers from 0 to 20, via Table", "Section"], Cell[BoxData[RowBox[{"list4", "=", RowBox[{"Table", "[", RowBox[{"i", ",", RowBox[{"{", RowBox[{"i", ",", "0", ",", "20", ",", "2"}], "}"}]}], "]"}]}]], "Input"], Cell["5: A 4x5 matrix with entries Sin[i] Cos[j], displayed with MatrixForm", "Section"], Cell[BoxData[RowBox[{RowBox[{"mat5", "=", RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"Sin", "[", "i", "]"}], " ", RowBox[{"Cos", "[", "j", "]"}]}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"MatrixForm", "[", "mat5", "]"}]}]], "Input"], Cell["6: Sorting the course numbers and the course names", "Section"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"Sort", "[", "courseNumbers", "]"}], ",", RowBox[{"Sort", "[", "courseNames", "]"}]}], "}"}]], "Input"], Cell["Sort puts integers in numerical order and symbols in alphabetical order,\nwhich is what \"canonical order\" means for each of those two types.", "Text"], Cell["7: Reverse of the list from Exercise 3", "Section"], Cell[BoxData[RowBox[{"Reverse", "[", "list3", "]"}]], "Input"], Cell["8: Drop the first three, then the last three, elements of the Exercise 3 list", "Section"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"Drop", "[", RowBox[{"list3", ",", "3"}], "]"}], ",", RowBox[{"Drop", "[", RowBox[{"list3", ",", RowBox[{"-", "3"}]}], "]"}]}], "}"}]], "Input"], Cell["9: Take the first three, the last three, and elements 3, 4 and 11", "Section"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"Take", "[", RowBox[{"list3", ",", "3"}], "]"}], ",", RowBox[{"Take", "[", RowBox[{"list3", ",", RowBox[{"-", "3"}]}], "]"}], ",", RowBox[{"list3", "\[LeftDoubleBracket]", RowBox[{"{", RowBox[{"3", ",", "4", ",", "11"}], "}"}], "\[RightDoubleBracket]"}]}], "}"}]], "Input"], Cell["Take handles the two contiguous cases. Elements 3, 4 and 11 are not\ncontiguous, so Take cannot express them; Part with a list of positions can.", "Text"], Cell["10: Insert \"Fun and games\" as the second element of the course-name list", "Section"], Cell[BoxData[RowBox[{"Insert", "[", RowBox[{"courseNames", ",", "\"Fun and games\"", ",", "2"}], "]"}]], "Input"], Cell["11: Replace the second course name with \"Fun and games\"", "Section"], Cell[BoxData[RowBox[{"ReplacePart", "[", RowBox[{"courseNames", ",", RowBox[{"2", "\[Rule]", "\"Fun and games\""}]}], "]"}]], "Input"], Cell["Insert lengthens the list to four entries; ReplacePart leaves it at three\nand overwrites one of them.", "Text"], Cell["12: Length of the Exercise 4 list", "Section"], Cell[BoxData[RowBox[{"Length", "[", "list4", "]"}]], "Input"], Cell["13: Dimensions of the Exercise 5 list of lists", "Section"], Cell[BoxData[RowBox[{"Dimensions", "[", "mat5", "]"}]], "Input"], Cell["14: Intersection of the Exercise 3 and Exercise 4 lists, in ColumnForm", "Section"], Cell[BoxData[RowBox[{"ColumnForm", "[", RowBox[{"list3", "\[Intersection]", "list4"}], "]"}]], "Input"], Cell["Every even integer from 0 to 20 already appears in the list 0 through 20,\nso the intersection is exactly the Exercise 4 list.", "Text"], Cell["15: Join of the Exercise 3 and Exercise 4 lists, in ColumnForm", "Section"], Cell[BoxData[RowBox[{"ColumnForm", "[", RowBox[{"Join", "[", RowBox[{"list3", ",", "list4"}], "]"}], "]"}]], "Input"], Cell["Join concatenates and does not remove duplicates: 21 + 11 = 32 entries.", "Text"], Cell["16: Partition the Exercise 3 list into sublists of length 4", "Section"], Cell[BoxData[RowBox[{RowBox[{"list16", "=", RowBox[{"Partition", "[", RowBox[{"list3", ",", "4"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"TableForm", "[", "list16", "]"}]}]], "Input"], Cell["21 elements do not divide evenly into blocks of 4, so Partition discards\nthe leftover element and returns five sublists.", "Text"], Cell["17: Partition into three sublists, each holding sublists of length 2", "Section"], Cell[BoxData[RowBox[{"MatrixForm", "[", RowBox[{"Partition", "[", RowBox[{RowBox[{"Partition", "[", RowBox[{"list3", ",", "2"}], "]"}], ",", "3"}], "]"}], "]"}]], "Input"], Cell["18: Part extraction - third element of Exercise 3, second element of Exercise 16", "Section"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"list3", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", RowBox[{"list16", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "}"}]], "Input"], Cell["19: The entry in row 2, column 3 of the Exercise 5 matrix", "Section"], Cell[BoxData[RowBox[{"mat5", "\[LeftDoubleBracket]", RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}]], "Input"], Cell["20: The second row of the Exercise 5 matrix", "Section"], Cell[BoxData[RowBox[{"mat5", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], "Input"], Cell["21: The second column of the Exercise 5 matrix, using Part alone", "Section"], Cell[BoxData[RowBox[{"mat5", "\[LeftDoubleBracket]", RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]], "Input"], Cell["All in the first slot means \"every row\", so the result is the column of\nsecond entries. This is Part doing the work that Map would otherwise do.", "Text"], Cell["22: Exp applied directly to a mixed list", "Section"], Cell[BoxData[SuperscriptBox["\[ExponentialE]", RowBox[{"{", RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"string\"", ",", "\[Pi]"}], "}"}]]], "Input"], Cell["Power has the Listable attribute, so it threads over the list without any\nhelp. Even the string is raised to a power symbolically - Mathematica does\nnot object, it simply cannot simplify it.", "Text"], Cell["23: Log over the same list via Map, then N applied to the result", "Section"], Cell[BoxData[RowBox[{"logs", "=", RowBox[{"Log", "/@", RowBox[{"{", RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"string\"", ",", "\[Pi]"}], "}"}]}]}]], "Input"], Cell[BoxData[RowBox[{"N", "[", "logs", "]"}]], "Input"], Cell["Map is the indirect route: it applies Log to each element separately rather\nthan relying on listability. N then converts whatever is numeric.", "Text"], Cell["24: Apply Plus to the Exercise 4 list", "Section"], Cell[BoxData[RowBox[{"Plus", "@@", "list4"}]], "Input"], Cell["Apply replaces the head List with Plus, turning {0, 2, ..., 20} into\n0 + 2 + ... + 20 = 110.", "Text"], Cell["25: Flatten the Exercise 5 matrix", "Section"], Cell[BoxData[RowBox[{"Flatten", "[", "mat5", "]"}]], "Input"], Cell["The 4 x 5 nested structure collapses into a single list of 20 entries.", "Text"]}, WindowSize -> {1100, 850}, StyleDefinitions -> "Default.nb"]
(* End of Notebook Content *)
