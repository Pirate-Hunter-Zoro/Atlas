Cell[CellGroupData[{

Cell["Listable Functions:", "Subsection"],

Cell[TextData[{
 "Most internal functions to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " are listable, i.e. they can automatically accept a list as an argument and \
return a list of results."
}], "Text"],

Cell["\<\
Attributes[symbol] gives the list of attributes for a symbol.\
\>", "Item",
 CellChangeTimes->{{3.3899986344704*^9, 3.3899986370814*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"Attributes", " ", "[", "Sin", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"Sin", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"{", 
   RowBox[{
   "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", "\[Pi]"}], 
   "}"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389746836056914*^9, 3.3897468404469137`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Attributes", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
    "Sin", ",", "Tan", ",", "Exp", ",", "Log", ",", "Abs", ",", "Sqrt"}], 
    "}"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.389746847669914*^9, 3.389746867871914*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["Making a User Defined Function Listable (Map Command):", "Subsection"],

Cell[TextData[{
 "There are two ways to get ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to map a user defined function onto a list.  First, give the function the \
Attribute Listable.  Second, map the function to each element in a list using \
the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command Map[...].\nObserve that the user-defined function  \
userFunction[...]  does not automatically map through a list of elements:"
}], "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"userFunction", " ", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\""}], "}"}],
    "]"}]}]], "Input"],

Cell["\<\
Map[f, expr] applies f to each element on the first level in expr.\
\>", "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3899986239444*^9, 3.3899986271684*^9}},
 FontWeight->"Bold"],

Cell["However, the Map[...] command performs this function", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Map", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
   "userFunction", " ", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\""}], 
     "}"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3897758462142*^9, 3.3897758604652*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["Replacing the Head of a Function:", "Subsection"],

Cell[TextData[StyleBox["Head[expr] gives the head of expr.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3899986165694*^9, 3.3899986198274*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"Sin", "[", "x", "]"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"Head", " ", "[", 
  RowBox[{"a", " ", "+", " ", "b", " ", "+", "c", " ", "+", " ", "d"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"FullForm", " ", "[", 
  RowBox[{"a", " ", "+", " ", "b", " ", "+", " ", "c", " ", "+", " ", "d"}], 
  "]"}]], "Input"],

Cell["\<\
Note that the Plus function is applied to a sequence, not a list.  Thus, if \
we want to add up the elements in a list, we can not use the Map function.  \
Note what the Head is for a list:\
\>", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\""}], "}"}],
    "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"FullForm", " ", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\""}], "}"}],
    "]"}]}]], "Input"],

Cell["\<\
Note that both Plus and List are applied to a sequence of elements.  Thus, if \
we want to add up the elements in a list, then all we have to do is replaced \
the head \"List\" with the head \"Plus\".  The command to do this is Apply \
(not Map).\
\>", "Text"],

Cell[TextData[StyleBox["Apply[f, expr] or f @@ expr replaces the head of expr \
by f.\nApply[f, expr, levelspec] replaces heads in parts of expr specified by \
levelspec.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3899986022944*^9, 3.3899986097594*^9}}],

Cell[BoxData[
 RowBox[{"Apply", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Plus", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"List", "[", 
    RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\""}], 
    "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897759645912*^9, 3.3897759748782*^9}}],

Cell["\tor ...", "Text"],

Cell[BoxData[
 RowBox[{"Apply", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Plus", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\""}], 
    "}"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897759873132*^9, 3.3897759988311996`*^9}}],

Cell["\tNote:", "Text"],

Cell[BoxData[
 RowBox[{"FullForm", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  " ", 
  RowBox[{"Apply", " ", "[", 
   RowBox[{"Plus", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\""}], 
     "}"}]}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3897760062312*^9, 3.3897760125982*^9}}],

Cell[TextData[{
 "\nConsider the following example to calculate the length of a vector:\n\n\
Length =  ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    FormBox[
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      SuperscriptBox[
       SubscriptBox["a", "i"], "2"]}],
     TraditionalForm]], TraditionalForm]]],
 "    for the vector (i.e. list)   ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["a", "1"], ",", 
    SubscriptBox["a", "2"], ",", 
    SubscriptBox["a", "3"], ",", 
    SubscriptBox["a", "4"], ",", 
    SubscriptBox["a", "5"]}], "}"}]],
  FontWeight->"Bold"],
 "   (the length is arbitrary):\n"
}], "Text",
 CellChangeTimes->{3.3897760284132*^9}],

Cell[BoxData[
 RowBox[{" ", 
  SqrtBox[
   RowBox[{" ", 
    RowBox[{"Apply", " ", "[", 
     RowBox[{"Plus", ",", " ", 
      SuperscriptBox[
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["a", "1"], ",", 
         SubscriptBox["a", "2"], ",", 
         SubscriptBox["a", "3"], ",", 
         SubscriptBox["a", "4"], ",", 
         SubscriptBox["a", "5"]}], "}"}], "2"]}], "]"}]}]]}]], "Input"],

Cell[BoxData[
 RowBox[{"vector", " ", "=", "  ", 
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["a", "1"], ",", 
    SubscriptBox["a", "2"], ",", 
    SubscriptBox["a", "3"], ",", 
    SubscriptBox["a", "4"], ",", 
    SubscriptBox["a", "5"]}], "}"}]}]], "Input"],

Cell[BoxData[
 SqrtBox[
  RowBox[{" ", 
   RowBox[{"Apply", " ", "[", 
    RowBox[{"Plus", ",", "  ", 
     SuperscriptBox["vector", "2"]}], "]"}]}]]], "Input"],

Cell[BoxData[
 RowBox[{"v1", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"v0", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["x", "0"], ",", 
    SubscriptBox["y", "0"], ",", 
    SubscriptBox["z", "0"]}], "}"}]}]], "Input"],

Cell[BoxData[
 SqrtBox[
  RowBox[{" ", 
   RowBox[{"Apply", " ", "[", 
    RowBox[{"Plus", ",", "  ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"v1", " ", "-", " ", "v0"}], ")"}], "2"]}], "]"}]}]]], "Input"],

Cell["\<\
Note that it was not necessary to determine the number of elements in the \
vector or to explicitly do the addition.

Finally, another commonly used application of Apply is multiplication (i.e. \
Times).\
\>", "Text"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"FullForm", " ", "[", 
   RowBox[{"a", "*", "b", "*", "c", "*", "d"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Apply", " ", "[", " ", 
   RowBox[{"Times", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["a", "1"], ",", 
      SubscriptBox["a", "2"], ",", 
      SubscriptBox["a", "3"], ",", 
      SubscriptBox["a", "4"], ",", 
      SubscriptBox["a", "5"]}], "}"}]}], "]"}]}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["Formatting Lists:", "Subsection"],

Cell[TextData[{
 "There are many different ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands to reformat the output of an operation to make it more visibly \
pleasing."
}], "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Partition", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "g", ",", 
      "h", ",", "i", ",", "j", ",", "k", ",", "l"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "3"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], " "}]], "Input",
 CellChangeTimes->{{3.3897760921542*^9, 3.3897760986342*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "e", ",", "f"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"g", ",", "h", ",", "i"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "k", ",", "l"}], "}"}]}], "}"}], "//", "  ", 
   "MatrixForm"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"d", ",", "e", ",", "f"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"g", ",", "h", ",", "i"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "k", ",", "l"}], "}"}]}], "}"}], "//", "    ", 
  "TableForm"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"d", ",", "e", ",", "f"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"g", ",", "h", ",", "i"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "k", ",", "l"}], "}"}]}], "}"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.3897761320882*^9, 3.3897761412402*^9}}],

Cell["Next, consider a list of lists with non uniform dimension:", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "a", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"b", ",", "c"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"d", ",", "e", ",", "f"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"g", ",", "h", ",", "i", ",", "j"}], "}"}]}], "}"}], "//", "  ", 
  "MatrixForm"}]], "Input"],

Cell["\<\
Note that the matrix is a vector whose elements are themselves lists.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "a", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"b", ",", "c"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"d", ",", "e", ",", "f"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"g", ",", "h", ",", "i", ",", "j"}], "}"}]}], "}"}], "//", "   ",
   "TableForm"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "a", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"b", ",", "c"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"d", ",", "e", ",", "f"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"g", ",", "h", ",", "i", ",", "j"}], "}"}]}], "}"}], "//", "  ", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.3897761890292*^9, 3.3897762044862003`*^9}}],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "a", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "c"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "e", ",", "f"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"g", ",", "h", ",", "i", ",", "j"}], "}"}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "Center"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897762189262*^9, 3.3897762417462*^9}}],

Cell["\<\
There are many formatting options to add structure, placement and labels to \
formatted lists (especially the Table command).\
\>", "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Exercises:", "Title"],
 "  Advanced Lesson 5 "
}], "Section"],

Cell["\<\
Your Name:

Your Math Class:\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold"],

Cell[TextData[{
 StyleBox["Note: Some of the following exercises are expressed in every day \
mathematical notation rather than proper ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation.  You ", "Subsubsection"],
 StyleBox["MUST", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" convert every day notation into ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation for your code to work properly.  For example:\n\n\t\
Equations ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be changed from  \"=\"  to  \"==\"  to work correctly (i.e. ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "\[Equal]", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]]],
 StyleBox["  not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "=", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]]],
 StyleBox["  ).  \n\tFunctions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be expressed as  f[x]  and  not  f(x)  to work correctly.  \n\t\
Functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be defined using  \"_\"  to work correctly (i.e.  ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]]],
 StyleBox["  and not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]]],
 StyleBox[").\n\t", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" start with a capital (i.e.  Sin[x]  not  sin[x]).\n\t", 
  "Subsubsection"],
 StyleBox["Your", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" functions should start with a lower case letter (i.e.  f[x]  not  \
F[x]).\n\tSpecial symbols ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be entered correctly (i.e.  ", "Subsubsection"],
 StyleBox["\[ExponentialE]", "Subsection"],
 StyleBox["  from the palette and not  e ).\n\t\nThese exercises begin your \
training in making this conversion automatically.\n", "Subsubsection"]
}], "Text",
 CellChangeTimes->{{3.39064873246*^9, 3.390649069177*^9}, {3.390649104818*^9, 
   3.390649156885*^9}, {3.390649215119*^9, 3.39064939362*^9}, {
   3.390649427467*^9, 3.390649437834*^9}, {3.3906856676331425`*^9, 
   3.3906858924611425`*^9}, {3.3906859679691424`*^9, 3.390686080823142*^9}, {
   3.390686138196142*^9, 3.390686244913142*^9}, 3.390686344335142*^9, {
   3.3906897169261427`*^9, 3.3906898397271423`*^9}, {3.3906898702421427`*^9, 
   3.3906898773081427`*^9}, {3.3906929625171423`*^9, 3.3906929634941425`*^9}}],

Cell[TextData[{
 "Remember to clear all variables that you will use below:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Clear", "[", "          ", "...", "             ", "]"}], 
   TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3906923197301426`*^9, 3.3906923812721424`*^9}, {
  3.3906924809361424`*^9, 3.3906924908791423`*^9}, {3.3906927825761423`*^9, 
  3.3906927911761427`*^9}}],

Cell["\<\
  1:  Type in a list that contains your name (as a string), your age (as an \
integer) and your major (as symbols i.e. variables).  Evaluate this \
expression.\
\>", "Text"],

Cell["\<\
  2:  Type in a list of lists which contains a list of the course numbers \
that you are taking this semester (as integers), a list of the corresponding \
course names (as symbols i.e. variables).  Display this list using: \
TableForm.  Evaluate this expression.\
\>", "Text"],

Cell["\<\
  3:  Generate a list of integers from 0 to 20 using the Table command.\
\>", "Text"],

Cell["\<\
  4:  Generate a list of EVEN integers from 0 to 20 using the Table command.\
\>", "Text"],

Cell["\<\
  5:  Part 1:  Generate a list of lists using the Table command which \
represents a 4x5 matrix containing the elements Sin[i]*Cos[j].  
       Part 2:  Display this list of lists using:  MatrixForm.  Evaluate this \
expression.\
\>", "Text"],

Cell["\<\
  6:  Sort the list containing your course numbers.  Sort the list containing \
the corresponding course names.\
\>", "Text"],

Cell["  7:  Reverse the list generated in Exercise 3.", "Text"],

Cell["\<\
  8:  Drop the first three elements from the list generated in Exercise 3.  \
Drop the last three elements from the list generated in Exercise 3.\
\>", "Text"],

Cell["\<\
  9:  Take the first three elements from the list generated in Exercise 3.  \
Take the last three elements from the list generated in Exercise 3.  Take \
elements  3, 4, and 11 from the list generated in Exercise 3.\
\>", "Text"],

Cell["\<\
10:  Insert a second element \"Fun and games\" into the list of your course \
names in Exercise 2. \
\>", "Text"],

Cell["\<\
11:  Replace the second course name in the list of your course names in \
Exercise 2 with \"Fun and games\". \
\>", "Text"],

Cell["12:  Determine the length of the list in Exercise 4:", "Text"],

Cell["\<\
13:  Determine the dimensions of the list of lists in Exercise 5:\
\>", "Text"],

Cell["\<\
14:  Part 1:  Take the intersection of the lists in exercises 3 and 4.  
       Part 2:  Display this list using: ColumnForm.  Evaluate this \
expression.\
\>", "Text"],

Cell["\<\
15:  Join the lists in exercises 3 and 4.  Display this list using: \
ColumnForm.  Evaluate this expression.\
\>", "Text"],

Cell["\<\
16:  Partition the list in Exercise 3 to contain lists of length 4.   Display \
this list of lists using: TableForm.  Evaluate this expression.\
\>", "Text"],

Cell["\<\
17:  Partition the list in Exercise 3 to contain lists of length three which \
each contain lists of length 2.   Display this list of lists of lists using:  \
MatrixForm.  Evaluate this expression.\
\>", "Text"],

Cell["\<\
18:  Using the [[...]] notation, extract the third element from the list in \
Exercise 3 and the second element from the list of lists in Exercise 16.\
\>", "Text"],

Cell["\<\
19:  Using the [[...]] notation, extract the element corresponding to the \
second row and third column from the list of lists in Exercise 5.\
\>", "Text"],

Cell["\<\
20:  Using the [[...]] notation, extract the second row from the list of \
lists in Exercise 5.\
\>", "Text"],

Cell["\<\
21:  It is possible to use JUST the [[...]] notation to extract the second \
column from the list of lists in Exercise 5.  You may have to look up the \
Part command in Help.\
\>", "Text"],

Cell[TextData[{
 "22:  Evaluate directly:",
 StyleBox[" ",
  FontSize->14],
 Cell[BoxData[
  RowBox[{" ", 
   StyleBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", 
       "\[Pi]"}], "}"}]],
    FontWeight->"Bold"]}]],
  FontSize->16]
}], "Text"],

Cell[TextData[{
 "23:  Evaluate:  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Log", "[", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "2", ",", "a", ",", "x", ",", "\"\<string\>\"", ",", "\[Pi]"}],
      "}"}], "]"}],
   FontWeight->"Bold"]]],
 "   ",
 StyleBox["indirectly",
  FontVariations->{"Underline"->True}],
 " by using the Map command.  Next, directly obtain the list of approximate \
real numerical values for the previous result using the  N Command."
}], "Text"],

Cell[TextData[{
 "24:  ",
 StyleBox["Apply",
  FontVariations->{"Underline"->True}],
 " Plus to the list in Exercise 4."
}], "Text"],

Cell[TextData[{
 "25:  ",
 StyleBox["Flatten",
  FontVariations->{"Underline"->True}],
 " out the list of lists in Exercise 5."
}], "Text"],

Cell[TextData[{
 StyleBox["Print",
  FontSize->14,
  FontWeight->"Bold"],
 StyleBox[" your homework exercises",
  FontSize->14],
 ".\n",
 StyleBox["But do ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["NOT",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" print the above lesson along with the exercises!",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.3903491193324003`*^9, 3.3903491706104*^9}, {
   3.3903492171244*^9, 3.3903492363613997`*^9}, {3.3903493057854*^9, 
   3.3903493616624002`*^9}, {3.390367829311*^9, 3.390368046703*^9}, {
   3.390368151425*^9, 3.390368157087*^9}, {3.3903689909309998`*^9, 
   3.390369020223*^9}, {3.390369115093*^9, 3.390369186012*^9}, {
   3.3903692234300003`*^9, 3.390369566137*^9}, {3.390369653565*^9, 
   3.390369672512*^9}, {3.390369704873*^9, 3.3903697467469997`*^9}, {
   3.390369895852*^9, 3.390369997834*^9}, {3.390370474823*^9, 
   3.390370498811*^9}, 3.3903705605439997`*^9, {3.390370625072*^9, 
   3.390370690086*^9}, {3.390374898767*^9, 3.390374902177*^9}, {
   3.390383169347*^9, 3.390383198519*^9}, 3.39038573018396*^9, {
   3.3903876565289598`*^9, 3.3903876566309595`*^9}, {3.39038798227396*^9, 
   3.3903879827329597`*^9}, {3.39042821355*^9, 3.3904282172060003`*^9}}]
}, Closed]]
