    ",", "i", ",", "j", ",", "k", ",", "l"}], "}"}], "[", 
  RowBox[{"[", "10", "]"}], "]"}]], "Input"],

Cell["\<\
expr[[ {i1, i2, ... } ]] gives a list of the parts i1, i2, ...  of expr.\:f3b5\
\>", "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 FontWeight->"Bold"],

