       RowBox[{"{", 
        RowBox[{"11", ",", "12"}], "}"}]}], "}"}]}], "}"}], "]"}]}]], "Input"],

Cell["The Flatten command removes internal lists from a list.", "Text"],

Cell["\<\
Flatten[list] flattens out nested lists.
Flatten[list, n] flattens to level n. 
Flatten[list, n, h] flattens subexpressions with head h.\
\>", "Item",
 CellChangeTimes->{{3.3899987778264*^9, 3.3899987896124*^9}},
 FontWeight->"Bold"],

