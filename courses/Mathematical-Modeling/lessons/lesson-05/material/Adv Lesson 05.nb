Cell[CellGroupData[{

Cell["Referencing Elements:", "Subsection"],

Cell["\<\
One of the most important commands for lists is the ability to select a \
specific element.\
\>", "Text"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"expr", "[", 
    RowBox[{"[", "i", "]"}], "]"}], TraditionalForm]]],
 " gives the ith part of expr."
}], "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3899987564454*^9, 3.3899987719624*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
   "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "g", ",", "h", 
    ",", "i", ",", "j", ",", "k", ",", "l"}], "}"}], "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
   "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "g", ",", "h", 
    ",", "i", ",", "j", ",", "k", ",", "l"}], "}"}], "[", 
  RowBox[{"[", "3", "]"}], "]"}]], "Input"],

