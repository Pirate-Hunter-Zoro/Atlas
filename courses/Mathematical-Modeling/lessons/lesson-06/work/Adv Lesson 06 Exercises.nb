Notebook[{
Cell["\<\
Advanced Lesson 6 - Exercises: Replacement Rules and Evaluation
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"a85ef402-40c8-4190-ac7c-31179af457f2"],

Cell["1: x = 2 followed by an integration in x", "Section",ExpressionUUID->"c8d14ad6-26dc-408e-8766-e9397b1954d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]}], "Input",ExpressionUUID->"d51278a1-\
baff-4a24-a81c-c4b73e14de18"],

Cell["2: x := 2 followed by the same integration", "Section",ExpressionUUID->"4d4c5fe0-4ba3-4512-9111-aa617f24e65e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", ":=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]}], "Input",ExpressionUUID->"ca7d42e9-\
30df-4da6-b8ec-3643ab1e7fd7"],

Cell["3: A global x colliding with a pattern variable named x", "Section",ExpressionUUID->"b501dc3c-1440-4061-8ff9-0edb7e0d3004"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "f1", ",", "f2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f1", "[", "x_", "]"}], "=", 
   SuperscriptBox["x", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", "x_", "]"}], ":=", 
   SuperscriptBox["x", "2"]}], ";"}]}], "Input",ExpressionUUID->"38827c65-\
4bea-41bc-923f-955632e6bc5b"],

Cell["?f1", "Input",ExpressionUUID->"9883b354-f263-477a-bff7-2f7d3ccba6a1"],

Cell["?f2", "Input",ExpressionUUID->"3495e7b9-2643-4592-bbe3-c66378c7a472"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f1", "[", "z", "]"}], ",", 
   RowBox[{"f2", "[", "z", "]"}]}], "}"}]], "Input",ExpressionUUID->"1bdebe7b-\
2acb-443c-a594-d8d3fb6971c2"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f1", "[", "z", "]"}], ",", 
     RowBox[{"f2", "[", "z", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", "0", ",", "3"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", "0.01`", "]"}], "}"}]}]}], "]"}]], "Input",Expr\
essionUUID->"5c84b85d-52ef-4029-b28e-871f42d83b37"],

Cell["\<\
4: A replacement rule and an integration in the wrong variable\
\>", "Section",ExpressionUUID->"e4801c55-034d-4daa-a8ed-edf3d126d9ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  SuperscriptBox["x", "2"], "/.", "\[VeryThinSpace]", 
  RowBox[{"x", "\[Rule]", "y"}]}]}], "Input",ExpressionUUID->"3db05e2e-c8a9-\
4c1d-9a3f-409e72ae4913"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "y"}]}]}]], "Input",ExpressionUUID->"97385191-\
933e-49b1-af12-8df3683156e1"],

Cell["5: Assigning the result of a self-replacement", "Section",ExpressionUUID->"185deef3-d2d2-449d-b916-da7ae83fff19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"x", "=", 
  RowBox[{"x", "/.", "\[VeryThinSpace]", 
   RowBox[{"x", "\[Rule]", "y"}]}]}]}], "Input",ExpressionUUID->"908b6aa5-\
5044-4296-a24d-9b87ab7c8aa0"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "y"}]}]}]], "Input",ExpressionUUID->"1386018b-\
09dd-498e-bcd7-55e577062f15"],

Cell["6: The same shape, with a symbol the rule does not mention", "Section",ExpressionUUID->"cc89d5ac-784b-4f50-ae4d-14ccc17c4e76"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"x", "=", 
  RowBox[{"z", "/.", "\[VeryThinSpace]", 
   RowBox[{"x", "\[Rule]", "y"}]}]}]}], "Input",ExpressionUUID->"9252d787-\
96e5-4ae3-943e-d61bc0d19ec4"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "y"}]}]}]], "Input",ExpressionUUID->"3b576c57-\
67b3-459a-852a-8316d3847b74"],

Cell["7: Why two rules in one list do not chain", "Section",ExpressionUUID->"b42e4469-2808-4af7-b4cc-a83449ef6d6e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sin", "[", "x", "]"}], "/.", "\[VeryThinSpace]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], "\[Rule]", 
     RowBox[{"Log", "[", "x", "]"}]}], ",", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{"2", " ", "\[Pi]", " ", "y"}]}]}], "}"}]}]}], "Input",ExpressionU\
UID->"de5cd091-f738-495b-86f8-1c95631e9943"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sin", "[", "x", "]"}], "//.", "\[VeryThinSpace]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], "\[Rule]", 
     RowBox[{"Log", "[", "x", "]"}]}], ",", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{"2", " ", "\[Pi]", " ", "y"}]}]}], "}"}]}]], "Input",ExpressionUU\
ID->"f7f98049-b2b8-401c-933c-59cb4c037cc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sin", "[", "x", "]"}], "/.", "\[VeryThinSpace]", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], "\[Rule]", 
   RowBox[{"Log", "[", 
    RowBox[{"2", " ", "\[Pi]", " ", "y"}], "]"}]}]}]], "Input",ExpressionUUID->\
"7e9cfbfb-c26c-42a2-aa54-ae80233df6d3"],

Cell["8: A rule set carried inside a function definition", "Section",ExpressionUUID->"66d6d07a-e0e8-483a-a7db-e5fe111db45b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "/.", "\[VeryThinSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"y", "\[Rule]", 
      RowBox[{"Cos", "[", "y", "]"}]}], ",", 
     RowBox[{"z", "\[Rule]", 
      RowBox[{"Sin", "[", "z", "]"}]}]}], "}"}]}]}]}], "Input",ExpressionUUID->\
"32b4eadb-f474-47db-b82c-a9a281d722da"],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input",ExpressionUUID->"c0730ae2-8df7-496b-a3fd-67b436b986b5"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"x", "+", "y", "+", "z"}], "]"}]], "Input",ExpressionUUID->\
"1f6edcfb-2abb-46d7-9190-d709592cf5ca"],

Cell["9: Frame -> False and Frame -> True as replacement rules", "Section",ExpressionUUID->"fbc744e6-e712-4a1c-a6af-427a1cb62982"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Frame", "\[Rule]", "False"}]}], "]"}]}], "Input",ExpressionUUID->\
"47c8f912-79bb-4a76-b5a5-6ca9de20dcea"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]], "Input",ExpressionUUID->\
"4b8b392c-9dd3-42d2-92b2-9f6b8ab0ad18"],

Cell["10: Rewriting a finished plot by rewriting its options", "Section",ExpressionUUID->"1c333b80-e80d-4741-b4ae-88e728755f48"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "plot1", ",", "plot2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"plot1", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", 
      RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}]}], "Input",ExpressionUUID->\
"8b10e7d2-9c0c-4944-ab1d-cfdf167fdaca"],

Cell["?plot1", "Input",ExpressionUUID->"951ed8a7-36fa-4738-8be3-bd0318fea22b"],

Cell[BoxData[
 RowBox[{"Frame", "/.", "\[VeryThinSpace]", 
  RowBox[{"Options", "[", "plot1", "]"}]}]], "Input",ExpressionUUID->\
"0c3ba0ca-694f-421c-894d-91629bc03dfe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plot2", "=", 
   RowBox[{"plot1", "/.", "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Frame", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"True", ",", "True"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"True", ",", "True"}], "}"}]}], "}"}]}], ")"}], "\[Rule]", 
     RowBox[{"Frame", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"False", ",", "True"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"False", ",", "True"}], "}"}]}], "}"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Frame", "/.", "\[VeryThinSpace]", 
  RowBox[{"Options", "[", "plot2", "]"}]}]}], "Input",ExpressionUUID->\
"142653c7-85d8-49b3-804d-76b45ab973a7"],

Cell[BoxData[
 RowBox[{"Show", "[", "plot2", "]"}]], "Input",ExpressionUUID->"069c20bf-b448-4a08-9c15-e6a35028d974"],

Cell["11: DSolve, substituting constants, checking, and plotting", "Section",ExpressionUUID->"8b3ea00a-4178-41f7-971a-2008be1395ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"y", ",", "t", ",", "sol", ",", "sol2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["y", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "+", 
      RowBox[{"y", "[", "t", "]"}]}], "\[Equal]", "0"}], ",", 
    RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}]}]}], "Input",ExpressionUUI\
D->"a622d491-fcb9-4e14-9f71-29bfbfb7db72"],

Cell[BoxData[
 RowBox[{"sol2", "=", 
  RowBox[{"sol", "/.", "\[VeryThinSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "C"], "\[Rule]", "4"}], ",", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "\[Rule]", "7"}]}], "}"}]}]}]], "Input",ExpressionUUID->\
"221c7a29-fe13-4799-af7e-a0d4fa15f754"],

Cell[BoxData[
 RowBox[{"rule", "=", 
  RowBox[{"First", "[", "sol2", "]"}]}]], "Input",ExpressionUUID->"8df25374-\
537a-4669-89a0-4c78259cbd23"],

Cell[BoxData[
 RowBox[{"drule", "=", 
  RowBox[{
   SubscriptBox["\[PartialD]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "2"}], "}"}]], "rule"}]}]], "Input",ExpressionUUID->\
"dde089c8-198d-4a7f-a365-0e96b4480daa"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["y", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "+", 
     RowBox[{"y", "[", "t", "]"}]}], "/.", "\[VeryThinSpace]", "drule"}], "/.",
    "\[VeryThinSpace]", "rule"}], "]"}]], "Input",ExpressionUUID->"00bf77d0-\
78de-4e9e-9c4e-c673938481e1"],

Cell[BoxData[
 RowBox[{"ysol", "=", 
  RowBox[{
   RowBox[{"y", "[", "t", "]"}], "/.", "\[VeryThinSpace]", 
   "rule"}]}]], "Input",ExpressionUUID->"ad6debe3-414f-4161-8144-\
ab7247e4f02d"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"ysol", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"9b4ebf3d-ecce-4b16-89be-11f62ce56576"]
},
