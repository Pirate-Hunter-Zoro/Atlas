Cell[TextData[{
 StyleBox[" Exercises:", "Title"],
 "  Advanced Lesson 6 "
}], "Section",ExpressionUUID->"8e1c85a3-aab5-4d08-8335-9153e289a306"],

Cell["\<\
Your Name:  Mikey Ferguson

Your Math Class:  MATH 7013 - Advanced Mathematical Modeling\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"48751dbd-df0f-4997-9916-13d826517eb4"],

Cell[TextData[{
 StyleBox["Note: Some of the following exercises are expressed in every day \
mathematical notation rather than proper ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation.  You ", "Subsubsection"],
 StyleBox["MUST", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" convert every day notation into ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation for your code to work properly.  For example:\n\n\t\
Equations ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be changed from  \"=\"  to  \"==\"  to work correctly (i.e. ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "\[Equal]", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]],ExpressionUUID->
  "fb9bf302-13bf-443d-9ecf-5ebadeef9541"],
 StyleBox["  not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "=", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]],ExpressionUUID->
  "9ef15bad-0bee-485c-b2bf-30d69c0d95a6"],
 StyleBox["  ).  \n\tFunctions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be expressed as  f[x]  and  not  f(x)  to work correctly.  \n\t\
Functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be defined using  \"_\"  to work correctly (i.e.  ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]],ExpressionUUID->"e2375d4d-714a-41ce-9e03-59dd9b8e0074"],
 StyleBox["  and not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]],ExpressionUUID->"65146833-048f-44e4-a1ad-e25d234f026a"],
 StyleBox[").\n\t", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" start with a capital (i.e.  Sin[x]  not  sin[x]).\n\t", 
  "Subsubsection"],
 StyleBox["Your", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" functions should start with a lower case letter (i.e.  f[x]  not  \
F[x]).\n\tSpecial symbols ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be entered correctly (i.e.  ", "Subsubsection"],
 StyleBox["\[ExponentialE]", "Subsection"],
 StyleBox["  from the palette and not  e ).\n\t\nThese exercises begin your \
training in making this conversion automatically.\n", "Subsubsection"]
}], "Text",
 CellChangeTimes->{{3.39064873246*^9, 3.390649069177*^9}, {3.390649104818*^9, 
   3.390649156885*^9}, {3.390649215119*^9, 3.39064939362*^9}, {
   3.390649427467*^9, 3.390649437834*^9}, {3.3906856676331425`*^9, 
   3.3906858924611425`*^9}, {3.3906859679691424`*^9, 3.390686080823142*^9}, {
   3.390686138196142*^9, 3.390686244913142*^9}, 3.390686344335142*^9, {
   3.3906897169261427`*^9, 3.3906898397271423`*^9}, {3.3906898702421427`*^9, 
   3.3906898773081427`*^9}, {3.3906929183261423`*^9, 
   3.3906929191781425`*^9}},ExpressionUUID->"36f074c8-2200-4ba0-81b5-\
c7cf72222c33"],

Cell[TextData[{
 "Remember to clear all variables that you will use below:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Clear", "[", "          ", "...", "             ", "]"}], 
   TraditionalForm]],ExpressionUUID->"8657a3dd-559c-401f-9f89-14e071371dbd"]
}], "Text",
 CellChangeTimes->{{3.3906923197301426`*^9, 3.3906923812721424`*^9}, {
  3.3906924809361424`*^9, 3.3906924908791423`*^9}, {3.3906927825761423`*^9, 
  3.3906927911761427`*^9}},ExpressionUUID->"3e673e25-d698-4873-a60f-\
63f27ea831bc"],

Cell[TextData[{
 "1: Explain why the following code gives unexpected results.\n\tx = 2\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{
     FormBox[
      SuperscriptBox["x", "2"],
      TraditionalForm], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "4cde53b2-026f-4d14-82fc-fb8eb9ee73cc"]
}], "Text",
 CellChangeTimes->{3.3903885877929597`*^9, 
  3.39038870608596*^9},ExpressionUUID->"d5f297cd-5848-4519-8021-493922733084"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]}], "Input",ExpressionUUID->"d51278a1-\
baff-4a24-a81c-c4b73e14de18"],

Cell["\<\
x had already been given the value 2, so by the time the integral was read it \
said integrate 4 with respect to 2. The integration variable itself had \
turned into a number, which is meaningless, so the integral was left \
unevaluated.\
\>", "Text",ExpressionUUID->"77e1a50c-a771-4ab2-8ca0-1f32d4bb96b5"],

Cell[TextData[{
 "2: Explain why the following code gives unexpected results.\n\tx := 2\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{
     FormBox[
      SuperscriptBox["x", "2"],
      TraditionalForm], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "5fa69b60-3f2b-4d94-81cc-cfec1d5478af"]
}], "Text",
 CellChangeTimes->{3.39038859192196*^9, 
  3.3903887096759596`*^9},ExpressionUUID->"bf24a30b-2d35-4f8e-8758-\
a6022fcf31c6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", ":=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]}], "Input",ExpressionUUID->"ca7d42e9-\
30df-4da6-b8ec-3643ab1e7fd7"],

Cell["\<\
The same thing happens. Using := only delays the evaluation of x; x still \
becomes 2 as soon as it is used, so the integration variable is again the \
number 2.\
\>", "Text",ExpressionUUID->"c57962b4-7c86-4cfc-a9e1-e4fcc7dcce8a"],

Cell[TextData[{
 "3: Explain why the following code gives unexpected results.\n\t",
 Cell[BoxData[{
  RowBox[{
   RowBox[{"x", "=", "2"}], ";"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"f1", "[", "x_", "]"}], "=", 
    SuperscriptBox["x", "2"]}], ";"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"f2", "[", "x_", "]"}], ":=", 
    SuperscriptBox["x", "2"]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f1", "[", "z", "]"}], ",", 
       RowBox[{"f2", "[", "z", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "3"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thickness", "[", "0.01", "]"}], "}"}]}]}], "]"}], ";"}]}],
  FontWeight->"Bold",ExpressionUUID->"04931abe-9efe-4bb0-8422-ed13afc20415"]
}], "Text",
 CellChangeTimes->{{3.39038867141996*^9, 3.39038867223396*^9}, {
  3.39038935257796*^9, 
  3.39038936334296*^9}},ExpressionUUID->"320f9ea0-0c36-49f1-a31b-\
e94f3bcc877d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "f1", ",", "f2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f1", "[", "x_", "]"}], "=", 
   SuperscriptBox["x", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", "x_", "]"}], ":=", 
   SuperscriptBox["x", "2"]}], ";"}]}], "Input",ExpressionUUID->"38827c65-\
4bea-41bc-923f-955632e6bc5b"],

Cell["?f1", "Input",ExpressionUUID->"9883b354-f263-477a-bff7-2f7d3ccba6a1"],

Cell["?f2", "Input",ExpressionUUID->"3495e7b9-2643-4592-bbe3-c66378c7a472"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f1", "[", "z", "]"}], ",", 
   RowBox[{"f2", "[", "z", "]"}]}], "}"}]], "Input",ExpressionUUID->"1bdebe7b-\
2acb-443c-a594-d8d3fb6971c2"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f1", "[", "z", "]"}], ",", 
     RowBox[{"f2", "[", "z", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", "0", ",", "3"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", "0.01`", "]"}], "}"}]}]}], "]"}]], "Input",Expr\
essionUUID->"5c84b85d-52ef-4029-b28e-871f42d83b37"],

Cell["\<\
x held the value 2 when f1 was defined with =, so the right-hand side x^2 was \
evaluated at once to 4, and f1 stores 4 for every argument. f2 was defined \
with :=, so it keeps x^2 and squares whatever it is given. That is why f1[z] \
is 4 and f2[z] is z^2, and the plot shows one flat line and one parabola.\
\>", "Text",ExpressionUUID->"53db5da7-5d59-4558-ab4d-3dc2742e3ac1"],

Cell[TextData[{
 "4: Explain why the following code gives unexpected results.\n\t",
 Cell[BoxData[{
  RowBox[{"Clear", " ", "[", 
   RowBox[{"x", ",", "y"}], "]"}], "\n", 
  RowBox[{" ", 
   RowBox[{
    SuperscriptBox["x", "2"], "  ", "/.", "  ", 
    RowBox[{"x", " ", "\[Rule]", " ", "y"}]}]}], "\n", 
  RowBox[{
   FormBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      FormBox[
       SuperscriptBox["x", "2"],
       TraditionalForm], 
      RowBox[{"\[DifferentialD]", "y"}]}]}],
    TraditionalForm], " "}]}],
  FontWeight->"Bold",ExpressionUUID->"bec6ae22-f80c-4ba3-8a1b-1c8539392e5f"]
}], "Text",ExpressionUUID->"ccb890fc-ef6b-432d-bec4-26cc83a6cd2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  SuperscriptBox["x", "2"], "/.", "\[VeryThinSpace]", 
  RowBox[{"x", "\[Rule]", "y"}]}]}], "Input",ExpressionUUID->"3db05e2e-c8a9-\
4c1d-9a3f-409e72ae4913"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "y"}]}]}]], "Input",ExpressionUUID->"97385191-\
933e-49b1-af12-8df3683156e1"],

Cell["\<\
The replacement itself is fine and gives y^2. The integral is the surprise: \
it asks for the integral of x^2 with respect to y, and x does not depend on \
y, so the answer is x^2 y. The replacement rule changed nothing permanently, \
so x is still x on the next line.\
\>", "Text",ExpressionUUID->"1ff995c4-9496-4eab-b5d9-95556d4ff431"],

Cell[TextData[{
 "5: Explain the results of the following code:\n\t",
 Cell[BoxData[{
  StyleBox[
   RowBox[{"Clear", " ", "[", 
    RowBox[{"x", ",", "y", ",", "z"}], "]"}],
   FontWeight->"Bold"], "\n", 
  RowBox[{" ", 
   StyleBox[
    RowBox[{"x", "=", 
     RowBox[{"x", "  ", "/.", "  ", 
      RowBox[{"x", " ", "\[Rule]", " ", "y"}]}]}],
    FontWeight->"Bold"]}], "\n", 
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{"\[Integral]", 
      RowBox[{
       FormBox[
        SuperscriptBox["x", "2"],
        TraditionalForm], 
       RowBox[{"\[DifferentialD]", "y"}]}]}],
     TraditionalForm], " "}],
   FontWeight->"Bold"]}],ExpressionUUID->
  "bb66bd16-9f99-4870-be8b-db95dd478b7b"]
}], "Text",ExpressionUUID->"e06622e6-62cc-4730-8d90-fafcb53bdd4c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"x", "=", 
  RowBox[{"x", "/.", "\[VeryThinSpace]", 
   RowBox[{"x", "\[Rule]", "y"}]}]}]}], "Input",ExpressionUUID->"908b6aa5-\
5044-4296-a24d-9b87ab7c8aa0"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "y"}]}]}]], "Input",ExpressionUUID->"1386018b-\
09dd-498e-bcd7-55e577062f15"],

Cell["\<\
This line assigns the result of the replacement, so x now genuinely holds y. \
The next line therefore integrates y^2 with respect to y and gives y^3/3.\
\>", "Text",ExpressionUUID->"04ff4659-e454-4fc9-893a-60e15b01a23f"],

Cell[TextData[{
 "6: Explain the results of the following code:\n\t",
 Cell[BoxData[{
  StyleBox[
   RowBox[{"Clear", " ", "[", 
    RowBox[{"x", ",", "y", ",", "z"}], "]"}],
   FontWeight->"Bold"], "\n", 
  StyleBox[
   RowBox[{" ", 
    RowBox[{"x", "=", 
     RowBox[{"z", "  ", "/.", "  ", 
      RowBox[{"x", " ", "\[Rule]", " ", "y"}]}]}]}],
   FontWeight->"Bold"], "\n", 
  StyleBox[
   RowBox[{
    FormBox[
     RowBox[{"\[Integral]", 
      RowBox[{
       FormBox[
        SuperscriptBox["x", "2"],
        TraditionalForm], 
       RowBox[{"\[DifferentialD]", "y"}]}]}],
     TraditionalForm], " "}],
   FontWeight->"Bold"]}],ExpressionUUID->
  "f5268f82-2ca6-4a48-9ae4-6dd98563ec3e"]
}], "Text",ExpressionUUID->"25103b15-d9b7-474d-af50-19a4fcaa5892"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"x", "=", 
  RowBox[{"z", "/.", "\[VeryThinSpace]", 
   RowBox[{"x", "\[Rule]", "y"}]}]}]}], "Input",ExpressionUUID->"9252d787-\
96e5-4ae3-943e-d61bc0d19ec4"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "2"], 
   RowBox[{"\[DifferentialD]", "y"}]}]}]], "Input",ExpressionUUID->"3b576c57-\
67b3-459a-852a-8316d3847b74"],

Cell["\<\
Here the rule does not apply, because the expression being replaced is z and \
the rule looks for x. So x is assigned z, and integrating x^2, which is now \
z^2, with respect to y gives y z^2.\
\>", "Text",ExpressionUUID->"7adfde44-8116-4e63-9145-f538696ede80"],

Cell["\<\
7: Explain why the following code does NOT yield:  Log[2 \[Pi] y]
\tClear [x,y]
\tSin[x]  /. {Sin[x] \[Rule] Log[x], x \[Rule] 2\[Pi] y}
How would you modify the replacement rule to yield the desired result?\
\>", "Text",
 CellChangeTimes->{{3.39038880315896*^9, 
  3.39038880315996*^9}},ExpressionUUID->"8a07d2d7-5383-42f2-b827-\
cd6134ae04da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sin", "[", "x", "]"}], "/.", "\[VeryThinSpace]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], "\[Rule]", 
     RowBox[{"Log", "[", "x", "]"}]}], ",", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{"2", " ", "\[Pi]", " ", "y"}]}]}], "}"}]}]}], "Input",ExpressionU\
UID->"de5cd091-f738-495b-86f8-1c95631e9943"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sin", "[", "x", "]"}], "//.", "\[VeryThinSpace]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], "\[Rule]", 
     RowBox[{"Log", "[", "x", "]"}]}], ",", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{"2", " ", "\[Pi]", " ", "y"}]}]}], "}"}]}]], "Input",ExpressionUU\
ID->"f7f98049-b2b8-401c-933c-59cb4c037cc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sin", "[", "x", "]"}], "/.", "\[VeryThinSpace]", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], "\[Rule]", 
   RowBox[{"Log", "[", 
    RowBox[{"2", " ", "\[Pi]", " ", "y"}], "]"}]}]}]], "Input",ExpressionUUID->\
"7e9cfbfb-c26c-42a2-aa54-ae80233df6d3"],

Cell["\<\
/. makes a single pass. It matches Sin[x] and replaces it with Log[x], and \
the result is not scanned again, so the second rule never reaches the x \
inside. //. repeats the rules until nothing changes, and that gives Log[2 Pi \
y].\
\>", "Text",ExpressionUUID->"97cfbd62-3fd0-4c46-9d94-cc4f02ce2e21"],

Cell["\<\
8: Explain how the following code works:
Clear [f,x,y,z]
\tf[x_] :=  x   /.  {y \[Rule] Cos[y],  z \[Rule] Sin[z]}
\tf[x]
\tf[x + y + z]\
\>", "Text",ExpressionUUID->"180c832e-5c84-40c9-b64d-5e11f15c09fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "/.", "\[VeryThinSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"y", "\[Rule]", 
      RowBox[{"Cos", "[", "y", "]"}]}], ",", 
     RowBox[{"z", "\[Rule]", 
      RowBox[{"Sin", "[", "z", "]"}]}]}], "}"}]}]}]}], "Input",ExpressionUUID->\
"32b4eadb-f474-47db-b82c-a9a281d722da"],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input",ExpressionUUID->"c0730ae2-8df7-496b-a3fd-67b436b986b5"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"x", "+", "y", "+", "z"}], "]"}]], "Input",ExpressionUUID->\
"1f6edcfb-2abb-46d7-9190-d709592cf5ca"],

Cell["\<\
The definition says: take whatever is handed in and apply the two rules to \
it. f[x] gives back x, because there is no y or z in it. f[x + y + z] gives x \
+ Cos[y] + Sin[z], because the rules find the y and the z inside the sum.\
\>", "Text",ExpressionUUID->"2515684a-8878-45e2-ae40-6367f32172ba"],

Cell["\<\
9: Explain the purpose of the replacement rules:  Frame \[Rule] False,  Frame \
\[Rule] True
\tClear [x]
\tPlot[Sin[x],{x,0,2\[Pi]}, Frame \[Rule] False]
\tPlot[Sin[x],{x,0,2\[Pi]}, Frame \[Rule] True]\
\>", "Text",ExpressionUUID->"5e71a60f-43e3-4a7a-98b3-e53dd500fdb9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Frame", "\[Rule]", "False"}]}], "]"}]}], "Input",ExpressionUUID->\
"47c8f912-79bb-4a76-b5a5-6ca9de20dcea"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]], "Input",ExpressionUUID->\
"4b8b392c-9dd3-42d2-92b2-9f6b8ab0ad18"],

Cell["\<\
Frame -> True and Frame -> False are options, and an option is written as a \
replacement rule. Plot reads that rule to decide whether to draw a box around \
the plot.\
\>", "Text",ExpressionUUID->"c85bc6c5-fd90-4731-94d8-31f2f50c0da7"],

Cell["\<\
10: Explain how the following code works:
\tClear [x,plot1,plot2]
\tplot1 = Plot[Sin[x], {x,0,2\[Pi]}, Frame \[Rule] True]
\t?plot1
\tplot2 = plot1  /.  (Frame\[Rule]{{True,True},{True,True}})  \[Rule]  (Frame \
\[Rule]{{False,True},{False,True}})
\t?plot2
\tShow[plot2]\
\>", "Text",
 CellChangeTimes->{{3.39038899765596*^9, 3.39038900699396*^9}, 
   3.6827906671779327`*^9, {3.6828580810652685`*^9, 
   3.6828581029832687`*^9}},ExpressionUUID->"f72a9575-36e8-4ea5-8138-\
f045284ccebb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "plot1", ",", "plot2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"plot1", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", 
      RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}]}], "Input",ExpressionUUID->\
"8b10e7d2-9c0c-4944-ab1d-cfdf167fdaca"],

Cell["?plot1", "Input",ExpressionUUID->"951ed8a7-36fa-4738-8be3-bd0318fea22b"],

Cell[BoxData[
 RowBox[{"Frame", "/.", "\[VeryThinSpace]", 
  RowBox[{"Options", "[", "plot1", "]"}]}]], "Input",ExpressionUUID->\
"0c3ba0ca-694f-421c-894d-91629bc03dfe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plot2", "=", 
   RowBox[{"plot1", "/.", "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Frame", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"True", ",", "True"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"True", ",", "True"}], "}"}]}], "}"}]}], ")"}], "\[Rule]", 
     RowBox[{"Frame", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"False", ",", "True"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"False", ",", "True"}], "}"}]}], "}"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Frame", "/.", "\[VeryThinSpace]", 
  RowBox[{"Options", "[", "plot2", "]"}]}]}], "Input",ExpressionUUID->\
"142653c7-85d8-49b3-804d-76b45ab973a7"],

Cell[BoxData[
 RowBox[{"Show", "[", "plot2", "]"}]], "Input",ExpressionUUID->"069c20bf-b448-4a08-9c15-e6a35028d974"],

Cell["\<\
A finished plot is just an expression: a Graphics object holding the drawing \
and a list of option rules. Applying a replacement rule to it rewrites the \
Frame option in place, and the result is a new, valid plot which Show \
displays. Nothing is recomputed; the picture is edited the same way any other \
expression is.\
\>", "Text",ExpressionUUID->"c974d89e-c467-437e-94b0-463166a5c47c"],

Cell[TextData[{
 "11:   Part 1:   Solve the ODE:  y''[t] + y[t] = 0   to get a replacement \
rule for  y[t]  using  DSolve.\nPart 2:   Use a list of replacement rules to \
replace C[1] with  4  and C[2] with  7  in the replacement rule for y[t].\n\
Part 3:   Use the solution replacement rule and substitute back into the ODE \
to check the solution   (You MUST use a procedure ",
 StyleBox["similar",
  FontVariations->{"Underline"->True}],
 " to the one I used above when I used the Solve command, however this \
example is harder than the one above).\nHint: How does  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", 
     RowBox[{"t", ",", "t"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
      RowBox[{"f", "[", "t", "]"}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"3ea7d341-208b-4de4-9d15-bb4d156c3867"],
 " evaluate?\nPart 4:   Use replacement rules to extract the solution  y[t]  \
from its replacement rule generated in Part 2 and use this to plot the \
solution for  0 \[LessEqual] t \[LessEqual] 2\[Pi]."
}], "Text",
 CellChangeTimes->{{3.3903891510319595`*^9, 
  3.39038925853496*^9}},ExpressionUUID->"c036a078-5201-4132-8605-\
ff46130a03eb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"y", ",", "t", ",", "sol", ",", "sol2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["y", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "+", 
      RowBox[{"y", "[", "t", "]"}]}], "\[Equal]", "0"}], ",", 
    RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}]}]}], "Input",ExpressionUUI\
D->"a622d491-fcb9-4e14-9f71-29bfbfb7db72"],

Cell[BoxData[
 RowBox[{"sol2", "=", 
  RowBox[{"sol", "/.", "\[VeryThinSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "C"], "\[Rule]", "4"}], ",", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "\[Rule]", "7"}]}], "}"}]}]}]], "Input",ExpressionUUID->\
"221c7a29-fe13-4799-af7e-a0d4fa15f754"],

Cell[BoxData[
 RowBox[{"rule", "=", 
  RowBox[{"First", "[", "sol2", "]"}]}]], "Input",ExpressionUUID->"8df25374-\
537a-4669-89a0-4c78259cbd23"],

Cell[BoxData[
 RowBox[{"drule", "=", 
  RowBox[{
   SubscriptBox["\[PartialD]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "2"}], "}"}]], "rule"}]}]], "Input",ExpressionUUID->\
"dde089c8-198d-4a7f-a365-0e96b4480daa"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["y", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "+", 
     RowBox[{"y", "[", "t", "]"}]}], "/.", "\[VeryThinSpace]", "drule"}], "/.",
    "\[VeryThinSpace]", "rule"}], "]"}]], "Input",ExpressionUUID->"00bf77d0-\
78de-4e9e-9c4e-c673938481e1"],

Cell[BoxData[
 RowBox[{"ysol", "=", 
  RowBox[{
   RowBox[{"y", "[", "t", "]"}], "/.", "\[VeryThinSpace]", 
   "rule"}]}]], "Input",ExpressionUUID->"ad6debe3-414f-4161-8144-\
ab7247e4f02d"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"ysol", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"9b4ebf3d-ecce-4b16-89be-11f62ce56576"]
},
