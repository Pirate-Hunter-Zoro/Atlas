Cell[CellGroupData[{

Cell[TextData[StyleBox[" Conditional Evaluation  \"/;\":", "Subtitle"]], \
"Section"],

Cell[TextData[{
 "It is possible to apply a delayed assignment (or a delayed rule) \
conditionally.\n\nThe basic form is:\t  \n\t\tdelayed assignment",
 Cell[BoxData[
  FormBox[
   RowBox[{"   ", 
    RowBox[{"/;", "    "}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "logical expression\nWhere the \"delayed assignment\" is evaluated ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " when the \"logical expression\" returns a value of True."
}], "Text",
 CellChangeTimes->{{3.5231995097425117`*^9, 3.5231995314555116`*^9}}],

Cell[BoxData[
 RowBox[{"Clear", " ", "[", 
  RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
  "]"}]], "InputOnly"],

Cell["\<\
patt /; test is a pattern which matches only if the evaluation of test yields \
True.
lhs :> rhs /; test represents a rule which applies only if the evaluation of \
test yields True. 
lhs := rhs /; test is a definition to be used only if test yields True.\"\
\>", "Item",
 CellChangeTimes->{{3.3900359876070004`*^9, 3.390036003276*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", " ", "/;", 
    RowBox[{"IntegerQ", "[", "x", "]"}]}], "]"}], ":=", " ", 
  "\"\<x is an integer\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", " ", "/;", 
    RowBox[{"NumberQ", "[", "x", "]"}]}], "]"}], ":=", " ", 
  "\"\<x is a number (not an integer)\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", " ", "/;", 
    RowBox[{"ListQ", "[", "x", "]"}]}], "]"}], ":=", "  ", 
  "\"\<x is a list\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", " ", "/;", 
    RowBox[{"StringQ", "[", "x", "]"}]}], "]"}], ":=", "  ", 
  "\"\<x is a string\>\""}]], "InputOnly"],

