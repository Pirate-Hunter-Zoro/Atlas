(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \n",
 "Advanced Lesson 8\n\nConstructing Functions\n\nDr. Dale R. Doty\nUniversity \
of Tulsa"
}], "Title"],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Simple Functions:", "Subtitle"]], "Section"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly"],

Cell["\<\
The following examples will clarify some of the different ways in which a \
function can be written, both correctly and incorrectly.\
\>", "Text",
 CellChangeTimes->{{3.3897870288599997`*^9, 3.389787045401*^9}}],

Cell[CellGroupData[{

Cell["   What Can Go Wrong?", "Subsection"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell["\<\
Next, consider the case of immediate assignment \"=\"  (rather than delayed \
assignment \":=\") as well as the case of a specific symbol as an argument \
for the function (i.e. \"x\" and not \"x_\" ).\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x", "]"}], "=", 
  SqrtBox["x"]}]], "Input"],

Cell[" Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
   RowBox[{"f", "\[IndentingNewLine]", "Global`f", "\[IndentingNewLine]", 
    RowBox[{"f", "[", "x", "]"}]}], "=", 
   SqrtBox["x"]}]}]], "Program",
 CellChangeTimes->{{3.3900077070844*^9, 3.3900077452524*^9}, {
  3.3900077817074003`*^9, 3.3900077835274*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "4", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"x", "=", "4"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "4", "]"}]], "Input"],

Cell["Observe how  f  is stored internally:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
   RowBox[{"f", "\[IndentingNewLine]", "Global`f", "\[IndentingNewLine]", 
    RowBox[{"f", "[", "x", "]"}]}], "=", 
   SqrtBox["x"]}]}]], "Program",
 CellChangeTimes->{{3.3900077070844*^9, 3.3900077452524*^9}, {
  3.3900077817074003`*^9, 3.3900077835274*^9}}],

Cell[TextData[{
 "Note that the above function is only defined for the ",
 StyleBox["specific",
  FontVariations->{"Underline"->True}],
 " symbol  \"x\"  as an argument (however, the symbol  x  is ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " a number and therefore the square root of a number can not be evaluated).  \
When x is assigned the value 4, then  f  has no value for this symbol or any \
other symbol (such as 9, z, etc. etc.).\n\nNext, considered what happens to a \
function when the symbol \"x\" has been previously assigned a value before \
the function is defined using ",
 StyleBox["immediate assignment",
  FontVariations->{"Underline"->True}],
 " \[OpenCurlyDoubleQuote]=\[CloseCurlyDoubleQuote]:"
}], "Text",
 CellChangeTimes->{{3.389787388281*^9, 3.389787391774*^9}, {
  3.5231836035681114`*^9, 3.523183647263712*^9}}],

Cell[BoxData[
 RowBox[{"x", "=", "4"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", "x", "]"}], "=", 
  SqrtBox["x"]}]], "Input"],

Cell[" Observe how  g  is stored:", "Text"],

Cell["\<\
?? g
   Global`g
   g[4] = 2\
\>", "Program",
 CellChangeTimes->{{3.3900078300424*^9, 3.3900078740984*^9}}],

Cell[BoxData[
 RowBox[{"g", "[", "6", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"g", "[", "4", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"g", "[", "x", "]"}]], "Input"],

Cell[" Observe:", "Text"],

Cell["\<\
?? x
   Global`x
   x = 4\
\>", "Program",
 CellChangeTimes->{{3.3900079057344*^9, 3.3900079364594*^9}}],

Cell[BoxData[
 RowBox[{"x", "=", "6"}]], "Input"],

Cell[BoxData[
 RowBox[{"g", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"y", "=", "4"}]], "Input"],

Cell[BoxData[
 RowBox[{"g", "[", "y", "]"}]], "Input"],

Cell[TextData[{
 "Note that in the definition of this function, that it will only recognize \
an argument which is ",
 StyleBox["precisely",
  FontVariations->{"Underline"->True}],
 " the number 4."
}], "Text",
 CellChangeTimes->{{3.3897874631619997`*^9, 3.389787468302*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
   Why You MUST Use Pattern Matching:\
\>", "Subsection",
 CellChangeTimes->{{3.5231836980105114`*^9, 3.5231837003973117`*^9}}],

Cell[TextData[{
 "One way of eliminating the problems illustrated above is to use pattern \
matching (much more about this later) for the argument of the function rather \
than a specific symbol that can be reassigned a different value.  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s notation for matching any single object is  \"symbol_\"."
}], "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  SqrtBox["x"]}]], "Input"],

Cell[" Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
   RowBox[{"f", "\n", "\t", "\"\<Global`f\>\"", "\n", "\t", 
    RowBox[{"f", "[", "x_", "]"}]}], "=", 
   SqrtBox["x"]}]}]], "Program",
 CellChangeTimes->{
  3.389787514061*^9, {3.3900079663094*^9, 3.3900079679614*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "y", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "4", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "9", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"Sin", "[", "x", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.523183757633712*^9, 3.5231837645757113`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", 
      RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.5231837890521116`*^9, 3.5231838146673117`*^9}}],

Cell[TextData[{
 "Notice that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " now accepts ",
 StyleBox["any",
  FontVariations->{"Underline"->True}],
 " symbol, number or function and returns the corresponding square root.  The \
pattern matching \"_\" in the symbol  x_  is a dummy variable internal to ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "and ",
 "matches ANYTHING",
 ".\n\n Next, assign the symbol \"x\" a value of 4."
}], "Text",
 CellChangeTimes->{{3.389787572712*^9, 3.3897875853780003`*^9}, {
  3.5231838434337115`*^9, 3.5231838606561117`*^9}, {3.5231839008729115`*^9, 
  3.5231839371585116`*^9}}],

Cell[BoxData[
 RowBox[{"x", "=", "4"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "y", "]"}]], "Input"],

Cell["Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
   RowBox[{"f", "\n", "\t", "\"\<Global`f\>\"", "\n", "\t", 
    RowBox[{"f", "[", "x_", "]"}]}], "=", 
   SqrtBox["x"]}]}]], "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3897876376029997`*^9, 3.389787641209*^9}, {
  3.3900079827784*^9, 3.3900079843064003`*^9}}],

Cell["\<\
Observe that the function behaved as expected with its argument (even though \
the symbol \"x\" has an assigned value). \
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["   Why It Is Usually Better To Use Delayed Assignment:", "Subsection"],

Cell["\<\
The above method of using pattern recognition for the argument of a function \
and immediate assignment will sometimes give problems as illustrated in the \
following example. \
\>", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"x", "=", "4"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  SqrtBox["x"]}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "4", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "9", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "y", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"Sin", "[", "z", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.5231840413977118`*^9, 3.5231840467017117`*^9}}],

Cell[" Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
   RowBox[{"f", "\[IndentingNewLine]", "Global`f", "\[IndentingNewLine]", 
    RowBox[{"f", "[", "x", "]"}]}], "=", 
   SqrtBox["x"]}]}]], "Program",
 CellChangeTimes->{{3.3900080024063997`*^9, 3.3900080477024*^9}}],

Cell[TextData[{
 "Note by using immediate assignment \"=\", rather than delayed assignment \
\":=\", that the symbol for the argument on the right hand side of the \
assignment has been replaced with the symbol   4  and ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has performed an ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " evaluation to get  2.  This gives the undesired result that the square \
root of any symbol is always  2.  Notice that in the previous case, where the \
symbol for the argument was not specified before the function was defined, \
that we obtained the desired definition of the function and there was no \
problem.  Thus, it is perfectly OK to use immediate assignment (rather than \
delayed assignment) as long as you are ",
 StyleBox["absolutely",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["sure",
  FontVariations->{"Underline"->True}],
 " that ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " of the arguments have ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " been previously assigned values.  This can be accomplished by using the \
Clear[...] command on all of the arguments before you define a function using \
immediate assignment.  \n\nThe way around these problems is to use both \
delayed assignment \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[":=", TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\[CloseCurlyDoubleQuote] along with pattern recognition \
\[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "_"}]], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\[CloseCurlyDoubleQuote] for the arguments (which is almost always the \
usual procedure)."
}], "Text",
 CellChangeTimes->{{3.389787693354*^9, 3.389787693773*^9}, {3.389787857906*^9,
   3.389787865665*^9}, {3.523184104265712*^9, 3.5231841325641117`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"x", "=", "4"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  SqrtBox["x"]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"f", "[", "4", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "9", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "y", "]"}]], "Input"],

Cell["Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
   RowBox[{"f", "\n", "\t", "Global`f", "\n", "\t", 
    RowBox[{"f", "[", "x_", "]"}]}], ":=", 
   RowBox[{
    SqrtBox["x"], "\[IndentingNewLine]", "\n", 
    RowBox[{"??", 
     RowBox[{"x", "\n", "\t", "Global`x", "\n", "\t", 
      InterpretationBox[
       RowBox[{"x", "=", "4"}],
       InputForm[
        Definition[x]],
       AutoDelete->True,
       Editable->True]}]}]}]}]}]], "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{
  3.389788071041*^9, {3.3900080771334*^9, 3.3900080984754*^9}, 
   3.3985900140840807`*^9}],

Cell[TextData[{
 "Note that throughout the above illustration that the symbol \"x\" has been \
assigned the symbol  4.  However, there was ",
 StyleBox["never",
  FontVariations->{"Underline"->True}],
 " any confusion in the definition and application of the function.  Thus, it \
is almost always best to use pattern recognition for the arguments and \
delayed evaluation for the assignment."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["   Further Examples:", "Subsection"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[TextData[{
 "Why do you need to assign a local name \[OpenCurlyDoubleQuote]x\
\[CloseCurlyDoubleQuote] to an argument \[OpenCurlyDoubleQuote]x_\
\[CloseCurlyDoubleQuote]?\n\nConsider the case where a function has two \
arguments.  How would you keep the rhs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], " ", "+", " ", 
    SuperscriptBox["y", "3"]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " straight?"
}], "Text",
 CellChangeTimes->{{3.5231841921873116`*^9, 3.5231842543533115`*^9}, {
   3.5231843048973117`*^9, 3.5231843243193116`*^9}, 3.5231843567205114`*^9, {
   3.5231844290265117`*^9, 3.5231844777765117`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox["x", "2"], " ", "+", " ", 
   SuperscriptBox["y", "3"]}]}]], "InputOnly",
 CellChangeTimes->{3.5231843620089116`*^9}],

Cell[" Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
   RowBox[{"f", "\n", "\t", "Global`f", "\n", "\t", 
    RowBox[{"f", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}]}], ":=", 
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    SuperscriptBox["y", "3"]}]}]}]], "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{
  3.389788146998*^9, {3.3900081049294*^9, 3.3900081113564*^9}, 
   3.5231844033021116`*^9}],

Cell["\<\
You can now use your function of 2 arguments any way you want:\
\>", "Text",
 CellChangeTimes->{{3.5231845208637114`*^9, 3.5231845602225113`*^9}}],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Equal]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"y", "\[Equal]", "x"}]}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897881863269997`*^9, 3.3897882021070004`*^9}, 
   3.5231845025805116`*^9}],

Cell[TextData[{
 "\nNormally, your ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code would involve combining both internal and user defined functions step \
by step to construct the final desired result.\n\nFor example, combine the \
internal functions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", "...", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ",",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"Power", "[", "...", "]"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SuperscriptBox["...", "2"]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\[CloseCurlyDoubleQuote] and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", "...", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " along with user defined functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "...", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "[", "...", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.5231846207037115`*^9, {3.5231846510301113`*^9, 3.5231849907513113`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", "x_", "]"}], ":=", 
  SuperscriptBox[
   RowBox[{"Sin", "[", "x", "]"}], "2"]}]], "InputOnly",
 CellChangeTimes->{{3.523184757297312*^9, 3.523184759262912*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", "[", "y_", "]"}], ":=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"g", "[", "x", "]"}], ",", 
    RowBox[{"{", " ", 
     RowBox[{"x", ",", 
      RowBox[{
       RowBox[{"-", "y"}], "*", "\[Pi]"}], ",", 
      RowBox[{"y", "*", "\[Pi]"}]}], "}"}]}], "]"}]}]], "InputOnly"],

Cell[" Observe:", "Text"],

Cell["\<\
?? h
   Global`h
   h[y_] := Plot[g[x], {x, -y \[Pi], y \[Pi]}]\
\>", "Program",
 CellChangeTimes->{{3.3900081698354*^9, 3.3900082017944*^9}}],

Cell[BoxData[
 RowBox[{"h", "[", "1", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"h", "[", "2", "]"}]], "Input"],

Cell[TextData[{
 "\nYou may choose to eliminate defining some functions like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "...", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " by introducing more arguments into ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "[", 
    RowBox[{"...", ",", "..."}], "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ":"
}], "Text",
 CellChangeTimes->{{3.5231851125093117`*^9, 3.5231852039565115`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{3.5231852532993116`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{"y_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"z", "[", "x", "]"}], ",", 
    RowBox[{"{", " ", 
     RowBox[{"x", ",", 
      RowBox[{
       RowBox[{"-", "y"}], "*", "\[Pi]"}], ",", 
      RowBox[{"y", "*", "\[Pi]"}]}], "}"}]}], "]"}]}]], "InputOnly"],

Cell[" Observe:", "Text"],

Cell["\<\
?? h
   Global`h
   h[y_, z_] := Plot[z[x], {x, -y \[Pi], y \[Pi]}]\
\>", "Program",
 CellChangeTimes->{{3.390035412295*^9, 3.390035459285*^9}}],

Cell[BoxData[
 RowBox[{"h", "[", 
  RowBox[{"1", ",", "g"}], "]"}]], "Input",
 CellChangeTimes->{{3.5231852711925116`*^9, 3.5231852853729115`*^9}}],

Cell[BoxData[
 RowBox[{"h", "[", 
  RowBox[{"1", ",", "Sin"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"h", "[", 
  RowBox[{"2", ",", "Cos"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"h", "[", 
  RowBox[{"1", ",", "Exp"}], "]"}]], "Input"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Checking The Head of an Argument:", "Subtitle"]], \
"Section"],

Cell[TextData[{
 "It is possible to check the type (Head) of an argument within a function to \
determine which assigned value of the function is to be generated.\n\nThe \
general form is:\t\n\n\t\tf[arg_type]   \n\t\t\nand the function is evaluated \
(for this specific assignment) ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " when the \"head\" of an argument is ",
 StyleBox["exactly",
  FontVariations->{"Underline"->True}],
 " \"type\"."
}], "Text",
 CellChangeTimes->{{3.389788271742*^9, 3.38978829201*^9}, {
  3.5231853497853117`*^9, 3.523185385166112*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_Integer", "]"}], ":=", " ", 
  "\"\<x is an integer\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
  "\"\<x is not an integer\>\""}]], "InputOnly"],

Cell[TextData[{
 "Observe that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "...", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " has ",
 "multiple assignments",
 ":"
}], "Text",
 CellChangeTimes->{{3.5231854041201115`*^9, 3.5231854395321116`*^9}}],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
  "f", "\[IndentingNewLine]", "Global`f", "\[LineSeparator]", "\t", GridBox[{
     {
      RowBox[{
       RowBox[{"f", "[", "x_Integer", "]"}], ":=", 
       "\"\<x is an integer\>\""}]},
     {" "},
     {
      RowBox[{
       RowBox[{"f", "[", "x_", "]"}], ":=", "\"\<x is not an integer\>\""}]}
    },
    BaselinePosition->{Baseline, {1, 1}},
    GridBoxAlignment->{
     "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}},
    GridBoxItemSize->{"Columns" -> {{
         Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
      "RowsIndexed" -> {}}]}]}]], "Program",
 CellChangeTimes->{{3.39003551437*^9, 3.390035543123*^9}, {
  3.3900355763780003`*^9, 3.390035582877*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", "5", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "5", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", " ", "[", "5.5", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "5.5", "]"}]], "Input"],

Cell[TextData[{
 "Next, extend the definition of the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "...", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " with even more assignments:"
}], "Text",
 CellChangeTimes->{{3.5231854559277115`*^9, 3.5231854739457116`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_List", "]"}], ":=", 
  "\"\<x is a list\>\""}]], "InputOnly"],

Cell[" Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
  "f", "\[IndentingNewLine]", "Global`f", "\[IndentingNewLine]", GridBox[{
     {
      RowBox[{
       RowBox[{"f", "[", "x_Integer", "]"}], ":=", 
       "\"\<x is an integer\>\""}]},
     {" "},
     {
      RowBox[{
       RowBox[{"f", "[", "x_List", "]"}], ":=", "\"\<x is a list\>\""}]},
     {" "},
     {
      RowBox[{
       RowBox[{"f", "[", "x_", "]"}], ":=", "\"\<x is not an integer\>\""}]}
    },
    BaselinePosition->{Baseline, {1, 1}},
    GridBoxAlignment->{
     "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}},
    GridBoxItemSize->{"Columns" -> {{
         Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
      "RowsIndexed" -> {}}]}]}]], "Program",
 CellChangeTimes->{{3.390035611182*^9, 3.390035640006*^9}}],

Cell[BoxData[
 RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
    {"1", "2"},
    {"3", "4"}
   }], "\[NegativeThinSpace]", ")"}]], "Input"],

Cell[BoxData[
 RowBox[{"Head", "[", 
  RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
     {"1", "2"},
     {"3", "4"}
    }], "\[NegativeThinSpace]", ")"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
     {"1", "2"},
     {"3", "4"}
    }], "\[NegativeThinSpace]", ")"}], "]"}]], "Input"],

Cell["\<\

 Consider the somewhat incomplete definition of a differentiating function:\
\>", "Text",
 CellChangeTimes->{3.5231854821825113`*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"ddx", ",", "x", ",", "y"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ddx", "[", "y_Integer", "]"}], ":=", "0"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ddx", "[", "y_Sin", "]"}], ":=", 
  RowBox[{"Cos", "[", "x", "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ddx", "[", "y_Cos", "]"}], ":=", 
  RowBox[{"-", 
   RowBox[{"Sin", "[", "x", "]"}]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ddx", "[", "y_Power", "]"}], ":=", 
  SuperscriptBox["\[ExponentialE]", "x"]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ddx", "[", 
   RowBox[{"y1_", "+", "y2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"ddx", "[", "y1", "]"}], " ", "+", " ", 
   RowBox[{"ddx", "[", "y2", "]"}]}]}]], "InputOnly"],

Cell[" Observe:", "Text"],

Cell["?? ddx", "Program"],

Cell["Global`ddx", "Program",
 CellChangeTimes->{{3.390035718231*^9, 3.3900357245880003`*^9}}],

Cell[BoxData[
 InterpretationBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"ddx", "[", "y_Integer", "]"}], ":=", "0"}]},
       {" "},
       {
        RowBox[{
         RowBox[{"ddx", "[", "y_Sin", "]"}], ":=", 
         RowBox[{"Cos", "[", "x", "]"}]}]},
       {" "},
       {
        RowBox[{
         RowBox[{"ddx", "[", "y_Cos", "]"}], ":=", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "x", "]"}]}]}]},
       {" "},
       {
        RowBox[{
         RowBox[{"ddx", "[", "y_Power", "]"}], ":=", 
         SuperscriptBox["\[ExponentialE]", "x"]}]},
       {" "},
       {
        RowBox[{
         RowBox[{"ddx", "[", 
          RowBox[{"y1_", "+", "y2_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"ddx", "[", "y1", "]"}], "+", 
          RowBox[{"ddx", "[", "y2", "]"}]}]}]}
      },
      BaselinePosition->{Baseline, {1, 1}},
      GridBoxAlignment->{
       "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
        "RowsIndexed" -> {}},
      GridBoxItemSize->{"Columns" -> {{
           Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
        "RowsIndexed" -> {}}]}
   },
   BaselinePosition->{Baseline, {1, 1}},
   GridBoxAlignment->{
    "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
     "RowsIndexed" -> {}}],
  Definition["ddx"],
  Editable->False]], "Program",
 CellChangeTimes->{3.3900071450324*^9},
 CellTags->"Info3389989144-7989455"],

Cell["\<\

Check the heads of the following functions:\
\>", "Text",
 CellChangeTimes->{{3.523185513148512*^9, 3.5231855296221113`*^9}}],

Cell[BoxData[
 RowBox[{"Head", "[", 
  RowBox[{"Sin", "[", "x", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Head", "[", 
  RowBox[{"Cos", "[", "x", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Head", "[", 
  SuperscriptBox["\[ExponentialE]", "x"], "]"}]], "Input"],

Cell["\<\

Therefore:\
\>", "Text",
 CellChangeTimes->{3.5231855356437116`*^9}],

Cell[BoxData[
 RowBox[{"ddx", "[", 
  RowBox[{"Sin", "[", "x", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"ddx", "[", 
  SuperscriptBox["\[ExponentialE]", "x"], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"ddx", "[", " ", 
  RowBox[{"123", " ", "+", " ", 
   SuperscriptBox["\[ExponentialE]", "x"], " ", "+", " ", 
   RowBox[{"Sin", "[", "x", "]"}], "+", " ", 
   RowBox[{"Cos", "[", "x", "]"}]}], " ", "]"}]], "Input"],

Cell["\<\

 Also note the following:\
\>", "Text",
 CellChangeTimes->{3.523185540869712*^9}],

Cell[BoxData[
 RowBox[{"ddx", "[", 
  RowBox[{"Sin", "[", 
   SuperscriptBox["y", "2"], "]"}], "]"}]], "Input"],

Cell[TextData[{
 "\n  The above assignments check ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " the head of the incoming function \[OpenCurlyDoubleQuote]Sin\
\[CloseCurlyDoubleQuote] (and not the argument",
 " \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", 
    RowBox[{"2", " "}]], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\[CloseCurlyDoubleQuote]",
 " contained within that function).  Therefore, the above example is not \
complete and does not handle the argument ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " correctly."
}], "Text",
 CellChangeTimes->{{3.389788436632*^9, 3.389788490502*^9}, {
  3.5231855461425114`*^9, 3.5231856547965117`*^9}, {3.5231856879621115`*^9, 
  3.5231857909845114`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Type Checking With Logical Boolean Functions:", \
"Subtitle"]], "Section"],

Cell["\<\
Many times it is desirable to check for a type that does not precisely \
correspond to the head of the argument that you want to use in a function.  \
For example, many times you want your function to be defined for any number \
(integer, rational, real or complex) rather than just for the integers (or \
rationals or reals etc.).  It is possible to use the logical Boolean \
functions (which return a True or False value) to determined which assignment \
of a function is to be applied.

The general form is:\t

\t\tf[arg_?test], 
\t\t
where  test[arg]  is a Boolean function and returns a True or False value.  \
f[arg_?test]  is evaluated when test[arg] is True, and is not evaluated when \
test[arg] is False.\
\>", "Text",
 CellChangeTimes->{{3.523185852292512*^9, 3.5231858532129116`*^9}}],

Cell[BoxData[
 RowBox[{"Clear", " ", "[", 
  RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
  "]"}]], "InputOnly"],

Cell["\<\
 Observe that most Boolean functions end in Q, however some do not (Positive, \
Negative, Etc.):\
\>", "Text"],

Cell["?? *Q", "Program"],

Cell["\<\
ArgumentCountQ       MatrixQ
AtomQ                MemberQ
DigitQ               NameQ
EllipticNomeQ        NumberQ
EvenQ                NumericQ
ExactNumberQ         OddQ
FreeQ                OptionQ
HypergeometricPFQ    OrderedQ
InexactNumberQ       PartitionsQ
IntegerQ             PolynomialQ
IntervalMemberQ      PrimeQ
InverseEllipticNomeQ SameQ
LegendreQ            StringMatchQ
LetterQ              StringQ
LinkConnectedQ       SyntaxQ
LinkReadyQ           TrueQ
ListQ                UnsameQ
LowerCaseQ           UpperCaseQ
MachineNumberQ       ValueQ
MatchLocalNameQ      VectorQ
MatchQ\
\>", "Program"],

Cell[" Observe:", "Text"],

Cell[CellGroupData[{

Cell["\<\
NumberQ[expr] gives True if expr is a number, and False otherwise.\
\>", "Item",
 CellChangeTimes->{3.39003579673*^9, {3.390035827317*^9, 3.390035837225*^9}}],

Cell["\<\
ListQ[expr] gives True if expr is a list, and False otherwise.\
\>", "Item",
 CellChangeTimes->{3.39003579673*^9, {3.390035827317*^9, 3.390035852678*^9}}],

Cell["\<\
IntegerQ[expr] gives True if expr is an integer, and False otherwise.\
\>", "Item",
 CellChangeTimes->{3.39003579673*^9, {3.390035827317*^9, 3.390035861922*^9}}]
}, Open  ]],

Cell[" Consider the following example:", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "IntegerQ"}], "]"}], ":=", " ", 
  "\"\<x is an integer\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "NumberQ"}], "]"}], ":=", " ", 
  "\"\<x is a number (not an integer)\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "ListQ"}], "]"}], ":=", "  ", 
  "\"\<x is a list\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "StringQ"}], "]"}], ":=", "  ", 
  "\"\<x is a string\>\""}]], "InputOnly"],

Cell[" Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
  "f", "\[IndentingNewLine]", "Global`f", "\[IndentingNewLine]", GridBox[{
     {
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x_", "?", "IntegerQ"}], "]"}], ":=", 
       "\"\<x is an integer\>\""}]},
     {" "},
     {
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x_", "?", "NumberQ"}], "]"}], ":=", 
       "\"\<x is a number (not an integer)\>\""}]},
     {" "},
     {
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x_", "?", "ListQ"}], "]"}], ":=", "\"\<x is a list\>\""}]},
     {" "},
     {
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x_", "?", "StringQ"}], "]"}], ":=", "\"\<x is a string\>\""}]}
    },
    BaselinePosition->{Baseline, {1, 1}},
    GridBoxAlignment->{
     "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}},
    GridBoxItemSize->{"Columns" -> {{
         Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
      "RowsIndexed" -> {}}]}]}]], "Program",
 CellChangeTimes->{{3.390035880351*^9, 3.390035926756*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", "5", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"3", "+", 
   RowBox[{"4", " ", "\[ImaginaryI]"}]}], "]"}]], "Input",
 CellChangeTimes->{3.389788576446*^9}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
     {"1"},
     {"2"}
    }], "\[NegativeThinSpace]", ")"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "\"\<example of a string\>\"", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"Sin", "[", "1", "]"}], "]"}]], "Input"],

Cell[TextData[{
 "\n",
 StyleBox["Note that correct syntax does NOT allow for spaces between \
\[OpenCurlyDoubleQuote]x\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]_\
\[CloseCurlyDoubleQuote]:",
  FontSize->14,
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.5231859514773116`*^9, 3.5231860589613113`*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x"}], "]"}]], "InputOnly",
 CellChangeTimes->{3.5231860976493115`*^9}],

Cell["\<\
Incorrectly insert a space between \[OpenCurlyDoubleQuote]x\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]_\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.5231866046325116`*^9, 3.5231866259109116`*^9}, 
   3.5231866587177114`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x", " ", "_"}], "]"}], ":=", 
  SuperscriptBox["x", "2"]}]], "InputOnly",
 CellChangeTimes->{3.5231860976493115`*^9, 3.5231861694093113`*^9}],

Cell["It does not work!", "Text",
 CellChangeTimes->{{3.5231866420257115`*^9, 3.5231866519941115`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", "4", "]"}]], "Input",
 CellChangeTimes->{{3.523186176507312*^9, 3.5231861819205112`*^9}}],

Cell["\<\

Check why this did NOT work:\
\>", "Text",
 CellChangeTimes->{{3.523186203510912*^9, 3.523186224758112*^9}}],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{"f", "\n", "      ", "Global`f", "\n", "  ", 
   InterpretationBox[GridBox[{
      {GridBox[{
         {
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"x", " ", "_"}], "]"}], ":=", 
           SuperscriptBox["x", "2"]}]}
        },
        BaselinePosition->{Baseline, {1, 1}},
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{"Columns" -> {{
             Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
          "RowsIndexed" -> {}}]}
     },
     BaselinePosition->{Baseline, {1, 1}},
     GridBoxAlignment->{
      "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
       "RowsIndexed" -> {}}],
    Definition[$CellContext`f],
    Editable->False]}]}]], "Text",
 CellChangeTimes->{{3.523186231809312*^9, 3.5231863065957117`*^9}, {
  3.523186346921712*^9, 3.523186427958912*^9}},
 CellTags->"Info3523168348-3174645"],

Cell["\<\
The above looks OK, but note the space between \[OpenCurlyDoubleQuote]x\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]_\[CloseCurlyDoubleQuote].

Try out the following:\
\>", "Text",
 CellChangeTimes->{{3.5231864434065113`*^9, 3.5231864959005117`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"x", " ", "_"}], "]"}]], "Input",
 CellChangeTimes->{{3.5231865010485115`*^9, 3.5231865257745113`*^9}}],

Cell["\<\

Which works.

And\
\>", "Text",
 CellChangeTimes->{{3.5231865404853115`*^9, 3.5231865415617113`*^9}, {
  3.5231867573721113`*^9, 3.5231867694309115`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"x", " ", "something"}], "]"}]], "Input",
 CellChangeTimes->{{3.5231863088265114`*^9, 3.5231863091385117`*^9}, {
  3.5231865480981116`*^9, 3.5231865673485117`*^9}}],

Cell["\<\

Which works.

And\
\>", "Text",
 CellChangeTimes->{{3.5231867092305117`*^9, 3.5231867126781116`*^9}, {
  3.5231867750313115`*^9, 3.5231867800233116`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"4", " ", "something"}], "]"}]], "Input",
 CellChangeTimes->{{3.523186729619712*^9, 3.5231867450169115`*^9}}],

Cell["\<\

Which does not work.  Why?\
\>", "Text",
 CellChangeTimes->{{3.5231867893365116`*^9, 3.5231868067929115`*^9}}],

Cell[TextData[{
 "\n",
 StyleBox["Note that correct syntax does NOT allow for spaces between \
\[OpenCurlyDoubleQuote]",
  FontSize->14,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["x_", TraditionalForm]],
  FormatType->"TraditionalForm",
  FontWeight->"Bold"],
 StyleBox["\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]?test\
\[CloseCurlyDoubleQuote] or between \[OpenCurlyDoubleQuote]",
  FontSize->14,
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["?", TraditionalForm]],
  FormatType->"TraditionalForm",
  FontWeight->"Bold"],
 StyleBox["\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]test\
\[CloseCurlyDoubleQuote].  If you put them there, they will ",
  FontSize->14,
  FontWeight->"Bold"],
 StyleBox["AUTOMATICALLY",
  FontWeight->"Bold"],
 StyleBox[" be removed.",
  FontSize->14,
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.5231859514773116`*^9, 3.5231860589613113`*^9}, {
  3.5231868733581114`*^9, 3.5231868811581116`*^9}, {3.5231870503869114`*^9, 
  3.5231870509017115`*^9}, {3.5231872833417115`*^9, 3.5231873586273117`*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x"}], "]"}]], "InputOnly",
 CellChangeTimes->{3.5231860976493115`*^9}],

Cell[TextData[{
 "Incorrectly insert a spaces between between \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox["x_", TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox["?", TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox["test", TraditionalForm]],
  FormatType->"TraditionalForm"],
 "\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.5231866046325116`*^9, 3.5231866259109116`*^9}, 
   3.5231866587177114`*^9, {3.5231869145265117`*^9, 3.5231869155561113`*^9}, {
   3.5231869743681116`*^9, 3.5231870115897117`*^9}, {3.5231870595285115`*^9, 
   3.5231870618373117`*^9}, {3.5231873710293117`*^9, 3.5231873963637114`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "     ", "?", "     ", "EvenQ"}], "]"}], ":=", 
  "\"\<x is even!\>\""}]], "InputOnly",
 CellChangeTimes->{
  3.5231860976493115`*^9, 3.5231861694093113`*^9, {3.5231870694345117`*^9, 
   3.523187078217312*^9}, {3.5231871099321117`*^9, 3.523187135406912*^9}, 
   3.523187171130912*^9, 3.5231872481325116`*^9, {3.5231874008877115`*^9, 
   3.5231874076425114`*^9}}],

Cell["It will work!", "Text",
 CellChangeTimes->{{3.5231866420257115`*^9, 3.5231866519941115`*^9}, {
  3.5231874201849117`*^9, 3.5231874212301116`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", "4", "]"}]], "Input",
 CellChangeTimes->{{3.5231874506517115`*^9, 3.5231874533973117`*^9}}],

Cell["\<\

Check why this works:\
\>", "Text",
 CellChangeTimes->{{3.523186203510912*^9, 3.523186224758112*^9}, {
  3.5231875993309116`*^9, 3.5231876002669115`*^9}}],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{"f", "\n", "      ", "Global`f", "\n", " ", 
   InterpretationBox[GridBox[{
      {GridBox[{
         {
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", "\"\<x is even!\>\""}]}
        },
        BaselinePosition->{Baseline, {1, 1}},
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{"Columns" -> {{
             Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
          "RowsIndexed" -> {}}]}
     },
     BaselinePosition->{Baseline, {1, 1}},
     GridBoxAlignment->{
      "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
       "RowsIndexed" -> {}}],
    Definition[$CellContext`f],
    Editable->False]}]}]], "Text",
 CellChangeTimes->{{3.5231875383973117`*^9, 3.5231875745269117`*^9}},
 CellTags->"Info3523169542-3174645"],

Cell["\<\
Verify that the above assignment has had ALL of the spaces removed!

The above examples illustrate that you must be careful with syntax!\
\>", "Text",
 CellChangeTimes->{{3.5231864434065113`*^9, 3.5231864959005117`*^9}, {
  3.5231876211241117`*^9, 3.5231876839453115`*^9}, {3.5231877224773116`*^9, 
  3.523187764581712*^9}}]
