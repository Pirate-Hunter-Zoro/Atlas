Cell["\<\
  
   Here is an example which has a test based on both functional arguments:\
\>", "Text",
 CellChangeTimes->{{3.3897890481549997`*^9, 3.389789052002*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", 
        RowBox[{" ", "2"}]], " ", "+", " ", 
       SuperscriptBox["y", "2"]}], ")"}]}]], "  ", "/;", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", 
       RowBox[{" ", "2"}]], " ", "+", " ", 
      SuperscriptBox["y", "2"]}], ")"}], "\[LessEqual]", 
    "1"}]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"0", "                             ", "/;", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", 
       RowBox[{" ", "2"}]], " ", "+", " ", 
      SuperscriptBox["y", "2"]}], ")"}], ">", "1"}]}]}]], "InputOnly"],

Cell[" Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
  "g", "\[IndentingNewLine]", "Global`g", "\[IndentingNewLine]", GridBox[{
     {
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "2"], "+", 
            SuperscriptBox["y", "2"]}], ")"}]}]], "/;", 
        RowBox[{
         RowBox[{
          SuperscriptBox["x", "2"], "+", 
          SuperscriptBox["y", "2"]}], "\[LessEqual]", "1"}]}]}]},
     {" "},
     {
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
       RowBox[{"0", "/;", 
        RowBox[{
         RowBox[{
          SuperscriptBox["x", "2"], "+", 
          SuperscriptBox["y", "2"]}], ">", "1"}]}]}]}
