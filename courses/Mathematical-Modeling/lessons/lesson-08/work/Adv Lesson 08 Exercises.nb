Cell["\<\
12: Repeat exercise 6 using a conditional application of a rule.\
\>", "Text",ExpressionUUID->"1b7d7419-29aa-4615-9e4d-6a2ccf658e4b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "rule6"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rule6", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n_", "\[RuleDelayed]", 
      RowBox[{
       RowBox[{"Sin", "[", "n", "]"}], "/;", 
       RowBox[{"n", ">", "0"}]}]}], ",", 
     RowBox[{"n_", "\[RuleDelayed]", 
      RowBox[{"-", 
       RowBox[{"Sin", "[", "n", "]"}]}]}]}], "}"}]}], ";"}]}], "Input",Express\
ionUUID->"dbb9b7b6-eeef-4d5f-8872-adc82e65b950"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
