  RowBox[{
   RowBox[{"-", 
    RowBox[{"Sin", "[", "x", "]"}]}], "/;", 
   RowBox[{"x", "\[LessEqual]", "0"}]}]}]}], "Input",ExpressionUUID->\
"018be57d-b6f0-4d49-aa73-22f365dabeb2"],

