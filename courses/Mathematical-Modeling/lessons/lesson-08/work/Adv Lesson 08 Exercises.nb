   RowBox[{"f", ",", "x", ",", "values"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_Integer", "]"}], ":=", 
   SuperscriptBox["x", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_Rational", "]"}], ":=", 
   SuperscriptBox["x", "3"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", "x"}]}], "Input",ExpressionUUID->\
"e0fa2b68-4805-4392-9a3c-6755417dcd00"],

Cell["??f", "Input",ExpressionUUID->"43ebec61-d05a-4dd4-a3a7-5a1f9fcf5dd1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    FractionBox["3", "5"], "]"}], ",", 
   RowBox[{"f", "[", "3", "]"}], ",", 
   RowBox[{"f", "[", 
    FractionBox["4", "2"], "]"}], ",", 
   RowBox[{"f", "[", "3.1`", "]"}]}], "}"}]], "Input",ExpressionUUID->\
"44d89691-f15c-4c30-b4e2-a3428e20523e"],

Cell[BoxData[
 RowBox[{"values", "=", 
  RowBox[{"Table", "[", 
