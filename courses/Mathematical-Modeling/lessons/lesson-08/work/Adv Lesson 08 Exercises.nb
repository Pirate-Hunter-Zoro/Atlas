Notebook[{
Cell["\<\
Advanced Lesson 8 - Exercises: Pattern Matching and Conditional Definitions
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"8455af48-1f28-4cd0-9ac1-c9f75b1576fd"],

Cell["1: Why pattern matching belongs in functional arguments", "Section",ExpressionUUID->"501a8b05-802c-44cb-ba63-1aeff518cc15"],

Cell["\<\
Part 1. A definition written without a pattern, f[x] = x^2, attaches to the
single symbol x and to nothing else. It is not a function; it is a stored
value for one particular expression. Writing f[x_] = x^2 attaches to the
pattern \"any one argument\", which is what a function of one variable
actually means. Pattern matching is how a definition says which calls it
applies to, and without it a definition applies to exactly one call.\
\>", "Text",ExpressionUUID->"b2ccf830-f065-451d-88f2-61dc4d3eda57"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"g", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x", "]"}], "=", 
   RowBox[{"Sin", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"g", "[", "x", "]"}], ",", 
   RowBox[{"g", "[", "y", "]"}], ",", 
   RowBox[{"g", "[", "0", "]"}], ",", 
   RowBox[{"g", "[", 
    FractionBox["\[Pi]", "2"], "]"}]}], "}"}]}], "Input",ExpressionUUID->\
"d6e67516-35d1-4760-94de-13df811b93a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"g", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], "=", 
   RowBox[{"Sin", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"g", "[", "x", "]"}], ",", 
   RowBox[{"g", "[", "y", "]"}], ",", 
   RowBox[{"g", "[", "0", "]"}], ",", 
   RowBox[{"g", "[", 
    FractionBox["\[Pi]", "2"], "]"}]}], "}"}]}], "Input",ExpressionUUID->\
"3eddecea-2f45-442e-a33e-a954b221c2be"],

Cell["2: Why delayed assignment belongs in functional definitions", "Section",ExpressionUUID->"5cff3145-f495-4110-9d4b-a5558ce248a3"],

Cell["\<\
Part 1. Immediate assignment evaluates the right-hand side once, at
definition time, when the pattern variable is still a bare symbol. Any
right-hand side whose meaning depends on the argument having a value - a
derivative, an integral, a random draw, a conditional test, a loop - is
therefore computed against the wrong thing and frozen. Delayed assignment
stores the right-hand side unevaluated and re-evaluates it per call, which
is what a function body is supposed to do.\
\>", "Text",ExpressionUUID->"dc51d098-3efa-4c8b-893e-d0d859c94259"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"h1", ",", "h2", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h1", "[", "x_", "]"}], "=", 
   RowBox[{"Length", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h2", "[", "x_", "]"}], ":=", 
   RowBox[{"Length", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"h1", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], ",", 
   RowBox[{"h2", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}], "}"}]}], "Input",Expre\
ssionUUID->"f784f4e6-ffdd-4072-9c9f-bec538676ad4"],

Cell["\<\
3: Squares of integers, cubes of rationals, everything else unchanged\
\>", "Section",ExpressionUUID->"f718d422-4dd7-45bb-94a0-9c49abd2bf80"],

Cell[BoxData[{
 RowBox[{
