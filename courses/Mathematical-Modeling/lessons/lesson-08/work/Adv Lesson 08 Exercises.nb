Cell["6: A sign-switched sine, via Boolean tests", "Section",ExpressionUUID->"e73b82dc-de89-46d7-a662-8227e126b6ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "/;", 
    RowBox[{"Positive", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Sin", "[", "x", "]"}]}], "/;", 
   RowBox[{"!", 
    RowBox[{"Positive", "[", "x", "]"}]}]}]}]}], "Input",ExpressionUUID->\
"914f04b0-6eb9-4d4f-92ad-af36f04b29e2"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], "]"}]], "Input",Expressi\
onUUID->"849a42d3-4d3a-4e02-bf61-70829aa164d6"],

Cell["7: Exercise 3 again, using conditional evaluation", "Section",ExpressionUUID->"9a4e3663-df09-408c-8228-fd5d0c08530f"],

