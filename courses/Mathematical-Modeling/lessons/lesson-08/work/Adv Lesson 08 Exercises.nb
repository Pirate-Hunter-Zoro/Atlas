    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"f", "[", "x", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "5", ",", 
      FractionBox["1", "2"]}], "}"}]}], "]"}]}]], "Input",ExpressionUUID->\
"87b5a410-d35f-44d0-b98d-366d2bd0fdb6"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "values", "]"}]], "Input",ExpressionUUID->"a3513264-fbf4-4484-9149-c972ba3119b8"],

Cell["4: NumberQ against NumericQ", "Section",ExpressionUUID->"75cf2982-81e2-4704-a705-4ed87858dcde"],

Cell[BoxData[{
