      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["\[ExponentialE]", "x"]}], ")"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}]], "Input",ExpressionUUID->\
