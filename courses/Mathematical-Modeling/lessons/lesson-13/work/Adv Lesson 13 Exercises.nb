Cell[TextData[{
 "3: Construct a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "...", ",", "xn"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"a7544663-0f60-4839-bbd3-bb4bfed0432b"],
 " which will accept a ",
 StyleBox["Sequence",
  FontVariations->{"Underline"->True}],
 " of expressions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", ",", "x2", ",", "x3", ",", "...", ",", "xn"}], 
   TraditionalForm]],ExpressionUUID->"9740f36f-5d87-4e02-990c-b1336a0b006c"],
 " (i.e. not a list) and display a ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of a list of both the unevaluated and evaluated form of each element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"xi", ",", " ", 
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], TraditionalForm]],
  ExpressionUUID->"df48d1f0-5046-4fe5-b069-1ea045bbf4a2"],
 " .\n\n\tTest your function:\n\t\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", " ", 
     RowBox[{
      RowBox[{"N", "[", "\[Pi]", "]"}], ",", 
      RowBox[{"1", "+", "2"}], ",", 
      RowBox[{"a", "*", 
       SuperscriptBox["a", "2"]}], ",", 
      RowBox[{"a", "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], ")"}]}]}], " ", "]"}], " "}], 
   TraditionalForm]],ExpressionUUID->"115003ac-1941-4ea1-a222-04db02e2c573"],
 "\n\t\t\n\t\t",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"N", "[", "\[Pi]", "]"}],
       HoldForm], ",", "3.141592653589793`"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"1", "+", "2"}],
       HoldForm], ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"a", " ", 
        SuperscriptBox["a", "2"]}],
       HoldForm], ",", 
      SuperscriptBox["a", "3"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"a", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "a"}], ")"}]}],
       HoldForm], ",", 
      RowBox[{"a", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], ")"}]}]}], "}"}]}], "}"}]],ExpressionUUID->
  "ea9066dd-c715-4aa5-b4c3-2ad93a7870a3"],
 "\n\t\n\tand:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", " ", 
     RowBox[{
      RowBox[{"N", "[", "\[Pi]", "]"}], ",", 
      RowBox[{"1", "+", "2"}], ",", 
      RowBox[{"a", "*", 
       SuperscriptBox["a", "2"]}], ",", 
      RowBox[{"a", "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], ")"}]}]}], " ", "]"}], "  ", "//", 
    "TableForm"}], TraditionalForm]],ExpressionUUID->
  "de019585-3cee-4680-b9fd-72e74488ccef"],
 "\n\n\t\t",
 Cell[BoxData[GridBox[{
    {
     TagBox[
      RowBox[{"N", "[", "\[Pi]", "]"}],
      HoldForm], "3.141592653589793`"},
    {
     TagBox[
      RowBox[{"1", "+", "2"}],
      HoldForm], "3"},
    {
     TagBox[
      RowBox[{"a", " ", 
       SuperscriptBox["a", "2"]}],
      HoldForm], 
     SuperscriptBox["a", "3"]},
    {
     TagBox[
      RowBox[{"a", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], ")"}]}],
      HoldForm], 
     RowBox[{"a", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "a"}], ")"}]}]}
   },
   GridBoxAlignment->{
    "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
     "RowsIndexed" -> {}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[2.0999999999999996`]}, 
       Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}, "RowsIndexed" -> {}}]],ExpressionUUID->
  "f06db06d-b893-41f3-a2b6-b166f8f7cc0d"],
 "\n\t\t\n\t(No hints will be given for this problem.)"
}], "Text",ExpressionUUID->"0bde6475-37e8-4c4d-b021-9f83ceae9390"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "a"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"f", ",", "HoldAll"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "args___", "]"}], ":=", 
  RowBox[{"List", "@@", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"u", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", "u", "]"}], ",", "u"}], "}"}], ",", 
      "HoldAll"}], "]"}], "/@", 
    RowBox[{"Hold", "[", "args", "]"}]}]}]}]}], "Input",ExpressionUUID->\
"19c2aae6-b265-4b21-b2b4-2e5a8a7dbd9f"],

