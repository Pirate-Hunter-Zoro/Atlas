Notebook[{
Cell["\<\
Advanced Lesson 13 - Exercises: Trace and Held Evaluation
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"ed741eb5-2af6-463a-be47-d471f890060b"],

Cell["1: Tracing differentiation and integration", "Section",ExpressionUUID->"48136a24-ff72-409a-a8cc-d94d6c704abf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], 
   SuperscriptBox["x", "2"]}], "]"}]}], "Input",ExpressionUUID->"9b6fb392-\
e054-4110-aa99-9701bea95d6c"],

Cell[BoxData[
 RowBox[{"Trace", "[", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], "2"]}], "]"}]], "Input",ExpressionUUID->\
"a8bd1212-ee82-4144-895d-0be270ea4b93"],

Cell[BoxData[
 RowBox[{"Trace", "[", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "1"}], ")"}], "2"]}], "]"}]], "Input",ExpressionUUID->\
"9a670321-6746-42d8-a8ed-64cbff0eaa75"],

Cell[BoxData[
 RowBox[{"Trace", "[", 
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "+", 
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["\[ExponentialE]", "x"]}], ")"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}]], "Input",ExpressionUUID->\
"e72a2079-e66b-4ad4-aa6d-140ee8c911f4"],

Cell[BoxData[
 RowBox[{"Trace", "[", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], 
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}], "2"], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], "]"}]], "Input",ExpressionUUID->\
"31847a89-d0bc-4352-8993-94407a887324"],

Cell["2: Tracing immediate against delayed replacement rules", "Section",ExpressionUUID->"be355dfb-ca5a-40af-bddf-ead07f3313dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "a", "]"}], "/.", "\[VeryThinSpace]", 
   RowBox[{"a", "\[Rule]", "b"}]}], "]"}]}], "Input",ExpressionUUID->\
"f01b6ac2-891e-49c4-9d87-f591e2e33ee1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "a", "]"}], "/.", "\[VeryThinSpace]", 
   RowBox[{"a", "\[Rule]", "b"}]}], "]"}]}], "Input",ExpressionUUID->\
"380a61be-1011-456d-91bc-16f763ec3510"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "a", "]"}], "/.", "\[VeryThinSpace]", 
   RowBox[{"a", "\[Rule]", "b"}]}], "]"}]}], "Input",ExpressionUUID->\
"12e1d577-a008-4807-98c0-0389dc16edd5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "a", "]"}], "/.", "\[VeryThinSpace]", 
   RowBox[{"a", "\[RuleDelayed]", "b"}]}], "]"}]}], "Input",ExpressionUUID->\
"b81587a6-306b-46e1-a275-a8ca7c04b07b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "a", "]"}], "/.", "\[VeryThinSpace]", 
   RowBox[{"a", "\[RuleDelayed]", "b"}]}], "]"}]}], "Input",ExpressionUUID->\
"e094775f-9076-41a1-9272-08e949e20314"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "a", "]"}], "/.", "\[VeryThinSpace]", 
   RowBox[{"a", "\[RuleDelayed]", "b"}]}], "]"}]}], "Input",ExpressionUUID->\
"1722f0b5-1cf0-4d9d-9d49-2977b5793b37"],

Cell["\<\
3: Displaying arguments unevaluated and evaluated, side by side\
\>", "Section",ExpressionUUID->"2b3349c4-737a-496d-9f2f-7c48adf2e477"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "a"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"f", ",", "HoldAll"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "args___", "]"}], ":=", 
  RowBox[{"List", "@@", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"u", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", "u", "]"}], ",", "u"}], "}"}], ",", 
      "HoldAll"}], "]"}], "/@", 
    RowBox[{"Hold", "[", "args", "]"}]}]}]}]}], "Input",ExpressionUUID->\
"19c2aae6-b265-4b21-b2b4-2e5a8a7dbd9f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "a", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"f", "[", 
  RowBox[{
   RowBox[{"N", "[", "\[Pi]", "]"}], ",", 
   RowBox[{"1", "+", "2"}], ",", 
   RowBox[{"a", " ", 
    SuperscriptBox["a", "2"]}], ",", 
   RowBox[{"a", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "a"}], ")"}]}]}], "]"}]}], "Input",ExpressionUUID->\
"d3bb353b-303f-4e59-8bb6-6645a206fa4f"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{"f", "[", 
   RowBox[{
    RowBox[{"N", "[", "\[Pi]", "]"}], ",", 
    RowBox[{"1", "+", "2"}], ",", 
    RowBox[{"a", " ", 
     SuperscriptBox["a", "2"]}], ",", 
    RowBox[{"a", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "a"}], ")"}]}]}], "]"}], "]"}]], "Input",ExpressionUUI\
D->"abcc16c1-7fa5-4c23-b1bf-fb53bc0bfdff"]
