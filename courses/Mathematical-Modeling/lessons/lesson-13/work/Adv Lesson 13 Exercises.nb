 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"7b4af81d-74db-498a-9676-240d7cb5e586"],

Cell[TextData[{
 "1: Use the Trace command to analyze the intermediate steps in the following \
commands:\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], "  ", 
    FormBox[
     SuperscriptBox[
      RowBox[{"x", " "}], "2"],
     TraditionalForm]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"354b8be4-e219-46b4-bb70-d9bb693ff9c7"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], "2"]}]],
  FontWeight->"Bold",ExpressionUUID->"3c027b6d-1ee3-49e1-8020-a1dafeed39d9"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "1"}], ")"}], "2"]}]],
  FontWeight->"Bold",ExpressionUUID->"e31b211b-9b18-49ec-b650-79058e3f0989"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "+", 
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["E", "x"]}], ")"}], 
    RowBox[{"\[DifferentialD]", "x"}], " "}]}]],
  FontWeight->"Bold",ExpressionUUID->"97dde986-ff84-4154-97dd-2033b20beb9d"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], " ", 
   RowBox[{"(", 
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "2"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], ")"}]}]],
  FontWeight->"Bold",ExpressionUUID->"fe2c8fc9-5d9c-4027-bdbf-0d2dbf4da1e0"],
 StyleBox["\t",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"b53f8111-5675-4f9d-ac29-b2e0203a2e3b"],

