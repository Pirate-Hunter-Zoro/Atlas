     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}], "2"], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], "]"}]], "Input",ExpressionUUID->\
"31847a89-d0bc-4352-8993-94407a887324"],

Cell["\<\
2: Use the Trace command to analyze the intermediate steps in the following \
commands:
Part 1:
\tClear[a,b]
\tTrace[ Sin[a] /. a \[Rule]b]
Part 2:
\tClear[a,b]
\tb=5
\tTrace[ Sin[a] /. a \[Rule]b]
Part 3:
\tClear[a,b]
\ta=2
\tb=5
\tTrace[ Sin[a] /. a \[Rule]b]
Part 4:
\tClear[a,b]
\tTrace[ Sin[a] /. a \[RuleDelayed]b]
Part 5:
\tClear[a,b]
\tb=5
\tTrace[ Sin[a] /. a \[RuleDelayed]b]
Part 6:
\tClear[a,b]
\ta=2
\tb=5
\tTrace[ Sin[a] /. a \[RuleDelayed]b]\t 
Observe that the lhs of a \[RuleDelayed]b is not held, however replacing \
\"a\" in both the expression Sin[a] and the lhs of the delayed replacement \
rule has no effect upon the final answer.\
\>", "Text",ExpressionUUID->"557b18e0-3978-4f00-b707-b64f7a22427e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "a", "]"}], "/.", "\[VeryThinSpace]", 
   RowBox[{"a", "\[Rule]", "b"}]}], "]"}]}], "Input",ExpressionUUID->\
"f01b6ac2-891e-49c4-9d87-f591e2e33ee1"],

