Cell["\<\

\t?y1\t\t?y2\t\t    \[ShortLeftArrow] Ask for information on y1 and y2 
\tGlobal`y1\tGlobal`y2
\ty1=x1New\ty=x2\t\t    \[ShortLeftArrow] Immediate assignments to y1 and y2 \
have been made\
\>", "Text"],

Cell[TextData[{
 " \n",
 StyleBox["Objective",
  FontVariations->{"Underline"->True}],
 ": Make multiple delayed assignments (i.e. \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\") when some of the arguments on both the left-hand side and right-hand \
side have assigned values.\nNext, the FullForm of  \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" is:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hold", "[", 
   RowBox[{"lhs", ":=", "rhs"}], "]"}], " ", "//", "FullForm"}]], "Input"],

Cell["\<\

The behavior of the SetDelayed[...] command will be determined by its \
Attributes:\
\>", "Text",
 CellChangeTimes->{3.523300074511178*^9}],

Cell[BoxData[
 RowBox[{"Attributes", "[", "SetDelayed", "]"}]], "Input"],

Cell[TextData[{
 "\nObserve that SetDelayed[...] has Attribute HoldAll.\n\nWe will run a \
simple trace of making multiple delayed assignments:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y1", ",", "y2"}], "}"}], 
    StyleBox[":=",
     FontWeight->"Bold"], 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2"}], "}"}]}], TraditionalForm]]],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y1", "=", "y1New"}], TraditionalForm]]],
 " on the left-hand side and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "=", "x1New"}], TraditionalForm]]],
 " on the right-hand side:"
}], "Text",
 CellChangeTimes->{3.5233000795012283`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"x1", ",", "x2", ",", "y1", ",", "y2"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"x1", "=", "x1New"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y1", "=", "y1New"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y1", ",", "y2"}], "}"}], ":=", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3898503033926554`*^9, 3.3898503332636557`*^9}}],

Cell[TextData[{
 "\nAs expected, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", 
    StyleBox[":=",
     FontWeight->"Bold"], "rhs"}], TraditionalForm]]],
 " returns nothing (i.e. Null).\nHowever, the delayed assignments to y1 and \
y2 have been made."
}], "Text",
 CellChangeTimes->{3.5233000837712708`*^9}],

Cell["The current delayed assignment to y1 is:", "Text"],

Cell[BoxData[
 RowBox[{"?", "y1"}]], "Input"],

Cell["\<\

and the current delayed assignment to y2 is:\
\>", "Text",
 CellChangeTimes->{3.5233000907313404`*^9}],

Cell[BoxData[
 RowBox[{"?", "y2"}]], "Input"],

Cell[TextData[{
 "\nObserve that the assignment  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "=", "x1New"}], TraditionalForm]]],
 "  was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " used for x1 on the right-hand side (i.e. would have been step 14), \nand \
the assignment  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y1", "=", "y1New"}], TraditionalForm]]],
 "  was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " used for y1 on the left-hand side (i.e. would have been step 14)."
}], "Text",
 CellChangeTimes->{3.5233000938313713`*^9}],

Cell[TextData[{
 "The above trace can be illustrated visually using the following color \
codes:\n\t",
 StyleBox["\[FilledSquare]",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 "  Function or symbol being evaluated.\n\t",
 StyleBox["\[FilledSquare]",
  FontSize->18,
  FontColor->RGBColor[1, 0, 0]],
 "  Argument to be evaluated within the function. \n\t",
 StyleBox["\[FilledSquare]",
  FontSize->18,
  FontColor->RGBColor[1, 0, 1]],
 "  Function or symbol assignment.\n "
}], "Text"],

