}], "Text"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"f", "[", 
       StyleBox["]",
        FontSize->1]}], " ", " ", " ", 
      StyleBox[",",
       FontSize->18], 
      RowBox[{"g", "[", 
       StyleBox["]",
        FontSize->1]}], "x2", 
      RowBox[{
       StyleBox["[",
        FontSize->1], "]"}], 
      StyleBox[",",
       FontSize->18], 
      RowBox[{"g", "[", 
       StyleBox["]",
        FontSize->1]}], "x3", 
