        FontSize->1], "]"}], 
      StyleBox[",",
       FontSize->18,
       FontColor->RGBColor[0, 0, 1]], 
      RowBox[{"g", "[", 
       StyleBox["]",
        FontSize->1]}], "x3", 
      RowBox[{
       StyleBox["[",
        FontSize->1], "]"}], 
      RowBox[{
       StyleBox["[",
        FontSize->1], 
       StyleBox["]",
        FontColor->RGBColor[0, 0, 1]]}]}
    }], TraditionalForm]]]
}], "Text"],

Cell[TextData[{
 "\n\t",
