Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      StyleBox[
       RowBox[{"{", 
        StyleBox["}",
         FontSize->1]}],
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[" ",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[",",
       FontSize->18,
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox["2",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[",",
       FontSize->18,
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox["3",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[
       RowBox[{
        StyleBox["[",
         FontSize->1], 
        RowBox[{
         StyleBox["{",
          FontSize->1], "}"}]}],
       FontColor->RGBColor[0, 0, 1]]},
     {"\[DownArrow]", 
      RowBox[{"\[UpArrow]", 
       StyleBox["1",
        FontColor->RGBColor[0, 0, 1]]}], " ", " ", " ", " ", " "},
     {"\[DownArrow]", " ", " ", " ", " ", " ", " "},
     {
      StyleBox[
       RowBox[{"{", 
        StyleBox["}",
         FontSize->1]}],
       FontColor->RGBColor[1, 0, 1]], 
      StyleBox["1",
       FontColor->RGBColor[1, 0, 1]], 
      StyleBox[",",
       FontSize->18,
       FontColor->RGBColor[1, 0, 1]], 
      StyleBox["2",
       FontColor->RGBColor[1, 0, 1]], 
      StyleBox[",",
       FontSize->18,
       FontColor->RGBColor[1, 0, 1]], 
      StyleBox["3",
       FontColor->RGBColor[1, 0, 1]], 
      StyleBox[
       RowBox[{
        StyleBox["{",
         FontSize->1], "}"}],
       FontColor->RGBColor[1, 0, 1]]}
    }], TraditionalForm]]],
 "       ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x2", ",", "2"}], "}"}], ",", 
       RowBox[{"g", "[", "2", "]"}], ",", 
       RowBox[{"x2", "=", "2"}], ",", "2"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x3", ",", "3"}], "}"}], ",", 
       RowBox[{"g", "[", "3", "]"}], ",", 
       RowBox[{"x2", "=", "3"}], ",", "3"}], "}"}]},
    {
     RowBox[{"f", "[", 
      RowBox[{
       RowBox[{"g", "[", "x1", "]"}], ",", "2", ",", "3"}], "]"}]},
    {
     RowBox[{
      StyleBox["{",
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      RowBox[{
       RowBox[{"g", "[", "x1", "]"}], 
       StyleBox[",",
        FontWeight->"Bold"], 
       StyleBox["2",
        FontWeight->"Bold",
        FontColor->RGBColor[0, 0, 1]], 
       StyleBox[",",
        FontWeight->"Bold",
        FontColor->RGBColor[0, 0, 1]], 
       StyleBox["3",
        FontWeight->"Bold",
        FontColor->RGBColor[0, 0, 1]]}], 
      StyleBox["}",
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]]}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x1", ",", "1"}], "}"}], ",", 
       RowBox[{"g", "[", "1", "]"}], ",", 
       RowBox[{"x2", "=", "1"}], ",", 
       StyleBox["1",
        FontWeight->"Bold",
        FontColor->RGBColor[0, 0, 1]]}], "}"}]},
    {
     StyleBox[
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}],
      FontWeight->"Bold",
      FontColor->RGBColor[1, 0, 1]]}
   },
   BaselinePosition->{Baseline, {1, 1}},
   GridBoxAlignment->{
    "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
     "RowsIndexed" -> {}}]]],
 "\nNote that the value of x2 was assigned 3 times and is currently 1.\nNote \
that the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"...", ",", "...", ",", "..."}], "]"}], TraditionalForm]]],
 " followed the Non-Standard Evaluation Procedure because the first argument \
was held from evaluation.  Also note that the final answer: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], TraditionalForm]]],
 " is ",
 StyleBox["different",
  FontVariations->{"Underline"->True}],
 " than the answer obtained for the previous example:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "3"}], "}"}], TraditionalForm]]],
 ", even though both examples used ",
 StyleBox["exactly",
  FontVariations->{"Underline"->True}],
 " the same function assignments.  Therefore, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure must be used as a guide in creating your programs."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 2:  Tracing an Evaluation", "Subsection"],

Cell[TextData[{
 "Recall our above example of calculating the absolute value by using the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", "...", "]"}], TraditionalForm]]],
 " command.  A much shorter version of this problem can be implemented with \
the following code:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", "     ", 
    RowBox[{
     RowBox[{
      RowBox[{"x1", "=", "x"}], ";", "     ", 
      RowBox[{"x1", "\[GreaterEqual]", "0"}]}], ",", "    ", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "    ", "x1", ",", 
     "         ", "\[IndentingNewLine]", 
     RowBox[{"-", "x1"}]}], "]"}], TraditionalForm]]],
 "\nNote that before the logical condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "\[GreaterEqual]", "0"}], TraditionalForm]]],
 " can be evaluated to either True or False, that the assignment of x to x1 \
must be made.\nHowever, this is clearly not the case for the following \
expression (which should yield the value 3):"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"f", ",", "g", ",", "x", ",", "x1"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", "  ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"x1", "=", "x"}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"x1", "\[GreaterEqual]", "0"}]}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "x1", ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"-", "x1"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "]"}], "/.", 
  RowBox[{"x", "\[Rule]", 
   RowBox[{"-", "3"}]}]}]}], "Input",
 CellChangeTimes->{{3.3898496753286552`*^9, 3.3898496955256557`*^9}}],

Cell[TextData[{
 "\nYour newly acquired understanding of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s evaluation procedure immediately clarifies what is happening.  \
Specifically, both of the arguments (i.e. expr and rule) in the \
ReplaceAll[expr,rule] command (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"expr", " ", "/.", " ", "rule"}], TraditionalForm]]],
 ")  will be evaluated ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " the replacements are made.  A direct consequence is that the If[...] \
statement will be evaluated.  However, the If[...] command which has \
Attributes HoldRest, will be shown to hold its last two arguments from \
evaluation.\nUse the Trace command:"
}], "Text",
 CellChangeTimes->{3.5232994171446047`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x1", "=", "x"}], ";", 
       RowBox[{"x1", "\[GreaterEqual]", "0"}]}], ",", "x1", ",", 
      RowBox[{"-", "x1"}]}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{"-", "3"}]}]}], "   ", "//", "Trace"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.389849708018656*^9, 3.389849724549656*^9}}],

Cell[TextData[{
 "\ni.e.\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"x1", "=", "x"}], ";", 
            RowBox[{"x1", "\[GreaterEqual]", "0"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x1", "=", "x"}], ",", "x"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x1", ",", "x"}], "}"}], ",", 
             RowBox[{"x", "\[GreaterEqual]", "0"}]}], "}"}], ",", 
           RowBox[{"x", "\[GreaterEqual]", "0"}]}], "}"}], ",", 
         RowBox[{
          StyleBox[
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"x", "\[GreaterEqual]", "0"}], ",", "x1", ",", 
             RowBox[{"-", "x1"}]}], "]"}],
           FontColor->RGBColor[0, 0, 1]], 
          StyleBox["is",
           FontColor->RGBColor[1, 0, 0]], 
          StyleBox[" ",
           FontColor->RGBColor[1, 0, 0]], 
          StyleBox["evaluated",
           FontColor->RGBColor[1, 0, 0]], 
          StyleBox[" ",
           FontColor->RGBColor[1, 0, 0]], 
          StyleBox["here",
           FontColor->RGBColor[1, 0, 0]]}]}], "}"}], "   "}]},
     {
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "\[Rule]", 
         RowBox[{"-", "3"}]}], ",", 
        RowBox[{"x", "\[Rule]", 
         RowBox[{"-", "3"}]}]}], "}"}]},
     {
      RowBox[{
       StyleBox[
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x", "\[GreaterEqual]", "0"}], ",", "x1", ",", 
          RowBox[{"-", "x1"}]}], "]"}],
        FontColor->RGBColor[0, 0, 1]], 
       StyleBox["/.",
        FontColor->RGBColor[0, 0, 1]], 
       StyleBox["\[InvisibleSpace]",
        FontColor->RGBColor[0, 0, 1]], 
       RowBox[{
        StyleBox["x",
         FontColor->RGBColor[0, 0, 1]], 
        StyleBox["\[Rule]",
         FontColor->RGBColor[0, 0, 1]], 
        RowBox[{
         StyleBox[
          RowBox[{"-", "3"}],
          FontColor->RGBColor[0, 0, 1]], "  ", 
         StyleBox["is",
          FontColor->RGBColor[1, 0, 0]], 
         StyleBox[" ",
          FontColor->RGBColor[1, 0, 0]], 
         StyleBox["evaluated",
          FontColor->RGBColor[1, 0, 0]], 
         StyleBox[" ",
          FontColor->RGBColor[1, 0, 0]], 
         StyleBox["here",
          FontColor->RGBColor[1, 0, 0]]}]}]}]},
     {
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], "\[GreaterEqual]", "0"}], ",", 
          StyleBox["x1",
           FontColor->RGBColor[0, 0, 1]], 
          StyleBox[",",
           FontColor->RGBColor[0, 0, 1]], 
          StyleBox[
           RowBox[{"-", "x1"}],
           FontColor->RGBColor[0, 0, 1]]}], "]"}], "   ", 
        StyleBox["x1",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["did",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["not",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["match",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["the",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["pattern",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["x",
         FontColor->RGBColor[1, 0, 0]]}], 
       StyleBox["\[Rule]",
        FontColor->RGBColor[1, 0, 0]], 
       StyleBox[
        RowBox[{"-", "3"}],
        FontColor->RGBColor[1, 0, 0]]}]},
     {
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], "\[GreaterEqual]", "0"}], ",", "False"}], "}"}]},
     {
      RowBox[{"If", "[", 
       RowBox[{"False", ",", "x1", ",", 
        RowBox[{"-", "x1"}]}], "]"}]},
     {
      RowBox[{"-", "x1"}]},
     {
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1", ",", "x"}], "}"}], " ", 
        StyleBox["assignment",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["is",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["being",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["made",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["long",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["after",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["the",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["replacement",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["rule",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["x",
         FontColor->RGBColor[1, 0, 0]]}], 
       StyleBox["\[Rule]",
        FontColor->RGBColor[1, 0, 0]], 
       RowBox[{
        StyleBox[
         RowBox[{"-", "3"}],
         FontColor->RGBColor[1, 0, 0]], " ", 
        StyleBox["has",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["been",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox["applied",
         FontColor->RGBColor[1, 0, 0]]}]}]},
     {
      RowBox[{"-", "x"}]}
    },
    BaselinePosition->{Baseline, {1, 1}},
    GridBoxAlignment->{
     "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}}], TraditionalForm]]],
 "\n\t"
}], "Text",
 CellChangeTimes->{3.5232994230446634`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 3:  Setting Attributes", "Subsection",
 CellChangeTimes->{3.3900449323114*^9}],

Cell[TextData[{
 StyleBox["Objective",
  FontVariations->{"Underline"->True}],
 ": Construct a function which will accept a list of expressions and display \
both the unevaluated and evaluated form of each expression.\n",
 StyleBox["Solution",
  FontVariations->{"Underline"->True}],
 ": One could construct a procedural program that would accomplish this one \
element at a time.  However, almost all the work can be accomplished by just \
setting the Attributes of the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "...", "]"}], TraditionalForm]]],
 ".  Careful examination of the above evaluation procedure indicates that the \
relevant evaluation steps (",
 StyleBox["in the order indicated",
  FontVariations->{"Underline"->True}],
 ") include:\n\tstep 7:\tEvaluate all arguments ",
 StyleBox["unless",
  FontVariations->{"Underline"->True}],
 " they are held from evaluation.\n\tstep 10: Apply Attribute Listable. \n\t\
step 14: Apply user-defined DownValues"
}], "Text"],

Cell[TextData[{
 "First: The function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "..."}], "}"}], "]"}], 
   TraditionalForm]]],
 " must be able to hold the elements within the list from evaluation until \
they are ready to be evaluated (i.e. step 7).  Therefore, set the attribute \
of  ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 "  to HoldAll:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{"Listable", ",", 
       StyleBox["HoldAll",
        FontColor->RGBColor[1, 0, 0]]}], "}"}]}], "]"}], TraditionalForm]]],
 "\nThis means the argument: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "..."}], "}"}], 
   TraditionalForm]]],
 " in the function: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "..."}], "}"}], "]"}], 
   TraditionalForm]]],
 " will be held from evaluation.\nSecond: The function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "..."}], "}"}], "]"}], 
   TraditionalForm]]],
 " must be able to work automatically with each element in the list.  \
Therefore, set the attribute of  ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 "  to be Listable:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["Listable",
        FontColor->RGBColor[1, 0, 0]], ",", "HoldAll"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "\nTherefore:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2", ",", "x3", ",", "..."}], "}"}], "]"}], 
    "\[DoubleLongRightArrow]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f", "[", "x1", "]"}], ",", 
      RowBox[{"f", "[", "x2", "]"}], ",", 
      RowBox[{
       RowBox[{"f", "[", "x3", "]"}], "..."}]}], " ", "}"}]}], 
   TraditionalForm]]],
 "\noccurs automatically (i.e. step 10).  In addition, the function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "xi", "]"}], TraditionalForm]]],
 "  continues to hold each element  xi  from the evaluation procedure because \
of the attribute HoldAll.\nThird: Enter a user-defined DownValue for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "xi", "]"}], TraditionalForm]]],
 " (i.e. step 14):\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"HoldForm", "[", "x", "]"}], ",", "x"}], "}"}]}], 
   TraditionalForm]]],
 "\nwhich creates a list of two values with the first element ",
 StyleBox["held",
  FontVariations->{"Underline"->True}],
 " from evaluation and the second element ",
 StyleBox["exposed",
  FontVariations->{"Underline"->True}],
 " to the evaluation procedure (remember, List[...] does not hold its \
arguments from evaluation).\nThe desired evaluation process is:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "..."}], "}"}], "]"}], 
     "\[DoubleLongRightArrow]", "\[IndentingNewLine]", "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", "x1", "]"}], ",", 
       RowBox[{"f", "[", "x2", "]"}], ",", 
       RowBox[{
        RowBox[{"f", "[", "x3", "]"}], "..."}]}], " ", "}"}], 
     "\[DoubleLongRightArrow]", "\[IndentingNewLine]", "\t\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"HoldForm", "[", "x1", "]"}], ",", "x1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"HoldForm", "[", "x2", "]"}], ",", "x2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"HoldForm", "[", "x3", "]"}], ",", "x3"}], "}"}], ",", 
       "..."}], "}"}]}], ","}], TraditionalForm]]],
 "\nwhere the second element of each pair will be evaluated.\n\t\nThe \
following code completely implements our function:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", "f", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{"Listable", ",", "HoldAll"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"HoldForm", "[", "x", "]"}], ",", "x"}], "}"}]}]}], "InputOnly"],

Cell[TextData[{
 "Test our function on a list of expressions:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", "[", "\[Pi]", "]"}], ",", 
     RowBox[{"1", "+", "2"}], ",", 
     RowBox[{"a", "*", 
      SuperscriptBox["a", "2"]}], ",", 
     RowBox[{"a", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", "a"}], ")"}]}]}], "}"}], TraditionalForm]]]
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"a", ",", "b", ",", "c"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", "[", "\[Pi]", "]"}], ",", 
     RowBox[{"1", "+", "2"}], ",", 
     RowBox[{"a", "*", 
      SuperscriptBox["a", "2"]}], ",", 
     RowBox[{"a", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", "a"}], ")"}]}]}], "}"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "  ", "//", "TableForm"}]}], "Input",
 CellChangeTimes->{{3.389849752143656*^9, 3.3898497561206555`*^9}}],

Cell[TextData[{
 "\nSummary: Construction of the above function required an understanding of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure.  Specifically, that the HoldAll attribute would be \
applied first, that the attribute Listable would be applied second and the \
user-defined DownValues would be applied third.  ",
 StyleBox["Consider how differently this function would be defined if the \
evaluation procedure were implemented in reverse order",
  FontVariations->{"Underline"->True}],
 ".\n\nThe function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"{", "...", "}"}], "]"}], TraditionalForm]]],
 " will be used to display the results in Examples 4 and 5."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 4A  \"==\" vs. \"===\" and the Evaluation Procedure:", \
"Subsection",
 CellChangeTimes->{3.3900449339094*^9}],

Cell[TextData[{
 "The command Equal[lhs,rhs] i.e. \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "==", "rhs"}], TraditionalForm]]],
 "\" and the command SameQ[lhs,rhs] i.e. \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "===", "rhs"}], TraditionalForm]]],
 "\" are similar in some respects but are fundamentally different in their \
evaluation procedure.\nEqual[lhs,rhs] i.e. \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "==", "rhs"}], TraditionalForm]]],
 "\" returns True if ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure determines that the lhs and the rhs are \
\"essentially\" the same mathematically, returns False if ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure determines that the lhs is \"essentially\" \
different from the rhs, returns unevaluated ",
 StyleBox["under all other circumstances",
  FontVariations->{"Underline"->True}],
 ".  \nTherefore, to have an understanding of what is going to happen with \
the function \"==\" requires an understanding of Evaluation Procedure as \
well.\nConsider the attributes of \"==\":"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Equal", "]"}]], "Input"],

Cell[TextData[{
 "\nNote that \"==\" has no attribute other than Protected.  Therefore, both \
the lhs and the rhs will be ",
 StyleBox["completely evaluated before the test of being \"essentially\" the \
same is applied",
  FontVariations->{"Underline"->True}],
 ".  You also know that ",
 StyleBox["Mathematica'",
  FontSlant->"Italic"],
 "s Evaluation Procedure only applies a ",
 StyleBox["limited",
  FontVariations->{"Underline"->True}],
 " set of mathematical transformations automatically (see step 13 and step \
15).\n\nConsider the following illustration:"
}], "Text",
 CellChangeTimes->{3.5232994985554185`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "+", "1"}], "\[Equal]", "2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"2.", "\[Equal]", "2"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"N", "[", "\[Pi]", "]"}], "\[Equal]", "\[Pi]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "+", "a", "+", 
       SqrtBox[
        RowBox[{"a", "+", "a"}]]}], "\[Equal]", 
      RowBox[{
       RowBox[{"2", "a"}], "+", 
       RowBox[{
        SqrtBox["2"], 
        SqrtBox["a"]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"a", "\[Equal]", 
      SqrtBox[
       SuperscriptBox["a", "2"]]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "*", "a"}], "\[Equal]", 
      SuperscriptBox["a", "2"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      FractionBox[
       RowBox[{"a", "*", "b"}], 
       RowBox[{"a", "*", "c"}]], "\[Equal]", 
      FractionBox["b", "c"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "+", 
       RowBox[{"(", 
        RowBox[{"b", "+", "c"}], ")"}]}], "\[Equal]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "+", "b"}], ")"}], "+", "c"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "+", "b"}], "\[Equal]", 
      RowBox[{"b", "+", "a"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Pi]", "\[Equal]", 
      FractionBox["22", "7"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"(", 
        RowBox[{"a", "+", 
         SuperscriptBox["a", "2"]}], ")"}]}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["a", "2"], "+", 
       SuperscriptBox["a", "3"]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"(", 
        RowBox[{"a", "+", 
         SuperscriptBox["a", "2"]}], ")"}]}], "\[Equal]", 
      RowBox[{"Factor", "[", 
       RowBox[{
        SuperscriptBox["a", "2"], "+", 
        SuperscriptBox["a", "3"]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"a", "*", 
        RowBox[{"(", 
         RowBox[{"a", "+", 
          SuperscriptBox["a", "2"]}], ")"}]}], "]"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["a", "2"], "+", 
       SuperscriptBox["a", "3"]}]}]}], "\[IndentingNewLine]", "}"}], "]"}], "//",
   "TableForm"}]], "Input"],

Cell[TextData[{
 "\nOn the other hand, SameQ[lhs,rhs] i.e. \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "===", "rhs"}], TraditionalForm]]],
 "\" returns True if ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure determines that the lhs and the rhs are ",
 StyleBox["absolutely identical",
  FontVariations->{"Underline"->True}],
 ", returns False under all other circumstances.\nConsider the attributes of \
\"===\":"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "SameQ", "]"}]], "Input"],

Cell[TextData[{
 "\nNote that \"===\" has no attribute other than Protected.  Therefore, both \
the lhs and the rhs will be ",
 StyleBox["completely evaluated before the test of being absolutely identical \
is applied",
  FontVariations->{"Underline"->True}],
 ".  Because ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure only applies a ",
 StyleBox["limited",
  FontVariations->{"Underline"->True}],
 " number of mathematical transformations, it is highly likely that a value \
of False will be returned even though the lhs and the rhs are mathematically \
identical (see step 13 and step 15).\n\nConsider the following illustrations:"
}], "Text",
 CellChangeTimes->{3.5232995630460634`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "+", "1"}], "===", "2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"2.", "===", "2"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"N", "[", "\[Pi]", "]"}], "===", "\[Pi]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "+", "a", "+", 
       SqrtBox[
        RowBox[{"a", "+", "a"}]]}], "===", 
      RowBox[{
       RowBox[{"2", "a"}], "+", 
       RowBox[{
        SqrtBox["2"], 
        SqrtBox["a"]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"a", "===", 
      SqrtBox[
       SuperscriptBox["a", "2"]]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "*", "a"}], "===", 
      SuperscriptBox["a", "2"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      FractionBox[
       RowBox[{"a", "*", "b"}], 
       RowBox[{"a", "*", "c"}]], "===", 
      FractionBox["b", "c"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "+", 
       RowBox[{"(", 
        RowBox[{"b", "+", "c"}], ")"}]}], "===", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "+", "b"}], ")"}], "+", "c"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "+", "b"}], "===", 
      RowBox[{"b", "+", "a"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Pi]", "===", 
      FractionBox["22", "7"]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"(", 
        RowBox[{"a", "+", 
         SuperscriptBox["a", "2"]}], ")"}]}], "===", 
      RowBox[{
       SuperscriptBox["a", "2"], "+", 
       SuperscriptBox["a", "3"]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"(", 
        RowBox[{"a", "+", 
         SuperscriptBox["a", "2"]}], ")"}]}], "===", 
      RowBox[{"Factor", "[", 
       RowBox[{
        SuperscriptBox["a", "2"], "+", 
        SuperscriptBox["a", "3"]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"a", "*", 
        RowBox[{"(", 
         RowBox[{"a", "+", 
          SuperscriptBox["a", "2"]}], ")"}]}], "]"}], "===", 
      RowBox[{
       SuperscriptBox["a", "2"], "+", 
       SuperscriptBox["a", "3"]}]}]}], "\[IndentingNewLine]", "}"}], "]"}], "//",
   "TableForm"}]], "Input"],

Cell[TextData[{
 "\nThe above list of examples helps illustrate the differences between \
\"==\" and \"===\".  In particular, they illustrates why equations ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " have the form \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "==", "rhs"}], TraditionalForm]]],
 "\" rather than \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "===", "rhs"}], TraditionalForm]]],
 "\".  They also illustrate that \"===\" can return False even though \
subsequent evaluation can prove that the lhs and the rhs are the same \
mathematically."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 4B  Construct  myEqual[lhs, rhs]:", "Subsection",
 CellChangeTimes->{3.3900449355414*^9}],

Cell[TextData[{
 "Objective: Construct a function: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myEqual", "[", 
    RowBox[{"lhs", ",", "rhs"}], "]"}], TraditionalForm]]],
 ", which will immediately return True if ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure determines that the lhs and the rhs are \
\"essentially\" the same mathematically.  Otherwise, immediately return a \
value of False (even if applications of specific functions like Simplify[...] \
could subsequently prove that they are the same).\nAnalysis: Our function is \
identical to the \"==\" function with the exception that ",
 StyleBox["if",
  FontVariations->{"Underline"->True}],
 " the function \"==\" remains unevaluated, then we must instead return the \
value False.  This can be accomplished with the following code:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"myEqual", ",", "lhs", ",", "rhs"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myEqual", "[", 
   RowBox[{"lhs_", ",", "rhs_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"lhs", "\[Equal]", "rhs"}], ",", "True", ",", "False", ",", 
    "False"}], "]"}]}]}], "InputOnly"],

Cell[TextData[{
 "Remember the attributes of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", "...", "]"}], TraditionalForm]]],
 " are:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "If", "]"}]], "Input"],

Cell[TextData[{
 "\nTherefore our test: ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"lhs", "\[Equal]", "rhs"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 ", which is in the first position of our logical expression:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     StyleBox[
      RowBox[{"lhs", "\[Equal]", "rhs"}],
      FontColor->RGBColor[1, 0, 0]], ",", "True", ",", "False", ",", 
     "False"}], "]"}], TraditionalForm]]],
 " will be evaluated as follows:\n\t\[FilledSmallSquare] If the evaluation of \
",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"lhs", "\[Equal]", "rhs"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 " results in True, then the value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"lhs", "\[Equal]", "rhs"}], ",", 
     StyleBox["True",
      FontColor->RGBColor[1, 0, 0]], ",", "False", ",", "False"}], "]"}], 
   TraditionalForm]]],
 " will be returned.  \n\t\[FilledSmallSquare] If the evaluation results in \
False, then the value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"lhs", "\[Equal]", "rhs"}], ",", "True", ",", 
     StyleBox["False",
      FontColor->RGBColor[1, 0, 0]], ",", "False"}], "]"}], TraditionalForm]]],
 " will be returned.  \n\t\[FilledSmallSquare] If the evaluation results in \
unevaluated (i.e. just ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"lhs", "\[Equal]", "rhs"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 " rather than True or False), then the value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"lhs", "\[Equal]", "rhs"}], ",", "True", ",", "False", ",", 
     StyleBox["False",
      FontColor->RGBColor[1, 0, 0]]}], "]"}], TraditionalForm]]],
 " will be returned."
}], "Text",
 CellChangeTimes->{3.5232996270467033`*^9}],

Cell["\<\
If[condition, t, f] gives t if condition evaluates to True, and f if it \
evaluates to False. 
If[condition, t, f, u] gives u if condition evaluates to neither True nor \
False.\
\>", "Item",
 FontWeight->"Bold"],

Cell["Test out our function:", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"1", "+", "1"}], ",", "2"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{"2.", ",", "2"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"N", "[", "\[Pi]", "]"}], ",", "\[Pi]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "+", "a", "+", 
        SqrtBox[
         RowBox[{"a", "+", "a"}]]}], ",", 
       RowBox[{
        RowBox[{"2", "a"}], "+", 
        RowBox[{
         SqrtBox["2"], 
         SqrtBox["a"]}]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{"a", ",", 
       SqrtBox[
        SuperscriptBox["a", "2"]]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "*", "a"}], ",", 
       SuperscriptBox["a", "2"]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"a", "*", "b"}], 
        RowBox[{"a", "*", "c"}]], ",", 
       FractionBox["b", "c"]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "+", 
        RowBox[{"(", 
         RowBox[{"b", "+", "c"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "+", "b"}], ")"}], "+", "c"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "+", "b"}], ",", 
       RowBox[{"b", "+", "a"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{"\[Pi]", ",", 
       FractionBox["22", "7"]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "*", 
        RowBox[{"(", 
         RowBox[{"a", "+", 
          SuperscriptBox["a", "2"]}], ")"}]}], ",", 
       RowBox[{
        SuperscriptBox["a", "2"], "+", 
        SuperscriptBox["a", "3"]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "*", 
        RowBox[{"(", 
         RowBox[{"a", "+", 
          SuperscriptBox["a", "2"]}], ")"}]}], ",", 
       RowBox[{"Factor", "[", 
        RowBox[{
         SuperscriptBox["a", "2"], "+", 
         SuperscriptBox["a", "3"]}], "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"a", "*", 
         RowBox[{"(", 
          RowBox[{"a", "+", 
           SuperscriptBox["a", "2"]}], ")"}]}], "]"}], ",", 
       RowBox[{
        SuperscriptBox["a", "2"], "+", 
        SuperscriptBox["a", "3"]}]}], "]"}]}], "\[IndentingNewLine]", "}"}], 
   "]"}], "//", "TableForm"}]], "Input"],

Cell[TextData[{
 "Observe that you would not know exactly what to expect unless you \
understood ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure.  Specifically, you need to understand the behavior \
of the Attributes of the If[...] command, how functional arguments are \
evaluated and the behavior of internal functions."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 4C  Notation \"lhs====rhs\"  for  myEqual[lhs, rhs]:", \
"Subsection",
 CellChangeTimes->{3.3900449366934*^9}],

Cell[TextData[{
 StyleBox["Objective",
  FontVariations->{"Underline"->True}],
 ": As a final step, you might want to create a notation which is more \
convenient for your purpose.  Specifically, I would like to use the Infix \
notation \"lhs====rhs\" for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myEqual", "[", 
    RowBox[{"lhs", ",", "rhs"}], "]"}], TraditionalForm]]],
 ".  This can be easily accomplished by using the Format[...] command:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Format", "[", 
   RowBox[{"myEqual", "[", 
    RowBox[{"lhs_", ",", "rhs_"}], "]"}], "]"}], ":=", 
  RowBox[{"Infix", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"lhs", ",", "rhs"}], "}"}], ",", "\"\<====\>\""}], 
   "]"}]}]], "Input"],

Cell[TextData[{
 "\nThis failed!  Why?\nObserve the value ",
 StyleBox["False",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " in the above error message:\n\t",
 StyleBox["Tag ",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["False",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" in MakeBoxes[",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["False",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",FormatType_] is Protected.",
  FontColor->RGBColor[1, 0, 0]],
 "\nThe atomic form ",
 StyleBox["False",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " cannot have an assignment (see step 1 in the Evaluation Procedure).\nBut \
where did ",
 StyleBox["False",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " come from?\nIt must come from the evaluation of:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Format", "[", 
    RowBox[{"myEqual", "[", 
     RowBox[{"lhs_", ",", "rhs_"}], "]"}], "]"}], TraditionalForm]]],
 ".\n(Remember, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ",
 StyleBox["automatically",
  FontVariations->{"Underline"->True}],
 " evaluates all Format[...] commands so that the formatting instructions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"...", ",", "FormatType_"}], "]"}], TraditionalForm]]],
 " are made available.)\nBut how does this evaluation progress?\nThe answer \
will depend upon the Attributes of Format[...]:\t\t"
}], "Text",
 CellChangeTimes->{3.5232996828872623`*^9}],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Format", "]"}]], "Input"],

Cell[TextData[{
 "\nFormat[...] does not hold any of its arguments.  \n(Again, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ",
 StyleBox["automatically",
  FontVariations->{"Underline"->True}],
 " calls all Format[...] commands to set up the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"...", ",", "FormatType_"}], "]"}], TraditionalForm]]],
 " formatting instructions.)  \nTherefore, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Format", "[", 
    RowBox[{"myEqual", "[", 
     RowBox[{"lhs_", ",", "rhs_"}], "]"}], "]"}], TraditionalForm]]],
 " will be required to evaluate its argument (see step 7f), which is:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"myEqual", "[", 
    RowBox[{"lhs_", ",", "rhs_"}], "]"}], TraditionalForm]]],
 "\nBut ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myEqual", "[", 
    RowBox[{"lhs_", ",", "rhs_"}], "]"}], TraditionalForm]]],
 " will evaluate to its DownValues (see step 14):\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"lhs_", "\[Equal]", "rhs_"}], ",", "True", ",", "False", ",", 
     "False"}], "]"}], TraditionalForm]]],
 ".  \nCarefully note the \"",
 StyleBox["_",
  FontColor->RGBColor[1, 0, 0]],
 "\" in:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     StyleBox[
      RowBox[{"lhs_", "\[Equal]", "rhs_"}],
      FontColor->RGBColor[1, 0, 0]], ",", "True", ",", "False", ",", 
     "False"}], "]"}], TraditionalForm]]],
 ".\nHowever, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", "...", "]"}], TraditionalForm]]],
 " command has Attributes: HoldRest.\nTherefore, the first argument of \
If[...] containing the logical expression:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"lhs_", "\[Equal]", "rhs_"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 "\nwill be evaluated as follows:"
}], "Text",
 CellChangeTimes->{3.5232997362477956`*^9}],

Cell[BoxData[
 RowBox[{"lhs_", "\[Equal]", "rhs_"}]], "Input"],

Cell[TextData[{
 "\nHowever, we have shown above that the evaluation of the expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs_", "\[Equal]", "rhs_"}], TraditionalForm]]],
 " returns unevaluated and does not evaluate to either True or False.\n\
Therefore, the If[...] command evaluates as follows:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     StyleBox[
      RowBox[{"lhs_", "\[Equal]", "rhs_"}],
      FontColor->RGBColor[1, 0, 0]], ",", "True", ",", "False", ",", 
     StyleBox["False",
      FontWeight->"Bold",
      FontColor->RGBColor[1, 0, 0]]}], "]"}], TraditionalForm]]],
 ".\nSolving the mystery of the error message:\n\t",
 StyleBox["Tag ",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["False",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" in MakeBoxes[",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["False",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",FormatType_] is Protected.\n",
  FontColor->RGBColor[1, 0, 0]],
 "We can quickly test this analysis by temporarily placing a character ",
 StyleBox["string",
  FontVariations->{"Underline"->True}],
 " (which is an atomic type) in the last position of the If[...] command:\n\t\
myEqual[lhs_,rhs_]:=If[lhs\[Equal]rhs,True,False, ",
 StyleBox["\" FROM If[...,LAST] \"",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ",
  FontColor->RGBColor[1, 0, 0]],
 "]"
}], "Text",
 CellChangeTimes->{3.52329975864802*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "myEqual", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"myEqual", "[", 
     RowBox[{"lhs_", ",", "rhs_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"lhs", "\[Equal]", "rhs"}], ",", "True", ",", "False", ",", 
      "\"\<FROM If[...,LAST]\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Format", "[", 
    RowBox[{"myEqual", "[", 
     RowBox[{"lhs_", ",", "rhs_"}], "]"}], "]"}], ":=", 
   RowBox[{"Infix", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lhs", ",", "rhs"}], "}"}], ",", "\"\<====\>\""}], "]"}]}], 
  ";"}]}], "InputOnly"],

Cell[TextData[{
 "Observe that the error message:\n\t",
 StyleBox["Tag ",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["String",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" in MakeBoxes[",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["FROM If[...,LAST]",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",FormatType_] is Protected.\n",
  FontColor->RGBColor[1, 0, 0]],
 "validates our analysis.\n\nBut how do we correct the problem?\nExamination \
of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure indicates that we either want to hold the argument \
of Format[...] from evaluation or we want to change the order of evaluation.  \
It would be inappropriate to change the Attributes of the internal function \
Format[...] to HoldAll.  \nTherefore, we will change the order of evaluation \
by changing the order in which we enter our commands:\n\tFirst:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Clear", "[", "myEqual", "]"}], TraditionalForm]]],
 ";\n\tSecond:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Format", "[", 
     RowBox[{"myEqual", "[", 
      RowBox[{"lhs_", ",", "rhs_"}], "]"}], "]"}], ":=", 
    RowBox[{"Infix", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lhs", ",", "rhs"}], "}"}], ",", "\"\<====\>\""}], "]"}]}], 
   TraditionalForm]]],
 "\nThis will allow the Format[...] command to be evaluated by ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " (see step 7f and step 15) so that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"...", ",", "FormatType_"}], "]"}], TraditionalForm]]],
 " formatting boxes can be constructed ",
 StyleBox["without",
  FontVariations->{"Underline"->True}],
 " substitution of the external ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myEqual", "[", 
    RowBox[{"lhs_", ",", "rhs_"}], "]"}], TraditionalForm]]],
 " DownValues.\nFinally, assign the desired DownValues to the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myEqual", "[", 
    RowBox[{"...", ",", "..."}], "]"}], TraditionalForm]]],
 ":\n\tThird:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"myEqual", "[", 
     RowBox[{"lhs_", ",", "rhs_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"lhs", "\[Equal]", "rhs"}], ",", "True", ",", "False", ",", 
      "False"}], "]"}]}], TraditionalForm]]],
 "\n\t"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "myEqual", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Format", "[", 
     RowBox[{"myEqual", "[", 
      RowBox[{"lhs_", ",", "rhs_"}], "]"}], "]"}], ":=", 
    RowBox[{"Infix", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lhs", ",", "rhs"}], "}"}], ",", "\"\<====\>\""}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"myEqual", "[", 
    RowBox[{"lhs_", ",", "rhs_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"lhs", "\[Equal]", "rhs"}], ",", "True", ",", "False", ",", 
     "False"}], "]"}]}], ";"}]}], "InputOnly"],

Cell[TextData[{
 "\nCheck out the assignments to the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myEqual", "[", 
    RowBox[{"...", ",", "..."}], "]"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"?", "myEqual"}]], "Input"],

Cell[TextData[{
 "\nObserve that the output formatting \"lhs_====rhs_\" is already \
functioning (as explained above, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " automatically implements the Format[...] command).  \nAlso observe the \
UpValues assigned to the \"symbolic head\" myEqual (see step 13):\n\t\
MakeBoxes[lhs_====rhs_,FormatType_]",
 StyleBox["^:=",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 "Format[Infix[{lhs,rhs},====],FormatType]\nand the DownValues assigned to \
the \"symbolic head\" myEqual (see step 15):\n\tlhs_====rhs_",
 StyleBox[":=",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 "If[lhs==rhs,True,False,False]\n\tFormat[lhs_====rhs_]",
 StyleBox[":=",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 "Infix[{lhs,rhs},====]\n\nAs a final test, redisplay the use of our new \
function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myEqual", "[", 
    RowBox[{"lhs", ",", "rhs"}], "]"}], TraditionalForm]]],
 " in the new notation lhs====rhs:"
}], "Text",
 CellChangeTimes->{3.523299813088564*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"1", "+", "1"}], ",", "2"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{"2.", ",", "2"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"N", "[", "\[Pi]", "]"}], ",", "\[Pi]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "+", "a", "+", 
        SqrtBox[
         RowBox[{"a", "+", "a"}]]}], ",", 
       RowBox[{
        RowBox[{"2", "a"}], "+", 
        RowBox[{
         SqrtBox["2"], 
         SqrtBox["a"]}]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{"a", ",", 
       SqrtBox[
        SuperscriptBox["a", "2"]]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "*", "a"}], ",", 
       SuperscriptBox["a", "2"]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"a", "*", "b"}], 
        RowBox[{"a", "*", "c"}]], ",", 
       FractionBox["b", "c"]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "+", 
        RowBox[{"(", 
         RowBox[{"b", "+", "c"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "+", "b"}], ")"}], "+", "c"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "+", "b"}], ",", 
       RowBox[{"b", "+", "a"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{"\[Pi]", ",", 
       FractionBox["22", "7"]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "*", 
        RowBox[{"(", 
         RowBox[{"a", "+", 
          SuperscriptBox["a", "2"]}], ")"}]}], ",", 
       RowBox[{
        SuperscriptBox["a", "2"], "+", 
        SuperscriptBox["a", "3"]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"a", "*", 
        RowBox[{"(", 
         RowBox[{"a", "+", 
          SuperscriptBox["a", "2"]}], ")"}]}], ",", 
       RowBox[{"Factor", "[", 
        RowBox[{
         SuperscriptBox["a", "2"], "+", 
         SuperscriptBox["a", "3"]}], "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"myEqual", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"a", "*", 
         RowBox[{"(", 
          RowBox[{"a", "+", 
           SuperscriptBox["a", "2"]}], ")"}]}], "]"}], ",", 
       RowBox[{
        SuperscriptBox["a", "2"], "+", 
        SuperscriptBox["a", "3"]}]}], "]"}]}], "\[IndentingNewLine]", "}"}], 
   "]"}], "//", "TableForm"}]], "Input"],

Cell[TextData[{
 "\nObservation: Once again, the mystery of how to achieve your objectives \
can only be solved with an understanding of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure."
}], "Text",
 CellChangeTimes->{3.5232998275487084`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 5: All Functions can be Manipulated the Same Way:", "Subsection"],

Cell[TextData[{
 "Consider a typical function:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], TraditionalForm]]],
 ".\nYou should now realize that this function can be manipulated like ",
 StyleBox["any",
  FontVariations->{"Underline"->True}],
 " other expression within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".\nCarefully examine the following operations performed on this function:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{
    "g", ",", "h", ",", "x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5", ",",
      "x6", ",", "xNew"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"First", "[", 
      RowBox[{"g", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Last", "[", 
      RowBox[{"g", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Drop", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "2"}], 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Drop", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", 
       RowBox[{"-", "2"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "2"}], 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", 
       RowBox[{"-", "2"}]}], "]"}], ",", "\[IndentingNewLine]", 
     SubscriptBox[
      RowBox[{"g", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], 
      RowBox[{"\[LeftDoubleBracket]", "0", "\[RightDoubleBracket]"}]], ",", 
     "\[IndentingNewLine]", 
     SubscriptBox[
      RowBox[{"g", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], 
      RowBox[{"\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], ",", 
     "\[IndentingNewLine]", 
     SubscriptBox[
      RowBox[{"g", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], 
      RowBox[{"\[LeftDoubleBracket]", 
       RowBox[{"{", "2", "}"}], "\[RightDoubleBracket]"}]], ",", 
     "\[IndentingNewLine]", 
     SubscriptBox[
      RowBox[{"g", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], 
      RowBox[{"\[LeftDoubleBracket]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], "\[RightDoubleBracket]"}]], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Reverse", "[", 
      RowBox[{"g", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "2"}], 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "xNew"}],
       "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "xNew"}],
       "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Insert", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "xNew", 
       ",", "3"}], "]"}], ",", 
     RowBox[{"ReplacePart", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "xNew", 
       ",", "3"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x3"}], "]"}], ",", 
       RowBox[{"g", "[", 
        RowBox[{"x2", ",", "x4"}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"x2", ",", "x4"}], "]"}], "\[Union]", 
      RowBox[{"g", "[", "x1", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Map", "[", 
      RowBox[{"h", ",", 
       RowBox[{"g", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}], 
        "]"}], ",", "EvenQ"}], "]"}]}], "\[IndentingNewLine]", "}"}], "]"}], 
  "               ", "//", "TableForm"}]}], "Input",
 CellChangeTimes->{3.3898498828426557`*^9}],

Cell[TextData[{
 "\nThe only cautionary note is that the functions: First[...], Drop[...], \
Take[...], etc. do not have the Hold... Attributes that automatically hold \
their first argument from evaluation (see steps 6 - 7e).  Therefore, if the \
function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], TraditionalForm]]],
 " has assigned DownValues (see step 7f), then they will be applied ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " the application of the internal DownValues for the functions: First[...], \
Drop[...], Take[...], etc. (see step 15).  This could be disastrous!\nFor \
example, assign some DownValues to the function g[...]:"
}], "Text",
 CellChangeTimes->{3.5232998707791405`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], ":=", 
   "\"\<Successfully Dropped 3 Arguments of g[...]\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", "x___", "]"}], ":=", 
    "\"\<Continued Evaluation of g[...]\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Attributes of Drop = \>\"", ",", 
     RowBox[{"Attributes", "[", "Drop", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Drop", "[", 
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "3"}], 
  "]"}]}], "Input"],

Cell[TextData[{
 "\nIt did not work!  Observe that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure evaluated the first argument: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], TraditionalForm]]],
 " of the expression: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Drop", "[", 
    RowBox[{"...", ",", " ", "3"}], "]"}], TraditionalForm]]],
 " (see step 7f) ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " the application of the Drop[...] command (see step 15). \n\nExamination of \
",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation procedure indicates that this evaluation occurs at step 7f.  \
Therefore, a solution to our problem ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " occur before step 7f.\nOne solution to this problem (not recommended) is \
to set the Attribute of the function Drop[...] to HoldFirst (see step 7d):"
}], "Text",
 CellChangeTimes->{3.523299892909362*^9}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Unprotect", "[", "Drop", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"Drop", ",", "HoldFirst"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Drop", "[", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "3"}], 
    "]"}], "//", "Trace"}], "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3898499198446555`*^9, 3.3898499345066557`*^9}}],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TagBox[
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], ",", "3"}], 
       "]"}],
      HoldForm]},
    {
     TagBox[
      RowBox[{"g", "[", "x4", "]"}],
      HoldForm]},
    {
     TagBox["\<\"Successfully Dropped 3 Arguments of g[...]\"\>",
      HoldForm]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{3.5232999394698277`*^9}]
}, Open  ]],

Cell["\<\

This procedure was successful.  However, it is extremely dangerous.  The \
reason is because subsequent evaluation might also call the function \
Drop[...], which will not be evaluated by the usual procedure.
Clean up our previous work by removing the HoldFirst attribute of Drop[...]:\
\>", "Text",
 CellChangeTimes->{3.523299900429437*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAttributes", "[", 
   RowBox[{"Drop", ",", " ", "HoldFirst"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Protect", "[", "Drop", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Attributes of Drop = \>\"", ",", 
   RowBox[{"Attributes", "[", "Drop", "]"}]}], "]"}]}], "InputOnly"],

Cell[TextData[{
 "Continued examination of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure before step 7f indicates the possibility of using \
step 7b: (i.e. use Unevaluated[...]):"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Drop", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Unevaluated", "[", 
      RowBox[{"g", "[", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "3"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "//", "Trace"}], "//",
   "Column"}]], "Input",
 CellChangeTimes->{{3.3898499830716553`*^9, 3.3898500023406553`*^9}}],

Cell["\<\

This procedure works, and is both simple and safe.\
\>", "Text",
 CellChangeTimes->{3.523299999100424*^9}],

Cell[TextData[{
 StyleBox["Observation",
  FontVariations->{"Underline"->True}],
 ": Even internal functions are evaluated by the same Evaluation Procedure."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Example 6:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "=", "rhs"}], TraditionalForm]]],
 "  and   ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", ":=", "rhs"}], TraditionalForm]]],
 " :"
}], "Subsection"],

Cell[TextData[{
 "You are now ready to fully understand the implementation of:\n\t\t\
\[FilledSmallSquare]  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", "=", "rhs"}], TraditionalForm]]],
 "\ti.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Set", "[", 
    RowBox[{"lhs", ",", "rhs"}], "]"}], TraditionalForm]]],
 "\n\t\t\[FilledSmallSquare]  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", ":=", "rhs"}], TraditionalForm]]],
 "\ti.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"SetDelayed", "[", 
    RowBox[{"lhs", ",", "rhs"}], "]"}], TraditionalForm]]],
 "\n\t\t\n",
 StyleBox["Objective",
  FontVariations->{"Underline"->True}],
 ": Make multiple immediate assignments (i.e. \"=\") when some of the \
arguments on both the left-hand side and right-hand side have assigned \
values.\nFirst, start with the FullForm of  \"=\":"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hold", "[", 
   RowBox[{"lhs", "=", "rhs"}], "]"}], "//", "FullForm"}]], "Input"],

Cell["\<\

The behavior of the Set[...] command will be determined by its Attributes:\
\>", "Text",
 CellChangeTimes->{3.523300023950672*^9}],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Set", "]"}]], "Input"],

Cell[TextData[{
 "\nObserve that Set[...] has Attribute HoldFirst.\n\nWe will run a simple \
trace of making ",
 StyleBox["multiple",
  FontVariations->{"Underline"->True}],
 " immediate assignments:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y1", ",", "y2"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2"}], "}"}]}], TraditionalForm]]],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y1", "=", "y1New"}], TraditionalForm]]],
 " on the left-hand side and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "=", "x1New"}], TraditionalForm]]],
 " on the right-hand side:"
}], "Text",
 CellChangeTimes->{3.5233000274007072`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{
    "x1", ",", "x2", ",", "y1", ",", "y2", ",", "x1New", ",", "y1New"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"x1", "=", "x1New"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y1", "=", "y1New"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y1", ",", "y2"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3898500333316555`*^9, 3.389850048273656*^9}, {
  3.3898502060766554`*^9, 3.3898502272346554`*^9}}],

Cell[TextData[{
 "\nObserve that the assignment  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "=", "x1New"}], TraditionalForm]]],
 "  ",
 StyleBox["was",
  FontVariations->{"Underline"->True}],
 " used for x1 on the right-hand side (i.e. step 14), \nbut the assignment  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y1", "=", "y1New"}], TraditionalForm]]],
 "  was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " made for y1 on the left-hand side (i.e. would have been step 14)."
}], "Text",
 CellChangeTimes->{3.5233000515609484`*^9}],

Cell["As expected, the current assignment to y1 is:", "Text"],

Cell[BoxData[
 RowBox[{"?", "y1"}]], "Input"],

