           FontWeight->"Bold"], 
          StyleBox[" ",
           FontWeight->"Bold"], 
          StyleBox["tagged",
           FontWeight->"Bold"], 
          StyleBox[" ",
           FontWeight->"Bold"], 
          StyleBox["to",
           FontWeight->"Bold"], 
          StyleBox["  ",
           FontWeight->"Bold"], 
          RowBox[{
           StyleBox["F",
            FontWeight->"Bold"], 
           StyleBox[":",
            FontWeight->"Bold"], "\[IndentingNewLine]", "\t\t\t\t", 
           RowBox[{"F", "[", 
            RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}]}]}]}], ":=", 
        RowBox[{"down", "[", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], "\[IndentingNewLine]",
        "\[IndentingNewLine]", "\t\t", 
       StyleBox[
        RowBox[{
         RowBox[{
          RowBox[{"\[ShortLeftArrow]", "  ", 
           RowBox[{"Step", " ", "4"}]}], ":", 
          RowBox[{"Normal", " ", "Expression", " ", "has", " ", "changed"}]}],
          ",", " ", 
         RowBox[{
          RowBox[{"so", "  ", "re"}], "-", "evaluate"}]}],
        FontWeight->"Bold"], "\[IndentingNewLine]"}]},
     {
      RowBox[{
       RowBox[{
        StyleBox[
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a2", ",", "A2"}], "}"}], ",", 
           RowBox[{"up", "[", "A2", "]"}]}], "}"}],
         FontWeight->"Bold",
         FontColor->RGBColor[0, 0, 1]], 
        StyleBox["\[ShortLeftArrow]",
         FontWeight->"Bold"], 
        StyleBox[" ",
         FontWeight->"Bold"], 
        RowBox[{
         StyleBox["Step",
          FontWeight->"Bold"], 
         StyleBox[" ",
          FontWeight->"Bold"], 
         StyleBox["7",
          FontWeight->"Bold"], 
         RowBox[{
          StyleBox["f",
           FontWeight->"Bold"], 
          StyleBox[":",
           FontWeight->"Bold"], 
          StyleBox[" ",
           FontWeight->"Bold"], 
          RowBox[{
           StyleBox["Evaluate",
            FontWeight->"Bold"], 
           StyleBox[" ",
            FontWeight->"Bold"], 
           StyleBox["all",
            FontWeight->"Bold"], 
           StyleBox[" ",
            FontWeight->"Bold"], 
           StyleBox["remaining",
            FontWeight->"Bold"], 
           StyleBox[" ",
            FontWeight->"Bold"], 
           RowBox[{
            StyleBox["arguments",
             FontWeight->"Bold"], 
            StyleBox[":",
             FontWeight->"Bold"], 
            StyleBox["  ",
             FontWeight->"Bold"], 
            StyleBox[
             RowBox[{"up", "[", "a2", "]"}],
             FontWeight->"Plain"]}]}]}]}]}], 
       StyleBox[",",
        FontWeight->"Bold"], "\[IndentingNewLine]", "\t\t\t   ", 
       StyleBox[
        RowBox[{
         RowBox[{"because", " ", 
          RowBox[{"head", ":", " ", 
           RowBox[{
            RowBox[{"down", "[", "...", "]"}], " ", "does", " ", "not", " ", 
            "hold", " ", "its", " ", "arguments"}]}]}], " ", 
         "\[IndentingNewLine]"}],
        FontWeight->"Bold"]}]},
     {
      StyleBox[
       RowBox[{
        StyleBox[
         RowBox[{"down", "[", 
          RowBox[{
           RowBox[{"up", "[", "A1", "]"}], ",", 
           RowBox[{"up", "[", "A2", "]"}], ",", 
           RowBox[{"up", "[", "A3", "]"}]}], "]"}],
         FontColor->RGBColor[0, 0, 1]], "\[ShortLeftArrow]", " ", 
        RowBox[{
         RowBox[{"Completion", " ", "of", " ", "steps", " ", "1"}], "-", 
         "17"}]}],
       FontWeight->"Bold"]}
    },
    BaselinePosition->{Baseline, {1, 1}},
    GridBoxAlignment->{
     "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}}], TraditionalForm]]]
}], "Text"],

Cell[TextData[{
 "\nThe completion of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"a3", ",", "a2", ",", "a1"}], "]"}], TraditionalForm]]],
 "  is:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"down", "[", 
    RowBox[{
     RowBox[{"up", "[", "A1", "]"}], ",", 
     RowBox[{"up", "[", "A2", "]"}], ",", 
     RowBox[{"up", "[", "A3", "]"}]}], "]"}], TraditionalForm]]],
 "\nand represents the value returned."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Standard Evaluation Procedure:"
}], "Subsection"],

Cell[TextData[{
 "Functions are categorized as either following or not following ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s \"Standard Evaluation Procedure\".  \nSimply stated, a function \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\" following the \"Standard Evaluation Procedure\" is evaluated as follows:\
\n\tFirst evaluate the head \"head\" of the expression.\n\tSecond, completely \
evaluate the arguments \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\" from left to right.\n\tFinally, apply any assignments (i.e. UpValues or \
DownValues) to the fully evaluated expression \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", "...", "]"}], TraditionalForm]]],
 "\"."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Non-Standard Evaluation Procedure:", "Subsection"],

Cell[TextData[{
 "Expressions which evaluate all arguments completely (i.e. step 7f) before \
functional assignments are evaluated follow the \"Standard Evaluation \
Procedure\".  However, any function which ",
 StyleBox["controls the evaluation of its arguments",
  FontVariations->{"Underline"->True}],
 " in a special way follows the \"Non-Standard Evaluation Procedure\".  A \
function may exhibit this control because of its Attributes like HoldFirst, \
HoldRest, HoldAll etc. or because one or more of its arguments are shielded \
from certain parts of the Standard Evaluation Procedure because the arguments \
are contained within the Unevaluated [...], Hold[...] etc. commands (see \
steps 6-7e).  The main reason for warning the user about the \"Non-Standard \
Evaluation Procedure\" is to ensure that the user exercises special caution \
in implementing these functions.  An example of tracing a function which \
utilizes the \"Standard Evaluation Procedure\" and a function that utilizes \
the \"Non-Standard Evaluation Procedure\" is illustrated below."
}], "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["  Examples of ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox["'s Full Evaluation Procedure:", "Subtitle"]
}], "Section"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Outline of ",
  FontVariations->{"Underline"->True}],
 StyleBox["Mathematica'",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox["s Evaluation Procedure:",
  FontVariations->{"Underline"->True}]
}], "Subsection"],

Cell[TextData[{
 StyleBox["\nRecursively Evaluate an Expression in the Following Order:\nStep \
1", "Subsubsection"],
 ": ",
 StyleBox["Evaluate", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" Atomic Numeric Expressions", "Subsubsection"],
 "\n",
 StyleBox["Step 2:", "Subsubsection"],
 " ",
 StyleBox["Return a Symbol as Unevaluated when it has has no OwnValues", 
  "Subsubsection",
  FontSlant->"Italic"],
 "\n",
 StyleBox["Step 3:", "Subsubsection"],
 " ",
 StyleBox["Return a Symbol with its OwnValues assigned", "Subsubsection",
  FontSlant->"Italic"],
 "\n",
 StyleBox["Step 4:", "Subsubsection"],
 " ",
 StyleBox["Normal Expression:", "Subsubsection"],
 "\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"head", "[", 
     RowBox[{
      SubscriptBox["part", "1"], ",", 
      SubscriptBox["part", "2"], ",", 
      SubscriptBox["part", "3"], ",", "...", ",", 
      SubscriptBox["part", "n"]}], "]"}], "Subsubsection"], TraditionalForm]]],
 "\nIf ",
 StyleBox["any part",
  FontVariations->{"Underline"->True}],
 " of an expression changes during the evaluation process, then the \
evaluation process for this expression will begin anew.\n",
 StyleBox["Step 5:", "Subsubsection"],
 " ",
 StyleBox["Evaluate the Head", "Subsubsection"],
 "\n",
 StyleBox["Step 6:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute HoldAllComplete (skip to step 14)", 
  "Subsubsection"],
 "\n",
 StyleBox["Step 7:", "Subsubsection"],
 " ",
 StyleBox["Evaluate All Arguments that are Not Held:", "Subsubsection"],
 "\n\t",
 StyleBox["(7a)", "Subsubsection"],
 " If \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"...", "n"}]}], TraditionalForm]]],
 ", is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Evaluate", "[", 
    SubscriptBox["part", "i"], "]"}], TraditionalForm]]],
 ", remove the Evaluate head and call the evaluation routine recursively on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 ".\n\t",
 StyleBox["(7b)", "Subsubsection"],
 " If \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], TraditionalForm]]],
 ", is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Unevaluated", "[", 
    SubscriptBox["expr", "i"], "]"}], TraditionalForm]]],
 ", replace ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 " by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["expr", "i"], TraditionalForm]]],
 " and make a note that this was done (see step 16). \n\t",
 StyleBox["(7c)", "Subsubsection"],
 " If \"head\" is a symbol having the HoldAll attribute, continue to step 8 \
without evaluating any of the arguments.\n\t",
 StyleBox["(7d)", "Subsubsection"],
 " If i==1 is True and \"head\" is a symbol having the HoldFirst attribute, \
continue with step 7 for the next part: \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "2"], TraditionalForm]]],
 "\".\n\t",
 StyleBox["(7e)", "Subsubsection"],
 " If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ">", "1"}], TraditionalForm]]],
 " is True and \"head\" is a symbol having the HoldRest attribute, continue \
to step 8 without evaluating the remaining arguments.\n\t",
 StyleBox["(7f)", "Subsubsection"],
 " Call the evaluation routine recursively on \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", until it is ",
 StyleBox["completely",
  FontVariations->{"Underline"->True}],
 " evaluated.\n",
 StyleBox["Step 8:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Flat", "Subsubsection"],
 "\n",
 StyleBox["Step 9:", "Subsubsection"],
 " ",
 StyleBox["Automatically Splice Sequences", "Subsubsection"],
 "\n",
 StyleBox["Step 10:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Listable", "Subsubsection"],
 "\n",
 StyleBox["Step 11:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Orderless", "Subsubsection"],
 "\n",
 StyleBox["Step 12: Apply User-Defined UpValues Associated with ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["part", "i"], "Subsubsection"], TraditionalForm]]],
 "\n",
 StyleBox["Step 13: Apply Internally-Defined UpValues Associated with ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["part", "i"], "Subsubsection"], TraditionalForm]]],
 "\n",
 StyleBox["Step 14: Apply User-Defined DownValues Associated with \"head\"", 
  "Subsubsection"],
 "\n",
 StyleBox["Step 15: Apply Internally-Defined DownValues Associated with \
\"head\"\n\t  (This is where most internal functions take over and are \
evaluated)", "Subsubsection"],
 "\n",
 StyleBox["Step 16: Restore Unevaluated[...]", "Subsubsection"],
 "\n",
 StyleBox["Step 17: Discard Return[...]", "Subsubsection"]
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 1A:  Standard Evaluation Procedure:", "Subsection"],

Cell[TextData[{
 "At this time it should be helpful to explicitly trace the evaluation \
procedure of a simple expression.\nConsider the evaluation procedure for the \
following function (which does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " hold any of its arguments):\n\t\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{"x1", "=", "1"}], ";"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"x2", "=", "2"}], ";"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"x3", "=", "3"}], ";"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "z_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"x2", "=", "z"}], ")"}]}], ";"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    FormBox[
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"z1_", ",", "z2_", ",", "z3_"}], "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{"z1", ",", "z2", ",", "z3"}], "}"}]}], ";"}],
     TraditionalForm], "\[IndentingNewLine]"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"g", "[", "x1", "]"}], ",", 
     RowBox[{"g", "[", "x2", "]"}], ",", 
     RowBox[{"g", "[", "x3", "]"}]}], "]"}], TraditionalForm]}]],
 "\nThe precise meanings of the functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "...", "]"}], "  ", "and", "  ", 
    RowBox[{"g", "[", "...", "]"}]}], TraditionalForm]]],
 ", etc. are relevant.  All functions pass through the same universal \
evaluation procedure.  Functions behave differently ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " because they are exposed to different parts of the universal evaluation \
procedure.  This control is determined by each function's attributes like \
HoldAll, HoldRest, Listable etc. and control functions like Unevaluated[...], \
Hold[...], HoldPattern[...] etc..\nThe actual code and trace for the above \
example follows.  This function utilizes the Standard Evaluation procedure."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "f", ",", "g"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"x1", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x2", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x3", "=", "3"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", "z_", "]"}], ":=", 
    RowBox[{"x2", "=", "z"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"z1_", ",", "z2_", ",", "z3_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{"z1", ",", "z2", ",", "z3"}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"g", "[", "x1", "]"}], ",", 
     RowBox[{"g", "[", "x2", "]"}], ",", 
     RowBox[{"g", "[", "x3", "]"}]}], "]"}], "//", "Trace"}], "//", 
  "Column"}]}], "Input",
 CellChangeTimes->{{3.3898495608616557`*^9, 3.3898495871566553`*^9}}],

Cell[TextData[{
 "The above trace can be illustrated visually using the following color \
codes:\n\t",
 StyleBox["\[FilledSquare]",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 "  Function or symbol being evaluated.\n\t",
 StyleBox["\[FilledSquare]",
  FontSize->18,
  FontColor->RGBColor[1, 0, 0]],
 "  Argument to be evaluated within the function. \n\t",
 StyleBox["\[FilledSquare]",
  FontSize->18,
  FontColor->RGBColor[1, 0, 1]],
 "  Function or symbol assignment.\nExamine the following lines carefully and \
relate each line to the trace above and the evaluation procedure outlined \
below."
}], "Text"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"f", "[", 
       StyleBox["]",
        FontSize->1]}], 
      RowBox[{"g", "[", 
       StyleBox["]",
        FontSize->1]}], "x1", 
