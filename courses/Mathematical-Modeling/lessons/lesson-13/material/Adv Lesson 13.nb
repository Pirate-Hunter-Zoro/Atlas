Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \nAdvanced Lesson 13\n\nCommon Mistakes\nDebugging with Trace[...]\n\
Controlling the Scope of Variables\n",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure\nExamples\nComputational Speed\n\nDr. Dale R. Doty\n\
University of Tulsa"
}], "Title"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Common Mistakes: ", "Subtitle"]], "Section"],

Cell[BoxData[
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]], "InputOnly",
 CellChangeTimes->{3.3998040088978376`*^9}],

Cell[CellGroupData[{

Cell["Mistake: Forgetting to Clear Predefined Variables:", "Subsection"],

Cell[TextData[{
 "For those functions that do NOT have the Hold, HoldRest or HoldAll \
Attributes, then when that function is assigned, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will substitute assigned values for all arguments ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " ",
 "assignment",
 "."
}], "Text",
 CellChangeTimes->{{3.3898435949166555`*^9, 3.3898435976906557`*^9}, {
  3.523291288673321*^9, 3.5232912930433645`*^9}}],

Cell[BoxData[
 RowBox[{"x", "=", "3"}]], "Input"],

Cell[" Observe the following mistake:", "Text"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Program"],

Cell["\<\
Integrate::\"ilim\" : \"Invalid integration variable or limit(s) in 3.\"\
\>", "Program",
 CellChangeTimes->{{3.3900445480934*^9, 3.3900445546823997`*^9}}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"Sin", "[", "3", "]"}], 
   RowBox[{"\[DifferentialD]", "3"}]}]}]], "Program"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Attributes", " ", "[", "Integrate", "]"}]}]], "Input"],

Cell["\<\

You must clear all assignments made to the arguments of a function which does \
not have its arguments held. \
\>", "Text",
 CellChangeTimes->{3.5232913024434586`*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", "x", "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["Mistake: Missing or Incorrect Punctuation:", "Subsection"],

Cell[TextData[{
 "The possibilities for problems in this case are almost limitless because ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " accepts almost any input and yields some result.  Consider the following \
example:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", "f", "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "   ", "Integer"}], "]"}], ":=", 
  "\"\<x is an Integer\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  "\"\<x is Not an Integer\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"f", "[", "3", "]"}]], "Input"],

Cell["\<\

 Observe that the test for an argument with an integer head failed.\
\>", "Text",
 CellChangeTimes->{3.523291368204116*^9}],

Cell[BoxData[
 RowBox[{"??", "f"}]], "Input"],

Cell["\<\

Note that the space between \"x_\" and \"Integer\" is interpreted as \
multiplication.  Therefore there is no pattern match for f[3] as an Integer.\
\>", "Text",
 CellChangeTimes->{3.3898437126426554`*^9, 3.5232913696341305`*^9}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Debugging with Trace[...]:", "Subtitle"]], "Section"],

Cell[CellGroupData[{

Cell[" Intermediate Results With \"?\":", "Subsection"],

Cell[TextData[{
 " It is always possible to determine the contents of any expression by \
placing \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"?", "..."}], TraditionalForm]]],
 "\" ",
 StyleBox["between",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " cells.  "
}], "Text",
 CellChangeTimes->{{3.3898437996016555`*^9, 3.3898438610246553`*^9}, {
  3.5232914126745605`*^9, 3.5232914211546454`*^9}}],

Cell[TextData[{
 "Consider the case of finding information about a symbol within a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " cell using the \"?\" command:"
}], "Text",
 CellChangeTimes->{{3.389843873181656*^9, 3.3898438745216556`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sum", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sum", "=", 
   RowBox[{"sum", "+", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sum", "=", 
   RowBox[{"sum", "+", "1"}]}], ";"}]}], "InputOnly"],

Cell[BoxData[
 RowBox[{"?", "sum"}]], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sum", "=", 
   RowBox[{"sum", "+", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sum", "=", 
   RowBox[{"sum", "+", "1"}]}], ";"}]}], "InputOnly"],

Cell[BoxData[
 RowBox[{"?", "sum"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Intermediate Results With \"Print[...]\":", "Subsection"],

Cell[TextData[{
 "Consider the case of printing information about a quantity ",
 StyleBox["within",
  FontVariations->{"Underline"->True}],
 " a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " cell using the \"Print[...]\" command:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sum", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sum", "=", 
   RowBox[{"sum", "+", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sum", "=", 
    RowBox[{"sum", "+", "1"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<sum=\>\"", ",", "sum"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sum", "=", 
    RowBox[{"sum", "+", "1"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sum", "=", 
    RowBox[{"sum", "+", "1"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<sum=\>\"", ",", "sum"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sum", "=", 
    RowBox[{"sum", "+", "1"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<sum=\>\"", ",", "sum"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.389843911294656*^9, 3.3898439728756557`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Tracing an Evaluation:", "Subsection"],

Cell["\<\
Trace[expr] generates a list of all expressions used in the evaluation of \
expr. 
Trace[expr, form] includes only those expressions which match form. 
Trace[expr, s] includes all evaluations which use transformation rules \
associated with the symbol s.\
\>", "Item",
 CellChangeTimes->{{3.3900445884533997`*^9, 3.3900445914974003`*^9}},
 FontWeight->"Bold"],

Cell["\<\
Consider the simple case of tracing the addition of two integers:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Trace", "[", 
  RowBox[{"1", "+", "2"}], "]"}]], "Input"],

Cell["\<\

Observe that the output of the Trace[...] command is a sequence of steps \
containing information leading to the final result.  In this case, the first \
step is entering:1 + 2, the second step is the evaluation to 3.

The second example traces the algebra required to evaluate the expression:  \
a+b-a\
\>", "Text",
 CellChangeTimes->{3.523291451524949*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Trace", "[", 
  RowBox[{"a", "+", "b", "-", "a"}], "]"}]}], "Input"],

Cell[TextData[{
 "\nObserve that the output of the Trace[...] command is a sequence of steps \
containing information leading to the final result.  In this case, the first \
step is entering: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "+", "b", "-", "a"}], TraditionalForm]]],
 ", the second step is to reorder the result to:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "a"}], "+", "a", "+", "b"}], TraditionalForm]]],
 ", the third step is the evaluation to ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]]],
 ".\n\nThe third example traces the algebra required to expand the \
expression:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "*", 
    RowBox[{"(", 
     RowBox[{"x", "+", "1"}], ")"}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.5232914652350864`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "x", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Trace", "[", " ", "\[IndentingNewLine]", 
   RowBox[{"Expand", " ", "[", 
    RowBox[{"x", "*", 
     RowBox[{"(", 
      RowBox[{"x", "+", "1"}], ")"}]}], "]"}], "\[IndentingNewLine]", "]"}], 
  "  "}]}], "Input",
 CellChangeTimes->{{3.3898440947816553`*^9, 3.3898440993506556`*^9}}],

Cell[TextData[{
 "\nObserve that the output of the Trace[...] command is a sequence of steps \
containing information leading to the final result.  In this case, the first \
step is entering: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "+", "1"}], TraditionalForm]]],
 " to yield: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "x"}], TraditionalForm]]],
 "  (this is expressed as an ordered pair:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "+", "1"}], ",", 
     RowBox[{"1", "+", "x"}]}], "}"}], TraditionalForm]]],
 "), the second step is to substitute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "x"}], TraditionalForm]]],
 " into the result to get:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}]}], TraditionalForm]]],
 ", the third step is to expand the result:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Expand", "[", 
    RowBox[{"x", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "x"}], ")"}]}], "]"}], TraditionalForm]]],
 ", which yields the final result of:",
 Cell[BoxData[
  RowBox[{"   ", 
   TagBox[
    RowBox[{"x", "+", 
     SuperscriptBox["x", "2"]}],
    HoldForm]}]],
  FontWeight->"Bold"],
 StyleBox[".",
  FontWeight->"Bold"],
 "\n\nThe final example traces the algebra required to expand the expression: \
",
 Cell[BoxData[
  RowBox[{"Expand", "[", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Integral]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "+", "1"}], ")"}], "4"], 
       RowBox[{"\[DifferentialD]", "x"}]}]}], ")"}], "2"], "]"}]],
  FontWeight->"Bold"],
 ".  Observe that the integration is automatically performed, however the \
square must be explicitly expanded. "
}], "Text",
 CellChangeTimes->{3.5232914739551735`*^9}],

Cell[BoxData[
 RowBox[{"Expand", "[", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "1"}], ")"}], "4"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], ")"}], "2"], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Trace", " ", "[", "\[IndentingNewLine]", 
   RowBox[{"Expand", " ", "[", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Integral]", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "+", "1"}], ")"}], "4"], 
        RowBox[{"\[DifferentialD]", "x"}]}]}], ")"}], "2"], "]"}], 
   "\[IndentingNewLine]", "]"}], "  "}]], "Input",
 CellChangeTimes->{{3.3898440846566553`*^9, 3.3898440885886555`*^9}}],

Cell[TextData[{
 "\nObserve that the output of the Trace[...] command is a sequence of steps \
containing information leading to the final result.  Also observe that this \
output is nested.  Each sequence contained within a list produces an \
intermediate result:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"...", ",", "...", ",", "...", ",", 
     RowBox[{"intermediate", " ", "result"}]}], "}"}], TraditionalForm]]],
 ".\nThese intermediate results are nested to produce the final result:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"...", ",", "..."}], "}"}], ",", "...", ",", "..."}], 
          "}"}], ",", "...", ",", 
         TagBox["...",
          HoldForm]}], "}"}], ",", "...", ",", 
       TagBox["...",
        HoldForm], ",", 
       RowBox[{"{", 
        RowBox[{"...", ",", 
         TagBox["...",
          HoldForm]}], "}"}], ",", 
       TagBox["...",
        HoldForm]}], "}"}], ",", "...", ",", 
     TagBox[
      RowBox[{"final", " ", "result"}],
      HoldForm]}], "}"}], TraditionalForm]]],
 ".\nIn this case, the first step is entering: x+1 to yield: 1+x.  This is \
expressed as a sequence of two steps within a list:  \n\t",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    TagBox[
     RowBox[{"x", "+", "1"}],
     HoldForm], ",", 
    TagBox[
     RowBox[{"1", "+", "x"}],
     HoldForm]}], "}"}]]],
 ".\nThe second step is to substitute 1+x into the fourth power, thereby \
completing this intermediate result: \n\t ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"x", "+", "1"}],
       HoldForm], ",", 
      TagBox[
       RowBox[{"1", "+", "x"}],
       HoldForm]}], "}"}], ",", 
    TagBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}], "4"],
     HoldForm]}], "}"}]]],
 ".\nThe third step is to  Integrate this result: ",
 Cell[BoxData[
  RowBox[{"\[Integral]", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", "1"}], ")"}], "4"], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]]],
 ", which yields the intermediate result:  \n\t",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        TagBox["...",
         HoldForm], ",", 
        TagBox["...",
         HoldForm]}], "}"}], ",", 
      TagBox["...",
       HoldForm]}], "}"}], ",", 
    TagBox[
     RowBox[{"\[Integral]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], "4"], 
       RowBox[{"\[DifferentialD]", "x"}]}]}],
     HoldForm], ",", 
    TagBox[
     RowBox[{
      FractionBox["1", "5"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "5"]}],
     HoldForm]}], "}"}]]],
 " .\nThis completes the evaluation sequence: \n\t",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        TagBox[
         RowBox[{"x", "+", "1"}],
         HoldForm], ",", 
        TagBox[
         RowBox[{"1", "+", "x"}],
         HoldForm]}], "}"}], ",", 
      TagBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], "4"],
       HoldForm]}], "}"}], ",", 
    TagBox[
     RowBox[{"\[Integral]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], "4"], 
       RowBox[{"\[DifferentialD]", "x"}]}]}],
     HoldForm], ",", 
    TagBox[
     RowBox[{
      FractionBox["1", "5"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "5"]}],
     HoldForm]}], "}"}]]],
 ". \nThe next step is to square this result:  ",
 Cell[BoxData[
  TagBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "5"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "5"]}], ")"}], "2"],
   HoldForm]]],
 ", which is evaluated as:  \n\t",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "...", "}"}], ",", 
    TagBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "5"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "x"}], ")"}], "5"]}], ")"}], "2"],
     HoldForm], ",", 
    TagBox[
     RowBox[{
      FractionBox["1", "25"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "x"}], ")"}], "5"], ")"}], "2"]}],
     HoldForm], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "x"}], ")"}], "5"], ")"}], "2"],
       HoldForm], ",", 
      TagBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], "10"],
       HoldForm]}], "}"}], ",", 
    TagBox[
     RowBox[{
      FractionBox["1", "25"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "10"]}],
     HoldForm]}], "}"}]]],
 ". \nEnter this into the Expand[...] command:\n\t ",
 Cell[BoxData[
  TagBox[
   RowBox[{"Expand", "[", 
    RowBox[{
     FractionBox["1", "25"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}], "10"]}], "]"}],
   HoldForm]]],
 ", \nwhich yields the final result: \n\t",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "...", "}"}], ",", 
    TagBox[
     RowBox[{"Expand", "[", 
      RowBox[{
       FractionBox["1", "25"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], "10"]}], "]"}],
     HoldForm], ",", "\[IndentingNewLine]", 
    TagBox[
     RowBox[{
      FractionBox["1", "25"], "+", 
      FractionBox[
       RowBox[{"2", " ", "x"}], "5"], "+", 
      FractionBox[
       RowBox[{"9", " ", 
        SuperscriptBox["x", "2"]}], "5"], "+", 
      FractionBox[
       RowBox[{"24", " ", 
        SuperscriptBox["x", "3"]}], "5"], "+", 
      FractionBox[
       RowBox[{"42", " ", 
        SuperscriptBox["x", "4"]}], "5"], "+", 
      FractionBox[
       RowBox[{"252", " ", 
        SuperscriptBox["x", "5"]}], "25"], "+", 
      FractionBox[
       RowBox[{"42", " ", 
        SuperscriptBox["x", "6"]}], "5"], "+", 
      FractionBox[
       RowBox[{"24", " ", 
        SuperscriptBox["x", "7"]}], "5"], "+", 
      FractionBox[
       RowBox[{"9", " ", 
        SuperscriptBox["x", "8"]}], "5"], "+", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["x", "9"]}], "5"], "+", 
      FractionBox[
       SuperscriptBox["x", "10"], "25"]}],
     HoldForm]}], "}"}]]],
 "."
}], "Text",
 CellChangeTimes->{3.5232914843852777`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Example: easyTrace [expr]", "Subsection"],

Cell["\<\
One major problem with Trace[...] is the notation which it uses.  Trace[...] \
might be more convenient to use if it had a more friendly notation.  \
Therefore, the function easyTrace[...] was created which uses pattern \
matching and replacement rules to clean up the notation found in Trace[...].  \
However, it is NOT bullet proof like Trace[...] is.\
\>", "Text",
 CellChangeTimes->{{3.5232915469259033`*^9, 3.523291573326167*^9}}],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", " ", 
  RowBox[{"easyTrace", ",", " ", "HoldAll"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"easyTrace", "[", "expr_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "y1", ",", "temp"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"temp", "=", 
      RowBox[{"Trace", "[", "expr", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"temp", "=", 
      RowBox[{"temp", "//.", "\[InvisibleSpace]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1___", ",", "y1_", ",", "y1_"}], "}"}], "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"x1", ",", "y1"}], "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"temp", "=", 
      RowBox[{"temp", "//.", "\[InvisibleSpace]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1_", ",", "y1_"}], "}"}], "\[Rule]", 
        RowBox[{"x1", "\[DoubleRightArrow]", "y1"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"temp", "//.", "\[InvisibleSpace]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x1_", ",", "x2__", ",", "y1_"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x1", ",", "x2"}], "}"}], "\[DoubleLongRightArrow]", "y1"}],
         "}"}]}]}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898443182056556`*^9, 3.3898443547556553`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["Examples:", "Subsection"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "x", ",", "f"}], "]"}]], "InputOnly"],

Cell["Repeating the examples developed above using easyTrace[...]:", "Text"],

Cell[BoxData[
 RowBox[{"easyTrace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"a", "+", "b", "-", "a"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898443818196554`*^9, 3.3898443855796556`*^9}}],

Cell[BoxData[
 RowBox[{"easyTrace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Expand", " ", "[", 
   RowBox[{"x", "*", 
    RowBox[{"(", 
     RowBox[{"x", "+", "1"}], ")"}]}], "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898443917706556`*^9, 3.389844396372656*^9}}],

Cell[BoxData[
 RowBox[{"easyTrace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Expand", " ", "[", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Integral]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "+", "1"}], ")"}], "4"], 
       RowBox[{"\[DifferentialD]", "x"}]}]}], ")"}], "2"], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898444189656553`*^9, 3.3898444371126556`*^9}}],

Cell["\<\

As a final example, compare the use of Trace[...] with easyTrace[...] on a \
replacement rule.  Before the replacement rule is evaluated, assignments are \
made to \"a\" and \"b\".  Compare how the assignments and replacements are \
made using Trace[...] and easyTrace[...].\
\>", "Text",
 CellChangeTimes->{3.5232916524369583`*^9}],

Cell[BoxData[
 RowBox[{"a", "=", "A"}]], "Input"],

Cell[BoxData[
 RowBox[{"b", "=", "B"}]], "Input"],

Cell[BoxData[
 RowBox[{"Trace", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f", "[", "a", "]"}], " ", "/.", " ", 
   RowBox[{"a", " ", "\[Rule]", "b"}]}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898444905816555`*^9, 3.3898444958646555`*^9}}],

Cell[BoxData[
 RowBox[{"easyTrace", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f", "[", "a", "]"}], " ", "/.", " ", 
   RowBox[{"a", " ", "\[Rule]", "b"}]}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898445047436557`*^9, 3.3898445076246557`*^9}}],

Cell["\<\

Warning: easyTrace[...] should be used primarily to help you understand what \
is happening when you use the Trace[...] command.  easyTrace[...] may produce \
confusing results in some circumstances.\
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Recommendation: Use Trace[expr, pattern] or Trace[expr, symbol]\
\>", "Subsection"],

Cell["\<\
Effective use of the Trace[...] command necessitates the use of the second \
argument:\
\>", "Text"],

Cell["\<\
Trace[expr] generates a list of all expressions used in the evaluation of \
expr. 
Trace[expr, form] includes only those expressions which match form. 
Trace[expr, s] includes all evaluations which use transformation rules \
associated with the symbol s.\
\>", "Item"],

Cell[TextData[{
 "The above examples clearly illustrate that a complicated expression (say \
with 1000 steps) will generate a truly huge trace.  Therefore, you usually \
need to restrict the information that you want traced.  This can be \
accomplished by using the following form of the Trace[...] command:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Trace", "[", 
     RowBox[{"expr", ",", "pattern"}], "]"}],
    FontWeight->"Bold",
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 ",\nwhere the pattern is chosen to extract only the information that you \
want.\nBasically, your ability to use the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Trace", "[", 
    RowBox[{"...", ",", "pattern"}], "]"}], TraditionalForm]]],
 " command depends directly upon your ability to construct appropriate \
patterns.  The following table illustrates some sample patterns that might be \
used:"
}], "Text",
 CellChangeTimes->{{3.389844596181656*^9, 3.3898446123086557`*^9}}],

Cell[TextData[{
 "\t ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      StyleBox[
       RowBox[{"Trace", "[", 
        RowBox[{"expr", ",", "pattern"}], "]"}],
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox["=",
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[
       RowBox[{"Show", " ", "only", " ", "match", " ", "of", " ", "pattern"}],
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"f", "[", "___", "]"}]}], "]"}], "=", 
      RowBox[{
      "Show", " ", "all", " ", "calls", " ", "to", " ", "function", " ", 
       "f"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"x", "=", "_"}]}], "]"}], "=", 
      RowBox[{"Show", " ", "all", " ", "assignments", " ", "to", " ", "x"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "=", "_"}]}], "]"}], "=", 
      RowBox[{"Show", " ", "every", " ", "assignment"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "+", "_"}]}], "]"}], "=", 
      RowBox[{
       RowBox[{"Show", " ", "every", " ", "sum"}], ",", " ", 
       RowBox[{"any", " ", "length"}]}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "*", "a"}]}], "]"}], "=", 
      RowBox[{
      "Show", " ", "every", " ", "product", " ", "containing", " ", "a"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        SqrtBox["_"]}], "]"}], "=", 
      RowBox[{"Show", " ", "only", " ", "every", " ", "square", " ", "root"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        SuperscriptBox["_", "_"]}], "]"}], "=", 
      RowBox[{"Show", " ", "only", " ", "every", " ", "power"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        SuperscriptBox["x", "_"]}], "]"}], "=", 
      RowBox[{
      "Show", " ", "only", " ", "every", " ", "power", " ", "of", " ", "x"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "*", 
         SuperscriptBox["x", "_"]}]}], "]"}], "=", 
      RowBox[{
      "Show", " ", "product", " ", "with", " ", "power", " ", "of", " ", 
       "x"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "+", 
         RowBox[{"_", "*", 
          SuperscriptBox["x", "_"]}]}]}], "]"}], "=", 
      RowBox[{
      "Sum", " ", "with", " ", "products", " ", "with", " ", "power", " ", 
       "of", " ", "x"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"\[Integral]", 
         RowBox[{"_", 
          RowBox[{"\[DifferentialD]", "_"}]}]}]}], "]"}], "=", 
      RowBox[{"Show", " ", "only", " ", "every", " ", "integration"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "/.", "_"}]}], "]"}], "=", 
      RowBox[{"Show", " ", "every", " ", "replacement", " ", "rule"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "/.", 
         RowBox[{"x", "\[Rule]", "_"}]}]}], "]"}], "=", 
      RowBox[{
      "Show", " ", "every", " ", "x", " ", "replacement", " ", "rule"}]},
     {
      RowBox[{"etc", "."}], "=", 
      RowBox[{"etc", "."}]}
    },
    GridBoxDividers->{
     "Columns" -> {True, {False}, True}, "ColumnsIndexed" -> {}, 
      "Rows" -> {{True}}, "RowsIndexed" -> {}}], TraditionalForm]]]
}], "Text"],

Cell[TextData[{
 "\nAs a first example, consider constructing a table that assigns  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "2"], TraditionalForm]]],
 "  to  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "[", "n", "]"}], TraditionalForm]]]
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "z", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"z", "[", "n", "]"}], "=", 
    SuperscriptBox["n", "2"]}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}]}], "Input"],

Cell["\<\

Trace the construction of this list:\
\>", "Text",
 CellChangeTimes->{3.5232917471179047`*^9}],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"z", "[", "n", "]"}], "=", 
     SuperscriptBox["n", "2"]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898446627196555`*^9, 3.389844666384656*^9}}],

Cell[TextData[{
 "\nThe above trace would quickly become too long to be useful for large \
values of n.\nTherefore, only trace the assignments to  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "[", "n", "]"}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.5232917712681465`*^9}],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "[", "n", "]"}], "=", 
      SuperscriptBox["n", "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z", "[", "_", "]"}], "=", "_"}]}], "]"}]], "Input"],

Cell[TextData[{
 "\nThere are of course several different ways to do this.\n\nAs a second \
example, consider the following polynomial of the function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.523291781518249*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "x", ",", "t"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"temp", "=", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"i", "=", "0"}], "2"], 
   RowBox[{
    SubscriptBox["a", "i"], " ", 
    SuperscriptBox[
     RowBox[{"x", "[", "t", "]"}], "i"]}]}]}]}], "Input"],

Cell[TextData[{
 "\nTrace the replacement of each coefficient  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "i"], TraditionalForm]]],
 "  and the variable  t:"
}], "Text",
 CellChangeTimes->{3.5232918122585564`*^9}],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"temp", "/.", 
      RowBox[{
       SubscriptBox["a", "0"], "\[Rule]", "3"}]}], "/.", 
     RowBox[{
      SubscriptBox["a", "1"], "\[Rule]", "4"}]}], "/.", 
    RowBox[{
     SubscriptBox["a", "2"], "\[Rule]", "5"}]}], "/.", 
   RowBox[{"t", "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898447126116557`*^9, 3.3898447175036554`*^9}}],

Cell[TextData[{
 "\nAgain, the above trace may be too long to be helpful.\nTherefore, trace \
only those expressions constructed as a sum which contain a coefficient times \
a power of the function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "[", "t", "]"}], TraditionalForm]]],
 ".  One possible pattern matching this description is:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"_", "+", 
    RowBox[{"_", "*", 
     SuperscriptBox[
      RowBox[{"x", "[", "t", "]"}], "_"]}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.523291827888713*^9}],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"temp", "/.", 
       RowBox[{
        SubscriptBox["a", "0"], "\[Rule]", "3"}]}], "/.", 
      RowBox[{
       SubscriptBox["a", "1"], "\[Rule]", "4"}]}], "/.", 
     RowBox[{
      SubscriptBox["a", "2"], "\[Rule]", "5"}]}], "/.", 
    RowBox[{"t", "\[Rule]", "1"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"_", "+", 
    RowBox[{"_", "*", 
     SuperscriptBox[
      RowBox[{"x", "[", "t", "]"}], "_"]}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898447423746557`*^9, 3.389844742676656*^9}}],

Cell[TextData[{
 "\nObserve that you can quickly follow the resulting replacements in the \
above polynomial expression.\n\nAs a final example, consider tracing only the \
expressions containing the replacements.  One possible pattern matching this \
description is:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"_", "/.", 
    RowBox[{"_", "\[Rule]", "_"}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.523291846688901*^9}],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"temp", "/.", 
       RowBox[{
        SubscriptBox["a", "0"], "\[Rule]", "3"}]}], "/.", 
      RowBox[{
       SubscriptBox["a", "1"], "\[Rule]", "4"}]}], "/.", 
     RowBox[{
      SubscriptBox["a", "2"], "\[Rule]", "5"}]}], "/.", 
    RowBox[{"t", "\[Rule]", "1"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"_", "/.", 
    RowBox[{"_", "\[Rule]", "_"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898447837936554`*^9, 3.3898447839896555`*^9}}],

Cell["\<\

In summary, the ability to make sense out of the Trace[..., pattern]  command \
requires a judicious choice of patterns.\
\>", "Text",
 CellChangeTimes->{3.523291875489189*^9}],

Cell[TextData[{
 "\nAnother application of the Trace command is:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Trace", "[", 
     RowBox[{"expr", ",", "_head"}], "]"}],
    FontWeight->"Bold",
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 "\nThe following table contains some illustrations on how the this might be \
used:"
}], "Text"],

Cell[TextData[{
 "\t ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      StyleBox[
       RowBox[{"Trace", "[", 
        RowBox[{"expr", ",", "_h"}], "]"}],
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox["=",
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[
       RowBox[{
       "Show", " ", "all", " ", "expressions", " ", "with", " ", "head", " ", 
        "h"}],
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", "_f"}], "]"}], "=", 
      RowBox[{
      "Show", " ", "all", " ", "expressions", " ", "with", " ", "head", " ", 
       "f"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"f", "[", "_Integer", "]"}]}], "]"}], "=", 
      RowBox[{"Show", " ", 
       RowBox[{"f", "[", "x", "]"}], " ", "only", " ", "for", " ", "Integer", 
       " ", "x"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", "_Plus"}], "]"}], "=", 
      RowBox[{"Show", " ", "all", " ", "sums"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", "_Times"}], "]"}], "=", 
      RowBox[{"Show", " ", "all", " ", "products"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"f", "[", "_Plus", "]"}]}], "]"}], "=", 
      RowBox[{"Show", " ", "only", " ", 
       RowBox[{"f", "[", 
        RowBox[{
         RowBox[{"a", "+", "b", "+"}], "..."}], "]"}]}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", "_Sin"}], "]"}], "=", 
      RowBox[{"Show", " ", "all", " ", 
       RowBox[{"Sin", "[", "...", "]"}]}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "+", "_f"}]}], "]"}], "=", 
      RowBox[{"Show", " ", "all", " ", "sums", " ", "containing", " ", 
       RowBox[{"f", "[", "...", "]"}]}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", "_List"}], "]"}], "=", 
      RowBox[{"Show", " ", "all", " ", 
       RowBox[{"{", " ", "...", " ", "}"}]}]},
     {
      RowBox[{"etc", "."}], "=", 
      RowBox[{"etc", "."}]}
    },
    GridBoxDividers->{
     "Columns" -> {True, {False}, True}, "ColumnsIndexed" -> {}, 
      "Rows" -> {{True}}, "RowsIndexed" -> {}}], TraditionalForm]]]
}], "Text"],

Cell["\<\
As an example, consider tracing our above polynomial where the pattern to be \
matched has head \"Plus\":\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"temp", "/.", 
       RowBox[{
        SubscriptBox["a", "0"], "\[Rule]", "3"}]}], "/.", 
      RowBox[{
       SubscriptBox["a", "1"], "\[Rule]", "4"}]}], "/.", 
     RowBox[{
      SubscriptBox["a", "2"], "\[Rule]", "5"}]}], "/.", 
    RowBox[{"t", "\[Rule]", "1"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "_Plus"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389844866570656*^9, 3.389844866773656*^9}}],

Cell[TextData[{
 "\nAnother application of the Trace command is:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Trace", "[", 
     RowBox[{"expression", ",", 
      RowBox[{"pattern", " ", "/;", "test"}]}], "]"}],
    FontWeight->"Bold",
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 "\nThe following table contains some illustrations on how the this might be \
used:"
}], "Text"],

Cell[TextData[{
 "\t ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      StyleBox[
       RowBox[{"Trace", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"patt", " ", "/;", "test"}]}], "]"}],
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox["=",
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[
       RowBox[{
       "Show", " ", "only", " ", "pattern", " ", "passing", " ", "test"}],
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "/;", 
         RowBox[{"x", ">", "0"}]}]}], "]"}], "=", 
      RowBox[{
       RowBox[{"Show", " ", "anything", " ", "when", " ", "x"}], ">", "0"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"_", "/;", 
         RowBox[{"4", "\[LessEqual]", "k", "\[LessEqual]", "8"}]}]}], "]"}], 
      "=", 
      RowBox[{
       RowBox[{"Show", " ", "anything", " ", "when", "  ", "4"}], 
       "\[LessEqual]", "k", "\[LessEqual]", "8"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{
         RowBox[{"_", "/;", 
          RowBox[{
           RowBox[{"x", ">", "0"}], "\[And]", "y"}]}], "=", "1"}]}], "]"}], 
      "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Show", " ", "anything", " ", "when", " ", "x"}], ">", "0"}],
         "\[And]", "y"}], "=", "1"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"f", "[", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", ">", "0"}]}], "]"}]}], "]"}], "=", 
      RowBox[{
       RowBox[{"Show", " ", 
        RowBox[{"f", "[", "x", "]"}], " ", "only", " ", "when", " ", "x"}], 
       ">", "0"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"x_", ",", "y_"}], "]"}], "/;", 
         RowBox[{
          RowBox[{"x", ">", "0"}], "\[Or]", 
          RowBox[{"y", ">", "0"}]}]}]}], "]"}], "=", 
      RowBox[{
       RowBox[{"Show", " ", 
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], " ", "when", " ", "x"}], ">", 
       RowBox[{"0", " ", "or", " ", "y"}], ">", "0"}]},
     {
      RowBox[{"etc", "."}], "=", 
      RowBox[{"etc", "."}]}
    },
    GridBoxDividers->{
     "Columns" -> {True, {False}, True}, "ColumnsIndexed" -> {}, 
      "Rows" -> {{True}}, "RowsIndexed" -> {}}], TraditionalForm]]]
}], "Text"],

Cell[TextData[{
 "The variables x, y and k can be either local or global depending upon your \
needs.\n\nAs a first example, consider constructing a table that assigns  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "2"], TraditionalForm]]],
 "  to  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "[", "n", "]"}], TraditionalForm]]],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "=", "1"}], ",", "...", ",", "100"}], TraditionalForm]]],
 ".\n(The full trace of this expression would be huge.)"
}], "Text"],

Cell[TextData[{
 "Trace ",
 StyleBox["every",
  FontVariations->{"Underline"->True}],
 " term in the construction of this list (i.e. \"_\") for:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"77", "\[LessEqual]", "n", "\[LessEqual]", "80"}], 
   TraditionalForm]]],
 " (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"...", "/;", 
    RowBox[{"77", "\[LessEqual]", "n", "\[LessEqual]", "80"}]}], 
   TraditionalForm]]],
 ")"
}], "Text",
 CellChangeTimes->{{3.3898449399696555`*^9, 3.3898449647326555`*^9}}],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "[", "n", "]"}], "=", 
      SuperscriptBox["n", "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "100"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"_", "/;", 
    RowBox[{"77", "\[LessEqual]", "n", "\[LessEqual]", "80"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898449145806556`*^9, 3.3898449152796555`*^9}, {
  3.3898449467826557`*^9, 3.3898449705286555`*^9}}],

Cell[TextData[{
 "\nConsider further restricting the trace to the assignments:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"z", "[", "n", "]"}], "=", 
    SuperscriptBox["n", "2"]}], TraditionalForm]]],
 "  (i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"z", "[", "_", "]"}], "=", "_"}], TraditionalForm]]],
 " )"
}], "Text",
 CellChangeTimes->{3.5232919164495983`*^9}],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "[", "n", "]"}], "=", 
      SuperscriptBox["n", "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "100"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z", "[", "_", "]"}], "=", 
    RowBox[{"_", "/;", 
     RowBox[{"77", "\[LessEqual]", "n", "\[LessEqual]", "80"}]}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898449846206555`*^9, 3.3898450300816555`*^9}, 
   3.3898450620416555`*^9}],

Cell[TextData[{
 "\nAs a second example, consider what would happen if the above Table[...] \
command was contained within a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      StyleBox["z",
       FontColor->RGBColor[1, 0, 0]], "}"}], ",", "..."}], "]"}], 
   TraditionalForm]]],
 " where the variable ",
 StyleBox["z",
  FontColor->RGBColor[1, 0, 0]],
 " has been localized:"
}], "Text",
 CellChangeTimes->{3.5232919215896497`*^9}],

Cell[BoxData[
 RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "z", "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"z", "[", "n", "]"}], "=", 
        SuperscriptBox["n", "2"]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "100"}], "}"}]}], "]"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z", "[", "_", "]"}], "=", 
    RowBox[{"_", "/;", 
     RowBox[{"77", "\[LessEqual]", "n", "\[LessEqual]", "80"}]}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389845085629656*^9, 3.3898450861376553`*^9}}],

Cell["\<\

Observe that even the local variables can be traced by this procedure.\
\>", "Text",
 CellChangeTimes->{3.5232919870803046`*^9}],

Cell[TextData[{
 "\nAnother application of the Trace command is:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Trace", "[", 
     RowBox[{"expression", ",", 
      RowBox[{"pattern", " ", "\[Rule]", 
       RowBox[{"new", " ", "pattern"}]}]}], "]"}],
    FontWeight->"Bold",
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 "\nThe following table contains some illustrations on how the this might be \
used:"
}], "Text"],

Cell[TextData[{
 "\t ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      StyleBox[
       RowBox[{"Trace", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"patt", " ", "\[Rule]", 
          RowBox[{"new", " ", "patt"}]}]}], "]"}],
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox["=",
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[
       RowBox[{"Show", " ", "only", " ", "new", " ", "pattern"}],
       FontWeight->"Bold",
       FontColor->RGBColor[0, 0, 1]]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{
         RowBox[{"f_", "[", "x_", "]"}], "\[Rule]", 
         RowBox[{"Print", "[", 
          RowBox[{"f", ",", "x"}], "]"}]}]}], "]"}], "=", 
      RowBox[{"Print", " ", "f", " ", "and", "  ", "x", " ", "in", " ", 
       RowBox[{"f", "[", "x", "]"}]}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"x_", "=", 
         RowBox[{"y_", "\[Rule]", 
          RowBox[{"Print", "[", 
           RowBox[{"x", ",", "y"}], "]"}]}]}]}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Print", " ", "lhs"}], "&"}], " ", "rhs", " ", "in", " ", 
       "assignments"}]},
     {
      RowBox[{"Trace", "[", 
       RowBox[{"expr", ",", 
        RowBox[{
         RowBox[{"patt", "/;", "test"}], "\[Rule]", 
         RowBox[{"new", " ", "patt"}]}]}], "]"}], "=", 
      RowBox[{
      "Generate", " ", "new", " ", "patt", " ", "for", " ", "valid", " ", 
       "test"}]},
     {
      RowBox[{"etc", "."}], "=", 
      RowBox[{"etc", "."}]}
    },
    GridBoxDividers->{
     "Columns" -> {True, {False}, True}, "ColumnsIndexed" -> {}, 
      "Rows" -> {{True}}, "RowsIndexed" -> {}}], TraditionalForm]]]
}], "Text"],

Cell[TextData[{
 "\nAs an example, consider constructing a table that assigns  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "2"], TraditionalForm]]],
 "  to  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "[", "n", "]"}], TraditionalForm]]],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "=", "1"}], ",", "...", ",", "100"}], TraditionalForm]]],
 ".\n(The full trace of this expression would be huge.)"
}], "Text"],

Cell[TextData[{
 "Trace every term in the construction of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"z", "[", "n", "]"}], "=", 
    SuperscriptBox["n", "2"]}], TraditionalForm]]],
 " for:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"77", "\[LessEqual]", "n", "\[LessEqual]", "80"}], 
   TraditionalForm]]],
 ". (i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z", "[", "n1_", "]"}], "=", "s1_"}], ")"}], "/;", 
    RowBox[{"77", "\[LessEqual]", "n", "\[LessEqual]", "80"}]}], 
   TraditionalForm]]],
 ")\nPrint out an expression something like:    ",
 Cell[BoxData[
  RowBox[{
  "\"\<n = \>\"", "\[InvisibleSpace]", "77", "\[InvisibleSpace]", 
   "\"\<  \\!\\(n\\^2\\) = \>\"", "\[InvisibleSpace]", "5929"}]]],
 " (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"...", "\[Rule]", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<\\\"n = \\\"\>\"", ",", "n1", ",", "\"\<  \\!\\(n\\^2\\) = \>\"", 
      ",", "s1"}], "]"}]}], TraditionalForm]]],
 " )"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"z", "[", "n", "]"}], "=", 
       SuperscriptBox["n", "2"]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "100"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z", "[", "n1_", "]"}], "=", "s1_"}], ")"}], "/;", 
      RowBox[{"77", "\[LessEqual]", "n", "\[LessEqual]", "80"}]}], "\[Rule]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<n = \>\"", ",", "n1", ",", 
       "\"\<  \!\(\*SuperscriptBox[\(n\), \(2\)]\) = \>\"", ",", "s1"}], 
      "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.3898451155716553`*^9, 3.3898451161726556`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["Other Options for Trace[expr, pattern, options] ", "Subsection"],

Cell["\<\
There are other options that assist you in extracting the information that \
you want from a trace.  Two of the most useful options include TraceForward \
and TraceBackward.
TraceForward allows you to see all operations that follow from the pattern \
being used.
TraceBackward allows you to see all operations that led up to the pattern \
being used.\
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Warning for Trace[expr, pattern] ", "Subsection"],

Cell[TextData[{
 "You should understand that nothing magical is happening here.  Basically, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " generates a complete trace of your operation which is displayed as a \
nested list of sub-operations.  Then, regular pattern matching is implemented \
on this structure to implement  Trace[..., pattern].  Therefore, as a general \
recommendation, you should display a sufficient amount of the ",
 StyleBox["full",
  FontVariations->{"Underline"->True}],
 " trace so that you know the structure of the pattern that should be entered \
into Trace[..., pattern].  This might be accomplished by using the Short[...] \
command:\n\tShort[  Trace[expression]  ,  15]\nwhich would attempt to \
restrict the displayed output to a most 15 lines.\nAs a final warning, \
realize that if you use:\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Trace", "[", 
     RowBox[{"expression", ",", 
      RowBox[{"pattern", " ", "\[Rule]", 
       RowBox[{"new", " ", "pattern"}]}]}], "]"}],
    FontWeight->"Bold",
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 "\nthat the resulting ",
 StyleBox["new pattern",
  FontColor->RGBColor[0, 0, 1]],
 " will be subjected to continued evaluation as well.  If this is not \
desired, you might want to use ",
 StyleBox["Hold[ new pattern ].",
  FontColor->RGBColor[0, 0, 1]]
}], "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Controlling the \"Scope\" of Your Variables:", \
"Subtitle"]], "Section"],

Cell[TextData[{
 "It is often important to insure that different parts of your program do not \
interfere with each other.  Interference occurs primarily when variables from \
different parts of the program share common names.  One of the main ways of \
preventing interference (and still use common variable names) is to control \
the \"scope\" of your variables.  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides two basic mechanisms for limiting the scope of variables: modules \
and blocks. "
}], "Text"],

Cell[CellGroupData[{

Cell["Example: Variables Entering a Module[...] from the Outside:", \
"Subsection"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "x1", ",", "y1", ",", "myAbs"}], "]"}]], "InputOnly"],

Cell[TextData[{
 "Define a module which imitates the  Abs[...] command that does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " localize the variables:  x1  and  y1:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myAbs", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x1", "=", "x"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
       RowBox[{"y1", "=", "x1"}], ",", 
       RowBox[{"y1", "=", 
        RowBox[{"-", "x1"}]}]}], "]"}], ";", "\[IndentingNewLine]", "y1"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898460188436556`*^9, 3.3898460418036556`*^9}}],

Cell[TextData[{
 "Of course, you test your new function:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myAbs", "[", "t", "]"}], TraditionalForm]]],
 "  by plotting it:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"myAbs", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".01", "]"}], "}"}]}]}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389846048327656*^9, 3.389846061056656*^9}}],

Cell["\<\

The above graph is exactly what you want so you're confident that no mistake \
has been made.\
\>", "Text",
 CellChangeTimes->{3.523292110211536*^9}],

Cell["\<\
Assume that somewhere within the body of your program values are assigned to \
the variables  x1  and  y1:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x1", "=", ".5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y1", "=", ".5"}], ";"}]}], "InputOnly"],

Cell[TextData[{
 "Next, you continue to create your main program in which you solve an ODE to \
obtain the solution  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "=", 
    RowBox[{"2", "t"}]}], TraditionalForm]]],
 ".  Then, you want to plot the absolute value of your solution using your \
newly created  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myAbs", "[", "x", "]"}], TraditionalForm]]],
 "  function:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"myAbs", "[", 
      RowBox[{"x", "[", "t", "]"}], "]"}], "/.", "\[InvisibleSpace]", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
      RowBox[{"2", " ", "t"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".01", "]"}], "}"}]}]}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898462096776557`*^9, 3.3898462258676558`*^9}}],

Cell[TextData[{
 "\nThe above graph is clearly not the correct solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"2", "t"}], "|"}], TraditionalForm]]],
 " !  Why?\nThe precise reason for this behavior can be determined by \
carefully examining the evaluation procedure implemented by ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  The problem arises for several reasons, but specifically from the fact \
that the scope of the variable  y1  (set equal to .5 in the earlier code) was \
not localized to the module.\n\nUnderstanding your mistake, you localize the \
scope of the variables  x1  and  y1  within the module:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      StyleBox[
       RowBox[{"x1", ",", "y1"}],
       FontColor->RGBColor[1, 0, 0]], "}"}], ",", "  ", "..."}], "  ", "]"}], 
   TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.523292129801732*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", "myAbs", "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myAbs", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", "y1"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x1", "=", "x"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
       RowBox[{"y1", "=", "x1"}], ",", 
       RowBox[{"y1", "=", 
        RowBox[{"-", "x1"}]}]}], "]"}], ";", "\[IndentingNewLine]", "y1"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.389846261608656*^9, 3.3898462901096554`*^9}}],

Cell[TextData[{
 "Again, you want to plot the absolute value of your solution  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "=", 
    RowBox[{"2", "t"}]}], TraditionalForm]]],
 "  using your newly ",
 StyleBox["corrected",
  FontVariations->{"Underline"->True}],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myAbs", "[", "x", "]"}], TraditionalForm]]],
 "  function:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"myAbs", "[", 
      RowBox[{"x", "[", "t", "]"}], "]"}], "/.", "\[InvisibleSpace]", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
      RowBox[{"2", " ", "t"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".01", "]"}], "}"}]}]}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898463076646557`*^9, 3.3898463248226557`*^9}}],

Cell["\<\

This time you have uncovered another error corresponding to the fact that you \
did NOT generate a plot at all!\
\>", "Text",
 CellChangeTimes->{{3.3898468639996557`*^9, 3.389846912096656*^9}, 
   3.523292141221846*^9}],

Cell[TextData[{
 "However, it is clear that the value of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y1", "=", ".5"}], TraditionalForm]]],
 "  is no longer being used within the module (which is currently using a \
local variable).  Therefore, the variable scoping problem has been eliminated \
only to uncover another problem."
}], "Text",
 CellChangeTimes->{{3.389846832084656*^9, 3.3898468376736555`*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["  Motivation: Problems with ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox["'s Evaluation Procedure:", "Subtitle"]
}], "Section"],

Cell[TextData[{
 "Without exception the greatest problem facing an intermediate ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " programmer is an inadequate understanding of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s evaluation procedure.  I cannot emphasize enough the importance of \
increasing your understanding of this important topic.  Usually, as you gain \
more experience these problems are easily recognized and easily corrected.  \
However, until you gain this necessary understanding, you will often be \
frustrated by what appears to be inexplicable behavior from ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".\nAs a general remark, almost all of the ",
 StyleBox["common",
  FontVariations->{"Underline"->True}],
 " evaluation procedure problems originate from one or more of the following \
considerations:\n\t\[FilledSmallSquare] When is an expression substituted for \
a symbolic variable?\n\t\[FilledSmallSquare] What is the value of that \
expression at the time of its substitution?\n\t\[FilledSmallSquare] Is an \
evaluation being made in the order that you want?\nThe answers to the above \
questions may be difficult to determine when delayed assignment is used or \
your code contains functions which have the attributes HoldAll or HoldRest \
etc."
}], "Text"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["The purpose of the following rather lengthy example is to motivate \
you to make the effort to both assimilate and understand ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["Mathematica",
  FontSize->14,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["'s Evaluation Procedure.\nThe procedure used to analyze the \
following example is ad hoc in nature, rather than a formal understanding of ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["Mathematica",
  FontSize->14,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["'s Evaluation Procedure.\nI hope you will conclude that this is ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["not",
  FontSize->14,
  FontWeight->"Bold",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" the procedure that you want to use to solve your problems.\n",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["Mathematica",
  FontSize->14,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["'s Full Evaluation Procedure is described in the next section.",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]]
}], "Subsection",
 CellChangeTimes->{3.3900452301174*^9}],

Cell[CellGroupData[{

Cell["\<\
Example: Problems with the HoldRest Attribute of the If[...] Command:\
\>", "Subsubsection"],

Cell[TextData[{
 "Consider our above example of creating a user defined function which \
imitates the  Abs[...] function:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"myAbs", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
    "Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "                 ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1", ",", "y1"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"x1", "=", "x"}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"y1", "=", ".5"}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
         RowBox[{"y1", "=", "x1"}], ",", 
         RowBox[{"y1", "=", 
          RowBox[{"-", "x1"}]}]}], "]"}], ";", "\[IndentingNewLine]", "\t", 
       "y1"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
   TraditionalForm]]],
 "\nObserve that this module contains the  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", "...", "]"}], TraditionalForm]]],
 "  command.\nThe Attributes of the  If  command are:"
}], "Text",
 CellChangeTimes->{{3.3898470245936556`*^9, 3.3898470396786556`*^9}}],

Cell[BoxData[
 RowBox[{"Attributes", "[", "If", "]"}]], "Input"],

Cell[TextData[{
 "\nBecause of the attribute: HoldRest, ",
 StyleBox["until the inequality  ",
  FontVariations->{"Underline"->True}],
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "\[GreaterEqual]", "0"}], TraditionalForm]],
  FontVariations->{"Underline"->True}],
 StyleBox["  evaluates to either True or False",
  FontVariations->{"Underline"->True}],
 ", the last two arguments of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{"...", ",", 
     StyleBox["...",
      FontWeight->"Bold",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[",",
      FontWeight->"Bold",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox["...",
      FontWeight->"Bold",
      FontColor->RGBColor[1, 0, 0]]}], "]"}], TraditionalForm]]],
 " will not be evaluated (i.e. substitutions will not be made for these two \
arguments and more importantly for our problem an assignment to the variable  \
y1  will not be made):\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
     StyleBox[
      RowBox[{"y1", "=", "x1"}],
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[",",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[
      RowBox[{"y1", "=", 
       RowBox[{"-", "x1"}]}],
      FontColor->RGBColor[1, 0, 0]]}], "]"}], TraditionalForm]]],
 ".\nTo illustrate this behavior, define our absolute value function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myAbs", "[", "x", "]"}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.523292337803812*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", "myAbs", "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myAbs", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", "y1"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x1", "=", "x"}], ";", "\[IndentingNewLine]", 
     RowBox[{"y1", "=", ".5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
       RowBox[{"y1", "=", "x1"}], ",", 
       RowBox[{"y1", "=", 
        RowBox[{"-", "x1"}]}]}], "]"}], ";", "\[IndentingNewLine]", "y1"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898470932556553`*^9, 3.389847112379656*^9}}],

Cell["\<\
Plot this function to verify that it indeed behaves like the absolute value \
function:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"myAbs", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".01", "]"}], "}"}]}]}], "]"}]], "Input"],

Cell[TextData[{
 "\nNext, you continue to create your hypothetical main program in which you \
solve an ODE to obtain the solution  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "=", 
    RowBox[{"2", "t"}]}], TraditionalForm]]],
 ".  Then, you want to plot the absolute value of your solution using your \
newly created  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myAbs", "[", "x", "]"}], TraditionalForm]]],
 "  function:"
}], "Text",
 CellChangeTimes->{3.5232923645240793`*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"myAbs", "[", 
      RowBox[{"x", "[", "t", "]"}], "]"}], "/.", "\[InvisibleSpace]", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
      RowBox[{"2", " ", "t"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".01", "]"}], "}"}]}]}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898471684446554`*^9, 3.3898471844486556`*^9}}],

Cell[TextData[{
 "\nAs before, the above plot is clearly not correct, the correct answer \
should be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"2", "t"}], "|"}], TraditionalForm]]],
 " and not 0.5.\nExamination of our module indicates that the expected \
assignment of  x1  or  -x1  to the variable  y1  was ",
 StyleBox["never",
  FontVariations->{"Underline"->True}],
 " made:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    "                  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1", ",", "y1"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      StyleBox[
       RowBox[{"x1", "=", "x"}],
       FontColor->RGBColor[1, 0, 0]], ";", "\[IndentingNewLine]", "\t", 
      StyleBox[
       RowBox[{"y1", "=", ".5"}],
       FontColor->RGBColor[0, 0, 1]], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
        StyleBox[
         RowBox[{"y1", "=", "x1"}],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[",",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         RowBox[{"y1", "=", 
          RowBox[{"-", "x1"}]}],
         FontColor->RGBColor[1, 0, 0]]}], "]"}], ";", "\[IndentingNewLine]", 
      "\t", 
      StyleBox["y1",
       FontColor->RGBColor[0, 0, 1]]}]}], 
    StyleBox["\[IndentingNewLine]",
     FontColor->RGBColor[0, 0, 1]], 
    StyleBox["\[IndentingNewLine]",
     FontColor->RGBColor[0, 0, 1]], "]"}], TraditionalForm]]],
 "\nBut why?\nThe following two calculations more clearly illustrate the \
problem:"
}], "Text",
 CellChangeTimes->{{3.3898472051046553`*^9, 3.3898472198886557`*^9}, 
   3.523292387244306*^9}],

Cell[BoxData[
 RowBox[{"myAbs", "[", "2", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myAbs", "[", "x", "]"}], "/.", " ", 
  RowBox[{"x", "\[Rule]", "2"}]}]], "Input"],

Cell[TextData[{
 "\nThe problem with the second expression is the HoldRest attribute of the \
If[...] command and ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure.  Basically what happened was that the module \
containing the If[...] command was evaluated ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " the variable  x  was replaced by  2.  As a consequence, the inequality  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", "\[GreaterEqual]", "0"}], TraditionalForm]]],
 "  did not evaluate to either True for False, thereby holding the \
assignments for y1:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
     StyleBox[
      RowBox[{"y1", "=", "x1"}],
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[",",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[
      RowBox[{"y1", "=", 
       RowBox[{"-", "x1"}]}],
      FontColor->RGBColor[1, 0, 0]]}], "]"}], TraditionalForm]]],
 "\nThis can be verified by using the Trace[...] command on both of the above \
examples.  \n\nWe will start by tracing the evaluation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myAbs", "[", "2", "]"}], TraditionalForm]]],
 " "
}], "Text",
 CellChangeTimes->{3.3898467476996555`*^9, 3.523292407714511*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"myAbs", "[", "2", "]"}], "//", "Trace"}]], "Input"],

Cell[TextData[{
 "\nThe most important observation is the part containing ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"2", "\[GreaterEqual]", "0"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 " that looks something like:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"...", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            StyleBox[
             RowBox[{
              TagBox["x1$90",
               HoldForm], ",", 
              TagBox["2",
               HoldForm]}],
             FontColor->RGBColor[1, 0, 0]], 
            StyleBox["}",
             FontColor->RGBColor[1, 0, 0]]}], 
           StyleBox[",",
            FontColor->RGBColor[1, 0, 0]], 
           StyleBox[
            TagBox[
             RowBox[{"2", "\[GreaterEqual]", "0"}],
             HoldForm],
            FontColor->RGBColor[1, 0, 0]], 
           StyleBox[",",
            FontColor->RGBColor[1, 0, 0]], 
           StyleBox[
            TagBox["True",
             HoldForm],
            FontColor->RGBColor[1, 0, 0]]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         TagBox[
          RowBox[{"If", "[", 
           RowBox[{
            StyleBox["True",
             FontColor->RGBColor[1, 0, 0]], ",", 
            RowBox[{"y1$90", "=", "x1$90"}], ",", 
            RowBox[{"y1$90", "=", 
             RowBox[{"-", "x1$90"}]}]}], "]"}],
          HoldForm], ",", "\[IndentingNewLine]", 
         TagBox[
          RowBox[{"y1$90", "=", "x1$90"}],
          HoldForm], ",", "\[IndentingNewLine]", "\t", 
         RowBox[{"{", 
          RowBox[{
           TagBox["x1$90",
            HoldForm], ",", 
           TagBox["2",
            HoldForm]}], "}"}], ",", 
         TagBox[
          RowBox[{"y1$90", "=", "2"}],
          HoldForm], ",", 
         TagBox["2",
          HoldForm]}], "}"}], ",", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"{", 
        RowBox[{
         TagBox["y1$90",
          HoldForm], ",", 
         TagBox["2",
          HoldForm]}], "}"}], ",", 
       TagBox["2",
        HoldForm]}], "}"}], ",", 
     TagBox["2",
      HoldForm]}], "}"}], TraditionalForm]]],
 "\nwhich allowed the If[",
 StyleBox["True",
  FontColor->RGBColor[1, 0, 0]],
 ",...,...] command to be evaluated properly to yield the final correct value \
of 2.\n\nHowever, if we trace the expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"myAbs", "[", "x", "]"}], "/.", " ", 
    RowBox[{"x", "\[Rule]", "2"}]}], TraditionalForm]]],
 " we get a completely different behavior:"
}], "Text",
 CellChangeTimes->{{3.3898473093766556`*^9, 3.3898473383736553`*^9}, 
   3.5232924094545283`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"myAbs", "[", "x", "]"}], "/.", " ", 
   RowBox[{"x", "\[Rule]", "2"}]}], "//", "Trace"}]], "Input"],

Cell[TextData[{
 "\nThe important part of the above trace command is the part containing ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "\[GreaterEqual]", "0"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 ":\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"...", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            StyleBox[
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                TagBox["x1$89",
                 HoldForm], ",", 
                TagBox["x",
                 HoldForm]}], "}"}], ",", 
              TagBox[
               RowBox[{"x", "\[GreaterEqual]", "0"}],
               HoldForm]}],
             FontColor->RGBColor[1, 0, 0]], "}"}], ",", "\[IndentingNewLine]", 
           TagBox[
            RowBox[{"If", "[", 
             RowBox[{
              StyleBox[
               RowBox[{"x", "\[GreaterEqual]", "0"}],
               FontColor->RGBColor[1, 0, 0]], ",", 
              StyleBox[
               RowBox[{"y1$89", "=", "x1$89"}],
               FontColor->RGBColor[0, 0, 1]], 
              StyleBox[",",
               FontColor->RGBColor[0, 0, 1]], 
              StyleBox[
               RowBox[{"y1$89", "=", 
                RowBox[{"-", "x1$89"}]}],
               FontColor->RGBColor[0, 0, 1]]}], "]"}],
            HoldForm]}], "}"}], ",", "\[IndentingNewLine]", "\t", 
         RowBox[{"{", 
          StyleBox[
           RowBox[{
            TagBox["y1$89",
             HoldForm], ",", 
            TagBox["0.5`",
             HoldForm]}],
           FontColor->RGBColor[1, 0, 1]], "}"}], ",", 
         TagBox["0.5`",
          HoldForm]}], "}"}], ",", 
       TagBox["0.5`",
        HoldForm]}], "}"}], ",", "\[IndentingNewLine]", "\t\t", 
     TagBox[
      RowBox[{"0.5`", "/.", "\[InvisibleSpace]", 
       RowBox[{"x", "\[Rule]", "2"}]}],
      HoldForm], ",", "\[IndentingNewLine]", "\t\t\t", 
     TagBox["0.5`",
      HoldForm]}], "}"}], TraditionalForm]]],
 "\nindicating that the inequality ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "\[GreaterEqual]", "0"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 " could ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " be evaluated to either True or False. This prevents the evaluation of the \
second and third arguments of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     StyleBox[
      RowBox[{"x", "\[GreaterEqual]", "0"}],
      FontColor->RGBColor[1, 0, 0]], ",", 
     StyleBox[
      RowBox[{"y1", "=", "x1"}],
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[",",
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[
      RowBox[{"y1", "=", 
       RowBox[{"-", "x1"}]}],
      FontColor->RGBColor[0, 0, 1]]}], "]"}], TraditionalForm]]],
 " command (remember attribute HoldRest) and thereby prevents the assignment \
of  x  for   x1$89  and subsequently for ",
 StyleBox["y1$89",
  FontColor->RGBColor[1, 0, 1]],
 ".  This explains how the  ",
 StyleBox["y1",
  FontColor->RGBColor[1, 0, 1]],
 "  value ended up as ",
 StyleBox["0.5",
  FontColor->RGBColor[1, 0, 1]],
 " (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox[
     RowBox[{
      TagBox["y1$89",
       HoldForm], ",", 
      TagBox["0.5`",
       HoldForm]}],
     FontColor->RGBColor[1, 0, 1]], "}"}], TraditionalForm]]],
 " ).\nObserve that the replacement rule is used when it is too late for this \
expression:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"...", ",", 
     TagBox[
      RowBox[{"0.5`", "/.", "\[InvisibleSpace]", 
       RowBox[{"x", "\[Rule]", "2"}]}],
      HoldForm], ",", "\[IndentingNewLine]", "\t", 
     TagBox["0.5`",
      HoldForm]}], "}"}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.5232924119845533`*^9}],

Cell[TextData[{
 "One ",
 StyleBox["possible",
  FontVariations->{"Underline"->True}],
 " solution is to override the HoldRest attribute of the If[...] command by \
explicitly forcing the evaluation by using the Evaluate[...] command:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myAbs", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", "y1"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x1", "=", "x"}], ";", "\[IndentingNewLine]", 
     RowBox[{"y1", "=", ".5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"y1", "=", "x1"}], "]"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"y1", "=", 
         RowBox[{"-", "x1"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "y1"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898474186866555`*^9, 3.3898474467126555`*^9}}],

Cell["Test this out using the above example:", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myAbs", "[", "x", "]"}], "/.", 
  RowBox[{"x", "\[Rule]", "2"}]}]], "Input"],

Cell["\<\

This time the correct value of x was used, however the incorrect branch of \
the If[...] command was chosen to produce -2 rather than 2.  Why?
Use the Trace command to determine what happened:\
\>", "Text",
 CellChangeTimes->{{3.3898474718106556`*^9, 3.3898474853356557`*^9}, 
   3.5232924167446012`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"myAbs", "[", "x", "]"}], "/.", 
   RowBox[{"x", "\[Rule]", "2"}]}], "  ", "//", "Trace"}]], "Input"],

Cell[TextData[{
 "\nThe important part of the trace command is the forced evaluation within \
the If[...] command:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"...", ",", 
       RowBox[{"{", 
        RowBox[{
         TagBox[
          RowBox[{
           RowBox[{
            RowBox[{"x1$122", "=", "x"}], ";", 
            RowBox[{"y1$122", "=", "0.5`"}], ";"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"x1$122", "\[GreaterEqual]", "0"}], ",", 
              StyleBox[
               RowBox[{"Evaluate", "[", 
                RowBox[{"y1$122", "=", "x1$122"}], "]"}],
               FontColor->RGBColor[1, 0, 0]], 
              StyleBox[",",
               FontColor->RGBColor[1, 0, 0]], 
              StyleBox[
               RowBox[{"Evaluate", "[", 
                RowBox[{"y1$122", "=", 
                 RowBox[{"-", "x1$122"}]}], "]"}],
               FontColor->RGBColor[0, 0, 1]]}], "]"}], ";"}], 
           "\[IndentingNewLine]", "\t", "y1$122"}],
          HoldForm], ",", 
         RowBox[{"{", 
          RowBox[{
           TagBox[
            RowBox[{"x1$122", "=", "x"}],
            HoldForm], ",", 
           TagBox["x",
            HoldForm]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           TagBox[
            RowBox[{"y1$122", "=", "0.5`"}],
            HoldForm], ",", 
           TagBox["0.5`",
            HoldForm]}], "}"}], ",", "\[IndentingNewLine]", "\t", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               TagBox["x1$122",
                HoldForm], ",", 
               TagBox["x",
                HoldForm]}], "}"}], ",", 
             TagBox[
              RowBox[{"x", "\[GreaterEqual]", "0"}],
              HoldForm]}], "}"}], ",", "\[IndentingNewLine]", "\t", 
           StyleBox[
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                TagBox["x1$122",
                 HoldForm], ",", 
                TagBox["x",
                 HoldForm]}], "}"}], ",", 
              TagBox[
               RowBox[{"y1$122", "=", "x"}],
               HoldForm], ",", 
              TagBox["x",
               HoldForm]}], "}"}],
            FontColor->RGBColor[1, 0, 0]], ",", "\[IndentingNewLine]", "\t", 
           RowBox[{"{", 
            StyleBox[
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  TagBox["x1$122",
                   HoldForm], ",", 
                  TagBox["x",
                   HoldForm]}], "}"}], ",", 
                TagBox[
                 RowBox[{"-", "x"}],
                 HoldForm]}], "}"}], ",", 
              TagBox[
               RowBox[{"y1$122", "=", 
                RowBox[{"-", "x"}]}],
               HoldForm], ",", 
              TagBox[
               RowBox[{"-", "x"}],
               HoldForm]}],
             FontColor->RGBColor[0, 0, 1]], "}"}], ",", "\[IndentingNewLine]",
            "\t\t", 
           TagBox[
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"x", "\[GreaterEqual]", "0"}], ",", "x", ",", 
              RowBox[{"-", "x"}]}], "]"}],
            HoldForm]}], "}"}], ",", "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{"{", 
          StyleBox[
           RowBox[{
            TagBox["y1$122",
             HoldForm], ",", 
            TagBox[
             RowBox[{"-", "x"}],
             HoldForm]}],
           FontColor->RGBColor[0, 0, 1]], "}"}], ",", 
         TagBox[
          RowBox[{"-", "x"}],
          HoldForm]}], "}"}], ",", 
       TagBox[
        RowBox[{"-", "x"}],
        HoldForm]}], "}"}], ",", "\[IndentingNewLine]", "\t\t\t\t\t", 
     TagBox[
      RowBox[{
       StyleBox[
        RowBox[{"-", "x"}],
        FontColor->RGBColor[0, 0, 1]], "/.", "\[InvisibleSpace]", 
       RowBox[{"x", "\[Rule]", "2"}]}],
      HoldForm], ",", 
     TagBox[
      RowBox[{"-", "2"}],
      HoldForm], ",", 
     TagBox[
      RowBox[{"-", "2"}],
      HoldForm]}], "}"}], TraditionalForm]]],
 "\nThe two Evaluate[...] commands forced two assignments to be made to the \
local variable  y1$122.\nIt just so happens that the ",
 StyleBox["last",
  FontVariations->{"Underline"->True}],
 " assignment to the local variable y1$122 was:\n\t\t",
 Cell[BoxData[
  FormBox[
   TagBox[
    StyleBox[
     RowBox[{"y1$122", "=", 
      RowBox[{"-", "x"}]}],
     FontColor->RGBColor[0, 0, 1]],
    HoldForm], TraditionalForm]]],
 "\nand not:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    TagBox[
     RowBox[{"y1$122", "=", "x"}],
     HoldForm],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 "\nTherefore, as in the example above, the If[...] command was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " evaluated (which is required to select the correct assignment to y1$122), \
however ",
 StyleBox["both",
  FontVariations->{"Underline"->True}],
 " arguments were forced to evaluate. The result is that ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " assignments were made to y1$122 with the ",
 StyleBox["second",
  FontVariations->{"Underline"->True}],
 " being the one that was eventually used by the replacement rule  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"...", "/.", "\[InvisibleSpace]", 
    RowBox[{"x", "\[Rule]", "2"}]}], TraditionalForm]]],
 ".  Again, the ",
 StyleBox["replacement rule was applied to late",
  FontVariations->{"Underline"->True}],
 " to yield the correct answer:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TagBox[
     RowBox[{
      StyleBox[
       RowBox[{"-", "x"}],
       FontColor->RGBColor[0, 0, 1]], "/.", "\[InvisibleSpace]", 
      RowBox[{"x", "\[Rule]", "2"}]}],
     HoldForm], ",", 
    TagBox[
     RowBox[{"-", "2"}],
     HoldForm]}], TraditionalForm]]],
 "}\n\nThe correct solution to this problem is to guarantee that the If[...] \
command can be properly evaluated.  This of course will happen only when the \
logical expression  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[GreaterEqual]", "0"}], TraditionalForm]]],
 "  can be evaluated to either True or False.  The expression  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[GreaterEqual]", "0"}], TraditionalForm]]],
 "  evaluates ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " when  x  is a number (more specifically a real, integer or rational \
number).\nTherefore, one possible solution that will eliminate ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " of our problems is to guarantee that  x  is a number ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " the function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myAbs", "[", "x", "]"}], TraditionalForm]]],
 "  is evaluated.\nThis is easily accomplished by using the Boolean test \
NumberQ[...] as follows:"
}], "Text",
 CellChangeTimes->{3.5232924190546246`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "myAbs", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myAbs", "[", 
   RowBox[{"x_", "?", "NumberQ"}], "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", "y1"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x1", "=", "x"}], ";", "\[IndentingNewLine]", 
     RowBox[{"y1", "=", ".5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"x1", "\[GreaterEqual]", "0"}], ",", 
       RowBox[{"y1", "=", "x1"}], ",", 
       RowBox[{"y1", "=", 
        RowBox[{"-", "x1"}]}]}], "]"}], ";", "\[IndentingNewLine]", "y1"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]}], "InputOnly",
 CellChangeTimes->{{3.3898475842566557`*^9, 3.389847615985656*^9}}],

Cell["Test out this new definition:", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myAbs", "[", "x", "]"}], "/.", 
  RowBox[{"x", "\[Rule]", "2"}]}]], "Input"],

Cell["\<\

Observe that it behaves as expected.
To verify that it is truly behaving as we want, use the Trace command:\
\>", "Text",
 CellChangeTimes->{3.5232924253646874`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"myAbs", "[", "x", "]"}], "/.", 
   RowBox[{"x", "\[Rule]", "2"}]}], "  ", "//", "Trace"}]], "Input"],

Cell[TextData[{
 "\nExamine the first part of the above trace:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TagBox[
        StyleBox[
         RowBox[{"myAbs", "[", "x", "]"}],
         FontColor->RGBColor[1, 0, 1]],
        HoldForm], ",", 
       RowBox[{"{", 
        StyleBox[
         RowBox[{
          TagBox[
           RowBox[{"NumberQ", "[", "x", "]"}],
           HoldForm], ",", 
          TagBox["False",
           HoldForm]}],
         FontColor->RGBColor[1, 0, 0]], "}"}], ",", "\[IndentingNewLine]", 
       StyleBox[
        TagBox[
         StyleBox[
          RowBox[{"myAbs", "[", "x", "]"}],
          FontColor->RGBColor[1, 0, 0]],
         HoldForm],
        FontColor->RGBColor[0, 0, 1]]}], 
      StyleBox["}",
       FontColor->RGBColor[0, 0, 1]]}], 
     StyleBox[",",
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[
      TagBox[
       RowBox[{
        RowBox[{"myAbs", "[", "x", "]"}], "/.", "\[InvisibleSpace]", 
        RowBox[{"x", "\[Rule]", "2"}]}],
       HoldForm],
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[",",
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox["\[IndentingNewLine]",
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox["\t",
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[
      TagBox[
       RowBox[{"myAbs", "[", "2", "]"}],
       HoldForm],
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[",",
      FontColor->RGBColor[0, 0, 1]], 
     RowBox[{
      StyleBox["{",
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[
       RowBox[{
        TagBox[
         RowBox[{"NumberQ", "[", "2", "]"}],
         HoldForm], ",", 
        TagBox["True",
         HoldForm]}],
       FontColor->RGBColor[0, 0, 1]], "}"}], ",", "\[IndentingNewLine]", 
     "\t\t\t\t\t\t", "...", ",", 
     TagBox["2",
      HoldForm]}], "}"}], TraditionalForm]]],
 "\nObserve that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s evaluation procedure ",
 StyleBox["attempted",
  FontVariations->{"Underline"->True}],
 " to evaluate  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myAbs", "[", "x", "]"}],
    FontColor->RGBColor[1, 0, 1]], TraditionalForm]]],
 "  first before applying the replacement rule.  However, the argument  x  \
failed to evaluate as a number  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox[
     RowBox[{
      TagBox[
       RowBox[{"NumberQ", "[", "x", "]"}],
       HoldForm], ",", 
      TagBox["False",
       HoldForm]}],
     FontColor->RGBColor[1, 0, 0]], "}"}], TraditionalForm]]],
 ", therefore preventing the evaluation of ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"myAbs", "[", "x", "]"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 ".  The next evaluation step was to apply the replacement rule  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    TagBox[
     RowBox[{
      RowBox[{
       RowBox[{"myAbs", "[", "x", "]"}], "/.", "\[InvisibleSpace]", 
       RowBox[{"x", "\[Rule]", "2"}]}], ",", "  ", 
      RowBox[{"myAbs", "[", "2", "]"}]}],
     HoldForm],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 ".  \nFrom this point on the evaluation of the If[...] command continues as \
desired:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"...", ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       TagBox[
        RowBox[{
         RowBox[{
          RowBox[{"x1$156", "=", "2"}], ";", 
          RowBox[{"y1$156", "=", "0.5`"}], ";"}], "\[IndentingNewLine]", "\t", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"x1$156", "\[GreaterEqual]", "0"}], ",", 
            RowBox[{"y1$156", "=", "x1$156"}], ",", 
            RowBox[{"y1$156", "=", 
             RowBox[{"-", "x1$156"}]}]}], "]"}], ";"}], "\[IndentingNewLine]",
          "\t", "y1$156"}],
        HoldForm], ",", 
       RowBox[{"{", 
        RowBox[{
         TagBox[
          RowBox[{"x1$156", "=", "2"}],
          HoldForm], ",", 
         TagBox["2",
          HoldForm]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         TagBox[
          RowBox[{"y1$156", "=", "0.5`"}],
          HoldForm], ",", 
         TagBox["0.5`",
          HoldForm]}], "}"}], ",", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             TagBox["x1$156",
              HoldForm], ",", 
             TagBox["2",
              HoldForm]}], "}"}], ",", 
           StyleBox[
            TagBox[
             RowBox[{"2", "\[GreaterEqual]", "0"}],
             HoldForm],
            FontColor->RGBColor[1, 0, 0]], 
           StyleBox[",",
            FontColor->RGBColor[1, 0, 0]], 
           StyleBox[
            TagBox["True",
             HoldForm],
            FontColor->RGBColor[1, 0, 0]]}], "}"}], ",", 
         TagBox[
          RowBox[{"\[IndentingNewLine]", "\t\t\t", 
           RowBox[{"If", "[", 
            RowBox[{
             StyleBox["True",
              FontColor->RGBColor[1, 0, 0]], ",", 
             StyleBox[
              RowBox[{"y1$156", "=", "x1$156"}],
              FontColor->RGBColor[0, 0, 1]], ",", 
             RowBox[{"y1$156", "=", 
              RowBox[{"-", "x1$156"}]}]}], "]"}]}],
          HoldForm], ",", "\[IndentingNewLine]", "\t\t\t\t   ", 
         StyleBox[
          TagBox[
           RowBox[{"y1$156", "=", "x1$156"}],
           HoldForm],
          FontColor->RGBColor[0, 0, 1]], 
         StyleBox[",",
          FontColor->RGBColor[0, 0, 1]], 
         StyleBox[
          RowBox[{"{", 
           RowBox[{
            TagBox["x1$156",
             HoldForm], ",", 
            TagBox["2",
             HoldForm]}], "}"}],
          FontColor->RGBColor[0, 0, 1]], 
         StyleBox[",",
          FontColor->RGBColor[0, 0, 1]], 
         StyleBox[
          TagBox[
           RowBox[{"y1$156", "=", "2"}],
           HoldForm],
          FontColor->RGBColor[0, 0, 1]], 
         StyleBox[",",
          FontColor->RGBColor[0, 0, 1]], 
         StyleBox[
          TagBox["2",
           HoldForm],
          FontColor->RGBColor[0, 0, 1]]}], "}"}], ",", "\[IndentingNewLine]", 
       "\t\t\t\t\t", 
       RowBox[{"{", 
        RowBox[{
         TagBox["y1$156",
          HoldForm], ",", 
         TagBox["2",
          HoldForm]}], "}"}], ",", 
       TagBox["2",
        HoldForm]}], "}"}], ",", 
     StyleBox[
      TagBox["2",
       HoldForm],
      FontColor->RGBColor[0, 0, 1]]}], "}"}], TraditionalForm]]],
 "\nObserve that the inequality ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"2", "\[GreaterEqual]", "0"}],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 " evaluates to True, thereby forcing ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " the second argument of the If[...] command to be evaluated  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"If", "[", 
    RowBox[{
     StyleBox["True",
      FontColor->RGBColor[1, 0, 0]], ",", 
     StyleBox[
      RowBox[{"y1$156", "=", "x1$156"}],
      FontColor->RGBColor[0, 0, 1]], ",", 
     RowBox[{"y1$156", "=", 
      RowBox[{"-", "x1$156"}]}]}], "]"}], TraditionalForm]]],
 ".  Evaluation of this branch of the If[...] command eventually yields the \
correct answer  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     TagBox[
      RowBox[{"y1$156", "=", "x1$156"}],
      HoldForm], ",", 
     RowBox[{"{", 
      RowBox[{
       TagBox["x1$156",
        HoldForm], ",", 
       TagBox["2",
        HoldForm]}], "}"}], ",", 
     TagBox[
      RowBox[{"y1$156", "=", "2"}],
      HoldForm], ",", 
     TagBox["2",
      HoldForm]}],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{3.523292429134725*^9}],

Cell[TextData[{
 "\nFinally, substitute the hypothetical solution of our ODE ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{"2", "t"}]}], TraditionalForm]]],
 " into the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"myAbs", "[", "...", "]"}], TraditionalForm]]],
 " function:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"myAbs", "[", 
     RowBox[{"x", "[", "t", "]"}], "]"}], "/.", "\[InvisibleSpace]", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
     RowBox[{"2", " ", "t"}]}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Thickness", "[", ".01", "]"}], "}"}]}]}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898477243046556`*^9, 3.3898477375646553`*^9}}],

Cell[TextData[{
 "\nObserve that it now performs exactly as you want (even without the \
Evaluate[...] command).\n\n",
 StyleBox["Summary",
  FontVariations->{"Underline"->True}],
 ": When ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " yields unexpected results, examine the evaluation procedure (possibly \
using the Trace[...] and Hold[...] commands).  Look very carefully at exactly \
what is happening and determine what must occur so that the proper procedure \
will be implemented.  Then modify your code to insure that what you want is \
implemented in a consistent fashion with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure.\n",
 StyleBox["This can only be accomplished if you possess a fundamental \
understanding of ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["Mathematica",
  FontSize->14,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["'s Evaluation Procedure. ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]]
}], "Text",
 CellChangeTimes->{3.523292435014784*^9}]
}, Closed]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["  ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox["'s Full Evaluation Procedure:", "Subtitle"]
}], "Section"],

Cell[TextData[{
 "An excellent reference for programming in general and ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s evaluation procedure specifically is:\n\tPower Programming with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " (The Kernel)\n\tMcGraw-Hill 1996\n\tby David B. Wagner\n\t\nContained \
within this book are the following steps utilized by the main evaluation loop \
in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s kernel.  I have included some simple illustrations for each step.\n\n\
Before we start, you must realize that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " contains only ",
 StyleBox["atomic",
  FontVariations->{"Underline"->True}],
 " expressions:\n\t\tInteger:  3\n\t\tRational:  2/3\n\t\tReal:  3.0\n\t\t\
Complex:  2+3\[ImaginaryI]\n\t\tString:  \"abc\"\n\t\tBoolean: True\n\t\t\
Symbol:  a,  x,  f  and  thisSymbol\nand ",
 StyleBox["non-atomic",
  FontVariations->{"Underline"->True}],
 " expressions.  \nAlso you must realize that ",
 StyleBox["absolutely every non-atomic expression",
  FontVariations->{"Underline"->True}],
 " within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has a functional representation:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\n\t\t\nIt is possible to explicitly display the functional representation \
for any non-atomic expression by using the FullForm[...] command (sometimes \
the Hold[...] command should be used if you want to prevent the expression \
from automatically evaluating)."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "  ", "//", "Hold"}], "//", 
  "FullForm"}]], "Input"],

Cell[TextData[{
 "\nIt is also important to understand the full form of a replacement rule:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"expr", " ", "/.", " ", 
    RowBox[{"a", "\[Rule]", "b"}]}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.5232989027994614`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "/.", 
    RowBox[{"x", "\[Rule]", "3"}]}], "  ", "//", "Hold"}], "//", 
  "FullForm"}]], "Input"],

Cell[TextData[{
 "\nObserve that \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", "x", "]"}], TraditionalForm]]],
 "\" and \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Rule]", "3"}], TraditionalForm]]],
 "\" are the first and second arguments of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ReplaceAll", "[", 
    RowBox[{"...", ",", "..."}], "]"}], TraditionalForm]]],
 " command.\n"
}], "Text",
 CellChangeTimes->{3.5232989115195484`*^9}],

Cell[CellGroupData[{

Cell[TextData[{
 "Extremely Short Outline of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure:"
}], "Subsection"],

Cell[TextData[{
 "The absolute minimal understanding of the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " evaluation procedure follows: \n\nFor the expression:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\n",
 StyleBox["First",
  FontVariations->{"Underline"->True}],
 "\nSteps 1-13:\tEvaluate ",
 StyleBox["completely",
  FontVariations->{"Underline"->True}],
 " each of the parts \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", ",
 StyleBox["in the order",
  FontVariations->{"Underline"->True}],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"...", "n"}]}], TraditionalForm]]],
 ", \n\t\tthat are ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " held from evaluation.\n",
 StyleBox["Second",
  FontVariations->{"Underline"->True}],
 "\nSteps 14-17:\tApply any user definitions for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "[", "...", "]"}], TraditionalForm]]],
 ", then\n\t\tapply any internal definitions for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "[", "...", "]"}], TraditionalForm]]],
 ".\n\t\t\nIf you just understand the above sequential procedure and the \
FullForm of your expression, then it will assist you in solving 90% of your \
problems.\t\t"
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Short Outline of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure:"
}], "Subsection"],

Cell[TextData[{
 "Recursively evaluate an expression in the following order:\nSteps 1-3:\t\
Evaluate Atomic expressions.\nSteps 4-5:\tEvaluate the Head of the expression \
\"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\".\nSteps 6-7:\tEvaluate ",
 StyleBox["completely",
  FontVariations->{"Underline"->True}],
 " each of the parts \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", ",
 StyleBox["in the order",
  FontVariations->{"Underline"->True}],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"...", "n"}]}], TraditionalForm]]],
 ", \n\t\tthat are ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " held from evaluation.\nSteps 8-11:\tImplement the attributes \"Flat\", \
\"SequenceHold\", \"Listable\" and \"Orderless\" \n\t\tfor the function and \
its parts.\nSteps 12-13:\tApply UpValues for parts \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"...", "n"}]}], TraditionalForm]]],
 ".\nSteps 14-15:\tApply DownValues for \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", "...", "]"}], TraditionalForm]]],
 "\".\nSteps 16-17:\tClean up and continue the evaluation process for other \
unevaluated expressions.\n"
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Outline of ",
  FontVariations->{"Underline"->True}],
 StyleBox["Mathematica'",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox["s Evaluation Procedure:",
  FontVariations->{"Underline"->True}],
 StyleBox["\n", "Subsubsection",
  FontVariations->{"Underline"->True}]
}], "Subsection"],

Cell[TextData[{
 StyleBox["Recursively Evaluate an Expression in the Following Order:\nStep \
1", "Subsubsection"],
 ": ",
 StyleBox["Evaluate", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" Atomic Numeric Expressions", "Subsubsection"],
 "\n",
 StyleBox["Step 2:", "Subsubsection"],
 " ",
 StyleBox["Return a Symbol as Unevaluated when it has has no OwnValues", 
  "Subsubsection",
  FontSlant->"Italic"],
 "\n",
 StyleBox["Step 3:", "Subsubsection"],
 " ",
 StyleBox["Return a Symbol with its OwnValues assigned", "Subsubsection",
  FontSlant->"Italic"],
 "\n",
 StyleBox["Step 4:", "Subsubsection"],
 " ",
 StyleBox["Normal Expression:", "Subsubsection"],
 "\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"head", "[", 
     RowBox[{
      SubscriptBox["part", "1"], ",", 
      SubscriptBox["part", "2"], ",", 
      SubscriptBox["part", "3"], ",", "...", ",", 
      SubscriptBox["part", "n"]}], "]"}], "Subsubsection"], TraditionalForm]]],
 "\nIf ",
 StyleBox["any part",
  FontVariations->{"Underline"->True}],
 " of an expression changes during the evaluation process, then the \
evaluation process for this expression will begin anew.\n",
 StyleBox["Step 5:", "Subsubsection"],
 " ",
 StyleBox["Evaluate the Head", "Subsubsection"],
 "\n",
 StyleBox["Step 6:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute HoldAllComplete (skip to step 14)", 
  "Subsubsection"],
 "\n",
 StyleBox["Step 7:", "Subsubsection"],
 " ",
 StyleBox["Evaluate All Arguments that are Not Held:", "Subsubsection"],
 "\n\t",
 StyleBox["(7a)", "Subsubsection"],
 " If \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"...", "n"}]}], TraditionalForm]]],
 ", is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Evaluate", "[", 
    SubscriptBox["part", "i"], "]"}], TraditionalForm]]],
 ", remove the Evaluate head and call the evaluation routine recursively on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 ".\n\t",
 StyleBox["(7b)", "Subsubsection"],
 " If \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], TraditionalForm]]],
 ", is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Unevaluated", "[", 
    SubscriptBox["expr", "i"], "]"}], TraditionalForm]]],
 ", replace ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 " by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["expr", "i"], TraditionalForm]]],
 " and make a note that this was done (see step 16). \n\t",
 StyleBox["(7c)", "Subsubsection"],
 " If \"head\" is a symbol having the HoldAll attribute, continue to step 8 \
without evaluating any of the arguments.\n\t",
 StyleBox["(7d)", "Subsubsection"],
 " If i==1 is True and \"head\" is a symbol having the HoldFirst attribute, \
continue with step 7 for the next part: \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "2"], TraditionalForm]]],
 "\".\n\t",
 StyleBox["(7e)", "Subsubsection"],
 " If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ">", "1"}], TraditionalForm]]],
 " is True and \"head\" is a symbol having the HoldRest attribute, continue \
to step 8 without evaluating the remaining arguments.\n\t",
 StyleBox["(7f)", "Subsubsection"],
 " Call the evaluation routine recursively on \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", until it is ",
 StyleBox["completely",
  FontVariations->{"Underline"->True}],
 " evaluated.\n",
 StyleBox["Step 8:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Flat", "Subsubsection"],
 "\n",
 StyleBox["Step 9:", "Subsubsection"],
 " ",
 StyleBox["Automatically Splice Sequences", "Subsubsection"],
 "\n",
 StyleBox["Step 10:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Listable", "Subsubsection"],
 "\n",
 StyleBox["Step 11:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Orderless", "Subsubsection"],
 "\n",
 StyleBox["Step 12: Apply User-Defined UpValues Associated with ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["part", "i"], "Subsubsection"], TraditionalForm]]],
 "\n",
 StyleBox["Step 13: Apply Internally-Defined UpValues Associated with ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["part", "i"], "Subsubsection"], TraditionalForm]]],
 "\n",
 StyleBox["Step 14: Apply User-Defined DownValues Associated with \"head\"", 
  "Subsubsection"],
 "\n",
 StyleBox["Step 15: Apply Internally-Defined DownValues Associated with \
\"head\"\n\t  (This is where most internal functions take over and are \
evaluated)", "Subsubsection"],
 "\n",
 StyleBox["Step 16: Restore Unevaluated[...]", "Subsubsection"],
 "\n",
 StyleBox["Step 17: Discard Return[...]", "Subsubsection"]
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Detailed Outline of ",
  FontVariations->{"Underline"->True}],
 StyleBox["Mathematica'",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox["s Evaluation Procedure:",
  FontVariations->{"Underline"->True}]
}], "Subsection"],

Cell[TextData[{
 StyleBox["Evaluate", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" Atomic Expressions:", "Subsubsection"],
 "\n",
 StyleBox["Step 1", "Subsubsection"],
 ": \nIf the expression is a string or a number, return it (i.e. the \
evaluation process is finished for this expression).  (Strings like \"abc\" \
and numbers like 3, 2/3, 3.0 and 2+3\[ImaginaryI] are atomic expressions in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " and evaluate to themselves.)  "
}], "Text"],

Cell[BoxData["3"], "Input"],

Cell[TextData[{
 "\nIn addition, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will not allow assignments to any ",
 StyleBox["atomic",
  FontVariations->{"Underline"->True}],
 " expression other than a symbol."
}], "Text",
 CellChangeTimes->{3.523299018790621*^9}],

Cell[BoxData[
 RowBox[{"3", "=", 
  "\"\<Can NOT Assign this String to the Atomic Expression 3\>\""}]], "Input"],

Cell[TextData[{
 StyleBox["\nStep 2:", "Subsubsection"],
 " \nIf the expression is a symbol (which is an atomic expression) that has \
no ownvalue (i.e. no assigned value like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", "3"}], TraditionalForm]]],
 "), return it (i.e. the evaluation process is finished for this expression). \
\nThe following example assigns an OwnValue to the symbol  a  but not to the \
symbol  b:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "b"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", "3"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"OwnValues", "[", "a", "]"}], ",", 
    RowBox[{"OwnValues", "[", "b", "]"}]}], "}"}], "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3898483834516554`*^9, 3.3898484132496557`*^9}}],

Cell[TextData[{
 StyleBox["\nStep 3:", "Subsubsection"],
 " \nIf the expression is a symbol (which is an atomic expression) that has \
an ownvalue, replace it with the ownvalue and start over with the new \
expression.  (In general, if the expression being evaluated changes at any \
step, then the process begins again with the new expression.)\nThe following \
example assigns an OwnValue to the symbol  a:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "a", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", "3"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"OwnValues", "[", "a", "]"}]}], "Input",
 CellChangeTimes->{{3.3898484329896555`*^9, 3.3898484376136556`*^9}}],

Cell[TextData[{
 StyleBox["\nStep 4:", "Subsubsection"],
 " ",
 StyleBox["Normal Expression:", "Subsubsection"],
 "\nAt this point the expression being evaluated must be a normal expression, \
i.e., an expression of the form:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\nwhere the \"head\" and individual parts \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\" may or may not be atomic expressions.\nLocate the head:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{
    "f", ",", "i1", ",", "i2", ",", "i3", ",", "x1", ",", "x2", ",", "t1"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"i1", ",", "i2", ",", "i3"}], "]"}], "[", 
   RowBox[{"x1", ",", 
    RowBox[{"x2", "[", "t1", "]"}]}], "]"}], "//", "Head"}]}], "Input"],

Cell["\<\

Locate the first and second parts:\
\>", "Text",
 CellChangeTimes->{3.5232990566709995`*^9}],

Cell[BoxData[
 SubscriptBox[
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"i1", ",", "i2", ",", "i3"}], "]"}], "[", 
   RowBox[{"x1", ",", 
    RowBox[{"x2", "[", "t1", "]"}]}], "]"}], 
  RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]]], "Input"],

Cell[BoxData[
 SubscriptBox[
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"i1", ",", "i2", ",", "i3"}], "]"}], "[", 
   RowBox[{"x1", ",", 
    RowBox[{"x2", "[", "t1", "]"}]}], "]"}], 
  RowBox[{"\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]]], "Input"],

Cell[TextData[{
 "\nIf no part of the expression has changed ",
 StyleBox["since its last evaluation",
  FontVariations->{"Underline"->True}],
 ", return the expression (i.e. the evaluation process is finished for this \
expression).  This is an optimization that prevents unnecessary re-evaluation \
of large expressions.\nFor example, trace the evaluation of the expression \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 "\" where both the head \"",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 "\" and argument  \"",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 "\" require evaluation:"
}], "Text",
 CellChangeTimes->{3.5232990601910353`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"f", ",", "g"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"f", "=", "g"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", "y"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Trace", "[", 
   RowBox[{"f", "[", "x", "]"}], "]"}], "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3898484919226556`*^9, 3.389848510634656*^9}}],

Cell[TextData[{
 "\nNo part of the partially evaluated expression  \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "y", "]"}], TraditionalForm]]],
 "\"  has changed ",
 StyleBox["since the last evaluation",
  FontVariations->{"Underline"->True}],
 ".  Therefore, re-evaluation of the expression ",
 "\"",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "[", "y", "]"}], TraditionalForm]]],
 "\"",
 " should produce an empty trace:"
}], "Text",
 CellChangeTimes->{3.3898486330076556`*^9, 3.5232990636810703`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", "y", "]"}], "       ", "//", "Trace"}]], "Input"],

Cell[TextData[{
 "\nHowever, if ",
 StyleBox["any part",
  FontVariations->{"Underline"->True}],
 " of an expression changes during the evaluation process, then the \
evaluation process for this expression will begin anew:"
}], "Text",
 CellChangeTimes->{3.5232990659210925`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"f", ",", "n", ",", "startingValue"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "1", "]"}], "=", "startingValue"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "n_", "]"}], ":=", 
  RowBox[{"f", "[", 
   RowBox[{"n", "-", "1"}], "]"}]}]}], "InputOnly",
 CellChangeTimes->{3.3898486523956556`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "3", "]"}], "//", "Trace"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.3898486641756554`*^9, 3.389848701457656*^9}}],

Cell[TextData[{
 "\nNote that the function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "...", "]"}], TraditionalForm]]],
 "  was re-evaluated repeatedly because the internal argument  ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 "  in  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "n", "]"}], TraditionalForm]]],
 "  was continually changing.  Therefore, ",
 StyleBox["Mathematica'",
  FontSlant->"Italic"],
 "s Evaluation Procedure is automatically recursive."
}], "Text",
 CellChangeTimes->{3.523299068561119*^9}],

Cell[TextData[{
 StyleBox["\nStep 5:", "Subsubsection"],
 " ",
 StyleBox["Evaluate the Head:", "Subsubsection"],
 "\nCall the evaluation routine on \"head\" in:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]]
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"f", ",", "newFunction", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "=", "newFunction"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], "//", "Trace"}], "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3898487344606557`*^9, 3.389848753511656*^9}}],

Cell[TextData[{
 "\nThe evaluation routine is called recursively on \"head\" in:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\nThis may be necessary because \"head\" itself could evaluate to something \
else.  For example, \"head\" might be a symbol that evaluates to a pure \
function; \"head\" could even be another normal expression (e.g., in the \
expression: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Derivative", "[", "2", "]"}], "[", "f", "]"}], "[", "x", "]"}], 
   TraditionalForm]]],
 ", the head is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Derivative", "[", "2", "]"}], "[", "f", "]"}], TraditionalForm]]],
 ", which may evaluate to a pure function for certain values of f)."
}], "Text",
 CellChangeTimes->{3.5232990775512085`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"f", ",", "g", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "1", "]"}], "[", "x", "]"}], "  ", "//", 
  "Head"}]}], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "1", "]"}], "=", 
    RowBox[{"f", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "2", "]"}], "=", 
    RowBox[{"f", "[", "3", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "3", "]"}], "=", "g"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "1", "]"}], "[", "x", "]"}], "//", "Trace"}], "//", 
  "Column"}]}], "Input",
 CellChangeTimes->{{3.3898487904816556`*^9, 3.3898488059166555`*^9}}],

Cell["\<\

At this point the head \"head\" has been determined.  (Note that the final \
value of \"head\" may be either a symbol or a normal expression.) 

Now various actions that depend upon the attributes of \"head\" are taken:\
\>", "Text",
 CellChangeTimes->{3.523299081831251*^9}],

Cell[TextData[{
 StyleBox["\nStep 6:", "Subsubsection"],
 " ",
 StyleBox["Attribute HoldAllComplete:", "Subsubsection"],
 "\nIf \"head\" in the normal expression:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 ",\nhas attribute HoldAllComplete, then skip to step 14. \nI.e. do not apply \
the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " evaluation procedure to any of the arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["part", "1"], ",", 
    SubscriptBox["part", "2"], ",", 
    SubscriptBox["part", "3"], ",", "...", ",", 
    SubscriptBox["part", "n"]}], TraditionalForm]]],
 ".  \nHowever, attempt to evaluate the function ",
 StyleBox["with these held arguments",
  FontVariations->{"Underline"->True}],
 "."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"f", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", "HoldAllComplete"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x__", "]"}], "=", 
    RowBox[{"Hold", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"1", "+", "1"}], ",", 
     RowBox[{"x", "+", "x"}]}], "]"}], "//", "Trace"}], "//", 
  "Column"}]}], "Input",
 CellChangeTimes->{{3.3898488387186556`*^9, 3.389848857353656*^9}}],

Cell[TextData[{
 "In the above example the arguments \"",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "+", "1"}], ",", 
    RowBox[{"x", "+", "x"}]}], TraditionalForm]]],
 "\" are ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " allowed to evaluate to \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", ",", 
    RowBox[{"2", "x"}]}], TraditionalForm]]],
 "\".  However, the function evaluates (i.e. step 14) using the DownValue: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x__", "]"}], "=", 
    RowBox[{"Hold", "[", "x", "]"}]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 StyleBox["\nStep 7:", "Subsubsection"],
 " ",
 StyleBox["Evaluate All Arguments that are Not Held:", "Subsubsection"],
 "\nFor each \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", in the order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], TraditionalForm]]],
 ", for the normal expression:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\n",
 StyleBox["recursively",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " evaluate each of the following steps:\n\n\t",
 StyleBox["(7a)", "Subsubsection"],
 " If \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"...", "n"}]}], TraditionalForm]]],
 ", is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Evaluate", "[", 
    SubscriptBox["part", "i"], "]"}], TraditionalForm]]],
 ", remove the Evaluate head and call the evaluation routine recursively on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 ".  Continue with step 7 for the remaining parts.\nAs an example, remember \
that the Plot command holds its arguments from evaluation:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Plot", "]"}]], "Input"],

Cell["\<\

Therefore, the integration must be explicitly forced before the plot can be \
generated:
(To keep it short, just display the first two steps in the Trace command):\
\>", "Text",
 CellChangeTimes->{3.523299110101534*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Take", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"\[Integral]", 
         RowBox[{
          RowBox[{"Sin", "[", "x", "]"}], 
          RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", 
         RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}], ",", 
    "\[IndentingNewLine]", "2"}], "\[IndentingNewLine]", "]"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.3898489151726556`*^9, 3.3898490295656557`*^9}}],

Cell[TextData[{
 "\t\n\t",
 StyleBox["(7b)", "Subsubsection"],
 " If \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], TraditionalForm]]],
 ", is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Unevaluated", "[", 
    SubscriptBox["expr", "i"], "]"}], TraditionalForm]]],
 ", replace ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 " by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["expr", "i"], TraditionalForm]]],
 " and make a note that this was done (see step 16).  Continue with step 7 \
for the ",
 StyleBox["remaining",
  FontVariations->{"Underline"->True}],
 " parts.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"Unevaluated", "[", 
     SubscriptBox["expr", "i"], "]"}], "]"}], TraditionalForm]]],
 " effectively works by temporarily setting attributes so that ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 " holds this argument unevaluated while attempting to evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    SubscriptBox["expr", "i"], "]"}], TraditionalForm]]],
 ".\nAs an example, consider the following two expressions:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "a", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Length", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"a", "+", "a", "+", "a"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "//", "Trace"}], "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3898490494706554`*^9, 3.3898490938296556`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Length", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Unevaluated", "[", 
     RowBox[{"a", "+", "a", "+", "a"}], "]"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "//", "Trace"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.389849072261656*^9, 3.3898491052226553`*^9}}],

Cell[TextData[{
 "\t\n\t",
 StyleBox["(7c)", "Subsubsection"],
 " If \"head\" is a symbol having the HoldAll attribute, continue to step 8 \
without evaluating any of the arguments.\nFor example, the attribute HoldAll \
prevents the following arguments from being evaluated, but continues the \
evaluation process to step 10."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", "f", "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{"HoldAll", ",", "Listable"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "+", "1"}], ",", 
      RowBox[{"2", "+", "2"}], ",", 
      RowBox[{"3", "+", "3"}]}], "}"}], "]"}], "//", "Trace"}], "//", 
  "Column"}]}], "Input",
 CellChangeTimes->{{3.3898491213706555`*^9, 3.3898491342866554`*^9}}],

Cell[TextData[{
 "\t\n\t",
 StyleBox["(7d)", "Subsubsection"],
 " If i==1 is True and \"head\" is a symbol having the HoldFirst attribute, \
continue with step 7 for the next part: \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "2"], TraditionalForm]]],
 "\".\nFor example, the attribute HoldFirst prevents the first argument from \
being evaluated, but continues the evaluation process for the second and \
third arguments."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", "f", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", "HoldFirst"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"1", "+", "1"}], ",", 
     RowBox[{"2", "+", "2"}], ",", 
     RowBox[{"3", "+", "3"}]}], "]"}], "//", "Trace"}], "//", 
  "Column"}]}], "Input",
 CellChangeTimes->{{3.389849175195656*^9, 3.3898491932496557`*^9}}],

Cell[TextData[{
 "\t\n\t",
 StyleBox["(7e)", "Subsubsection"],
 " If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ">", "1"}], TraditionalForm]]],
 " is True and \"head\" is a symbol having the HoldRest attribute, continue \
to step 8 without evaluating the remaining arguments.\nFor example, the \
attribute HoldRest prevents the second and third arguments from being \
evaluated, but continues the evaluation process for the first argument."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", "f", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", "HoldRest"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"1", "+", "1"}], ",", 
     RowBox[{"2", "+", "2"}], ",", 
     RowBox[{"3", "+", "3"}]}], "]"}], "//", "Trace"}], "//", 
  "Column"}]}], "Input",
 CellChangeTimes->{{3.3898492068556557`*^9, 3.3898492226066556`*^9}}],

Cell[TextData[{
 "\t\n\t",
 StyleBox["(7f)", "Subsubsection"],
 " Call the evaluation routine recursively on \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", until it is ",
 StyleBox["completely",
  FontVariations->{"Underline"->True}],
 " evaluated.\nFor example, consider the following arguments that require \
recursive evaluation:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"f", ",", "g", ",", "done", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "1", "]"}], "=", 
   RowBox[{"g", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "2", "]"}], "=", 
   RowBox[{"g", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", "3", "]"}], "=", "done"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"g", "[", "1", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}], ",", 
     RowBox[{"g", "[", "3", "]"}]}], "]"}], "//", "Trace"}], "//", 
  "Column"}]}], "Input",
 CellChangeTimes->{{3.3898492330066557`*^9, 3.3898492599626555`*^9}}],

Cell[TextData[{
 "Step 7 summary: In other words, ",
 StyleBox["parts",
  FontVariations->{"Underline"->True}],
 " having the head Evaluate are always evaluated, and ",
 StyleBox["parts",
  FontVariations->{"Underline"->True}],
 " having the head Unevaluated are never evaluated.  Evaluation of other ",
 StyleBox["parts",
  FontVariations->{"Underline"->True}],
 " is controlled by the Hold... attributes, with the default being that ",
 StyleBox["parts",
  FontVariations->{"Underline"->True}],
 " which are not held are completely evaluated."
}], "Text"],

Cell[TextData[{
 StyleBox["\nStep 8:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Flat:", "Subsubsection"],
 "\nIf \"head\" in expression \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\" has attribute Flat, then splice the elements of any part with head \
\"head\" into the sequence:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"a", ",", 
      RowBox[{"f", "[", 
       RowBox[{"b", ",", "c"}], "]"}], ",", "d"}], "]"}], " ", 
    "\[DoubleLongRightArrow]", " ", 
    RowBox[{"f", "[", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]}], TraditionalForm]]],
 "\nBasically, the attribute Flat makes a function behave associatively.  \
Associative operators such as Plus and Times have the Flat attribute.\nFor \
example:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"f", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", "Flat"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"a", ",", 
     RowBox[{"f", "[", 
      RowBox[{"b", ",", "c"}], "]"}], ",", "d"}], "]"}], "//", "Trace"}], "//",
   "Column"}]}], "Input",
 CellChangeTimes->{{3.3898492944286556`*^9, 3.3898493191686554`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"a", ",", 
       RowBox[{"f", "[", 
        RowBox[{"b", ",", "c"}], "]"}]}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"d", ",", "e"}], "]"}]}], "]"}], "//", "Trace"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.389849308858656*^9, 3.389849313044656*^9}}],

Cell[TextData[{
 StyleBox["\nStep 9:", "Subsubsection"],
 " ",
 StyleBox["Automatically Splice Sequences:", "Subsubsection"],
 "\nIf \"head\" in expression \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\" does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " have the attribute SequenceHold, then automatically splice any part with \
head Sequence into a sequence of parts.\n(The assignment operators \"=\" and \
\": =\" in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " have the SequenceHold attribute.)\nFor example, the following function \
does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " have attribute SequenceHold:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"f", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e"}], "]"}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"a", ",", 
     RowBox[{"Sequence", "[", 
      RowBox[{"b", ",", "c"}], "]"}], ",", "d"}], "]"}], "//", "Trace"}], "//",
   "Column"}]}], "Input",
 CellChangeTimes->{{3.3898493402306557`*^9, 3.389849350365656*^9}}],

Cell[TextData[{
 StyleBox["\nStep 10:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Listable:", "Subsubsection"],
 "\nIf \"head\" in expression \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\" has attribute Listable, then automatically thread \"head\" over any part \
\"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\" that are lists, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], TraditionalForm]]],
 ".\n(All ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " internal numerical functions, predicates, and selected symbolic functions \
have the Listable attribute.)\nFor example, the following function has \
attribute Listable:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"f", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e"}], "]"}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", "Listable"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "]"}], "//", 
   "Trace"}], "//", "Column"}]}], "Input",
 CellChangeTimes->{{3.3898493569606557`*^9, 3.3898493756546555`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d"}], "}"}]}], "]"}], "//", "Trace"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.3898493831406555`*^9, 3.3898493884876556`*^9}}],

Cell[TextData[{
 StyleBox["\nStep 11:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute Orderless:", "Subsubsection"],
 "\nIf \"head\" in expression \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\" has attribute Orderless, then automatically sort the parts \"",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 "\", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], TraditionalForm]]],
 " into ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s canonical order.\n(",
 StyleBox["Mathematica'",
  FontSlant->"Italic"],
 "s internal communicative functions such as Plus and Times have the \
Orderless attribute.)\nFor example, the following function has attribute \
Orderless:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"f", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e"}], "]"}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"f", ",", "Orderless"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"d", ",", "c", ",", "b", ",", "a"}], "]"}], "//", "Trace"}], "//",
   "Column"}]}], "Input",
 CellChangeTimes->{{3.3898494012066555`*^9, 3.3898494147856555`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"a", ",", "2", ",", "b", ",", "1"}], "]"}]], "Input"],

Cell[TextData[{
 "\nSummary for steps 8-11: Both the head and all of the parts of the \
expression: \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", 
    RowBox[{
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}], "]"}], TraditionalForm]]],
 "\" have now been fully evaluated (if not held).\nActual rule application \
now follows:"
}], "Text"],

Cell[TextData[{
 StyleBox["\nStep 12: Apply User-Defined UpValues Associated with ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["part", "i"], "Subsubsection"], TraditionalForm]]],
 StyleBox[":", "Subsubsection"],
 " \nApply user-defined UpValues attached to the \"symbolic heads\" of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 ".  \nNote: \tUpValues are used to make assignments to the argument of a \
function rather than to the function itself.  This procedure is especially \
convenient if you want to extend the definition of protected internal \
function like Integrate.\nNote: \t\"symbolic head\" of  x  is  x\n\t\
\"symbolic head\" of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "...", "]"}], TraditionalForm]]],
 " is  ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 "\n\t\"symbolic head\" of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "...", "]"}], "[", "...", "]"}], TraditionalForm]]],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " "}], TraditionalForm]]],
 "\n\t\"symbolic head\" of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "...", "]"}], "[", "...", "]"}], "[", "...", "]"}], 
   TraditionalForm]]],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " "}], TraditionalForm]]],
 "\n\tetc.\n\t\nFor example:  What if you want the assignment of formulas for \
calculating the area of an object attached to that object (like circle or \
square) rather than to the area[...] function.  You would use UpValues. "
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{
    "area", ",", " ", "circle", ",", " ", "square", ",", "r", ",", "s"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"area", "[", 
    RowBox[{"circle", "[", "r_", "]"}], "]"}], "^=", 
   RowBox[{"\[Pi]", " ", 
    SuperscriptBox["r", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"area", "[", 
    RowBox[{"square", "[", "s_", "]"}], "]"}], "^=", 
   SuperscriptBox["s", "2"]}], ";"}]}], "InputOnly"],

Cell[TextData[{
 "First note that ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " assignment has been made to the area[...] function:"
}], "Text"],

Cell[BoxData[
 RowBox[{"?", "area"}]], "Input"],

Cell["\<\
Observe that the \"symbolic head\" of circle[r] is circle and the \"symbolic \
head\" of square[r] is square.
Next, observe that the formula for the area of a circle has been attached to \
the \"symbolic head\" of circle[...]:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"?", "circle"}]], "Input"],

Cell["\<\
Next, observe that the formula for the area of a square has been attached to \
the \"symbolic head\" of square[...]:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"?", "square"}]], "Input"],

Cell["\<\
Finally, trace the evaluation of the area of a circle with radius 2:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"area", "[", 
    RowBox[{"circle", "[", "2", "]"}], "]"}], "//", "Trace"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.3898494620006557`*^9, 3.3898494681076555`*^9}}],

Cell[TextData[{
 StyleBox["\nStep 13: Apply Internally-Defined UpValues Associated with ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["part", "i"], "Subsubsection"], TraditionalForm]]],
 StyleBox[":", "Subsubsection"],
 " \nApply internally-defined UpValues attached to the \"symbolic head\" of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 ".  "
}], "Text"],

Cell[TextData[{
 StyleBox["\nStep 14: Apply User-Defined DownValues Associated with \
\"head\":", "Subsubsection"],
 " \nApply user-defined DownValues attached to \"symbolic head\" of \"head\". \
 \nNote: \tDownValues are used to make assignments to the \"symbolic head\" \
of a function.  This procedure is the one typically implemented when \
user-defined functions are entered.\n\t\nFor example:  What if you want the \
assignment of formulas for calculating the area of an object attached to the \
area function rather than to the object (like circle or square).  You would \
use DownValues. "
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{
    "area", ",", " ", "circle", ",", " ", "square", ",", "r", ",", "s"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"area", "[", 
    RowBox[{"circle", "[", "r_", "]"}], "]"}], "=", 
   RowBox[{"\[Pi]", " ", 
    SuperscriptBox["r", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"area", "[", 
    RowBox[{"square", "[", "s_", "]"}], "]"}], "=", 
   SuperscriptBox["s", "2"]}], ";"}]}], "InputOnly"],

Cell["\<\
First note that all assignments have been made to the \"symbolic head\" of \
the area[...] function:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"?", "area"}]], "Input"],

Cell[TextData[{
 "\nNext, observe that ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " assignments have been attached to the \"symbolic head\" of circle[...]:"
}], "Text",
 CellChangeTimes->{3.523299211622549*^9}],

Cell[BoxData[
 RowBox[{"?", "circle"}]], "Input"],

Cell["\<\

or square[...]:\
\>", "Text",
 CellChangeTimes->{3.5232992131425643`*^9}],

Cell[BoxData[
 RowBox[{"?", "square"}]], "Input"],

Cell[TextData[{
 StyleBox["\nStep 15: Apply Internally-Defined DownValues Associated with \
\"head\":", "Subsubsection"],
 " ",
 StyleBox["\n\t  (This is where most internal functions take over and are \
evaluated)", "Subsubsection"],
 "\nApply internally-defined DownValues attached to \"symbolic head\" of \
\"head\".  \nNote: \tThis is when the bulk of ",
 StyleBox["Mathematica'",
  FontSlant->"Italic"],
 "s internal rules are applied.\n\t\nFor example:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", 
    RowBox[{"2", "\[Pi]"}], "]"}], TraditionalForm]]],
 " which has \"symbolic head\"  Sin  would be evaluated here. \n\n(In \
general, rule applications performed ",
 StyleBox["within",
  FontVariations->{"Underline"->True}],
 " step 15 are usually not visible using the Trace[...] command.  However, ",
 StyleBox["some",
  FontVariations->{"Underline"->True}],
 " of the internal rule applications can be displayed by using the \
TraceInternal option.)\n"
}], "Text"],

Cell[TextData[{
 StyleBox["Step 16: Restore Unevaluated[...]", "Subsubsection"],
 "\nIf ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " applicable rules were found for:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"head", "[", "...", "]"}], TraditionalForm]]],
 ", then restore the head Unevaluated[...] to any ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["part", "i"], TraditionalForm]]],
 " from which it was removed earlier in step 7b.\n\t\nExample: Consider a \
function which has no applicable rules assigned to it:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{"f1", ",", "f2"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"Unevaluated", "[", 
    RowBox[{"1", "+", "2"}], "]"}], "]"}], "//", "Trace"}]}], "Input"],

Cell[TextData[{
 "\nAs expected, Unevaluated[...] was removed from the sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "2"}], TraditionalForm]]],
 ", which was held unevaluated (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"f1", "[", 
     RowBox[{"1", "+", "2"}], "]"}]}], TraditionalForm]]],
 ").  When no rules were applied for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f1", "[", "...", "]"}], TraditionalForm]]],
 ", the Unevaluated head was restored (i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f1", "[", 
    RowBox[{"Unevaluated", "[", 
     RowBox[{"1", "+", "2"}], "]"}], "]"}], TraditionalForm]]],
 ").\nHowever, consider a function which has an applicable rule assigned to \
it:"
}], "Text",
 CellChangeTimes->{3.52329922567269*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f2", "[", "x_", "]"}], ":=", 
    RowBox[{"Hold", "[", "x", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{"Unevaluated", "[", 
    RowBox[{"1", "+", "2"}], "]"}], "]"}], "//", "Trace"}]}], "Input"],

Cell[TextData[{
 "\nObserve that Unevaluated[...] was removed from the sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "2"}], TraditionalForm]]],
 ", which was held unevaluated (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"f2", "[", 
     RowBox[{"1", "+", "2"}], "]"}]}], TraditionalForm]]],
 ").  Then the rule was applied producing:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Hold", "[", 
    RowBox[{"1", "+", "2"}], "]"}], TraditionalForm]]],
 ".  Also observe that Unevaluated[...] was not restored."
}], "Text",
 CellChangeTimes->{3.523299234082774*^9}],

Cell[TextData[{
 StyleBox["\nStep 17: Discard Return[...]", "Subsubsection"],
 "\nDiscard the head Return[...], if present.\n"
}], "Text"],

Cell[TextData[{
 "The above outline of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s evaluation procedure is not unabridged.  However it contains most of the \
essential features that the intermediate and advanced programmer will need to \
understand.\n"
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Example: Putting It All Together", "Subsection"],

Cell[TextData[{
 "The following example illustrates ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure for a normal expression which modifies its head, \
has attributes, has arguments which evaluate, has an UpValue for one of its \
arguments and a DownValue for the head.\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"SetAttributes", "[", 
    RowBox[{"F", ",", 
     RowBox[{"{", 
      RowBox[{"HoldRest", ",", "Orderless"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "  \[LongLeftArrow]  Set Attributes HoldRest and Orderless for  F\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "=", "F"}], TraditionalForm]]],
 "\t\t\[LongLeftArrow]  Assignment for head\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"a1", "=", "A1"}], TraditionalForm]]],
 "\t\[LongLeftArrow]  Assignment for argument\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"a2", "=", "A2"}], TraditionalForm]]],
 "\t\[LongLeftArrow]  Assignment for argument\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"a3", "=", "A3"}], TraditionalForm]]],
 "\t\[LongLeftArrow]  Assignment for argument\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"a2", "/:", 
    RowBox[{"F", "[", 
     RowBox[{"x1_", ",", "a2", ",", "x3_"}], "]"}], ":=", 
    RowBox[{"F", "[", 
     RowBox[{
      RowBox[{"up", "[", "x1", "]"}], ",", 
      RowBox[{"up", "[", "a2", "]"}], ",", 
      RowBox[{"up", "[", "x3", "]"}]}], "]"}]}], TraditionalForm]]],
 "\t\[LongLeftArrow]  Assign an UpValue for a2\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}], ":=", 
    RowBox[{"down", "[", 
     RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], TraditionalForm]]],
 "\t\t\[LongLeftArrow]  Assign a DownValue for F\n\t"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", 
    RowBox[{
    "f", ",", "F", ",", "a1", ",", "A1", ",", "a2", ",", "A2", ",", "a3", ",",
      "A3", ",", "up", ",", "down"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"F", ",", 
     RowBox[{"{", 
      RowBox[{"HoldRest", ",", "Orderless"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "=", "F"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a1", "=", "A1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a2", "=", "A2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a3", "=", "A3"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a2", "/:", 
    RowBox[{"F", "[", 
     RowBox[{"x1_", ",", "a2", ",", "x3_"}], "]"}], ":=", 
    RowBox[{"F", "[", 
     RowBox[{
      RowBox[{"up", "[", "x1", "]"}], ",", 
      RowBox[{"up", "[", "a2", "]"}], ",", 
      RowBox[{"up", "[", "x3", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", 
    RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}], ":=", 
   RowBox[{"down", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], ";"}]}], "InputOnly"],

Cell[TextData[{
 "Trace the evaluation of the normal expression:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"a3", ",", "a2", ",", "a1"}], "]"}], TraditionalForm]]],
 "\n\t\t"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"a3", ",", "a2", ",", "a1"}], "]"}], "//", "Trace"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.3898495298476553`*^9, 3.389849535886656*^9}}],

