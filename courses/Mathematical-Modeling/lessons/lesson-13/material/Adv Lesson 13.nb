}], "Text"],

Cell[TextData[{
 "\n",
 StyleBox["Highly Technical Remark",
  FontVariations->{"Underline"->True}],
 ": The actual evaluation of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"lhs", 
    StyleBox["=",
     FontWeight->"Bold",
     FontColor->RGBColor[1, 0, 0]], 
    RowBox[{"rhs", "   ", 
     RowBox[{
      StyleBox["i",
       FontWeight->"Plain",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], 
      StyleBox[".",
       FontWeight->"Plain",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], 
      StyleBox["e",
       FontWeight->"Plain",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], 
      StyleBox[".",
       FontWeight->"Plain",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], "  ", 
      RowBox[{
       StyleBox["Set",
        FontColor->RGBColor[1, 0, 0]], "[", 
       RowBox[{"lhs", ",", "rhs"}], "]"}]}]}]}], TraditionalForm]]],
 " is actually somewhat more involved than indicated above.  Even though the \
left-hand side of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["lhs",
     FontColor->RGBColor[0, 0, 1]], 
    StyleBox["=",
     FontWeight->"Bold",
     FontColor->RGBColor[1, 0, 0]], "rhs"}], TraditionalForm]]],
 " is held from evaluation because of the attribute HoldFirst of the ",
 StyleBox["Set",
  FontColor->RGBColor[1, 0, 0]],
 " command, the ",
 Cell[BoxData[
  FormBox[
   StyleBox["lhs",
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 " is actually allowed to ",
 StyleBox["partially",
  FontVariations->{"Underline"->True}],
 " evaluate ",
 StyleBox["after",
  FontVariations->{"Underline"->True}],
 " the ",
 StyleBox["Set",
  FontColor->RGBColor[1, 0, 0]],
 " command has been passed to the pattern matching machinery in step 15.  \
Specifically, if the ",
 StyleBox["held",
  FontVariations->{"Underline"->True}],
 " expression on the left-hand side is itself a normal expression: i.e.\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     StyleBox[
      RowBox[{"head", "[", 
       RowBox[{
        SubscriptBox["part", "1"], ",", 
        SubscriptBox["part", "2"], ",", 
        SubscriptBox["part", "3"], ",", "...", ",", 
        SubscriptBox["part", "n"]}], "]"}],
      FontColor->RGBColor[0, 0, 1]], " ", 
     StyleBox["=",
      FontWeight->"Bold",
      FontColor->RGBColor[1, 0, 0]], "  ", "rhs"}]}], TraditionalForm]]],
 ",\nor\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Set",
     FontColor->RGBColor[1, 0, 0]], "[", "  ", 
    RowBox[{
     StyleBox[
      RowBox[{"head", "[", 
       RowBox[{
        SubscriptBox["part", "1"], ",", 
        SubscriptBox["part", "2"], ",", 
        SubscriptBox["part", "3"], ",", "...", ",", 
        SubscriptBox["part", "n"]}], "]"}],
      FontColor->RGBColor[0, 0, 1]], ",", "  ", "rhs"}], "]"}], 
   TraditionalForm]]],
 ",\nthen ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " of the ",
 StyleBox["individual",
  FontVariations->{"Underline"->True}],
 " components: ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"head", ",", " ", 
     SubscriptBox["part", "1"], ",", 
     SubscriptBox["part", "2"], ",", 
     SubscriptBox["part", "3"], ",", "...", ",", 
     SubscriptBox["part", "n"]}],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 ", will ",
 StyleBox["eventually",
  FontVariations->{"Underline"->True}],
 " be allowed to evaluate ",
 StyleBox["after",
  FontVariations->{"Underline"->True}],
 " the ",
 StyleBox["Set[...]",
  FontColor->RGBColor[1, 0, 0]],
 " command has been passed to step 15 for final evaluation.  However, ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " UpValues (i.e. steps 12 and 13) and ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " DownValues (i.e. steps 14 and 15) will be applied to the resulting \
partially evaluated left-hand side: ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"head", "[", 
     RowBox[{
      SubscriptBox["part", "1"], ",", 
      SubscriptBox["part", "2"], ",", 
      SubscriptBox["part", "3"], ",", "...", ",", 
      SubscriptBox["part", "n"]}], "]"}],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 ".\nYou might wonder why this is necessary.  Consider the following example \
of re-assigning the value of a single element within a list:"
}], "Text"],

Cell[BoxData[
 RowBox[{"sList", "=", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"i", "=", "2"}]], "Input"],

Cell[TextData[{
 "\nTrace the steps performed by the Evaluation Procedure required to \
evaluate the contents of the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], 
   TraditionalForm]]],
 " at location ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", "2"}], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.523300216762601*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sList", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "//",
    "Trace"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.389850374917656*^9, 3.3898503897366557`*^9}}],

Cell[TextData[{
 "\nObserve that the following replacements were made as part of the Standard \
Evaluation Procedure:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"sList", "  ", "\[DoubleLongRightArrow]", "  ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]}], 
   TraditionalForm]]],
 "\tstep 7f\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "  ", "\[DoubleLongRightArrow]", "  ", "2"}], 
   TraditionalForm]]],
 "\t\t\tstep 7f\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], 
     RowBox[{"\[LeftDoubleBracket]", " ", 
      StyleBox["2",
       FontSize->10,
       FontWeight->"Bold",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], 
      StyleBox[" ",
       FontWeight->"Bold",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], "\[RightDoubleBracket]"}]], "  ", 
    "\[DoubleLongRightArrow]", "  ", "2"}], TraditionalForm]]],
 ".\tstep 15 \n\nNow, consider how a new value might be assigned to the \
location ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", "2"}], TraditionalForm]]],
 " within the list.\nYou would enter the following immediate assignment:\n\t\t\
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["sList", 
     RowBox[{"\[LeftDoubleBracket]", " ", 
      StyleBox["i",
       FontSize->10,
       FontWeight->"Bold",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], 
      StyleBox[" ",
       FontWeight->"Bold",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], "\[RightDoubleBracket]"}]], 
    StyleBox["=",
     FontWeight->"Bold"], 
    RowBox[{"New", " ", "Value"}]}], TraditionalForm]]],
 ".\nThe FullForm of the above expression is:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Set", "[", "  ", 
    RowBox[{
     RowBox[{"Part", "[", 
      RowBox[{"sList", ",", "i"}], "]"}], ",", "  ", 
     RowBox[{"New", " ", "Value"}]}], "]"}], TraditionalForm]]],
 ".\nRemember, the Set[...] command has the attribute HoldFirst.  Therefore, \
you would expect that the left-hand expression:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Part", "[", 
    RowBox[{"sList", ",", "i"}], "]"}], TraditionalForm]]],
 "     i.e.      ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["sList", 
    RowBox[{"\[LeftDoubleBracket]", " ", 
     StyleBox["i",
      FontSize->10,
      FontWeight->"Bold",
      FontSlant->"Plain",
      FontTracking->"Plain",
      FontVariations->{"CompatibilityType"->0,
      "Masked"->False,
      "Outline"->False,
      "RotationAngle"->0,
      "Shadow"->False,
      "StrikeThrough"->False,
      "Underline"->False}], 
     StyleBox[" ",
      FontWeight->"Bold",
      FontSlant->"Plain",
      FontTracking->"Plain",
      FontVariations->{"CompatibilityType"->0,
      "Masked"->False,
      "Outline"->False,
      "RotationAngle"->0,
      "Shadow"->False,
      "StrikeThrough"->False,
      "Underline"->False}], "\[RightDoubleBracket]"}]], TraditionalForm]]],
 "\nwill ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " be evaluated by the Evaluation Procedure (which is indeed the case).\n\
However, there is absolutely no hope of replacing the second element of the \
list with a new value unless the following replacements are made at some \
point during the evaluation:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"sList", "  ", "\[DoubleLongRightArrow]", "  ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]}], 
   TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "  ", "\[DoubleLongRightArrow]", "  ", "2"}], 
   TraditionalForm]]],
 "\nto obtain the intermediate expression:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], 
     RowBox[{"\[LeftDoubleBracket]", " ", 
      StyleBox["2",
       FontSize->10,
       FontWeight->"Bold",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], 
      StyleBox[" ",
       FontWeight->"Bold",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], "\[RightDoubleBracket]"}]], " ", 
    StyleBox["=",
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    RowBox[{"New", " ", "Value"}]}], TraditionalForm]]],
 ".\nThe expression on the left-hand side can ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " be allowed to evaluate to its final form:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], 
     RowBox[{"\[LeftDoubleBracket]", " ", 
      StyleBox["2",
       FontSize->10,
       FontWeight->"Bold",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], 
      StyleBox[" ",
       FontWeight->"Bold",
       FontSlant->"Plain",
       FontTracking->"Plain",
       FontVariations->{"CompatibilityType"->0,
       "Masked"->False,
       "Outline"->False,
       "RotationAngle"->0,
       "Shadow"->False,
       "StrikeThrough"->False,
       "Underline"->False}], "\[RightDoubleBracket]"}]], "  ", 
    "\[DoubleLongRightArrow]", "  ", "2"}], TraditionalForm]]],
 "\t(which would occur at step 15)\nbecause this would generate the following \
unacceptable assignment to the atomic expression \"2\":\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", 
    StyleBox["=",
     FontWeight->"Bold"], 
    RowBox[{"New", " ", "Value"}]}], TraditionalForm]]],
 ".\n\t\t\nEvaluate the following immediate assignment to see that the above \
procedure is implemented as described:"
}], "Text",
 CellChangeTimes->{
  3.523300244402877*^9, {3.523300422494658*^9, 3.523300423494668*^9}, {
   3.5233004619350524`*^9, 3.5233005175856085`*^9}}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["sList", 
   RowBox[{"\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]], "=", 
  "\"\<New Value\>\""}]], "Input"],

Cell["\<\

Check the current contents of our list:\
\>", "Text",
 CellChangeTimes->{3.5233005243156757`*^9}],

Cell[BoxData[
 RowBox[{"?", "sList"}]], "Input"],

Cell[TextData[{
 "\nYou can trace the above immediate assignment to verify that the \
replacements:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"sList", "  ", "\[DoubleLongRightArrow]", "  ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]}], 
   TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "  ", "\[DoubleLongRightArrow]", "  ", "2"}], 
   TraditionalForm]]],
 "\nare ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " being made during the Evaluation Procedure (i.e. not outside of step 15):"
}], "Text",
 CellChangeTimes->{3.523300527855712*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sList", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
    "=", "\"\<New Value\>\""}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.3898504301776557`*^9, 3.3898504365146556`*^9}, {
  3.389850467063656*^9, 3.3898504800476556`*^9}}],

Cell[TextData[{
 "\nHowever, we can use the option \"TraceInternal\" requesting that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " shows us at least some of the replacements that are made ",
 StyleBox["after",
  FontVariations->{"Underline"->True}],
 " the expression has been passed to the pattern matching machinery in step \
15."
}], "Text",
 CellChangeTimes->{3.523300546435897*^9}],

Cell[TextData[{
 "TraceInternal ... specifies whether to trace evaluations of expressions \
generated ",
 StyleBox["internally",
  FontVariations->{"Underline"->True}],
 " by Mathematica."
}], "Item",
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Trace", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sList", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
     "=", "\"\<New Value\>\""}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"TraceInternal", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.389850489405656*^9, 3.3898505223496556`*^9}}],

Cell["\<\

Carefully compare this trace to the trace of the evaluation presented earlier.\
\>", "Text",
 CellChangeTimes->{3.5233005637760706`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 7: Internal Function Subscript [...]:", "Subsection"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "rhs", ",", "n", ",", "Subscript"}], 
  "]"}]], "InputOnly"],

Cell[TextData[{
 StyleBox["Objective",
  FontVariations->{"Underline"->True}],
 ": Determine where the assignments for subscripted expressions are stored.\n\
\nIt is often convenient to use subscripted expressions:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["a", "1"], ",", 
     SubscriptBox["a", "2"], ",", 
     SubscriptBox["a", "3"], ",", 
     SubscriptBox["a", "4"], ",", 
     SubscriptBox["a", "5"], ",", 
     SubscriptBox["a", "6"], ",", 
     SubscriptBox["a", "7"]}], "}"}], TraditionalForm]]],
 ".\n\t\t\nIt is easy to make assignments to a subscripted expression:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["a", "2"], "=", "rhs"}]], "Input"],

Cell["\<\

We can evaluate this subscripted expression to verify the above assignment:\
\>", "Text",
 CellChangeTimes->{3.5233005901463346`*^9}],

Cell[BoxData[
 SubscriptBox["a", "2"]], "Input"],

Cell[TextData[{
 "\nHowever, what symbol is this assignment attached to?  This information is \
required if you want to use Clear[...] (there are, as always, other ways to \
clear this assignment).\n\nYou might think that our assignment  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "2"], "=", "rhs"}], TraditionalForm]]],
 "  would be attached to the symbol  ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 ".  However, this is not the case:"
}], "Text",
 CellChangeTimes->{3.523300591906352*^9}],

Cell[BoxData[
 RowBox[{"?", "a"}]], "Input"],

Cell[TextData[{
 "\nEven an exhaustive search of Context Global` (using  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"?", "Global`*"}], TraditionalForm]]],
 ") did not turn up any indication of where this assignment might be stored.\n\
\nTherefore, we must turn to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure for the answer.\nExamination of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure indicates that user defined assignments ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " be stored either as UpValues or as DownValues (see steps 12 and 14).  You \
also know that UpValues are tagged to the \"symbolic head\" of the argument \
and DownValues must be tagged to the \"symbolic head\" of the function.\nAs \
usual, our first step is to determine the FullForm of the expression:"
}], "Text",
 CellChangeTimes->{3.5233005942563753`*^9}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["a", "n"], "  ", "//", "FullForm"}]], "Input"],

Cell[TextData[{
 "\nTherefore the assignment:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "2"], "=", "rhs"}], TraditionalForm]]],
 "\nis really just:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"Subscript", "[", 
      RowBox[{"a", ",", "2"}], "]"}],
     ShowSpecialCharacters->False,
     ShowStringCharacters->True,
     NumberMarks->True], "=", "rhs"}], TraditionalForm]]],
 "\n\t\t\nThe next step is to determine the Attributes of Subscript[...]:"
}], "Text",
 CellChangeTimes->{3.5233006283667164`*^9}],

Cell[BoxData[
 RowBox[{"Attributes", "[", "Subscript", "]"}]], "Input"],

Cell[TextData[{
 "\nUnlike almost every other internal ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function, the Subscript[...] function is ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " protected!\nTherefore, it is now completely clear that the assignment will \
be assigned to the \"symbolic head\" Subscript:"
}], "Text",
 CellChangeTimes->{{3.3898509845086555`*^9, 3.3898509874296556`*^9}, 
   3.523300636176795*^9}],

Cell[BoxData[
 RowBox[{"??", "Subscript"}]], "Input",
 CellChangeTimes->{3.389851015754656*^9}],

Cell["\<\

We now understand why we did not find this assignment in Context Global`.  It \
is actually stored in Context System` because Subscript[...] is a System \
function.

It is now easy to clear all Subscript assignments:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", "Subscript", "]"}]], "InputOnly"],

Cell["and check to verify that the assignments have been cleared:", "Text"],

Cell[BoxData[
 RowBox[{"??", "Subscript"}]], "Input",
 CellChangeTimes->{3.3898510449726553`*^9}],

Cell[TextData[{
 StyleBox["\nObservation",
  FontVariations->{"Underline"->True}],
 ": Even internal functions must be evaluated using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure.  Therefore, this understanding will always guide \
you to a solution of your problems.\n"
}], "Text"],

Cell[TextData[{
 StyleBox["New Problem",
  FontVariations->{"Underline"->True}],
 ": Clearing the \"symbolic head\" Subscript will clear ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " subscripted expressions simultaneously:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["a", "1"], ",", 
     SubscriptBox["a", "2"], ",", 
     SubscriptBox["a", "3"], ",", 
     SubscriptBox["a", "4"], ",", 
     SubscriptBox["a", "5"], ",", 
     SubscriptBox["a", "6"], ",", 
     SubscriptBox["a", "7"]}], "}"}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["b", "1"], ",", 
     SubscriptBox["b", "2"], ",", 
     SubscriptBox["b", "3"], ",", 
     SubscriptBox["b", "4"]}], "}"}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["c", "1"], ",", 
     SubscriptBox["c", "2"], ",", 
     SubscriptBox["c", "3"], ",", 
     SubscriptBox["c", "4"], ",", 
     SubscriptBox["c", "5"], ",", 
     SubscriptBox["c", "6"]}], "}"}], TraditionalForm]]],
 ".\n\t\t\nHow can we explicitly clear ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " the expressions associated with the symbol  ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]]],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["b", "1"], ",", 
     SubscriptBox["b", "2"], ",", 
     SubscriptBox["b", "3"], ",", 
     SubscriptBox["b", "4"]}], "}"}], TraditionalForm]]],
 " ?\n\nExamination of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure indicates that if we insist upon assignments like:\n\
\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "2"], "=", "rhs"}], TraditionalForm]]],
 "\ti.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"Subscript", "[", 
      RowBox[{"a", ",", "2"}], "]"}],
     ShowSpecialCharacters->False,
     ShowStringCharacters->True,
     NumberMarks->True], "=", "rhs"}], TraditionalForm]]],
 ",\nthen the assignments ",
 StyleBox["will",
  FontVariations->{"Underline"->True}],
 " be tagged as DownValues to the \"symbolic head\" Subscript (see step 14).\n\
However, step 12 indicates that we can explicitly tag these assignments as \
UpValues to the argument  ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 "  in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"Subscript", "[", 
      RowBox[{"a", ",", "2"}], "]"}],
     ShowSpecialCharacters->False,
     ShowStringCharacters->True,
     NumberMarks->True], "=", "rhs"}], TraditionalForm]]],
 ". \nRecall the notation   ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x3", "/:", " ", 
    RowBox[{"f", "[", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], "=", "rhs"}], 
   TraditionalForm]]],
 ", which tags the UpValue to the single location  x3.   However, if you use \
the notation  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "]"}], "^=", "rhs"}], 
   TraditionalForm]]],
 ", then the UpValue will be tagged to 4 different locations:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", ",", "x2", ",", 
    RowBox[{"x3", " ", "and", " ", "x4"}]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "/:", "   ", 
   SubscriptBox["a", "1"], "=", "rhs1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "/:", "   ", 
   SubscriptBox["a", "2"], "=", "rhs2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "/:", "   ", 
    SubscriptBox["a", "3"], "=", "rhs3"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "/:", "   ", 
   SubscriptBox["b", "1"], "=", "rhs1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "/:", "   ", 
   SubscriptBox["b", "2"], "=", "rhs2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "/:", "   ", 
    SubscriptBox["b", "3"], "=", "rhs3"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "/:", "   ", 
   SubscriptBox["c", "1"], "=", "rhs1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "/:", "   ", 
   SubscriptBox["c", "2"], "=", "rhs2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "/:", "   ", 
   SubscriptBox["c", "3"], "=", "rhs3"}], ";"}]}], "InputOnly"],

Cell["Verify that the assignments are not assigned to Subscript:", "Text",
 CellChangeTimes->{{3.3898510863156557`*^9, 3.3898510898696556`*^9}}],

Cell[BoxData[
 RowBox[{"?", "Subscript"}]], "Input"],

Cell[TextData[{
 "\nVerify that the assignments are indeed assigned as UpValues to the \
symbols  ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 ",  b  and  c:"
}], "Text",
 CellChangeTimes->{{3.3898510928876553`*^9, 3.3898510955196557`*^9}, 
   3.523300717997613*^9}],

Cell[BoxData[
 RowBox[{"?", "a"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "b"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "c"}]], "Input"],

Cell[TextData[{
 "\nWe can now clear just the Upvalue assignments to the symbol  ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]]],
 "  leaving the assignments to the symbols  ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]]],
 "  untouched:"
}], "Text",
 CellChangeTimes->{3.523300722207655*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", "b", "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"?", "a"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "b"}]], "Input"],

Cell[BoxData[
 RowBox[{"?", "c"}]], "Input"],

Cell[TextData[{
 "\n",
 StyleBox["Observation",
  FontVariations->{"Underline"->True}],
 ": Your earliest experience with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " may have led you to believe that your only option was to memorize each of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s strange and quirky behaviors.  However, an understanding of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure is actually much more valuable than attempting to \
memorize the behavior of every conceivable situation.\n"
}], "Text"],

Cell[TextData[{
 StyleBox["New Problem",
  FontVariations->{"Underline"->True}],
 ": Consider making the assignment:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "2"], "=", 
    FractionBox["\[Pi]", "2"]}], TraditionalForm]]],
 "\ti.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"Subscript", "[", 
      RowBox[{"a", ",", "2"}], "]"}],
     ShowSpecialCharacters->False,
     ShowStringCharacters->True,
     NumberMarks->True], "=", 
    FractionBox["\[Pi]", "2"]}], TraditionalForm]]],
 ".\nThis assignment ",
 StyleBox["will",
  FontVariations->{"Underline"->True}],
 " be assigned as DownValues to the \"symbolic head\" Subscript (see step 14):"
}], "Text",
 CellChangeTimes->{{3.3898511542116556`*^9, 3.389851156372656*^9}}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["a", "2"], "=", 
  FractionBox["\[Pi]", "2"]}]], "Input"],

Cell["\<\

Evaluate the following expression:\
\>", "Text",
 CellChangeTimes->{3.523300735357786*^9}],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  SubscriptBox["a", "2"], "]"}]], "Input"],

Cell["\<\

Why did the subscripted variable not use the most recent assignment?
Verify the assignment you made as a DownValue to Subscript:\
\>", "Text",
 CellChangeTimes->{3.5233007373778067`*^9}],

Cell[BoxData[
 RowBox[{"??", "Subscript"}]], "Input",
 CellChangeTimes->{3.3898514399806557`*^9}],

Cell[TextData[{
 "\nThis looks OK.\nTest to see if there are any assignments tagged to the \
argument  ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.523300745087884*^9}],

Cell[BoxData[
 RowBox[{"?", "a"}]], "Input"],

Cell[TextData[{
 "\nThis clearly indicates where the expression  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", 
    SubscriptBox["a", "2"], "]"}], TraditionalForm]]],
 "  obtained the value  rhs2,  but why?\nExamination of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure indicates that UpValues (step 12) are evaluated ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " DownValues (step 14).  Therefore, there were ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " patterns matching the expression:  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "2"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.523300750897942*^9}],

Cell[TextData[{
 "\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "/:", 
    RowBox[{"\"\<Subscript\>\"", "[", 
     RowBox[{"a", ",", "2"}], "]"}], "=", "rhs2"}], TraditionalForm]]],
 "\tUpValue to be applied in step 12 and\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "2"], "=", 
    FractionBox["\[Pi]", "2"]}], TraditionalForm]]],
 "\t\t\tDownValue to be applied in step 14.\nTherefore, the DownValue  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "2"], "=", 
    FractionBox["\[Pi]", "2"]}], TraditionalForm]]],
 "  tagged to Subscript  was never used."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Summary:", "Subsection"],

Cell[TextData[{
 "The precise evaluation sequence of symbolic code can be very confusing.  An \
understanding of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure, along with judicious use of Trace[...] and \
Hold[...], are invaluable for both generating and debugging symbolic code.  "
}], "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Improving Computational Speed:", "Subtitle"]], \
"Section"],

Cell[TextData[{
 "It is well known that the computational speed of ",
 StyleBox["some",
  FontVariations->{"Underline"->True}],
 " internal ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands is extremely poor.  It is also well known that procedures that \
are computationally efficient in \"imperative\" languages like Fortran may be \
highly inefficient in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  The reason for this behavior can usually be traced to the following \
consideration:\n\t ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is structured as a functional list-based language where operations are \
performed by transformation rules.  \"Imperative\" languages are built on \
rigid data structures corresponding to specific machine addresses.  The \
advantage offered by ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is that complicated structures can be operated on in their totality rather \
than using piecemeal procedures.  Another advantage is that all computations \
proceed without requiring the programmer to explicitly allocate machine \
resources (i.e. declare variable types and dimension arrays).  The \
disadvantage is that implementing piecemeal procedures within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " may invoke an unexpected computational overhead (which is especially \
surprising to Fortran and C++ programmers).  This computational overhead \
usually arises from the following aspect of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure:\n\t",
 StyleBox["Step 4:", "Subsubsection"],
 " ",
 StyleBox["Normal Expression:", "Subsubsection"],
 "\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"head", "[", 
     RowBox[{
      SubscriptBox["part", "1"], ",", 
      SubscriptBox["part", "2"], ",", 
      SubscriptBox["part", "3"], ",", "...", ",", 
      SubscriptBox["part", "n"]}], "]"}], "Subsubsection"], TraditionalForm]]],
 "\n\tIf ",
 StyleBox["any part",
  FontVariations->{"Underline"->True}],
 " of an expression changes during the evaluation process, \n\tthen the ",
 StyleBox["evaluation process for this expression ",
  FontVariations->{"Underline"->True}],
 StyleBox["will begin anew",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[1, 0, 0]],
 ".\nA direct consequence of this statement is that any computational step \
which modifies just a single component of a more complicated expression ",
 StyleBox["may",
  FontVariations->{"Underline"->True}],
 " automatically trigger the complete re-evaluation of the full expression \
(even if 99.9% of the components remain unchanged).  For example, modifying a \
single element within a list will ",
 StyleBox["automatically",
  FontVariations->{"Underline"->True}],
 " force the re-evaluation of the complete contents of the list. You may feel \
that this requirement is unusually harsh.  However, you must keep in mind \
that the elements of a list can be ",
 StyleBox["any",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " expression, not just numbers (which remain invariant).  It is quite \
conceivable that the expressions computed at one location within the list may \
be required at other locations as well.\nAnother example includes the \
Append[...] and the Prepend[...] commands which automatically modify a single \
element of the list that they create.  Therefore, a lengthy list created \
using these commands will tend to have quadratic computational complexity as \
the length of the list grows.  \nThe good news is that there are several ways \
to easily avoid these problems (see the examples and concluding remarks).  \
However, the bad news is that the solution to your computational speed \
problem depends upon your understanding of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure."
}], "Text"],

Cell[CellGroupData[{

Cell["Example 1: Modifying a Large List in Place:", "Subsection"],

Cell[TextData[{
 "Programing languages like Fortran and C++ may (or may not) require that you \
dimension a list (i.e. array) before you enter the individual elements.  \
Then, it is typical to compute each element (one element at a time using a \
\"Do\" loop) and modify the existing list in place by entering each newly \
computed element.  However, this procedure implemented within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " generates a method with quadratic computational complexity, because ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure will re-evaluate the full contents of the list each \
and every time that the list is modified.  The quadratic computational \
complexity will then be the kiss of death to your program's computational \
efficiency.\n",
 StyleBox["Example",
  FontVariations->{"Underline"->True}],
 ": Consider the following simple example of creating a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nMax", "+", "1"}], TraditionalForm]]],
 " elements long of the form:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"example1", "=", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "2", ",", "4", ",", "8", ",", "16", ",", "32", ",", "...", ",", 
      SuperscriptBox["2", "nMax"]}], "}"}]}], TraditionalForm]]],
 "\n\t\nby repeatedly modifying an existing list.  \nThis will be \
accomplished by mimicking the procedure typically used in Fortran \
programming:\nStep 1: Dimension in Fortran (i.e. generate a list in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ") ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nMax", "+", "1"}], TraditionalForm]]],
 " elements long of 1's to hold our results:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"example1", "=", 
    RowBox[{"{", 
     RowBox[{
     "temp", ",", "temp", ",", "temp", ",", "temp", ",", "temp", ",", "...", 
      " ", ",", "temp"}], "}"}]}], TraditionalForm]]],
 "\nStep 2: Using a \"Do\" loop and starting at the beginning of the list, \
double each element of the list and store the result in the next element of \
the list:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Do", " ", "..."}], "   ", "n"}], " ", "=", " ", "1"}], ",", 
    "nMax"}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["example1", 
     RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], "=", 
    "1"}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["example1", 
     RowBox[{"\[LeftDoubleBracket]", 
      RowBox[{"n", "+", "1"}], "\[RightDoubleBracket]"}]], "=", 
    RowBox[{"2", "*", 
     SubscriptBox["example1", 
      RowBox[{"\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}]], 
     " "}]}], TraditionalForm]]],
 "\n\nThe ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code that mimics the Fortran procedure follows:"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "dataList", ",", "f1", ",", "f2", ",", "f3", ",", "f4", ",", "temp", ",", 
     "tempList"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "[", "nMax_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"time", "=", 
      RowBox[{
      "Timing", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"example1", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"temp", ",", 
           RowBox[{"{", 
            RowBox[{"nMax", "+", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
        RowBox[{
         SubscriptBox["example1", 
          RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], 
         "=", "1"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
         RowBox[{
          RowBox[{
           SubscriptBox["example1", 
            RowBox[{"\[LeftDoubleBracket]", 
             RowBox[{"n", "+", "1"}], "\[RightDoubleBracket]"}]], "=", 
           RowBox[{"2", "*", 
            SubscriptBox["example1", 
             RowBox[{
             "\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}]]}]}], ",",
           "\[IndentingNewLine]", "\t\t", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", "\t     ", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"nMax", ",", 
       SubscriptBox["time", 
        RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]]}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "InputOnly",
 CellChangeTimes->{
  3.389851507200656*^9, {3.3898527458176556`*^9, 3.3898527463186555`*^9}, {
   3.399751109524724*^9, 3.399751147821844*^9}, {3.3997515516056786`*^9, 
   3.3997515530588126`*^9}}],

Cell[TextData[{
 "Illustrate this function where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nMax", " ", "=", " ", "10"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"f1", "[", "10", "]"}]], "Input",
 CellChangeTimes->{{3.389851538518656*^9, 3.3898515454326553`*^9}}],

Cell[TextData[{
 "\nThe number of doublings (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"length", " ", "of", " ", "the", " ", "list"}], "-", "1"}], 
   TraditionalForm]]],
 " ) is in the first element and the time required to create this list \
measured in seconds is in the second position.\n"
}], "Text",
 CellChangeTimes->{3.523300961220045*^9}],

Cell["The corresponding list is:", "Text"],

Cell[BoxData["example1"], "Input"],

Cell[TextData[{
 "\nCalculate the approximate number of doublings required to use about 1 sec \
of time on your machine using this method.\n",
 StyleBox["Note: this evaluation may take several seconds:",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{3.5233009690701237`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "timeData1", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"timeData1", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0.", ",", "0."}], "}"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nn", "=", "0"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"While", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"nn", "=", 
       RowBox[{"nn", "+", "1"}]}], ";", 
      RowBox[{"f1Steps", "=", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         SuperscriptBox["1.5", "nn"], "*", "1000"}], "]"}]}], ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"timeData1", ",", " ", 
        RowBox[{"f1", "[", "f1Steps", "]"}]}], "]"}], ";", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"f1Time", "=", 
         SubscriptBox[
          RowBox[{"Last", "[", "timeData1", "]"}], 
          RowBox[{"\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]]}], 
        ")"}], "<", "1"}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "f1Steps", ",", "\"\< steps requires \>\"", ",", "f1Time", ",", 
       "\"\< sec\>\""}], "]"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{
    "f1Steps", ",", "\"\< steps requires \>\"", ",", "f1Time", ",", 
     "\"\< sec\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Number of steps required for about 1 sec is \>\"", ",", 
   RowBox[{"nSpeed", "=", 
    RowBox[{"Ceiling", "[", 
     RowBox[{"n", "/.", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Fit", "[", 
           RowBox[{"timeData1", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", "n", ",", 
              SuperscriptBox["n", "2"]}], "}"}], ",", " ", "n"}], "]"}], 
          "]"}], "\[Equal]", "1"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", 
          SubscriptBox[
           RowBox[{"Last", "[", "timeData1", "]"}], 
           RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]]}], 
         "}"}]}], "]"}]}], "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.3898515694286556`*^9, 3.3898516265506554`*^9}, 
   3.3898523783976555`*^9}],

Cell[TextData[{
 "\nIllustrate this function where the number of doublings is nSpeed (the \
approximate number of doublings required to use about 1 sec of time on your \
machine using method ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f1", "[", "...", " ", "]"}], TraditionalForm]]],
 "):"
}], "Text",
 CellChangeTimes->{3.52330099068034*^9}],

Cell[BoxData[
 RowBox[{"f1", "[", "nSpeed", "]"}]], "Input"],

Cell[TextData[{
 "\nGenerate a list of sizes and corresponding times using the highly \
inefficient \"modify a large list in place\" procedure:\n",
 StyleBox["Note: this evaluation may take several minutes on a slow machine:",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{3.5233010175606084`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"data1", "=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"speedInfo", "=", 
       RowBox[{"f1", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        SubscriptBox["speedInfo", 
         RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], 
        ",", "\"\< steps requires \>\"", ",", 
        SubscriptBox["speedInfo", 
         RowBox[{"\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], 
        ",", "\"\< sec\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      "speedInfo"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{
        RowBox[{"2", "*", "nSpeed"}], "+", "1"}], ",", 
       RowBox[{"Floor", "[", 
        RowBox[{"nSpeed", "/", "10."}], "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.3898529562046556`*^9, 3.3898529956186557`*^9}}],

Cell["Next, plot the above data set of computational times:", "Text"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"data1", ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"PointSize", "[", ".02", "]"}]}]}], "]"}]], "Input"],

Cell["\<\

Observe that the computational time appears to be essentially quadratic as a \
function of the resulting list size.
\
\>", "Text",
 CellChangeTimes->{3.5233010753611865`*^9}],

Cell["\<\
The quadratic fit to the time data corresponding to the \"modify a large list \
in place\" procedure is:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Fit", "[", 
  RowBox[{"data1", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "n", ",", 
     RowBox[{"n", "^", "2"}]}], "}"}], ",", "n"}], "]"}]], "Input"],

Cell[TextData[{
 "\nObserve the positive coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "2"], TraditionalForm]]],
 ", supporting the observation that the method has quadratic computational \
complexity."
}], "Text",
 CellChangeTimes->{3.5233011001814346`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 2: Efficiently Modifying a Large List in Place:", "Subsection"],

Cell[TextData[{
 "Careful examination of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure indicates that a computational penalty occurs at \
step 4:\n\t",
 StyleBox["Step 4:", "Subsubsection"],
 " ",
 StyleBox["Normal Expression:", "Subsubsection"],
 "\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"head", "[", 
     RowBox[{
      SubscriptBox["part", "1"], ",", 
      SubscriptBox["part", "2"], ",", 
      SubscriptBox["part", "3"], ",", "...", ",", 
      SubscriptBox["part", "n"]}], "]"}], "Subsubsection"], TraditionalForm]]],
 "\n\tIf ",
 StyleBox["any part",
  FontVariations->{"Underline"->True}],
 " of an expression changes during the evaluation process, \n\tthen the ",
 StyleBox["evaluation process for this expression will begin anew",
  FontVariations->{"Underline"->True}],
 ".\n\nTherefore, the solution to this particular problem is to prevent the \
list from being needlessly re-evaluated.  Examination of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Evaluation Procedure suggests many possibilities, most involve using one \
of the Hold... Attributes or Hold...[...] commands.  However, the procedure \
which avoids as much of the Evaluation Procedure as possible is:\n\t",
 StyleBox["Step 6:", "Subsubsection"],
 " ",
 StyleBox["Apply Attribute HoldAllComplete (then skip to step 14)\n", 
  "Subsubsection"],
 "You might attempt to give List the attribute HoldAllComplete.  However, the \
List[...] function is locked to prevent any modification:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "List", "]"}]], "Input"],

Cell[TextData[{
 "\nThis forces you to make the following important observations:\n\tA list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a1", ",", "a2", ",", "a3", ",", "...", ",", "an"}], "}"}], 
   TraditionalForm]]],
 " has FullForm ",
 Cell[BoxData[
  FormBox[
   RowBox[{"List", "[", 
    RowBox[{"a1", ",", "a2", ",", "a3", ",", "...", ",", "an"}], "]"}], 
   TraditionalForm]]],
 ".\n\tA List[...] is exactly like ",
 StyleBox["any",
  FontVariations->{"Underline"->True}],
 " other function with ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " arguments.\n\tTherefore, you are ",
 StyleBox["expected",
  FontVariations->{"Underline"->True}],
 " to create a function for handling your data needs which behaves ",
 StyleBox["exactly",
  FontVariations->{"Underline"->True}],
 " the way you want (i.e. you are ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " restricted to using just a list). \n\t\nWe will implement these \
observations by creating a new data handling function \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"dataList", "[", 
    RowBox[{"a1", ",", "a2", ",", "a3", ",", "...", ",", "an"}], "]"}], 
   TraditionalForm]]],
 "\" which has the attribute HoldAllComplete:"
}], "Text",
 CellChangeTimes->{3.523301147271906*^9}],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"dataList", ",", "HoldAllComplete"}], "]"}]], "InputOnly"],

Cell[TextData[{
 "\n(You can, if you desire, also use the Format[...] command to make the \
printed appearance of this new function look exactly as if it were a list.)\n\
Efficient implementation of our pseudo-Fortran program given in Example 1 \
requires only a ",
 StyleBox["single",
  FontVariations->{"Underline"->True}],
 " modification:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"example2", "=", 
    RowBox[{"Apply", "[", 
     RowBox[{"dataList", ",", "example2"}], "]"}]}], TraditionalForm]]],
 "\nWhich effectively changes:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "temp", ",", "temp", ",", "temp", ",", "temp", ",", "temp", ",", "...", 
     " ", ",", "temp"}], "}"}], TraditionalForm]]],
 "\ninto:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"dataList", "[", 
    RowBox[{
    "temp", ",", "temp", ",", "temp", ",", "temp", ",", "temp", ",", "...", 
     " ", ",", "temp"}], "]"}], TraditionalForm]]],
 ".\n\t\t\nTherefore, every subsequent reference to the variable \"example2\" \
will be a reference to \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"dataList", "[", "...", "]"}], TraditionalForm]]],
 "\"."
}], "Text",
 CellChangeTimes->{{3.5233011692021246`*^9, 3.5233011714621477`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f2", "[", "nMax_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"time", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
      "Timing", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"example2", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"temp", ",", 
           RowBox[{"{", 
            RowBox[{"nMax", "+", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"example2", "=", 
         RowBox[{"Apply", "[", 
          RowBox[{"dataList", ",", "example2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
        RowBox[{
         SubscriptBox["example2", 
          RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], 
         "=", "1"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
         RowBox[{
          RowBox[{
           SubscriptBox["example2", 
            RowBox[{"\[LeftDoubleBracket]", 
             RowBox[{"n", "+", "1"}], "\[RightDoubleBracket]"}]], "=", 
           RowBox[{"2", "*", 
            SubscriptBox["example2", 
             RowBox[{
             "\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}]]}]}], ",",
           "\[IndentingNewLine]", "\t\t", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", "\t     ", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"nMax", ",", 
       SubscriptBox["time", 
        RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]]}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898530423226557`*^9, 3.3898530591686554`*^9}, {
  3.39975083392921*^9, 3.3997508374136076`*^9}, {3.3997509016171436`*^9, 
  3.399750903851533*^9}, {3.3997512780883026`*^9, 3.399751281557075*^9}}],

Cell[TextData[{
 "Illustrate this function where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nMax", " ", "=", " ", "10"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"f2", "[", "10", "]"}]], "Input"],

Cell[TextData[{
 "\nThe number of doublings (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"length", " ", "of", " ", "the", " ", "list"}], "-", "1"}], 
   TraditionalForm]]],
 " ) is in the first element and the time required to create this list \
measured in seconds is in the second position.\n"
}], "Text",
 CellChangeTimes->{3.5233011913623466`*^9}],

Cell["The corresponding \"data\" list is:", "Text"],

Cell[BoxData["example2"], "Input"],

Cell[TextData[{
 "\nIllustrate the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f2", "[", "...", " ", "]"}], TraditionalForm]]],
 ", where the number of doublings is nSpeed (the approximate number of \
doublings required to use about 1 sec of time on your machine using method ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f1", "[", "...", " ", "]"}], TraditionalForm]]],
 "):"
}], "Text",
 CellChangeTimes->{3.5233011932723656`*^9}],

Cell["Illustrate this function using nSpeed steps:", "Text"],

Cell[BoxData[
 RowBox[{"f2", "[", "nSpeed", "]"}]], "Input"],

Cell[TextData[{
 "\nGenerate a list of sizes and corresponding computational times using the \
\"Efficiently modify a large list in place\" procedure:\n",
 StyleBox["Note: this evaluation may take several minutes:",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.3997522113911505`*^9, 3.3997522396257067`*^9}, 
   3.523301206112494*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"data2", "=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"speedInfo", "=", 
       RowBox[{"f2", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        SubscriptBox["speedInfo", 
         RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], 
        ",", "\"\< steps requires \>\"", ",", 
        SubscriptBox["speedInfo", 
         RowBox[{"\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], 
        ",", "\"\< sec\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      "speedInfo"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{
        RowBox[{"3", "*", "nSpeed"}], "+", "1"}], ",", 
       RowBox[{"Floor", "[", 
        RowBox[{"nSpeed", "/", "6."}], "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.3898530976646557`*^9, 3.3898531227526555`*^9}, {
   3.3898541246146555`*^9, 3.3898541269826555`*^9}, {3.389854257360656*^9, 
   3.3898542575696554`*^9}, {3.3898549758486557`*^9, 3.389854977089656*^9}, {
   3.3898552174826555`*^9, 3.3898552176826553`*^9}, {3.389870580139*^9, 
   3.389870606057*^9}, 3.389870764094*^9, 3.399752067671481*^9, 
   3.399752117031172*^9, {3.3997522689696445`*^9, 3.3997522726884184`*^9}, 
   3.39975233789196*^9}],

Cell["\<\

Next, plot the above data set of computational times:\
\>", "Text",
 CellChangeTimes->{3.5233012440028725`*^9}],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"data2", ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"PointSize", "[", ".02", "]"}]}]}], "]"}]], "Input"],

Cell["\<\

Observe that the computational time also appears to be essentially quadratic \
as a function of the resulting list size.
\
\>", "Text",
 CellChangeTimes->{3.5233012469529023`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Comparing the Efficient and Inefficient \"Modifying a Large List in Place\" \
Methods:\
\>", "Subsection"],

Cell["Next, plot the above two data sets of computational times:", "Text"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data1", ",", "data2"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Epilog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Text", "[", 
       RowBox[{"\"\<data 1           \>\"", ",", 
        RowBox[{"Last", "[", "data1", "]"}]}], "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<data 2            \>\"", ",", 
        RowBox[{"Last", "[", "data2", "]"}]}], "]"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389853162681656*^9, 3.3898531704436555`*^9}, {
   3.389871021447*^9, 3.389871033888*^9}, {3.399751432058038*^9, 
   3.3997514393237095`*^9}, 3.3997523951735773`*^9}],

Cell["\<\

Observe the efficient behavior of the dataList[...] procedure and the \
inefficient behavior of the other method.  It should be clear that \
eventually, a method with quadratic computational complexity will quickly \
overwhelm your machine.  However, you do not have to make it worse then it \
needs to be.\
\>", "Text",
 CellChangeTimes->{3.523301266393097*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 3: Building Up a List Using the Append[...] Command:", \
"Subsection"],

Cell[TextData[{
 "You might think that using one of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal functions will automatically overcome the quadratic \
computational time penalty.  However, you should realize that every function, \
both external and internal, will be evaluated by the same Evaluation \
Procedure.  \nConsider the following simple example of creating a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nMax", "+", "1"}], TraditionalForm]]],
 " elements long of the form:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"example3", "=", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "2", ",", "4", ",", "8", ",", "16", ",", "32", ",", "...", ",", 
      SuperscriptBox["2", "nMax"]}], "}"}]}], TraditionalForm]]],
 ".\n\t\nThis will be accomplished by using the Append[...] command to build \
up this list one element at a time by successively doubling the last element \
in the list and appending the result to the list (thereby creating a new list \
one element longer):\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Do", " ", "..."}], "  ", "n"}], "=", "1"}], ",", "nMax"}], 
   TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"example3", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"example3", ",", 
      RowBox[{"2", "*", 
       SubscriptBox["example3", 
        RowBox[{"\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}]]}]}], 
     "]"}]}], TraditionalForm]]],
 "\n\t"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f3", "[", "nMax_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"example3", "=", 
      RowBox[{"{", "1", "}"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"time", "=", 
      RowBox[{"Timing", "[", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t\t", 
        RowBox[{
         RowBox[{"example3", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"example3", ",", 
            RowBox[{"2", "*", 
             SubscriptBox["example3", 
              RowBox[{
              "\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}]]}]}], 
           "]"}]}], ",", "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", "\t\t      ", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"nMax", ",", 
       SubscriptBox["time", 
        RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]]}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898532451026554`*^9, 3.3898532489956555`*^9}}],

Cell[TextData[{
 "Illustrate this function where the number of doublings is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nMax", " ", "=", " ", "10"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"f3", "[", "10", "]"}]], "Input"],

Cell[TextData[{
 "\nThe number of doublings (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"length", " ", "of", " ", "the", " ", "list"}], "-", "1"}], 
   TraditionalForm]]],
 " ) is in the first element and the time required to create this list \
measured in seconds is in the second position.\nThe corresponding list \
created is:"
}], "Text",
 CellChangeTimes->{3.523301308123514*^9}],

Cell[BoxData["example3"], "Input"],

Cell[TextData[{
 "\nIllustrate the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f3", "[", "...", " ", "]"}], TraditionalForm]]],
 ", where the number of doublings is nSpeed (the approximate number of \
doublings required to use about 1 sec of time on your machine using method ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f1", "[", "...", " ", "]"}], TraditionalForm]]],
 "):"
}], "Text",
 CellChangeTimes->{3.5233013209536424`*^9}],

Cell[TextData[StyleBox["Note: this evaluation may take several minutes:",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{3.399752427470659*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "timeData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"timeData", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0.", ",", "0."}], "}"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nn", "=", "0"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"While", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"nn", "=", 
       RowBox[{"nn", "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f3Steps", "=", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         SuperscriptBox["1.5", "nn"], "*", "1000"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"timeData", ",", " ", 
        RowBox[{"f3", "[", "f3Steps", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"f3Time", "=", 
         SubscriptBox[
          RowBox[{"Last", "[", "timeData", "]"}], 
          RowBox[{"\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]]}], 
        ")"}], "<", "1"}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "f3Steps", ",", "\"\< steps requires \>\"", ",", "f3Time", ",", 
       "\"\< sec\>\""}], "]"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{
    "f3Steps", ",", "\"\< steps requires \>\"", ",", "f3Time", ",", 
     "\"\< sec\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Number of steps required for about 1 sec is \>\"", ",", 
   RowBox[{"nSpeed", "=", 
    RowBox[{"Ceiling", "[", 
     RowBox[{"n", "/.", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Fit", "[", 
           RowBox[{"timeData", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", "n", ",", 
              SuperscriptBox["n", "2"]}], "}"}], ",", " ", "n"}], "]"}], 
          "]"}], "\[Equal]", "1"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", 
          SubscriptBox[
           RowBox[{"Last", "[", "timeData", "]"}], 
           RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]]}], 
         "}"}]}], "]"}]}], "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.3898532719756556`*^9, 3.389853345945656*^9}}],

Cell[BoxData[
 RowBox[{"f3", "[", "nSpeed", "]"}]], "Input"],

Cell[TextData[{
 "\nGenerate lists of increasing sizes and corresponding times using the \
Append[...] command:\n",
 StyleBox["Note: this evaluation may take several minutes on a slow machine:",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{3.5233013450938835`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"data3", "=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"speedInfo", "=", 
       RowBox[{"f3", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        SubscriptBox["speedInfo", 
         RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], 
        ",", "\"\< steps requires \>\"", ",", 
        SubscriptBox["speedInfo", 
         RowBox[{"\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], 
        ",", "\"\< sec\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      "speedInfo"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{
        RowBox[{"1.5", "*", "nSpeed"}], "+", "1"}], ",", 
       RowBox[{"Floor", "[", 
        RowBox[{"nSpeed", "/", "10."}], "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.389853365018656*^9, 3.3898533974086556`*^9}, {
   3.3898702038120003`*^9, 3.389870211413*^9}, 3.389871139711*^9}],

Cell["\<\

Next, plot the above data set of computational times:\
\>", "Text",
 CellChangeTimes->{3.5233013714641476`*^9}],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"data3", ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"PointSize", "[", ".02", "]"}]}]}], "]"}]], "Input"],

Cell["\<\

Observe that the computational time appears to be essentially quadratic as a \
function of the resulting list size.  In order to better understand the \
computational complexity of the above method, fit a quadratic function to the \
data set.

The quadratic fit to the time data corresponding to the \"Append[...] command \
method\" is:\
\>", "Text",
 CellChangeTimes->{3.5233013732041645`*^9}],

Cell[BoxData[
 RowBox[{"Fit", "[", 
  RowBox[{"data3", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "n", ",", 
     RowBox[{"n", "^", "2"}]}], "}"}], ",", "n"}], "]"}]], "Input"],

Cell[TextData[{
 "\nObserve the ",
 StyleBox["positive",
  FontVariations->{"Underline"->True}],
 " coefficient of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "2"], TraditionalForm]]],
 ", supporting the observation that the method has quadratic computational \
complexity."
}], "Text",
 CellChangeTimes->{3.523301389434327*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Example 4: Creating a List Using Individual Functional Assignments:\
\>", "Subsection"],

Cell[TextData[{
 "One possible method (out of many possible methods) of eliminating both the \
repeated re-writing and the repeated re-evaluation of ",
 StyleBox["each",
  FontVariations->{"Underline"->True}],
 " intermediate list generated using the Append[...] command follows.  The \
idea is to assign each individual intermediate result to a unique symbol \
(i.e. the length (i.e. width) will always be 1).  This procedure saves time \
because evaluating this single element will consume only a fixed amount of \
time for each step.  Therefore, this procedure produces a method with \
computational complexity which is linear rather than quadratic.  \
Implementation is accomplished by constructing a function to temporarily \
store each intermediate result.  The argument of this function corresponds to \
the index within the list being generated.  After ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " elements to be contained within the list have been generated, then \
construct the final list from this function ",
 StyleBox["only once",
  FontVariations->{"Underline"->True}],
 ".\n\nGenerate the same type of list as before:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"example4", "=", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "2", ",", "4", ",", "8", ",", "16", ",", "32", ",", "...", ",", 
      SuperscriptBox["2", "nMax"]}], "}"}]}], TraditionalForm]]],
 "\n\nAchieve this by assigning the individual elements to the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"tempList", "[", "...", "]"}], TraditionalForm]]],
 ":\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"tempList", "[", "1", "]"}], "=", "1"}], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Do", "  ", "..."}], "   ", "n"}], "=", "1"}], ",", "nMax"}], 
   TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"tempList", "[", 
      RowBox[{"n", "+", "1"}], "]"}], "=", 
     RowBox[{"2", "*", 
      RowBox[{"tempList", "[", "n", "]"}]}]}], " ", ",", "  "}], 
   TraditionalForm]]],
 "\n\t\nthen construct the final list: ",
 Cell[BoxData[
  FormBox["example4", TraditionalForm]]],
 " only once from these functional values using the Table[...] command."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f4", "[", "nMax_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", "tempList", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"time", "=", 
      RowBox[{"Timing", "[", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{
         RowBox[{"tempList", "[", "1", "]"}], "=", "1"}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
         RowBox[{
          RowBox[{
           RowBox[{"tempList", "[", 
            RowBox[{"n", "+", "1"}], "]"}], "=", 
           RowBox[{"2", "*", 
            RowBox[{"tempList", "[", "n", "]"}]}]}], ",", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\t", 
        RowBox[{"example4", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"tempList", "[", "n", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"nMax", "+", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"nMax", ",", 
       SubscriptBox["time", 
        RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]]}], 
      "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.389853473950656*^9, 3.3898534781756554`*^9}}],

Cell[TextData[{
 "Illustrate this function where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nMax", " ", "=", " ", "10"}], TraditionalForm]]],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"f4", "[", "10", "]"}]], "Input"],

Cell[TextData[{
 "\nThe number of doublings (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"length", " ", "of", " ", "the", " ", "list"}], "-", "1"}], 
   TraditionalForm]]],
 " ) is in the first element and the time required to create this list \
measured in seconds is in the second position.\nThe assignments made to the \
function: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"tempList", "[", "n", "]"}], TraditionalForm]]],
 " are:"
}], "Text",
 CellChangeTimes->{3.5233014539949727`*^9}],

Cell[BoxData[
 RowBox[{"Information", "[", "tempList", "]"}]], "Input"],

Cell["\<\

The generated list corresponding to these values  is:\
\>", "Text",
 CellChangeTimes->{3.5233014649850826`*^9}],

Cell[BoxData["example4"], "Input"],

Cell["\<\

Illustrate this function where the number of doublings is nSpeed:\
\>", "Text",
 CellChangeTimes->{3.523301474775181*^9}],

Cell[BoxData[
 RowBox[{"f4", "[", "nSpeed", "]"}]], "Input"],

Cell[TextData[{
 "\nIllustrate the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f4", "[", "...", " ", "]"}], TraditionalForm]]],
 ", where the number of doublings is nSpeed (the approximate number of \
doublings required to use about 1 sec of time on your machine using method ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f1", "[", "...", " ", "]"}], TraditionalForm]]],
 "):"
}], "Text",
 CellChangeTimes->{3.523301484845281*^9}],

Cell[TextData[StyleBox["Note: this evaluation will take several seconds:",
 FontColor->RGBColor[1, 0, 0]]], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"data4", "=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"speedInfo", "=", 
       RowBox[{"f4", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        SubscriptBox["speedInfo", 
         RowBox[{"\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]], 
        ",", "\"\< steps requires \>\"", ",", 
        SubscriptBox["speedInfo", 
         RowBox[{"\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], 
        ",", "\"\< sec\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      "speedInfo"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{
        RowBox[{"3", "*", "nSpeed"}], "+", "1"}], ",", 
       RowBox[{"Floor", "[", 
        RowBox[{"nSpeed", "/", "10."}], "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.3898535009726553`*^9, 3.3898535230666556`*^9}, {
   3.3898697990030003`*^9, 3.389869799358*^9}, 3.389869882613*^9}],

Cell["\<\

Next, plot the above data set of computational times:\
\>", "Text",
 CellChangeTimes->{{3.5233015049554825`*^9, 3.523301509015523*^9}}],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"data4", ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"PointSize", "[", ".02", "]"}]}]}], "]"}]], "Input"],

Cell["\<\

Observe that the computational time appears to be essentially linear as a \
function of the resulting list size.
\
\>", "Text",
 CellChangeTimes->{3.523301510635539*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Comparing the Two Methods from Example 3 and Example 4:", "Subsection"],

Cell["Next, plot the above two data sets of computational times:", "Text"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data3", ",", "data4"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Epilog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Text", "[", 
       RowBox[{"\"\<data 3           \>\"", ",", 
        RowBox[{"Last", "[", "data3", "]"}]}], "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<data 4       \>\"", ",", 
        RowBox[{"Last", "[", "data4", "]"}]}], "]"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3898535516996555`*^9, 3.3898535592886553`*^9}, {
   3.389870959506*^9, 3.3898709806540003`*^9}, {3.399751649981308*^9, 
   3.3997516610595036`*^9}, 3.3997525324713306`*^9}],

Cell["\<\

Observe the linear behavior of the \"functional definition method\" and the \
quadratic behavior of the \"Append[...] method\".  It should be clear that \
eventually, a method with quadratic computational complexity will quickly \
overwhelm your machine.\
\>", "Text",
 CellChangeTimes->{3.5233015330357633`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Comparing All Four Methods:", "Subsection"],

Cell["Next, plot the above four data sets of computational times:", "Text"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data1", ",", "data2", ",", "data3", ",", "data4"}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Epilog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Text", "[", 
       RowBox[{"\"\<data 1          \>\"", ",", 
        RowBox[{"Last", "[", "data1", "]"}]}], "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<data 2          \>\"", ",", 
        RowBox[{"Last", "[", "data2", "]"}]}], "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<data 3          \>\"", ",", 
        RowBox[{"Last", "[", "data3", "]"}]}], "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<data 4       \>\"", ",", 
        RowBox[{"Last", "[", "data4", "]"}]}], "]"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389853574391656*^9, 3.3898535873296556`*^9}, {
  3.389855327393656*^9, 3.3898555503836555`*^9}, {3.3997516375437284`*^9, 
  3.3997516424187593`*^9}}],

Cell["\<\

Observe that the three quadratic methods have larger computational times and \
the linear method has a lower computational time. The fastest method \
corresponds to holding expressions from evaluation and keeping the length \
(i.e. width) to be always 1.  
Other computational considerations include the utilization of computer \
memory.  However, this issue will not be discussed here.\
\>", "Text",
 CellChangeTimes->{3.523301550195935*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["General Recommendation:", "Subsection"],

Cell[TextData[{
 "You can easily zero in on the inefficient part of your program by judicious \
use of  Timing[...] (useful for determining the interval of time utilized in \
evaluating a specific expression within an individual Cell) and TimeUsed[...] \
(useful for determining the time consumed from one Cell to a later Cell).\n\n\
Also, as a general rule: \n\t",
 StyleBox["NEVER decompose a structure and work on its individual elements.  ",
  FontWeight->"Bold"],
 "\nFor example, if your structure is a list 100,000 elements wide, then any \
operation on a single element of the list automatically involves the other \
100,000 elements as well (even if their values are not changing).  This is a \
direct consequence of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Standard Evaluation Procedure.  Examples include the Append[...] and \
Prepend[...] commands as well as modification of a list in place.  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is a list based language and therefore you should always attempt to modify \
the full contents of your list in a single step rather than modifying a \
single element at a time.  However, if you must work one element at a time, \
then make sure that your data structure is either held from evaluation or is \
only one element wide.  For example, the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"tempList", "[", "n", "]"}], ",", " ", 
    RowBox[{"n", "=", "1"}], ",", "...", ",", "n", " "}], TraditionalForm]]],
 " developed above is only one element wide for each value of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ".\nYou might ask: How do I know how \"wide\" a structure is?  The answer is \
simple.  Just look at the FullForm[...] of the expression.  The \"width\" of \
a structure is just the ",
 StyleBox["number of arguments",
  FontVariations->{"Underline"->True}],
 " in its functional representation.  For example:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "...", ",", "x100000"}], "}"}], 
    "//", "FullForm"}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"List", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "...", ",", "x100000"}], "]"}], 
   TraditionalForm]]],
 "\nis 100,000 elements wide.  \nHowever, the function:\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"tempList", "[", "n", "]"}], "//", "FullForm"}], 
   TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"tempList", "[", "n", "]"}],
    ShowSpecialCharacters->False,
    ShowStringCharacters->True,
    NumberMarks->True], TraditionalForm]]],
 "\nis only 1 element wide for each index \"n\".\n"
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Additional Computational Speed Considerations:", "Subsection"],

Cell[TextData[{
 "Starting with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 4.0, the computational speed is exceptionally good ",
 StyleBox["as long as you avoid several common pitfalls",
  FontVariations->{"Underline"->True}],
 ".  In general, the claim is made that implementing a procedure within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will produce a computational time penalty of at most 50% when compared \
with a stand-alone compiled program written in Fortran or C++ (as long as the \
same algorithm is used for both procedures).  Also, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal computational algorithms are almost always more efficient than \
those which ",
 StyleBox["you",
  FontVariations->{"Underline"->True}],
 " might typically write in Fortran or C++, thereby often eliminating any \
computational speed advantage of these lower-level languages.  Finally, \
program development time is usually the most significant consideration in the \
cost of developing programs for any purpose other than commercial sales.  The \
program development time in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is almost always ",
 StyleBox["significantly",
  FontVariations->{"Underline"->True}],
 " shorter when compared to the development time in Fortran or C++.\n\nThe \
above remarks assume that you avoid some common programming pitfalls.  It is \
often the case that just a ",
 StyleBox["single",
  FontVariations->{"Underline"->True}],
 " highly-inefficient programming command can destroy the overall efficiency \
of your program.  It is sad that these inefficient procedures go unrecognized \
which ultimately gives ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " a poor reputation as a computational language.  \nThere are a number of \
examples where truly massive computation has been performed using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", including parallel processing.  However, your program must be structured \
to be computationally efficient in order to achieve these results.\nAn \
excellent reference for programming in general and computational efficiency \
specifically is:\n\tPower Programming with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " (The Kernel)\n\tMcGraw-Hill 1996\n\tby David B. Wagner\n\t\nContained \
within this book are some rules of thumb to help insure computational speed:\n\
\tRule 1: Use built-in functions\n\tRule 2: Program functionally\n\tRule 3: \
Use machine-precision arithmetic\n\tRule 4: Explicitly evaluate when possible\
\n\tRule 5: Compile when possible\n\tRule 6: Avoid Append[...] and \
Prepend[...]\n\tRule 7: Do not modify large lists in place\n\tRule 8: Beware \
of inefficient patterns\n\tRule 9: Use #, &-style pure functions\nalong with \
recommendations on how to over come each of these programming pitfalls."
}], "Text",
 CellChangeTimes->{{3.389871318527*^9, 3.389871318966*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Exercises:", "Title"],
 "  Advanced Lesson 13 "
}], "Section"],

Cell["\<\
Your Name:

Your Math Class:\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold"],

Cell[TextData[{
 "1: Use the Trace command to analyze the intermediate steps in the following \
commands:\n",
 StyleBox["\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], "  ", 
    FormBox[
     SuperscriptBox[
      RowBox[{"x", " "}], "2"],
     TraditionalForm]}], TraditionalForm]],
  FontWeight->"Bold"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], "2"]}]],
  FontWeight->"Bold"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "1"}], ")"}], "2"]}]],
  FontWeight->"Bold"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "+", 
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["E", "x"]}], ")"}], 
    RowBox[{"\[DifferentialD]", "x"}], " "}]}]],
  FontWeight->"Bold"],
 StyleBox["\n\t",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], " ", 
   RowBox[{"(", 
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "2"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], ")"}]}]],
  FontWeight->"Bold"],
 StyleBox["\t",
  FontWeight->"Bold"]
}], "Text"],

Cell["\<\
2: Use the Trace command to analyze the intermediate steps in the following \
commands:
Part 1:
\tClear[a,b]
\tTrace[ Sin[a] /. a \[Rule]b]
Part 2:
\tClear[a,b]
\tb=5
\tTrace[ Sin[a] /. a \[Rule]b]
Part 3:
\tClear[a,b]
\ta=2
\tb=5
\tTrace[ Sin[a] /. a \[Rule]b]
Part 4:
\tClear[a,b]
\tTrace[ Sin[a] /. a \[RuleDelayed]b]
Part 5:
\tClear[a,b]
\tb=5
\tTrace[ Sin[a] /. a \[RuleDelayed]b]
Part 6:
\tClear[a,b]
\ta=2
\tb=5
\tTrace[ Sin[a] /. a \[RuleDelayed]b]\t 
Observe that the lhs of a \[RuleDelayed]b is not held, however replacing \
\"a\" in both the expression Sin[a] and the lhs of the delayed replacement \
rule has no effect upon the final answer.\
\>", "Text"],

Cell[TextData[{
 "3: Construct a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "...", ",", "xn"}], "]"}], 
   TraditionalForm]]],
 " which will accept a ",
 StyleBox["Sequence",
  FontVariations->{"Underline"->True}],
 " of expressions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x1", ",", "x2", ",", "x3", ",", "...", ",", "xn"}], 
   TraditionalForm]]],
 " (i.e. not a list) and display a ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of a list of both the unevaluated and evaluated form of each element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"xi", ",", " ", 
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], TraditionalForm]]],
 " .\n\n\tTest your function:\n\t\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", " ", 
     RowBox[{
      RowBox[{"N", "[", "\[Pi]", "]"}], ",", 
      RowBox[{"1", "+", "2"}], ",", 
      RowBox[{"a", "*", 
       SuperscriptBox["a", "2"]}], ",", 
      RowBox[{"a", "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], ")"}]}]}], " ", "]"}], " "}], 
   TraditionalForm]]],
 "\n\t\t\n\t\t",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"N", "[", "\[Pi]", "]"}],
       HoldForm], ",", "3.141592653589793`"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"1", "+", "2"}],
       HoldForm], ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"a", " ", 
        SuperscriptBox["a", "2"]}],
       HoldForm], ",", 
      SuperscriptBox["a", "3"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       RowBox[{"a", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "a"}], ")"}]}],
       HoldForm], ",", 
      RowBox[{"a", " ", 
       RowBox[{"(", 
