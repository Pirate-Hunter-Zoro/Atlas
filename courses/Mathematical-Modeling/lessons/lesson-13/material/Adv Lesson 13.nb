Cell[CellGroupData[{

Cell["Example 1B:  Non-Standard Evaluation Procedure", "Subsection"],

Cell[TextData[{
 "Consider the evaluation procedure for the ",
 StyleBox["same",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " function (which ",
 StyleBox["does",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " hold its first argument):\n\t\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{"x1", "=", "1"}], ";"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"x2", "=", "2"}], ";"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"x3", "=", "3"}], ";"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "z_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"x2", "=", "z"}], ")"}]}], ";"}], 
