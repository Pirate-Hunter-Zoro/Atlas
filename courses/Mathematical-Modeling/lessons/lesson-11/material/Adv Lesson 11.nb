(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \n",
 "Advanced Lesson 11\n\nPattern Matching\n\nDr. Dale R. Doty\nUniversity of \
Tulsa"
}], "Title"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Matching One Element  \"a_\":", "Subtitle"]], \
"Section"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly"],

Cell["\<\
The notation used to match a single (arbitrary) expression is:   \"_\"
The notation used to assign a local name \"a\" to the pattern match \"_\" is: \
 \"a_\"\
\>", "Text",
 CellChangeTimes->{{3.3898306698856554`*^9, 3.3898306929966555`*^9}}],

Cell[CellGroupData[{

Cell["Example: Function Definition", "Subsection"],

Cell[TextData[{
 "First, define a function ",
 StyleBox["without pattern matching",
  FontVariations->{"Underline"->True}],
 "   \"_\"  (but use delayed assignment):"
}], "Text",
 CellChangeTimes->{{3.3898298103166556`*^9, 3.3898298380016556`*^9}, 
   3.3898300314356556`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", "x", "]"}], ":=", 
  RowBox[{"Sin", "[", "x", "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"?", "g"}]], "Input"],

Cell[BoxData[
 RowBox[{"g", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"g", "[", "y", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"g", "[", "a", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"g", "[", "3", "]"}]], "Input"],

Cell[TextData[{
 "\nObserve that the ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " pattern that matches the symbol \"x\" is ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " the symbol \"x\".\n\nNext, define the same function using pattern matching \
 \"_\".  The \"x_\" will match any arbitrary single symbol \"_\" and assign \
it the local name \"x\" so that the name \"x\" can be used on the rhs of the \
assignment."
}], "Text",
 CellChangeTimes->{{3.3898307507456555`*^9, 3.3898308574336557`*^9}, {
   3.389830888188656*^9, 3.389830892707656*^9}, 3.523276563330575*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"Sin", "[", "x", "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "y", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "3", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "\"\<Anything\>\"", "]"}]], "Input"],

Cell["\<\

More complicated pattern matching can be built up from these single elements:\
\>", "Text",
 CellChangeTimes->{3.523276583520777*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Example: Replacement Rules", "Subsection"],

Cell["Next, consider some replacement rules.", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "+", "b", "+", "c", "+", "d"}], " ", "/.", 
  RowBox[{
   RowBox[{"x_", "+", "y_"}], "\[Rule]", 
   RowBox[{"x", "*", "y"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"TreeForm", " ", "[", 
   RowBox[{"a", " ", "+", "b", "+", "c", "+", "d"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"TreeForm", " ", "[", 
   RowBox[{"a", " ", 
    RowBox[{"(", 
     RowBox[{"b", "+", "c", "+", "d"}], ")"}]}], "]"}]}]], "Input"],

Cell[TextData[{
 "\nNote that after the first replacement, Plus has moved from the top level \
to a lower level.  Therefore, subsequent possible pattern matches have been \
moved to a lower level. ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " only continues the search for a pattern match on the part of the \
expression that has not changed to a lower level.  In this case, all of the \
remaining Plus expression has been has been moved to a lower level.  \n\
However, you can request that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ",
 StyleBox["repeat",
  FontVariations->{"Underline"->True}],
 " the pattern matching after each substitution until no match at any level \
can be been found."
}], "Text",
 CellChangeTimes->{{3.3898359506256557`*^9, 3.3898359827816553`*^9}, {
   3.3898360740576553`*^9, 3.3898362096206555`*^9}, 3.523276607901021*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "+", "b", "+", "c", "+", "d"}], " ", "//.", 
  RowBox[{
   RowBox[{"x_", "+", "y_"}], "\[Rule]", 
   RowBox[{"x", "*", "y"}]}]}]], "Input"],

Cell["\<\

Observe the following:\
\>", "Text",
 CellChangeTimes->{{3.3898309826706553`*^9, 3.3898309883996553`*^9}, 
   3.523276644111383*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "+", "b", "+", "c", "+", "d"}], " ", "/.", 
  RowBox[{
   RowBox[{"x_", "+", "x_"}], "\[Rule]", 
   RowBox[{"x", "*", "x"}]}]}]], "Input"],

Cell[TextData[{
 "\nNote that there was no pattern match to: symbol_ + symbol_  (",
 StyleBox["same",
  FontVariations->{"Underline"->True}],
 " symbol in both cases)."
}], "Text",
 CellChangeTimes->{3.5232766504414463`*^9}],

Cell[TextData[{
 "Next, switch the elements ",
 StyleBox["inside",
  FontVariations->{"Underline"->True}],
 " an ordered pair in a list of ordered pairs:"
}], "Text",
 CellChangeTimes->{{3.3898310292196555`*^9, 3.3898310768316555`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "6"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"7", ",", "8"}], "}"}]}], "}"}], "/.", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"y", ",", "x"}], "}"}]}]}]], "Input"],

Cell["However, observe the following:", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4"}], "}"}]}], "}"}], "/.", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"y", ",", "x"}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "\nObserve that it was the ordered pairs that were switched, ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " the coordinates within the ordered pairs.  Study the above two examples \
closely until you understand how the pattern match was made in each case.\n\
The above example allows two distinctly different possibilities for matching \
a pattern, each of which matches the pattern: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], TraditionalForm]]],
 ".  Thus, a more ",
 StyleBox["detailed",
  FontVariations->{"Underline"->True}],
 " pattern must be specified so that multiple possibilities of this type are \
eliminated.  \nConsider a pattern which is a list of elements:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a___", ",", "   ", "...", "   ", ",", "b___"}], "}"}], 
   TraditionalForm]]],
 "  which contains a pattern for an ordered pair: ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{"...", " ", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}]}], " ", "..."}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389831117509656*^9, 3.389831118393656*^9}, {
   3.389831202832656*^9, 3.389831244681656*^9}, {3.3898312881126556`*^9, 
   3.3898313166756554`*^9}, {3.3898362947446556`*^9, 3.3898363100616555`*^9}, 
   3.5232766678716207`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4"}], "}"}]}], "}"}], "/.", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a___", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}], ",", "b___"}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"a", ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "x"}], "}"}], ",", "b"}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "\nObserve that only the first ordered pair was switched.  However, if we \
were to use repeated replacement here, the new ",
 StyleBox["pattern",
  FontVariations->{"Underline"->True}],
 " would be ",
 StyleBox["exactly",
  FontVariations->{"Underline"->True}],
 " the same as the old pattern (that was already replaced), thereby setting \
up a recursive replacement that would ",
 StyleBox["never",
  FontVariations->{"Underline"->True}],
 " stop.  Other procedures would be required to fix this problem."
}], "Text",
 CellChangeTimes->{{3.3898363822636557`*^9, 3.3898365108816557`*^9}, 
   3.5232767024919667`*^9}],

Cell["\<\
As a further example, consider replacing the head of a function \"Sin\" and \
its argument \"x\" with pattern matching:\
\>", "Text",
 CellChangeTimes->{{3.3898313993056555`*^9, 3.389831421452656*^9}, {
  3.3898365304166555`*^9, 3.3898365460176554`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sin", "[", "x", "]"}], "/.", 
  RowBox[{
   RowBox[{"f_", "[", "y_", "]"}], "\[Rule]", 
   RowBox[{"Tan", "[", 
    RowBox[{"2", "\[Pi]", " ", "y"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.3898314264626555`*^9, 3.389831430860656*^9}}],

Cell["\<\

Consider trigonometric substitution (i.e. rule replacement).\
\>", "Text",
 CellChangeTimes->{3.523276716352105*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox[
    RowBox[{"x", " "}], "2"], "+", " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "x", "]"}], "2"], " ", "+", " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", "x", "]"}], "2"], " ", "+", 
   SuperscriptBox["y", "2"]}], " ", "/.", 
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"Sin", "[", "a_", "]"}], "2"], " ", "+", " ", 
    SuperscriptBox[
     RowBox[{"Cos", "[", "a_", "]"}], "2"]}], " ", "\[Rule]", 
   "1"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"Cos", "[", "x", "]"}], "2"], " ", "+", 
    SuperscriptBox[
     RowBox[{"x", " "}], "2"], "+", " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "x", "]"}], "2"], " ", "+", 
    SuperscriptBox["y", "2"]}], " ", "/.", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"Sin", "[", "a_", "]"}], "2"], " ", "+", " ", 
     SuperscriptBox[
      RowBox[{"Cos", "[", "a_", "]"}], "2"]}], " ", "\[Rule]", 
    "1"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"Head", "[", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"x", " "}], "2"], "+", " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "x", "]"}], "2"], " ", "+", " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", "x", "]"}], "2"], " ", "+", 
   SuperscriptBox["y", "2"]}], " ", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Attributes", " ", "[", "Plus", "]"}]}]], "Input"],

Cell["\<\
Orderless is an attribute that can be assigned to a symbol f to indicate that \
the elements ei in expressions of the form f[e1, e2, ... ] should \
automatically be sorted into canonical order. This property is accounted for \
in pattern matching.\
\>", "Item",
 CellChangeTimes->{{3.3900435711364*^9, 3.3900435741854*^9}},
 FontWeight->"Bold"],

Cell[TextData[{
 "Thus, the reason ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " was able to match this pattern (even though algebraic rearrangement was \
required before a pattern match could be made) was because Plus has attribute \
Orderless.  A function with attribute Orderless first arranges the arguments \
into canonical order, then attempts to match a pattern.  \nConsider the \
following canonical forms  (which explains the pattern match in the above \
cases):"
}], "Text",
 CellChangeTimes->{{3.3898365818696556`*^9, 3.3898366495316553`*^9}}],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"x", " "}], "2"], "+", " ", 
  SuperscriptBox[
   RowBox[{"Sin", "[", "x", "]"}], "2"], " ", "+", " ", 
  SuperscriptBox[
   RowBox[{"Cos", "[", "x", "]"}], "2"], " ", "+", 
  SuperscriptBox["y", "2"]}]], "Input"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"Cos", "[", "x", "]"}], "2"], " ", "+", 
  SuperscriptBox[
   RowBox[{"x", " "}], "2"], "+", " ", 
  SuperscriptBox[
   RowBox[{"Sin", "[", "x", "]"}], "2"], " ", "+", 
  SuperscriptBox["y", "2"]}]], "Input"],

Cell["\<\

Next, consider some simple replacements. In what follows, the symbol \"a\" is \
missing the pattern \"_\":\
\>", "Text",
 CellChangeTimes->{{3.389836709523656*^9, 3.3898367429306555`*^9}, {
   3.389836815773656*^9, 3.3898368223296556`*^9}, 3.5232767449123907`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a", "+", "b"}], ")"}], "*", "c"}], "  ", "/.", " ", 
  RowBox[{
   RowBox[{"a", "*", "c"}], "\[Rule]", "\"\< something new\>\""}]}]], "Input"],

Cell["\<\

No pattern match was achieved.  Why?\
\>", "Text",
 CellChangeTimes->{3.5232767603025446`*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"TreeForm", " ", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "+", "b"}], ")"}], "*", "c"}], " ", "]"}]}]], "Input"],

Cell["\<\

Add the pattern \"_\" to get the proper pattern \"a_\":\
\>", "Text",
 CellChangeTimes->{{3.3898367732966557`*^9, 3.3898368330666556`*^9}, 
   3.5232767632425747`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a", "+", "b"}], ")"}], "*", "c"}], "  ", "/.", " ", 
  RowBox[{
   RowBox[{"a_", "*", "c"}], "\[Rule]", "\"\<something new\>\""}]}]], "Input"],

Cell["\<\

Consider some more examples:\
\>", "Text",
 CellChangeTimes->{3.5232767677726192`*^9}],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"x", " "}], "2"], "+", " ", 
  SuperscriptBox[
   RowBox[{"Sin", "[", "x", "]"}], "2"], " ", "+", " ", 
  SuperscriptBox[
   RowBox[{"Cos", "[", "x", "]"}], "2"], " ", "+", 
  SuperscriptBox["y", "2"]}]], "Input"],

Cell["\<\

Observe the new order above:
Apply the replacement rule once:\
\>", "Text",
 CellChangeTimes->{3.5232767715226574`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox[
    RowBox[{"x", " "}], "2"], "+", " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "x", "]"}], "2"], " ", "+", " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", "x", "]"}], "2"], " ", "+", 
   SuperscriptBox["y", "2"]}], " ", "/.", 
  RowBox[{
   RowBox[{
    SuperscriptBox["a_", "2"], " ", "+", " ", 
    SuperscriptBox["b_", "2"]}], " ", "\[Rule]", "1"}]}]], "Input"],

Cell["\<\

Apply the replacement rule repeatedly:\
\>", "Text",
 CellChangeTimes->{3.5232767741926837`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox[
    RowBox[{"x", " "}], "2"], "+", " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "x", "]"}], "2"], " ", "+", " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", "x", "]"}], "2"], " ", "+", 
   SuperscriptBox["y", "2"]}], " ", "//.", 
  RowBox[{
   RowBox[{
    SuperscriptBox["a_", "2"], " ", "+", " ", 
    SuperscriptBox["b_", "2"]}], " ", "\[Rule]", "1"}]}]], "Input"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Matching One Or More Elements \"a_ _\":", \
"Subtitle"]], "Section",
 CellChangeTimes->{
  3.389836879181656*^9, {3.389836917575656*^9, 3.3898369272256556`*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
  "f", ",", "g", ",", "x", ",", "y", ",", "a", ",", "b", ",", "c", ",", "d"}],
   "]"}]], "InputOnly"],

Cell[TextData[{
 "Whereas  \"_\"  will match any single expression,  \"",
 Cell[BoxData[
  FormBox["__", TraditionalForm]]],
 "\"   (i.e. two \"_\")  will match any sequence of ",
 StyleBox["one or more",
  FontVariations->{"Underline"->True}],
 " expressions.\nTherefore  ",
 Cell[BoxData[
  FormBox["a__", TraditionalForm]]],
 "  (i.e. two \"_\") will assign the local name \"a\" to any sequence of ",
 StyleBox["one or more",
  FontVariations->{"Underline"->True}],
 " expressions.\n\nConsider the following examples:"
}], "Text",
 CellChangeTimes->{3.3898369099826555`*^9, 3.3898369484496555`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], " ", "/.", " ", 
  RowBox[{
   RowBox[{"{", "x__", "}"}], " ", "\[Rule]", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<something new\>\"", ",", 
     RowBox[{"f", "[", "x", "]"}]}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "Carefully observe that the pattern  \"",
 Cell[BoxData[
  FormBox["__", TraditionalForm]]],
 "\"  matched the complete sequence:  a,b,c,d  of four objects."
}], "Text",
 CellChangeTimes->{3.3898370042936554`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "b", ",", "c"}], "}"}], " ", "/.", " ", 
  RowBox[{
   RowBox[{"{", "x__", "}"}], " ", "\[Rule]", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<something new\>\"", ",", 
     RowBox[{"f", "[", "x", "]"}]}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "Carefully observe that the pattern  \"",
 Cell[BoxData[
  FormBox["__", TraditionalForm]]],
 "\"  matched the complete sequence:  a,b,c  of three objects."
}], "Text",
 CellChangeTimes->{3.3898370273956556`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "b"}], "}"}], " ", "/.", " ", 
  RowBox[{
   RowBox[{"{", "x__", "}"}], " ", "\[Rule]", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<something new\>\"", ",", 
     RowBox[{"f", "[", "x", "]"}]}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "Carefully observe that the pattern  \"",
 Cell[BoxData[
  FormBox["__", TraditionalForm]]],
 "\"  matched the complete sequence:  a,b  of two objects."
}], "Text",
 CellChangeTimes->{3.3898370406316557`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", "a", "}"}], " ", "/.", " ", 
  RowBox[{
   RowBox[{"{", "x__", "}"}], " ", "\[Rule]", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<something new\>\"", ",", 
     RowBox[{"f", "[", "x", "]"}]}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "Carefully observe that the pattern  \"",
 Cell[BoxData[
  FormBox["__", TraditionalForm]]],
 "\"  matched the complete sequence:   a   of one object."
}], "Text",
 CellChangeTimes->{3.3898370568896556`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", "}"}], " ", "/.", " ", 
  RowBox[{
   RowBox[{"{", "x__", "}"}], " ", "\[Rule]", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<something new\>\"", ",", 
     RowBox[{"f", "[", "x", "]"}]}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "Carefully observe that the pattern  \"",
 Cell[BoxData[
  FormBox["__", TraditionalForm]]],
 "\"  did ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " match the sequence:  \"  \"  of no objects."
}], "Text",
 CellChangeTimes->{3.3898370744166555`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Matching Zero Or More Elements  \"a_ _ _\":", \
"Subtitle"]], "Section",
 CellChangeTimes->{{3.3898370832716556`*^9, 3.389837085577656*^9}}],

Cell[TextData[{
 "Whereas  \"",
 Cell[BoxData[
  FormBox["__", TraditionalForm]]],
 "\"  will match any sequence of one or more expressions,  \"",
 Cell[BoxData[
  FormBox["___", TraditionalForm]]],
 "\"   (i.e. three \"_\")  will match any sequence of ",
 StyleBox["zero or more",
  FontVariations->{"Underline"->True}],
 " expressions.\nTherefore  ",
 Cell[BoxData[
  FormBox["a___", TraditionalForm]]],
 "  (i.e. three \"_\") will assign the local name \"a\" to any sequence of ",
 StyleBox["zero or more",
  FontVariations->{"Underline"->True}],
 " expressions.\n\nConsider the following examples:"
}], "Text",
 CellChangeTimes->{{3.389837097320656*^9, 3.3898371141256557`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "b", ",", "c"}], "}"}], " ", "/.", " ", 
  RowBox[{
   RowBox[{"{", "x___", "}"}], " ", "\[Rule]", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<something new\>\"", ",", 
     RowBox[{"f", "[", "x", "]"}]}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "\nCarefully observe that the pattern  \"",
 Cell[BoxData[
  FormBox["___", TraditionalForm]]],
 "\"  matched the complete sequence:  a,b,c  of three objects."
}], "Text",
 CellChangeTimes->{3.3898371278566556`*^9, 3.523276929084233*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "b"}], "}"}], " ", "/.", " ", 
  RowBox[{
   RowBox[{"{", "x___", "}"}], " ", "\[Rule]", " ", 
