    RowBox[{"x", ",", 
     RowBox[{"{", "\"\<something new\>\"", "}"}], ",", "z"}], 
    "}"}]}]}]], "Input"],

Cell["\<\

Then use repeated replacement.  \
\>", "Text",
 CellChangeTimes->{3.5232769457743998`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4"}], "}"}], ",", 
