    "}"}]}]}]], "Input"],

Cell["\<\

Next, try only one replacement:\
\>", "Text",
 CellChangeTimes->{3.5232769401543436`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
