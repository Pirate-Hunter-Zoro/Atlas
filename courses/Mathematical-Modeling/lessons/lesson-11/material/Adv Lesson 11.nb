    RowBox[{"\"\<something new\>\"", ",", 
     RowBox[{"f", "[", "x", "]"}]}], "}"}]}]}]], "Input"],

Cell[TextData[{
 "\nCarefully observe that the pattern  \"",
 Cell[BoxData[
  FormBox["___", TraditionalForm]]],
 "\"  matched the complete sequence:  a,b  of two objects."
}], "Text",
 CellChangeTimes->{3.3898371349466553`*^9, 3.5232769302842445`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", "a", "}"}], " ", "/.", " ", 
