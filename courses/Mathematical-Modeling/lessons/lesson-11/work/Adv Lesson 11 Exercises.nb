    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}]}], "}"}]], "Input",Expr\
essionUUID->"ec06a338-4241-410c-bc19-bee985c4782f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f3", "[", 
    RowBox[{"1", ",", "2"}], "]"}], ",", 
   RowBox[{"f4", "[", 
    RowBox[{"1", ",", "2", ",", "3"}], "]"}]}], "}"}]], "Input",ExpressionUUID\
->"bb047da1-ce72-4182-bfbd-602acc17dc20"],

Cell["\<\
f3 takes exactly three arguments and f4 exactly four. Given the right number \
they return the list of their arguments; given the wrong number nothing \
matches and they stay unevaluated.\
\>", "Text",ExpressionUUID->"f00e545b-4aef-478f-b1f5-1d804ffd4f51"],

Cell[TextData[{
 "7: Write a delayed assignment function of exactly ONE argument followed by \
ZERO or more arguments which will square the first argument times the Sine of \
the LIST of the second arguments.\n\tEvaluate:   ? f\n\tEvaluate:   f[ ]\n\t\
Evaluate:   f[x]\t  \[DoubleLongRightArrow]  { },  How did ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " calculate this value?\n\tEvaluate:   f[ {1,2} ]\t  Why did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to calculate this value?\n\tEvaluate:   f[ x,y ]\t\t  \
\[DoubleLongRightArrow] ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["x", "2"], " ", 
     RowBox[{"Sin", "[", "y", "]"}]}], "}"}],
   FontWeight->"Bold"]],ExpressionUUID->
  "3ce49a45-4982-4a09-b148-e20fa4dcf1cd"],
 "\n\tEvaluate:   f[ 2,3,4,5 ]\t  \[DoubleLongRightArrow]  {4 Sin[3],4 \
Sin[4],4 Sin[5]}\n\tEvaluate:   f[ x, y, z, w ]\n\tEvaluate:   f[ x, {1,2,3}, \
A, B ]\tLook at this result in:  ColumnForm,  \n\t\t\t\t\t\tHow did ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " calculate this value?\n\tEvaluate:   f[ \"string\", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {"1", "2"},
      {"3", "4"}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "fd6068e6-adae-4606-89f9-5f012b19cacd"],
 " ]"
}], "Text",ExpressionUUID->"3a1d1749-9b5b-4755-bb2e-224d8df8b0e0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "x", ",", "y", ",", "z", ",", "w", ",", "A", ",", "B"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y___"}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox["x", "2"], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"{", "y", "}"}], "]"}]}]}]}], "Input",ExpressionUUID->"0fc65241-\
c2ff-49a5-b324-4d6e33cbe7cf"],

