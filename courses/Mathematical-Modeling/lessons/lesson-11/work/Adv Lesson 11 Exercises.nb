Cell["9: A derivative table by pattern matching", "Section",ExpressionUUID->"58291a68-fb62-45bd-a6c1-e68cfade407f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"Sin", "[", "x_", "]"}], "]"}], ":=", 
   RowBox[{"Cos", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"Cos", "[", "x_", "]"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"Sin", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"Log", "[", "x_", "]"}], "]"}], ":=", 
   FractionBox["1", "x"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   SuperscriptBox["\[ExponentialE]", "x_"], "]"}], ":=", 
  SuperscriptBox["\[ExponentialE]", "x"]}]}], "Input",ExpressionUUID->\
"d0b28fb3-b800-4312-b70e-71cf011ab12e"],

