 RowBox[{"f", "[", 
  RowBox[{"x", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "A", ",", "B"}], 
  "]"}]], "Input",ExpressionUUID->"962385ac-ccb4-479a-8c18-b052a4060a40"],

