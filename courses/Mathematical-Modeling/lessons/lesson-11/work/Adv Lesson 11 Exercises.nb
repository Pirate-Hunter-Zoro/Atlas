   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", "+", "y"}], ")"}], "3"], "]"}]],
  FontWeight->"Bold",ExpressionUUID->"880afd15-d2c3-4680-b283-01c1c8588430"],
 "\n\tEvaluate:    ",
