    RowBox[{"2", "+", "y"}], ")"}], "3"], "//.", "\[VeryThinSpace]", 
  RowBox[{"{", 
   RowBox[{"rule1", ",", "rule2"}], "}"}]}]], "Input",ExpressionUUID->\
"592521a5-ca92-45df-a352-c9c0d81cb862"],

Cell["\<\
With /. Mathematica works from the outside in and does not re-scan what it \
has just replaced. The cube rule matches the whole expression first, so the 2 \
buried inside is never visited and rule1 is missed. //. keeps re-applying the \
rules until nothing changes, so the 2 is caught on a later pass and the \
answer becomes (222 + y)^333.\
\>", "Text",ExpressionUUID->"f0dedfcc-5b95-4c55-8fc8-b877fef9057f"],

Cell[TextData[{
 "17: The following example illustrates some of the power of pattern matching \
and replacement rules.  As you already know, every operation in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has an internal functional representation.  \n\nFor example, generate the \
plot of ",
 Cell[BoxData[
  StyleBox[
   SuperscriptBox["x", "2"],
   FontWeight->"Bold"]],ExpressionUUID->
  "7efeb2c3-1a9d-402e-a4fb-a2ff3308235f"],
 " and assign the output to:  plot1.\n\n\tEvaluate:   ",
 Cell[BoxData[
  RowBox[{"plot1", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     SuperscriptBox["x", "2"], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}]],
  FontWeight->"Bold",ExpressionUUID->"b26711b3-9e98-42e8-b7af-bf96a718c64a"],
 "\n\n  To display the internal functional representation:\n  \n\tEvaluate:   \
? plot1\n\n Observe that the contents of plot1 is something like:  \n \n   \
plot1 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", " ", "}"}], ",", 
       RowBox[{"{", " ", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Hue", "[", 
          RowBox[{"0.67`", ",", "0.6`", ",", "0.6`"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "2.040816326530612`*^-8", ",", "4.1649312786339017`*^-16"}], 
             "}"}], ","}]}]}]}]}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "d7b190ff-7bdd-4af7-b76e-5c80d815aff6"],
 " .........\n \nalong with a list of replacement rules for graphic options.  \
The first part consists of the Line command, which just connects a sequence \
of line segments through a list of coordinates  {{x1,y1}, {x2,y2},  ...  }.  \
\n\n Our objective is to replace the line segments with a list of points \
using pattern matching and replacement rules.  To accomplish this, we need to \
understand the pattern in the Line command as well as the Point command.  The \
patterns are as follows:\n \n \tThe pattern we have:   Line [{{x1,y1}, \
{x2,y2},  ...  }]\n \tThe pattern we want:  {Point [{x1,y1}], Point \
[{x2,y2}],  ...  }\n \t \n Thus, we want to use pattern matching and \
replacement rules to replace:\n \n \t Line [{  ...  , {x,y},  ...  }]\n \t \n \
with:\n \n  \t {  ...  , Point [{x,y}],  ...  }\n  \t \n This can be \
accomplished in two steps.  Replace the content in plot1 by creating a \
replacement rule from:   \n \t\n \tLine [{  ...  , {x,y},  ...  }]  \[Rule]  \
Line [{  ...  , Point [{x,y}],  ...  }]\n \t\t\n to get an intermediate step \
(call it plot2).  plot2 will NOT be a proper plot, so it can not be \
displayed.  The graphic display can be suppressed by ending with a \";\".  \
Then to see the content of plot2:\n \n \tEvaluate:   ? plot2\n \t\nThen \
replace the content in plot2 by creating a replacement rule from:   \n \t\n \t\
Line [{  ...  , Point [{x,y}],  ...  }] \[Rule]  {  ...  , Point [{x,y}],  \
...  }\n \t\t\n to get our final graphic commands (call it plot3).  Then to \
see the content of plot3:\n \n \tEvaluate:   ? plot3\n \t\n plot3 will be a \
proper plot, so it can be displayed.\n \n\tEvaluate:   plot3 \n\t\nYou should \
conclude that EVERY ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " expression, no matter what its form, can be manipulated in this way."
}], "Text",
 CellChangeTimes->{{3.39047221126*^9, 3.390472267766*^9}, 3.390473108457*^9, {
   3.390473186025*^9, 
   3.3904734621689997`*^9}},ExpressionUUID->"2cacd9e1-8027-4e9a-933c-\
0bc0622c5577"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"x", ",", "plot1", ",", "plot2", ",", "plot3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"plot1", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    SuperscriptBox["x", "2"], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], "Input",Expression\
UUID->"b1ae49bb-397d-4b62-b70f-d57ff030bf1c"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Cases", "[", 
   RowBox[{"plot1", ",", "_Line", ",", "\[Infinity]"}], "]"}], "]"}]], "Input",\
ExpressionUUID->"abd340bb-a1ae-4ad2-8cc5-c09e5c06c106"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plot2", "=", 
   RowBox[{"plot1", "/.", "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"Line", "[", 
      RowBox[{"{", "pts__", "}"}], "]"}], "\[RuleDelayed]", 
     RowBox[{"Line", "[", 
      RowBox[{"Point", "/@", 
       RowBox[{"{", "pts", "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", 
  RowBox[{"Cases", "[", 
   RowBox[{"plot2", ",", "_Point", ",", "\[Infinity]"}], "]"}], 
  "]"}]}], "Input",ExpressionUUID->"fe63d186-0fad-4ce8-965e-58bedbfd135d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plot3", "=", 
   RowBox[{"plot2", "/.", "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"Line", "[", 
      RowBox[{"{", "pts__Point", "}"}], "]"}], "\[RuleDelayed]", 
     RowBox[{"{", "pts", "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Head", "[", "plot3", "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"plot3", ",", "_Line", ",", "\[Infinity]"}], "]"}], "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"plot3", ",", "_Point", ",", "\[Infinity]"}], "]"}], "]"}]}], 
  "}"}]}], "Input",ExpressionUUID->"b989f83d-523a-414c-a420-953df77e037f"],

Cell[BoxData["plot3"], "Input",ExpressionUUID->"f4481f16-60ca-49bf-827a-dafcd88287ad"]
},
WindowSize->{1100, 850},
FrontEndVersion->"15.0 for Linux x86 (64-bit) (May 26, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"53e1aa67-6381-4be0-aec1-2e1147a12ddd"
]
