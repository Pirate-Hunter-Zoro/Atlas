Cell["\<\
x___ means zero or more arguments, so f[ ] now matches. The argument list is \
empty, and the empty list squared is still the empty list, so the answer is { \
}.\
\>", "Text",ExpressionUUID->"6a6bfbae-0ddf-4777-9e0f-8a63704bbe35"],

Cell[TextData[{
 "5: Write a delayed assignment function of exactly TWO arguments which will \
square the first argument times the Sine of the second argument.\n\tEvaluate: \
  ? f\n\tEvaluate:   f[ ]\n\tEvaluate:   f[x]\n\tEvaluate:   f[ {1,2} ]\n\t\
Evaluate:   f[ {1,2,3} ]\n\tEvaluate:   f[ 1,2,3,4 ]\n\tEvaluate:   f[ x,y ]\t\
\t\t",
 StyleBox["\[DoubleLongRightArrow]  ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["x", "2"], " ", 
   RowBox[{"Sin", "[", "y", "]"}]}]],
  FontWeight->"Bold",ExpressionUUID->"1d87311c-a84f-4b8c-a7dd-d65c91fa02d3"],
 "\n\tEvaluate:   f[ x, {1,2,3} ]\n\tEvaluate:   f[ \"string\", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {"1", "2"},
      {"3", "4"}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "2ffcef47-21c8-46a9-aad9-216d621a7944"],
 " ]\n Explain why the first five evaluations did not work."
}], "Text",ExpressionUUID->"84b046dc-d6c0-4413-ab25-bd4d46d1b111"],

