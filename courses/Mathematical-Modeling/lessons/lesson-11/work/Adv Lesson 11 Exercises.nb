Cell["\<\
In {1, 2, 3, 2+2} the 2+2 was added up to 4 before the rule was ever applied, \
so by then there was no 2 left in that position to replace. Wrapping it as \
Hold[2+2] stops the addition, and then both 2s are replaced.\
\>", "Text",ExpressionUUID->"a301297c-2ebf-466c-9205-50f379847365"],

Cell[TextData[{
 "15: Write an immediate replacement rule which pattern matches ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", "x_", ")"}], "3"], TraditionalForm]],ExpressionUUID->
  "b7179047-292b-49b3-88a8-35b2d4c62078"],
 " and replaces it with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "333"], TraditionalForm]],ExpressionUUID->
  "8a0d881b-acbb-4967-b197-d7fd294481d2"],
 " and assign this rule to: rule2.  Apply this replacement rule to the \
following expressions:\n\tEvaluate:   ? rule2\t\t\t\[DoubleLongRightArrow]   \
rule2 =  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", "x_", ")"}], "3"], TraditionalForm]],ExpressionUUID->
  "873e102c-f1ec-4f59-9129-f98aa3db28df"],
 " \[Rule] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "333"], TraditionalForm]],ExpressionUUID->
  "67b079c7-898d-4ae8-b8fa-7ea58942bb93"],
 "\n\tEvaluate:   ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      SuperscriptBox["x", "2"], ",", " ", 
      SuperscriptBox["x", "3"], ",", " ", 
      SuperscriptBox["x", "4"], ",", " ", 
      SuperscriptBox["y", "3"], ",", " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "x", "]"}], "3"], ",", " ", 
      FractionBox["1", 
       RowBox[{"2", "+", 
        SuperscriptBox["z", "3"]}]], " ", ",", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "y"}], ")"}], "3"]}], "}"}], "/.", "  ", 
    "rule2"}]}]],
  FontWeight->"Bold",ExpressionUUID->"ee79a089-d2ec-4e98-b294-6a6935d98fcc"],
 "\n\tEvaluate:   ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", 
       RowBox[{"2", "+", "y"}]], ")"}], "3"], "/.", "  ", "rule2"}],
   FontWeight->"Bold"]],ExpressionUUID->
  "47c25f6c-20f8-47cc-8e8e-69ee8434e228"],
 "\t Why was the last replacement missed?\n\tLook at the following to answer \
the above question:\n\tEvaluate:    ",
 Cell[BoxData[
  RowBox[{"FullForm", "[", 
   SuperscriptBox["x", "3"], "]"}]],
  FontWeight->"Bold",ExpressionUUID->"09d68520-8117-4233-85dc-ac04518583e5"],
 "\n\tEvaluate:    ",
 Cell[BoxData[
