 RowBox[{"f", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4"}], "}"}]}], "}"}], "]"}]], "Input",ExpressionUUID->\
"da0bf22e-2c75-410f-aa8f-0f8f3997303c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}]}], "}"}]], "Input",Expr\
essionUUID->"ca691a92-42d6-41dc-8b5f-b84b1b464572"],

Cell["\<\
f[x_] takes exactly one argument. f[ ], f[x, y] and f[1,2,3,4] supply the \
wrong number, so no definition matches and they come back unevaluated.\
\>", "Text",ExpressionUUID->"2d2dc8f2-450c-4609-8769-dda5692b6ebf"],

Cell[TextData[{
 "2: Write a delayed assignment function of EXACTLY ZERO arguments which will \
take on the value 3.\n\tEvaluate:   ? f\n\tEvaluate:   f[ ]\t\t\t",
 StyleBox["\[DoubleLongRightArrow] 3",
  FontWeight->"Bold"],
 "\n\tEvaluate:   f[2]\n\tEvaluate:   f[x]\n\tEvaluate:   f[ x,y ]\n\t\
Evaluate:   f[ 1,2,3,4 ]\n\tEvaluate:   f[ ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {"1", "2"},
      {"3", "4"}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "821a1fd7-bc8e-42c5-a655-12b6bed60c81"],
 " ]\n Explain what is different about the last five evaluations."
}], "Text",ExpressionUUID->"4edbce31-ac76-473a-a12c-a86e89de4d4e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "]"}], ":=", "3"}]}], "Input",ExpressionUUID->"127c3d85-\
5fa2-4d96-9e16-e595c1af2d70"],

