Cell["\<\
The pattern asks for a list that contains a list. f[1, 2, {4,5}, 6] fails \
because it passes four separate arguments rather than one list. f[{1,2,3,4}] \
fails because nothing inside it is a list. f[{1, 2, { }, 3, 4}] does match in \
this version, because the empty list is still a list, so the answer is the \
empty list.\
\>", "Text",ExpressionUUID->"2db8f0b7-7db1-4de8-b1e1-e9bd64334817"],

Cell[TextData[{
 "14: Calculate the FullForm[...] of each expression ",
 StyleBox["inside",
  FontVariations->{"Underline"->True}],
 " the quotation marks:\n\t\"_\"           \[DoubleLongRightArrow]  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Blank", "[", "]"}], TraditionalForm]],ExpressionUUID->
  "f5727c7a-ebf1-4ed6-b7bc-5591df22a96b"],
 "\n\t\"x_\"\n\t\"x__\"\n\t\"x___\"\t\n\t\"x_Integer\"\n\t\"x_?EvenQ\"\n\t\
\"x_?(# > 3&)\"\n\t\"x_Integer?EvenQ\"\nCreate a function which will return \
the character string \"Positive Integer\" when its argument is a positive \
integer and have the function remain unevaluated under all other \
circumstances.  Your function should use pattern matching similar to the last \
entry given above:\n  \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x_.", ".."}], "?"}], "..."}], "]"}], ":=", " "}], 
   TraditionalForm]],ExpressionUUID->"8ca2d2f5-6d61-41dc-9d3f-71c85e3611e0"],
 "\"Positive Integer\"\nEvaluate:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "3", "]"}], TraditionalForm]],ExpressionUUID->
  "7c4cf69b-914a-4869-b7d0-439f26339c71"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "3.45", "]"}], TraditionalForm]],ExpressionUUID->
  "0474a27f-9935-4faa-b278-ae6494723038"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"-", "3"}], "]"}], " "}], TraditionalForm]],ExpressionUUID->
  "5fa9017c-dfe6-4bb7-98a7-75245cd0ed42"]
}], "Text",ExpressionUUID->"7b06eaed-f81d-46c2-977b-7daa70a79600"],

Cell[" Pattern matching in replacement rules:", "Section",ExpressionUUID->"a7a17dd4-af26-45ae-86a8-4431bb9ce98d"],

Cell["\<\
When you are instructed to construct an immediate replacement rule you will \
write:   lhs \[Rule] rhs
When you are instructed to construct a delayed replacement rule you will \
write:   lhs \[RuleDelayed] rhs
When you are instructed to apply the replacement rule to an expression you \
will write: 
\t  expression(   ...   lhs  ...  )      /.     lhs \[Rule] rhs 
which will yield:
\t  expression(   ...  rhs  ...  )\
\>", "Text",ExpressionUUID->"82d713e9-ff38-48f9-840c-463faeda6e5a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"List", "@@", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"u", ",", 
      RowBox[{"ToString", "[", 
       RowBox[{"FullForm", "[", "u", "]"}], "]"}]}], "]"}], "/@", 
    RowBox[{"Hold", "[", 
     RowBox[{"_", ",", "x_", ",", "x__", ",", "x___", ",", "x_Integer", ",", 
      RowBox[{"x_", "?", "EvenQ"}], ",", 
      RowBox[{"x_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#1", ">", "3"}], "&"}], ")"}]}], ",", 
      RowBox[{"x_Integer", "?", "EvenQ"}]}], "]"}]}]}], "]"}]}], "Input",Expre\
ssionUUID->"db7d3fce-19ff-4b6a-ad0a-5151396b0b78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]", 
