  RowBox[{" ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      SuperscriptBox["x", "2"], ",", " ", 
      SuperscriptBox["x", "3"], ",", " ", 
      SuperscriptBox["x", "4"], ",", " ", 
      SuperscriptBox["y", "3"], ",", " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "x", "]"}], "3"], ",", " ", 
      FractionBox["1", 
       RowBox[{"2", "+", 
        SuperscriptBox["z", "3"]}]], " ", ",", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", "y"}], ")"}], "3"]}], "}"}], "/.", 
    RowBox[{"{", 
