    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", 
       RowBox[{"2", "+", "y"}]], ")"}], "3"], "]"}], "/.", "  ", "rule2"}]],
  FontWeight->"Bold",ExpressionUUID->"172faa25-11a9-4e18-ac01-fda4cfb4b7d8"],
 "\n\tEvaluate:    ",
 Cell[BoxData[
