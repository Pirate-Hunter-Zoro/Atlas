ssionUUID->"2437a00a-9cc5-49d1-9966-a3e3958b40b4"],

Cell["\<\
f[ ] is defined for exactly zero arguments, so it gives 3. The other five all \
supply at least one argument, match nothing, and stay unevaluated.\
\>", "Text",ExpressionUUID->"7a999653-ec0f-4bcf-8689-f1c142853518"],

Cell[TextData[{
 "3: Write a delayed assignment function of ONE OR MORE arguments which will \
square the LIST of arguments.\n\tDoes the square (i.e. Power) have attribute \
Listable?  What does this mean?\n\tEvaluate:   ? f\n\tEvaluate:   f[2]\n\t\
Evaluate:   f[x]\n\tEvaluate:   f[y]\t\t\t",
 StyleBox["\[DoubleLongRightArrow]  ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"{", 
   SuperscriptBox["y", "2"], "}"}]],
  FontWeight->"Bold",ExpressionUUID->"49229695-f755-4295-965a-b5161db7da1b"],
 StyleBox["  ",
  FontWeight->"Bold"],
 "\n\tEvaluate:   f[\"string\"]\n\tEvaluate:   f[ {1,2,3} ]\t\t\t",
 StyleBox["\[DoubleLongRightArrow] ",
  FontWeight->"Bold"],
 "{{1,4,9}}\n\tEvaluate:   f[ ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {"1", "2"},
      {"3", "4"}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "dd54aad8-123f-4c46-9af8-403be860806c"],
 " ]\n\tEvaluate:   f[ x,y ]\n\tEvaluate:   f[ 1,2,3,4 ]\n\tEvaluate:   f[ x, \
{1,2,3} ]\t\t",
 StyleBox["\[DoubleLongRightArrow] ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SuperscriptBox["x", "2"], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "9"}], "}"}]}], "}"}]],
  FontWeight->"Bold",ExpressionUUID->"d53781c5-f10d-4769-8af7-76e13652b631"],
 "\n\tEvaluate:   f[ x, {1,2,3}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NegativeThinSpace]", GridBox[{
      {"1", "2"},
      {"3", "4"}
     }], "\[NegativeThinSpace]", ")"}], TraditionalForm]],ExpressionUUID->
  "3368998b-2373-497e-87d6-2cdbbd8c5737"],
 " ]\n\tEvaluate:   f[ ]\n Explain what is different about the last \
evaluation."
}], "Text",ExpressionUUID->"4195275f-632f-41a6-8244-4a02281a8ba1"],

