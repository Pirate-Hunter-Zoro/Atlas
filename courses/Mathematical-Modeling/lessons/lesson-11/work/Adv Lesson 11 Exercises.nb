     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "]"}]], "Input",ExpressionUUI\
D->"eb505cd4-ee75-4bfd-886f-e26c893f6f97"],

Cell["\<\
f[x] supplies no later arguments, so the second group is empty, Sin of the \
empty list is the empty list, and the answer is { }. f[{1,2}] has an empty \
second group for the same reason, but this time the first argument is a \
two-element list, and Mathematica cannot multiply a two-element list by an \
empty one, so it reports a length mismatch and stops. The pattern matched \
perfectly well; it is the arithmetic that failed. f[x, {1,2,3}, A, B] shows \
the grouping clearly: everything after the first argument is collected into \
one list and Sin spreads over it.\
\>", "Text",ExpressionUUID->"18cff8d2-63b0-4d22-9d88-1871b18c6989"],

Cell[TextData[{
 "8: Write a delayed assignment function of the Sine of exactly one argument \
which will square the argument which appears inside the Sine function.\n\t\
Evaluate:   ? f\n\tEvaluate:   f[ Sin[2] ]\t\t  \[DoubleLongRightArrow] 4\n\t\
Evaluate:   f[ Sin[y] ]\n\tEvaluate:   f[ Sin[ {1,2,3} ] ]\t  Why did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?\n\tEvaluate:   f[ Sin[ Log[x] ] ]\n\tEvaluate:  \
 f[x]\n\tEvaluate:   f[ Cos[y] ]\n\tEvaluate:   f[ 1,2,3,4 ]\n Explain what \
is different about the last three evaluations."
}], "Text",ExpressionUUID->"fa2f7422-cc7d-47e7-b877-4fcecf03e80e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"Sin", "[", "x_", "]"}], "]"}], ":=", 
  SuperscriptBox["x", "2"]}]}], "Input",ExpressionUUID->"d77a3593-e081-45ca-\
847e-ba5667ce81e6"],

Cell["?f", "Input",ExpressionUUID->"19d320ca-ae8b-4154-9c54-d03febab2195"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"Sin", "[", "2", "]"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"Sin", "[", "y", "]"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"Sin", "[", 
     RowBox[{"Log", "[", "x", "]"}], "]"}], "]"}]}], "}"}]], "Input",Expressio\
nUUID->"05147c01-1f11-4336-b459-e4aa0a5b6d88"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"Sin", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], "]"}]], "Input",Expressio\
nUUID->"f12d344a-4f72-4d17-8350-b32d1c2976cb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"Cos", "[", "y", "]"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}]}], "}"}]], "Input",Expr\
essionUUID->"0942f0e8-74ee-41b1-be42-ccd4ebcc133a"],

Cell["\<\
The pattern is f[Sin[x_]], so the argument must literally be a sine of one \
thing. f[Sin[{1,2,3}]] fails because Sin is Listable and spreads over the \
list before f ever sees it, so the argument that arrives is {Sin[1], Sin[2], \
Sin[3]}, a list and not a sine. f[x] and f[Cos[y]] are not sines either, and \
f[1,2,3,4] has four arguments.\
\>", "Text",ExpressionUUID->"66fc8056-19b4-4f70-99cc-d3a43d995a27"],

Cell[TextData[{
 "9: Write a delayed assignment function which will have several different \
assignments.  Specifically,  f[ function[ x_ ] ] :=  derivative[ x ] for \
different functions (\"f\" will be defined using multiple assignments.  Also, \
\"f\" will ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " use the chain rule correctly, i.e. f[ Sin[2x] ]\t\[DoubleLongRightArrow] \
Cos[ 2x ]   ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 "  2 Cos[ 2x ]).  \"f\" should use pattern matching to accept as arguments \
the functions:   Sin[x], Cos[x], Log[x], ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", "x"], TraditionalForm]],ExpressionUUID->
  "bc356faf-011b-4a97-af70-d8e3b311b17d"],
 "   and return the corresponding  \"derivative\" functions.\n\tEvaluate:   ? \
f\n\tEvaluate:   f[ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", "x"], TraditionalForm]],ExpressionUUID->
  "8fd98e13-e465-47ba-bdde-dd2d956a9fb0"],
 " ]\n\tEvaluate:   f[ Sin[y] ]\t\t\[DoubleLongRightArrow] Cos[ y ]\n\t\
Evaluate:   f[ Cos[x + y] ]\n\tEvaluate:   f[ Sin[2] ]\t\t\
\[DoubleLongRightArrow] Cos[ 2 ]\n\tEvaluate:   f[ Sin[ Log[x] ] ]\n\t\
Evaluate:   f[ Sin[ {1,2,3} ] ]\t  Why did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?"
}], "Text",ExpressionUUID->"ae1cfbf7-da50-4868-ad86-bc5ea136d0dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"Sin", "[", "x_", "]"}], "]"}], ":=", 
   RowBox[{"Cos", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"Cos", "[", "x_", "]"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"Sin", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"Log", "[", "x_", "]"}], "]"}], ":=", 
   FractionBox["1", "x"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   SuperscriptBox["\[ExponentialE]", "x_"], "]"}], ":=", 
  SuperscriptBox["\[ExponentialE]", "x"]}]}], "Input",ExpressionUUID->\
"d0b28fb3-b800-4312-b70e-71cf011ab12e"],

Cell["?f", "Input",ExpressionUUID->"9962a6c5-16bf-4091-8d91-09c283b59cc4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    SuperscriptBox["\[ExponentialE]", "x"], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"Sin", "[", "y", "]"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"Cos", "[", 
     RowBox[{"x", "+", "y"}], "]"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"Sin", "[", "2", "]"}], "]"}]}], "}"}]], "Input",ExpressionUUID->\
"823dffb8-cc15-4e98-b824-ed1c1ee092cc"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"Sin", "[", 
   RowBox[{"Log", "[", "x", "]"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"8d064101-4a99-4427-afa1-7cbefa7bff14"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"Sin", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], "]"}]], "Input",Expressio\
nUUID->"203ca8d3-d668-431e-8849-2e3e69936b43"],

Cell["\<\
Each rule matches one named function and returns its derivative. \
f[Sin[Log[x]]] gives Cos[Log[x]]: the rule matches the outer sine and ignores \
what is inside, which is exactly why there is no chain rule here. \
f[Sin[{1,2,3}]] fails for the earlier reason, that Sin spreads over the list \
first and leaves no sine to match.\
\>", "Text",ExpressionUUID->"7d54ccd6-bde6-47a6-a975-f56dc78e7ef5"],

Cell[TextData[{
 "10:  Odd functions have the property that:  f( -x )  \
\[DoubleLongRightArrow]  -f( x ).  Write a delayed assignment function which \
uses pattern matching which will make this assignment.  (Note that this is a \
recursive assignment.)\n\tEvaluate:   ? f\n\tEvaluate:   f[ -x ]\n\tEvaluate: \
  f[ -y ]\t\t\[DoubleLongRightArrow] - f[ y ]\n\tEvaluate:   f[ -Sin[y] ]\n\t\
Evaluate:   f[ -5 ]\tWhy did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?  \n\t\t\t\tHint: look at FullForm[ -5 ]  and  \
FullForm[ -x ]"
}], "Text",ExpressionUUID->"ab739c2a-51cc-4b52-a759-90a9c6c805b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"-", "x_"}], "]"}], ":=", 
  RowBox[{"-", 
   RowBox[{"f", "[", "x", "]"}]}]}]}], "Input",ExpressionUUID->"b6fb9598-466c-\
40de-b757-0a05f166f0c5"],

Cell["?f", "Input",ExpressionUUID->"81965da0-9a5e-44a4-91fb-e24dea581b48"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"-", "x"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"-", "y"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"-", 
     RowBox[{"Sin", "[", "y", "]"}]}], "]"}]}], "}"}]], "Input",ExpressionUUID\
->"2f7ad5ad-8b76-4e54-961b-1bf5e5e74129"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"-", "5"}], "]"}]], "Input",ExpressionUUID->"f30035a8-340f-4bfc-a3b2-31d04aa2eeb4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullForm", "[", 
    RowBox[{"-", "5"}], "]"}], ",", 
   RowBox[{"FullForm", "[", 
    RowBox[{"-", "x"}], "]"}]}], "}"}]], "Input",ExpressionUUID->"7fff38ee-\
1323-48ed-bb0b-1f85dddf473f"],

Cell["\<\
f[-x] works because -x is stored as Times[-1, x], which fits the pattern -x_. \
f[-5] fails because -5 is stored as the single number -5, not as Times[-1, \
5], so there is no product there for the pattern to match. FullForm shows the \
difference plainly.\
\>", "Text",ExpressionUUID->"00139213-acfb-4785-b606-0f1be95eb3dd"],

Cell["\<\
11:  How would you add a new assignment to the function \"f\" in Problem 10 \
so that the function \"f\" with two assignments would also accept the \
pattern:   f( -5 )  \[DoubleLongRightArrow]  -f( 5 ) for different negative \
numbers?  (There are several correct ways to do this.)
\tEvaluate:   ? f
\tEvaluate:   f[ -x ]\t\t\[DoubleLongRightArrow] - f[ x ]
\tEvaluate:   f[ x ]
\tEvaluate:   f[ -y ]
\tEvaluate:   f[ -Sin[y] ]
\tEvaluate:   f[ -5 ]\t\t\[DoubleLongRightArrow] - f[ 5 ]
\tEvaluate:   f[ -7 ]
\tEvaluate:   f[ 5 ]\
\>", "Text",ExpressionUUID->"5768ed1d-9e20-423f-bf46-521bd9c258e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"-", "x_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"f", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"n_", "?", "Negative"}], "]"}], ":=", 
  RowBox[{"-", 
   RowBox[{"f", "[", 
    RowBox[{"-", "n"}], "]"}]}]}]}], "Input",ExpressionUUID->"b2e3a0f5-013b-\
4aba-82be-5d1adf1a4829"],

Cell["?f", "Input",ExpressionUUID->"710240e1-4ece-4299-abf3-76f8f8623c8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"-", "x"}], "]"}], ",", 
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"-", "y"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"-", 
     RowBox[{"Sin", "[", "y", "]"}]}], "]"}]}], "}"}]], "Input",ExpressionUUID\
->"17b1a93c-201b-485d-a68e-9a1e68a2247a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"-", "5"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"-", "7"}], "]"}], ",", 
   RowBox[{"f", "[", "5", "]"}]}], "}"}]], "Input",ExpressionUUID->"e4bb99a5-\
1967-4122-917c-633c72250daa"],

Cell[TextData[{
 "12: Write a delayed assignment function using pattern matching that will \
accept as its argument a list (of 3 or more elements) which will return the \
value of the third element in the list.  \n\tEvaluate:   ? f\n\tEvaluate:   \
f[ ]\t\tWhy did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?\n\tEvaluate:   f[x]\tWhy did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?\n\tEvaluate:   f[ {1,2} ]\tWhy did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?\n\tEvaluate:   f[ {1,2,3} ] \t\
\[DoubleLongRightArrow] 3\n\tEvaluate:   f[ {1,2,3,4} ]\n\tEvaluate:   f[ \
{1,2,3,4,5} ]\n\tEvaluate:   f[ {x,y, {1,2,3}, A, B }]\t"
}], "Text",ExpressionUUID->"f6de05b6-604e-4549-8689-ea988c28f9dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"f", ",", "x", ",", "y", ",", "A", ",", "B"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"{", 
    RowBox[{"_", ",", "_", ",", "c_", ",", "___"}], "}"}], "]"}], ":=", 
  "c"}]}], "Input",ExpressionUUID->"73e08056-3671-439b-8c15-9caf09bf2f79"],

Cell["?f", "Input",ExpressionUUID->"5d8ff21b-3f22-4eff-9161-7b502b24f855"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "]"}], ",", 
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}]}], "}"}]], "Input",ExpressionUUID->\
"b7123ec9-e60e-4479-b266-d44c28de2b78"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], "]"}]}], 
  "}"}]], "Input",ExpressionUUID->"b7861eba-e82e-42f4-9c87-df4a5ce4d340"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "A", ",", "B"}], "}"}], 
  "]"}]], "Input",ExpressionUUID->"316ab702-36c0-41a6-998a-00ec9a9cb46b"],

Cell["\<\
The pattern asks for a list of at least three elements. f[ ] has no argument, \
f[x] has one that is not a list, and f[{1,2}] is a list that is too short, so \
none of the three match.\
\>", "Text",ExpressionUUID->"05f0b7d8-4b4d-430b-bfa3-a0822b690ad8"],

Cell[TextData[{
 "13: Write a delayed assignment function using pattern matching that will \
accept as its argument:\n\tA list of elements,\n\tWhich contains another list \
(of 1 or more elements)\t\n\tWhich will return the inside list of elements.  \
\n\tEvaluate:   ? f\n\tEvaluate:   f[ 1, 2, {4, 5}, 6 ]\t\tWhy did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?\n\tEvaluate:   f[ {1, 2, 3, 4} ]\t\tWhy did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?\n\tEvaluate:   f[ {1, 2, { }, 3, 4} ]\tWhy did ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "fail to match this pattern?\n\tEvaluate:   f[ {{1}, 2, 3, 4} ] \t\t\
\[DoubleLongRightArrow] {1}\n\tEvaluate:   f[ {1, 2, {3}, 4} ] \t\t\
\[DoubleLongRightArrow] {3}\n\tEvaluate:   f[ {1, {2, 3}, 4} ] \t\t\
\[DoubleLongRightArrow] {2, 3}\n\tEvaluate:   f[ {1, 2, 3, {4}} ] \t\t\
\[DoubleLongRightArrow] {4}\n\tEvaluate:   f[ {1, 2, {3, 4, 5}} ]\n\t\
Evaluate:   f[ {{1, 2, 3, 4, 5}} ]\n\tEvaluate:   f[ {1, 2, {3,{ 4, 5}}} ]\n\t\
Evaluate:   f[ {x, y, {1,2,3}, A, B }]\t"
}], "Text",ExpressionUUID->"da2a414d-e690-4ff8-8fed-2eb18210f3be"],

