   FontWeight->"Bold"]],ExpressionUUID->
  "19b3e269-c1b7-4395-a57f-e1b19a445d90"],
 "\tWhy did this work?"
}], "Text",ExpressionUUID->"f9338a70-df68-4e49-b3ab-576e409c006d"],

