Cell[TextData[{
 "\nTherefore, you MUST ALWAYS make the assignment explicitly, ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "=", "#1"}],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 ", whenever Dynamic[...] has ",
 StyleBox["TWO",
  FontColor->RGBColor[1, 0, 0]],
 " arguments:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", " ", 
    RowBox[{"x", ",", " ", 
     RowBox[{
      RowBox[{
       StyleBox["(",
        FontColor->RGBColor[1, 0, 0]], 
       RowBox[{
        StyleBox[
         RowBox[{"x", "=", "#1"}],
         FontColor->RGBColor[0, 0, 1]], 
        StyleBox[";",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         RowBox[{"Identity", "[", "#1", "]"}],
         FontColor->RGBColor[1, 0, 0]]}], 
       StyleBox[")",
        FontColor->RGBColor[1, 0, 0]]}], 
      StyleBox["&",
       FontColor->RGBColor[1, 0, 0]]}]}], " ", "]"}], TraditionalForm]]],
 "\n\n \tNow the Slider[...] both moves and updates ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 ":"
}], "Text",
