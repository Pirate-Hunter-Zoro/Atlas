Cell[TextData[{
 "\n\nIn the following example, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Locator", "[", 
    RowBox[{"Dynamic", "[", "...", "]"}], "]"}], TraditionalForm]]],
 " in graph on the left works. \n\nHowever in the right graph, Dynamic[...] \
is not close enough to symbol ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]]],
 " (that contains a List) for the graphic Locator[...] to work.\n\nThe link \
between Dynamic ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 " needed to create a change in the Dynamic ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " is broken for the plot on the right."
}], "Text",
 CellChangeTimes->{{3.389439934391*^9, 3.389439954274*^9}, 
   3.389440121652*^9, {3.389440261951*^9, 3.389440268726*^9}, {
   3.3894869955296*^9, 3.3894870017506*^9}}],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Framed", "[", "\[IndentingNewLine]", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Locator", "[", 
           RowBox[{"Dynamic", "[", "p", "]"}], "]"}], "}"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "1"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "200"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Move the graphic Locator[...]\\n\!\(\*
