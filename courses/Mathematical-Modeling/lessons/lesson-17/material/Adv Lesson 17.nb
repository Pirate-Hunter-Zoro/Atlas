Cell[TextData[{
 "However, if there are ",
 StyleBox["additional",
  FontVariations->{"Underline"->True}],
 " Dynamic expressions in the remaining arguments to be used as Dynamic \
annotations, then you will need to program Dynamic[...] explicitly.\n\nThe \
output display generated by Manipulate[...] always contains ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " areas:\n\n\tPrimary area for the Dynamic expression and\n\tControls area.\n\
\t\nBy default the Output Cell generated from Manipulate[...] has the \
controls area is displayed on top and the primary area for the Dynamic \
expression displayed on the bottom. You can, of course, change this if you \
want.\n\nFor example:\n\n\t",
 StyleBox["Manipulate[\n\t\n\tPlot[a x + b, {x, 0, 2Pi}],  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " displayed in the primary expression area",
 StyleBox["\n\t\n\t{a, 0, 2} ,       ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] continuous Slider control of ",
 StyleBox["a",
  FontSlant->"Italic"],
 " from 0 to 2 displayed in the controls area",
 StyleBox["\n\tDynamic[ ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["expr2",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ] ,  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " you want to control displayed in the controls area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] other annotation to be displayed in the controls \
area",
 StyleBox["\n\t{b, 1, 5, 1} ,   ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] discrete Slider control of ",
 StyleBox["b",
  FontSlant->"Italic"],
 " from 1 to 5 in steps of 1 displayed in the controls area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] other annotation to be displayed in the controls \
area",
 StyleBox["\n\tDynamic[ ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["expr3",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ] ,  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " you want to control displayed in the controls area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] other annotation to be displayed in the controls \
area",
 StyleBox["\n\t{u,  ...  } ,       ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] control of ",
 StyleBox["u",
  FontSlant->"Italic"],
 " displayed in the controls area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] other annotation to be displayed in the controls \
area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " you want to control displayed in the controls area",
 StyleBox["\n\t...                   ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] more controls displayed in the controls area ",
 StyleBox["\n\t ]",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\n\nhas a primary display area and many different controls and annotations \
in the controls area."
}], "Text",
 CellChangeTimes->{{3.389600685666*^9, 3.3896006894639997`*^9}, {
