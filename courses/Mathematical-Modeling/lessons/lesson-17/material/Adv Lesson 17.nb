StyleBox[\"]\",
FontColor->RGBColor[1, 0, 0]]\)\!\(\*
StyleBox[\"]\",
FontColor->RGBColor[1, 0, 0]]\) does NOT work!\\n\>\"", ",", 
             RowBox[{"Dynamic", "[", "p", "]"}]}], "}"}], "]"}]}]}], "]"}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
