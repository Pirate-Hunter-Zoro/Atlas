      "\"\<  and  xxxx[2] = \>\"", ",", 
      RowBox[{"Dynamic", "[", 
       RowBox[{"xxxx", "[", "2", "]"}], "]"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]", "}"}]}], "Input",
