Cell[CellGroupData[{

Cell[TextData[{
 "So what other Dynamic ",
 StyleBox["displays",
  FontColor->RGBColor[1, 0, 0]],
 " are REVERSIBLE?\n\nSuch ",
 StyleBox["displays",
  FontColor->RGBColor[1, 0, 0]],
 " can be edited and can establish a ",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link between ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ".\n\n",
 StyleBox["Illustration",
  FontColor->RGBColor[0.5, 0, 0.5]],
 ": Some low level ",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional commands:\n\n\tSlider[...]\t(",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link between ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ")\n\tSetterBar[...]\t(",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link between ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ")\n\tSlider2D[...]\t(",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link between ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ")\n\tLocator[...]  \t(",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link in Graphics to Graphics ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ")\n\t\t\t(Graphic Primative)\n\tLocatorPane[...](",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link in Graphics to Graphics ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ")\n\t\t\t(Intermediate Graphic)\n\tColorSlider[...]\t(",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link between ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and color ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ")\n\tActionMenu[...](",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link between ",
