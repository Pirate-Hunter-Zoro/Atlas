   3.3896555471127996`*^9, 3.3896555476678*^9}, 3.5236327947201786`*^9}],

Cell[TextData[{
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "  Dynamic Plot with 2 continuous Sliders Dynamically Manipulating values ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]]],
 ":\n\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["min", "TI"]], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["max", "TI"]]}], "}"}], 
      RowBox[{Cell[TextData[{
        "manipulator (",
        StyleBox["slider",
         FontColor->RGBColor[1, 0, 0]],
        ", animator, etc.)"
       }], "TableText"], " "}]}
    }], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["init", "TI"]]}], "}"}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "}"}], Cell[TextData[{
       "control with initial value ",
       Cell[BoxData[
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["init", "TI"]]], "InlineFormula"]
      }], "TableText"]}
    }], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["init", "TI"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["lbl", "TI"]]}], "}"}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "}"}], Cell[TextData[{
       "control with label ",
       Cell[BoxData[
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["lbl", "TI"]]], "InlineFormula"]
      }], "TableText"]}
    }], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["min", "TI"]], ",", 
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["max", "TI"]], ",", 
      StyleBox["\[Ellipsis]", "TR"], ",", 
      RowBox[{
       ButtonBox["Appearance",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Appearance"], "->", "\"\<Labeled\>\""}]}], 
     "}"}], "   ", "yields", " ", "a", " ", "slider", " ", "with", " ", 
    "value", " ", "displayed", " ", "as", " ", "a", " ", 
    RowBox[{"label", "."}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3895873807320004`*^9, 3.38958738909*^9}, {
   3.389587493933*^9, 3.389587499649*^9}, {3.3895889454230003`*^9, 
   3.389588979231*^9}, {3.3895893178859997`*^9, 3.38958932117*^9}, {
   3.3895906995*^9, 3.389590700689*^9}, {3.389590750007*^9, 
   3.3895907609049997`*^9}, {3.3895909513529997`*^9, 3.389590954752*^9}, {
   3.3895909975629997`*^9, 3.389591004492*^9}, {3.389596507811*^9, 
   3.389596516594*^9}, {3.3895965524849997`*^9, 3.3895965546610003`*^9}, {
   3.389600458373*^9, 3.3896005015550003`*^9}, 3.3896104546*^9}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"a", " ", "x"}], "+", "b"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "2", ",", "\"\<Multiplier\>\""}], "}"}], ",", "1", 
     ",", "4"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "0", ",", "\"\<Phase Parameter\>\""}], "}"}], ",", 
     "0", ",", "10", ",", 
     RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.38958721299*^9, 3.3895872244449997`*^9}, {
  3.389587255726*^9, 3.389587296488*^9}, {3.3896002427869997`*^9, 
  3.3896002515620003`*^9}, {3.389600285775*^9, 3.3896003149*^9}},
 CellID->26946],

Cell[TextData[{
 "Note that the scope of the Dynamic Manipulated values ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]]],
 " is restricted to the Manipulate[...] command:"
}], "Text",
 CellChangeTimes->{{3.3895873807320004`*^9, 3.38958738909*^9}, {
  3.389587493933*^9, 3.389587499649*^9}, {3.3895889454230003`*^9, 
  3.389588979231*^9}, {3.389589018828*^9, 3.389589093892*^9}, {
  3.389596527473*^9, 3.3895965305950003`*^9}}],

Cell[BoxData[
 RowBox[{"?", "a"}]], "Input",
 CellChangeTimes->{{3.389588829175*^9, 3.389588830058*^9}}],

Cell[BoxData[
 RowBox[{"?", "b"}]], "Input",
 CellChangeTimes->{{3.389588835617*^9, 3.389588836933*^9}}],

Cell[TextData[{
 "\n",
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "  Dynamic Formula calculation using a Dynamic discrete Slider[...] with \
step size 1.\n\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["min", "TI"]], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["max", "TI"]], ",", 
        StyleBox["du", "TI"]}], "}"}], 
      RowBox[{Cell[TextData[{
        StyleBox["discrete manipulator",
         FontColor->RGBColor[1, 0, 0]],
        " with step ",
        Cell[BoxData[
         StyleBox["du", "TI"]], "InlineFormula"]
       }], "TableText"], " "}]}
    }], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389589333701*^9, 3.389589399505*^9}, {
   3.3895896099379997`*^9, 3.389589621541*^9}, {3.3895906533310003`*^9, 
   3.389590671902*^9}, {3.389596588764*^9, 3.389596600885*^9}, 
   3.389610443358*^9}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Formula when n = \>\"", ",", "n", ",", "\"\<:\\n\>\""}], 
        "}"}], "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"nn", "=", "n"}], "}"}], ",", 
           RowBox[{"HoldForm", "[", 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"k", "=", "0"}], "m"], 
             SuperscriptBox["k", "nn"]}], "]"}]}], "]"}], ",", "\"\< = \>\"", 
         ",", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"k", "=", "0"}], "m"], 
          SuperscriptBox["k", "n"]}]}], "}"}], "]"}]}], "\[IndentingNewLine]",
      "\[IndentingNewLine]", "}"}], "//", "Column"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "30", ",", "1"}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3895875700620003`*^9, 3.3895877190629997`*^9}, {
  3.389587762141*^9, 3.3895877671*^9}, {3.3895878169230003`*^9, 
  3.389587943112*^9}, {3.389587993564*^9, 3.3895881143269997`*^9}, {
  3.38958815606*^9, 3.3895882188310003`*^9}, {3.389588278403*^9, 
