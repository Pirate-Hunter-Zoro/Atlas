Cell[TextData[{
 "\n\nIn the following example Dynamic surrounds a ",
 StyleBox["List",
  FontVariations->{"Underline"->True}],
 "\n\n\t",
 StyleBox["Dynamic[{xxx, yyy}]",
  Background->RGBColor[1, 1, 0]],
 "\n\t\nand it works:"
}], "Text",
 CellChangeTimes->{{3.3894393080220003`*^9, 3.389439330634*^9}}],

Cell[BoxData[{
 RowBox[{
