      "\[IndentingNewLine]", 
      RowBox[{"Panel", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<Type in a number between 0. and 1. in the \\nInputField[...] \
box and press the Enter key:\>\"", ",", 
           RowBox[{"InputField", "[", 
            RowBox[{"Dynamic", "[", "xx", "]"}], "]"}]}], "}"}], "//", 
         "Column"}], ",", 
        RowBox[{"FrameMargins", "\[Rule]", "5"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\\n{\!\(\*
StyleBox[\"xx\",
FontColor->RGBColor[1, 0, 0]]\),\!\(\*
StyleBox[\"yy\",
FontColor->RGBColor[1, 0, 0]]\)} = \>\"", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Dynamic", "[", 
            RowBox[{"Round", "[", 
             RowBox[{"xx", ",", ".001"}], "]"}], "]"}], ",", 
           RowBox[{"Dynamic", "[", 
            RowBox[{"Round", "[", 
             RowBox[{"yy", ",", ".001"}], "]"}], "]"}]}], "}"}]}], "}"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\\n\>\"", ",", 
         RowBox[{
          SubsuperscriptBox["\[Integral]", 
           RowBox[{"Dynamic", "[", 
            RowBox[{"Round", "[", 
             RowBox[{"xx", ",", ".001"}], "]"}], "]"}], 
           RowBox[{"Dynamic", "[", 
            RowBox[{"Round", "[", 
             RowBox[{"yy", ",", ".001"}], "]"}], "]"}]], 
          RowBox[{
           RowBox[{"\"\<Sin\>\"", "[", "t", "]"}], 
           RowBox[{"\[DifferentialD]", "t"}]}]}], ",", "\"\< = \>\"", ",", 
         RowBox[{"Dynamic", "[", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{
             SubsuperscriptBox["\[Integral]", "xx", "yy"], 
             RowBox[{
              RowBox[{"Sin", "[", "t", "]"}], 
              RowBox[{"\[DifferentialD]", "t"}]}]}], ",", ".001"}], "]"}], 
          "]"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", "2"}], "]"}], "//", "Grid"}]}], "Input",
