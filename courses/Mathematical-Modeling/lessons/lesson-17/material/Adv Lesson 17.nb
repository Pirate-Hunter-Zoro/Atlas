Cell[TextData[{
 "\n",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      ButtonBox["Dynamic",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Dynamic"], "[", 
      RowBox[{
       StyleBox["expr", "TI"], ",", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["f", "TI"], ",", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["end", "TI"]]}], "}"}]}], "]"}]], "InlineFormula"],
    "\[LineSeparator]            also evaluates ",
    Cell[BoxData[
     RowBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["end", "TI"]], "[", 
      RowBox[{
       StyleBox["val", "TI"], ",", 
       StyleBox["expr", "TI"]}], "]"}]], "InlineFormula"],
    " when interactive changing or editing is complete. "
   }]], TraditionalForm]]],
 "\n\nExample using the second argument of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", 
    RowBox[{
     StyleBox["expr", "TI"], ",", 
     StyleBox[
      RowBox[{"{", 
       RowBox[{
        StyleBox["f", "TI"], 
        StyleBox[",", "TI"], 
        SubscriptBox[
         StyleBox["f", "TI"], 
         StyleBox["end", "TI"]]}], "}"}], "TI",
      FontColor->RGBColor[1, 0, 0]]}], "]"}], TraditionalForm]]],
 ":\n\nNote:\n\n\t1: Evaluate the following Input Cell.\n\t\t\t \n\t2: As you \
",
 StyleBox["move",
  FontVariations->{"Underline"->True}],
 " the Slider[...], Dynamically change the ",
 StyleBox["size",
  FontVariations->{"Underline"->True}],
 " of the displayed ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " using the Dynamic value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 ":\n\t\t\t \n\t\t\t ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      StyleBox["f", "TI"], "  ", " ", "is", "  ", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "=", "#"}], ";", 
        RowBox[{"under", "=", 
         RowBox[{"Sequence", "[", " ", "]"}]}], ";", 
        RowBox[{"size", "=", 
         RowBox[{
          RowBox[{"#", " ", "44"}], "+", "5"}]}]}], ")"}]}], "&"}],
    FontColor->GrayLevel[0]], TraditionalForm]]],
 "\n\t\t\t \n\t3: The ",
 StyleBox["instant",
  FontVariations->{"Underline"->True}],
