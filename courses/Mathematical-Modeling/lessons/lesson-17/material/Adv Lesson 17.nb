 ")\n\tCheckboxBar[...](",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional link between ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and ",
 StyleBox["display",
