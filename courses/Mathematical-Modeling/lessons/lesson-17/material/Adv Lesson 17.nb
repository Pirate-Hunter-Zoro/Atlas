       StyleBox["f", "TI"], 
       StyleBox["end", "TI"]], "  ", " ", "is", "  ", " ", 
      RowBox[{"(", 
       RowBox[{"under", "=", "Underlined"}], ")"}]}], "&"}],
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 "\n\t\nThe code for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", 
    RowBox[{
     StyleBox["expr", "TI"], ",", 
     StyleBox[
      RowBox[{"{", 
       RowBox[{"f", ",", 
        SubscriptBox[
         StyleBox["f", "TI"], 
