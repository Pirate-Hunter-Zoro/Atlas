Cell[TextData[{
 " \n",
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 " \t"
}], "Text",
 CellChangeTimes->{{3.389592375271*^9, 3.3895924602*^9}, {3.389592495907*^9, 
   3.389592496086*^9}, {3.389592887684*^9, 3.389592903745*^9}, 
   3.389596634296*^9, 3.389610419083*^9, 3.3896557906538*^9}],

Cell[TextData[{
 "\tThe form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           StyleBox["x", "TI"], 
           StyleBox["1", "TR"]], ",", 
          SubscriptBox[
           StyleBox["y", "TI"], 
           StyleBox["1", "TR"]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           StyleBox["x", "TI"], 
           StyleBox["2", "TR"]], ",", 
          SubscriptBox[
           StyleBox["y", "TI"], 
           StyleBox["2", "TR"]]}], "}"}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "}"}], ",", 
    ButtonBox["Locator",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Locator"]}], "}"}]], "InlineFormula"],
 " sets up a locator for each \n\tof the ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["i", "TI"]], ",", 
    SubscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["i", "TI"]]}], "}"}]], "InlineFormula"],
 ", and makes the value of ",
 Cell[BoxData[
  StyleBox["u", "TI"]], "InlineFormula"],
 " be the list of all ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["i", "TI"]], ",", 
    SubscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["i", "TI"]]}], "}"}]], "InlineFormula"],
 "."
}], "Text",
 CellChangeTimes->{{3.3895929115179996`*^9, 3.389592918163*^9}},
 CellID->41702966],

Cell[TextData[{
 "\tWith ",
 Cell[BoxData[
  RowBox[{"LocatorAutoCreate", "->", 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula"],
 ", any ",
 StyleBox["Alt", "KeyEvent",
  FontColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],
 StyleBox["+", "KeyEventDelimiter"],
 StyleBox["Click", "PointerEvent"],
 " that does not hit an existing locator \n\twill cause a new locator to be \
created at the position of the click. ",
 StyleBox["Alt", "KeyEvent",
  Background->RGBColor[1, 1, 0]],
 StyleBox["+", "KeyEventDelimiter"],
 StyleBox["Click", "PointerEvent"],
 " on an existing \n\tlocator deletes the locator.\n\t\nEvaluate the Dynamic \
Graphic Locator in the following Cell and:\n\t\n\tClick and move each Locator\
\n\tCreate additional locators with ",
 StyleBox["Alt", "KeyEvent",
  Background->RGBColor[1, 1, 0]],
 StyleBox["+", "KeyEventDelimiter"],
 StyleBox["Click", "PointerEvent"]
}], "Text",
 CellChangeTimes->{{3.38959381324*^9, 3.389593825251*^9}, {3.3896557970738*^9,
   3.3896559402248*^9}},
 CellID->1067943069],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"Line", "[", "pt", "]"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "2"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pt", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "Locator", ",", "\[IndentingNewLine]", 
     RowBox[{"LocatorAutoCreate", "\[Rule]", "True"}]}], 
    "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.38959192315*^9, 3.3895919715179996`*^9}, 
   3.389592027174*^9, {3.389592073829*^9, 3.389592074597*^9}, {
   3.38959225117*^9, 3.389592362554*^9}}],

Cell[TextData[{
 "\n",
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\n\n\tDynamic InputField\n\t\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       StyleBox["u", "TI"], "}"}], Cell["blank input field", "TableText"]}
    }], TraditionalForm]]],
 "\n\t\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["init", "TI"]]}], "}"}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "}"}], Cell[TextData[{
       "input field control with initial value ",
       Cell[BoxData[
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["init", "TI"]]], "InlineFormula"]
      }], "TableText"]}
    }], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389593890255*^9, 3.389593897975*^9}, {3.389593970888*^9,
    3.389593987045*^9}, {3.389594108153*^9, 3.389594111991*^9}, 
   3.389596649208*^9, 3.389610267442*^9, 3.3896104096549997`*^9, {
   3.3896560248487997`*^9, 3.3896560470088*^9}}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{
     "PlotLabel", "\[Rule]", 
      "\"\<Enter a Mathematica function name above and press Enter:\>\""}]}], 
    "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"f", ",", "Tan"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389593141776*^9, 3.389593229499*^9}, {3.389594654977*^9,
   3.389594660483*^9}, {3.389594725199*^9, 3.389594742633*^9}, {
  3.3895948069960003`*^9, 3.389594807183*^9}, {3.3896560889558*^9, 
  3.3896560987728*^9}}],

Cell[TextData[{
 "\n",
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 " of how EASY it is to create VERY COMPLICATED DYNAMIC expressions:\n\n\t",
 StyleBox["Manipulate[",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["expr",
  FontSize->14,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",  ... controls and annotations ... ]",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\n\n\tAdd the ",
 StyleBox["expr",
  FontSize->14,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 " to be Dynamically Manipulated by the six Sliders:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a1", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"n1", " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", "p1"}], ")"}]}], "]"}]}], ",", 
       RowBox[{"a2", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"n2", " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", "p2"}], ")"}]}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"20", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}]}], 
    "\[IndentingNewLine]", "]"}], TraditionalForm]]],
 "\n\t\n\tAdd six Dynamic continuous Sliders (each with an initital value and \
a name) separated by a Delimiter:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n1", ",", "1", ",", "\"\<Frequency\>\""}], "}"}], ",", "1", 
      ",", "4"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a1", ",", "1", ",", "\"\<Amplitude\>\""}], "}"}], ",", "0", 
      ",", "1"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "0", ",", "\"\<Phase\>\""}], "}"}], ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "Delimiter", ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n2", ",", 
        RowBox[{"5", "/", "4"}], ",", "\"\<Frequency\>\""}], "}"}], ",", "1", 
      ",", "4"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a2", ",", "1", ",", "\"\<Amplitude\>\""}], "}"}], ",", "0", 
      ",", "1"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p2", ",", "0", ",", "\"\<Phase\>\""}], "}"}], ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}]}], TraditionalForm]]],
 "\n\n\tAdd two Dynamic annotations to be Manipulated by the Sliders:\n\t\n\t\
\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
    RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a1", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"n1", " ", 
           RowBox[{"(", 
            RowBox[{"x", "+", "p1"}], ")"}]}], "]"}]}], ",", "x"}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "\[Rule]", "100"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "Pi"}]}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
     "]"}], "\[IndentingNewLine]", "]"}], TraditionalForm]]],
 "\n\t\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a2", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"n2", " ", 
         RowBox[{"(", 
          RowBox[{"x", "+", "p2"}], ")"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "\[Rule]", "100"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", "1"}]}], "\[IndentingNewLine]", "]"}], 
    "\[IndentingNewLine]", "]"}], TraditionalForm]]],
 "\n\t\t\n\tPlace the Controls to the Left of the Dynamically Manipulated \
expression i.e. ParametricPlot[...]:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"ControlPlacement", "\[Rule]", "Left"}], TraditionalForm]]],
 "\n\t\t"
}], "Text",
 CellChangeTimes->{{3.389595322311*^9, 3.3895954232469997`*^9}, {
   3.389595575803*^9, 3.3895960499189997`*^9}, {3.389596095652*^9, 
   3.389596153343*^9}, {3.3895963629049997`*^9, 3.389596394531*^9}, {
   3.389596453434*^9, 3.389596459703*^9}, 3.389596663215*^9, {
   3.38959669767*^9, 3.389596706855*^9}, {3.3895967932980003`*^9, 
   3.3895968426289997`*^9}, {3.389596974543*^9, 3.389597018892*^9}, {
   3.389597142542*^9, 3.389597207285*^9}, {3.389597265417*^9, 
   3.389597315046*^9}, {3.3895973654440002`*^9, 3.389597397561*^9}, 
   3.3896103949960003`*^9, {3.3896561462088003`*^9, 3.3896562217198*^9}}],

