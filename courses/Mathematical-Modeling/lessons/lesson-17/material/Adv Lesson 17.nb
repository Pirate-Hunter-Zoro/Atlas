   3.3895658144068003`*^9, 3.3895658510257998`*^9}, {3.3895659612188*^9, 
   3.3895659661647997`*^9}, {3.3895660227348003`*^9, 
   3.3895660273408003`*^9}, {3.3895660874638*^9, 3.3895661000448*^9}, {
   3.389588527692*^9, 3.389588530583*^9}, {3.389588573267*^9, 
