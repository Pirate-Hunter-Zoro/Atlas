Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      ButtonBox["Trigger",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Trigger"], "[", 
      RowBox[{
       RowBox[{
        ButtonBox["Dynamic",
         BaseStyle->"Link",
         ButtonData->"paclet:ref/Dynamic"], "[", 
        StyleBox["u", "TI"], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["min", "TI"]], ",", 
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["max", "TI"]]}], "}"}], ",", 
       StyleBox["ups", "TI"]}], "]"}]], "InlineFormula"],
    "\[LineSeparator]makes the value of ",
    Cell[BoxData[
     StyleBox["u", "TI"]], "InlineFormula"],
    " increase at a rate of ",
    Cell[BoxData[
     StyleBox["ups", "TI"]], "InlineFormula"],
    " units per second when triggered. "
   }]], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.388350652512*^9, 3.3883506583640003`*^9}}],

