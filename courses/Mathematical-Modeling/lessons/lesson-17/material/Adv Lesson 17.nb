 RowBox[{
  RowBox[{
   RowBox[{"under", "=", 
    RowBox[{"Sequence", "[", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Slider", "[", "\[IndentingNewLine]", 
    RowBox[{"Dynamic", "[", "x", "]"}], "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Panel", "[", 
