 CellID->19626],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon"], "\"\<KeyDown\>\"", Cell[
    "any key on the keyboard depressed", "TableText"]},
   {Cell["      ", "TableRowIcon"], 
    RowBox[{"{", 
     RowBox[{"\"\<KeyDown\>\"", ",", "\"\<\!\(\*
StyleBox[\"x\", \"TI\"]\)\>\""}], "}"}], Cell[TextData[{
     "key ",
     Cell[BoxData[
      StyleBox["x", "TI"]], "InlineFormula"],
     " depressed"
    }], "TableText"]},
   {Cell["      ", "TableRowIcon"], "\"\<ReturnKeyDown\>\"", Cell[TextData[{
