Cell[TextData[{
 StyleBox["Illustration Code",
  FontColor->RGBColor[0.5, 0, 0.5]],
 ": \n\n\tEvaluate the following normal Input Cell and move the Dynamic \
Slider[...] in the Output Cell:"
}], "Text",
 CellChangeTimes->{{3.389136335104*^9, 3.389136339998*^9}, {3.389136438252*^9,
    3.389136473808*^9}, {3.3891472300875998`*^9, 3.3891472665906*^9}, {
   3.3891473616666*^9, 3.3891474414906*^9}, {3.3891479304976*^9, 
   3.3891479314435997`*^9}, {3.3891486621656*^9, 3.3891486642116003`*^9}, {
   3.3891486978526*^9, 3.3891487129606*^9}, {3.3891492159786*^9, 
   3.3891492555146*^9}, 3.3892175849268*^9, {3.3892249218417997`*^9, 
   3.3892249244318*^9}, {3.3892312642088003`*^9, 3.3892312713058*^9}, {
   3.3894859850945997`*^9, 3.3894860083775997`*^9}, {3.3894865227186003`*^9, 
   3.3894865688336*^9}, {3.3894866075656*^9, 3.3894866360996*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xxx", "=", ".2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yyy", "=", ".3"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Slider2D", "[", "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      StyleBox[
       RowBox[{"Dynamic", "[", "xxx", "]"}],
       Background->RGBColor[1, 1, 0]], ",", "\[IndentingNewLine]", 
      StyleBox[
       RowBox[{"Dynamic", "[", "yyy", "]"}],
       Background->RGBColor[1, 1, 0]]}], "\[IndentingNewLine]", "}"}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<xxx = \>\"", ",", 
      RowBox[{"Dynamic", "[", "xxx", "]"}], ",", "\"\<  and  yyy = \>\"", ",", 
      RowBox[{"Dynamic", "[", "yyy", "]"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]", "}"}]}], "Input"],

Cell[TextData[{
 StyleBox["\nIllustration",
  FontColor->RGBColor[0.5, 0, 0.5]],
 ": Evaluate the following normal Input Cell that contains both ",
 StyleBox["non-Dynamic",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["Dynamic",
  FontVariations->{"Underline"->True}],
 " content.\n\nEvaluate:"
}], "Text",
 CellChangeTimes->{{3.389136335104*^9, 3.389136339998*^9}, {3.389136438252*^9,
    3.389136473808*^9}, {3.3891472300875998`*^9, 3.3891472665906*^9}, {
   3.3891473616666*^9, 3.3891474414906*^9}, {3.3891479304976*^9, 
   3.3891479314435997`*^9}, {3.3891486621656*^9, 3.3891486642116003`*^9}, {
   3.3891486978526*^9, 3.3891487129606*^9}, {3.3891492159786*^9, 
   3.3891492555146*^9}, 3.3892175849268*^9, {3.3892249218417997`*^9, 
   3.3892249244318*^9}, {3.3892312642088003`*^9, 3.3892312713058*^9}, 
   3.3894866618546*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"f", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", "  ", 
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], ",", "   ", 
   RowBox[{"Dynamic", "[", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}]}], "  ", "}"}]}], "Input",
 CellChangeTimes->{{3.38913635092*^9, 3.389136375751*^9}, {3.389136805532*^9, 
   3.389136821377*^9}, {3.3891374389449997`*^9, 3.3891374545959997`*^9}, 
   3.3891474900036*^9, {3.3891485569856*^9, 3.3891485782706003`*^9}, {
   3.3891495616186*^9, 3.3891495877876*^9}, {3.3891496211246*^9, 
   3.3891496269856*^9}, 3.3892176207038*^9}],

Cell[TextData[{
 "\nFirst, observe that both the ",
 StyleBox["non-Dynamic",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["Dynamic",
  FontVariations->{"Underline"->True}],
 " content are ",
 StyleBox["displayed",
  FontColor->RGBColor[1, 0, 0]],
 " the same.\n\n",
 StyleBox["Illustration",
  FontColor->RGBColor[0.5, 0, 0.5]],
 ": Part 1: \n\nNow change both the ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " for the ",
 StyleBox["non",
  FontVariations->{"Underline"->True}],
 "-Dynamic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]]],
 " on the ",
 StyleBox["left",
  FontVariations->{"Underline"->True}],
 " side of the above Output Cell (NOT the Input Cell above it)!\n\nNote that \
a normal (",
 StyleBox["non",
  FontVariations->{"Underline"->True}],
 "-Dynamic) Output Cell (when edited) changes into an Input Cell containing \
the changes."
}], "Text",
 CellChangeTimes->{{3.3891475024346*^9, 3.3891475504926*^9}, {
   3.3891475854086*^9, 3.3891477196646*^9}, {3.3891478503876*^9, 
   3.3891478624625998`*^9}, {3.3891479747116003`*^9, 3.3891480632906*^9}, {
   3.3891493388676*^9, 3.3891494505016003`*^9}, {3.3891497671066*^9, 
   3.3891497823445997`*^9}, {3.3892176345088*^9, 3.3892177561488*^9}, {
   3.3892177863698*^9, 3.3892178156148*^9}, {3.3892178916008*^9, 
   3.3892178953248*^9}, {3.3892179529658003`*^9, 3.3892179569538*^9}, {
   3.3892312937988*^9, 3.3892312965028*^9}, {3.3894862518536*^9, 
   3.3894862525226*^9}, {3.3894862833016*^9, 3.3894862868806*^9}, 
   3.5236315312915773`*^9}],

Cell[TextData[{
 StyleBox["Illustration",
  FontColor->RGBColor[0.5, 0, 0.5]],
 ": Part 2: ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " unsuccessfully to change Dynamic ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 " \[Rule] to generate a change in its Dynamic ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 ".\n\nNow TRY ",
 "unsuccessfully",
 " to change either the ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 " or ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " for the Dynamic ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]]],
 " on the ",
 StyleBox["right",
  FontVariations->{"Underline"->True}],
 " side of the above Cell that contains the changes from Part 1 (the bottom \
not the top of the two cells)!\n\nThe edit is prohibited!\n\nDynamic \
connections are by default ",
 StyleBox["bi",
  FontVariations->{"Underline"->True}],
 "\[Hyphen]directional between ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ".\n\n",
 StyleBox["Most",
  FontVariations->{"Underline"->True}],
 " Dynamic ",
 StyleBox["displays",
  FontColor->RGBColor[1, 0, 0]],
 " do NOT have a REVERSIBLE link to the underlying Dynamic ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " and therefore the edit will be prohibited."
}], "Text",
