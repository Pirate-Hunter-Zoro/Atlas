Cell[CellGroupData[{

Cell["Example:  Dynamic and Slider2D", "Subsubsection",
 CellChangeTimes->{{3.389136335104*^9, 3.389136339998*^9}, {3.389136438252*^9,
    3.389136473808*^9}, {3.3891472300875998`*^9, 3.3891472665906*^9}, {
   3.3891473616666*^9, 3.3891474414906*^9}, 3.3891806188552*^9, {
   3.3895023132446003`*^9, 3.3895023420016003`*^9}, {3.3895188009561996`*^9, 
   3.3895188341292*^9}}],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "}"}]}], ",", 
     RowBox[{"p2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], ",", 
     RowBox[{"p3", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", "0"}], "}"}]}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Panel", "[", "\[IndentingNewLine]", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Framed", "[", "\[IndentingNewLine]", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Dynamic", "[", 
             RowBox[{"Hue", "[", 
              RowBox[{"Apply", "[", 
               RowBox[{"Plus", ",", 
                RowBox[{"p1", "+", "p2", "+", "p3"}]}], "]"}], "]"}], "]"}], 
            ",", 
            RowBox[{"Polygon", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Dynamic", "[", "p1", "]"}], ",", 
               RowBox[{"Dynamic", "[", "p2", "]"}], ",", 
               RowBox[{"Dynamic", "[", "p3", "]"}]}], "}"}], "]"}]}], "}"}], 
          ",", 
          RowBox[{"PlotRange", "\[Rule]", "1"}], ",", 
          RowBox[{"ImageSize", "\[Rule]", "240"}]}], "]"}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Row", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Slider2D", "[", 
           RowBox[{
            RowBox[{"Dynamic", "[", "p1", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "\"\< \>\"", ",", "\[IndentingNewLine]", 
          RowBox[{"Slider2D", "[", 
           RowBox[{
            RowBox[{"Dynamic", "[", "p2", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "\"\< \>\"", ",", "\[IndentingNewLine]", 
          RowBox[{"Slider2D", "[", 
           RowBox[{
            RowBox[{"Dynamic", "[", "p3", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}]}], "\[IndentingNewLine]", "}"}], 
     "]"}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3895013803126*^9, 3.3895015692806*^9}, {
  3.3895016173766003`*^9, 3.3895016823476*^9}, {3.3895017154936*^9, 
  3.3895018847766*^9}, {3.3895019782416*^9, 3.3895020392306004`*^9}, {
  3.3895021037946*^9, 3.3895021672176*^9}}]
}, Closed]],

