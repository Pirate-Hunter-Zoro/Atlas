Cell["\<\


 Annotate curves in a plot:  \
\>", "Text",
 CellChangeTimes->{{3.388614410915*^9, 3.388614474216*^9}, {
   3.3893914010656*^9, 3.3893914012486*^9}, 3.3893928923496*^9}],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Annotation", "[", 
         RowBox[{
          RowBox[{"Sin", "[", "x", "]"}], ",", 
          "\"\<\!\(\*SubsuperscriptBox[\(\[Integral]\), \(a\), \(b\)]\)Cos[x]\
\[DifferentialD]x\>\"", ",", "\"\<Mouse\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
