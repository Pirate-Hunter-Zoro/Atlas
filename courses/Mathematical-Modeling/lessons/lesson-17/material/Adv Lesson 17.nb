  3.3895008454946003`*^9, 3.3895008533626003`*^9}}],

Cell[TextData[{
 "\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     ButtonBox["Dynamic",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/Dynamic"], "[", 
     RowBox[{
      StyleBox["expr", "TI"], ",", 
      StyleBox["f", "TI"]}], "]"}], "\[IndentingNewLine]"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"                     ", 
    RowBox[{"Continually", " ", 
     RowBox[{
      StyleBox[
       RowBox[{"evaluates", 
        StyleBox["f", "TI"]}]], "[", 
      RowBox[{
       StyleBox["val", "TI"], ",", 
       StyleBox["expr", "TI"]}], "]"}], "during", " ", "interactive", " ", 
     "changing", " ", "or", " ", "editing", " ", "of", " ", 
     StyleBox["val", "TI"]}]}], TraditionalForm]}]],
 "\n\nExample using the second argument of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", 
    RowBox[{
     StyleBox["expr", "TI"], ",", 
     StyleBox["f", "TI",
      FontColor->RGBColor[1, 0, 0]]}], "]"}], TraditionalForm]]],
 ":\n\nNote:\n\n\t1: Evaluate the following Input Cell.\n\t\t\t \n\t2: As you \
",
 StyleBox["move",
  FontVariations->{"Underline"->True}],
 " the Slider[...], Dynamically change the ",
 StyleBox["size",
  FontVariations->{"Underline"->True}],
 " of the displayed ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " using the Dynamic value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 ":\n\t\t\t \n\t\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox[
      StyleBox["f", "TI"],
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox["  ",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[" ",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox["is",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox["  ",
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[" ",
      FontColor->RGBColor[1, 0, 0]], 
     RowBox[{
      StyleBox["(",
       FontColor->RGBColor[1, 0, 0]], 
      RowBox[{
       StyleBox[
        RowBox[{"x", "=", "#"}],
        FontColor->RGBColor[1, 0, 0]], 
       StyleBox[";",
        FontColor->RGBColor[1, 0, 0]], 
       StyleBox[
        RowBox[{"size", "=", 
         RowBox[{
          RowBox[{"#", " ", "44"}], "+", "5"}]}],
        FontColor->RGBColor[0, 0, 1]]}], 
      StyleBox[")",
       FontColor->RGBColor[1, 0, 0]]}]}], 
    StyleBox["&",
     FontColor->RGBColor[1, 0, 0]]}], TraditionalForm]]],
 "\n\t\nThe code for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", 
    RowBox[{
     StyleBox["expr", "TI"], ",", 
     StyleBox["f", "TI",
      FontColor->RGBColor[1, 0, 0]]}], "]"}], TraditionalForm]]],
 ":\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", " ", 
    RowBox[{"x", ",", " ", 
     RowBox[{
      RowBox[{
       StyleBox["(",
        FontColor->RGBColor[1, 0, 0]], 
       RowBox[{
        StyleBox[
         RowBox[{"x", "=", "#1"}],
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[";",
         FontColor->RGBColor[1, 0, 0]], 
        StyleBox[
         RowBox[{"size", "=", 
          RowBox[{
           RowBox[{"#", " ", "44"}], "+", "5"}]}],
         FontColor->RGBColor[0, 0, 1]]}], 
       StyleBox[")",
        FontColor->RGBColor[1, 0, 0]]}], 
      StyleBox["&",
       FontColor->RGBColor[1, 0, 0]]}]}], " ", "]"}], TraditionalForm]]],
 "\n\t"
}], "Text",
