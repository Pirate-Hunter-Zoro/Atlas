 CellID->513341059],

Cell[TextData[{
 "\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     ButtonBox["Dynamic",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/Dynamic"], "[", 
     RowBox[{
      StyleBox["expr", "TI"], ",", 
      StyleBox["f", "TI"]}], "]"}], "\[IndentingNewLine]"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"                     ", 
    RowBox[{"Continually", " ", 
     RowBox[{
      StyleBox[
       RowBox[{"evaluates", 
        StyleBox["f", "TI"]}]], "[", 
      RowBox[{
       StyleBox["val", "TI"], ",", 
       StyleBox["expr", "TI"]}], "]"}], "during", " ", "interactive", " ", 
     "changing", " ", "or", " ", "editing", " ", "of", " ", 
     RowBox[{
      StyleBox["val", "TI"], "."}]}]}], TraditionalForm]}]],
 "\n\nBy default, Dynamic[...] performs an ",
 StyleBox["assignment",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["operation",
  FontVariations->{"Underline"->True}],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["expr", "TI"], TraditionalForm]]],
 " when used in interactive elements.\n\n\tThis is ONLY TRUE when \
Dynamic[...] has only ",
 StyleBox["ONE",
  FontVariations->{"Underline"->True}],
 " ARGUMENT!!\n\n\tThis is ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " TRUE when Dynamic[...] has ",
 StyleBox["TWO",
  FontColor->RGBColor[1, 0, 0]],
 " ARGUMENTS!!\n\t\nExample: Dynamic[...] has ",
 StyleBox["TWO",
  FontColor->RGBColor[1, 0, 0]],
 " ARGUMENTS:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", " ", 
    RowBox[{"x", ",", " ", 
     StyleBox[
      RowBox[{
       RowBox[{"Identity", "[", "#", "]"}], " ", "&"}],
      FontColor->RGBColor[1, 0, 0]]}], " ", "]"}], TraditionalForm]]],
 "\n\n\tNote that ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " does NOT AUTOMATICALLY UPDATE!\n\tTherefore the Slider[...] can ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " EVEN MOVE!"
}], "Text",
 CellChangeTimes->{
  3.389061372633*^9, {3.3890675400439997`*^9, 3.389067630624*^9}, {
   3.389067680179*^9, 3.389067714916*^9}, {3.3890677507469997`*^9, 
