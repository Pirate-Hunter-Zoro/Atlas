Cell[CellGroupData[{

Cell["Example:  Construct a dynamic calculating interface: ", "Subsubsection",
 CellChangeTimes->{{3.3895187309802*^9, 3.3895187521542*^9}, 
   3.3895191417362003`*^9, 3.3895191845822*^9}],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "=", "0"}], ",", 
     RowBox[{"b", "=", "0"}], ",", 
     RowBox[{"s", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"5", ",", "30"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "Infinity"}], "}"}]}], "}"}]}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Deploy", "[", "\[IndentingNewLine]", 
    RowBox[{"Style", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Panel", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Grid", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Input a number\>\"", ",", "Red"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Input another number\>\"", ",", "Red"}], "]"}], 
               ",", "\"\<here is their sum\>\"", ",", 
               "\"\<their difference\>\"", ",", "\"\<their product\>\""}], 
              "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"InputField", "[", 
                RowBox[{
                 RowBox[{"Dynamic", "[", "a", "]"}], ",", "Number"}], "]"}], 
               ",", 
               RowBox[{"InputField", "[", 
                RowBox[{
                 RowBox[{"Dynamic", "[", "b", "]"}], ",", "Number"}], "]"}], 
               ",", 
               RowBox[{"InputField", "[", 
                RowBox[{
                 RowBox[{"Dynamic", "[", 
                  RowBox[{"a", "+", "b"}], "]"}], ",", 
                 RowBox[{"Enabled", "\[Rule]", "False"}]}], "]"}], ",", 
               RowBox[{"InputField", "[", 
                RowBox[{
                 RowBox[{"Dynamic", "[", 
                  RowBox[{"a", "-", "b"}], "]"}], ",", 
                 RowBox[{"Enabled", "\[Rule]", "False"}]}], "]"}], ",", 
               RowBox[{"InputField", "[", 
                RowBox[{
                 RowBox[{"Dynamic", "[", 
                  RowBox[{"a", " ", "b"}], "]"}], ",", 
                 RowBox[{"Enabled", "\[Rule]", "False"}]}], "]"}]}], "}"}]}], 
            "}"}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Alignment", "\[Rule]", "Right"}]}], "\[IndentingNewLine]", 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ImageMargins", "\[Rule]", "10"}]}], "\[IndentingNewLine]", 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"DefaultOptions", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"InputField", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ContinuousAction", "\[Rule]", "True"}], ",", 
           RowBox[{"FieldSize", "\[Rule]", "s"}]}], "}"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3895203833672*^9, 3.3895204839402*^9}, {
  3.3895205622282*^9, 3.3895205703412*^9}},
 CellID->4671]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Example:  Construct custom controls, i.e., an angular slider with range (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[Infinity]"}], TraditionalForm]], "InlineMath"],
 ",",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]], "InlineMath"],
 "):\n                   Click and Move Arrow to generate the number:"
}], "Subsubsection",
 CellChangeTimes->{{3.3895187309802*^9, 3.3895187521542*^9}, 
   3.3895191417362003`*^9, 3.3895193196972*^9, 3.3895193615372*^9, {
   3.3895202742882*^9, 3.3895202997042*^9}, {3.3895207229322*^9, 
   3.3895207427892*^9}}],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"angle", "=", "0"}], ",", 
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", "angleCalc"}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"LocatorPane", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Dynamic", "[", 
        RowBox[{"p", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"angleCalc", "@@", 
            RowBox[{"Normalize", "/@", 
             RowBox[{"{", 
              RowBox[{"#", ",", "p"}], "}"}]}]}], ")"}], "&"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Circle", "[", "]"}], ",", 
           RowBox[{"Arrowheads", "[", "0.15", "]"}], ",", 
           RowBox[{"Arrow", "[", 
            RowBox[{"Dynamic", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], ",", "p"}], "}"}], "]"}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "Tiny"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Appearance", "\[Rule]", "None"}]}], "\[IndentingNewLine]", 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Panel", "[", 
      RowBox[{"Dynamic", "[", "angle", "]"}], "]"}]}], "\[IndentingNewLine]", 
    "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Initialization", "\[RuleDelayed]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"angleCalc", "[", 
       RowBox[{"newp_", ",", "oldp_"}], "]"}], ":=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"angle", "=", 
         RowBox[{"angle", "+", 
          RowBox[{
           RowBox[{"ArcCos", "[", 
            RowBox[{"newp", ".", "oldp"}], "]"}], 
           RowBox[{"Sign", "[", 
            RowBox[{
             RowBox[{"Cross", "[", "newp", "]"}], ".", 
             RowBox[{"(", 
              RowBox[{"newp", "-", "oldp"}], ")"}]}], "]"}]}]}]}], ";", 
        RowBox[{"p", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "angle", "]"}], ",", 
           RowBox[{"Sin", "[", "angle", "]"}]}], "}"}]}]}], ")"}]}], 
     ")"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3895197397212*^9, 3.3895198389522*^9}, {
  3.3895198815952*^9, 3.3895199012932*^9}, {3.3895202626191998`*^9, 
  3.3895202681792*^9}},
 CellID->1106614873]
}, Closed]],

