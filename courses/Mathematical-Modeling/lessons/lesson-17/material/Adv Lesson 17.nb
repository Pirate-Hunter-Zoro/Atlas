Cell[CellGroupData[{

Cell["Example: LU Decomp", "Section",
 CellChangeTimes->{{3.388657863337*^9, 3.388657870572*^9}, {
  3.3940525328061476`*^9, 3.3940525337749043`*^9}}],

Cell[TextData[{
 "An implementation of LU decomposition that ",
 Cell[BoxData[
  ButtonBox["Sow",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Sow"]], "InlineFormula"],
 " all intermediate steps: "
}], "Text",
 CellID->289204568],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LU", "[", "A_", "]"}], ":=", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "n", ",", "L", ",", "U"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", "n"}], "}"}], "=", 
       RowBox[{"Dimensions", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Sow", "[", 
       RowBox[{"L", ",", " ", "\"\<L\>\""}], " ", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"U", "=", "A"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Sow", "[", 
       RowBox[{"U", ",", " ", "\"\<U\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", ";;", "n"}], ",", "k"}], "]"}], "]"}], "=", " ", 
          RowBox[{
           RowBox[{"U", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", ";;", "n"}], ",", "k"}], "]"}], "]"}], "/", 
           RowBox[{"U", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "k"}], "]"}], "]"}]}]}], ";", " ", 
         "\[IndentingNewLine]", 
         RowBox[{"Sow", "[", 
          RowBox[{"L", ",", " ", "\"\<L\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"U", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k", "+", "1"}], ")"}], ";;", "n"}], ",", 
             RowBox[{"k", ";;", "n"}]}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"U", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"k", "+", "1"}], ")"}], ";;", "n"}], ",", 
              RowBox[{"k", ";;", "n"}]}], "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"L", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", "+", "1"}], ")"}], ";;", "n"}], ",", 
               RowBox[{"{", "k", "}"}]}], "]"}], "]"}], ".", 
            RowBox[{"U", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"{", "k", "}"}], ",", 
               RowBox[{"k", ";;", "n"}]}], "]"}], "]"}]}]}]}], ";", 
         "\[IndentingNewLine]", " ", 
         RowBox[{"Sow", "[", 
          RowBox[{"U", ",", " ", "\"\<U\>\""}], "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"L", ",", "U"}], "}"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.394122318953451*^9, 3.394122383360113*^9}},
 CellID->167480756],

