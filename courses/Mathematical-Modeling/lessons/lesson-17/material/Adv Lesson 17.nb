Cell[CellGroupData[{

Cell[TextData[{
 "Where do you place Dynamic[",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 "]  to have a change in Dynamic ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " \[Rule] generate a change in the Dynamic ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 ". "
}], "Subsection",
 CellChangeTimes->{{3.389259204493*^9, 3.389259231152*^9}, {3.389259294347*^9,
   3.38925933083*^9}, {3.389259912762*^9, 3.3892599418059998`*^9}, {
  3.3894867948196*^9, 3.3894868158886003`*^9}}],

Cell[TextData[{
 "Almost anywhere!\n\nIn the following example, Dynamic surrounds all of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    RowBox[{"Plot3D", "[", "...", "]"}]}], TraditionalForm]]],
 " and it works!"
}], "Text",
 CellChangeTimes->{{3.3892600354639997`*^9, 3.389260048608*^9}, {
   3.389260081483*^9, 3.389260181773*^9}, {3.389260717097*^9, 
   3.3892607426549997`*^9}, {3.389261297965*^9, 3.389261352851*^9}, {
   3.389261982875*^9, 3.389262046803*^9}, {3.3893030387*^9, 
   3.389303098988*^9}, 3.389303130961*^9}],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", "2"}], ",", 
     RowBox[{"y", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Slider", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Slider", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "y", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      StyleBox[
       RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
        RowBox[{"Plot3D", "[", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"xx", "*", "yy"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"xx", ",", "0", ",", "x"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"yy", ",", "0", ",", "y"}], "}"}], ",", 
          RowBox[{
          "PlotLabel", "\[Rule]", "\"\<Dynamic[Plot3D[...]] works!\>\""}]}], 
         "]"}], "\[IndentingNewLine]", "]"}],
       FontColor->GrayLevel[0]]}], "\[IndentingNewLine]", "}"}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389260828933*^9, 3.389260845092*^9}, {3.389260899738*^9,
   3.389261123509*^9}, {3.389261442992*^9, 3.389261475738*^9}, {
  3.389261726637*^9, 3.389261815613*^9}}],

Cell[TextData[{
 "\nAs long as the expression ",
 StyleBox["SURROUNDING",
  FontVariations->{"Underline"->True}],
 " ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Dynamic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Dynamic"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula"],
 "has sufficient information to evaluate ",
 StyleBox["properly",
  FontVariations->{"Underline"->True}],
 ", then it will work.\n\nIn the following example, Dynamic surrounds only ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]],
 " inside Plot3D[...]: \n\n\tPlot3D[...Dynamic[x] ... Dynamic[y]...]  \n\t\n\
and it only works half way!"
}], "Text",
 CellChangeTimes->{{3.389261380321*^9, 3.3892614316140003`*^9}, {
   3.38926183305*^9, 3.3892618536429996`*^9}, {3.389262105266*^9, 
   3.389262191513*^9}, {3.38926222735*^9, 3.3892623535620003`*^9}, {
   3.389262438512*^9, 3.389262450936*^9}, {3.3893031411400003`*^9, 
   3.389303157557*^9}, {3.389303274668*^9, 3.3893033008929996`*^9}, 
   3.389303371014*^9, {3.389303602832*^9, 3.38930368101*^9}, {
   3.389303712348*^9, 3.389303843724*^9}, {3.3893039234119997`*^9, 
   3.389303953184*^9}, 3.389304048159*^9, {3.389304154972*^9, 
   3.389304198314*^9}, {3.389304228649*^9, 3.389304297159*^9}, 
   3.389304330882*^9, {3.3893043664440002`*^9, 3.3893045352390003`*^9}, {
   3.389304577948*^9, 3.389304603382*^9}, {3.389304691473*^9, 
   3.389304692124*^9}, {3.38930479874*^9, 3.3893048734449997`*^9}, 
   3.389304904575*^9, {3.389305092271*^9, 3.389305157576*^9}, {
   3.389305709113*^9, 3.389305755382*^9}, {3.389307386524*^9, 
   3.389307404234*^9}, {3.389328185104*^9, 3.3893281919779997`*^9}, {
   3.3893937459746*^9, 3.3893937511656*^9}, {3.3893938018906*^9, 
   3.3893939545916*^9}, 3.3893940359166*^9}],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", "2"}], ",", 
     RowBox[{"y", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Slider", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Slider", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "y", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"xx", "*", "yy"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"xx", ",", "0", ",", 
          RowBox[{"Dynamic", "[", "x", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"yy", ",", "0", ",", 
          RowBox[{"Dynamic", "[", "y", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.389260784242*^9, {3.389261180433*^9, 3.389261207609*^9}, {
   3.389261250149*^9, 3.389261253586*^9}, {3.389261863108*^9, 
   3.389261909829*^9}}],

Cell[TextData[{
 "\nRead the above error message and move the sliders and note that \
Plot3D[...] is ",
 StyleBox["trying",
  FontVariations->{"Underline"->True}],
 " to evaluate BEFORE the values from Dynamic[x] and Dynamic[y] have been \
supplied to Plot3D[...] in numeric form from the sliders.\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Plot3D", "::", "\"\<plln\>\""}], ":", " ", 
    "\"\<Limiting value \!\(\*DynamicBox[ToBoxes[x$87, StandardForm],
ImageSizeCache->{50., {2., 18.}}]\) in {xx,0,\!\(\*DynamicBox[ToBoxes[x$87, \
StandardForm],
ImageSizeCache->{50., {2., 18.}}]\)} is not a machine-size real \
number.\>\""}], TraditionalForm]]],
 "\n\nPlot3D[...] needs numeric information for the local variable x$87 that \
Plot3D made from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", "x", "]"}], TraditionalForm]]],
 " in \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"xx", ",", " ", "0", ",", " ", 
     RowBox[{"Dynamic", "[", "x", "]"}]}], "}"}], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"yy", ",", " ", "0", ",", " ", 
     RowBox[{"Dynamic", "[", "y", "]"}]}], "}"}], TraditionalForm]]],
 "\n\nWhen you look above (",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " you moved the slider, the values were both ",
 StyleBox["2",
  FontColor->RGBColor[1, 0, 0]],
 "), you see what appears to be OK:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"xx", " ", "yy"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"xx", ",", "0", ",", 
       StyleBox["2",
        FontColor->RGBColor[1, 0, 0]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"yy", ",", "0", ",", 
       StyleBox["2",
        FontColor->RGBColor[1, 0, 0]]}], "}"}]}], "]"}], TraditionalForm]]],
 "\n\t\nbut if you cut and paste this elsewhere into your notebook, you will \
see that the real content is:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"xx", " ", "yy"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"xx", ",", "0", ",", 
       StyleBox["x$$",
        FontColor->RGBColor[1, 0, 0]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"yy", ",", "0", ",", 
       StyleBox["y$$",
        FontColor->RGBColor[1, 0, 0]]}], "}"}]}], "]"}], TraditionalForm]]],
 "\n\t\nand you will note that x$$ and y$$ do NOT have the value 2 at the ",
 StyleBox["time",
  FontVariations->{"Underline"->True}],
 " that Plot3D[...] was evaluated.\n\t\nYou might think that you can fix this \
problem in the usual way by surrounding the needed limits with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Evaluate", "[", 
    RowBox[{"Dynamic", "[", "x", "]"}], "]"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Evaluate", "[", 
    RowBox[{"Dynamic", "[", "y", "]"}], "]"}], TraditionalForm]]],
 ".\nThis solves the ",
 StyleBox["evaluation",
  FontVariations->{"Underline"->True}],
 " problem, but will ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " solve the ",
 StyleBox["dynamic",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["timing",
  FontVariations->{"Underline"->True}],
 " problem.\n\nThe observation that you need to make here is that the use of:\
\n\n\tDynamic[...]\n\t\naffects BOTH the ",
 StyleBox["evaluation",
  FontVariations->{"Underline"->True}],
 " process and the ",
 StyleBox["timing",
  FontVariations->{"Underline"->True}],
 " when a Cell is evaluated."
}], "Text",
 CellChangeTimes->{{3.389261380321*^9, 3.3892614316140003`*^9}, {
   3.38926183305*^9, 3.3892618536429996`*^9}, {3.389262105266*^9, 
   3.389262191513*^9}, {3.38926222735*^9, 3.3892623535620003`*^9}, {
   3.389262438512*^9, 3.389262450936*^9}, {3.3893031411400003`*^9, 
   3.389303157557*^9}, {3.389303274668*^9, 3.3893033008929996`*^9}, 
   3.389303371014*^9, {3.389303602832*^9, 3.38930368101*^9}, {
   3.389303712348*^9, 3.389303843724*^9}, {3.3893039234119997`*^9, 
   3.389303953184*^9}, 3.389304048159*^9, {3.389304154972*^9, 
   3.389304198314*^9}, {3.389304228649*^9, 3.389304297159*^9}, 
   3.389304330882*^9, {3.3893043664440002`*^9, 3.3893045352390003`*^9}, {
   3.389304577948*^9, 3.389304603382*^9}, {3.389304691473*^9, 
   3.389304692124*^9}, {3.38930479874*^9, 3.3893048734449997`*^9}, 
   3.389304904575*^9, {3.389305092271*^9, 3.389305157576*^9}, {
   3.389305709113*^9, 3.389305755382*^9}, {3.389307386524*^9, 
   3.389307404234*^9}, {3.389328185104*^9, 3.3893281919779997`*^9}, {
   3.3893937459746*^9, 3.3893937511656*^9}, {3.3893938018906*^9, 
   3.3893939545916*^9}, {3.3893940526056004`*^9, 3.3893941010636*^9}, {
   3.3893941952995996`*^9, 3.3893943070076*^9}, {3.3894789503356*^9, 
   3.3894789526916*^9}, {3.3905591083845997`*^9, 3.3905591520786*^9}, 
   3.523631882805092*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Where do you place Dynamic[",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 "] to have a change in Dynamic ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 " \[Rule] generate a change in the Dynamic ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 ". "
}], "Subsection",
 CellChangeTimes->{{3.389259204493*^9, 3.389259231152*^9}, {3.389259294347*^9,
    3.38925933083*^9}, 3.3894869007276*^9}],

Cell[TextData[{
 "When used to assign values to ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula"],
 " through interactive operations, the expression in ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Dynamic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Dynamic"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula"],
 " will most often be a symbol ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula"],
 ", an object ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "[", 
   StyleBox["i", "TI"], "]"}]], "InlineFormula"],
 ", a part ",
 Cell[BoxData[
  RowBox[{
   StyleBox["e", "TI"], "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula"],
 " or a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["\[Ellipsis]", "TR"]}], "}"}]], "InlineFormula"],
 ". \n\nIf ",
 Cell[BoxData[
  StyleBox["expr", "TI"]]],
 " in ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Dynamic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Dynamic"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula"],
 " is more complicated than what is given in the sentence above, then the \
link needed to create a change in the Dynamic ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " will be broken. Note that this is a very ",
 StyleBox["short",
  FontVariations->{"Underline"->True}],
 " list of ",
 StyleBox["acceptable",
  FontVariations->{"Underline"->True}],
 " options.\n\nIn the following example Dynamic surrounds a ",
 StyleBox["symbol",
  FontVariations->{"Underline"->True}],
 "\n\n\t",
 StyleBox["Dynamic[xxx],\n\n\tDynamic[yyy]",
  Background->RGBColor[1, 1, 0]],
 "\n\t\nand it works:"
}], "Text",
 CellChangeTimes->{{3.389259448178*^9, 3.3892596302869997`*^9}, {
   3.389259718099*^9, 3.38925979292*^9}, 3.389260192715*^9, {
   3.3892624936429996`*^9, 3.389262632711*^9}, {3.389262666613*^9, 
