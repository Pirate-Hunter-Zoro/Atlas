Cell[CellGroupData[{

Cell["Localizing and initializing Variables in Dynamic Output", "Subsection",
 CellChangeTimes->{{3.3895241006972*^9, 3.3895241070202*^9}, 
   3.3895244359502*^9}],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["DynamicModule",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/DynamicModule"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["x", "TI"], ",", 
       StyleBox["y", "TI"], ",", 
       StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", 
     StyleBox["expr", "TI"]}], "]"}], TraditionalForm]]],
 "\n\n  ",
 Cell[BoxData[{
  FormBox[
   RowBox[{
   "an", " ", "object", " ", "which", " ", "maintains", " ", "the", " ", 
    "same", " ", "local", " ", "instance", " ", "of", " ", "the", " ", 
    "symbols"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{" ", 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["y", "TI"], ",", 
     RowBox[{
     "\[Ellipsis]", " ", "in", " ", "the", " ", "course", " ", "of", " ", 
      "all", " ", "evaluations", " ", "of", 
      ButtonBox["Dynamic",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Dynamic"], "objects", " ", "in", " ", 
      StyleBox["expr", "TI"]}]}]}], TraditionalForm]}]],
 "\n  \n  \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["DynamicModule",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/DynamicModule"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        StyleBox["x", "TI"], "=", 
        SubscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["0", "TR"]]}], ",", 
       RowBox[{
        StyleBox["y", "TI"], "=", 
        SubscriptBox[
         StyleBox["y", "TI"], 
         StyleBox["0", "TR"]]}]}], "}"}], ",", 
     StyleBox["expr", "TI"]}], "]"}], TraditionalForm]]],
 "\n\n  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"specifies", " ", "initial", " ", "values", " ", 
     StyleBox[
      RowBox[{"for", 
       StyleBox["x", "TI"]}]]}], ",", 
    StyleBox["y", "TI"], ",", "\[Ellipsis]"}], TraditionalForm]]],
 "\n"
}], "Text",
 CellChangeTimes->{{3.3895241501242*^9, 3.3895243233182*^9}, {
  3.3895602554848003`*^9, 3.3895602594448*^9}}],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 " has arguments identical to ",
 Cell[BoxData[
  ButtonBox["Module",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Module"]], "InlineFormula"],
 " and is similarly used to localize and initialize variables, but there are \
important differences in how they operate. "
}], "Text",
 CellID->1493927483],

Cell[TextData[{
 "You might be tempted to use ",
 Cell[BoxData[
  ButtonBox["Module",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Module"]], "InlineFormula"],
 " in place of ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 ", and in fact this would appear to work at first. However, it is not a good \
idea for several reasons, which are discussed in more detail in \"",
 ButtonBox["Advanced Dynamic Functionality\"",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/AdvancedDynamicFunctionality"],
 "."
}], "Text",
 CellChangeTimes->{3.3895237111842003`*^9, 3.3895238369542*^9}],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 " does its work in the ",
 StyleBox["front",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["end",
  FontVariations->{"Underline"->True}],
 ", not in the ",
 StyleBox["kernel",
  FontVariations->{"Underline"->True}],
 ". It remains unchanged by evaluation, and when formatted as output, it \
creates an invisible object embedded in the output expression which handles \
the localization. As long as that space of output remains in existence (e.g. \
is not deleted), the invisible object representing the ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 " will maintain the values of the variables, allowing them to be used in \
subsequent evaluations of ",
 Cell[BoxData[
  ButtonBox["Dynamic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Dynamic"]], "InlineFormula"],
 " expressions within the scope (area) of the ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 "."
}], "Text",
 CellChangeTimes->{3.3895237111842003`*^9, 3.3895238605481997`*^9}],

Cell[TextData[{
 "If you save a notebook containing a ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 ", close that notebook, then later reopen it in a new ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " session, the values of all the local variables will still be preserved and \
the sliders inside the ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 " will be in the same positions. This will ",
 StyleBox["not",
  FontSlant->"Italic"],
 " be the case with sliders linked to global variables (like the earliest \
examples in this tutorial), nor with sliders linked to variables localized \
with ",
 Cell[BoxData[
  ButtonBox["Module",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Module"]], "InlineFormula"],
 " instead of ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 ". Such variables store their values in the current ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " kernel session, and they are lost as soon as you quit ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{3.3895237111842003`*^9, 3.3895238768562*^9}],

Cell[TextData[{
 "In addition to localizing variables to particular regions of output, ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 " provides options to automatically initialize function definitions when an \
expression containing a ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 " is opened, and to clean up values when the expression is closed or \
deleted. More details are found in ",
 Cell[BoxData[
  ButtonBox["DynamicModule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DynamicModule"]], "InlineFormula"],
 "."
}], "Text",
 CellChangeTimes->{3.3895237111842003`*^9, 3.3895239023241997`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Examples:", "Subsection",
 CellChangeTimes->{{3.3895284045752*^9, 3.3895284090972*^9}}],

Cell[CellGroupData[{

Cell[" Interactive curve fit plot:", "Subsubsection",
 CellChangeTimes->{3.3895284192092*^9, 3.3895285169132*^9}],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pts", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"LocatorPane", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Dynamic", "[", "pts", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"InterpolatingPolynomial", "[", 
         RowBox[{"pts", ",", "x"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "3"}]}], "]"}], "\[IndentingNewLine]",
       "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3895284394421997`*^9, 3.3895284653582*^9}},
 CellID->6077861]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Demonstate a sinusoidal relationship:
Click and drag arrow:\
\>", "Subsubsection",
 CellChangeTimes->{{3.3895285523132*^9, 3.3895285721542*^9}, {
  3.3895635953388*^9, 3.3895636084168*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"angularSlider", "[", 
     RowBox[{"Dynamic", "[", "angle_", "]"}], "]"}], ":=", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], ",", "angleCalc"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"LocatorPane", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", 
         RowBox[{"p", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"angleCalc", "@@", 
             RowBox[{"Normalize", "/@", 
              RowBox[{"{", 
               RowBox[{"#", ",", "p"}], "}"}]}]}], ")"}], "&"}]}], "]"}], ",", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Circle", "[", "]"}], ",", 
            RowBox[{"Arrowheads", "[", "0.15", "]"}], ",", 
            RowBox[{"Arrow", "[", 
             RowBox[{"Dynamic", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], ",", "p"}], "}"}], "]"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"ImageSize", "\[Rule]", "Tiny"}]}], "]"}], ",", 
        RowBox[{"Appearance", "\[Rule]", "None"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Initialization", "\[RuleDelayed]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"angle", "=", "0"}], ";", 
         RowBox[{
          RowBox[{"angleCalc", "[", 
           RowBox[{"newp_", ",", "oldp_"}], "]"}], ":=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"angle", "=", 
             RowBox[{"angle", "+", 
              RowBox[{
               RowBox[{"ArcCos", "[", 
                RowBox[{"newp", ".", "oldp"}], "]"}], 
               RowBox[{"Sign", "[", 
                RowBox[{
                 RowBox[{"Cross", "[", "newp", "]"}], ".", 
                 RowBox[{"(", 
                  RowBox[{"newp", "-", "oldp"}], ")"}]}], "]"}]}]}]}], ";", 
            RowBox[{"p", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cos", "[", "angle", "]"}], ",", 
               RowBox[{"Sin", "[", "angle", "]"}]}], "}"}]}]}], ")"}]}]}], 
        ")"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Theta]", "=", "0"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"angularSlider", "[", 
         RowBox[{"Dynamic", "[", "\[Theta]", "]"}], "]"}], ",", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"Sin", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
          RowBox[{"Epilog", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
             RowBox[{"Dynamic", "@", 
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{"\[Theta]", ",", 
                 RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}], "]"}]}]}], 
            "}"}]}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ParametricPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "y", "]"}], ",", "y"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
          RowBox[{"AspectRatio", "\[Rule]", "2"}], ",", 
          RowBox[{"Epilog", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
             RowBox[{"Dynamic", "@", 
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", "\[Theta]"}], 
                "}"}], "]"}]}]}], "}"}]}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<\[Theta] = \>\"", ",", 
           RowBox[{"Dynamic", "[", "\[Theta]", "]"}], ",", "\"\< rad\>\""}], 
          "}"}], "//", "Row"}]}], "}"}]}], "\[IndentingNewLine]", "}"}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.3895286317511997`*^9, 3.3895286349312*^9}, {
  3.3895287841802*^9, 3.3895288909862003`*^9}, {3.3895636958817997`*^9, 
  3.3895637875188*^9}, {3.3895638204828*^9, 3.3895638466608*^9}},
 CellID->366453132]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Manipulate[ ... ]:   The Dynamic Function Used 95 % of the Time!\
\>", "Section",
 CellChangeTimes->{{3.3905600823666*^9, 3.3905600850036*^9}, {
  3.3905603905156*^9, 3.3905603991886*^9}}],

Cell[TextData[Cell[BoxData[GridBox[{
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["min", "TI"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["max", "TI"]]}], "}"}]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]generates a version of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula"],
     " with controls added to allow interactive \nmanipulation of the value \
of ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["min", "TI"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["max", "TI"]], ",", 
          StyleBox["du", "TI"]}], "}"}]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]allows the value of ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     " to vary between ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["min", "TI"]]], "InlineFormula"],
     " and ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["max", "TI"]]], "InlineFormula"],
     " in steps ",
     Cell[BoxData[
      StyleBox["du", "TI"]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            StyleBox["u", "TI"], ",", 
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["init", "TI"]]}], "}"}], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["min", "TI"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["max", "TI"]], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]takes the initial value of ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     " to be ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["init", "TI"]]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            StyleBox["u", "TI"], ",", 
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["init", "TI"]], ",", 
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["lbl", "TI"]]}], "}"}], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]labels the controls for ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     " with ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["lbl", "TI"]]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["1", "TR"]], ",", 
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["2", "TR"]], ",", 
            StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "}"}]}], "]"}]], 
      "InlineFormula"],
     "\[LineSeparator]allows ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     " to take on discrete values ",
     Cell[BoxData[
      RowBox[{
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["\[Ellipsis]", "TR"]}]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["v", "TI"], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]provides controls to manipulate each of the ",
     Cell[BoxData[
      RowBox[{
       StyleBox["u", "TI"], ",", 
       StyleBox["v", "TI"], ",", 
       StyleBox["\[Ellipsis]", "TR"]}]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"\"\<\!\(\*SubscriptBox[
StyleBox[\"c\", \"TI\"], 
StyleBox[\"u\", \"TI\"]]\)\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           StyleBox["u", "TI"], ",", 
           StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], ",", 
        RowBox[{"\"\<\!\(\*SubscriptBox[
StyleBox[\"c\", \"TI\"], 
StyleBox[\"v\", \"TI\"]]\)\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           StyleBox["v", "TI"], ",", 
           StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]links the controls to the specified controllers on an \
external device.\n"
    }]]}
  }]],
 GridBoxOptions->{
 GridBoxBackground->{
  "Columns" -> {{None}}, "ColumnsIndexed" -> {}, 
   "Rows" -> {None, None, None, None, None, None, {None}}, 
   "RowsIndexed" -> {}}}]], "Text",
 CellChangeTimes->{{3.3895173469982*^9, 3.3895173926672*^9}, {
  3.3895174650072002`*^9, 3.3895175269462*^9}},
 TextJustification->1.],

Cell[CellGroupData[{

Cell["Introduction to Manipulate[...]", "Subsection",
 CellChangeTimes->{{3.38959970931*^9, 3.389599731852*^9}}],

Cell[TextData[{
 "The single command ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " lets you create an astonishing range of interactive applications with just \
a few lines of input. ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " is designed to be used by anyone who is comfortable using basic commands \
such as ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 " and ",
 Cell[BoxData[
  ButtonBox["Plot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Plot"]], "InlineFormula"],
 ": it does not require learning any complicated new concepts, nor any \
understanding of user interface programing ideas.\n\nThe output you get from \
evaluating a ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " command is an interactive object containing one or more controls (sliders, \
etc.) that you can use to vary the value of one or more parameters. The \
output is very much like a small applet or widget: it is not just a static \
result, it is a running program you can interact with.\n\nAt its most basic, \
the syntax of ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " is identical to that of the humble function ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 ". \n\nConsider this ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 " command, which produces a list of numbers from 1 to 20 in steps of 1."
}], "Text",
 CellChangeTimes->{{3.389599654104*^9, 3.389599658648*^9}, {3.389599817123*^9,
   3.389599828992*^9}, {3.389606698573*^9, 3.3896067102799997`*^9}}],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{"n", ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "20", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.389599948332*^9, 3.389599949031*^9}}],

Cell[TextData[{
 "Simply replace the word ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 " with the word ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 ", and you get an interactive application that lets you explore values of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula"],
 " from 1 to 20 in steps of 1 with a slider."
}], "Text",
 CellChangeTimes->{{3.3896489290028*^9, 3.3896489381638002`*^9}}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{"n", ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "20", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.389599933547*^9, 3.389599934394*^9}}],

Cell[TextData[{
 "Of course the whole point of ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " (and ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 " for that matter) is that you can put any expression you like in the first \
argument, not just a simple variable name. \n\nOne way to think of ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " is as a way to interactively explore a large parameter space. You can move \
around that space at will, exploring interesting directions as they appear. \n\
\n",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " supports a wide range of alternate ways of specifying variables, which \
generate different kinds of controls for those variables. These dynamic \
controls include checkboxes, popup menus, and others in addition to sliders. \
\n\nThe principle is that for each Dynamic variable, ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]]],
 ", you ask for a particular set of possible values for the variable ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]]],
 " (like from 1 to 20 in steps of 1 e.g. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"u", ",", "1", ",", "20", ",", "1"}], "}"}], TraditionalForm]]],
 ") and ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " ",
 StyleBox["automatically chooses",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 " an appropriate type of control to make those values conveniently \
available.\n\n\t",
 StyleBox["Possible Values:\t\t\tManipulate Automatically Chooses an \
Appropriate Type of Control:",
  FontVariations->{"Underline"->True}],
 "\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["min", "TI"]], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["max", "TI"]]}], "}"}], " "}
    }], TraditionalForm]]],
 "\t\t\tcontinuous manipulator (slider, animator, etc.)\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["min", "TI"]], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["max", "TI"]], ",", 
        StyleBox["du", "TI"]}], "}"}], "   "}
    }], TraditionalForm]]],
 "\t\t\t",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    "discrete manipulator with step ",
    Cell[BoxData[
     StyleBox["du", "TI"]], "InlineFormula"]
   }], "TableText"], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["min", "TI"]], ",", 
       SubscriptBox[
        StyleBox["y", "TI"], 
        StyleBox["min", "TI"]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["max", "TI"]], ",", 
       SubscriptBox[
        StyleBox["y", "TI"], 
        StyleBox["max", "TI"]]}], "}"}]}], "}"}], TraditionalForm]]],
 "\t\t2D slider\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     ButtonBox["Locator",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/Locator"]}], "}"}], TraditionalForm]]],
 "\t\t\t\t",
 Cell[BoxData[
  FormBox[Cell["a locator in a graphic", "TableText"], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "}"}], TraditionalForm]]],
 "\t\t\tsetter bar for few elements; popup menu for more\n\tetc.\t\t\t\t\t\
etc.\n\tetc.\t\t\t\t\tetc."
}], "Text",
 CellChangeTimes->{{3.389600685666*^9, 3.3896006894639997`*^9}, {
   3.389600854349*^9, 3.389600862738*^9}, 3.389600927474*^9, {
