   3.389439016031*^9, 3.38943904277*^9}}],

Cell[TextData[{
 "\n\nIn the following example Dynamic surrounds a function with ",
 StyleBox["any",
  FontVariations->{"Underline"->True}],
 " head (e.g. ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 ") ",
 StyleBox["other",
  FontVariations->{"Underline"->True}],
 " than List\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Dynamic", "[", 
     RowBox[{"f", "[", 
      RowBox[{"xxx", ",", " ", "yyy"}], "]"}], "]"}],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 "\n\t\nand it does ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " work!\n\nThe link between Dynamic ",
 StyleBox["display",
  FontColor->RGBColor[1, 0, 0]],
 " needed to create a change in the Dynamic ",
 StyleBox["value",
  FontColor->RGBColor[1, 0, 0]],
 " is broken."
}], "Text",
 CellChangeTimes->{{3.3894393080220003`*^9, 3.389439330634*^9}, {
  3.389439517454*^9, 3.389439528124*^9}, {3.389439579133*^9, 
