Cell[BoxData[
 RowBox[{
  RowBox[{"LUAnimate", "[", 
   RowBox[{"A_", ",", "f_"}], "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"lu", ",", "l", ",", "u"}], "}"}], ",", " ", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lu", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "l", "}"}], ",", 
          RowBox[{"{", "u", "}"}]}], "}"}]}], "}"}], " ", "=", " ", 
      RowBox[{"Reap", "[", " ", 
       RowBox[{
        RowBox[{"LU", "[", " ", "A", " ", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<L\>\"", ",", " ", "\"\<U\>\""}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"ListAnimate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"l", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "\"\<.\>\"", ",", 
           RowBox[{"f", "[", 
            RowBox[{"u", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "\"\<==\>\"", ",", 
           RowBox[{"f", "[", "A", "]"}]}], "}"}], "]"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "l", "]"}]}], "}"}]}], "\[IndentingNewLine]",
        "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3941223865320086`*^9, 3.3941224181572113`*^9}},
 CellID->600205114],

