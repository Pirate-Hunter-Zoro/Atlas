     RowBox[{"Style", "[", 
      RowBox[{"x", ",", 
       RowBox[{"FontSize", "\[Rule]", "size"}], ",", 
       RowBox[{"Background", "\[Rule]", "back"}], ",", "under"}], "]"}], 
     "]"}], "]"}]}], "\[IndentingNewLine]", "}"}]}], "Input",
 CellChangeTimes->{{3.3894890169636*^9, 3.3894890366345997`*^9}, {
