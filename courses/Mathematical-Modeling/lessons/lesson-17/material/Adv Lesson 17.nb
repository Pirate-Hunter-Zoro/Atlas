Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Animate",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Animate"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["min", "TI"]], ",", 
      ButtonBox["Infinity",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Infinity"]}], "}"}]}], "]"}]], "InlineFormula"],
 " makes an infinite animation in which the value of ",
 Cell[BoxData[
  StyleBox["u", "TI"]], "InlineFormula"],
 " increases forever at a rate of one unit per second. "
}], "Text",
 CellID->6461],

