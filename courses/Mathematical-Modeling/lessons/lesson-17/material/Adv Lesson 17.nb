Cell[TextData[{
 "\n\nIn the following example Dynamic surrounds a ",
 StyleBox["List",
  FontVariations->{"Underline"->True}],
 " with ",
 StyleBox["objects",
  FontVariations->{"Underline"->True}],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"xxxx", "[", "i", "]"}], TraditionalForm]]],
 "\n\n\t",
 StyleBox["Dynamic[{xxxx[1], xxxx[2]}]",
  Background->RGBColor[1, 1, 0]],
 "\n\t\nand it works:"
}], "Text",
 CellChangeTimes->{{3.3894393080220003`*^9, 3.389439330634*^9}, {
  3.389439426474*^9, 3.389439464348*^9}}],

