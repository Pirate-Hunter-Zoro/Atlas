Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"func", "[", "0", "]"}], "=", "Sin"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"func", "[", "1", "]"}], "=", "Cos"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"func", "[", "2", "]"}], "=", "Tan"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"func", "[", "3", "]"}], "=", "Sec"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"func", "[", "4", "]"}], "=", "Cot"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
