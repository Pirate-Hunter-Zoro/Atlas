Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["Dynamic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Dynamic"], "[", 
    RowBox[{
     StyleBox["expr", "TI"], ",", 
     StyleBox["f", "TI"]}], "]"}], TraditionalForm]]]
}], "Subsubsection",
