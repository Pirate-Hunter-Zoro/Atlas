   RowBox[{
    RowBox[{"xxxx", "[", "2", "]"}], "=", ".3"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Slider2D", "[", "\[IndentingNewLine]", 
    StyleBox[
     RowBox[{"Dynamic", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xxxx", "[", "1", "]"}], ",", 
        RowBox[{"xxxx", "[", "2", "]"}]}], "}"}], "]"}],
     Background->RGBColor[1, 1, 0]], "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
