Cell[TextData[{
 "\n",
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 " Dynamic Control is a SetterBar:\n\n\t  ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["1", "TR"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["2", "TR"]], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "}"}], Cell[TextData[{
       StyleBox["setter bar",
        FontColor->RGBColor[1, 0, 0]],
       " for ",
       StyleBox["few",
        FontVariations->{"Underline"->True},
        FontColor->RGBColor[1, 0, 0]],
       " elements; popup menu for more"
      }], "TableText"]}
    }], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389590030516*^9, 3.389590050627*^9}, {3.389590331059*^9,
    3.389590337852*^9}, {3.3895904775*^9, 3.3895904793970003`*^9}, 
   3.389596615632*^9, 3.38961043658*^9}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "f"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{"Sin", ",", "Cos", ",", "Tan", ",", "Cot"}], "}"}]}], "}"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3895899393059998`*^9, 3.389589967664*^9}, {
  3.389590227282*^9, 3.389590242244*^9}, {3.389590380083*^9, 
  3.38959041376*^9}}],

Cell[TextData[{
 "\n",
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 " Dynamic Control is a PopUp: \n\n\t ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["1", "TR"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["2", "TR"]], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "}"}], Cell[TextData[{
       "setter bar for few elements; ",
       StyleBox["popup",
        FontColor->RGBColor[1, 0, 0]],
       " menu for ",
       StyleBox["more",
        FontVariations->{"Underline"->True},
        FontColor->RGBColor[1, 0, 0]]
      }], "TableText"]}
    }], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389590030516*^9, 3.389590050627*^9}, {3.389590331059*^9,
    3.389590337852*^9}, {3.389590495764*^9, 3.3895905050109997`*^9}, 
   3.389596625341*^9, 3.38961042881*^9}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "f"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{
      "Sin", ",", "Cos", ",", "Tan", ",", "Cot", ",", "Sec", ",", "Csc"}], 
