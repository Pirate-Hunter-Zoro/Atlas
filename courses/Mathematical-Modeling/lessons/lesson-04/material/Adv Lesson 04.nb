Copy and Paste this into your code:\
\>", "Text",
 CellChangeTimes->{
  3.439159196515625*^9, {3.4391592646875*^9, 3.439159274625*^9}, {
   3.4391593339375*^9, 3.4391594408125*^9}, {3.439159847671875*^9, 
   3.4391601231875*^9}, {3.43916024796875*^9, 3.4391602801875*^9}, 
   3.43916032865625*^9, {3.43916084959375*^9, 3.4391608798125*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Framed", "[", 
       RowBox[{
        RowBox[{"y", "^", "3"}], "<", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", "x"}]}], "]"}], ",", "16", ",", "Blue",
       ",", 
      RowBox[{"Background", "\[Rule]", 
       RowBox[{"Lighter", "[", "Yellow", "]"}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.439160913828125*^9, 3.439160965609375*^9, {3.43916123765625*^9, 
   3.43916124634375*^9}}],

Cell["\<\

Then modify the above code to meet your specific needs:\
\>", "Text",
