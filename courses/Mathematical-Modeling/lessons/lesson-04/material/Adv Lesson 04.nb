Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Warning: Extreme Example!",
  FontColor->RGBColor[1, 0, 0]],
 "\n\n\tUse many Plot options together:\n\t"
}], "Subsection",
 CellChangeTimes->{{3.3900902646918*^9, 3.3900902693487997`*^9}, {
   3.3900903212788*^9, 3.3900903316168003`*^9}, {3.3900928108608*^9, 
   3.3900928163208*^9}, 3.390102019295*^9, 3.439159452421875*^9}],

Cell[TextData[{
 "Consider one last example which brings everything together:    Plot:    ",
 Cell[BoxData[
  RowBox[{"\[Integral]", 
   RowBox[{
    StyleBox[
     FractionBox["1", "x"],
     FontSize->14], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]],
  FontWeight->"Bold"]
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"\[Integral]", 
     RowBox[{
      FractionBox["1", "x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0.1", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", "0.01", "]"}], ",", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{"0.03", ",", "0.02"}], "}"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Background", "\[Rule]", 
    RowBox[{"GrayLevel", "[", "0.9", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRegion", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.01", ",", "1"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\[IndentingNewLine]", 
    RowBox[{"Style", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Plot of: \>\"", ",", 
         RowBox[{"HoldForm", "[", 
          RowBox[{"\[Integral]", 
           RowBox[{
            FractionBox["1", "x"], 
            RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}]}], "}"}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FontSize", "\[Rule]", "12"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FontWeight", "\[Rule]", "\"\<Bold\>\""}]}], 
     "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "None"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<FrameLabel X values here\>\"", ",", "\"\<Y values here\>\"", ",", 
      "None", ",", "None"}], "}"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900816922628*^9, 3.3900817339788*^9}, {
  3.3900830551798*^9, 3.3900831159407997`*^9}, {3.3900831592878*^9, 
  3.3900832059188004`*^9}, {3.3900832654807997`*^9, 3.3900833737988*^9}, {
  3.390102660493*^9, 3.390102701101*^9}}],

Cell["\<\

The above graph is extremely complicated in nature, much more than what you \
would normally need.  However, it illustrates many of the plotting options.\
\>", "Text",
 CellChangeTimes->{3.439068351171875*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Help!  Do You Really Expect Me To Remember All of This?", "Subsection",
 CellChangeTimes->{{3.439159155546875*^9, 3.439159157828125*^9}, {
  3.43915920065625*^9, 3.439159259390625*^9}, {3.439159309890625*^9, 
  3.439159322703125*^9}, {3.4391598133125*^9, 3.43915983321875*^9}}],

Cell[TextData[{
 StyleBox["No I do not!",
  FontSize->18],
 "\n\nWhat I ",
 StyleBox["EXPECT",
  FontColor->RGBColor[1, 0, 0]],
 " is that you will visit the Help Documentation Center any time you have a \
complicated plot.\n\nFor example, say that you want a more detailed plot \
label for the following plot and you have no idea how to do it."
}], "Text",
 CellChangeTimes->{
  3.439159196515625*^9, {3.4391592646875*^9, 3.439159274625*^9}, {
   3.4391593339375*^9, 3.4391594408125*^9}, {3.439159847671875*^9, 
   3.4391601538125*^9}, {3.439160310734375*^9, 3.439160320890625*^9}, 
   3.439162077703125*^9, 3.439162218921875*^9},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", "\[Pi]", " ", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.439160157015625*^9, 3.4391602213125*^9}, {
  3.43916139228125*^9, 3.439161432625*^9}}],

Cell["\<\

Kind of a pathetic plot label isn't it.

So, go to the Help Documentation Center and enter \"plot label\" and follow \
the links.

