Cell[CellGroupData[{

Cell["Example 2", "Subsection",
 CellChangeTimes->{{3.3895180011652*^9, 3.3895180021862*^9}, {
  3.3895646809788*^9, 3.3895646836218*^9}, {3.390107528738*^9, 
  3.390107534933*^9}, {3.390108126705*^9, 3.390108126902*^9}}],

Cell[TextData[{
 "Dynamic Plot of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", " ", 
    RowBox[{
     RowBox[{
      StyleBox[
       FrameBox["a"],
       Background->RGBColor[1, 1, 0]], " ", "x"}], " ", "+", " ", 
     StyleBox[
      FrameBox["b"],
      Background->RGBColor[1, 1, 0]]}], 
    StyleBox[" ",
     Background->RGBColor[1, 1, 0]], "]"}], TraditionalForm]]],
 " with 2 Sliders Dynamically Manipulating the values of ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["a"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["b"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3895873807320004`*^9, 3.38958738909*^9}, {
   3.389587493933*^9, 3.389587499649*^9}, {3.3895889454230003`*^9, 
   3.389588979231*^9}, {3.3895893178859997`*^9, 3.38958932117*^9}, {
   3.3895906995*^9, 3.389590700689*^9}, {3.389590750007*^9, 
   3.3895907609049997`*^9}, {3.3895909513529997`*^9, 3.389590954752*^9}, {
   3.3895909975629997`*^9, 3.389591004492*^9}, {3.389596507811*^9, 
   3.389596516594*^9}, {3.3895965524849997`*^9, 3.3895965546610003`*^9}, {
   3.389600458373*^9, 3.3896005015550003`*^9}, 3.3896104546*^9, {
   3.390108543186*^9, 3.39010856169*^9}, 3.390108723509*^9, {
   3.390109052689*^9, 3.390109106967*^9}, {3.3901109247860003`*^9, 
   3.390110925257*^9}, {3.390113104436*^9, 3.390113105026*^9}}],

Cell[TextData[{
 "\t",
 StyleBox["Manipulate[\n\t\n\t  Plot[ ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["a"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[" x + ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["b"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[", {x, 0, 2Pi}]",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 "[ ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["a"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[", ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["b"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[" ",
  FontSlant->"Italic"],
 "] you want to control",
 StyleBox["  ",
  FontSlant->"Italic"],
 StyleBox["\n \t\n\t  { ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["a"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[", 1, 5} ,   ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] ",
 StyleBox["continuous",
  FontVariations->{"Underline"->True}],
 " Slider control of ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["a"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 " from 1 to 5\n\n",
 StyleBox["\t  { ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["b"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[", 0, 2Pi, Pi/2}",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\t\[DoubleLongLeftArrow] ",
 StyleBox["discrete",
  FontVariations->{"Underline"->True}],
 " Slider control of ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["b"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 " from 0 to 2\[Pi] in ",
 StyleBox["discrete",
  FontVariations->{"Underline"->True}],
 " steps of \[Pi]/2",
 StyleBox["\n\n\t]\n\t",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\nEvaluate:"
}], "Text",
