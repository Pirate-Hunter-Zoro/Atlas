Cell[TextData[{
 "\t",
 StyleBox["Manipulate[\n\t\n\t  Plot[ ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["f"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[" [x], {x, 0, 2Pi}]",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 "[ ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["f"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[" ",
  FontSlant->"Italic"],
 "] you want to control",
 StyleBox["  ",
  FontSlant->"Italic"],
 StyleBox["\n \t\n\t  { ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["f"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[", {Sin, Cos, Tan, Cot, Sec, Csc}} ,   ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] popup menu control of ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["f"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 " for 6 functions",
 StyleBox["\n\n\t]\n\t",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\nEvaluate:"
}], "Text",
 CellChangeTimes->{{3.389600685666*^9, 3.3896006894639997`*^9}, {
