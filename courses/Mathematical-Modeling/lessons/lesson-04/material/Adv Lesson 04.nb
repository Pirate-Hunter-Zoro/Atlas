  3.390796215467*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Drawing Tools and the Graphics Inspector:", \
"Subtitle"]], "Section",
 CellChangeTimes->{{3.3901133743120003`*^9, 3.390113404869*^9}}],

Cell[TextData[{
 "If you have ever used the Microsoft Paint program contained in the Windows \
operating system, then using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s \"",
 StyleBox["Drawing Tools",
  FontWeight->"Bold"],
 "\" and \"",
 StyleBox["Graphics Inspector",
  FontWeight->"Bold"],
 "\" should be a very straight forward experience.\n\nIn general, you should \
generate the basic plot using one of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s plotting commands like ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot3D", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"ParametricPlot", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " etc. Then, you can modify your plot using the \"",
 StyleBox["Drawing Tools",
  FontWeight->"Bold"],
 "\" and \"",
 StyleBox["Graphics Inspector",
  FontWeight->"Bold"],
 "\"."
}], "Text",
 CellChangeTimes->{{3.390113488016*^9, 3.3901135453310003`*^9}, {
  3.390113624534*^9, 3.3901137892469997`*^9}, {3.390114007666*^9, 
  3.390114240001*^9}, {3.390114273159*^9, 3.390114282677*^9}, {
  3.439068973453125*^9, 3.43906897853125*^9}}],

Cell[TextData[{
 StyleBox["Step 1:",
  FontSize->14,
  FontWeight->"Bold"],
 "  Load the \"",
 StyleBox["Drawing Tools",
  FontWeight->"Bold"],
 "\" and \"",
 StyleBox["Graphics Inspector",
  FontWeight->"Bold"],
 "\":\n\n\t",
 StyleBox["Menu Bar >> Graphics >> Drawing Tools",
  FontWeight->"Bold"],
 "\n\n\t",
 StyleBox["Menu Bar >> Graphics >> Graphics Inspector",
  FontWeight->"Bold"],
 "\n\t"
}], "Text",
 CellChangeTimes->{
  3.3890416107942*^9, {3.3890435835232*^9, 3.3890436335882*^9}, {
   3.3901143031400003`*^9, 3.39011430676*^9}}],

