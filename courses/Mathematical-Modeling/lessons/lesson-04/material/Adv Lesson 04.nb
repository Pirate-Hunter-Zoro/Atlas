Cell[CellGroupData[{

Cell[TextData[{
 "Example 4\n\n",
 StyleBox["Warning: Extreme Example!",
  FontColor->RGBColor[1, 0, 0]],
 " "
}], "Subsection",
 CellChangeTimes->{{3.3895180011652*^9, 3.3895180021862*^9}, {
   3.3895646809788*^9, 3.3895646836218*^9}, {3.390107528738*^9, 
   3.390107534933*^9}, {3.390109586454*^9, 3.390109614106*^9}, 
   3.390109688402*^9}],

Cell[TextData[{
 "The following code illustrates how EASY it is to create EXTREMELY \
COMPLICATED DYNAMIC expressions in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ":\n\n\t",
 StyleBox["Manipulate[",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["expr",
  FontSize->14,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",  ... controls and annotations ... ]",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\n\n\tStep 1: Add the ",
 StyleBox["expr",
  FontSize->14,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 " to be Dynamically Manipulated containing the\n\t\n\t\tSix Variables :   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     FrameBox["a1"],
     Background->RGBColor[1, 1, 0]], " ", ",", " ", 
    StyleBox[
     FrameBox["n1"],
     Background->RGBColor[1, 1, 0]], 
    StyleBox[",",
     Background->RGBColor[1, 1, 0]], " ", 
    StyleBox[
     FrameBox["p1"],
     Background->RGBColor[1, 1, 0]], 
    StyleBox[",",
     Background->RGBColor[1, 1, 0]], 
    StyleBox[" ",
     Background->RGBColor[1, 1, 0]], 
    StyleBox[
     FrameBox["a2"],
     Background->RGBColor[1, 1, 0]], 
    StyleBox[",",
     Background->RGBColor[1, 1, 0]], 
    StyleBox[" ",
     Background->RGBColor[1, 1, 0]], 
    StyleBox[
     FrameBox["n2"],
     Background->RGBColor[1, 1, 0]], 
    StyleBox[",",
     Background->RGBColor[1, 1, 0]], 
    StyleBox[" ",
     Background->RGBColor[1, 1, 0]], 
    StyleBox[
     FrameBox["p2"],
     Background->RGBColor[1, 1, 0]]}], TraditionalForm]]],
 "\n\t\n\t\tThe Dynamic expression containing the six variables is a \
ParametricPlot[ ... ]:\n\t\t\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        StyleBox[
         FrameBox["a1"],
         Background->RGBColor[1, 1, 0]], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          StyleBox[
           FrameBox["n1"],
           Background->RGBColor[1, 1, 0]], " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", 
            StyleBox[
             FrameBox["p1"],
             Background->RGBColor[1, 1, 0]]}], ")"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        StyleBox[
         FrameBox["a2"],
         Background->RGBColor[1, 1, 0]], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{
          StyleBox[
           FrameBox["n2"],
           Background->RGBColor[1, 1, 0]], " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", 
            StyleBox[
             FrameBox["p2"],
             Background->RGBColor[1, 1, 0]]}], ")"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"20", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}]}], 
    "\[IndentingNewLine]", "]"}], TraditionalForm]]],
 "\n\t\n\tStep 2: Add six Dynamic Continuous Sliders (each with an initital \
value and a name) \n\t             separated by a Delimiter:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox[
         FrameBox["n1"],
         Background->RGBColor[1, 1, 0]], ",", "1", ",", "\"\<Frequency\>\""}],
        "}"}], ",", "1", ",", "4"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox[
         FrameBox["a1"],
         Background->RGBColor[1, 1, 0]], ",", "1", ",", "\"\<Amplitude\>\""}],
        "}"}], ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox[
         FrameBox["p1"],
         Background->RGBColor[1, 1, 0]], ",", "0", ",", "\"\<Phase\>\""}], 
       "}"}], ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "Delimiter", ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox[
         FrameBox["n2"],
         Background->RGBColor[1, 1, 0]], ",", 
        RowBox[{"5", "/", "4"}], ",", "\"\<Frequency\>\""}], "}"}], ",", "1", 
      ",", "4"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox[
         FrameBox["a2"],
         Background->RGBColor[1, 1, 0]], ",", "1", ",", "\"\<Amplitude\>\""}],
        "}"}], ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox[
         FrameBox["p2"],
         Background->RGBColor[1, 1, 0]], ",", "0", ",", "\"\<Phase\>\""}], 
       "}"}], ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}]}], TraditionalForm]]],
 "\n\n\tStep 3: Add two Dynamic annotations (i.e. Plots[ ... ]) to be \
Manipulated by the Sliders:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
    RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         StyleBox[
          FrameBox["a1"],
          Background->RGBColor[1, 1, 0]], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"n1", " ", 
           RowBox[{"(", 
            RowBox[{"x", "+", 
             StyleBox[
              FrameBox["p1"],
              Background->RGBColor[1, 1, 0]]}], ")"}]}], "]"}]}], ",", "x"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "\[Rule]", "100"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "Pi"}]}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
     "]"}], "\[IndentingNewLine]", "]"}], TraditionalForm]]],
 "\n\t\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       StyleBox[
        FrameBox["a2"],
        Background->RGBColor[1, 1, 0]], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"n2", " ", 
         RowBox[{"(", 
          RowBox[{"x", "+", 
           StyleBox[
            FrameBox["p2"],
            Background->RGBColor[1, 1, 0]]}], ")"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "\[Rule]", "100"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", "1"}]}], "\[IndentingNewLine]", "]"}], 
    "\[IndentingNewLine]", "]"}], TraditionalForm]]],
 "\n\t\t\n\tStep 4: Place the Controls to the Left of the Dynamically \
Manipulated expression i.e. ParametricPlot[...]:\n\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"ControlPlacement", "\[Rule]", "Left"}], TraditionalForm]]],
 "\n\t\t\n\tStep 5: Then evaluate your code:\n\t\t"
