Cell[TextData[{
 "8:  Using the data generated below:\ni.e.    ",
 Cell[BoxData[
  FormBox[
   RowBox[{"someData", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0.1", "*", "i"}], ",", " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"0.1", "*", "i"}], ")"}], "2"], "+", " ", 
         RowBox[{"0.5", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RandomReal", "[", " ", "]"}], " ", "-", " ", "0.5"}], 
           ")"}]}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "20"}], "}"}]}], "]"}]}], 
   TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3900844959438*^9, 3.3900845341977997`*^9}, 
   3.39038534366296*^9}],

Cell[BoxData[
 RowBox[{"someData", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0.1", " ", "i"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"0.1", " ", "i"}], ")"}], "2"], "+", 
       RowBox[{"0.5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], "-", "0.5"}], ")"}]}]}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "20"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.3900843107598*^9, 3.3900843229458*^9}}],

Cell[TextData[{
 "Part1:  Plot the ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of data with points having a point size of  2% (i.e. .02) of the overall \
graph size.\nPart2:  Define a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]]],
 " to be the function  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]]],
 ".\n            Plot the function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]]],
 "  for  0 \[LessEqual] x \[LessEqual] 2, where the curve has a thickness of  \
1% (i.e. .01) of the overall graph size.\nPart3:  Use the Show[...] command \
to display both of the above graphs at the same time."
}], "Text",
 CellChangeTimes->{{3.3907974754300003`*^9, 3.3907975403129997`*^9}}],

Cell[TextData[{
 "9:  Find the least-squares fit  ",
 Cell[BoxData[
  FormBox["\"\<g\>\"", TraditionalForm]]],
 "  to the data:  someData  generated in problem 8 using the functions:  ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", 
    SuperscriptBox["\[ExponentialE]", "x"]}], "}"}]],
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{
  3.3903853497939596`*^9, 3.390734685818*^9, {3.390797601134*^9, 
   3.390797601337*^9}, {3.39079791525*^9, 3.390797947208*^9}, {
   3.390798255554*^9, 3.390798263193*^9}}],

Cell[TextData[{
 "10:  Plot the least-squares exponential fit  ",
 Cell[BoxData[
  FormBox["\"\<g\>\"", TraditionalForm]]],
 "  to the data so that it has Thickness [.009]  and  Dashing [{.02, .02}]."
}], "Text",
 CellChangeTimes->{{3.39038535451396*^9, 3.39038535509896*^9}, 
   3.3907346922980003`*^9, {3.3907975893570004`*^9, 3.3907975899960003`*^9}}],

Cell[TextData[{
 "11:  Show the list plot of the data, the continuous plot of the function  ",
 Cell[BoxData[
  FormBox["\"\<\!\(\*Cell[\"f\"]\)\>\"", TraditionalForm]]],
 "   and the continuous plot of the \n       function  ",
 Cell[BoxData[
  FormBox["\"\<g\>\"", TraditionalForm]]],
 "  on one graph."
}], "Text",
 CellChangeTimes->{
  3.3903853595769596`*^9, 3.390734698755*^9, {3.390797064483*^9, 
   3.3907970678269997`*^9}, {3.3907972830439997`*^9, 
   3.3907972849300003`*^9}, {3.390797637311*^9, 3.390797693142*^9}}],

