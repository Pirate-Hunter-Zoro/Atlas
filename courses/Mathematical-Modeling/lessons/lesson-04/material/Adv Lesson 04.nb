(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \nAdvanced Lesson 4\n\nGraphics\n\nDr. Dale R. Doty\nUniversity of Tulsa"
}], "Title",
 CellChangeTimes->{{3.390796853674*^9, 3.3907968596549997`*^9}, {
  3.5231822402373114`*^9, 3.5231822434509115`*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Two-Dimensional Plots:", "Subtitle"]], "Section"],

Cell[TextData[{
 "Evaluate (",
 StyleBox["Shift-Enter",
  Background->RGBColor[1, 1, 0]],
 ") the following Input Cell to clear and remove any existing definitions \
from memory before you start this lesson."
}], "Text",
 CellChangeTimes->{{3.3907793381137037`*^9, 3.3907794823047037`*^9}, {
  3.3907795655947037`*^9, 3.3907795802237043`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly"],

Cell[CellGroupData[{

Cell["Plot:", "Subsection"],

Cell[TextData[{
 " The basic command to generate a two-dimensional plot is \"",
 StyleBox["Plot",
  FontWeight->"Bold"],
 "\"."
}], "Text"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", " ", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 " ",
 StyleBox[" \n \n",
  FontWeight->"Bold"],
 "generates a plot of f[x] as a function of x from xmin to xmax."
}], "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900821806418*^9, 3.3900821903668003`*^9}, {
   3.3900823745648003`*^9, 3.3900823828417997`*^9}, 3.3900922554038*^9, 
   3.390102342648*^9},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900823888288*^9, 3.3900823993487997`*^9}}],

Cell[TextData[{
 "\n Generate a plot of a list of functions:  \n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", "x"}], "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"3", "x"}], "]"}]}], "}"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t"
}], "Text",
 CellChangeTimes->{{3.3901023853050003`*^9, 3.390102396502*^9}, 
   3.43906801353125*^9}],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f1", "[", "x", "]"}], ",", " ", 
       RowBox[{"f2", "[", "x", "]"}], ",", " ", "..."}], " ", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 " ",
 StyleBox[" \n \n",
  FontWeight->"Bold"],
 "plots several functions fi[x].\:f3b5"
}], "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900821715698*^9, 3.3900821740358*^9}, {
   3.3900824303928003`*^9, 3.3900824351308002`*^9}, {3.3900912177588*^9, 
   3.3900912206238003`*^9}, 3.390102331336*^9},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], ",", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", "x"}], "]"}], ",", 
     RowBox[{"Sin", "[", 
      RowBox[{"3", "x"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900824466088*^9, 3.3900824563938*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["Options:", "Subsection"],

Cell[" There are many options available for the Plot[...] command.", "Text"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
  "Options", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", "Plot", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900824652578*^9, 3.3900824884618*^9}}],

Cell["\<\

We will look at a few of the more useful options to see how they influence \
the appearance of the graph.\
\>", "Text",
 CellChangeTimes->{3.439068106796875*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Example using Plot options:", "Subsection"],

Cell[TextData[{
 "Consider the following Plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["1", "x"],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "1"}], " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", 
     " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  which uses only default settings:"
}], "Text",
 CellChangeTimes->{3.439068119609375*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   FractionBox["1", "x"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]], "Input"],

Cell[TextData[{
 "\nAlthough the graph generated above is reasonable considering that the \
function becomes infinite at  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "=", " ", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ", its appearance could be improved by restricting the plot's vertical \
range.  This can be accomplished by using the ",
 StyleBox["PlotRange",
  FontWeight->"Bold"],
 " option:"
}], "Text",
 CellChangeTimes->{{3.439068130125*^9, 3.439068138640625*^9}}],

Cell[TextData[{
 "PlotRange ",
 StyleBox[" \n \n",
  FontWeight->"Bold"],
 "is an option for graphics functions that specifies what points to include \
in a plot."
}], "Item",
 CellChangeTimes->{{3.3900821401958*^9, 3.3900821518848*^9}},
 FontWeight->"Bold"],

Cell[TextData[{
 "Restrict the vertical ",
 StyleBox["PlotRange",
  FontWeight->"Bold"],
 " to be between -6 and 6:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900825376848*^9, 3.3900825499208*^9}}],

Cell[TextData[{
 "The appearance of the above graph may or may not be more desirable.\n\n\
Note, it is also possible to have the range of the graph  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "2"}], " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", 
     " ", "2"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   different from the plot ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{" ", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", 
      " ", "1"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 " "
}], "Text",
 CellChangeTimes->{{3.3900825939328003`*^9, 3.3900826034828*^9}, {
  3.43906817*^9, 3.439068176046875*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "6"}], ",", "6"}], "}"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900826128538*^9, 3.3900826232708*^9}}],

Cell[TextData[{
 "\nEventually, you will want to alter the appearance of the curve contained \
within the plot.  Specifically, you would like to alter the style of the plot \
curve.  This can be accomplished with the ",
 StyleBox["PlotStyle",
  FontWeight->"Bold"],
 " option."
}], "Text",
 CellChangeTimes->{3.439068184578125*^9}],

Cell[TextData[{
 "PlotStyle ",
 StyleBox[" \n \n",
  FontWeight->"Bold"],
 "is an option for Plot and ListPlot that specifies the style of lines or \
points to be plotted."
}], "Item",
 CellChangeTimes->{{3.3900821148118*^9, 3.3900821286977997`*^9}},
 FontWeight->"Bold"],

Cell[TextData[{
 "One style is to alter the ",
 StyleBox["thickness",
  FontWeight->"Bold"],
 " of the curve."
}], "Text"],

Cell[TextData[StyleBox["Thickness[r]  \n \nis a graphics directive which \
specifies that lines which follow are to be drawn with a thickness r. \nThe \
thickness r is given as a fraction of the total width of the graph.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900820941528*^9, 3.3900821077408*^9}}],

Cell[TextData[{
 "As an example, increase the ",
 StyleBox["thickness",
  FontWeight->"Bold"],
 " of the curve to be 2% of the total size of the graph:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", ".02", "]"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900826579798*^9, 3.3900826714748*^9}}],

Cell[TextData[{
 "\nThe above thickness is excessive, maybe a thickness of .01 or .005 would \
be better.\n\nAnother style is to apply ",
 StyleBox["dashing",
  FontWeight->"Bold"],
 " to the curve."
}], "Text",
 CellChangeTimes->{{3.439068220953125*^9, 3.439068227390625*^9}}],

Cell[TextData[StyleBox["Dashing[{r1, r2, ... }]  \n \nis a two-dimensional \
graphics directive which specifies that lines which follow are to be drawn \
dashed, with successive segments of lengths r1, r2, ...  (repeated \
cyclically). \nThe ri is given as a fraction of the total width of the graph.\
\"",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900820693048*^9, 3.3900820831048*^9}}],

Cell[TextData[{
 "As an example, apply ",
 StyleBox["dashing",
  FontWeight->"Bold"],
 " to the curve to be 3% \"dash\" followed by 2% \"blank\" of the total size \
of the graph:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", ".01", "]"}], ",", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{".03", ",", ".02"}], "}"}], "]"}]}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900827008868*^9, 3.3900827221948*^9}}],

Cell[TextData[{
 "\nAnother option is to apply ",
 StyleBox["GridLines",
  FontWeight->"Bold"],
 " and/or a ",
 StyleBox["Frame",
  FontWeight->"Bold"],
 " to our graph:"
}], "Text",
 CellChangeTimes->{3.439068246453125*^9}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Frame  \n \nis an option for two-dimensional graphics \
functions which specifies whether a frame should be drawn around the plot.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900820370098*^9, 3.3900820556127996`*^9}}],

Cell[TextData[StyleBox["GridLines  \n \nis an option for two-dimensional \
graphics functions that specifies grid lines.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900820341768*^9, 3.3900820606018*^9}}],

Cell["\<\
Automatic

represents an option or other value that is to be chosen automatically by a \
built-in function.\
\>", "Item",
 CellChangeTimes->{{3.390102492164*^9, 3.390102516125*^9}},
 FontWeight->"Bold"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", ".01", "]"}], ",", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{".03", ",", ".02"}], "}"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900827499068003`*^9, 3.3900827776598*^9}}],

Cell["\<\

Another option is to apply a background color to our graph:\
\>", "Text",
 CellChangeTimes->{3.4390682606875*^9}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Background  \n \nis an option which specifies the \
background color to use.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900820029068003`*^9, 3.3900820274048*^9}}],

Cell[TextData[StyleBox["GrayLevel[level]  \n \nis a graphics directive which \
specifies the gray-level intensity with which graphical objects that follow \
should be displayed.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900820058417997`*^9, 3.3900820242868*^9}}],

Cell[TextData[StyleBox["Hue[h]  \n \nis a graphics directive which specifies \
that graphical objects which follow are to be displayed, if possible, in a \
color corresponding to hue h.\nHue[h, s, b] specifies colors in terms of hue, \
saturation and brightness.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900819726928*^9, 3.3900819925148*^9}}],

Cell[TextData[{
 "RGBColor[red, green, blue]",
 StyleBox["\n ",
  FontWeight->"Bold"],
 "\[LineSeparator]is a graphics directive which specifies that objects which \
follow are to be displayed, if possible, in the color given. "
}], "Item",
 FontWeight->"Bold"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", ".01", "]"}], ",", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{".03", ",", ".02"}], "}"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Background", "\[Rule]", 
    RowBox[{"GrayLevel", "[", "0.9", "]"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900827888908*^9, 3.3900828162708*^9}}],

Cell[TextData[{
 "\nAnother option is to restrict the ",
 StyleBox["plot region",
  FontWeight->"Bold"],
 " of our graph (i.e. shrink the graph so that it does not expand to the \
outer edges of our plot region):"
}], "Text",
 CellChangeTimes->{3.4390682721875*^9}],

Cell[TextData[StyleBox["PlotRegion  \n \nis an option for graphics functions \
that specifies what region of the final display area a plot should fill.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900819481738*^9, 3.3900819666008*^9}, 
   3.3900822240608*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", ".01", "]"}], ",", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{".03", ",", ".02"}], "}"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Background", "\[Rule]", 
    RowBox[{"GrayLevel", "[", "0.9", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRegion", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{".05", ",", ".95"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{".05", ",", ".95"}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900828311688004`*^9, 3.3900828567128*^9}}],

Cell[TextData[{
 "\nApply a ",
 StyleBox["PlotLabel",
  FontWeight->"Bold"],
 " to our graph:"
}], "Text",
 CellChangeTimes->{3.43906829240625*^9}],

Cell[TextData[StyleBox["PlotLabel  \n \nis an option for graphics functions \
that specifies an overall label for a plot.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900819286538*^9, 3.3900819408248*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", ".01", "]"}], ",", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{".03", ",", ".02"}], "}"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Background", "\[Rule]", 
    RowBox[{"GrayLevel", "[", "0.9", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRegion", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{".05", ",", ".95"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{".05", ",", ".95"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Plot of: 1/x\>\""}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900828662658*^9, 3.3900828977738*^9}}],

Cell["\<\

Apply a style to the plot label:\
\>", "Text",
 CellChangeTimes->{3.439068302109375*^9}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Style[expr, options]  \n \nprints using the specified \
style options.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900818714388*^9, 3.3900818899958*^9}, {
  3.3975614327710414`*^9, 3.3975614334272957`*^9}}],

Cell[TextData[StyleBox[" Style[expr, \"style\"]  \n \nprints using the \
specified cell style in the current notebook.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900818714388*^9, 3.3900819081488*^9}, {
  3.397561436239814*^9, 3.3975614370210686`*^9}}]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", "0.01", "]"}], ",", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{"0.03", ",", "0.02"}], "}"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Background", "\[Rule]", 
    RowBox[{"GrayLevel", "[", "0.9", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRegion", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.05", ",", "0.95"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.05", ",", "0.95"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\[IndentingNewLine]", 
    RowBox[{"Style", "[", "\[IndentingNewLine]", 
     RowBox[{"\"\<Plot of: 1/x\>\"", ",", "\[IndentingNewLine]", 
      RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FontSize", "\[Rule]", "14"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FontWeight", "\[Rule]", "\"\<Bold\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FontSlant", "\[Rule]", "\"\<Italic\>\""}]}], 
     "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900818300378*^9, 3.3900818479758*^9}, {
  3.3900829100548*^9, 3.3900829582338*^9}, {3.3901025736470003`*^9, 
  3.3901025998120003`*^9}}],

Cell[TextData[{
 "\nApply an ",
 StyleBox["axis label",
  FontWeight->"Bold"],
 " and/or ",
 StyleBox["frame label",
  FontWeight->"Bold"],
 " to our graph:"
}], "Text",
 CellChangeTimes->{3.439068311984375*^9}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["AxesLabel  \n \nis an option for graphics functions \
that specifies labels for axes.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900817952678003`*^9, 3.3900818187608*^9}}],

Cell[TextData[StyleBox["FrameLabel  \n \nis an option for two-dimensional \
graphics functions that specifies labels to be placed on the edges of a frame \
around a plot.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900817966108*^9, 3.3900818212648*^9}}]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["1", "x"], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", "0.01", "]"}], ",", 
      RowBox[{"Dashing", "[", 
       RowBox[{"{", 
        RowBox[{"0.03", ",", "0.02"}], "}"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Background", "\[Rule]", 
    RowBox[{"GrayLevel", "[", "0.9", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRegion", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.05", ",", "0.95"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.05", ",", "0.95"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\[IndentingNewLine]", 
    RowBox[{"Style", "[", "\[IndentingNewLine]", 
     RowBox[{"\"\<Plot of: 1/x\>\"", ",", "\[IndentingNewLine]", 
      RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FontSize", "\[Rule]", "14"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FontWeight", "\[Rule]", "\"\<Bold\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FontSlant", "\[Rule]", "\"\<Italic\>\""}]}], 
     "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "None"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Label X values here\>\"", ",", "\"\<Label Y values here\>\"", ",", 
      "None", ",", "None"}], "}"}]}]}], "\[IndentingNewLine]", 
