  3.439159196515625*^9, {3.4391592646875*^9, 3.439159274625*^9}, {
   3.4391593339375*^9, 3.4391594408125*^9}, {3.439159847671875*^9, 
   3.4391601231875*^9}, {3.43916024796875*^9, 3.4391602801875*^9}, 
