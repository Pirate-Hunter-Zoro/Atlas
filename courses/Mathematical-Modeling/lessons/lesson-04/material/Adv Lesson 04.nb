Cell[TextData[{
 "The Dynamic Control is a ",
 StyleBox["PopUp Menu",
  FontWeight->"Bold"],
 " for the 6 functions: ",
 StyleBox["{Sin, Cos, Tan, Cot, Sec, Csc}",
  FontWeight->"Bold"]
}], "Text",
