Cell[TextData[{
 StyleBox["Step 2:",
  FontSize->14,
  FontWeight->"Bold"],
 "  Type:\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", 
        RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   \n\t\ninto an ",
 StyleBox["Input Cell",
  FontWeight->"Bold"],
 " within a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " window and ",
 StyleBox["evaluate",
  FontWeight->"Bold"],
 " to generate a ",
 StyleBox["plot",
  FontWeight->"Bold"],
 " of the sine curve."
}], "Text",
 CellChangeTimes->{{3.3890414813361998`*^9, 3.3890415159312*^9}, 
   3.3890436859252*^9, {3.3890439495692*^9, 3.3890441514561996`*^9}, {
   3.3890450939702*^9, 3.3890451248982*^9}, {3.3890451725632*^9, 
   3.3890453311202*^9}, {3.3890454023892*^9, 3.3890454779872*^9}, {
   3.3890455234152*^9, 3.3890455484572*^9}, {3.3890455886052*^9, 
   3.3890455942292*^9}, {3.3890456411792*^9, 3.3890456821542*^9}, {
   3.3890457134972*^9, 3.3890458060601997`*^9}, {3.3890460133422003`*^9, 
   3.3890460770822*^9}, {3.3890461264142*^9, 3.3890461496502*^9}, 
   3.390113830723*^9, {3.390114345012*^9, 3.390114349824*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{3.390113879067*^9}],

Cell[TextData[{
 "\n",
 StyleBox["Step 3:",
  FontSize->14,
  FontWeight->"Bold"],
 "  \tPlace the mouse cursor over the ",
 StyleBox["plot",
  FontWeight->"Bold"],
 " and click to select the plot.\n\t\t(Note the orange outline box \
surrounding the plot.)\n\n\t\tPlace the mouse cursor over the ",
 StyleBox["sine curve",
  FontWeight->"Bold"],
 " within the plot and click several times until selected.\n\t\tNote the \
appearance of    ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[DiamondSuit]", 
     AdjustmentBox["+",
      BoxMargins->{{-0.9047619047619051, 0.9047619047619051}, {0., 0.}}]}],
    FontSize->16,
    FontWeight->"Bold"], TraditionalForm]]],
 "adjacent to the cursor when you are over the ",
 StyleBox["selected",
  FontWeight->"Bold"],
 " sine curve and\n\t\talso note several nested orange outline boxes as \
illustrated below.\n  \n\t\t\tThen adjust the ",
 StyleBox["Thickness",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Dashing",
  FontWeight->"Bold"],
 " for the curve as indicated below :"
}], "Text",
 CellChangeTimes->{{3.3890414813361998`*^9, 3.3890415159312*^9}, 
   3.3890436859252*^9, {3.3890439495692*^9, 3.3890441514561996`*^9}, {
   3.3890450939702*^9, 3.3890451248982*^9}, {3.3890451725632*^9, 
   3.3890453311202*^9}, {3.3890454023892*^9, 3.3890454779872*^9}, {
   3.3890455234152*^9, 3.3890455484572*^9}, {3.3890455886052*^9, 
   3.3890455942292*^9}, {3.3890456411792*^9, 3.3890456821542*^9}, {
   3.3890457134972*^9, 3.3890458060601997`*^9}, {3.3890460133422003`*^9, 
   3.3890460770822*^9}, {3.3890461264142*^9, 3.3890461496502*^9}, 
   3.390113830723*^9, 3.390113889993*^9, {3.390114367031*^9, 
   3.3901143784119997`*^9}}],

