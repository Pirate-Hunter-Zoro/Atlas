Cell[CellGroupData[{

Cell["Example 1", "Subsection",
 CellChangeTimes->{{3.3895180011652*^9, 3.3895180021862*^9}, {
  3.3895646809788*^9, 3.3895646836218*^9}, {3.390107528738*^9, 
  3.390107534933*^9}}],

Cell[TextData[{
 "\n\t",
 StyleBox["Manipulate[\n\t\n\t  Plot[ Sin[ ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["n"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[" 2 Pi x ] , {x, 0, 1}]",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 "[ ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["n"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 " ] you want to control",
 StyleBox["  ",
  FontSlant->"Italic"],
 StyleBox["\n \t\n\t  { ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["n"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 StyleBox[", 1, 5} ,   ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] continuous Slider control of ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FrameBox["n"],
    Background->RGBColor[1, 1, 0]], TraditionalForm]]],
 " from 1 to 5",
 StyleBox["\n\n\t]",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\n"
}], "Text",
 CellChangeTimes->{{3.389600685666*^9, 3.3896006894639997`*^9}, {
   3.389600854349*^9, 3.389600862738*^9}, 3.389600927474*^9, {
