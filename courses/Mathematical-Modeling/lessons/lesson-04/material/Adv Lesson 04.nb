Cell["\<\
Evaluate the following code and move the Slider to see what happens:\
\>", "Text",
 CellChangeTimes->{{3.389601590756*^9, 3.3896016086870003`*^9}, {
  3.3896554699458*^9, 3.3896554801448*^9}, {3.3896555236478*^9, 
