   3.439160996546875*^9, 3.439161024046875*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Framed", "[", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], "]"}], ",", "18", ",", 
      RowBox[{"Darker", "[", "Blue", "]"}], ",", "Bold", ",", 
      RowBox[{"Background", "\[Rule]", "None"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.439160913828125*^9, 3.439160965609375*^9, {3.439161045015625*^9, 
   3.439161105234375*^9}, {3.43916125175*^9, 3.43916125653125*^9}, 
   3.439161477484375*^9}],

Cell[TextData[{
 "\nRemember, you can not hope to know and understand all of the options \
available in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". Therefore, you must learn to search through examples to find something \
close to what you really want. Then copy, paste and modify to meet your needs."
}], "Text",
 CellChangeTimes->{
  3.439159196515625*^9, {3.4391592646875*^9, 3.439159274625*^9}, {
   3.4391593339375*^9, 3.4391594408125*^9}, {3.439159847671875*^9, 
   3.4391601231875*^9}, {3.43916024796875*^9, 3.4391602801875*^9}, 
   3.43916032865625*^9, {3.43916084959375*^9, 3.4391608798125*^9}, {
   3.439160996546875*^9, 3.439161024046875*^9}, {3.439161831515625*^9, 
   3.439162008*^9}},
 FontWeight->"Bold"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Show Command:", "Subtitle"]], "Section"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " generates a ",
 StyleBox["PostScript",
  FontWeight->"Bold"],
 " description of each graph that is generated in your notebook.  It is \
possible to save the ",
 StyleBox["PostScript",
  FontWeight->"Bold"],
 " description and ",
 StyleBox["show",
  FontWeight->"Bold"],
 " it later.  Even more important, it is possible to combine several \
different graphs together using the ",
 StyleBox["show",
  FontWeight->"Bold"],
 " command.  The general outline is as follows:\n\n",
 StyleBox["\tplot1 = Plot[...]\n\t\n\t...  some code  ...\n\t\n\tplot2 = \
Plot[...]\n\t\n\t...  some code  ...\n\t\n\tplot3 = Plot[...]\n\t\n\t...  \
some code  ...\n\t\n\tShow[ plot1, plot2, plot3 ]",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.3900834515818*^9, 3.3900834808358*^9}}],

Cell[CellGroupData[{

Cell["Example:", "Subsection"],

Cell[BoxData[
 RowBox[{"plot1", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"plot2", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"plot3", "=", 
  RowBox[{"Plot", "[", " ", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", "x"], " ", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}]], "Input"],

Cell[TextData[{
 "Show[g1, g2, ... ] ",
 StyleBox[" \n \n",
  FontWeight->"Bold"],
 "shows several plots combined."
}], "Item",
 CellChangeTimes->{{3.3900816651658*^9, 3.3900816765158*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"plot1", ",", "plot2", ",", "plot3", ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.3900835600038*^9, 3.3900835673648*^9}}],

Cell[TextData[{
 "\nObserve that even though the range of ",
 StyleBox["plot3",
  FontWeight->"Bold"],
 " was different than the range of ",
 StyleBox["plot1",
  FontWeight->"Bold"],
 " and ",
 StyleBox["plot2",
  FontWeight->"Bold"],
 ", the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Show", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command combined them together correctly.\n\nWhat is even more surprising \
is that the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Show", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command can combine any type of 2D graphics together automatically.  The \
following section will show how a ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " and a ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"ListPlot", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " can be combined automatically."
}], "Text",
 CellChangeTimes->{{3.439068418125*^9, 3.439068473140625*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["ListPlot and ParametricPlot:", "Subtitle"]], "Section"],

Cell[CellGroupData[{

Cell["ListPlot:", "Subsection"],

Cell[TextData[{
 "Consider the following problem:  \n\t1: Generate some data with ",
 StyleBox["random",
  FontWeight->"Bold"],
 " noise\n\t2: Plot the list of data using ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"ListPlot", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t3: Find the linear quadratic least squares ",
 StyleBox["fit",
  FontWeight->"Bold"],
 " to the data\n\t4: Plot the least squares function using ",
 StyleBox["Plot[...]",
  FontWeight->"Bold"],
 "\n\t5: Show the ListPlot and the Plot together using the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Show", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command\n\t\nTo create some data, we will generate a list (i.e. ",
 StyleBox["table",
  FontWeight->"Bold"],
 ") of numbers corresponding to a quadratic function with some ",
 StyleBox["random",
  FontWeight->"Bold"],
 " noise."
}], "Text",
 CellChangeTimes->{{3.4390685003125*^9, 3.43906852296875*^9}}],

Cell[TextData[{
 "RandomReal[ ] ",
 StyleBox[" \n \n",
  FontWeight->"Bold"],
 "gives a uniformly distributed pseudorandom Real in the range 0 to 1."
}], "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900816091647997`*^9, 3.3900816311038*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"someData", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0.1", " ", "i"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"0.1", " ", "i"}], ")"}], "2"], "+", 
       RowBox[{"0.5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], "-", "0.5"}], ")"}]}]}]}], "}"}], 
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "20"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3900816455758*^9, 3.3900816544358*^9}, 
   3.3900822503638*^9, {3.3900836077567997`*^9, 3.3900836233728*^9}}],

Cell[TextData[{
 "\nWe can plot this list of data using just the  ",
 StyleBox["y",
  FontWeight->"Bold"],
 "  coordinate vs. its number location within the list (i.e. 1, 2, 3, etc.) \
or we can plot a list of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  data points:"
}], "Text",
 CellChangeTimes->{{3.439068550671875*^9, 3.439068569984375*^9}}],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"ListPlot", "[", 
    RowBox[{"{", 
     RowBox[{"y1", ",", " ", "y2", ",", " ", "..."}], " ", "}"}], "]"}], 
   TraditionalForm]]],
 " ",
 StyleBox["  \n\n",
  FontWeight->"Bold"],
 "plots a list of values. The x coordinates for each point are taken to be 1, \
2, ... .",
 StyleBox[" ",
  FontWeight->"Bold"]
}], "Item",
 CellChangeTimes->{{3.3900813983227997`*^9, 3.3900814301118*^9}, {
   3.3900815952868*^9, 3.3900815997757998`*^9}, {3.3900928590108*^9, 
   3.3900928625878*^9}, 3.390102814684*^9},
 FontWeight->"Bold"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"ListPlot", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1", ",", " ", "y1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x2", ",", " ", "y2"}], "}"}], ",", " ", "..."}], " ", "}"}], 
    "]"}], TraditionalForm]]],
 " ",
 StyleBox["  \n\n",
  FontWeight->"Bold"],
 "plots a list of values with specified x and y coordinates."
}], "Item",
 CellChangeTimes->{{3.3900813983227997`*^9, 3.3900814301118*^9}, {
   3.3900815952868*^9, 3.3900815997757998`*^9}, 3.3900928590108*^9, 
   3.390102823977*^9},
 FontWeight->"Bold"]
}, Open  ]],

Cell[TextData[{
 "Plot this list of  ",
 Cell[BoxData[
  FormBox[Cell[TextData[StyleBox["{x, y}",
    FontWeight->"Bold"]]], TraditionalForm]]],
 "  data points data using ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"ListPlot", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3900837000788*^9, 3.3900837029048*^9}, 
   3.3901028422*^9, {3.439068580546875*^9, 3.439068587125*^9}}],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "someData", "]"}]], "Input"],

Cell[TextData[{
 "\nThe appearance can be improved by applying a ",
 StyleBox["PlotStyle",
  FontWeight->"Bold"],
 " to increase the ",
 StyleBox["PointSize",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{3.439068595734375*^9}],

Cell[CellGroupData[{

Cell[TextData[{
 "PlotStyle",
 StyleBox["  \n\n",
  FontWeight->"Bold"],
 "is an option for Plot and ListPlot that specifies the style of lines or \
points to be plotted."
}], "Item",
 CellChangeTimes->{{3.3900813155688*^9, 3.3900813225098*^9}, {
   3.3900813826717997`*^9, 3.3900813900098*^9}, 3.3900815866528*^9},
 FontWeight->"Bold"],

Cell[TextData[StyleBox["PointSize[d]  \n\nis a graphics directive which \
specifies that points which follow are to be shown if possible as circular \
regions with diameter d. \nThe diameter d is given as a fraction of the total \
width of the graph. ",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900813077608*^9, 3.3900813746728*^9}, 
   3.3900815823998003`*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{"plot1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"someData", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"PointSize", "[", "0.02", "]"}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3900837235298*^9, 3.3900837356598*^9}, {
  3.3900913734578*^9, 3.3900913774838*^9}}],

Cell[TextData[{
 "\nObserve that the ",
 StyleBox["list plot",
  FontWeight->"Bold"],
 " information has been stored in \"",
 StyleBox["plot1",
  FontWeight->"Bold"],
 "\".\n\nIt is now easy to determine a least squares linear ",
 StyleBox["fit",
  FontWeight->"Bold"],
 " to our data set."
}], "Text",
 CellChangeTimes->{{3.439068608140625*^9, 3.4390686236875*^9}}],

Cell[TextData[{
 "Fit[data, funs, vars]    ",
 StyleBox["  \n\n",
  FontWeight->"Bold"],
 "finds a least-squares fit to a list of data as a linear combination of the \
functions funs of variables vars. "
}], "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900812886647997`*^9, 3.3900812983008003`*^9}, 
   3.3900814383448*^9, 3.3900815735058002`*^9},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{"Fit", "[", 
   RowBox[{"someData", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "x", ",", 
      SuperscriptBox["x", "2"]}], "}"}], ",", "x"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.3901028834519997`*^9, 3.3901028870629997`*^9}}],

Cell[TextData[{
 "\nObserve what is stored in \"",
 StyleBox["f",
  FontWeight->"Bold"],
 "\":"
}], "Text",
 CellChangeTimes->{{3.3900837762248*^9, 3.3900837947237997`*^9}, 
   3.439068636078125*^9}],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[TextData[{
 "\n  Plot our least squares quadratic fit to the data using ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{{3.43906864565625*^9, 3.439068650984375*^9}}],

Cell[BoxData[
 RowBox[{"plot2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", " ", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "->", " ", 
     RowBox[{"{", 
      RowBox[{"Thickness", " ", "[", ".009", "]"}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3900838084748*^9, 3.3900838253557997`*^9}, {
  3.39079836634*^9, 3.390798370189*^9}}],

Cell[TextData[{
 "\nObserve that the ",
 StyleBox["plot",
  FontWeight->"Bold"],
 " information has been stored in \"",
 StyleBox["plot2",
  FontWeight->"Bold"],
 "\".\n",
 StyleBox["\nMathematica",
  FontSlant->"Italic"],
 " has a common form for storing 2-dimensional graphs of different types.  \
Therefore we can \"",
 StyleBox["show",
  FontWeight->"Bold"],
 "\" both our ",
 StyleBox["ListPlot",
  FontWeight->"Bold"],
 " of the data and our continuous ",
 StyleBox["Plot",
  FontWeight->"Bold"],
 " of the function on one graph."
}], "Text",
 CellChangeTimes->{{3.4390686576875*^9, 3.43906866784375*^9}}],

Cell[TextData[{
 "Show[g1, g2, ... ]    ",
 StyleBox["  \n\n",
  FontWeight->"Bold"],
 "shows several plots combined."
}], "Item",
 CellChangeTimes->{{3.3900812772458*^9, 3.3900812824807997`*^9}, 
   3.3900814489628*^9, {3.3900815630708*^9, 3.3900815655538*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Show", " ", "[", 
    RowBox[{"plot1", ",", " ", "plot2"}], "]"}], "\n"}]}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["ParametricPlot:", "Subsection"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"ParametricPlot", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fx", "[", "t", "]"}], ",", " ", 
       RowBox[{"fy", "[", "t", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "tmin", ",", " ", "tmax"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "    ",
 StyleBox[" \n \n",
  FontWeight->"Bold"],
 "produces a parametric plot with x and y coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"fx", "[", "t", "]"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"fy", "[", "t", "]"}], TraditionalForm]]],
 " generated as a function of t. "
}], "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900812629298*^9, 3.3900812722158003`*^9}, 
   3.3900814562418003`*^9, 3.3900815569388*^9, {3.3900838693458*^9, 
   3.3900838735768003`*^9}, {3.3901029306870003`*^9, 3.39010297059*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", ".009", "]"}], ",", "Orange"}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900838521057997`*^9, 3.3900838607838*^9}, {
  3.3900929496768*^9, 3.3900929767208*^9}, {3.390103040736*^9, 
  3.390103047039*^9}, {3.390103079873*^9, 3.390103103414*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Warning: Extreme Example!",
  FontColor->RGBColor[1, 0, 0]],
 "  \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot", "[", " ", "...", " ", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", " ", "...", " ", "]"}]}], "\[IndentingNewLine]", 
    "  ", "]"}], TraditionalForm]]]
}], "Subsection",
 CellChangeTimes->{{3.3900897914578*^9, 3.3900898490987997`*^9}, {
  3.3900899370548*^9, 3.3900899958417997`*^9}, {3.3900930103308*^9, 
  3.3900930106888*^9}, {3.3901019490959997`*^9, 3.390101967467*^9}}],

Cell[TextData[{
 "Use the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Show", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command to combine two very different and very intricate 2-D plots:\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"plot1", "=", 
     RowBox[{"ParametricPlot", "[", " ", "...", " ", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\nand\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"plot2", "=", 
     RowBox[{"Plot", "[", " ", "...", " ", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3900859415278*^9, 3.3900859503378*^9}, {
   3.3900860307208*^9, 3.3900860391868*^9}, {3.3900862576498003`*^9, 
   3.3900863665188*^9}, {3.3900870127488003`*^9, 3.3900870503398*^9}, {
   3.3900889776098003`*^9, 3.3900889876738*^9}, {3.3900898614077997`*^9, 
   3.3900899259628*^9}, 3.439068703046875*^9}],

Cell[TextData[{
 "How about a 2-D ",
 StyleBox["parametric plot",
  FontWeight->"Bold"],
 " with intricate color shading:"
}], "Text",
 CellChangeTimes->{{3.3900900266588*^9, 3.3900900721168003`*^9}}],

Cell[CellGroupData[{

Cell[TextData[{
 "Mesh",
 StyleBox["\n",
  FontWeight->"Bold"],
 "\nis an option for that specifies what mesh should be drawn. "
}], "Item",
 CellChangeTimes->{{3.3900931081448*^9, 3.3900931498218*^9}, 
   3.3900931914428*^9},
 FontWeight->"Bold"],

Cell["\<\
MeshFunctions

is an option for plotting functions that specifies functions to use to \
determine the placement of mesh divisions.\
\>", "Item",
 CellChangeTimes->{{3.3900932359168*^9, 3.3900932373938*^9}},
 FontWeight->"Bold"],

Cell["\<\
MeshShading

is an option for plotting functions that gives lists of colors to use for \
regions between mesh divisions.\
\>", "Item",
 CellChangeTimes->{{3.390101855854*^9, 3.390101883049*^9}},
 FontWeight->"Bold"],

Cell["\<\
MeshStyle

is an option for plotting functions that specifies the style in which to draw \
a mesh.\
\>", "Item",
 CellChangeTimes->{{3.390101861146*^9, 3.390101861314*^9}, {3.390101909815*^9,
   3.390101923627*^9}},
 FontWeight->"Bold"],

Cell[TextData[StyleBox["AspectRatio      \n\nis an option for Show and \
related functions which specifies the ratio of height to width for a plot.",
 FontWeight->"Bold"]], "Item",
 CellChangeTimes->{{3.3900812467938004`*^9, 3.3900812576328*^9}, 
   3.3900814662167997`*^9, 3.3900815378758*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{"plot1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["u", "2"], " ", 
        RowBox[{"Cos", "[", "u", "]"}]}], "+", "4"}], ",", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["u", "15"]}], " ", 
       RowBox[{"Sin", "[", "u", "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "0", ",", 
      RowBox[{"4", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Thickness", "[", "0.01", "]"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Mesh", "\[Rule]", "20"}], ",", "\[IndentingNewLine]", 
    RowBox[{"MeshShading", "\[Rule]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Hue", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "1", ",", ".05"}], "}"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"MeshStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PointSize", "[", ".02", "]"}], ",", "Orange"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3900880534147997`*^9, 3.3900880889438*^9}, {
   3.3900883442068*^9, 3.3900883745987997`*^9}, {3.3900884748417997`*^9, 
   3.3900885342708*^9}, {3.3900885781708*^9, 3.3900887120657997`*^9}, {
   3.3900887941188*^9, 3.3900887957438*^9}, {3.3900888790778*^9, 
   3.3900889052988*^9}, {3.3900892403498*^9, 3.3900892454428*^9}, {
   3.3900893667058*^9, 3.3900893927458*^9}, {3.3900894625198*^9, 
   3.3900895521078*^9}, {3.3900895858297997`*^9, 3.3900896208468*^9}, 
   3.3900897265418*^9, {3.3901045181549997`*^9, 3.3901045304119997`*^9}, {
   3.3901045604519997`*^9, 3.3901045610220003`*^9}}],

Cell[TextData[{
 "\nHow about a standard 2-D ",
 StyleBox["plot",
  FontWeight->"Bold"],
 " with colored filling:"
}], "Text",
 CellChangeTimes->{{3.3900901025078*^9, 3.3900901392418003`*^9}, 
   3.3906523453640003`*^9}],

Cell["\<\
Filling

is an option for plot functions which specifies what filling to add under \
points, curves and surfaces.\
\>", "Item",
 CellChangeTimes->{{3.390102256434*^9, 3.390102292773*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"plot2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BesselJ", "[", 
        RowBox[{"n", ",", "x"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "4"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Filling", "\[Rule]", "Axis"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3900882929378*^9, 3.3900883158638*^9}, {
  3.3900887251678*^9, 3.3900887566898003`*^9}, {3.3900896432628*^9, 
  3.3900896725137997`*^9}}],

Cell[TextData[{
 "\nUse the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Show", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command to combine the two 2-D plots:\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"plot1", "=", 
     RowBox[{"ParametricPlot", "[", " ", "...", " ", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\nand\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"plot2", "=", 
     RowBox[{"Plot", "[", " ", "...", " ", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3900859415278*^9, 3.3900859503378*^9}, {
  3.3900860307208*^9, 3.3900860391868*^9}, {3.3900862576498003`*^9, 
  3.3900863665188*^9}, {3.3900870127488003`*^9, 3.3900870503398*^9}, {
  3.3900889776098003`*^9, 3.3900889876738*^9}, {3.3900898614077997`*^9, 
  3.3900899259628*^9}, {3.3900901911868*^9, 3.3900902067538*^9}, {
  3.439068752703125*^9, 3.43906876075*^9}}],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"plot1", ",", "plot2"}], "]"}]], "Input",
 CellChangeTimes->{{3.3900887601148*^9, 3.3900887678328*^9}, {
  3.3900894179058*^9, 3.3900894392167997`*^9}, {3.3900896778068*^9, 
  3.3900897082698*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Three-Dimensional Plots:", "Subtitle"]], "Section"],

Cell[CellGroupData[{

Cell["Plot3D:", "Subsection"],

Cell[TextData[{
 "It is also possible to generate a 3 dimensional plot over a rectangular \
domain using the command ",
 StyleBox["Plot3D",
  FontWeight->"Bold"],
 "."
}], "Text"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Plot3D", "[", " ", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "ymin", ",", " ", "ymax"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "    ",
 StyleBox["  \n\n",
  FontWeight->"Bold"],
 "generates a three-dimensional plot of f as a function of x and y. "
}], "Item",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900812258288*^9, 3.3900812360278*^9}, 
   3.3900814765888*^9, 3.3900815294468*^9, {3.3900839113817997`*^9, 
   3.3900839137108*^9}, {3.390103179712*^9, 3.390103186624*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"x", "*", "y"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "\[Pi]"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "\[Pi]"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900839212088003`*^9, 3.3900839496208*^9}}],

Cell["\<\
Just for fun, click your mouse on the above plot and rotate it to see the \
\"bottom\" side of the plot.\
\>", "Text",
 CellChangeTimes->{{3.3900840035338*^9, 3.3900841094198*^9}, {
  3.3900851928308*^9, 3.3900851971428003`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["Options:", "Subsection"],

Cell["\<\
There are many options available for the Plot3D[...] command.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
  "Options", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", "Plot3D", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900841268417997`*^9, 3.3900841349488*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["ContourPlot:", "Subsection"],

Cell["\<\
It is also possible to generate a contour plot over a rectangular domain \
using the command ContourPlot.\
\>", "Text"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"ContourPlot", "[", " ", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "ymin", ",", " ", "ymax"}], "}"}]}], "]"}], 
   TraditionalForm]]],
 "   ",
 StyleBox["  \n\n",
  FontWeight->"Bold"],
 "generates a contour plot of f as a function of x and y."
}], "Item",
 CellChangeTimes->{{3.3900811529978*^9, 3.3900812203398*^9}, 
   3.3900814844558*^9, 3.3900815214898*^9, {3.3900841529838*^9, 
   3.3900841569638*^9}, {3.390103204316*^9, 3.3901032135220003`*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"x", "*", "y"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "\[Pi]"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "\[Pi]"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "30"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900841660388002`*^9, 3.3900841995838003`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["DensityPlot:", "Subsection"],

Cell["\<\
It is also possible to generate a density plot over a rectangular domain \
using the command DensityPlot.\
\>", "Text"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"DensityPlot", "[", " ", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "ymin", ",", " ", "ymax"}], "}"}]}], "]"}], 
    "   "}], TraditionalForm]]],
 StyleBox["\n",
  FontWeight->"Bold"],
 " ",
 StyleBox[" \n",
  FontWeight->"Bold"],
 "makes a density plot of f as a function of x and y."
}], "Item",
 CellChangeTimes->{{3.3900811404348*^9, 3.3900811438677998`*^9}, {
  3.3900812123578*^9, 3.3900812126577997`*^9}, {3.3900814913578*^9, 
  3.3900815043768*^9}, {3.3900842190158*^9, 3.3900842213688*^9}, {
  3.390103241108*^9, 3.390103247184*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"DensityPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"x", "*", "y"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "\[Pi]"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "\[Pi]"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "50"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900842286618*^9, 3.3900842529168*^9}, {
  3.3900854330598*^9, 3.3900854334807997`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["ParametricPlot3D:", "Subsection",
 CellChangeTimes->{{3.3900917391238003`*^9, 3.3900917470998*^9}}],

Cell["\<\
Of course, more complicated functions have more interesting shapes:\
\>", "Text",
 CellChangeTimes->{{3.3900855072748003`*^9, 3.3900855503758*^9}}],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      StyleBox["ParametricPlot3D",
       FontSize->14], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["x", "TI"]], "[", "u", "]"}], ",", 
         RowBox[{
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["y", "TI"]], "[", "u", "]"}], ",", 
         RowBox[{
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["z", "TI"]], "[", "u", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["u", "TI"], ",", 
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["min", "TI"]], ",", 
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["max", "TI"]]}], "}"}]}], "]"}]]],
    "\[LineSeparator]produces a three\[Hyphen]dimensional space curve \
parametrized by a variable ",
    Cell[BoxData[
     StyleBox["u", "TI"]], "InlineFormula"],
    " which runs from ",
    Cell[BoxData[
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox["min", "TI"]]], "InlineFormula"],
    " to ",
    Cell[BoxData[
     SubscriptBox[
      StyleBox["u", "TI"], 
      StyleBox["max", "TI"]]], "InlineFormula"],
    ". "
   }]], TraditionalForm]]],
 "\n"
}], "Item",
 CellChangeTimes->{{3.3900919280188*^9, 3.3900919379978*^9}, {
  3.3900919704378*^9, 3.3900919986907997`*^9}, {3.3900920705098*^9, 
  3.3900920839368*^9}, {3.390103265974*^9, 3.390103342651*^9}, {
  3.390103467046*^9, 3.39010351204*^9}},
 FontWeight->"Bold"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      StyleBox["ParametricPlot3D",
       FontSize->14], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["x", "TI"]], "[", 
          RowBox[{"u", ",", "v"}], "]"}], ",", 
         RowBox[{
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["y", "TI"]], "[", 
          RowBox[{"u", ",", "v"}], "]"}], ",", 
         RowBox[{
          SubscriptBox[
           StyleBox["f", "TI"], 
           StyleBox["z", "TI"]], "[", 
          RowBox[{"u", ",", "v"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["u", "TI"], ",", 
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["min", "TI"]], ",", 
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["max", "TI"]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["v", "TI"], ",", 
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["min", "TI"]], ",", 
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["max", "TI"]]}], "}"}]}], "]"}]], "InlineFormula"],
    "\[LineSeparator]produces a three\[Hyphen]dimensional surface \
parametrized by ",
    Cell[BoxData[
     StyleBox["u", "TI"]], "InlineFormula"],
    " and ",
    Cell[BoxData[
     StyleBox["v", "TI"]], "InlineFormula"],
    ". "
   }]], TraditionalForm]]],
 "\n"
}], "Item",
 CellChangeTimes->{{3.3900919280188*^9, 3.3900919379978*^9}, {
  3.3900919704378*^9, 3.3900919986868*^9}, {3.3900920972348003`*^9, 
  3.3900921174628*^9}, {3.390103351398*^9, 3.39010335794*^9}, {
  3.3901034422139997`*^9, 3.3901034536099997`*^9}, {3.390103537861*^9, 
  3.390103539711*^9}},
 FontWeight->"Bold"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"ParametricPlot3D", "[", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["1.16", "v"], " ", 
      RowBox[{"Cos", "[", "v", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Cos", "[", "u", "]"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["1.16", "v"]}], " ", 
      RowBox[{"Sin", "[", "v", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Cos", "[", "u", "]"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SuperscriptBox["1.16", "v"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Sin", "[", "u", "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
    "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"u", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"v", ",", 
     RowBox[{"-", "15"}], ",", "6"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Mesh", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "40"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3900849591387997`*^9, 3.3900850389108*^9}, {
  3.3900850907998*^9, 3.3900851347658*^9}}],

Cell["\<\
Just for fun, click your mouse on the above plot and rotate it to see the \
\"back\" side of the plot.\
\>", "Text",
 CellChangeTimes->{{3.3900840035338*^9, 3.3900841094198*^9}, {
  3.3900851928308*^9, 3.3900851971428003`*^9}, {3.3900856090408*^9, 
  3.3900856098258*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Warning: Extreme Example!",
  FontColor->RGBColor[1, 0, 0]],
 " \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot3D", "[", " ", "...", " ", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot3D", "[", " ", "...", " ", "]"}]}], "\[IndentingNewLine]", 
    "]"}], TraditionalForm]]]
}], "Subsection",
 CellChangeTimes->{{3.3900897914578*^9, 3.3900898490987997`*^9}, {
   3.3900899370548*^9, 3.3900899958417997`*^9}, {3.3900916938758*^9, 
   3.3900917047618*^9}, 3.390102126866*^9}],

Cell[TextData[{
 "Use the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Show", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command to combine two very different 3-D plots:\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"plot1", "=", 
     RowBox[{"ParametricPlot3D", "[", " ", "...", " ", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\nand\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"plot2", "=", 
     RowBox[{"Plot3D", "[", " ", "...", " ", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3900859415278*^9, 3.3900859503378*^9}, {
   3.3900860307208*^9, 3.3900860391868*^9}, {3.3900862576498003`*^9, 
   3.3900863665188*^9}, {3.3900870127488003`*^9, 3.3900870503398*^9}, {
   3.3900921560657997`*^9, 3.3900921570888*^9}, 3.439068912765625*^9}],

Cell[BoxData[
 RowBox[{"plot1", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
  "ParametricPlot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       SuperscriptBox["1.16", "v"], " ", 
       RowBox[{"Cos", "[", "v", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Cos", "[", "u", "]"}]}], ")"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["1.16", "v"]}], " ", 
       RowBox[{"Sin", "[", "v", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Cos", "[", "u", "]"}]}], ")"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", 
       SuperscriptBox["1.16", "v"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Sin", "[", "u", "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"u", ",", "0", ",", 
      RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"v", ",", 
      RowBox[{"-", "15"}], ",", "6"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Mesh", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotPoints", "\[Rule]", "40"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3900869498788*^9, 3.3900869532078*^9}}],

Cell[BoxData[
 RowBox[{"plot2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"x", "*", "y"}], "]"}], "-", "5"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "\[Pi]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"y", ",", "0", ",", "\[Pi]"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.3900869720028*^9, 3.3900869748118*^9}}],

Cell[TextData[{
 "Use the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Show", "[", " ", "...", " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command to combine two different 3-D plots:\n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Show", "[", " ", 
     RowBox[{"plot1", ",", " ", "plot2"}], " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t"
}], "Text",
 CellChangeTimes->{{3.3900859415278*^9, 3.3900859503378*^9}, {
  3.3900860307208*^9, 3.3900860391868*^9}, {3.3900862576498003`*^9, 
  3.3900863665188*^9}, {3.3900870127488003`*^9, 3.3900870503398*^9}, {
  3.3900872449198*^9, 3.3900872676788*^9}, {3.3907962691029997`*^9, 
  3.390796272277*^9}, {3.43906894*^9, 3.439068947125*^9}}],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"plot1", ",", "plot2"}], "]"}]], "Input",
 CellChangeTimes->{{3.3900857151888*^9, 3.3900857509598*^9}, {
   3.3900858099468*^9, 3.3900858101358*^9}, {3.3900858449438*^9, 
   3.3900858457738*^9}, 3.3900869329458*^9, {3.3900869834938*^9, 
   3.3900869963368*^9}}],

Cell["\<\
Just for fun, click your mouse on the above plot and rotate it to see inside \
the \"mouth\" of the plot.\
\>", "Text",
 CellChangeTimes->{{3.3900840035338*^9, 3.3900841094198*^9}, {
  3.3900851928308*^9, 3.3900851971428003`*^9}, {3.3900856090408*^9, 
  3.3900856098258*^9}, {3.3900859133708*^9, 3.3900859277827997`*^9}, {
