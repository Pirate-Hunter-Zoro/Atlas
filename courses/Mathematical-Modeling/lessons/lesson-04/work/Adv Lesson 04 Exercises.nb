"2f375488-271c-47dd-8927-b5b1aacf4ac4"],

Cell["9: A least-squares fit using the basis {1, E^x}", "Section",ExpressionUUID->"0d697244-91f6-4de5-aab2-2d2bed270813"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"g", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"g", "=", 
  RowBox[{"Fit", "[", 
   RowBox[{"someData", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      SuperscriptBox["\[ExponentialE]", "x"]}], "}"}], ",", "x"}], 
   "]"}]}]}], "Input",ExpressionUUID->"8e4454ab-a4b6-407b-ace6-f76d1670d5ce"],

Cell["10: Plotting the fit, dashed", "Section",ExpressionUUID->"88ee4d13-cddb-4f1a-a35a-260abfe64150"],

Cell[BoxData[
