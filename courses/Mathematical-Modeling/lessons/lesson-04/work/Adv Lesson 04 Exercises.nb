    FractionBox["x", 
     RowBox[{"Sin", "[", "y", "]"}]], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], "]"}]], "Input",Expressi\
onUUID->"a5a829fd-ff9a-46fd-9d8d-24521cbe73e8"],

