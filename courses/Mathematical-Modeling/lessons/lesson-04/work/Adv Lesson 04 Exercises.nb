Cell["\<\
Advanced Lesson 4 - Exercises: Graphics
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"f8b9912e-4cc0-4e5e-b5f2-afe5ca614d63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "a", ",", "b", ",", "f", ",", "g", ",", "x", ",", "y", ",", "u", ",", "v", 
    ",", "someData"}], "]"}], ";"}]], "Input",ExpressionUUID->"0a4e831b-f73c-\
439d-b49e-7c5a89fc5d46"],

Cell["\<\
1: ParametricPlot with MeshShading, from the Documentation Center\
\>", "Section",ExpressionUUID->"4ebfe667-fe62-4567-8715-afb1869986b9"],

Cell["\<\
Parts 1 to 3 are a walk through the Documentation Center page for
ParametricPlot. Parts 4 and 5 are below: a MeshShading example copied out of
that page, and then the same example with the parameter interval moved from
0 <= u <= 4 Pi to 2 Pi <= u <= 8 Pi.
MeshShading takes a list of colours (or None) and paints the successive mesh
segments of the curve with them in rotation, so the curve is drawn as an
alternating dashed ribbon rather than one uniform line.\
\>", "Text",ExpressionUUID->"502ed3b7-315f-490a-9a8c-92b62c3fbe7f"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", 
     RowBox[{"u", " ", 
      RowBox[{"Sin", "[", "u", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"u", ",", "0", ",", 
     RowBox[{"4", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "20"}], ",", 
   RowBox[{"MeshShading", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Blue"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"c53f7404-0d4c-403a-8d1a-c8375a5549fe"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", 
     RowBox[{"u", " ", 
      RowBox[{"Sin", "[", "u", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"u", ",", 
     RowBox[{"2", " ", "\[Pi]"}], ",", 
     RowBox[{"8", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "20"}], ",", 
   RowBox[{"MeshShading", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Blue"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"5068c44c-3a89-41aa-8156-05f099db6914"],

Cell["2: Four trigonometric functions on one graph", "Section",ExpressionUUID->"49cf4be6-b4cb-4620-9b2e-07881b77b677"],

