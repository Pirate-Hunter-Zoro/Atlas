Cell["14: Manipulate - dynamic 2-D and 3-D plots", "Section",ExpressionUUID->"14a83c02-01bc-4730-befd-0f46e1f66758"],

Cell["\<\
The three cells below are Manipulate expressions. They build correctly under
a plain kernel but the sliders are only live inside a Wolfram front end
(Mathematica or Wolfram Player). Evaluated through Wolfram Engine under
Jupyter they render as a static snapshot at the initial parameter values.\
\>", "Text",ExpressionUUID->"81ef0cc1-5781-43a4-ac80-c590e61cb498"],

Cell["Manipulate[Plot[E^(-a x), {x, 0, 1}], {a, 0, 10}]", "Input",ExpressionUUID->"231517de-2ca4-4249-a0ae-948f62a8dbad"],

Cell["\<\
Manipulate[Plot[E^(-a x), {x, 0, 1}, PlotRange -> All], {a, 0, 10}]\
\>", "Input",ExpressionUUID->"ac65e0a0-7180-46c2-be04-30d9aec12e5a"],

Cell["\<\
Manipulate[
 Plot3D[E^(-a x - b y), {x, 0, 1}, {y, 0, 1}, PlotRange -> All],
 {a, 0, 10}, {b, 0, 10, 2}]\
\>", "Input",ExpressionUUID->"bfa4eb8d-2f48-4753-b243-493d13f3a365"],

Cell["15: A dynamic algebraic calculator", "Section",ExpressionUUID->"ad1b2f80-c6c6-4b93-a4b0-6a9e3a11fadc"],

Cell["Manipulate[Expand[(x + y)^n], {n, 0, 10, 1}]", "Input",ExpressionUUID->"8b063f38-974e-44b8-9da9-57a7468cb027"],

Cell["16: Analysing 2x^2 + 3x^3 y == 4x^4 + 5y + 6", "Section",ExpressionUUID->"112f84c4-e973-44e2-ad42-866ba00e04dc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol16", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["x", "2"]}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox["x", "3"], " ", "y"}]}], "\[Equal]", 
     RowBox[{
      RowBox[{"4", " ", 
       SuperscriptBox["x", "4"]}], "+", 
      RowBox[{"5", " ", "y"}], "+", "6"}]}], ",", "y"}], "]"}]}]}], "Input",Ex\
pressionUUID->"cc0cb054-0233-4a4e-8fae-87ddac20f259"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{"y", "/.", "\[VeryThinSpace]", 
   RowBox[{"First", "[", "sol16", "]"}]}]}]], "Input",ExpressionUUID->\
"0c2b6ab6-68d4-458d-8e97-d6437ed56c6d"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
