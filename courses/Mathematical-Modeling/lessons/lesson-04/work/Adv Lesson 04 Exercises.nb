Cell["8: Plotting data against a fitted curve", "Section",ExpressionUUID->"9d055420-7422-421e-9eba-f6a75613c9ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "20250825", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"someData", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0.1`", " ", "i"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"0.1`", " ", "i"}], ")"}], "2"], "+", 
       RowBox[{"0.5`", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], "-", "0.5`"}], ")"}]}]}]}], "}"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "20"}], "}"}]}], "]"}]}]}], "Input",Expressio\
nUUID->"7799c17e-d0f5-4b6b-a1d2-501592892b30"],

Cell[BoxData[
 RowBox[{"plotData", "=", 
