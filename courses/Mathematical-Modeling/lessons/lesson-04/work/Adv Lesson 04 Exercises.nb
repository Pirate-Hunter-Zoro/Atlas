7b2885bce362"],

Cell["\<\
Your Name:  Mikey Ferguson

Your Math Class:  MATH 7013 - Advanced Mathematical Modeling\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.460217537811943*^9},
 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"4028ebb9-e255-4ddd-a5a4-61319691a07b"],

Cell[TextData[{
 StyleBox["Note: Some of the following exercises are expressed in every day \
mathematical notation rather than proper ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation.  You ", "Subsubsection"],
 StyleBox["MUST", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" convert every day notation into ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation for your code to work properly.  For example:\n\n\t\
Equations ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be changed from  \"=\"  to  \"==\"  to work correctly (i.e. ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "\[Equal]", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]],ExpressionUUID->
  "46d78fa0-6e40-418d-bd1e-dbab596172ce"],
 StyleBox["  not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "=", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]],ExpressionUUID->
  "19e6b1bf-3144-4d6d-be5b-1dfbb2498201"],
 StyleBox["  ).  \n\tFunctions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be expressed as  f[x]  and  not  f(x)  to work correctly.  \n\t\
Functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be defined using  \"_\"  to work correctly (i.e.  ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]],ExpressionUUID->"8d709715-1e63-4ca3-a545-1f9a5890d65f"],
 StyleBox["  and not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]],ExpressionUUID->"d169bb77-f0b9-4775-ba72-d5d6ac135015"],
 StyleBox[").\n\t", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" start with a capital (i.e.  Sin[x]  not  sin[x]).\n\t", 
  "Subsubsection"],
 StyleBox["Your", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" functions should start with a lower case letter (i.e.  f[x]  not  \
F[x]).\n\tSpecial symbols ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be entered correctly (i.e.  ", "Subsubsection"],
 StyleBox["\[ExponentialE]", "Subsection"],
 StyleBox["  from the palette and not  e ).\n\t\nThese exercises begin your \
training in making this conversion automatically.\n", "Subsubsection"]
}], "Text",
 CellChangeTimes->{{3.39064873246*^9, 3.390649069177*^9}, {3.390649104818*^9, 
   3.390649156885*^9}, {3.390649215119*^9, 3.39064939362*^9}, {
   3.390649427467*^9, 3.390649437834*^9}, {3.3906856676331425`*^9, 
   3.3906858924611425`*^9}, {3.3906859679691424`*^9, 3.390686080823142*^9}, {
   3.390686138196142*^9, 3.390686244913142*^9}, 3.390686344335142*^9, {
   3.3906897169261427`*^9, 3.3906898397271423`*^9}, {3.3906898702421427`*^9, 
   3.3906898773081427`*^9}, {3.390693000946142*^9, 
   3.3906930021191425`*^9}},ExpressionUUID->"250e2527-3714-4475-adaf-\
05a7c436b2b6"],

Cell[TextData[{
 "Remember to clear all variables that you will use below:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Clear", "[", "          ", "...", "             ", "]"}], 
   TraditionalForm]],ExpressionUUID->"c3320554-1108-4f4e-be5e-0c82e4ca0467"]
}], "Text",
 CellChangeTimes->{{3.3906923197301426`*^9, 3.3906923812721424`*^9}, {
  3.3906924809361424`*^9, 3.3906924908791423`*^9}, {3.3906927825761423`*^9, 
  3.3906927911761427`*^9}},ExpressionUUID->"a229ec81-ba79-4d18-8213-\
d404586e65de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "a", ",", "b", ",", "f", ",", "g", ",", "x", ",", "y", ",", "u", ",", "v", 
    ",", "someData"}], "]"}], ";"}]], "Input",ExpressionUUID->"0a4e831b-f73c-\
439d-b49e-7c5a89fc5d46"],

Cell[TextData[{
 "1: Using the existing code in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Help Documentation Center can make your work much easier.\nPart1: Open \
",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s Help Documentation Center.\nPart2: Look up ParametricPlot.\nPart3: Open \
each and ",
 StyleBox["every",
  FontVariations->{"Underline"->True}],
 " example and see what ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " of the examples look like.\nPart4: Under Option",
 Cell[BoxData[
  FormBox[">>", TraditionalForm]],ExpressionUUID->
  "c0528a96-655c-48e3-b91e-0013cc7f17e3"],
 " MeshShading, choose your favorite example of MeshShading and Copy and \
Paste the corresponding ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " Code into ",
 StyleBox["your",
  FontVariations->{"Underline"->True}],
 " notebook and then evaluate this code to see the plot appear in your \
notebook.\nPart5: Make a second copy of the same code in your notebook just \
below your first copy. Then change the parametric interval from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "u", "\[LessEqual]", 
    RowBox[{"4", "\[Pi]"}]}], TraditionalForm]],ExpressionUUID->
  "35479c13-3e2f-4203-8ab6-7959860b567a"],
 " to 2\[Pi] \[LessEqual] u \[LessEqual] 8 \[Pi] and reevaluate to see the \
difference that it makes."
}], "Text",
 CellChangeTimes->{{3.3901038567530003`*^9, 3.3901040044440002`*^9}, {
  3.3901040584119997`*^9, 3.390104249377*^9}, {3.39010505359*^9, 
  3.390105239362*^9}, {3.39010545641*^9, 3.3901055072469997`*^9}, {
  3.3901055667060003`*^9, 3.390105571617*^9}, {3.3903852834899597`*^9, 
  3.3903853150979595`*^9}, {3.3903854048709598`*^9, 
  3.3903854734919596`*^9}},ExpressionUUID->"6b32731a-b447-4f76-9a64-\
6fdc31702639"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", 
     RowBox[{"u", " ", 
      RowBox[{"Sin", "[", "u", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"u", ",", "0", ",", 
     RowBox[{"4", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "20"}], ",", 
   RowBox[{"MeshShading", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Blue"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"c53f7404-0d4c-403a-8d1a-c8375a5549fe"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", 
     RowBox[{"u", " ", 
      RowBox[{"Sin", "[", "u", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"u", ",", 
     RowBox[{"2", " ", "\[Pi]"}], ",", 
     RowBox[{"8", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "20"}], ",", 
   RowBox[{"MeshShading", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Blue"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"5068c44c-3a89-41aa-8156-05f099db6914"],

Cell["\<\
