"d500075c-3eab-4f07-8648-8c0800a1072e"],

Cell[BoxData[
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", 
    FractionBox["x", 
     RowBox[{"Sin", "[", "y", "]"}]], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "False"}]}], "]"}]], "Input",ExpressionUUID->\
"ee00769a-5b1b-4a17-94b3-972286712628"],

Cell[BoxData[
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{"Sin", "[", 
    FractionBox["x", 
     RowBox[{"Sin", "[", "y", "]"}]], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "200"}], ",", 
   RowBox[{"Mesh", "\[Rule]", "False"}]}], "]"}]], "Input",ExpressionUUID->\
"299d8d41-f2a2-4213-af87-00789df1c877"],

Cell["\<\
Part 1: sin(x/sin y) blows up wherever sin y = 0, which is at y = 0 and y = \
+/-Pi. Near those lines the function oscillates infinitely fast and the \
default sampling cannot keep up, so the surface looks torn. Part 9: away from \
those lines the surface is a smooth ripple; as y approaches 0 or +/-Pi the \
ripples crowd together without limit. Raising PlotPoints shows more of them \
but never resolves them, because there is no finest scale to reach. The \
density plots show the same thing as bands packing tighter toward the same \
lines.\
\>", "Text",ExpressionUUID->"6008ae8e-7fee-453d-9307-57a579aa6914"],

Cell[TextData[{
 "14: Using Manipulate[ ... ]:\n\nPart 1: Create a dynamic 2-D plot of:\n\n\t",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "a"}], " ", "x"}]], TraditionalForm]],ExpressionUUID->
  "2157e686-4c39-4fde-97c3-c782045adde6"],
 "  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "1", " "}], 
   TraditionalForm]],ExpressionUUID->"c36315c9-b3ed-4128-9dfb-d6f94ce5a36a"],
 "\n\tWith a ",
 StyleBox["continuous",
  FontVariations->{"Underline"->True}],
 " slider for  a  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "a", "\[LessEqual]", "10"}], 
   TraditionalForm]],ExpressionUUID->"d58f9ffd-9e71-491a-b81f-acf0ffc54770"],
 "\n\t\nPart 2: Note that the plot jumps around as you move the slider.  Add \
a PlotRange option to your plot \n            (that plots All of the range) \
to fix this problem.\n\nPart 3: Create a dynamic 3-D plot of:\n\n\t",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], " ", "x"}], "-", 
     RowBox[{"b", " ", "y"}]}]], TraditionalForm]],ExpressionUUID->
  "d38b2fe0-b260-4b79-a808-63a8f0ac114a"],
 "  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "1", " "}], 
   TraditionalForm]],ExpressionUUID->"51872cd3-1483-4917-8d40-3a9e758bc81d"],
 " and  0 \[LessEqual] y \[LessEqual] 1 \n\tWith a ",
 StyleBox["continuous",
  FontVariations->{"Underline"->True}],
 " slider for  a  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "a", "\[LessEqual]", "10"}], 
   TraditionalForm]],ExpressionUUID->"13aa49f0-b1cd-4754-aac9-d5e3c0d63d9d"],
 "\n\tWith a ",
 StyleBox["discrete",
  FontVariations->{"Underline"->True}],
 " slider for  b  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "b", "\[LessEqual]", "10"}], 
   TraditionalForm]],ExpressionUUID->"1eebb198-0775-46a0-b81f-2865e489e9ef"],
 "  in steps of 2"
}], "Text",
 CellChangeTimes->{{3.39038661270596*^9, 3.39038666806696*^9}, {
   3.39038687211796*^9, 3.3903869916539598`*^9}, {3.39038703139196*^9, 
   3.3903870853149595`*^9}, {3.39038756030496*^9, 3.39038758131696*^9}, {
   3.39038763079796*^9, 3.3903876330299597`*^9}, 3.3903914264769597`*^9, {
   3.390734939565*^9, 3.390734945311*^9}, {3.390776836082*^9, 
   3.390776911248*^9}, {3.39079739723*^9, 3.390797397356*^9}, {
   3.390797750583*^9, 
   3.390797750663*^9}},ExpressionUUID->"3730b5ac-b1f0-44ac-a532-218d114ef915"],

Cell["Manipulate[Plot[E^(-a x), {x, 0, 1}], {a, 0, 10}]", "Input",ExpressionUUID->"231517de-2ca4-4249-a0ae-948f62a8dbad"],

Cell["\<\
Manipulate[Plot[E^(-a x), {x, 0, 1}, PlotRange -> All], {a, 0, 10}]\
\>", "Input",ExpressionUUID->"ac65e0a0-7180-46c2-be04-30d9aec12e5a"],

Cell["\<\
Manipulate[
 Plot3D[E^(-a x - b y), {x, 0, 1}, {y, 0, 1}, PlotRange -> All],
 {a, 0, 10}, {b, 0, 10, 2}]\
\>", "Input",ExpressionUUID->"bfa4eb8d-2f48-4753-b243-493d13f3a365"],

Cell[TextData[{
 "15: Using Manipulate[ ... ]:\n\n      Create a dynamic algebraic calculator \
that expands  (i.e.  Expand[ ... ]) the expression:\n\n\t",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "y"}], ")"}], "n"], TraditionalForm]],ExpressionUUID->
  "db9a5f08-35af-45ca-9533-ffd916efa44b"],
 "  \n\t\n      With a ",
 StyleBox["discrete",
  FontVariations->{"Underline"->True}],
 " slider for  n  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "n", "\[LessEqual]", "10"}], 
   TraditionalForm]],ExpressionUUID->"cb91c3d5-8289-4938-9c72-5a999950df16"],
 "  in steps of 1"
}], "Text",
 CellChangeTimes->{{3.39038661270596*^9, 3.39038666806696*^9}, {
  3.39038687211796*^9, 3.3903869916539598`*^9}, {3.39038703139196*^9, 
  3.3903870853149595`*^9}, {3.39038756030496*^9, 3.39038758131696*^9}, {
  3.39038763079796*^9, 3.3903876330299597`*^9}, {3.3903914264769597`*^9, 
  3.39039145662596*^9}, {3.3903914867819595`*^9, 3.3903916333009596`*^9}, {
  3.39039174024496*^9, 3.3903917560819597`*^9}, {3.3903918654959598`*^9, 
  3.39039186591496*^9}, {3.390730243856*^9, 3.390730257472*^9}, {
  3.390797402816*^9, 3.39079740287*^9}, {3.3907977582860003`*^9, 
  3.3907977583780003`*^9}},ExpressionUUID->"7fe580d7-5a4b-4d83-b014-\
f3e09bee47d9"],

Cell["Manipulate[Expand[(x + y)^n], {n, 0, 10, 1}]", "Input",ExpressionUUID->"8b063f38-974e-44b8-9da9-57a7468cb027"],

Cell[TextData[{
 "16. Analyze the behavior of the equation:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"2", 
      SuperscriptBox["x", "2"]}], " ", "+", 
     RowBox[{"3", 
      SuperscriptBox["x", "3"], " ", "y"}]}], "=", 
    RowBox[{
     RowBox[{"4", 
      SuperscriptBox["x", "4"]}], "+", 
     RowBox[{"5", "y"}], "+", "6"}]}], TraditionalForm]],ExpressionUUID->
  "e470a24a-e073-49cd-9457-c7f8dd40c8ba"],
 "\n\nPart 1: Solve (i.e. use Solve[ ... ]) the above equation for  y  in \
terms of  x.\n\nPart 2: Use the results from Part 1 to define a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "be6aa89d-5bf4-4720-abb8-fc5e6103c1c9"],
 "  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "66660f5b-4b6b-499c-953b-59490ffbfc31"],
 ".\n            Remember, you have an expression for  y  in terms of  x  \
from Part 1.\n\nPart 3: Plot  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "1f6e2e56-633f-4632-8d06-a59be27b2e5e"],
 "  for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "4"}], "\[LessEqual]", "x", "\[LessEqual]", "4"}], 
   TraditionalForm]],ExpressionUUID->"61bc85b5-91a5-46d7-81f6-138175a66b6e"],
 ".\n\nPart 4: Calculate  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "050d8f90-c154-4a9c-8550-247be4d3baeb"],
 " .\n\nPart 5: Plot  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "5d5eb25e-2a5d-4827-8e32-a3e1cf0d3e52"],
 "  for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "4"}], "\[LessEqual]", "x", "\[LessEqual]", "4"}], 
   TraditionalForm]],ExpressionUUID->"a2defe87-9c8b-4888-9ee9-6ee25265e10c"],
 ".\n\nPart 6: Find the critical points for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "2ad5b324-8e0b-4cd4-9d24-937f067ad00a"],
 "  by solving (i.e. use Solve[ ... ]) the equation\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "7e21288e-3892-4f58-8416-fb37e48ebd90"],
 "\n\nfor  x .  Note that the result is not very useful in this form (i.e. \
the answer contains Root[ ... ] objects).\n \nPart 7: Find the critical \
points for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "28b2dfdf-3e01-4c40-970b-867e6649caef"],
 "  ",
 StyleBox["numerically",
  FontVariations->{"Underline"->True}],
 " by solving (i.e. use NSolve[ ... ]) the equation\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "11f4e5aa-9117-4927-bfbc-29c29a5378c3"],
 "\n\n          for  x .  Note that the result has two complex and four real \
values.\n \n Part 8: Comment (in a Text Cell) on whether or not the four real \
roots found in Part 7 agree with the \n             plot in Part 5.  Also, \
which of the four real roots correspond to local maxima of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "676b785d-3d12-4a1a-9f92-32e3419e3564"],
 "?"
}], "Text",
 CellChangeTimes->{{3.390734991005*^9, 3.390735201507*^9}, {3.390735237369*^9,
   3.3907353176210003`*^9}, {3.39073561051*^9, 3.390735812318*^9}, {
  3.390735848177*^9, 3.390736203007*^9}, {3.390736279561*^9, 
  3.390736288457*^9}, {3.3907363208570004`*^9, 3.3907364892019997`*^9}, {
  3.390736642663*^9, 3.390736739125*^9}, {3.390736815766*^9, 
  3.3907369381549997`*^9}, {3.390737081999*^9, 3.39073710305*^9}, {
  3.390797406727*^9, 3.390797411932*^9}, {3.3907977617539997`*^9, 
  3.390797761889*^9}},ExpressionUUID->"70dffe43-5002-4032-8448-9a2a11e07cb3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol16", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["x", "2"]}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox["x", "3"], " ", "y"}]}], "\[Equal]", 
     RowBox[{
      RowBox[{"4", " ", 
       SuperscriptBox["x", "4"]}], "+", 
      RowBox[{"5", " ", "y"}], "+", "6"}]}], ",", "y"}], "]"}]}]}], "Input",Ex\
pressionUUID->"cc0cb054-0233-4a4e-8fae-87ddac20f259"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{"y", "/.", "\[VeryThinSpace]", 
   RowBox[{"First", "[", "sol16", "]"}]}]}]], "Input",ExpressionUUID->\
"0c2b6ab6-68d4-458d-8e97-d6437ed56c6d"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"4a4375e6-d3f0-42dd-8e7c-0ea95b63ce21"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   SuperscriptBox["f", "\[Prime]",
    MultilineFunction->None], "[", "x", "]"}], "]"}]], "Input",ExpressionUUID->\
"443c0f7e-944d-4520-bd6c-d5f262ec0039"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"45869693-0a74-473f-b1b4-19dc3ffa9be3"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["f", "\[Prime]",
      MultilineFunction->None], "[", "x", "]"}], "\[Equal]", "0"}], ",", 
   "x"}], "]"}]], "Input",ExpressionUUID->"64ce224a-1f4b-4105-9975-\
75c0d85efd9d"],

Cell[BoxData[
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["f", "\[Prime]",
      MultilineFunction->None], "[", "x", "]"}], "\[Equal]", "0"}], ",", 
   "x"}], "]"}]], "Input",ExpressionUUID->"8c708953-7d20-4b70-b5dc-\
ef774d429cde"],

Cell[BoxData[
 RowBox[{"roots16", "=", 
  RowBox[{"Chop", "[", 
   RowBox[{"x", "/.", "\[VeryThinSpace]", 
    RowBox[{"NSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["f", "\[Prime]",
         MultilineFunction->None], "[", "x", "]"}], "\[Equal]", "0"}], ",", 
      "x"}], "]"}]}], "]"}]}]], "Input",ExpressionUUID->"d148e907-1130-4b3a-\
9816-b8850f3845ef"],

Cell[BoxData[
 RowBox[{"realRoots16", "=", 
  RowBox[{"Select", "[", 
   RowBox[{"roots16", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Im", "[", "#1", "]"}], "\[Equal]", "0"}], "&"}]}], 
   "]"}]}]], "Input",ExpressionUUID->"d6f8b872-0b9d-48ed-b037-82c979da4345"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"Chop", "[", 
        RowBox[{
         SuperscriptBox["f", "\[Prime]",
          MultilineFunction->None], "[", "r", "]"}], "]"}], ",", 
       RowBox[{"Chop", "[", 
        RowBox[{
         SuperscriptBox["f", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "r", "]"}], "]"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           SuperscriptBox["f", "\[Prime]\[Prime]",
            MultilineFunction->None], "[", "r", "]"}], "<", "0"}], 
         ",", "\"\<local maximum\>\"", ",", "\"\<local minimum\>\""}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "realRoots16"}], "}"}]}], "]"}], ",", 
   RowBox[{"TableHeadings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<f'[x]\>\"", ",", "\"\<f''[x]\>\"", 
        ",", "\"\<classification\>\""}], "}"}]}], "}"}]}]}], "]"}]], "Input",E\
xpressionUUID->"7764d5f2-e1f4-4cdd-b734-9f2fd441c118"],

Cell["\<\
Part 8: NSolve gives six roots, two complex and four real, at about x = \
-0.84, 0, 0.27 and 1.96. Those are exactly the four places where the plot of \
f'(x) crosses zero, so they agree. Checking the second derivative there, x = \
-0.84 and x = 0.27 are the local maxima (f'' negative), while x = 0 and x = \
1.96 are local minima.\
\>", "Text",ExpressionUUID->"f805b8ac-bb70-40f0-9ec7-28f86e0ac376"]
},
