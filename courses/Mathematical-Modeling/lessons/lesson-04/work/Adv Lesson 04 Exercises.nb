Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], ",", 
     RowBox[{"Cos", "[", "x", "]"}], ",", 
     RowBox[{"Tan", "[", "x", "]"}], ",", 
     RowBox[{"Cot", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "3"}], ",", "3"}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", "0.01`", "]"}], ",", 
      RowBox[{"Thickness", "[", "0.005`", "]"}], ",", 
      RowBox[{"Thickness", "[", "0.003`", "]"}], ",", 
      RowBox[{"Thickness", "[", "0.001`", "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<sin(x), cos(x), tan(x), cot(x)\>\"", ",", 
      RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
      RowBox[{"FontWeight", "\[Rule]", "Bold"}], ",", 
      RowBox[{"FontSize", "\[Rule]", "12"}]}], "]"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]], "Input",ExpressionUUID->\
"e308fd36-8cfe-4ad9-8049-e698da2bf902"],

Cell[TextData[{
 "8:  Using the data generated below:\ni.e.    ",
 Cell[BoxData[
  FormBox[
   RowBox[{"someData", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0.1", "*", "i"}], ",", " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"0.1", "*", "i"}], ")"}], "2"], "+", " ", 
         RowBox[{"0.5", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RandomReal", "[", " ", "]"}], " ", "-", " ", "0.5"}], 
           ")"}]}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "20"}], "}"}]}], "]"}]}], 
   TraditionalForm]],ExpressionUUID->"4ef35f83-7c21-4b38-8e48-28bd0ecc4c82"]
}], "Text",
 CellChangeTimes->{{3.3900844959438*^9, 3.3900845341977997`*^9}, 
   3.39038534366296*^9},ExpressionUUID->"e4a13c59-3e75-4f2e-956b-\
0c4df147d457"],

Cell[BoxData[
 RowBox[{"someData", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0.1", " ", "i"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"0.1", " ", "i"}], ")"}], "2"], "+", 
       RowBox[{"0.5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], "-", "0.5"}], ")"}]}]}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "20"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.3900843107598*^9, 
  3.3900843229458*^9}},ExpressionUUID->"27c5a3c2-6fad-401a-ace2-896c3f089a28"],

Cell[TextData[{
 "Part1:  Plot the ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of data with points having a point size of  2% (i.e. .02) of the overall \
graph size.\nPart2:  Define a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "99760157-c47b-4cbc-846e-2d13099e8ff6"],
 " to be the function  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "8e65c973-26df-432b-8580-dcbbd6bde526"],
 ".\n            Plot the function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "ed0c14a1-87a4-4e42-b9db-5ef6e742f04b"],
 "  for  0 \[LessEqual] x \[LessEqual] 2, where the curve has a thickness of  \
1% (i.e. .01) of the overall graph size.\nPart3:  Use the Show[...] command \
to display both of the above graphs at the same time."
}], "Text",
 CellChangeTimes->{{3.3907974754300003`*^9, 
  3.3907975403129997`*^9}},ExpressionUUID->"69a36f57-7910-4eaa-9d27-\
db40d56c78f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "20250825", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"someData", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0.1`", " ", "i"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"0.1`", " ", "i"}], ")"}], "2"], "+", 
       RowBox[{"0.5`", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], "-", "0.5`"}], ")"}]}]}]}], "}"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "20"}], "}"}]}], "]"}]}]}], "Input",Expressio\
nUUID->"7799c17e-d0f5-4b6b-a1d2-501592892b30"],

Cell[BoxData[
 RowBox[{"plotData", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"someData", ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"PointSize", "[", "0.02`", "]"}]}]}], "]"}]}]], "Input",Expressio\
nUUID->"71736c4a-3ddb-46ad-8c3e-2aeafd441ee5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "f", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   SuperscriptBox["x", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"plotF", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"Thickness", "[", "0.01`", "]"}]}]}], "]"}]}]}], "Input",Expressi\
onUUID->"45e45787-12fd-4292-9095-75eeaf95eac0"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"plotData", ",", "plotF"}], "]"}]], "Input",ExpressionUUID->\
"2f375488-271c-47dd-8927-b5b1aacf4ac4"],

Cell[TextData[{
 "9:  Find the least-squares fit  ",
 Cell[BoxData[
  FormBox["\"\<g\>\"", TraditionalForm]],ExpressionUUID->
  "b8b7a71c-ce71-4009-8dd2-9d5a2902a7c5"],
 "  to the data:  someData  generated in problem 8 using the functions:  ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", 
    SuperscriptBox["\[ExponentialE]", "x"]}], "}"}]],
  FontWeight->"Bold",ExpressionUUID->"411f8e55-d023-4766-b082-4dee039c464b"],
 "."
}], "Text",
 CellChangeTimes->{
  3.3903853497939596`*^9, 3.390734685818*^9, {3.390797601134*^9, 
   3.390797601337*^9}, {3.39079791525*^9, 3.390797947208*^9}, {
   3.390798255554*^9, 
   3.390798263193*^9}},ExpressionUUID->"4cdb3eff-d9ac-4969-9cf8-1c69f703bd8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"g", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"g", "=", 
  RowBox[{"Fit", "[", 
   RowBox[{"someData", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      SuperscriptBox["\[ExponentialE]", "x"]}], "}"}], ",", "x"}], 
   "]"}]}]}], "Input",ExpressionUUID->"8e4454ab-a4b6-407b-ace6-f76d1670d5ce"],

Cell[TextData[{
 "10:  Plot the least-squares exponential fit  ",
 Cell[BoxData[
  FormBox["\"\<g\>\"", TraditionalForm]],ExpressionUUID->
  "7f35b9de-6ed6-4942-b628-c20aa099f01e"],
 "  to the data so that it has Thickness [.009]  and  Dashing [{.02, .02}]."
}], "Text",
 CellChangeTimes->{{3.39038535451396*^9, 3.39038535509896*^9}, 
   3.3907346922980003`*^9, {3.3907975893570004`*^9, 
   3.3907975899960003`*^9}},ExpressionUUID->"71777bce-a655-4489-a887-\
59ff9b25662f"],

Cell[BoxData[
 RowBox[{"plotG", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{"g", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thickness", "[", "0.009`", "]"}], ",", 
       RowBox[{"Dashing", "[", 
        RowBox[{"{", 
         RowBox[{"0.02`", ",", "0.02`"}], "}"}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",ExpressionUUID->"4d5276b8-4ecd-403c-9f53-303db81c94e4"],

Cell[TextData[{
 "11:  Show the list plot of the data, the continuous plot of the function  \
",
 Cell[BoxData[
  FormBox["\"\<\!\(\*Cell[\"f\",ExpressionUUID->\"8ff0a202-8854-404e-b237-\
e664c64a62fa\"]\)\>\"", TraditionalForm]],ExpressionUUID->
  "babf74e5-e6e7-40ef-ac33-8be741cd1608"],
 "   and the continuous plot of the \n       function  ",
 Cell[BoxData[
  FormBox["\"\<g\>\"", TraditionalForm]],ExpressionUUID->
  "82011aa2-cbe4-4ed7-99df-dde6f329531b"],
 "  on one graph."
}], "Text",
 CellChangeTimes->{
  3.3903853595769596`*^9, 3.390734698755*^9, {3.390797064483*^9, 
   3.3907970678269997`*^9}, {3.3907972830439997`*^9, 
   3.3907972849300003`*^9}, {3.390797637311*^9, 
   3.390797693142*^9}},ExpressionUUID->"dd885479-7204-4a2d-99b9-c8770566f29e"],

Cell["\<\
                   When you are through, your graph should look like:\
\>", "Text",
 CellChangeTimes->{
  3.39038537913196*^9, {3.3907973805880003`*^9, 3.3907973807530003`*^9}, {
   3.390797722914*^9, 
   3.390797723826*^9}},ExpressionUUID->"031daf19-cdcb-477d-acb3-959802f540c6"],

