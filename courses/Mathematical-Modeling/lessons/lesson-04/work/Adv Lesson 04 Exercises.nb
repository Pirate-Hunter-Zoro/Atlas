   "x"}], "]"}]], "Input",ExpressionUUID->"8c708953-7d20-4b70-b5dc-\
ef774d429cde"],

Cell[BoxData[
 RowBox[{"roots16", "=", 
  RowBox[{"Chop", "[", 
   RowBox[{"x", "/.", "\[VeryThinSpace]", 
    RowBox[{"NSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["f", "\[Prime]",
         MultilineFunction->None], "[", "x", "]"}], "\[Equal]", "0"}], ",", 
