 RowBox[{"a", "=", "5"}]], "Input",ExpressionUUID->"acfe8e6c-b2d7-4a11-82f7-80b463241a6f"],

Cell[BoxData[
 RowBox[{"a", " ", "A"}]], "Input",ExpressionUUID->"041416bc-a2bf-4a12-a719-30e967bc0c30"],

Cell["?a", "Input",ExpressionUUID->"a4bf30b0-df82-4e6d-8529-3f52a8a38f40"],

Cell["?A", "Input",ExpressionUUID->"9a788c55-875a-4548-805c-a77b5b67bdde"],

Cell[BoxData[
 RowBox[{"A", "=", "6"}]], "Input",ExpressionUUID->"7e765421-0d6b-461b-9ec1-852d8181df48"],

Cell[BoxData[
 RowBox[{"a", " ", "A"}]], "Input",ExpressionUUID->"bf56e660-961c-4bbd-9baa-51ee2ce99a07"],

Cell["?a", "Input",ExpressionUUID->"6d073366-b478-4226-a9d9-1e37097b90d4"],

Cell["?A", "Input",ExpressionUUID->"7a4fe4cf-075e-4b43-91ac-5cb6884d450f"],

Cell[BoxData[
 RowBox[{"A", "=", "7"}]], "Input",ExpressionUUID->"472855fd-f415-4daf-b165-30ac9e930d9c"],

Cell[BoxData[
 RowBox[{"a", " ", "A"}]], "Input",ExpressionUUID->"5f947907-d2f5-431c-941b-08261d1107d0"],

Cell["?a", "Input",ExpressionUUID->"05510c81-2d15-4f99-8f30-775a6d75921b"],

Cell["?A", "Input",ExpressionUUID->"2ca8708d-2f49-47ce-8035-a733f835e36e"],

Cell["\<\
Mathematica is case sensitive, so a and A are two different symbols. Before \
any assignment neither has a value and a A stays as a product. After a = 5 \
the product becomes 5 A; after A = 6 it becomes 30; after A = 7 it becomes \
35. Each ? shows the value that symbol is holding at that moment.\
\>", "Text",ExpressionUUID->"6db88b66-0acf-4e59-8baf-0edfdd31ed07"],

Cell[TextData[{
 StyleBox["4:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\[GrayCircle]\tCheck the meaning \
assigned to:    ",
 StyleBox["Sin",
  FontWeight->"Bold"],
 "    using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\t(Then follow the link  ",
 StyleBox[">>",
  FontWeight->"Bold"],
 "  to ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to see what is there.)\n  \n\[GrayCircle]\tCheck the meaning assigned to:  \
  ",
 StyleBox["sin",
  FontWeight->"Bold"],
 "    using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\n\[GrayCircle]\tExplain the results (in a Text Cell).\n"
}], "Text",
 CellChangeTimes->{{3.3903441911864*^9, 3.3903443179203997`*^9}, {
   3.3903464349474*^9, 3.3903464373824*^9}, {3.3903478296544*^9, 
   3.3903478894114*^9}, {3.3903490843094*^9, 3.3903490845174*^9}, {
