 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "A", ",", "feet", ",", "sec"}], "]"}], ";"}], "\[IndentingNewLine]", 
 FractionBox["a", "A"]}], "Input",ExpressionUUID->"389287af-dd5b-4dae-851e-\
6173a6f41ff0"],

Cell["?a", "Input",ExpressionUUID->"e0aa6b95-a2b6-4d1d-b0f6-6036d8f32bf5"],

Cell["?A", "Input",ExpressionUUID->"97ae89c6-1a35-484d-8707-3478f1de988a"],

Cell[BoxData[
 RowBox[{"A", "=", 
  FractionBox[
   RowBox[{"5", " ", "feet"}], "sec"]}]], "Input",ExpressionUUID->"aee22b43-\
801d-4ab2-949d-db86ef1be783"],

Cell[BoxData[
 FractionBox["a", "A"]], "Input",ExpressionUUID->"6f9b7b2a-8c5c-4c21-a8e7-1ba0905ebe07"],

Cell["?a", "Input",ExpressionUUID->"f71963b9-4e5e-4013-8ab7-cdb027505240"],

Cell["?A", "Input",ExpressionUUID->"d0e0f033-fab7-4134-b3bf-0f5e4cbce8da"],

Cell[BoxData[
 RowBox[{"a", "=", 
  RowBox[{"10", " ", "feet"}]}]], "Input",ExpressionUUID->"193248df-bcbf-4812-8689-272d47bcde23"],

Cell[BoxData[
 FractionBox["a", "A"]], "Input",ExpressionUUID->"8eae0ffe-fc29-44ee-988c-2f97bd7a527e"],

Cell["?a", "Input",ExpressionUUID->"35c4296e-3c49-48a8-8df8-7665eafec188"],

Cell["?A", "Input",ExpressionUUID->"dcf34efe-a8e4-45b6-b993-03e52db9a43a"],

Cell["?feet", "Input",ExpressionUUID->"45a6bca7-b494-45e6-b8da-b1e1a83262c8"],

Cell["?sec", "Input",ExpressionUUID->"14f84368-f37f-4689-8f85-a15076ebafe7"],

Cell["\<\
feet and sec are never given values, so they stay in the answer as ordinary \
symbols. That is why a/A comes out as 2 sec: the feet cancel and 10/5 = 2 is \
left. ?feet and ?sec show no value, and that is exactly what lets them behave \
like units.\
\>", "Text",ExpressionUUID->"2995fd5a-b0b5-4d65-843e-84e6d5832d1e"],

Cell[TextData[{
 StyleBox["6:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n\[GrayCircle]\t",
 StyleBox["Clear[ x, f ]",
  FontWeight->"Bold"],
 "\n\tDefine a function:    ",
 StyleBox["f",
  FontWeight->"Bold"],
 "    of the variable:   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "   to be the ",
 StyleBox["Sin[x]",
  FontWeight->"Bold"],
 ".\n\t(Remember to use the  \"",
 StyleBox["_",
  FontWeight->"Bold"],
 "\".)\n \t(Use one Input cell for both lines of code and be sure to use the \
\"",
 StyleBox[";",
  FontWeight->"Bold"],
 "\")\n\[GrayCircle]\tEvaluate the Sine of   ",
 StyleBox["\[Pi]",
  FontWeight->"Bold"],
 "   and   ",
 StyleBox["\[Pi]/2",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["6.0",
  FontWeight->"Bold"],
 "  using ",
 StyleBox["your",
  FontVariations->{"Underline"->True}],
 " function:   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  and\n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette button  ",
 Cell[BoxData[
  ButtonBox["\<\" \[Pi] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3906051182934*^9},ExpressionUUID->
  "9cf2bc5d-1ad4-4f02-9481-cdff2407a764"],
 "  to enter  \[Pi].\n\t(i.e. evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{
      StyleBox["f",
       FontSlant->"Plain"], "[", "\[Pi]", "]"}],
     FontWeight->"Bold"], ",", " ", 
    StyleBox[
     RowBox[{
      StyleBox["f",
       FontSlant->"Plain"], "[", 
      RowBox[{"\[Pi]", "/", "2"}], "]"}],
     FontWeight->"Bold"], ",", " ", 
    StyleBox[
     RowBox[{
      StyleBox["f",
       FontSlant->"Plain"], "[", "6.0", "]"}],
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "05189d5d-8572-4eb6-9626-1f3c194447f0"],
 ")\n\[GrayCircle]\tExplain the results (in a ",
 StyleBox["Text",
  FontVariations->{"Underline"->True}],
 " Cell).\n\[GrayCircle] \tCheck the value assigned to the function:     ",
 StyleBox["f",
  FontWeight->"Bold"],
 "     using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" \n\[GrayCircle] \tEvaluate the derivative of the function:   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 ",  i.e.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "8442d60a-43a5-4d5b-a5ed-202dc114f8ad"],
 ",  \n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function ",
 Cell[BoxData[
  FormBox[
   ButtonBox["\<\" \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \\(\[Placeholder]\
\\)]\\) \[FilledSquare] \"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], TraditionalForm]],ExpressionUUID->
  "3bdc59d0-0b91-4b6e-b49d-e2e9afa40f46"],
 ".\n\t(The Output cell will contain:  ",
 StyleBox["Cos[x]",
  FontWeight->"Bold"],
 " )\n\[GrayCircle] \tEvaluate the derivative of the function:   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using \n\tthe alternate notation    ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "cdaf273e-e7eb-4e35-b0fd-4e0952f5e761"],
 "\n\t(The Output cell will contain:  ",
 StyleBox["Cos[x]",
  FontWeight->"Bold"],
 " )\n\[GrayCircle] \tEvaluate the integral of the function:   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 ",  i.e.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "a2a2e2b8-4dd7-410c-baca-eff4a8190dbd"],
 ", \n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function ",
 Cell[BoxData[
  ButtonBox["\<\" \[Integral]\[FilledSquare]\[DifferentialD]\[Square] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9},ExpressionUUID->
  "eb381bfb-e74c-418a-b08b-f296b7ad0c25"],
 ".\n\[GrayCircle] \tSolve the equation:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"3", 
       RowBox[{"f", "[", "x", "]"}]}], "+", "4"}], "\[Equal]", "0"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "9b17fe47-80a9-46cb-992e-a6672f57954d"],
 "   for  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using the  ",
 StyleBox["Solve[ ... ]",
  FontWeight->"Bold"],
 "  command.\n\tRemember, the  ",
 StyleBox["==",
  FontWeight->"Bold"],
 "  is typed as  ",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "175c86fe-5cc8-488e-90e2-c8f98da89283"],
 "  followed by another  ",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "58932af1-e2df-4326-a3a6-c129e1134587"],
 " . \n\[GrayCircle] \tPlot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    StyleBox[
     RowBox[{"f", "[", "x", "]"}],
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "45b4e753-671f-402f-9197-2fda994dcdd5"],
 "   for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", 
     RowBox[{"2", "\[Pi]"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b78cd15b-185a-4a2e-ac5a-4eebf965cce9"],
 "  using the  ",
 StyleBox["Plot[ ... ]",
  FontWeight->"Bold"],
 "  command and\n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette button  ",
 Cell[BoxData[
  ButtonBox["\<\" \[Pi] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3906051182934*^9},ExpressionUUID->
  "6fcf8914-8e7c-4165-b9c1-e0dc07ea6494"],
 "  to enter  \[Pi].\n\t"
}], "Text",
 CellChangeTimes->{{3.3903448233803997`*^9, 3.3903448267384*^9}, {
   3.3903448720274*^9, 3.3903449016484003`*^9}, {3.3903449967984*^9, 
   3.3903450204414*^9}, {3.3903459752374*^9, 3.3903459902924*^9}, {
   3.3903460633234*^9, 3.3903461167144003`*^9}, {3.3903462647934*^9, 
