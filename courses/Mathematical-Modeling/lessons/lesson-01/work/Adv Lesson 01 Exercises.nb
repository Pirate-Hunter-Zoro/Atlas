 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "A"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"a", " ", "A"}]}], "Input",ExpressionUUID->"d5339b0b-ba72-4d6c-a469-\
5a4e635df070"],

Cell["?a", "Input",ExpressionUUID->"afe9bd8b-8b78-42ae-b0d0-22f73d0dc743"],

Cell["?A", "Input",ExpressionUUID->"59813157-7d78-4c7b-9766-434be8d21e51"],

