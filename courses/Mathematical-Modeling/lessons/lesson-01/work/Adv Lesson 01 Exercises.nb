   RowBox[{"f2", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"RandomReal", "[", "]"}], " ", "x"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f2", "[", "x", "]"}], ",", 
   RowBox[{"f2", "[", "x", "]"}], ",", 
   RowBox[{"f2", "[", "x", "]"}]}], "}"}]}], "Input",ExpressionUUID->\
"73ce3b3c-36a9-426c-882b-a71755b65bd6"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
