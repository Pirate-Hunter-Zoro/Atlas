   3.3906045679203997`*^9}, {3.3906046056334*^9, 3.3906046824104*^9}, {
   3.3906047834354*^9, 3.3906048749533997`*^9}, {3.3906049837044*^9, 
   3.3906050448024*^9}, 3.3906050932214003`*^9, {3.3906051497904*^9, 
   3.3906051500564003`*^9}, {3.3906052033554*^9, 3.3906052701904*^9}, {
   3.3906053156404*^9, 3.3906053186394*^9}, 3.3906053926264*^9, 
   3.3906070187734003`*^9, 3.3906073481134*^9, {3.3907733207799997`*^9, 
