Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "3"], "-", 
    RowBox[{"2", " ", "x"}], "+", "1"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"50072e55-f861-4d5b-bec3-bce85eb1bcc5"],

Cell["\<\
The two calculus results are the ordinary power rules, stated for a symbolic \
n. Solve returns only x = (19 - Sqrt[37])/2, because the other root of the \
underlying quadratic would require a negative square root and does not \
satisfy the original equation. The plot of x^3 - 2 x + 1 rises to a local \
maximum near x = -0.8, dips to a local minimum near x = 0.8, and rises again.\
\
\>", "Text",ExpressionUUID->"b7ccf881-6a25-4036-921f-c8228bf7b7fe"],

Cell[TextData[{
 StyleBox["10",
  FontSize->16,
  FontWeight->"Bold"],
 ": Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\[GrayCircle]\tUsing the \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" command, find information about:   ",
 StyleBox["Style",
  FontWeight->"Bold"],
 "\n\t(Then follow the link ",
 StyleBox[">>",
  FontWeight->"Bold"],
 " to ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to glimpse how ",
 StyleBox["Style",
  FontWeight->"Bold"],
 " works.)\n\t\n\tUsing the \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" command and the wild card \" ",
 Cell[BoxData[
  FormBox[
   StyleBox["*",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "bb12d89c-6fdd-402d-bde5-ccb13a289f8d"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "\", determine:\n \n\[GrayCircle] \t",
 StyleBox["All",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands that ",
 StyleBox["start",
  FontVariations->{"Underline"->True}],
 " with:   ",
 StyleBox["Style",
  FontWeight->"Bold"],
 "\n\t(there are about 12).\n\[GrayCircle] \t",
 StyleBox["All",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands that ",
 StyleBox["end",
  FontVariations->{"Underline"->True}],
 " in:   ",
 StyleBox["Style",
  FontWeight->"Bold"],
 "\n\t(there are about 45).\n\[GrayCircle] \t",
 StyleBox["All",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands that ",
 StyleBox["contain",
  FontVariations->{"Underline"->True}],
 " the word:   ",
 StyleBox["Style",
  FontWeight->"Bold"],
 "  \n\t(there are about 65)."
}], "Text",
