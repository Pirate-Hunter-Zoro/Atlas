Cell[TextData[{
 StyleBox["2:",
  FontSize->16,
  FontWeight->"Bold"],
 " Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to locate information on the \"numerical\" function ",
 StyleBox["N[", "MR",
  FontWeight->"Bold"],
 StyleBox["expr", "TI",
  FontWeight->"Bold"],
 StyleBox["]", "MR",
  FontWeight->"Bold"],
 ":\n\n\t\tType:  ",
 StyleBox["n",
  FontWeight->"Bold"],
 "   \[Implies]   Click to search and locate   \[Implies]   ",
 StyleBox["N[", "MR",
  FontWeight->"Bold"],
 StyleBox["expr", "TI",
  FontWeight->"Bold"],
 StyleBox["]", "MR",
  FontWeight->"Bold"],
 StyleBox["\n \t\n\t", "MR"],
 "Note the two ways you can  use  ",
 StyleBox["N",
  FontWeight->"Bold"],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     StyleBox[
      RowBox[{"N", "[", 
       StyleBox["expr", "TI"], "]"}],
      FontWeight->"Bold"]], "InlineFormula",ExpressionUUID->
     "ebf22e31-d2be-4e8c-834c-283d1fbdc489"],
    "\[LineSeparator]gives the numerical value of ",
    Cell[BoxData[
     StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
     "cf9b650d-f39b-489d-8488-53c84261aa84"],
    ". "
   }],ExpressionUUID->"cc70ed9a-102b-4e9f-ba44-875d57c9c126"], 
   TraditionalForm]],ExpressionUUID->"346924e6-1cec-4a14-8a25-355ddf00a149"],
 "\n\t\n\t\t",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     StyleBox[
      RowBox[{"N", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["n", "TI"]}], "]"}],
      FontWeight->"Bold"]], "InlineFormula",ExpressionUUID->
     "903d4704-0560-42c0-9609-2ce3b857cb54"],
    "\[LineSeparator]attempts to give a result with ",
    Cell[BoxData[
     StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
     "2becb70a-00d2-4503-b597-221b2c8beb7b"],
    "\[Hyphen]digit precision. "
   }],ExpressionUUID->"707934e0-04cd-45dd-82ff-71acebcbaf85"], 
   TraditionalForm]],ExpressionUUID->"bdf4250a-120e-4d1f-b371-3a34b4a65a2a"],
 "\n\t\t\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "bb44ef07-98e0-44e8-9d6f-e3bee5e0af34"],
 " \t",
 StyleBox["Modify",
  FontVariations->{"Underline"->True}],
 " the \"Basic Examples\" in ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to calculate:   ",
 StyleBox["N[ 1/13 ]",
  FontWeight->"Bold"],
 "\n\t\t\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "008cd5b7-24e3-46ff-b73e-72dd85f928cc"],
 "\t",
 StyleBox["Modify",
  FontVariations->{"Underline"->True}],
 " the \"Basic Examples\" in ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to calculate:   ",
 StyleBox["N[ 1/13 , 50 ]",
  FontWeight->"Bold"],
 "\n\t\t\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "bfbfcf77-da6e-4c73-85cb-8aa3e2eb2132"],
 "\tCut and Paste the two Input-Output cell pairs containing the above \
results into this notebook just below this text cell.\n"
}], "Text",
 CellChangeTimes->{{3.3903401298974*^9, 3.3903401498434*^9}, 
   3.3903410750064*^9, {3.3903413303794003`*^9, 3.3903414493574*^9}, {
   3.3903415111204*^9, 3.3903416955854*^9}, {3.3903417845964003`*^9, 
   3.3903418699564*^9}, {3.3903419051544*^9, 3.3903419321414003`*^9}, {
   3.3903420349184*^9, 3.3903420490924*^9}, {3.3903421201664*^9, 
   3.3903423234434*^9}, {3.3903423666244*^9, 3.3903424035334*^9}, 
