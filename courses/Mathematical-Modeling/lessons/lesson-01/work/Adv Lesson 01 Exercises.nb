   3.390372725369*^9, 3.390372735527*^9}, {3.390372811757*^9, 
   3.390372894584*^9}, {3.390373273884*^9, 3.390373312488*^9}, {
   3.3903733549849997`*^9, 3.390373427324*^9}, {3.390373592907*^9, 
   3.3903736184119997`*^9}, {3.390373651698*^9, 3.390373678199*^9}, {
