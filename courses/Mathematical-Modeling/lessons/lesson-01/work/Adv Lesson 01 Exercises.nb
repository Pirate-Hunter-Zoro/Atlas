Cell["?f1", "Input",ExpressionUUID->"859e7c68-8472-41d5-8298-3a4b66309700"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"RandomReal", "[", "]"}], " ", "x"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
