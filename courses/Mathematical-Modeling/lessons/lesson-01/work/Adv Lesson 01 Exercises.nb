->"aea6635f-5891-4cf4-b6dc-80bf367ea023"],

Cell["?f2", "Input",ExpressionUUID->"61c5bb06-f590-4cfc-8a06-372c6e133eb3"],

Cell["9: Derivative, integral, radical equation, and a cubic plot", "Section",ExpressionUUID->"62382d7f-b997-4ad8-8f1f-c51f0d5a9095"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "n"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["\[PartialD]", "x"], 
  SuperscriptBox["x", "n"]}]}], "Input",ExpressionUUID->"57c8d099-0224-4cbd-\
89e7-d80f89c43148"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["x", "n"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"c622abc1-\
2e8e-4f0e-b206-58319fffd716"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "+", 
     SqrtBox["x"]}], "\[Equal]", "9"}], ",", "x"}], "]"}]], "Input",Expression\
UUID->"8c7aee0f-02f6-45d5-8418-5787c26f370f"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "3"], "-", 
    RowBox[{"2", " ", "x"}], "+", "1"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"50072e55-f861-4d5b-bec3-bce85eb1bcc5"],

