Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "x", ",", "f", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], "=", 
   SuperscriptBox["x", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   SuperscriptBox["\[ExponentialE]", "x"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "2", "]"}], "=", "\[Pi]"}], ";"}]}], "Input",ExpressionUU\
ID->"50906c67-0cc7-48c8-92ed-9e513aa495a4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"f", "[", "a", "]"}], ",", 
   RowBox[{"f", "[", "y", "]"}], ",", 
   RowBox[{"f", "[", "2", "]"}], ",", 
   RowBox[{"f", "[", "3", "]"}]}], "}"}]], "Input",ExpressionUUID->"b4907af3-\
db86-460b-a828-7c90f814bc0c"],

Cell["?f", "Input",ExpressionUUID->"984b88d2-926b-46aa-b16d-1e8c8ce7404c"],

Cell["\<\
Three definitions are stored and none of them replaces the others. f[x] = x^2 \
applies only to the literal symbol x, f[2] = Pi only to the literal 2, and \
f[x_] = E^x to any argument. Mathematica uses the most specific definition \
that fits, so f[x] gives x^2 and f[2] gives Pi, while f[a], f[y] and f[3] \
fall through to E^a, E^y and E^3. ?f lists all three.\
\>", "Text",ExpressionUUID->"69f5a1c5-abc0-405d-b643-e92bfdd2a4ca"],

Cell[TextData[{
 StyleBox["8:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\tThe following exercise \
illustrates a circumstance where using delayed assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "57302b67-3a0c-4c80-806d-547dbb71bed5"],
 "\" and \n\timmediate assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e75718ff-b4f7-4058-a65f-16f1629d0983"],
 "\" do ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " give the same result.  The idea is to define a function which \n\twill \
generate random real numbers between 0 and 1 scaled by the size of   x.  \n\n\
\tWhen ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " assignment \"",
 StyleBox["=",
  FontWeight->"Bold"],
 "\" is used to define the function ",
 StyleBox["f1[x_]",
  FontWeight->"Bold"],
 "\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f1", "[", "x_", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"RandomReal", "[", " ", "]"}], "*", "x", " "}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "6591fa53-0765-48b9-a7d4-d14d2567b6f5"],
 "  \n\t\n\tthen the right hand side will be evaluated ",
 StyleBox["immediately once and only once",
  FontVariations->{"Underline"->True}],
 ".  Therefore  ",
 StyleBox["RandomReal[ ]",
  FontWeight->"Bold"],
 "   \n\twill be called ",
 StyleBox["once and only once",
  FontVariations->{"Underline"->True}],
 " and therefore would have only ",
 StyleBox["one",
  FontVariations->{"Underline"->True}],
 " value no matter how many other \n\ttimes you call the function  ",
 StyleBox["f1",
  FontWeight->"Bold"],
 ".\n\n\tWhen delayed assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "a0e1f6b8-612b-4624-940d-5c9a308736a0"],
 "\" is used to define the function ",
 StyleBox["f2[x_]",
  FontWeight->"Bold"],
 "\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f2", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"RandomReal", "[", " ", "]"}], "*", "x", "   "}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "46215815-41da-4b8f-a69f-af81c47210cb"],
 "\n\t\n\tthen the right hand side will ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " be evaluated ",
 StyleBox["until",
  FontVariations->{"Underline"->True}],
 " the function   ",
 StyleBox["f2",
  FontWeight->"Bold"],
 "  is called ",
 StyleBox["later",
  FontVariations->{"Underline"->True}],
 ".  And the function  \n\tmay be called ",
 StyleBox["many",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["many",
  FontVariations->{"Underline"->True}],
 " different times (as would occur when you generate a plot of the function",
 StyleBox[" f2",
  FontWeight->"Bold"],
 "). \n\tTherefore ",
 StyleBox["each and every time",
  FontVariations->{"Underline"->True}],
 " the function   ",
 StyleBox["f2",
  FontWeight->"Bold"],
 "   is called, then the right-hand side will be evaluated \n\tanew and \
thereby generating a ",
 StyleBox["new and different",
  FontVariations->{"Underline"->True}],
 " evaluation of ",
 StyleBox["RandomReal[ ]",
  FontWeight->"Bold"],
 ").\n\n\[GrayCircle] \tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n\t\tClear ",
 StyleBox["f1",
  FontWeight->"Bold"],
 ",",
 StyleBox["f2",
  FontWeight->"Bold"],
 " and ",
 StyleBox["x",
  FontWeight->"Bold"],
 "\n\t\tFind information about   ",
 StyleBox["RandomReal",
  FontWeight->"Bold"],
 "   using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\t\tDefine   ",
 StyleBox["f1[x_]",
  FontWeight->"Bold"],
 "   to be   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"RandomReal", "[", " ", "]"}], "*", "x"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "25c5754f-4824-4b83-8987-522f15bce466"],
 "   using immediate assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "1daf78b0-09b3-4611-a63c-135e2bbe8876"],
 "\"\n\t\tEvaluate   ",
 StyleBox["f1[x]",
  FontWeight->"Bold"],
 "\n\t\tEvaluate   ",
 StyleBox["f1[x]",
  FontWeight->"Bold"],
 "\n\t\tEvaluate   ",
 StyleBox["f1[x]",
  FontWeight->"Bold"],
 "\n\t\tPlot   ",
 StyleBox["f1",
  FontWeight->"Bold"],
 "  for   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
    "0", " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "d3b92cf7-8be6-4e08-b07c-41f6e2fa7b97"],
 "\n\t\tFind information about   ",
 StyleBox["f1",
  FontWeight->"Bold"],
 "   using the \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" command\n\t\tDefine   ",
 StyleBox["f2[x_]",
  FontWeight->"Bold"],
 "   to be   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"RandomReal", "[", " ", "]"}], "*", "x"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "d96a89a9-6f5f-4a92-9e20-580d4fc24f18"],
 "   using delayed assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "6cafc4e5-0616-4eba-b9fe-7d5e61ef6be9"],
 "\"\n\t\tEvaluate   ",
 StyleBox["f2[x]",
  FontWeight->"Bold"],
 "\n\t\tEvaluate   ",
 StyleBox["f2[x]",
  FontWeight->"Bold"],
 "\n\t\tEvaluate   ",
 StyleBox["f2[x]",
  FontWeight->"Bold"],
 "\n\t\tPlot   ",
 StyleBox["f2",
  FontWeight->"Bold"],
 "  for   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
    "0", " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "3098ec4a-ab4e-47e4-b57a-456c48cbc5e8"],
 "\n\t\tFind information about   ",
 StyleBox["f2",
  FontWeight->"Bold"],
 "   using the \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" command\n\t\n\[GrayCircle] \tExplain the above results (in a Text Cell):\
\n"
}], "Text",
 CellChangeTimes->{{3.3903470036814003`*^9, 3.3903470125643997`*^9}, {
   3.3903491056144*^9, 3.3903491060504*^9}, {3.390371595508*^9, 
   3.3903716523120003`*^9}, {3.39037168684*^9, 3.3903716949300003`*^9}, {
   3.3903717295150003`*^9, 3.390371877376*^9}, {3.390371935167*^9, 
