Cell["\<\
6: Defining a function, differentiating, integrating, solving, plotting\
\>", "Section",ExpressionUUID->"50cc0813-2e76-4ec8-ad41-a7ef4ab99f9e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "f"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{"Sin", "[", "x", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"7b1c5e47-4453-4a50-9118-6ffdbc083a6f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "\[Pi]", "]"}], ",", 
   RowBox[{"f", "[", 
    FractionBox["\[Pi]", "2"], "]"}], ",", 
   RowBox[{"f", "[", "6.`", "]"}]}], "}"}]], "Input",ExpressionUUID->\
"b9499acc-f78a-42be-baa0-9ddc061295b5"],

Cell["?f", "Input",ExpressionUUID->"ae30a8f5-b732-486e-a20f-93bd2147517b"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "x"], 
  RowBox[{"f", "[", "x", "]"}]}]], "Input",ExpressionUUID->"4ab234a6-e8fd-\
459a-b793-10f4e7d1a306"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["f", "\[Prime]",
   MultilineFunction->None], "[", "x", "]"}]], "Input",ExpressionUUID->\
"14c6ae12-f624-4970-8ad9-21348f610f3f"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"a45c80bf-\
fe2c-41ef-b35f-46d6a70370f1"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"3", " ", 
      RowBox[{"f", "[", "x", "]"}]}], "+", "4"}], "\[Equal]", "0"}], ",", 
   "x"}], "]"}]], "Input",ExpressionUUID->"932fda66-c047-4d36-ae9e-\
6eac93054196"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"a614f425-808a-4d95-8cef-8fc6359cc82c"],

Cell["7: f[x] = x^2 versus f[x_] = E^x versus f[2] = Pi", "Section",ExpressionUUID->"107cb491-cb70-4c42-97f7-65027ec35525"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "x", ",", "f", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], "=", 
   SuperscriptBox["x", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   SuperscriptBox["\[ExponentialE]", "x"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "2", "]"}], "=", "\[Pi]"}], ";"}]}], "Input",ExpressionUU\
ID->"50906c67-0cc7-48c8-92ed-9e513aa495a4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"f", "[", "a", "]"}], ",", 
   RowBox[{"f", "[", "y", "]"}], ",", 
   RowBox[{"f", "[", "2", "]"}], ",", 
   RowBox[{"f", "[", "3", "]"}]}], "}"}]], "Input",ExpressionUUID->"b4907af3-\
db86-460b-a828-7c90f814bc0c"],

Cell["?f", "Input",ExpressionUUID->"984b88d2-926b-46aa-b16d-1e8c8ce7404c"],

Cell["8: Immediate versus delayed assignment with RandomReal", "Section",ExpressionUUID->"7875ea07-a9e7-4f75-83cd-9037236cf474"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f1", ",", "f2", ",", "x"}], "]"}], ";"}]], "Input",ExpressionUUID->\
"82977c43-4ec2-4533-a103-623da585b554"],

