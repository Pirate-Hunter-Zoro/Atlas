     RowBox[{"2", " ", "\[Pi]"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"a614f425-808a-4d95-8cef-8fc6359cc82c"],

Cell["\<\
f[Pi] is exactly 0 and f[Pi/2] is exactly 1, because Pi is the exact symbol \
and Mathematica knows those values. f[6.0] is -0.279415, an approximate \
number, because 6.0 is approximate: one approximate input makes the whole \
answer approximate.\
\>", "Text",ExpressionUUID->"f2a2633c-d38d-4031-8dc9-7bd87e319d9c"],

Cell[TextData[{
 StyleBox["7:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n\[GrayCircle]\t ",
 StyleBox["Clear[ a, x, f, y ]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Define a function:    ",
 StyleBox["f",
  FontWeight->"Bold"],
 "    of the ",
 StyleBox["specific",
  FontVariations->{"Underline"->True}],
 " symbol:   ",
 StyleBox["x",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "   and ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 "   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "   to be    ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "2"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e4f26377-fa9c-40b9-b825-13f271d5e02c"],
 "   by   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "  ", "=", "  ", 
     SuperscriptBox["x", "2"]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "1a7bd595-fef8-46c0-a18d-5cde729b9a4a"],
 ".\n\t Use the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SuperscriptBox[\\(\[FilledSquare]\\), \\(\
\[Placeholder]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9, 3.3903461483704*^9, 
   3.3903467799474*^9},ExpressionUUID->"63dc388f-67b8-445b-b732-50104185cb82"],
 ".\n\t (Note that there is no  \"",
 StyleBox["_",
  FontWeight->"Bold"],
 "\"  used in the above definition.)\n\[GrayCircle]\t ",
 StyleBox["Without",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["clearing",
  FontVariations->{"Underline"->True}],
 " the definition of   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  define a function:    ",
 StyleBox["f",
  FontWeight->"Bold"],
 "    of the variable:   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "   \n\t to be    ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["\[ExponentialE]", "x"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b88cabfc-2924-4e29-a3c1-5fdeb0b8c9e4"],
 "   by   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "  ", "=", 
     SuperscriptBox["\[ExponentialE]", "x"]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "bc52a01f-8b0e-4147-8be2-4a92b3b4b94d"],
 "\n\t (Note that  \"",
 StyleBox["_",
  FontWeight->"Bold"],
 "\"  is used in the above definition.)\n\t Use the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette functions ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SuperscriptBox[\\(\[FilledSquare]\\), \\(\
\[Placeholder]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9, 3.3903461483704*^9, 
   3.3903467799474*^9},ExpressionUUID->"d7fde914-4363-49e6-bbe8-5e8be9a0b772"],
 " and ",
 Cell[BoxData[
  ButtonBox["\<\" \[ExponentialE] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903480045254*^9, 3.3903485225174*^9, 
   3.3903487686774*^9},ExpressionUUID->"d597a78d-7d4d-4eb1-afb3-f029d6a679a9"],
 " to get  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["\[ExponentialE]", "x"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "eec6981d-8f02-4574-a8e1-a28f29b769ff"],
 "  and ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 "  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["e", "x"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "97261cfb-2f4e-47c5-99fa-8eb56eee7021"],
 ".\n \[GrayCircle]\t ",
 StyleBox["Without",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["clearing",
  FontVariations->{"Underline"->True}],
 " the definition of   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  define a function:    ",
 StyleBox["f",
  FontWeight->"Bold"],
 "    at  ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    StyleBox[
     RowBox[{"x", "=", "2"}],
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "3a5a3b0f-fef8-44a4-9588-3826f43e1159"],
 "  \n\t to be    ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Pi]",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "c592603b-7d59-4187-97ee-8b8a43d2a4a6"],
 "   by   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "2", "]"}], "  ", "=", " ", "\[Pi]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "ff098424-6d8d-4cc6-948f-bd17a1eee2e5"],
 " \n\t Use the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette button  ",
 Cell[BoxData[
  ButtonBox["\<\" \[Pi] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903480045254*^9, 3.3903485225174*^9},ExpressionUUID->
  "043f599e-69ea-4b6a-b6cd-ae38811ac916"],
 ".\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[x]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[a]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[y]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[2]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[3] ",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Explain the results (in a Text Cell):\n\[GrayCircle]\t \
Check the values assigned to the function:    ",
 StyleBox[" f",
  FontWeight->"Bold"],
 "     using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" \n\[GrayCircle]\t Explain the results (in a Text Cell):\n"
}], "Text",
 CellChangeTimes->{{3.3903469622094*^9, 3.3903469905234003`*^9}, {
