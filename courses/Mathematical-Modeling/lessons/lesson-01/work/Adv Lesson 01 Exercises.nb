->"aea6635f-5891-4cf4-b6dc-80bf367ea023"],

Cell["?f2", "Input",ExpressionUUID->"61c5bb06-f590-4cfc-8a06-372c6e133eb3"],

Cell["\<\
With = the right-hand side is worked out once, when the definition is made, \
so a single random number is chosen and frozen: the three values of f1[x] are \
identical and the plot is a straight line. With := nothing is worked out \
until the function is called, so a new random number is drawn every time: the \
three values differ and the plot is a band of scattered points, because Plot \
calls the function once per plotted point.\
\>", "Text",ExpressionUUID->"96a7bcd8-4eef-4ff2-a0ed-03ae39018159"],

Cell[TextData[{
 StyleBox["9:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\[GrayCircle]\tClear  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["n",
  FontWeight->"Bold"],
 ".\n\[GrayCircle] \tEvaluate the derivative of the function:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "n"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "a737b6aa-a34d-4fa2-95c0-5eb900a8193e"],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using \n\tthe ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette functions  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SuperscriptBox[\\(\[FilledSquare]\\), \\(\
\[Placeholder]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9, 3.3903461483704*^9, 
   3.3903467799474*^9},ExpressionUUID->"4c8beb1f-e257-4323-9f5d-ef0765307a87"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   ButtonBox["\<\" \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \\(\[Placeholder]\
\\)]\\) \[FilledSquare] \"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], TraditionalForm]],ExpressionUUID->
  "7e618fc5-9176-41b1-a72c-8f105a8476b1"],
 ".\n\[GrayCircle] \tEvaluate the integral of the function:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "n"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "4ca8fc8b-90aa-4b9b-bac4-fa1ae79fd839"],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 ",  using \n\tthe ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function ",
 Cell[BoxData[
  ButtonBox["\<\" \[Integral]\[FilledSquare]\[DifferentialD]\[Square] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9},ExpressionUUID->
  "9652c8ea-0a64-4ea3-811c-fe8cb462163b"],
 ".\n\[GrayCircle] \tSolve the algebraic equation:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"x", "+", 
      SqrtBox["x"]}], "\[Equal]", "9"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e6177cfc-7f51-429c-8d43-a82f812f1c49"],
 "   for  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using the  ",
 StyleBox["Solve[ ... ]",
  FontWeight->"Bold"],
 "  command and\n\tthe ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SqrtBox[\\(\[FilledSquare]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3906038820243998`*^9},ExpressionUUID->
  "a9431318-c340-4303-b8a8-96066e117d09"],
 ".\n\tRemember, the  ",
 StyleBox["==",
  FontWeight->"Bold"],
 "  is typed as  ",
 StyleBox["=",
  FontWeight->"Bold"],
 "  followed by another ",
 StyleBox[" =",
  FontWeight->"Bold"],
 " . \n\[GrayCircle] \tPlot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    StyleBox[
     RowBox[{
      SuperscriptBox["x", "3"], "-", 
      RowBox[{"2", "x"}], "+", "1", " "}],
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "134ca498-ad91-4228-9897-8960c99aa991"],
 "   for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "2"}], "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "772d0508-d253-4d2b-973c-58d495b6fa84"],
 "  using the  ",
 StyleBox["Plot[ ... ]",
  FontWeight->"Bold"],
 "  command and\n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette button  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SuperscriptBox[\\(\[FilledSquare]\\), \\(\
\[Placeholder]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3906051182934*^9},ExpressionUUID->
  "34ab691a-9fda-4765-a172-6fb00aaec3a3"],
 "  to enter  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "3"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "12cc8cba-a387-49f6-8a02-ee464716dc5a"],
 ".\n\[GrayCircle] \tExplain the above results (in a Text Cell):\n"
}], "Text",
