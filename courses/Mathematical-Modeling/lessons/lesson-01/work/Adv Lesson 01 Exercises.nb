   3.390374356682*^9, 3.390374383592*^9}, {3.390374650385*^9, 
   3.390374674127*^9}, {3.390374729801*^9, 3.390374731487*^9}, {
   3.390374777387*^9, 3.3903747968199997`*^9}, 3.3906070003274*^9, {
   3.3906073636334*^9, 3.3906074884714003`*^9}, {3.439057279703125*^9, 
