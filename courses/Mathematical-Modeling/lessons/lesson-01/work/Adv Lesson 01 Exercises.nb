Cell[TextData[{
 StyleBox["3:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells for each question immediately below this Text Cell.\n\n\tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "1180ab6a-91ca-4c42-acef-d0a34b7f4367"],
 " \t",
 StyleBox["Clear[ a, A ];",
  FontWeight->"Bold"],
 "\n \tEvaluate the product:  ",
 StyleBox["a*A",
  FontWeight->"Bold"],
 "\n \t(Use one Input cell for both lines and be sure to use the \"",
 StyleBox[";",
  FontWeight->"Bold"],
 "\")\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "427b723c-50cf-4d4d-8d2b-7ab598c61112"],
 " \tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "  using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\t(Use two Input cells.)\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "6ea99ce5-da12-44c6-b1da-ebe382963d3c"],
 "\tAssign  ",
 StyleBox["5",
  FontWeight->"Bold"],
 "  to  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "b454168b-7755-4ecd-a4d6-60b675355c61"],
 "\tEvaluate  ",
 StyleBox["a*A",
  FontWeight->"Bold"],
 "\n\t(Use a new Input cell.)\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "d1ab3e32-30ba-4d60-8f44-9b60e995e0e0"],
 " \tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "  using \"?\"\n\t(Use two Input cells.)\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "a9147b4d-5f4c-43c7-9f09-fba0a60ce439"],
 " \tAssign  ",
 StyleBox["6",
  FontWeight->"Bold"],
 "  to  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "0a43f4cd-3a8c-4f43-92d0-f0f072bb508f"],
 " \tEvaluate  ",
 StyleBox["a*A",
  FontWeight->"Bold"],
 "  again\n\t(Use a new Input cell.)\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "e7c88029-c190-463d-aed9-b98c82518c77"],
 "\tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "  using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\t(Use two Input cells.)\n\t\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "4ad65a39-726a-423c-a8b3-c19af20226e6"],
 "\tAssign   ",
 StyleBox["7",
  FontWeight->"Bold"],
 "   to   ",
 StyleBox["A",
  FontWeight->"Bold"],
 "\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "ce189689-f30c-4a23-98b3-c777ad4e34ec"],
 " \tEvaluate  ",
 StyleBox["a*A",
  FontWeight->"Bold"],
 "\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "861a0932-c2fa-4fed-b7ff-ec9f32827ab2"],
 " \tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "  using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]],ExpressionUUID->
  "b652dde2-dcb3-4955-9cc0-fd8120b05d05"],
 "\tBriefly explain your results (in a ",
 StyleBox["Text",
  FontVariations->{"Underline"->True}],
 " Cell located below your Input-Output cells):\n"
}], "Text",
 CellChangeTimes->{{3.3903433382194*^9, 3.3903436602223997`*^9}, {
   3.3903436974694*^9, 3.3903438139524*^9}, {3.3903438633504*^9, 
