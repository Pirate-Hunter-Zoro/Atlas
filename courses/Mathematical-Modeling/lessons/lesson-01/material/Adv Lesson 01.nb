Cell[TextData[{
 StyleBox["5:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n\[GrayCircle]\t",
 StyleBox["Clear[ a, A, feet, sec ];",
  FontWeight->"Bold"],
 "\n \tEvaluate ",
 StyleBox["a/A",
  FontWeight->"Bold"],
 "\n \t(Use one Input cell for both lines and be sure to use the \"",
 StyleBox[";",
  FontWeight->"Bold"],
 "\") \t\n\[GrayCircle] \tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\tAssign:    ",
 StyleBox["5 feet / sec",
  FontWeight->"Bold"],
 "     to:   ",
 StyleBox["A",
  FontWeight->"Bold"],
 "\n\t(i.e.   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A",
     FontSlant->"Plain"], " ", "=", " ", 
    RowBox[{"5", " ", 
     RowBox[{"feet", "/", "sec"}]}]}], TraditionalForm]],
  FontWeight->"Bold"],
 ")\n\[GrayCircle]\tEvaluate   ",
 StyleBox["a/A",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\tAssign:       ",
 StyleBox["10 feet",
  FontWeight->"Bold"],
 "      to:    ",
 StyleBox["a",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\tEvaluate ",
 StyleBox["a/A",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\tCheck the values assigned to both:   ",
 StyleBox["feet",
  FontWeight->"Bold"],
 "   and:   ",
 StyleBox["sec",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\tExplain the results (in a ",
 StyleBox["Text",
  FontVariations->{"Underline"->True}],
 " Cell).\n"
}], "Text",
