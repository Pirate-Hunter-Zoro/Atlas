  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Help: Documentation Center", "Subtitle"]], "Section",
 CellChangeTimes->{{3.3902128652869997`*^9, 3.3902128808199997`*^9}}],

Cell[TextData[{
 "Extensive (and well organized) help is available from the \n\n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Help", ">>", 
     RowBox[{"Documentation", " ", "Center"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\nmenu item at the top of your screen.  You should examine the contents \
of the Help Documentation Center program in detail.  Please note that the ",
 StyleBox["Help Documentation Center",
  FontWeight->"Bold"],
 " is written as a live ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebook, and therefore most entries can be evaluated (and even modified) \
within the ",
 StyleBox["Help Documentation Center",
  FontWeight->"Bold"],
 " notebook.  Use the ",
 StyleBox["Help Documentation Center",
  FontWeight->"Bold"],
 " to help you generate your own code or to illustrate ideas on how your \
needs may be accomplished.  The ",
 StyleBox["Help Documentation Center",
  FontWeight->"Bold"],
 " is especially valuable because it illustrates the vast range of \
capabilities that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " offers."
}], "Text",
 CellChangeTimes->{{3.390194073852*^9, 3.390194192383*^9}, {3.3901942336*^9, 
  3.3901942556029997`*^9}}],

Cell[CellGroupData[{

Cell["Example", "Subsection"],

Cell[TextData[{
 "Say that you want to plot a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "x", "]"}], TraditionalForm]]],
 " using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  Because you are a new user, you decide to use the ",
 StyleBox["Help Documentation Center",
  FontWeight->"Bold"],
 " to locate the appropriate ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command."
}], "Text",
 CellChangeTimes->{{3.3901945263389997`*^9, 3.39019453356*^9}}],

