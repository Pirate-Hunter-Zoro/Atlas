   3.3907731207200003`*^9, 3.390773162273*^9}, {3.390773195514*^9, 
   3.3907732524849997`*^9}}],

Cell[TextData[{
 StyleBox["3:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells for each question immediately below this Text Cell.\n\n\tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \t",
 StyleBox["Clear[ a, A ];",
  FontWeight->"Bold"],
 "\n \tEvaluate the product:  ",
 StyleBox["a*A",
  FontWeight->"Bold"],
 "\n \t(Use one Input cell for both lines and be sure to use the \"",
 StyleBox[";",
  FontWeight->"Bold"],
 "\")\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "  using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\t(Use two Input cells.)\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 "\tAssign  ",
 StyleBox["5",
  FontWeight->"Bold"],
 "  to  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 "\tEvaluate  ",
 StyleBox["a*A",
  FontWeight->"Bold"],
 "\n\t(Use a new Input cell.)\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "  using \"?\"\n\t(Use two Input cells.)\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \tAssign  ",
 StyleBox["6",
  FontWeight->"Bold"],
 "  to  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \tEvaluate  ",
 StyleBox["a*A",
  FontWeight->"Bold"],
 "  again\n\t(Use a new Input cell.)\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 "\tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "  using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\t(Use two Input cells.)\n\t\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 "\tAssign   ",
 StyleBox["7",
  FontWeight->"Bold"],
 "   to   ",
 StyleBox["A",
  FontWeight->"Bold"],
 "\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \tEvaluate  ",
 StyleBox["a*A",
  FontWeight->"Bold"],
 "\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \tCheck the values assigned to both:  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and:  ",
 StyleBox["A",
  FontWeight->"Bold"],
 "  using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 "\tBriefly explain your results (in a ",
 StyleBox["Text",
  FontVariations->{"Underline"->True}],
 " Cell located below your Input-Output cells):\n"
}], "Text",
 CellChangeTimes->{{3.3903433382194*^9, 3.3903436602223997`*^9}, {
   3.3903436974694*^9, 3.3903438139524*^9}, {3.3903438633504*^9, 
