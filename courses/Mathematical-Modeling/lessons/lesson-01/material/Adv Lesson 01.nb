Cell[TextData[{
 StyleBox["7:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n\[GrayCircle]\t ",
 StyleBox["Clear[ a, x, f, y ]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Define a function:    ",
 StyleBox["f",
  FontWeight->"Bold"],
 "    of the ",
 StyleBox["specific",
  FontVariations->{"Underline"->True}],
 " symbol:   ",
 StyleBox["x",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "   and ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 "   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "   to be    ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "2"],
    FontWeight->"Bold"], TraditionalForm]]],
 "   by   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "  ", "=", "  ", 
     SuperscriptBox["x", "2"]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n\t Use the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SuperscriptBox[\\(\[FilledSquare]\\), \\(\
\[Placeholder]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9, 3.3903461483704*^9, 
   3.3903467799474*^9}],
 ".\n\t (Note that there is no  \"",
 StyleBox["_",
  FontWeight->"Bold"],
 "\"  used in the above definition.)\n\[GrayCircle]\t ",
 StyleBox["Without",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["clearing",
  FontVariations->{"Underline"->True}],
 " the definition of   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  define a function:    ",
 StyleBox["f",
  FontWeight->"Bold"],
 "    of the variable:   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "   \n\t to be    ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["\[ExponentialE]", "x"],
    FontWeight->"Bold"], TraditionalForm]]],
 "   by   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "  ", "=", 
     SuperscriptBox["\[ExponentialE]", "x"]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t (Note that  \"",
 StyleBox["_",
  FontWeight->"Bold"],
 "\"  is used in the above definition.)\n\t Use the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette functions ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SuperscriptBox[\\(\[FilledSquare]\\), \\(\
\[Placeholder]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9, 3.3903461483704*^9, 
   3.3903467799474*^9}],
 " and ",
 Cell[BoxData[
  ButtonBox["\<\" \[ExponentialE] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903480045254*^9, 3.3903485225174*^9, 
   3.3903487686774*^9}],
 " to get  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["\[ExponentialE]", "x"],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 "  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["e", "x"],
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n \[GrayCircle]\t ",
 StyleBox["Without",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["clearing",
  FontVariations->{"Underline"->True}],
 " the definition of   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  define a function:    ",
 StyleBox["f",
  FontWeight->"Bold"],
 "    at  ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    StyleBox[
     RowBox[{"x", "=", "2"}],
     FontWeight->"Bold"]}], TraditionalForm]]],
 "  \n\t to be    ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Pi]",
    FontWeight->"Bold"], TraditionalForm]]],
 "   by   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "2", "]"}], "  ", "=", " ", "\[Pi]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " \n\t Use the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette button  ",
 Cell[BoxData[
  ButtonBox["\<\" \[Pi] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903480045254*^9, 3.3903485225174*^9}],
 ".\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[x]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[a]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[y]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[2]",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Evaluate:  ",
 StyleBox["f[3] ",
  FontWeight->"Bold"],
 "\n\[GrayCircle]\t Explain the results (in a Text Cell):\n\[GrayCircle]\t \
Check the values assigned to the function:    ",
 StyleBox[" f",
  FontWeight->"Bold"],
 "     using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" \n\[GrayCircle]\t Explain the results (in a Text Cell):\n"
}], "Text",
 CellChangeTimes->{{3.3903469622094*^9, 3.3903469905234003`*^9}, {
   3.3903480761703997`*^9, 3.3903481496464*^9}, {3.3903481876514*^9, 
   3.3903482390313997`*^9}, {3.3903482832844*^9, 3.3903484391674*^9}, {
   3.3903485677584*^9, 3.3903485719514*^9}, {3.3903486128624*^9, 
   3.3903486845284*^9}, {3.3903487261614*^9, 3.3903487485334*^9}, {
   3.3903488026014*^9, 3.3903488605524*^9}, {3.3903489179444*^9, 
   3.3903489652293997`*^9}, {3.3903489984184*^9, 3.3903490057074003`*^9}, {
   3.3903491003073997`*^9, 3.3903491005903997`*^9}, 3.390367565302*^9, {
   3.3906055756744003`*^9, 3.3906057683724003`*^9}, {3.3906058448534*^9, 
   3.3906058489104*^9}, {3.3906058811274*^9, 3.3906058995783997`*^9}, 
   3.3906070098314*^9, 3.3906073542293997`*^9, {3.390773422507*^9, 
   3.390773487395*^9}, {3.3907735231540003`*^9, 3.3907735675150003`*^9}}],

Cell[TextData[{
 StyleBox["8:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\tThe following exercise \
illustrates a circumstance where using delayed assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" and \n\timmediate assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" do ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " give the same result.  The idea is to define a function which \n\twill \
generate random real numbers between 0 and 1 scaled by the size of   x.  \n\n\
\tWhen ",
 StyleBox["immediate",
  FontVariations->{"Underline"->True}],
 " assignment \"",
 StyleBox["=",
  FontWeight->"Bold"],
 "\" is used to define the function ",
 StyleBox["f1[x_]",
  FontWeight->"Bold"],
 "\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f1", "[", "x_", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"RandomReal", "[", " ", "]"}], "*", "x", " "}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  \n\t\n\tthen the right hand side will be evaluated ",
 StyleBox["immediately once and only once",
  FontVariations->{"Underline"->True}],
 ".  Therefore  ",
 StyleBox["RandomReal[ ]",
  FontWeight->"Bold"],
 "   \n\twill be called ",
 StyleBox["once and only once",
  FontVariations->{"Underline"->True}],
 " and therefore would have only ",
 StyleBox["one",
  FontVariations->{"Underline"->True}],
 " value no matter how many other \n\ttimes you call the function  ",
 StyleBox["f1",
  FontWeight->"Bold"],
 ".\n\n\tWhen delayed assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" is used to define the function ",
 StyleBox["f2[x_]",
  FontWeight->"Bold"],
 "\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f2", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"RandomReal", "[", " ", "]"}], "*", "x", "   "}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\n\tthen the right hand side will ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " be evaluated ",
 StyleBox["until",
  FontVariations->{"Underline"->True}],
 " the function   ",
 StyleBox["f2",
  FontWeight->"Bold"],
 "  is called ",
 StyleBox["later",
  FontVariations->{"Underline"->True}],
 ".  And the function  \n\tmay be called ",
 StyleBox["many",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["many",
  FontVariations->{"Underline"->True}],
 " different times (as would occur when you generate a plot of the function",
 StyleBox[" f2",
  FontWeight->"Bold"],
 "). \n\tTherefore ",
 StyleBox["each and every time",
  FontVariations->{"Underline"->True}],
 " the function   ",
 StyleBox["f2",
  FontWeight->"Bold"],
 "   is called, then the right-hand side will be evaluated \n\tanew and \
thereby generating a ",
 StyleBox["new and different",
  FontVariations->{"Underline"->True}],
 " evaluation of ",
 StyleBox["RandomReal[ ]",
  FontWeight->"Bold"],
 ").\n\n\[GrayCircle] \tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n\t\tClear ",
 StyleBox["f1",
  FontWeight->"Bold"],
 ",",
 StyleBox["f2",
  FontWeight->"Bold"],
 " and ",
 StyleBox["x",
  FontWeight->"Bold"],
 "\n\t\tFind information about   ",
 StyleBox["RandomReal",
  FontWeight->"Bold"],
 "   using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\"\n\t\tDefine   ",
 StyleBox["f1[x_]",
  FontWeight->"Bold"],
 "   to be   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"RandomReal", "[", " ", "]"}], "*", "x"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   using immediate assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\"\n\t\tEvaluate   ",
 StyleBox["f1[x]",
  FontWeight->"Bold"],
 "\n\t\tEvaluate   ",
 StyleBox["f1[x]",
  FontWeight->"Bold"],
 "\n\t\tEvaluate   ",
 StyleBox["f1[x]",
  FontWeight->"Bold"],
 "\n\t\tPlot   ",
 StyleBox["f1",
  FontWeight->"Bold"],
 "  for   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
    "0", " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\tFind information about   ",
 StyleBox["f1",
  FontWeight->"Bold"],
 "   using the \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" command\n\t\tDefine   ",
 StyleBox["f2[x_]",
  FontWeight->"Bold"],
 "   to be   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"RandomReal", "[", " ", "]"}], "*", "x"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   using delayed assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\"\n\t\tEvaluate   ",
 StyleBox["f2[x]",
  FontWeight->"Bold"],
 "\n\t\tEvaluate   ",
 StyleBox["f2[x]",
  FontWeight->"Bold"],
 "\n\t\tEvaluate   ",
 StyleBox["f2[x]",
  FontWeight->"Bold"],
 "\n\t\tPlot   ",
 StyleBox["f2",
  FontWeight->"Bold"],
 "  for   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
    "0", " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\tFind information about   ",
 StyleBox["f2",
  FontWeight->"Bold"],
 "   using the \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" command\n\t\n\[GrayCircle] \tExplain the above results (in a Text Cell):\
\n"
}], "Text",
 CellChangeTimes->{{3.3903470036814003`*^9, 3.3903470125643997`*^9}, {
   3.3903491056144*^9, 3.3903491060504*^9}, {3.390371595508*^9, 
   3.3903716523120003`*^9}, {3.39037168684*^9, 3.3903716949300003`*^9}, {
   3.3903717295150003`*^9, 3.390371877376*^9}, {3.390371935167*^9, 
   3.390372066119*^9}, {3.390372410538*^9, 3.3903726213059998`*^9}, {
   3.390372725369*^9, 3.390372735527*^9}, {3.390372811757*^9, 
   3.390372894584*^9}, {3.390373273884*^9, 3.390373312488*^9}, {
   3.3903733549849997`*^9, 3.390373427324*^9}, {3.390373592907*^9, 
   3.3903736184119997`*^9}, {3.390373651698*^9, 3.390373678199*^9}, {
   3.390373709263*^9, 3.390373788783*^9}, {3.390373822163*^9, 
   3.390373918389*^9}, {3.390373964138*^9, 3.3903739716029997`*^9}, {
   3.390374051825*^9, 3.390374126907*^9}, {3.39037420613*^9, 
   3.3903742422320004`*^9}, {3.3903742880039997`*^9, 3.390374312512*^9}, {
   3.390374356682*^9, 3.390374383592*^9}, {3.390374650385*^9, 
   3.390374674127*^9}, {3.390374729801*^9, 3.390374731487*^9}, {
   3.390374777387*^9, 3.3903747968199997`*^9}, 3.3906070003274*^9, {
   3.3906073636334*^9, 3.3906074884714003`*^9}, {3.439057279703125*^9, 
   3.439057325515625*^9}, {3.43905737825*^9, 3.439057405734375*^9}, {
   3.43905743646875*^9, 3.439057438171875*^9}, {3.439057500296875*^9, 
   3.439057554296875*^9}}],

Cell[TextData[{
 StyleBox["9:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\[GrayCircle]\tClear  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["n",
  FontWeight->"Bold"],
 ".\n\[GrayCircle] \tEvaluate the derivative of the function:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "n"],
    FontWeight->"Bold"], TraditionalForm]]],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using \n\tthe ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette functions  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SuperscriptBox[\\(\[FilledSquare]\\), \\(\
\[Placeholder]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9, 3.3903461483704*^9, 
   3.3903467799474*^9}],
 "  and  ",
 Cell[BoxData[
  FormBox[
   ButtonBox["\<\" \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \\(\[Placeholder]\
\\)]\\) \[FilledSquare] \"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], TraditionalForm]]],
 ".\n\[GrayCircle] \tEvaluate the integral of the function:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "n"],
    FontWeight->"Bold"], TraditionalForm]]],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 ",  using \n\tthe ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function ",
 Cell[BoxData[
  ButtonBox["\<\" \[Integral]\[FilledSquare]\[DifferentialD]\[Square] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9}],
 ".\n\[GrayCircle] \tSolve the algebraic equation:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"x", "+", 
      SqrtBox["x"]}], "\[Equal]", "9"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   for  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using the  ",
 StyleBox["Solve[ ... ]",
  FontWeight->"Bold"],
 "  command and\n\tthe ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SqrtBox[\\(\[FilledSquare]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3906038820243998`*^9}],
 ".\n\tRemember, the  ",
 StyleBox["==",
  FontWeight->"Bold"],
 "  is typed as  ",
 StyleBox["=",
  FontWeight->"Bold"],
 "  followed by another ",
 StyleBox[" =",
  FontWeight->"Bold"],
 " . \n\[GrayCircle] \tPlot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    StyleBox[
     RowBox[{
      SuperscriptBox["x", "3"], "-", 
      RowBox[{"2", "x"}], "+", "1", " "}],
     FontWeight->"Bold"]}], TraditionalForm]]],
 "   for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "2"}], "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  using the  ",
 StyleBox["Plot[ ... ]",
  FontWeight->"Bold"],
 "  command and\n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette button  ",
 Cell[BoxData[
  ButtonBox["\<\" \\!\\(\\*SuperscriptBox[\\(\[FilledSquare]\\), \\(\
\[Placeholder]\\)]\\) \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3906051182934*^9}],
 "  to enter  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "3"],
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n\[GrayCircle] \tExplain the above results (in a Text Cell):\n"
}], "Text",
 CellChangeTimes->{{3.3906043433664*^9, 3.3906043467044*^9}, {
   3.3906061155154*^9, 3.3906061291734*^9}, {3.3906061788403997`*^9, 
   3.3906062414294*^9}, 3.3906062940984*^9, {3.3906063926684*^9, 
   3.3906064359554*^9}, {3.3906065020814*^9, 3.3906065457874002`*^9}, {
   3.3906065785834*^9, 3.3906066080854*^9}, {3.3906067037324*^9, 
   3.3906067130713997`*^9}, 3.3906069030704*^9, 3.3906069944323997`*^9, 
   3.3906070838604*^9}],

Cell[TextData[{
 StyleBox["10",
  FontSize->16,
  FontWeight->"Bold"],
 ": Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\[GrayCircle]\tUsing the \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" command, find information about:   ",
 StyleBox["Style",
  FontWeight->"Bold"],
 "\n\t(Then follow the link ",
 StyleBox[">>",
  FontWeight->"Bold"],
 " to ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to glimpse how ",
 StyleBox["Style",
  FontWeight->"Bold"],
 " works.)\n\t\n\tUsing the \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" command and the wild card \" ",
 Cell[BoxData[
  FormBox[
   StyleBox["*",
    FontWeight->"Bold"], TraditionalForm]]],
 StyleBox[" ",
  FontWeight->"Bold"],
 "\", determine:\n \n\[GrayCircle] \t",
 StyleBox["All",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands that ",
 StyleBox["start",
  FontVariations->{"Underline"->True}],
 " with:   ",
 StyleBox["Style",
  FontWeight->"Bold"],
 "\n\t(there are about 12).\n\[GrayCircle] \t",
 StyleBox["All",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands that ",
 StyleBox["end",
  FontVariations->{"Underline"->True}],
 " in:   ",
 StyleBox["Style",
  FontWeight->"Bold"],
 "\n\t(there are about 45).\n\[GrayCircle] \t",
 StyleBox["All",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands that ",
 StyleBox["contain",
  FontVariations->{"Underline"->True}],
 " the word:   ",
 StyleBox["Style",
  FontWeight->"Bold"],
 "  \n\t(there are about 65)."
}], "Text",
 CellChangeTimes->{{3.3903470213124*^9, 3.3903470262264*^9}, {
   3.3903470790294*^9, 3.3903470862054*^9}, {3.3903471415573997`*^9, 
   3.3903471882094*^9}, {3.3903472621724*^9, 3.3903472635354*^9}, {
   3.3903473042244*^9, 3.3903473053164*^9}, {3.3903473713894*^9, 
   3.3903473737794*^9}, {3.3903474221454*^9, 3.3903474267774*^9}, {
   3.3903474661974*^9, 3.3903474911134*^9}, {3.3903475230204*^9, 
   3.3903476227883997`*^9}, {3.3903477033374*^9, 3.3903477995874*^9}, {
   3.3903491129494*^9, 3.3903491135053997`*^9}, {3.3906069592824*^9, 
   3.3906069598213997`*^9}, 3.3906075003154*^9}],

Cell[TextData[{
 "\n\n",
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox[
     RowBox[{
      StyleBox["Print",
       FontSize->16], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["your",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["homework",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["exercises",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["using",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["the",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["following",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox[
       RowBox[{"steps", ":"}],
       FontSize->14]}],
     FontWeight->"Bold",
     FontColor->RGBColor[1, 0, 0]]], TraditionalForm]],
  FontSize->16],
 "\n\n \[GrayCircle] At the top of your exercises, enter your name, your \
class and your quiz section into the top text cell as illustrated below:\n\n \
\[GrayCircle] Select ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " the 2nd outer cell bracket containing ",
 StyleBox["ONLY",
  FontVariations->{"Underline"->True}],
 " the ",
 StyleBox["exercises",
  FontVariations->{"Underline"->True}],
 " section. (Do NOT print the lesson.):"
}], "Text",
 CellChangeTimes->{{3.390428545079*^9, 3.390428598755*^9}, {
   3.3904286397200003`*^9, 3.390429050267*^9}, {3.390429145796*^9, 
