Cell[TextData[{
 StyleBox["6:",
  FontSize->16,
  FontWeight->"Bold"],
 " Insert your answers to the following questions by inserting new Input \
Cells immediately below this Text Cell.\n\n\tEnter the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code which accomplishes the following:\n\n\[GrayCircle]\t",
 StyleBox["Clear[ x, f ]",
  FontWeight->"Bold"],
 "\n\tDefine a function:    ",
 StyleBox["f",
  FontWeight->"Bold"],
 "    of the variable:   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "   to be the ",
 StyleBox["Sin[x]",
  FontWeight->"Bold"],
 ".\n\t(Remember to use the  \"",
 StyleBox["_",
  FontWeight->"Bold"],
 "\".)\n \t(Use one Input cell for both lines of code and be sure to use the \
\"",
 StyleBox[";",
  FontWeight->"Bold"],
 "\")\n\[GrayCircle]\tEvaluate the Sine of   ",
 StyleBox["\[Pi]",
  FontWeight->"Bold"],
 "   and   ",
 StyleBox["\[Pi]/2",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["6.0",
  FontWeight->"Bold"],
 "  using ",
 StyleBox["your",
  FontVariations->{"Underline"->True}],
 " function:   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  and\n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette button  ",
 Cell[BoxData[
  ButtonBox["\<\" \[Pi] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3906051182934*^9}],
 "  to enter  \[Pi].\n\t(i.e. evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{
      StyleBox["f",
       FontSlant->"Plain"], "[", "\[Pi]", "]"}],
     FontWeight->"Bold"], ",", " ", 
    StyleBox[
     RowBox[{
      StyleBox["f",
       FontSlant->"Plain"], "[", 
      RowBox[{"\[Pi]", "/", "2"}], "]"}],
     FontWeight->"Bold"], ",", " ", 
    StyleBox[
     RowBox[{
      StyleBox["f",
       FontSlant->"Plain"], "[", "6.0", "]"}],
     FontWeight->"Bold"]}], TraditionalForm]]],
 ")\n\[GrayCircle]\tExplain the results (in a ",
 StyleBox["Text",
  FontVariations->{"Underline"->True}],
 " Cell).\n\[GrayCircle] \tCheck the value assigned to the function:     ",
 StyleBox["f",
  FontWeight->"Bold"],
 "     using \"",
 StyleBox["?",
  FontWeight->"Bold"],
 "\" \n\[GrayCircle] \tEvaluate the derivative of the function:   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 ",  i.e.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ",  \n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function ",
 Cell[BoxData[
  FormBox[
   ButtonBox["\<\" \\!\\(\\*SubscriptBox[\\(\[PartialD]\\), \\(\[Placeholder]\
\\)]\\) \[FilledSquare] \"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], TraditionalForm]]],
 ".\n\t(The Output cell will contain:  ",
 StyleBox["Cos[x]",
  FontWeight->"Bold"],
 " )\n\[GrayCircle] \tEvaluate the derivative of the function:   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using \n\tthe alternate notation    ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t(The Output cell will contain:  ",
 StyleBox["Cos[x]",
  FontWeight->"Bold"],
 " )\n\[GrayCircle] \tEvaluate the integral of the function:   ",
 StyleBox["f",
  FontWeight->"Bold"],
 "   with respect to  ",
 StyleBox["x",
  FontWeight->"Bold"],
 ",  i.e.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ", \n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette function ",
 Cell[BoxData[
  ButtonBox["\<\" \[Integral]\[FilledSquare]\[DifferentialD]\[Square] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3903460307874002`*^9}],
 ".\n\[GrayCircle] \tSolve the equation:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"3", 
       RowBox[{"f", "[", "x", "]"}]}], "+", "4"}], "\[Equal]", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   for  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  using the  ",
 StyleBox["Solve[ ... ]",
  FontWeight->"Bold"],
 "  command.\n\tRemember, the  ",
 StyleBox["==",
  FontWeight->"Bold"],
 "  is typed as  ",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 "  followed by another  ",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 " . \n\[GrayCircle] \tPlot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    StyleBox[
     RowBox[{"f", "[", "x", "]"}],
     FontWeight->"Bold"]}], TraditionalForm]]],
 "   for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", 
     RowBox[{"2", "\[Pi]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  using the  ",
 StyleBox["Plot[ ... ]",
  FontWeight->"Bold"],
 "  command and\n\tby using the ",
 StyleBox["Basic Math Input",
  FontVariations->{"Underline"->True}],
 " Palette button  ",
 Cell[BoxData[
  ButtonBox["\<\" \[Pi] \"\>",
   Appearance->{Automatic, "DialogBox"},
   ButtonFunction:>{},
   Evaluator->None,
   Method->"Preemptive"]],
  CellChangeTimes->{3.3906051182934*^9}],
 "  to enter  \[Pi].\n\t"
}], "Text",
