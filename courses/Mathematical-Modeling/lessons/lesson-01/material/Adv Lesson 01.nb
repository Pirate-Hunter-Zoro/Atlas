  RowBox[{
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Shift\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], "-", 
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Enter\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"]}]],
  CellChangeTimes->{{3.3902570408182*^9, 3.3902570426292*^9}},
  FontSize->14],
 " ) the following ",
 StyleBox["Input",
  FontWeight->"Bold"],
 " Cell to clear and remove any existing definitions from memory before you \
start this lesson."
}], "Text",
 CellChangeTimes->{{3.3907793381137037`*^9, 3.3907794823047037`*^9}, {
   3.3907795655947037`*^9, 3.3907795802237043`*^9}, 3.390781425592704*^9, {
   3.4390400768125*^9, 3.43904008403125*^9}}],

