Cell[TextData[{
 "\nPlay arround ",
 StyleBox["within",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s: ",
 StyleBox["Documentation Center: \"Plot\"",
  FontWeight->"Bold"],
 "\n(Not in this notebook.)\n\n\tFor example: You Evaluate  (",
 StyleBox[" ", "Subsubtitle"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Shift\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], "-", 
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Enter\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"]}]],
  CellChangeTimes->{{3.3902570408182*^9, 3.3902570426292*^9}},
  FontSize->14],
 " ):\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"6", "Pi"}]}], "}"}]}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  \n\t\n\tto see the plot of ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Sin", "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ", in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s: ",
 StyleBox["Documentation Center.",
  FontWeight->"Bold"],
 "\n   \n\tNext, edit ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Sin", "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " and evaluate (",
 StyleBox[" ", "Subsubtitle"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Shift\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], "-", 
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"Enter\\\",\\nFontColor->GrayLevel[\
0]]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"]}]],
  CellChangeTimes->{{3.3902570408182*^9, 3.3902570426292*^9}},
  FontSize->14],
 " )\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Cos", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"6", "Pi"}]}], "}"}]}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  \n\t\n\tto see the plot of ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s: ",
 StyleBox["Documentation Center",
  FontWeight->"Bold"],
 ".       "
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.388141053609*^9, 3.388141090446*^9}, {
   3.3881411285039997`*^9, 3.388141167065*^9}, {3.3881411999189997`*^9, 
   3.388141405465*^9}, {3.388141471995*^9, 3.3881414778789997`*^9}, {
   3.3890433777882*^9, 3.3890434161882*^9}, {3.3890434578612003`*^9, 
   3.3890434793532*^9}, {3.389661059994*^9, 3.389661081783*^9}, {
   3.38966114869*^9, 3.3896611517209997`*^9}, {3.389661185803*^9, 
   3.389661223858*^9}, 3.390195673807*^9, {3.390196333822*^9, 
   3.390196431053*^9}, {3.390196773967*^9, 3.3901968071800003`*^9}, 
   3.390196856227*^9, {3.439044028703125*^9, 3.439044029609375*^9}, {
   3.43904461146875*^9, 3.439044645703125*^9}, {3.4391325334375*^9, 
   3.43913253790625*^9}}],

Cell[TextData[{
 "Finally, copy the Input Cell containing the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " code for the Cos[x] plot from ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s: ",
 StyleBox["Documentation Center",
  FontWeight->"Bold"],
 " into this notebook and then reevaluate that Cell in this notebook."
}], "Text",
 CellChangeTimes->{{3.3901968695109997`*^9, 3.390196972917*^9}, {
   3.390197033053*^9, 3.3901974358059998`*^9}, {3.390197727895*^9, 
   3.390197752101*^9}, 3.3901977910030003`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Observation:", "Subsection"],
 "  "
}], "Subsection"],

Cell[TextData[{
 "Good use of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s: ",
 StyleBox["Documentation Center",
  FontWeight->"Bold"],
 " can be made by finding code that does ",
 StyleBox["most",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " of what you want, then copying that code into your notebook and making the \
necessary modifications to get the code that fills your needs.   "
}], "Text",
 CellChangeTimes->{{3.3901968695109997`*^9, 3.390196972917*^9}, {
  3.390197033053*^9, 3.3901974358059998`*^9}, {3.390197727895*^9, 
  3.390197752101*^9}, {3.3901977910030003`*^9, 3.3901978531070004`*^9}, {
  3.390197981142*^9, 3.390197993743*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Notation Conventions", "Subtitle"]], "Section",
 CellChangeTimes->{3.3902128054300003`*^9}],

Cell[CellGroupData[{

Cell[" Notation: (Upper and Lower Case Letters):", "Subsection"],

Cell[TextData[{
 "All notation in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is ",
 StyleBox["case",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["sensitive",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 ".  The symbols   \"A\"  and  \"a\"   or   \"Plot\"  and  \"plot\"  are \
treated as ",
 StyleBox["completely",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["different",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 ".  All symbols internal to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " either start with a capital letter or a \[OpenCurlyDoubleQuote]$\
\[CloseCurlyDoubleQuote].  \n\nThus, as a general rule, ",
 StyleBox["ALWAYS",
  FontWeight->"Bold"],
 " start all of your user defined symbols with a lower case letter and they \
will never clash with a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " defined symbol."
}], "Text",
 CellChangeTimes->{{3.390198275576*^9, 3.390198335626*^9}, {
  3.43904480090625*^9, 3.43904480196875*^9}, {3.523016660693845*^9, 
  3.5230166631274605`*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[" Example:", "Subsection"],

Cell[TextData[{
 "Find all information that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has on the symbols  a, b, c, d, e and f  by evaluating the following \
expression:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Map", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Information", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}]}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.390198350818*^9, 3.3901983725550003`*^9}}],

Cell[TextData[{
 "\nObserve that ",
 StyleBox["no",
  FontWeight->"Bold"],
 " information exists on any of these lowercase letters other than their \
names: Global`a, Global`b etc..  \nTherefore, these lowercase letters are \
available for you to use in your program.\n\nNext, find all information that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has on the uppercase symbols  A, B, C, D, E and F  by evaluating the \
following expression:"
}], "Text",
 CellChangeTimes->{3.439044826890625*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Map", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Information", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"A", ",", "B", ",", "C", ",", "D", ",", "E", ",", "F"}], "}"}]}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.390198396218*^9, 3.390198403726*^9}}],

Cell[TextData[{
 "\nObserve that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has assigned meanings to the uppercase letters  C, D and E.  Therefore, \
these uppercase letters are ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " available for your use.  \n\nThe important observation is \"Always start a \
user defined symbol with a lowercase letter\".\n"
}], "Text",
 CellChangeTimes->{{3.390198415692*^9, 3.3901984341879997`*^9}, {
  3.4390448698125*^9, 3.439044874515625*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Notation: (Parentheses vs. Bracket vs. Brace): ", "Subsection"],

Cell[TextData[{
 " ",
 StyleBox["Parentheses \"(\" and \")\"", "Subsubsection"],
 " are ",
 StyleBox["ALWAYS",
  FontWeight->"Bold"],
 " used to group calculations.\nFor example, arithmetic computation:"
}], "Text"],

Cell[BoxData[
 RowBox[{"2", "*", 
  RowBox[{"(", 
   RowBox[{"3", "+", "4"}], ")"}]}]], "Input"],

Cell["\<\

For example, algebraic computation:\
\>", "Text",
 CellChangeTimes->{3.439045125484375*^9}],

Cell[BoxData[
 RowBox[{"Expand", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "+", "1"}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "+", "2"}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "+", "3"}], ")"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901984576070004`*^9, 3.390198461384*^9}}],

Cell["\<\

For example, solving algebraic expressions:\
\>", "Text",
 CellChangeTimes->{3.439045126875*^9}],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "y"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"x", "+", "y"}], ")"}]}], "\[Equal]", "4"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "y"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3901984678450003`*^9, 3.3901984746359997`*^9}}],

Cell[TextData[{
 "\n  ",
 StyleBox["Square brackets \"[\" and \"]\"", "Subsubsection"],
 " are ",
 StyleBox["ALWAYS",
  FontWeight->"Bold"],
 " used to specify arguments for functions.\nFor example, common functions:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  FractionBox["\[Pi]", "2"], "]"}]], "Input"],

Cell["\<\

For example, user defined functions:\
\>", "Text",
 CellChangeTimes->{3.439045130453125*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "y", ",", "f"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  SuperscriptBox["x", "2"]}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "3", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "y", "]"}]], "Input"],

Cell[TextData[{
 "\n ",
 StyleBox["Braces \"{\" and \"}\"", "Subsubsection"],
 " are ",
 StyleBox["ALWAYS",
  FontWeight->"Bold"],
 " used to specify lists, vectors and matrices.\nFor example, a ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of numbers:"
}], "Text"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   FractionBox["1", "4"], ",", "1", ",", 
   FractionBox["9", "4"], ",", "4", ",", 
   FractionBox["25", "4"], ",", "9"}], "}"}]], "Input"],

Cell[TextData[{
 "\nPlot the ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of numbers using the command ListPlot:"
}], "Text",
 CellChangeTimes->{3.4390451359375*^9}],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     FractionBox["1", "4"], ",", "1", ",", 
     FractionBox["9", "4"], ",", "4", ",", 
     FractionBox["25", "4"], ",", "9"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"PointSize", "[", ".02", "]"}], "}"}]}]}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.390198529234*^9, 3.390198539134*^9}}],

Cell[TextData[{
 "\nFor example, a ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of functions:"
}], "Text",
 CellChangeTimes->{3.4390451393125*^9}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", "x"], ",", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
   RowBox[{"Cos", "[", 
    RowBox[{"2", "\[Pi]", " ", "x"}], "]"}]}], "}"}]], "Input"],

Cell[TextData[{
 "\nPlot the ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of functions:"
}], "Text",
 CellChangeTimes->{{3.390198557026*^9, 3.390198562691*^9}, 3.43904513775*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", "x"], ",", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", "\[Pi]", " ", "x"}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.390198572638*^9, 3.390198579549*^9}}],

Cell[TextData[{
 "\nA ",
 StyleBox["list",
  FontVariations->{"Underline"->True}],
 " of plots:"
}], "Text",
 CellChangeTimes->{{3.390198557026*^9, 3.390198562691*^9}, {3.390198836183*^9,
    3.39019884779*^9}, 3.439045142265625*^9}],

Cell[BoxData[
 RowBox[{"{", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", "x"], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "70"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "80"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "80"}]}], "]"}]}], "\[IndentingNewLine]",
   "}"}]], "Input",
 CellChangeTimes->{{3.39019859358*^9, 3.3901988003190002`*^9}, {
  3.390198861166*^9, 3.390198875271*^9}}],

Cell[TextData[{
 StyleBox["\n", "Subsubsection"],
 StyleBox["Rule :", "Subsubsection",
  FontSize->14],
 "  ",
 StyleBox["If it is more than one thing, then it probably needs to be put in \
a list!",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.390198918705*^9, 3.3901989928059998`*^9}, {
  3.390212711458*^9, 3.39021271223*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Warning:", "Subsection"],

Cell[TextData[{
 "The use of parentheses, brackets or braces determines the meaning of your \
code in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  Therefore, it is ",
 StyleBox["imperative",
  FontWeight->"Bold"],
 " that you pay very close attention to which is required.\n\nFor example, if \
you make a mistake and use parentheses rather than square brackets for \
function arguments, the following will happen:"
}], "Text",
 CellChangeTimes->{3.390199077914*^9}],

Cell[BoxData[
 RowBox[{"f", 
  RowBox[{"(", "3", ")"}]}]], "Input"],

Cell[TextData[{
 "\nIt is clear from the above output that the expression \"",
 StyleBox["f(3)",
  FontWeight->"Bold"],
 "\" was interpreted as \"",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "*", 
    RowBox[{"(", "3", ")"}]}], TraditionalForm]],
  FontWeight->"Bold"],
 "\" and not as \"",
 StyleBox["f[3]",
  FontWeight->"Bold"],
 "\". "
}], "Text",
 CellChangeTimes->{3.4390451205625*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Using  \";\"  Between Lines of Code", "Subsection",
 CellChangeTimes->{{3.3905995583784*^9, 3.3905995586014*^9}, {
  3.3906007041754*^9, 3.3906007537434*^9}, {3.3906010954994*^9, 
  3.3906011040794*^9}, {3.3906014261854*^9, 3.3906014275734*^9}}],

Cell[TextData[{
 "Sometimes you would like to put more than one line of code into the same \
Input Cell.  You may do this as long as you insert a  \";\"  ",
 StyleBox["between",
  FontVariations->{"Underline"->True}],
 " the lines of code.\n\nFor example, solve the quadratic equation  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"b", " ", "x"}], "+", "c"}], "\[Equal]", "0"}], 
   TraditionalForm]]],
 "  for  x  when:\n\n\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{"a", "=", "2"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"b", "=", "5"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"c", "=", "3"}], TraditionalForm]}]],
 "\n\t\nEvaluate the following Input Cell that contains five lines of code:"
}], "Text",
 CellChangeTimes->{{3.3905995722384*^9, 3.3905997494114*^9}, {
  3.3905998873084*^9, 3.3905999381094*^9}, {3.3906000340414*^9, 
  3.3906000637104*^9}, {3.3906007645404*^9, 3.3906007662033997`*^9}, {
  3.3906014995243998`*^9, 3.3906015578454*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "=", "3"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"b", " ", "x"}], "+", "c"}], "\[Equal]", "0"}], ",", " ", "x"}], 
  " ", "]"}]}], "Input",
 CellChangeTimes->{{3.3905997709214*^9, 3.3905998801574*^9}, {
  3.3905999577494*^9, 3.3906000132134*^9}, {3.3906002554644003`*^9, 
  3.3906002579784*^9}}],

Cell[TextData[{
 "\nObserve the  \";\"  ",
 StyleBox["between",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " lines of code but ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " after the ",
 StyleBox["last",
  FontVariations->{"Underline"->True}],
 " line of code in the Input Cell.\n\nWhat happens if you do ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " insert  \";\"  between ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " lines of code?\n\nEvaluate the following example to find out:"
}], "Text",
 CellChangeTimes->{{3.3906003105094*^9, 3.3906005266924*^9}, {
   3.3906015272394*^9, 3.3906015316224003`*^9}, 3.43904510653125*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{
    RowBox[{"2", "   ", "b"}], "=", 
    RowBox[{
     RowBox[{"5", "   ", "c"}], "=", "3"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"b", " ", "x"}], "+", "c"}], "\[Equal]", "0"}], ",", " ", "x"}], 
  " ", "]"}]}], "Input",
 CellChangeTimes->{{3.3905997709214*^9, 3.3905998801574*^9}, {
  3.3905999577494*^9, 3.3906000132134*^9}, {3.3906001342544003`*^9, 
  3.3906002153954*^9}}],

Cell[TextData[{
 "\nAs expected, all sorts of errors occurred.  \n\nNote the missing  \";\"  \
between the three lines of code:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     RowBox[{"2", "       ", "b"}], "=", 
     RowBox[{
      RowBox[{"5", "       ", "c"}], "=", "3"}]}]}], TraditionalForm]]],
 "\n\t\nrather than:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "=", "2"}], ";", " ", 
    RowBox[{"b", "=", "5"}], ";", " ", 
    RowBox[{"c", "=", "3"}], ";"}], TraditionalForm]]],
 "\n\t\nNow try again, but this time use  \";\"  correctly:"
}], "Text",
 CellChangeTimes->{{3.3906005537234*^9, 3.3906006803894*^9}, {
   3.3906008597214003`*^9, 3.3906009281694*^9}, {3.3906010291974*^9, 
   3.3906010773864*^9}, {3.3906011868334*^9, 3.3906012114004*^9}, 
   3.43904510884375*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", "2"}], ";", "  ", 
   RowBox[{"b", "=", "5"}], ";", "  ", 
   RowBox[{"c", "=", "3"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"b", " ", "x"}], "+", "c"}], "\[Equal]", "0"}], ",", " ", "x"}], 
  " ", "]"}]}], "Input",
 CellChangeTimes->{{3.3905997709214*^9, 3.3905998801574*^9}, {
  3.3905999577494*^9, 3.3906000132134*^9}, {3.3906001342544003`*^9, 
  3.3906002153954*^9}, {3.3906009989884*^9, 3.3906010080874*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Notation: ( Punctuation    \",\"  \":\"  \"?\"  \"@\"   Etc.):", \
"Subsection",
 CellChangeTimes->{{3.3906016171154003`*^9, 3.3906016523864*^9}}],

Cell["\<\
Specific punctuation is often required for specific functions and \
circumstances.  Although there are some general guidelines, we will \
illustrate the proper use of punctuation as the lessons continue.\
\>", "Text",
 CellChangeTimes->{{3.3906016801524*^9, 3.3906016868744*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Case Specific Help", "Subtitle"]], "Section",
 CellChangeTimes->{3.390212809046*^9}],

Cell[TextData[{
 " If you want fast and easy case specific help on the assignment to a \
symbol, or the definition of an internal ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command, then the \"?\" notation can be used."
}], "Text",
 CellChangeTimes->{{3.390199180756*^9, 3.3901991875369997`*^9}}],

Cell[CellGroupData[{

Cell[" Examples:", "Subsection"],

Cell["Determine what information is available about  +:", "Text"],

Cell[BoxData[
 RowBox[{"?", "+"}]], "Input"],

Cell[TextData[{
 "\nClick on the above link ",
 Cell[BoxData[
  FormBox[
   StyleBox[">>",
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 " to get additional information about \"+\" .\n\nAssign the value  2  to the \
symbol  a:"
}], "Text",
 CellChangeTimes->{{3.3902109720620003`*^9, 3.390211097138*^9}, 
   3.43904519940625*^9, 3.43904523228125*^9}],

Cell[BoxData[
 RowBox[{"a", "=", "2"}]], "Input"],

Cell["\<\

Determine the information currently available about the symbol a:\
\>", "Text",
 CellChangeTimes->{3.439045245421875*^9}],

Cell[BoxData[
 RowBox[{"?", "a"}]], "Input"],

Cell["\<\

Observe that both the name:  Global`a  and the assignment:  a = 2  are \
associated with the symbol  a.
\
\>", "Text",
 CellChangeTimes->{3.439045247765625*^9}],

Cell[TextData[{
 "Remember that the function  f  was previously assigned the formula ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]]],
 " above:"
}], "Text"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[TextData[{
 "\nDetermine what information is available about the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command   Solve:"
}], "Text",
 CellChangeTimes->{3.390779971685704*^9}],

Cell[BoxData[
 RowBox[{"?", " ", "Solve"}]], "Input"],

Cell[TextData[{
 "\nClick on the above link ",
 Cell[BoxData[
  FormBox[
   StyleBox[">>",
    FontColor->RGBColor[0, 0, 1]], TraditionalForm]]],
 " to get additional information about \"Solve\".\n"
}], "Text",
 CellChangeTimes->{{3.3902109720620003`*^9, 3.390211097138*^9}, {
  3.390211169587*^9, 3.390211193455*^9}, {3.43904527809375*^9, 
  3.4390452825*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 " The wild card  \"",
 Cell[BoxData[
  FormBox["*", TraditionalForm]]],
 "\""
}], "Subsection",
 CellChangeTimes->{3.439132810421875*^9}],

Cell[TextData[{
 "The symbol \"",
 Cell[BoxData[
  FormBox["*", TraditionalForm]]],
 "\" is used as a wild card (similar to its use in MS Windows) to match \
additional cases.  \nFor example, I might want to find all internal ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " commands which contain the word \"Plot\" either at the:\n\nBeginning of \
the command:"
}], "Text",
 CellChangeTimes->{{3.390211229744*^9, 3.390211231618*^9}, {3.390211290178*^9,
   3.390211292524*^9}, {3.3902113267869997`*^9, 3.3902113383789997`*^9}, {
  3.39021140449*^9, 3.390211408016*^9}}],

Cell[BoxData[
 RowBox[{"?", "  ", "Plot*"}]], "Input",
 CellChangeTimes->{{3.390211277139*^9, 3.390211280416*^9}, {
  3.3902113825769997`*^9, 3.39021138534*^9}}],

Cell["\<\

At the end of the command:\
\>", "Text",
 CellChangeTimes->{3.3902114605150003`*^9, 3.390780009569704*^9}],

Cell[BoxData[
 RowBox[{"?", "  ", "*Plot"}]], "Input",
 CellChangeTimes->{{3.390211353227*^9, 3.390211374553*^9}}],

Cell["\<\

Anywhere within the command:\
\>", "Text",
 CellChangeTimes->{3.3902114674*^9, 3.390780012209704*^9}],

Cell[BoxData[
 RowBox[{"?", "  ", "*Plot*"}]], "Input",
 CellChangeTimes->{{3.3902113934779997`*^9, 3.390211395744*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Symbols: Assigned Value vs. Name", "Subtitle"]], \
"Section",
 CellChangeTimes->{
  3.390212812915*^9, {3.439132887328125*^9, 3.439132888484375*^9}}],

Cell[TextData[{
 "One point that may cause you confusion in using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is that every symbol has several different properties, including its name \
and the possibility of an assigned value.  It is important to realize that \
when a symbol is entered into ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " it ",
 StyleBox["always",
  FontVariations->{"Underline"->True}],
 " has a name.  However, it ",
 StyleBox["may or may not",
  FontVariations->{"Underline"->True}],
 " have an assigned value. You may use a symbol even if it has no assigned \
value."
}], "Text",
 CellChangeTimes->{{3.390780113033704*^9, 3.390780128195704*^9}, {
  3.390780212071704*^9, 3.390780230545704*^9}}],

Cell[CellGroupData[{

Cell[" Example:", "Subsection"],

Cell["Start by clearing all assignments for the symbols   a, b:", "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b"}], "]"}]], "InputOnly"],

Cell["Next, determine what information exists about the symbol  a:", "Text"],

Cell[BoxData[
 RowBox[{"?", "a"}]], "Input"],

Cell[TextData[{
 "\nObserve that the symbol  a  has no assigned value but it does have a name \
 \"Global`a\"  or just  a  for short.\nHowever, the symbol  a  may still be \
used in any ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " expression:"
}], "Text",
 CellChangeTimes->{{3.390211591701*^9, 3.390211593337*^9}, {3.39021163702*^9, 
   3.390211647172*^9}, 3.4390453619375*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", "a"}], "+", 
  RowBox[{"3", "a"}]}]], "Input"],

Cell["\<\

Next, assign the value  3  to the symbol  a:\
\>", "Text",
 CellChangeTimes->{3.439045376265625*^9}],

Cell[BoxData[
 RowBox[{"a", "=", "3"}]], "Input"],

Cell["\<\

Observe that the symbol  a  has two properties, an assigned value of  3  \
along with its name  Global`a.\
\>", "Text",
 CellChangeTimes->{{3.390211617809*^9, 3.390211619606*^9}, {
   3.3902116577469997`*^9, 3.390211695804*^9}, 3.439045389609375*^9}],

Cell[BoxData[
 RowBox[{"?", "a"}]], "Input"],

Cell[TextData[{
 "\nThe symbol  a  (and its assigned value of 3) may be used in any ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " expression:"
}], "Text",
 CellChangeTimes->{3.439045398046875*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", "a"}], "+", 
  RowBox[{"3", "a"}]}]], "Input"],

Cell[BoxData[
 FractionBox[
  RowBox[{"Sin", "[", "a", "]"}], 
  RowBox[{"Cos", "[", "a", "]"}]]], "Input"],

Cell["\<\

As a final observation, you may freely mix symbols with assigned values \
together with symbols that have no assigned values:\
\>", "Text",
 CellChangeTimes->{3.43904540653125*^9}],

Cell[BoxData[
 RowBox[{"a", "*", "b"}]], "Input"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{"  ", 
   RowBox[{
    RowBox[{"Simple", " ", "Function", " ", "Assignments", "    ", 
     RowBox[{"f", "[", "x_", "]"}]}], "=", 
    SuperscriptBox["x", "2"], " "}]}], "Subtitle"]], "Section",
 CellChangeTimes->{3.390212786781*^9, 3.3903401733213997`*^9}],

Cell[TextData[{
 "It is easy to define functions in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  However, you must make sure that you follow the correct syntax.\n\nThe \
syntax for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]]],
 " consists of the following components:\n\tThe function's name:     f\n\tThe \
brackets containing the function's variable:      [   ]\n\tThe dummy \
variable:     _\n\tThe dummy variable  \"_\"  local name :     x\n\tThe \
immediate assignment command:     =\n\tThe formula using the dummy variable's \
local name:     ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]]],
 "\n\nThe main point of confusion for a new user is to misunderstand the \
distinction between the dummy variable \"_\" and its local name \"x\".  The \
local name \"x\" is restricted in its scope, and is only used inside the \
Input Cell at the time which the function is defined.  The local name \"x\" \
has absolutely no relevance beyond that.\nA function can be defined using \
many different local names ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "..."}], 
   TraditionalForm]]],
 " for its dummy variable  \"_\"  and they will all yield the same result.  \
For example:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "y_", "]"}], "=", 
    SuperscriptBox["y", "2"]}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "z_", "]"}], "=", 
    SuperscriptBox["z", "2"]}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "anything_", "]"}], "=", 
    SuperscriptBox["anything", "2"]}], TraditionalForm]]],
 "\n\t\t\nwill all produce exactly the same definition for the function with \
name \"f\".  For example, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "3", "]"}], TraditionalForm]]],
 " will be 9 irrespective of which of the 4 above definitions are used.\n\
However, the expression:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]]],
 "\n\t\t\nis ",
 StyleBox["completely",
  FontWeight->"Bold"],
 " ",
 StyleBox["different",
  FontWeight->"Bold"],
 ".  It has ",
 StyleBox["no",
  FontWeight->"Bold"],
 " ",
 StyleBox["dummy",
  FontWeight->"Bold"],
 " ",
 StyleBox["variable",
  FontWeight->"Bold"],
 " \"_\".  Therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "3", "]"}], TraditionalForm]]],
 " will have no value.  \n\n",
 StyleBox["Remember, the \"_\" in the expression  f[ x_ ]  represents the \
\"fill in the blank\" behavior of the dummy variable.  Without \"_\", no \
substitutions can be made for the argument of a function.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.390211890366*^9, 3.390211893933*^9}, {
  3.390780317116704*^9, 3.390780343405704*^9}, {3.43904550546875*^9, 
  3.439045524046875*^9}, {3.43904556746875*^9, 3.439045572328125*^9}, {
  3.439045605*^9, 3.439045609390625*^9}}],

Cell[CellGroupData[{

Cell[" Example:", "Subsection"],

Cell["Start by clearing all assignments for the symbols   a,b,x,f:", "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "x", ",", "f", ",", "anything"}], 
  "]"}]], "InputOnly",
 CellChangeTimes->{{3.43904600084375*^9, 3.439046003046875*^9}}],

Cell[TextData[{
 "Next, define a function using the ",
 StyleBox["correct",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " syntax:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  SuperscriptBox["x", "2"]}]], "Input"],

Cell["\<\

Check on the function's definition:\
\>", "Text",
 CellChangeTimes->{3.439045642265625*^9}],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[TextData[{
 "\nObserve that it contains both the function's name  Global`f  as well as \
the assignment  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]]],
 ".\n\nNext, evaluate this function for different values of the dummy \
variable \"_\":"
}], "Text",
 CellChangeTimes->{{3.4390456454375*^9, 3.439045670015625*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", "2", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "3", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "a", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "b", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "y", "]"}]], "Input",
 CellChangeTimes->{3.4390457600625*^9}],

Cell[BoxData[
 RowBox[{"f", "[", "anything", "]"}]], "Input",
 CellChangeTimes->{{3.439045767921875*^9, 3.43904576975*^9}}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "x"], " ", 
  RowBox[{"f", "[", "x", "]"}]}]], "Input",
 CellChangeTimes->{{3.3906022430313997`*^9, 3.3906022503864*^9}}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "y"], " ", 
  RowBox[{"f", "[", "y", "]"}]}]], "Input",
 CellChangeTimes->{{3.3906022430313997`*^9, 3.3906022503864*^9}, {
  3.439045742140625*^9, 3.439045743421875*^9}}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "anything"], " ", 
  RowBox[{"f", "[", "anything", "]"}]}]], "Input",
 CellChangeTimes->{{3.3906022430313997`*^9, 3.3906022503864*^9}, {
  3.439045742140625*^9, 3.439045743421875*^9}, {3.43904578428125*^9, 
  3.4390457915625*^9}}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",
 CellChangeTimes->{{3.3906022697704*^9, 3.3906022764054003`*^9}}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "y", "]"}], 
   RowBox[{"\[DifferentialD]", "y"}]}]}]], "Input",
 CellChangeTimes->{{3.3906022697704*^9, 3.3906022764054003`*^9}, {
  3.439045804484375*^9, 3.439045805640625*^9}}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "anything", "]"}], 
   RowBox[{"\[DifferentialD]", "anything"}]}]}]], "Input",
 CellChangeTimes->{{3.3906022697704*^9, 3.3906022764054003`*^9}, {
  3.439045817109375*^9, 3.439045825875*^9}}],

Cell[BoxData[
 RowBox[{"Solve", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "\[Equal]", "4"}], ",", " ", "x"}], " ", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3906022814274*^9, 3.3906022965374002`*^9}}],

Cell[TextData[{
 "\nObserve that the dummy variable \"_\" local name of \"x\" had nothing to \
do with any of the above evaluations.\n\nHowever, if we ",
 StyleBox["improperly",
  FontVariations->{"Underline"->True}],
 " define the function without a dummy variable, then the following problem \
results."
}], "Text",
 CellChangeTimes->{{3.3906021732244*^9, 3.3906021738733997`*^9}, 
   3.43904568865625*^9}],

Cell["Start by clearing all assignments for the symbols   a,b,x,f:", "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "x", ",", "f"}], "]"}]], "InputOnly"],

Cell[TextData[{
 "Next, define a function using the ",
 StyleBox["incorrect",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " syntax (without a dummy variable \"_\"):"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x", "]"}], "=", 
  SuperscriptBox["x", "2"]}]], "Input"],

Cell["\<\

Check on the function's definition:\
\>", "Text",
 CellChangeTimes->{3.43904585765625*^9}],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[TextData[{
 "\nObserve that the function appears to be defined OK but it is NOT!  \n\n",
 StyleBox["This function is only defined for the unique symbol \"x\" and for \
no other value.\n",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\nTo illustrate this point, evaluate the following expressions:"
}], "Text",
 CellChangeTimes->{{3.3906024401334*^9, 3.3906024428784*^9}, {
  3.43904585890625*^9, 3.439045909390625*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", "2", "]"}]], "Input"],

Cell["\<\

Nothing happens!\
\>", "Text",
 CellChangeTimes->{{3.390212027991*^9, 3.390212054637*^9}, 
   3.43904592615625*^9}],

Cell[BoxData[
 RowBox[{"f", "[", "a", "]"}]], "Input"],

Cell["\<\

Nothing happens!\
\>", "Text",
 CellChangeTimes->{{3.390212027991*^9, 3.390212054637*^9}, 
   3.439045928171875*^9}],

Cell["\<\
However, the function does have a value for (and only for) the unique symbol  \
x:\
\>", "Text",
 CellChangeTimes->{{3.3906023595344*^9, 3.3906023911303997`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", "x", "]"}]], "Input"],

Cell[TextData[{
 "\nIn conclusion, when defining a function ",
 StyleBox["always",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 " use a dummy variable \"_\"."
}], "Text",
 CellChangeTimes->{3.43904593953125*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Remark:", "Subsection"],

Cell[TextData[{
 "The so-called \"dummy variable\" i.e. \"_\" is actually a larger part of \
the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " programming language.  A more precise meaning for \"_\" will be covered \
later when pattern matching is discussed."
}], "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{"  ", 
   RowBox[{
    RowBox[{"Simple", " ", "Function", " ", "Assignments", "    ", 
     RowBox[{"f", "[", "x_", "]"}]}], ":=", 
    SuperscriptBox["x", "2"], " "}]}], "Subtitle"]], "Section",
 CellChangeTimes->{3.390212789545*^9, 3.3903401694124002`*^9}],

Cell[TextData[{
 "Another point of confusion for new users is the difference between \
immediate \"",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" and delayed \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" assignments.  For now, just realize that the notation \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" represents delayed assignment (which means that your functional \
arguments will ",
 StyleBox["not",
  FontWeight->"Bold"],
 " be replaced with values until you actually use your function).  The \
notation\"",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" represents immediate assignment (which means that any functional \
arguments that have values, ",
 StyleBox["will use those values immediately while setting up and storing the \
function",
  FontVariations->{"Underline"->True}],
 "."
}], "Text",
 CellChangeTimes->{{3.390212119788*^9, 3.39021215329*^9}, {
  3.439053468609375*^9, 3.43905348021875*^9}, {3.439053557265625*^9, 
  3.43905358425*^9}, {3.439133110671875*^9, 3.439133117796875*^9}}],

Cell[CellGroupData[{

Cell[" Example of Immediate Assignment    \"=\"", "Subsection",
 CellChangeTimes->{{3.390212183322*^9, 3.390212186217*^9}}],

Cell[TextData[{
 "Say that the symbol  ",
 StyleBox["b",
  FontWeight->"Bold"],
 "  was assigned the value  ",
 StyleBox["3",
  FontWeight->"Bold"],
 "  earlier in your ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebook. "
}], "Text"],

Cell[BoxData[
 RowBox[{"b", " ", "=", " ", "3"}]], "Input"],

Cell[TextData[{
 "\nAlso assume that you remember to clear  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  but forget to clear the value of  ",
 StyleBox["b",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{3.43905360196875*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x", ",", "a"}], "]"}]], "InputOnly"],

Cell[TextData[{
 "\nUse ",
 StyleBox["immediate assignment",
  FontVariations->{"Underline"->True}],
 " (i.e. ",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 ") to define the function \"",
 StyleBox["f",
  FontWeight->"Bold"],
 "\".  "
}], "Text",
 CellChangeTimes->{3.43905360328125*^9, 3.439053649328125*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{"a", " ", "+", 
   RowBox[{"b", "*", "x"}]}]}]], "Input"],

Cell["\<\

Check the assignment to the function  f:\
\>", "Text",
 CellChangeTimes->{3.439053604671875*^9}],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[TextData[{
 "\nNote that the value assigned previously to \"",
 StyleBox["b",
  FontWeight->"Bold"],
 "\" has been automatically substituted.  Therefore ",
 StyleBox["the value of  ",
  FontVariations->{"Underline"->True}],
 StyleBox["b",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox["  used in the formula for ",
  FontVariations->{"Underline"->True}],
 StyleBox["f[x]",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox[" can never be changed from the value of  ",
  FontVariations->{"Underline"->True}],
 StyleBox["3",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 ".  \n\nHowever, because  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  had no assigned value when the function  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  was defined, the value of  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  in this formula can be changed later."
}], "Text",
 CellChangeTimes->{
  3.439053606296875*^9, {3.43913316328125*^9, 3.43913317778125*^9}, 
   3.439133240890625*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Example of Delayed Assignment    \":=\"", "Subsection",
 CellChangeTimes->{{3.390212241738*^9, 3.390212244637*^9}}],

Cell[TextData[{
 "Say that the symbol  ",
 StyleBox["b",
  FontWeight->"Bold"],
 "  was assigned the value  ",
 StyleBox["3",
  FontWeight->"Bold"],
 "  earlier in your ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebook. "
}], "Text"],

Cell[BoxData[
 RowBox[{"b", " ", "=", " ", "3"}]], "Input"],

Cell[TextData[{
 "\nAlso assume that you remember to clear  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  but forget to clear the value of  ",
 StyleBox["b",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{3.439053716171875*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x", ",", "a"}], "]"}]], "InputOnly"],

Cell[TextData[{
 "Use ",
 StyleBox["delayed assignment",
  FontVariations->{"Underline"->True}],
 " (i.e. ",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 ") to define the function \"",
 StyleBox["f",
  FontWeight->"Bold"],
 "\".  "
}], "Text",
 CellChangeTimes->{3.43905374515625*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"a", " ", "+", 
   RowBox[{"b", "*", "x"}]}]}]], "InputOnly"],

Cell[TextData[{
 "Check the assignment to the function  ",
 StyleBox["f",
  FontWeight->"Bold"],
 ":"
}], "Text"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[TextData[{
 "\nNote that the value assigned previously to \"",
 StyleBox["b",
  FontWeight->"Bold"],
 "\" has ",
 StyleBox["NOT",
  FontVariations->{"Underline"->True}],
 " been automatically substituted into the formula.  Therefore ",
 StyleBox["different values of  ",
  FontVariations->{"Underline"->True}],
 StyleBox["b",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox["  can be used later",
  FontVariations->{"Underline"->True}],
 ".  \n\nAgain, note that because  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  had no assigned value, the value of  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  in this formula can be changed later also."
}], "Text",
 CellChangeTimes->{
  3.43905376296875*^9, {3.43905379515625*^9, 3.439053796640625*^9}, 
   3.43913322446875*^9}],

Cell[TextData[{
 "When you use this function at a later time, it will use any values of  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["b",
  FontWeight->"Bold"],
 "  which are currently available.\n\nEvaluate the following (remember, \
currently  ",
 StyleBox["b",
  FontWeight->"Bold"],
 "  has the value  ",
 StyleBox["3",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  has no assigned value):"
}], "Text",
 CellChangeTimes->{{3.3906027255834*^9, 3.3906028264344*^9}, {
   3.439053816734375*^9, 3.4390538204375*^9}, 3.439133234109375*^9}],

Cell[BoxData[
 RowBox[{"f", "[", "\[Pi]", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "z", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "x"], " ", 
  RowBox[{"f", "[", "x", "]"}]}]], "Input",
 CellChangeTimes->{{3.3906022430313997`*^9, 3.3906022503864*^9}}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",
 CellChangeTimes->{{3.3906022697704*^9, 3.3906022764054003`*^9}}],

Cell[BoxData[
 RowBox[{"Solve", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "\[Equal]", "4"}], ",", " ", "x"}], " ", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3906022814274*^9, 3.3906022965374002`*^9}}],

Cell[TextData[{
 "\nRemember that  \"",
 StyleBox["a",
  FontWeight->"Bold"],
 "\"  currently has no assigned value, however  \"",
 StyleBox["b",
  FontWeight->"Bold"],
 "\"  currently has the assigned value of  ",
 StyleBox["3",
  FontWeight->"Bold"],
 ".\n\nChange the current assignment for \"",
 StyleBox["b",
  FontWeight->"Bold"],
 "\"  from  ",
 StyleBox["3",
  FontWeight->"Bold"],
 "  to a new value of ",
 StyleBox["10",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3906028482864*^9, 3.3906028509393997`*^9}, {
  3.3906028862934*^9, 3.3906029125094*^9}, {3.439053842125*^9, 
  3.43905386484375*^9}}],

Cell[BoxData[
 RowBox[{"b", "=", "10"}]], "Input"],

Cell[TextData[{
 "\nCheck the function  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "  using this new value of  ",
 StyleBox["b",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{3.439053872015625*^9}],

Cell[BoxData[
 RowBox[{"f", "[", "\[Pi]", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "z", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "x"], " ", 
  RowBox[{"f", "[", "x", "]"}]}]], "Input",
 CellChangeTimes->{{3.3906022430313997`*^9, 3.3906022503864*^9}}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",
 CellChangeTimes->{{3.3906022697704*^9, 3.3906022764054003`*^9}}],

Cell[BoxData[
 RowBox[{"Solve", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "\[Equal]", "4"}], ",", " ", "x"}], " ", 
  "]"}]], "Input",
 CellChangeTimes->{{3.3906022814274*^9, 3.3906022965374002`*^9}}],

Cell[TextData[{
 "\nObserve that the newly assigned value is used in the formula for the \
function  ",
 StyleBox["f",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{3.43905388621875*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[" Recommendation:", "Subsection"],

Cell[TextData[{
 "Usually, it is almost always better to use delayed assignment rather than \
immediate assignment.  Thus, the usual notation for assigning an expression \
to a function is:\n\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], " ", ":=", "  ", 
     RowBox[{
      RowBox[{"...", " ", "some", " ", "formula", " ", "of", " ", "x"}], 
      "..."}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\n"
}], "Text",
 CellChangeTimes->{{3.4390539155*^9, 3.439053926265625*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["  Functions with Multiple Assignments:", \
"Subtitle"]], "Section"],

Cell["\<\
For many functions, it is desirable to allow multiple assignments. \
\>", "Text"],

Cell[CellGroupData[{

Cell[" Example:", "Subsection"],

Cell[TextData[{
 "Consider how you might define the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{"Abs", "[", "x", "]"}]}], TraditionalForm]]],
 " from scratch.   \nYou might proceed as follows:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"f", "[", "x_", "]"}],
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    StyleBox["=",
     FontWeight->"Bold"], 
    RowBox[{
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold"], 
      StyleBox[
       RowBox[{
        StyleBox[" ",
         FontWeight->"Bold"], "          "}]], "when", "  ", 
      StyleBox["x",
       FontWeight->"Bold"]}], 
     StyleBox["\[GreaterEqual]",
      FontWeight->"Bold"], 
     StyleBox["0",
      FontWeight->"Bold"]}]}], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"f", "[", "x_", "]"}],
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    StyleBox["=",
     FontWeight->"Bold"], 
    RowBox[{
     RowBox[{
      StyleBox[
       RowBox[{"-", "x"}],
       FontWeight->"Bold"], "         ", "when", "  ", 
      StyleBox["x",
       FontWeight->"Bold"]}], 
     StyleBox["<",
      FontWeight->"Bold"], 
     StyleBox["0",
      FontWeight->"Bold"]}]}], TraditionalForm]]],
 "\nHowever, the above definition using immediate assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox["=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\" will not yield the desired result.\nIt will be necessary in this case to \
use delayed assignment \"",
 Cell[BoxData[
  FormBox[
   StyleBox[":=",
    FontWeight->"Bold"], TraditionalForm]]],
 "\"\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"f", "[", "x_", "]"}],
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    StyleBox[":=",
     FontWeight->"Bold"], 
    RowBox[{
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold"], 
      StyleBox[
       RowBox[{
        StyleBox[" ",
         FontWeight->"Bold"], "         "}]], "when", "  ", 
      StyleBox["x",
       FontWeight->"Bold"]}], 
     StyleBox["\[GreaterEqual]",
      FontWeight->"Bold"], 
     StyleBox["0",
      FontWeight->"Bold"]}]}], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"f", "[", "x_", "]"}],
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    StyleBox[":=",
     FontWeight->"Bold"], 
    RowBox[{
     RowBox[{
      StyleBox[
       RowBox[{"-", "x"}],
       FontWeight->"Bold"], "       ", "when", "  ", 
      StyleBox["x",
       FontWeight->"Bold"]}], 
     StyleBox["<",
      FontWeight->"Bold"], 
     StyleBox["0",
      FontWeight->"Bold"]}]}], TraditionalForm]]],
 "\nThe above definitions are easily entered."
}], "Text",
 CellChangeTimes->{{3.439053980578125*^9, 3.439054053640625*^9}, {
  3.439133312234375*^9, 3.4391333234375*^9}}],

Cell[TextData[{
 "Start by clearing all assignments for the symbols   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", ",", " ", "f"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.439054066984375*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "f"}], "]"}]], "InputOnly"],

Cell[TextData[{
 "Next, define the Abs function when ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "\[GreaterEqual]", " ", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " using the conditional \"",
 StyleBox["/;",
  FontWeight->"Bold"],
 "\" command"
}], "Text",
 CellChangeTimes->{3.43905407915625*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "   ", "/;", " ", 
   RowBox[{"x", "\[GreaterEqual]", "0"}]}]}]], "InputOnly"],

Cell[TextData[{
 "Next, define the Abs function when ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "<", " ", "0"}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.439054181234375*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "x"}], "   ", "/;", " ", 
   RowBox[{"x", "<", "0"}]}]}]], "InputOnly"],

Cell["Check on the definition for the function:", "Text"],

Cell[BoxData[
 RowBox[{"?", "f"}]], "Input"],

Cell[TextData[{
 "\nObserve that the function has the name  ",
 StyleBox["Global`f",
  FontWeight->"Bold"],
 "  and two assigned values:  \n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", " ", "]"}], " ", ":=", " ", 
     RowBox[{"x", "     ", "  ", "/;", "  ", 
      RowBox[{"x", "\[GreaterEqual]", "0"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 " \n\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", " ", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"-", "x"}], "    ", "/;", "  ", 
      RowBox[{"x", "<", "0", " "}]}]}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.4390541936875*^9, 3.43905424475*^9}}],

Cell["Check this definition using some values:", "Text"],

Cell[BoxData[
 RowBox[{"f", "[", "3", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"-", "3"}], "]"}]], "Input"],

Cell[TextData[{
 "\nPlot this function for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "5"}], " ", "\[LessEqual]", " ", "x", " ", "\[LessEqual]", 
     " ", "5"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.439054251671875*^9, 3.439054258875*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Warning:", "Subsection"],

Cell[TextData[{
 "The ability of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to allow multiple assignments can cause great confusion to a new user.  A \
common problem originates as follows: the user assigns an expression to a \
newly created function, decides that it is not correct, assigns a new \
expression to the same function (which happens to be a different pattern), \
the function now is multiply valued (unknown to the user who forgot about the \
first assignment), the user then applies the multiply valued function later \
with erratic and unexpected results.\nThe way to avoid this problem is to \
continually check the assignments to your variables and functions until you \
gain more experience.  If a function becomes multiply valued in an \
unacceptable way, the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Clear", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command can be used to clear all assignments to that function."
}], "Text",
 CellChangeTimes->{{3.3906030384983997`*^9, 3.3906030585383997`*^9}, {
   3.439054303796875*^9, 3.439054316671875*^9}, 3.439054369640625*^9}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["  Using ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox[" like a Pocket Calculator:", "Subtitle"]
}], "Section"],

Cell[TextData[{
 "Many times you will want to interact with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " entering your commands one line at a time.  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebooks allow you to enter (and evaluate) your calculations in any order \
that you want. \n\nJust remember, if you jump around in your notebook while \
you are evaluating it, that you will often get completely different results.\n\
 \n If you do not intend to rerun your notebook later, then there are some \
shortcuts that can be used to save time.  Specifically, when you finish one \
cell of calculations, you often want to use the output from that cell as \
input to the next cell.  This can be accomplished by using the \"",
 StyleBox["%",
  FontWeight->"Bold"],
 "\" notation.  However, please be aware that this notation always refers to \
the ",
 StyleBox["most",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["recently",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["completed",
  FontVariations->{"Underline"->True}],
 " calculation (irrespective of where it is located in your ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebook).\nConsider the following example which integrates the function ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Sin", "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " and plots the answer (remember to evaluate the second Input Cell \
immediately after evaluating the first):"
}], "Text",
 CellChangeTimes->{{3.390212479623*^9, 3.3902125805109997`*^9}, 
   3.43905448078125*^9}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Exercises ", "Title"],
 "  Advanced Lesson 1"
}], "Section",
 CellChangeTimes->{
  3.390779239827704*^9, {3.460216426577568*^9, 3.460216429577568*^9}}],

Cell["\<\
Your Name:

Your Math Class:\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.460216458858818*^9},
 FontSize->16,
 FontWeight->"Bold"],

Cell[TextData[{
 StyleBox["1:",
  FontSize->16,
  FontWeight->"Bold"],
 " Inside this notebook:",
 StyleBox["\n",
  FontVariations->{"Underline"->True}],
 "\n\[GrayCircle] \tPlace the Tool Bar at the top of this notebook.\n\n\t\t\
menu: Window  \[Implies]  Show Toolbar\n\t\t\n\tCheck out the \"fast\" access \
to different cell styles located at the left\n\tedge of the Toolbar.\n\t\t\n  \
    Open ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal ",
 StyleBox["Help Documentation Center.\n\n",
  FontVariations->{"Underline"->True}],
 "\[GrayCircle] \tChange the \"Magnification\" (located at the lower \
right-hand corner) from \n\t    the default 100% to a more readable size \
(like 125% or 150% etc.).\n\n\[GrayCircle] \tSearch for the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function ",
 StyleBox["Integrate",
  FontWeight->"Bold"],
 " using ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 ":\n\n\t\tType:\t",
 StyleBox["Integrate",
  FontWeight->"Bold"],
 "   \[Implies]   and follow the link to ",
 StyleBox["Integrate ",
  FontWeight->"Bold"],
 StyleBox["(\[Integral])", "OperatorCharacter",
  FontWeight->"Bold"],
 " and evaluate \n\t\tthe ",
 StyleBox["Basic Examples",
  FontWeight->"Bold"],
 " in the ",
 StyleBox["Help Documentation Center.",
  FontVariations->{"Underline"->True}],
 StyleBox["\n \t", "MR"],
 "\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \tClick on each of the following 7 blue links to the ",
 StyleBox["Help Documentation Center.",
  FontVariations->{"Underline"->True}],
 " \n\t",
 StyleBox["Read",
  FontWeight->"Bold"],
 " the contents of each tutorial and also ",
 StyleBox["evaluate",
  FontWeight->"Bold"],
 " each of the tutorial Input cells:",
 StyleBox["\n\t\n\t\t", "MR"],
 StyleBox["Getting Started", "Subsection"],
 "\n\t\t",
 StyleBox["\t",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["Your First ",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/YourFirstMathematicaCalculations"],
  FontWeight->"Bold"],
 StyleBox[ButtonBox["Mathematica",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/YourFirstMathematicaCalculations"],
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[ButtonBox[" Calculations",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/YourFirstMathematicaCalculations"],
  FontWeight->"Bold"],
 StyleBox["\n\t\t\t",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["Arithmetic",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/Arithmetic"],
  FontWeight->"Bold"],
 StyleBox["\n\t\t\t",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["Defining Variables",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/DefiningVariables"],
  FontWeight->"Bold"],
 StyleBox["\n\t\t\t",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["Defining Functions",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/DefiningFunctions"],
  FontWeight->"Bold"],
 StyleBox["\n\t\t\t",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["Some Mathematical Functions",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/SomeMathematicalFunctions"],
  FontWeight->"Bold"],
 StyleBox["\n\t\t\t",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["Symbolic Calculations",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/SymbolicCalculations"],
  FontWeight->"Bold"],
 StyleBox["\n\t\t\t",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["Numerical Calculations",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/NumericalCalculations"],
  FontWeight->"Bold"],
 StyleBox["\n", "MR"],
 "\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \tDon't worry about an answer--just do it!\n"
}], "Text",
 CellChangeTimes->{{3.3903401298974*^9, 3.3903401498434*^9}, {
   3.3903402955374002`*^9, 3.3903404857304*^9}, {3.3903405656944*^9, 
   3.3903406683274*^9}, 3.3903410714554*^9, 3.3903416815643997`*^9, {
   3.3903424540354*^9, 3.3903424703794003`*^9}, {3.3903428362214003`*^9, 
   3.3903429249944*^9}, {3.3903429906714*^9, 3.3903430350664*^9}, {
   3.390366571057*^9, 3.390366656635*^9}, {3.39036673154*^9, 
   3.390366747684*^9}, {3.390366834608*^9, 3.39036695037*^9}, {
   3.3903670586949997`*^9, 3.390367106473*^9}, {3.3906067818274*^9, 
   3.3906068439604*^9}, 3.3906070518724003`*^9, 3.439054969359375*^9, {
   3.439055012078125*^9, 3.439055012515625*^9}, {3.439055468546875*^9, 
   3.439055706453125*^9}, 3.439055758609375*^9, {3.43905580790625*^9, 
   3.439055861421875*^9}, {3.43905596303125*^9, 3.43905605525*^9}, {
   3.43905609565625*^9, 3.439056107328125*^9}, {3.439056138859375*^9, 
   3.439056186703125*^9}, {3.439056217328125*^9, 3.439056383234375*^9}, {
   3.439056448625*^9, 3.439056551109375*^9}, {3.439056608*^9, 
   3.439056620203125*^9}, {3.439059686734375*^9, 3.439059690953125*^9}}],

Cell[TextData[{
 StyleBox["2:",
  FontSize->16,
  FontWeight->"Bold"],
 " Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to locate information on the \"numerical\" function ",
 StyleBox["N[", "MR",
  FontWeight->"Bold"],
 StyleBox["expr", "TI",
  FontWeight->"Bold"],
 StyleBox["]", "MR",
  FontWeight->"Bold"],
 ":\n\n\t\tType:  ",
 StyleBox["n",
  FontWeight->"Bold"],
 "   \[Implies]   Click to search and locate   \[Implies]   ",
 StyleBox["N[", "MR",
  FontWeight->"Bold"],
 StyleBox["expr", "TI",
  FontWeight->"Bold"],
 StyleBox["]", "MR",
  FontWeight->"Bold"],
 StyleBox["\n \t\n\t", "MR"],
 "Note the two ways you can  use  ",
 StyleBox["N",
  FontWeight->"Bold"],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     StyleBox[
      RowBox[{"N", "[", 
       StyleBox["expr", "TI"], "]"}],
      FontWeight->"Bold"]], "InlineFormula"],
    "\[LineSeparator]gives the numerical value of ",
    Cell[BoxData[
     StyleBox["expr", "TI"]], "InlineFormula"],
    ". "
   }]], TraditionalForm]]],
 "\n\t\n\t\t",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     StyleBox[
      RowBox[{"N", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["n", "TI"]}], "]"}],
      FontWeight->"Bold"]], "InlineFormula"],
    "\[LineSeparator]attempts to give a result with ",
    Cell[BoxData[
     StyleBox["n", "TI"]], "InlineFormula"],
    "\[Hyphen]digit precision. "
   }]], TraditionalForm]]],
 "\n\t\t\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 " \t",
 StyleBox["Modify",
  FontVariations->{"Underline"->True}],
 " the \"Basic Examples\" in ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to calculate:   ",
 StyleBox["N[ 1/13 ]",
  FontWeight->"Bold"],
 "\n\t\t\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 "\t",
 StyleBox["Modify",
  FontVariations->{"Underline"->True}],
 " the \"Basic Examples\" in ",
 StyleBox["Help Documentation Center",
  FontVariations->{"Underline"->True}],
 " to calculate:   ",
 StyleBox["N[ 1/13 , 50 ]",
  FontWeight->"Bold"],
 "\n\t\t\n",
 Cell[BoxData[
  FormBox["\[GrayCircle]", TraditionalForm]]],
 "\tCut and Paste the two Input-Output cell pairs containing the above \
results into this notebook just below this text cell.\n"
}], "Text",
 CellChangeTimes->{{3.3903401298974*^9, 3.3903401498434*^9}, 
   3.3903410750064*^9, {3.3903413303794003`*^9, 3.3903414493574*^9}, {
   3.3903415111204*^9, 3.3903416955854*^9}, {3.3903417845964003`*^9, 
   3.3903418699564*^9}, {3.3903419051544*^9, 3.3903419321414003`*^9}, {
