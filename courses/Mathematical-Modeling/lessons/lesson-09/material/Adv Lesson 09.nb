?? perimeter
  Global`perimeter\
\>", "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.390039245139*^9, 3.3900392493570004`*^9}}],

Cell["\<\
?? area
  Global`area\
\>", "Program",
 GeneratedCell->False,
