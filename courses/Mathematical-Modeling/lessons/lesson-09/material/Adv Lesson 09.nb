 CellChangeTimes->{{3.390039254501*^9, 3.3900392775290003`*^9}}],

Cell["\<\
?? circle
   Global`circle
   perimeter[circle[r_]] ^:= 2*Pi*r
   area[circle[r_]] ^:= Pi*r^2
   color[circle[r_]] ^:= \"Red\"\
\>", "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.390039255649*^9, 3.3900392941359997`*^9}, 
   3.39003934715*^9}],

Cell["\<\
?? square
   Global`square
   perimeter[square[x_]] ^:= 4*x
   area[square[x_]] ^:= x^2
   color[square[x_]] ^:= \"Blue\"\
\>", "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900392588929996`*^9, 3.390039302676*^9}, 
   3.390039343801*^9}],

Cell["\<\
?? triangle
   Global`triangle
   area[triangle[b_, h_]] ^:= 1/2*b*h
   color[triangle[b_, h_]] ^:= \"Green\"\
\>", "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.390039261295*^9, 3.390039267368*^9}, {3.39003930594*^9, 
  3.390039308038*^9}}],

