Cell["\<\

As a final remark, there are some restrictions on tagging an argument of a \
function for use as an assignment tag (e.g. the tagged argument can only be \
nested one level deep). See the Mathematica references for more details.\
\>", "Text",
 CellChangeTimes->{3.523200796228512*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Head Of A Function:", "Subtitle"]], "Section"],

Cell[TextData[{
 "As illustrated previously, every expression in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has a head.  For \"atomic\" expressions, the head corresponds to its type."
}], "Text"],

Cell[BoxData[
 RowBox[{"Head", "[", "3", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Head", "[", "3.33", "]"}]], "Input"],

Cell["\<\

For non-atomic expressions, the head corresponds to the outermost function.\
\>", "Text",
 CellChangeTimes->{3.5232008297775116`*^9}],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"Head", " ", "[", 
   RowBox[{"a", "+", "b"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "+", "b"}], "//", "TreeForm"}]], "Input",
 CellChangeTimes->{{3.3898237822166557`*^9, 3.3898237918216553`*^9}}],

Cell[BoxData[
 RowBox[{"Head", " ", "[", 
  RowBox[{"Tan", "[", "x", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tan", "[", "x", "]"}], "//", "TreeForm"}]], "Input",
 CellChangeTimes->{{3.3898238038746557`*^9, 3.3898238192566557`*^9}}],

Cell[BoxData[
 RowBox[{"Head", " ", "[", 
  RowBox[{"Tan", "[", 
   RowBox[{
    SuperscriptBox["x", "2"], " ", "+", " ", "1"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tan", "[", 
   RowBox[{
    SuperscriptBox["x", "2"], " ", "+", " ", "1"}], "]"}], "//", 
  "TreeForm"}]], "Input",
 CellChangeTimes->{{3.389823839016656*^9, 3.3898238572206554`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Attributes Of A Functions:", "Subtitle"]], "Section"],

Cell[TextData[{
 "As discussed earlier, the attributes that are assigned to a function \
determine how it behaves within ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  For example:"
}], "Text",
 CellChangeTimes->{{3.3898239174296556`*^9, 3.3898239232526555`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Attributes", " ", "[", " ", "Plus", "]"}]}]], "Input"],

Cell["\<\
Flat is an attribute that can be assigned to a symbol f to indicate that all \
expressions involving nested functions f should be flattened out. This \
property is accounted for in pattern matching.\
\>", "Item",
 CellChangeTimes->{{3.390038652979*^9, 3.390038657153*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "a", ",", "b", ",", "c", ",", "d"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"Plus", " ", "[", 
  RowBox[{"a", ",", 
   RowBox[{"Plus", " ", "[", 
    RowBox[{"b", ",", " ", 
     RowBox[{"Plus", " ", "[", 
      RowBox[{"c", ",", "d"}], "]"}]}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Plus", " ", "[", 
   RowBox[{"a", ",", 
    RowBox[{"Plus", " ", "[", 
     RowBox[{"b", ",", " ", 
      RowBox[{"Plus", " ", "[", 
       RowBox[{"c", ",", "d"}], "]"}]}], "]"}]}], "]"}], "//", 
  "FullForm"}]], "Input",
 CellChangeTimes->{{3.3898239762136555`*^9, 3.3898239812436557`*^9}}],

Cell["\<\
Listable is an attribute that can be assigned to a symbol f to indicate that \
the function f should automatically be threaded over lists that appear as its \
arguments.\
\>", "Item",
 CellChangeTimes->{{3.390038643408*^9, 3.39003864863*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Plus", " ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "]"}]}]], "Input"],

Cell["\<\
NumericFunction is an attribute that can be assigned to a symbol f to \
indicate that f[arg1, arg2, ... ] should be considered a numeric quantity \
whenever all the argi are numeric quantities.\
\>", "Item",
 CellChangeTimes->{{3.390038636342*^9, 3.390038639656*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"f", ",", " ", "NumericFunction"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"Attributes", "[", "f", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"NumericQ", "[", 
  RowBox[{"f", "[", 
   RowBox[{"a", ",", "b"}], "]"}], "]"}]], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "3"}], ";"}], "\n", 
 RowBox[{"NumericQ", "[", 
  RowBox[{"f", "[", 
   RowBox[{"a", ",", "b"}], "]"}], "]"}]}], "Input"],

Cell["\<\
OneIdentity is an attribute that can be assigned to a symbol f to indicate \
that f[x], f[f[x]], etc. are all equivalent to x for the purpose of pattern \
matching.\
\>", "Item",
 CellChangeTimes->{{3.390038707315*^9, 3.3900387104969997`*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "a", ",", "b", ",", "c", ",", "d"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"Plus", "[", "a", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"+", "a"}]], "Input",
 CellChangeTimes->{{3.3898240673666553`*^9, 3.3898240681996555`*^9}}],

Cell[BoxData[
 RowBox[{"Plus", " ", "[", 
  RowBox[{"Plus", " ", "[", 
   RowBox[{"Plus", " ", "[", "a", "]"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"+", 
  RowBox[{"(", 
   RowBox[{"+", 
    RowBox[{"(", 
     RowBox[{"+", "a"}], ")"}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.3898240749986553`*^9, 3.3898241080406556`*^9}}],

Cell["\<\
Orderless is an attribute that can be assigned to a symbol f to indicate that \
the elements ei in expressions of the form f[e1, e2, ... ] should \
automatically be sorted into canonical order. This property is accounted for \
in pattern matching.\
\>", "Item",
 CellChangeTimes->{{3.39003869881*^9, 3.390038702675*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Plus", "[", 
   RowBox[{"a", ",", "b"}], "]"}], "==", 
  RowBox[{"Plus", "[", 
   RowBox[{"b", ",", "a"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e"}], "==", 
  RowBox[{"c", "+", "e", "+", "b", "+", "a", "+", "d"}]}]], "Input"],

Cell["\<\
Protected is an attribute which prevents any values associated with a symbol \
from being modified.\
\>", "Item",
 CellChangeTimes->{{3.3900386928719997`*^9, 3.3900386961029997`*^9}},
 FontWeight->"Bold"],

Cell["\<\
Plus[a_, b_] := \"Something New\"

SetDelayed::write : \"Tag Plus in a_ + b_ is Protected.\"
$Failed\
\>", "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.390039407038*^9, 3.390039444317*^9}}],

Cell["\<\
a + b = 4

Set::write : \"Tag Plus in a + b is Protected.\"
4\
\>", "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900394542279997`*^9, 3.390039486487*^9}}],

Cell["\<\
Finally, the other commonly used attributes include variations on \"Hold\".

Hold specifies which arguments in a function are to be held in an unevaluated \
state UNTIL the subsequent functional assignments are invoked. Arguments that \
are not held are evaluated (i.e. replaced with any previously assigned \
values) and they take on those fixed values throughout the evaluation of the \
function.  The held arguments are not evaluated (i.e. are not replaced with \
any previously assigned values) and are kept in symbolic form until \
evaluation is forced later.\
\>", "Text"],

Cell[CellGroupData[{

Cell["\<\
HoldAll is an attribute which specifies that all arguments to a function are \
to be maintained in an unevaluated form.\
\>", "Item",
 CellChangeTimes->{{3.39003873201*^9, 3.3900387414969997`*^9}},
 FontWeight->"Bold"],

Cell["\<\
HoldFirst is an attribute which specifies that the first argument to a \
function is to be maintained in an unevaluated form.\
\>", "Item",
 CellChangeTimes->{{3.390038735391*^9, 3.390038744153*^9}},
 FontWeight->"Bold"],

Cell["\<\
HoldRest is an attribute which specifies that all but the first argument to a \
function are to be maintained in an unevaluated form.\
\>", "Item",
 CellChangeTimes->{{3.390038736795*^9, 3.390038747458*^9}},
 FontWeight->"Bold"]
}, Open  ]],

