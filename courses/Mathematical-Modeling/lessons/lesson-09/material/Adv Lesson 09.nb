 RowBox[{" ", 
  RowBox[{"multiplication", "[", 
   RowBox[{"a", ",", "b"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Hold", " ", "[", 
   RowBox[{"multiplication", "[", 
    RowBox[{"a", ",", "b"}], "]"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Attributes", " ", "[", "multiplication", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"multiplication", ",", "HoldFirst"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"Attributes", " ", "[", "multiplication", "]"}]], "Input"],

Cell["Observe:", "Text"],

Cell["\<\
?? multiplication
  Global`multiplication
  (InputForm[Definition[multiplication]])\
\>", "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.3900395090950003`*^9, 3.3900395127939997`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "3"}], ";"}]}], "Input",
 CellChangeTimes->{3.3898242186256557`*^9}],

Cell[BoxData[
 RowBox[{"multiplication", "[", 
  RowBox[{"a", ",", "b"}], "]"}]], "Input"],

Cell[TextData[{
 "\nNotice that the first argument \"a\" was ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " evaluated (even though a has an assigned value)."
}], "Text",
 CellChangeTimes->{3.389824247169656*^9, 3.523201051476512*^9}],

Cell["\<\
Now introduce an assignment to the function's name (which will force the \
subsequent evaluation of the arguments).\
\>", "Text"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"multiplication", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"a", "*", "b"}]}]}]], "InputOnly"],

Cell["Observe:", "Text"],

Cell["?? multiplication", "Program"],

Cell["Global`multiplication", "Program",
 CellChangeTimes->{{3.390039537234*^9, 3.390039540373*^9}}],

Cell["\<\
Attributes[multiplication] = {HoldFirst}
 
multiplication[a_, b_] := a*b\
\>", "Program",
 CellChangeTimes->{{3.3900395316029997`*^9, 3.3900395335030003`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "3"}], ";"}]}], "Input",
 CellChangeTimes->{3.3898242656786556`*^9}],

Cell[BoxData[
 RowBox[{"multiplication", "[", 
  RowBox[{"a", ",", "b"}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Evaluation Of A Function:", "Subtitle"]], "Section"],

Cell[TextData[{
 "When ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " invokes a function, the following procedure is used:\n\n\t  First, the \
head of the function is evaluated along with its attributes.\n\n\t  Second, \
if the function does NOT have an attribute of  HoldAll, HoldFirst or \
HoldRest, then all of the arguments to the function are evaluated (i.e. ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " searches for assignments to the individual arguments and makes the \
replacement and any simplification is performed).  Then, the function is \
evaluated (using the functional assignment) using the fixed evaluated values \
of the arguments.\n\t   \n\t   However, if the function DOES have an \
attribute of  HoldAll, HoldFirst or HoldRest, then the arguments that are not \
\"Held\" are evaluated (i.e. replaced by any assigned values) and any \
variables that are \"Held\" are not evaluated (i.e. not replaced by assigned \
values). ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " then begins to evaluate the function, keeping the \"Held\" variables \
unevaluated and in symbolic form until evaluation is forced by an internal \
use of these variables.\n\t   \n\t   \n\t    Recall a previous example:"
}], "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Attributes", " ", "[", "Table", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"RandomReal", "[", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.398712201052762*^9, 3.398712224740262*^9}}],

Cell[BoxData[
 RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"RandomReal", "[", "]"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.398712201052762*^9, 3.398712253271512*^9}}],

Cell[TextData[{
 "\nNotice that in the first case that RandomReal [ ] was \"held\" in an \
unevaluated state to generate the table.  Only after the table had been \
generated was the evaluation of RandomReal [ ] forced yielding five different \
values.\n\n\t\t",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"RandomReal", "[", " ", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}],
    Function[BoxForm`e$, 
     TableForm[BoxForm`e$]]], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomReal", "[", "]"}], ",", 
     RowBox[{"RandomReal", "[", "]"}], ",", 
     RowBox[{"RandomReal", "[", "]"}], ",", 
     RowBox[{"RandomReal", "[", "]"}], ",", 
     RowBox[{"RandomReal", "[", "]"}]}], "}"}], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "0.7809374086951795`", ",", "0.5806440817890204`", ",", 
     "0.3414981911709023`", ",", "0.980638479599871`", ",", 
     "0.7642149574406976`"}], "}"}], TraditionalForm]]],
 "\n\t\t\nNotice that in the second case that RandomReal [ ] was not \"held\" \
in an unevaluated state to generate the table.  RandomReal [ ] was evaluated ",
 StyleBox["before",
  FontVariations->{"Underline"->True}],
 " the table was constructed and the ",
 StyleBox["same",
  FontVariations->{"Underline"->True}],
 " evaluated value for RandomReal [ ] was used for all entries in the table. \
\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"RandomReal", "[", " ", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}], TraditionalForm]]],
 "\n\t\t\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Table", "[", " ", 
    RowBox[{"0.22234949009386673`", " ", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}], TraditionalForm]]],
 "\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "0.22234949009386673`", ",", "0.22234949009386673`", ",", 
     "0.22234949009386673`", ",", "0.22234949009386673`", ",", 
     "0.22234949009386673`"}], "}"}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3898244263886557`*^9, 3.3898245350286555`*^9}, {
   3.389824575563656*^9, 3.3898246117516556`*^9}, {3.389824673393656*^9, 
   3.389824773707656*^9}, 3.5232012838185115`*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Documenting Your Functions:", "Subtitle"]], "Section"],

Cell[TextData[{
 "If you want to find information about ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s internal functions, you use the \"?\" command"
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"?", "Sin"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Sin", "[", "z", "]"}], " ", "gives", " ", "the", " ", "sine", " ",
    "of", " ", "z"}], " ", ">>", Cell[""]}]}], "Program",
 CellChangeTimes->{{3.389824795570656*^9, 3.389824799497656*^9}, {
  3.3898248843116555`*^9, 3.3898249095606556`*^9}, {3.3898249460866556`*^9, 
  3.3898249496836557`*^9}, {3.3898249888646555`*^9, 3.389825054570656*^9}}],

Cell["\<\
It is possible to define your own information about a function that you have \
created.
The general form is:     function::usage=\"  ...   what ever you want to say  \
...\"\
\>", "Text",
 CellChangeTimes->{{3.389825111832656*^9, 3.3898251223816557`*^9}}],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"ClearAll", " ", "[", 
   RowBox[{"f", ",", "x"}], "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  SqrtBox["x"]}]], "InputOnly"],

Cell["Observe:", "Text"],

Cell["?? f", "Program"],

Cell["Global`f", "Program",
 CellChangeTimes->{{3.390039584778*^9, 3.390039588225*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], " ", ":=", 
   SqrtBox["x"]}],
  ShowStringCharacters->True,
  NumberMarks->True]], "Program",
 CellChangeTimes->{3.389825195754656*^9, 3.390039578796*^9}],

Cell["Create a message for f:", "Text",
 CellChangeTimes->{{3.3898252646966553`*^9, 3.3898252660926557`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "::", "usage"}], "=", 
  "\"\<f[x] is the square root function\>\""}]], "Input"],

Cell["Observe:", "Text"],

Cell["?? f", "Program"],

Cell["f[x] is the square root function", "Program",
 CellChangeTimes->{{3.3900396080699997`*^9, 3.390039633802*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", 
   SqrtBox["x"]}],
  ShowStringCharacters->True,
  NumberMarks->True]], "Program",
 CellChangeTimes->{3.3898252067436557`*^9, 3.3900396232939997`*^9}],

Cell[TextData[{
 "Another way to introduce documentation is to comment individual lines of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3898252815626554`*^9, 3.3898252861456556`*^9}}],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"ClearAll", " ", "[", 
   RowBox[{"f", ",", "x"}], "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Clears", " ", "definition", " ", "of", " ", "f", " ", "and", " ", "x"}], 
   " ", "*)"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  SqrtBox["x"], "             ", 
  RowBox[{"(*", " ", 
   RowBox[{"Assigns", " ", "a", " ", "value", " ", "to", " ", 
    RowBox[{"f", "[", "x", "]"}]}], " ", "*)"}]}]], "InputOnly"],

Cell["Observe:", "Text"],

Cell[BoxData[
 RowBox[{"??", 
  RowBox[{
   RowBox[{"f", "\n", "Global`f", "\n", 
    RowBox[{"f", "[", "x_", "]"}]}], ":=", 
   SqrtBox["x"]}]}]], "Program",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{
  3.389825215740656*^9, {3.390039647045*^9, 3.3900396525290003`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Exercises:", "Title"],
 "  Advanced Lesson 9 "
}], "Section"],

Cell["\<\
Your Name:

Your Math Class:\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold"],

Cell["\<\
1:  Define a function:   f( x, y, z ) = {x, y, z}   such that argument:  y  \
has a default value of 10, and argument:  z  has a default value of 20.  \
Evaluate:  f[1,2,3,4],  f[1,2,3],  f[1,2],  f[1], f[ ]\
\>", "Text"],

Cell["\<\
2: Make 2 copies of the following code segment by interchanging the second \
and third lines.  Evaluate each of the 2 code segments.  Also display  ?f  \
for each of the 2 code segments.  Observe the differences between the 2 code \
segments (and also differences between how you typed them in and how they are \
stored) and identify which code segment (first, second or both) that would \
work if we want the numbers to be identified as:  even or odd or = 2.
\tf[x_]:=\"x is anything\"
\tf[x_?OddQ]:=\"x is odd\"
\tf[x_?EvenQ]:=\"x is even\"
\tf[2]:=\"x = 2\"
\tTable[{i,f[i]},{i,1,4,1/2}]  // TableForm\
\>", "Text"],

Cell["\<\
3: Make 2 copies of the following code segment by interchanging the second \
and third lines.  Evaluate each of the 2 code segments.  Also display  ?f  \
for each of the 2 code segments.  Observe the differences between the 2 code \
segments (and also differences between how you typed them in and how they are \
stored) and identify why you get different results.
\tf[x_?OddQ]:=\" x is odd\"
\tf[x_?Positive]:=\" x is positive\"
\tf[x_?IntegerQ ]:=\" x is an integer\"
\tf[2]:=\" x = 2\"
\tf[x_]:=\" x is arbitrary\"
\tTable[{i,f[i]},{i,-2,4,1/2}]  // TableForm\
\>", "Text"],

Cell[TextData[{
 "4: Assume that in your research you construct a complicated new function \
called: myFunction [x].  Your work requires repeated integration involving \
your new function.  However, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is unaware of your new function and its corresponding integral.  Therefore \
you integrate your function to get: myFunctionIntegral [x].  You would like \
to assign your new formula to the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command Integrate by:\n\t Integrate [ myFunction[x_], x_ ] := \
myFunctionIntegral [x]\n Part 1: Try this and explain what happens.\n Part 2: \
Tag this assignment to the functional argument:  myFunction\n Part 3: \
Evaluate:    ?? myFunction\n Part 4: Evaluate:    \[Integral] Sin[x] \
\[DifferentialD]x\n Part 5: Evaluate:    \[Integral] myFunction[x] \
\[DifferentialD]x \n Part 6: Evaluate:    \[Integral] myFunction[y] \
\[DifferentialD]y\n Part 7: What is the Head of:  \[Integral] myFunction[x] \
\[DifferentialD]x "
}], "Text"],

Cell["\<\
5: Assume that in your research you construct a complicated new function \
called: myFunction [x, y, z,  ...  ].  The order in which the functional \
arguments appear is irrelevant and the function should always give the same \
value irrespective of the order of the arguments.   
 Part 1: Set your function's attributes to be orderless.
 Part 2: Evaluate:    ?? myFunction
 Part 3: Evaluate:    myFunction[1,2,3]   and   myFunction[3,2,1]
 Part 4: Evaluate:    myFunction[a,b,c,d]   and   myFunction[d,c,b,a]
 Part 5: Evaluate:    myFunction[c,b,a,d] == myFunction[d,c,b,a]\
\>", "Text"],

Cell["\<\
6: Assume that in your research you construct a complicated new function \
called: myFunction [x, y, z,  ...  ].   When you use your function, the first \
argument \"x\" is expected to contain information which will take on several \
different values while your function is being evaluated.  However, all of the \
remaining arguments:  y, z,  ...   will only be assigned one value each which \
will remain fixed throughout the evaluation of your function.  
 Part 1: Set your function's attributes to hold only the first argument.
 Part 2: Evaluate:    ?? myFunction
 Part 3: Evaluate:    a=1, b=2, c=3, d=4    and   myFunction[a,b,c,d]   \
Explain this result.
 Part 4: Evaluate:    myFunction[a_,b_,c_,d_] := {a, b, c, d}
 Part 5: Evaluate:    ?? myFunction
 Part 6: Evaluate:    a=1, b=2, c=3, d=4,  myFunction[a,b,c,d]   
 Part 7: Explain (i.e. trace) at what point the argument \"a\" was evaluated.\
\>", "Text",
 CellChangeTimes->{{3.3904306117130003`*^9, 3.390430618551*^9}}],

Cell["\<\
7: Assume that in your research you construct a complicated new function \
called: myFunction [x, y, z,  ...  ].   It is important to document your \
function so that other users can understand its usage.
 Part 1: Set your function's usage message to:   \"myFunction [x, y, z,  ...  \
] is important to understand.\"
             Set:     myFunction [x_, y_, z_ ] := Sin[x y z]
             Set your function's attributes to hold all of the arguments.
 Part 2: Evaluate:    ? myFunction
 Part 3: Evaluate:    ?? myFunction\
\>", "Text",
 CellChangeTimes->{{3.39043070226*^9, 3.3904307317469997`*^9}}],

Cell[TextData[{
 StyleBox["Print",
  FontSize->14,
  FontWeight->"Bold"],
 StyleBox[" your homework exercises",
  FontSize->14],
 ".\n",
 StyleBox["But do ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["NOT",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" print the above lesson along with the exercises!",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.3903491193324003`*^9, 3.3903491706104*^9}, {
   3.3903492171244*^9, 3.3903492363613997`*^9}, {3.3903493057854*^9, 
   3.3903493616624002`*^9}, {3.390367829311*^9, 3.390368046703*^9}, {
   3.390368151425*^9, 3.390368157087*^9}, {3.3903689909309998`*^9, 
