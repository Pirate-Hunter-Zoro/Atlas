Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \n",
 "Advanced Lesson 9\n\nProperties of Functions\n\nDr. Dale R. Doty\n\
University of Tulsa"
}], "Title"],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Default Values:", "Subtitle"]], "Section"],

Cell["\<\
Many times you want to define a function of several arguments.  However, it \
may be convenient to allow some of the arguments to take on default values if \
they do not always need to be specified.

The general notation for this is:    variable_: default

and the function (with default value) is:           f[  ... ,variable_: \
default, ...]:=\
\>", "Text",
 CellChangeTimes->{{3.389821868360656*^9, 3.3898218865956554`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly"],

Cell["\<\
Consider a function that generates a list of integers from a starting to a \
stopping value (unless no starting value has been specified, in which case \
the default starting value is 0).\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", " ", 
   RowBox[{
    RowBox[{"start_:", " ", "0"}], ",", " ", "stop_"}], "]"}], ":=", " ", 
  RowBox[{"Range", " ", "[", 
   RowBox[{"start", ",", " ", "stop"}], "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"3", ",", "7"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", "7", "]"}]], "Input"],

Cell["\<\

Consider an example of integration with an optional constant of integration \
(where the default value for the optional constant is:  c):\
\>", "Text",
 CellChangeTimes->{3.523199996082512*^9}],

Cell[BoxData[
 RowBox[{"Clear", "[", " ", 
  RowBox[{"newIntegrate", ",", "f", ",", "x", ",", "c"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newIntegrate", "[", 
   RowBox[{
    RowBox[{"f_", "[", "x", "]"}], ",", 
    RowBox[{"optionalConstant_:", "c"}]}], "]"}], ":=", "\[IndentingNewLine]",
   "\n", "\t                    ", 
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "+", " ", 
   "optionalConstant"}]}]], "InputOnly",
 CellChangeTimes->{3.389821946926656*^9}],

Cell[BoxData[
 RowBox[{"newIntegrate", "[", 
  RowBox[{
   RowBox[{"Tan", "[", "x", "]"}], ",", "9"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"newIntegrate", "[", 
  RowBox[{"Tan", "[", "x", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"c", "=", "1234"}]], "Input"],

Cell[BoxData[
 RowBox[{"newIntegrate", "[", 
  RowBox[{"Tan", "[", " ", "x", "]"}], "]"}]], "Input"],

Cell["\<\

Note that I used the specific symbol \"x\" in the definition of the function \
f[x]  (rather than x_) to ensure that the integral would be with respect to \
the symbol  \"x\" only.  Recall that this is an extremely dangerous procedure \
to use in a definition (if x has been previously assigned a value).\
\>", "Text",
 CellChangeTimes->{{3.3898220112846556`*^9, 3.3898220260866556`*^9}, 
   3.523200022832512*^9}],

Cell[BoxData[
 RowBox[{"newIntegrate", "[", 
  RowBox[{"Tan", "[", 
   RowBox[{"2", " ", "x"}], "]"}], "]"}]], "Input"],

Cell["\<\

Next, examine what happens when we change the location of the default \
argument as well as the number of arguments that have defaults.\
\>", "Text",
 CellChangeTimes->{3.5232000430385113`*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z", ",", "c"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{
    RowBox[{"x_:", "333"}], ",", "y_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]], "InputOnly",
 CellChangeTimes->{{3.389822080912656*^9, 3.3898220814076557`*^9}, {
  3.389822153839656*^9, 3.389822154332656*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"1", ",", "2", ",", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"2", ",", "3"}], "]"}]], "Input"],

Cell["\<\
\[LineSeparator]Move the default argument to the second position.\
\>", "Text",
 CellChangeTimes->{3.389822105372656*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z", ",", "c"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", 
    RowBox[{"y_:", "555"}], ",", "z_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898221280586557`*^9, 3.3898221285766554`*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"1", ",", "2", ",", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"1", ",", "3"}], "]"}]], "Input"],

Cell["\<\

Create two default arguments.  Note that this will create an ambiguity if we \
only assigned values to two out of the three arguments.\
\>", "Text",
 CellChangeTimes->{3.5232000669255114`*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z", ",", "c"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{
    RowBox[{"x_:", "333"}], ",", 
    RowBox[{"y_:", "444"}], ",", "z_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898221667896557`*^9, 3.389822174030656*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"1", ",", "2", ",", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"1", ",", "3"}], "]"}]], "Input"],

Cell[TextData[{
 "\nNote that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " assumes that the last default (i.e. the second position) is the missing \
value.\n\nHowever, if two values are missing, then there is no ambiguity."
}], "Text",
 CellChangeTimes->{3.523200082589512*^9}],

Cell[BoxData[
 RowBox[{"f", "[", "3", "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Order Of Evaluation Of Assignments:", "Subtitle"]], \
"Section"],

Cell[TextData[{
 "The above examples illustrate that it is possible to give a single symbol \
(function) several different delayed assignments.  The question is, in \
exactly what order will ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " attempt to perform the assignment.  In general, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " attempts to order the assignments from more specific to less specific.  \
For example, f[x_ Integer]:= ...  is more specific than  f[x_]:= ... .  \
However,  f[x_ Integer]:= ...   and  f[x_  Real]:= ...   are equally specific \
(at least to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ") and the order of evaluation will depend upon the order in which you \
entered the delayed assignments.  The exact order that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has chosen can always be discovered with the ??f command."
}], "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_Integer", "]"}], ":=", 
  RowBox[{"Sin", "[", "x", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898223345616555`*^9, 3.3898223369166555`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", " ", 
  "\"\<x is even\>\""}]], "InputOnly"],

Cell["Observe:", "Text"],

Cell["?f", "Program"],

Cell["Global`f", "Program",
 CellChangeTimes->{{3.390038868625*^9, 3.390038871428*^9}}],

Cell["\<\
f[x_Integer] := Sin[x]
 
f[(x_)?EvenQ] := \"x is even\"\
\>", "Program",
 CellChangeTimes->{{3.3898224548236556`*^9, 3.3898224577386556`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}], "//", 
  "TableForm"}]], "Input",
 CellChangeTimes->{{3.3898222761236553`*^9, 3.3898222971996555`*^9}}],

Cell[TextData[{
 "\nNote that every value of the argument was an integer and therefore the \
value of the function was a Sin[i].  Thus, the delayed assignment as an even \
integer was never used. \nHowever, \"we\" want to consider an \"even\" \
integer to be more specific than just an integer.  Thus, if we assign it ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 ", then the application of the delayed assignments will be correct."
}], "Text",
 CellChangeTimes->{{3.3898223658836555`*^9, 3.389822415209656*^9}, 
   3.5232001622165117`*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", " ", 
  "\"\<x is even\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_Integer", "]"}], ":=", 
  RowBox[{"Sin", "[", "x", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898224320126553`*^9, 3.3898224371826553`*^9}}],

Cell["Observe:", "Text"],

Cell["?? f", "Program"],

Cell["Global`f", "Program",
 CellChangeTimes->{{3.390038876666*^9, 3.390038878968*^9}}],

Cell["\<\
f[(x_)?EvenQ] := \"x is even\"
 
f[x_Integer] := Sin[x]\
\>", "Program",
 CellChangeTimes->{{3.3898224916946554`*^9, 3.3898224947116556`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}], "//", 
  "TableForm"}]], "Input"],

Cell[TextData[{
 "\nAn \"atomic\"  (i.e. number etc.) value is more specific than any other \
type, therefore ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will ",
 StyleBox["always",
  FontVariations->{"Underline"->True}],
 " place it first."
}], "Text",
 CellChangeTimes->{{3.3898225347046556`*^9, 3.3898225449476557`*^9}, 
   3.5232001851755114`*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  "\"\< x is arbitrary\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", 
  "\"\< x is even\>\""}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "4", "]"}], ":=", 
  "\"\< x = 4   (most specific)\>\""}]], "InputOnly"],

Cell["Observe:", "Text"],

Cell["?? f", "Program"],

Cell["Global`f", "Program",
 CellChangeTimes->{{3.390038966435*^9, 3.390038968995*^9}}],

Cell[TextData[Cell[BoxData[GridBox[{
   {
    RowBox[{
     RowBox[{"f", "[", "4", "]"}], ":=", "\"\< x = 4   (most specific)\>\""}]},
   {" "},
   {
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", "\"\< x is even\>\""}]},
   {" "},
   {
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ":=", "\"\< x is arbitrary\>\""}]}
  },
  BaselinePosition->{Baseline, {1, 1}},
  GridBoxAlignment->{
   "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
    "RowsIndexed" -> {}},
  GridBoxItemSize->{"Columns" -> {{
       Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
    "RowsIndexed" -> {}}]],
 CellChangeTimes->{3.3900389146280003`*^9}]], "Program",
 CellChangeTimes->{3.390038935365*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}], "//", 
  "TableForm"}]], "Input"],

Cell["\<\

Observe that the order of assignment has been reversed from how we entered it.\
\>", "Text",
 CellChangeTimes->{3.523200213188512*^9}],

Cell[TextData[{
 "Finally, observe that even when we use the \"Which\" command that the order \
in which the assignments are listed can be important (",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " evaluates the order EXACTLY as specified in the Which command ALWAYS)."
}], "Text",
 CellChangeTimes->{{3.3898226094066553`*^9, 3.3898226176966553`*^9}, {
  3.5232002382275114`*^9, 3.5232002436505117`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Which", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IntegerQ", "[", "x", "]"}], ",", "\"\< x is arbitrary\>\"", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"EvenQ", "[", "x", "]"}], ",", "\"\< x is even\>\"", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"x", "\[Equal]", "4"}], ",", "\"\< x = 4   (most specific)\>\"", 
    ",", "\[IndentingNewLine]", "True", ",", "\"\< no value assigned\>\""}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.3898226432266555`*^9, 3.3898226706976557`*^9}}],

Cell["Observe:", "Text"],

Cell["?? f", "Program"],

Cell["Global`f", "Program",
 CellChangeTimes->{{3.390039006869*^9, 3.390039009705*^9}}],

Cell["\<\
f[x_] := Which[IntegerQ[x], \" x is arbitrary\", EvenQ[x], \" x is even\", x \
== 4, \" x = 4   (most specific)\", True, \" no value assigned\"]\
\>", "Program",
 CellChangeTimes->{{3.390038985186*^9, 3.390038986251*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}], "//", 
  "TableForm"}]], "Input"],

Cell["\<\

Reverse the order to be most specific to least specific.\
\>", "Text",
 CellChangeTimes->{3.5232002588975115`*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{"f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z"}], 
   "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"Which", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "\[Equal]", "4"}], ",", "\"\< x = 4   (most specific)\>\"", 
    ",", "\[IndentingNewLine]", 
    RowBox[{"EvenQ", "[", "x", "]"}], ",", "\"\< x is even\>\"", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"IntegerQ", "[", "x", "]"}], ",", "\"\< x is arbitrary\>\"", ",", 
    "\[IndentingNewLine]", "True", ",", "\"\< no value assigned\>\""}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "InputOnly",
 CellChangeTimes->{{3.389822768221656*^9, 3.3898227925936556`*^9}}],

Cell["Observe:", "Text"],

Cell["?? f", "Program"],

Cell["Global`f", "Program",
 CellChangeTimes->{{3.390039022329*^9, 3.3900390253199997`*^9}}],

Cell["\<\
f[x_] := Which[x == 4, \" x = 4   (most specific)\", EvenQ[x], \" x is \
even\", IntegerQ[x], \" x is arbitrary\", True, \" no value assigned\"]]\
\>", "Program",
 CellChangeTimes->{{3.390039029045*^9, 3.390039032223*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}], "//", 
  "TableForm"}]], "Input"],

Cell["\<\

The following illustrates why it is sometimes handy to have a \"trap\" to \
ensure that an assignment has been made when all other conditions in the \
Which command fail to yield True.\
\>", "Text",
 CellChangeTimes->{3.5232002660985117`*^9}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"3", "+", 
   RowBox[{"4", "\[ImaginaryI]"}]}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Tagging Functional Arguments In Assignments:", \
"Subtitle"]], "Section"],

Cell[TextData[{
 "Sometimes it is desirable to assign an expression to a different expression \
(sometimes this can be accomplished with replacement rules).  However, \
sometimes it is more desirable to use delayed assignment rather than \
replacement rules, especially if the assignment is to be used over again in \
the future.\n\nAs an example, consider the case where you might want to take \
a separated linear expression involving a linear operator (like the \
derivative, integral or Laplace transform) and merge all expressions inside \
that linear operator.\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "*", 
     RowBox[{"L", "[", "x", "]"}]}], " ", "+", " ", 
    RowBox[{"b", "*", 
     RowBox[{
      RowBox[{"L", "[", "y", "]"}], " ", "\[DoubleLongRightArrow]", " ", 
      RowBox[{"L", "[", 
       RowBox[{
        RowBox[{"a", "*", "x"}], " ", "+", " ", 
        RowBox[{"b", "*", "y"}]}], "]"}]}]}]}], TraditionalForm]]],
 "         (In this direction)\n\t\nHow do we do this?"
}], "Text",
 CellChangeTimes->{{3.3898229147856555`*^9, 3.3898229590076556`*^9}, {
  3.3898229985176554`*^9, 3.3898230222566557`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{
   "L", ",", "f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z", ",", "a", 
    ",", "b"}], "]"}]}]], "InputOnly"],

Cell[TextData[{
 "We might just try to make the assignment directly:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "*", 
     RowBox[{"L", "[", "x", "]"}]}], " ", "+", " ", 
    RowBox[{"b", "*", 
     RowBox[{
      RowBox[{"L", "[", "y", "]"}], " ", "\[DoubleLongRightArrow]", " ", 
      RowBox[{"L", "[", 
       RowBox[{
        RowBox[{"a", "*", "x"}], " ", "+", " ", 
        RowBox[{"b", "*", "y"}]}], "]"}]}]}]}], TraditionalForm]]],
 "  \n\nthat generates the following error message:"
}], "Text",
 CellChangeTimes->{{3.3898230566256557`*^9, 3.3898231054866557`*^9}}],

Cell["a*L[x_] + b*L[y_] := L[a*x + b*y]   ", "Program"],

Cell["\<\
SetDelayed::write : Tag Plus in a L[x_] + b L[y_] is Protected.\
\>", "Program",
 CellChangeTimes->{{3.3900391193599997`*^9, 3.39003914405*^9}, {
  3.390039182176*^9, 3.390039185454*^9}}],

Cell["$Failed", "Program"],

Cell["What is going on here?", "Text"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{"TreeForm", " ", "[", "   ", 
   RowBox[{"Hold", " ", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"L", "[", "x_", "]"}]}], " ", "+", " ", 
      RowBox[{"b", "*", 
       RowBox[{"L", "[", "y_", "]"}]}]}], " ", ":=", " ", 
     RowBox[{"L", "[", 
      RowBox[{
       RowBox[{"a", "*", "x"}], " ", "+", " ", 
       RowBox[{"b", "*", "y"}]}], "]"}]}], "]"}], "]"}]}]], "Input"],

Cell["\<\

From the TreeForm, we see that the delayed assignment (i.e. SetDelayed) is \
trying to assign \[OpenCurlyDoubleQuote]L\[CloseCurlyDoubleQuote] to \
\[OpenCurlyDoubleQuote]Plus\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.3898231447446556`*^9, 3.389823223917656*^9}, {
  3.523200347372512*^9, 3.5232003674675117`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Head", "[", 
   RowBox[{
    RowBox[{"a", "*", 
     RowBox[{"L", "[", "x_", "]"}]}], " ", "+", " ", 
    RowBox[{"b", "*", 
     RowBox[{"L", "[", "y_", "]"}]}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Attributes", " ", "[", " ", "Plus", "]"}]}]], "Input"],

Cell["\<\
We are attempting to make a new assignment to (i.e. modify) the \"Plus\" \
command which has been given the attribute \"Protected\".\
\>", "Text"],

Cell["\<\
Protected is an attribute which prevents any values associated with a symbol \
from being modified.\
\>", "Item",
 CellChangeTimes->{{3.390038572281*^9, 3.390038575216*^9}},
 FontWeight->"Bold"],

Cell["\<\
However if we want this to work, the delayed assignment must be made to some \
symbol. This assignment is usually the head of the outermost function.  \
However, in this case the head \"Plus\" is \"Protected\", and therefore it \
would be more natural to tag this delayed assignment to one of the function's \
internal arguments.  In this case, the only internal argument is the linear \
operator \"L\", which is a user defined function and has not been protected.\
\>", "Text",
 CellChangeTimes->{{3.3898232575986557`*^9, 3.3898233101536555`*^9}}],

Cell["\<\
f /: lhs = rhs assigns rhs to be the value of lhs, and associates the \
assignment with the symbol f.\
\>", "Item",
 CellChangeTimes->{{3.3900385911099997`*^9, 3.3900385981879997`*^9}},
 FontWeight->"Bold"],

Cell["Notation:     f /:   lhs = rhs", "Text"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{
   "L", ",", "f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z", ",", "a", 
    ",", "b"}], "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"L", "/:", "   ", 
  RowBox[{
   RowBox[{"L", "[", "x_", "]"}], " ", "+", " ", 
   RowBox[{"L", "[", "y_", "]"}]}], " ", ":=", " ", 
  RowBox[{"L", "[", 
   RowBox[{"x", " ", "+", " ", "y"}], "]"}], "   "}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"L", "/:", "  ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a_", "?", "NumberQ"}], ")"}], "*", 
   RowBox[{"L", "[", "x_", "]"}]}], " ", ":=", " ", 
  RowBox[{"L", "[", 
   RowBox[{"a", "*", "x"}], " ", "]"}], "   "}]], "InputOnly"],

Cell["\<\
Observe that the assignments have been made to \"L\" and not to the \
\[OpenCurlyDoubleQuote]Plus\[CloseCurlyDoubleQuote] command:\
\>", "Text",
 CellChangeTimes->{{3.523200635292512*^9, 3.5232006369555116`*^9}}],

Cell["?? L", "Program"],

Cell["Global`L", "Program",
 CellChangeTimes->{{3.390039201102*^9, 3.390039204672*^9}}],

Cell["\<\
L[x_] + L[y_] ^:= L[x + y]
 
L[x_]*(a_)?NumberQ ^:= L[a*x]\
\>", "Program",
 CellChangeTimes->{{3.3900391941610003`*^9, 3.390039197852*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "[", "X1", "]"}], " ", "+", " ", 
  RowBox[{"L", "[", "X2", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"4", "*", 
  RowBox[{"L", "[", 
   RowBox[{"17", "*", "X4"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "[", "X1", "]"}], " ", "+", " ", 
  RowBox[{"2", "*", 
   RowBox[{"L", "[", "X2", "]"}]}], "+", 
  RowBox[{"3", "*", 
   RowBox[{"L", "[", "X3", "]"}]}], "+", 
  RowBox[{"4", "*", 
   RowBox[{"L", "[", 
    RowBox[{"17", "*", "X4"}], "]"}]}]}]], "Input"],

Cell[TextData[{
 "\nBecause most ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " functions have Attribute \"Protected\", they can not be augmented easily \
to include our new assignment (although removing \"Protected\" for \"Plus\" \
can be done, it is inefficient and may possibly break this function).  Thus, \
augmenting the assigned values to a user defined function \"f\" is usually \
the only possible recourse.  Remember, this assignment rule is specifically \
for the symbol \"f\", and the assignment will not work if the symbol \"f\" is \
reassigned to a new value. However, this augmented assignment to the function \
\"f\" can be used at anytime in the future.\n\nNote that the same result can \
be accomplished with delayed replacement rules (however it won't occur \
automatically whenever the expression  ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"a", "*", 
     RowBox[{"L", "[", "x_", "]"}]}], " ", "+", " ", 
    RowBox[{"b", "*", 
     RowBox[{"L", "[", "y_", "]"}]}]}],
   FontWeight->"Bold"]]],
 "  occurs in the future  ( i.e. it occurs only on the single line in which \
the replacement rule is used))."
}], "Text",
 CellChangeTimes->{{3.3898233887386556`*^9, 3.3898234530086555`*^9}, {
   3.3898235087856555`*^9, 3.3898235161686554`*^9}, 3.5232006461145115`*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Clear", " ", "[", 
   RowBox[{
   "L", ",", "f", ",", "g", ",", "h", ",", "x", ",", "y", ",", "z", ",", "a", 
    ",", "b"}], "]"}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"a", "*", 
    RowBox[{"L", "[", "x", "]"}]}], " ", "+", " ", 
   RowBox[{"b", "*", 
    RowBox[{"L", "[", "y", "]"}]}]}], " ", "/.", 
  RowBox[{
   RowBox[{
    RowBox[{"a_", "*", 
     RowBox[{"L", "[", "x_", "]"}]}], " ", "+", " ", 
    RowBox[{"b_", "*", 
     RowBox[{"L", "[", "y_", "]"}]}]}], " ", "\[RuleDelayed]", " ", 
   RowBox[{"L", "[", 
    RowBox[{
     RowBox[{"a", "*", "x"}], " ", "+", " ", 
     RowBox[{"b", "*", "y"}]}], "]"}], "   "}]}]], "Input",
 CellChangeTimes->{{3.3898235329846554`*^9, 3.3898235369106555`*^9}}],

Cell["\<\

Observe that the replacement worked in the above line, but as expected fails \
in the following line:\
\>", "Text",
 CellChangeTimes->{3.5232007068405113`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "*", 
   RowBox[{"L", "[", "x", "]"}]}], " ", "+", " ", 
  RowBox[{"b", "*", 
   RowBox[{"L", "[", "y", "]"}], " "}]}]], "Input"],

Cell["\<\

Observe that the symbol:  L has no assignments:\
\>", "Text",
 CellChangeTimes->{3.5232007183755116`*^9}],

Cell["?? L", "Program"],

Cell["Global`L", "Program",
 CellChangeTimes->{{3.390039219729*^9, 3.390039223258*^9}}],

Cell["\<\
Another example where it is desirable to use one of the arguments of a \
function to assign the \"Delayed Assignments\" rather than the head of the \
function follows.  In this example we want to show formulas, numbers and \
properties corresponding to certain values of the functional arguments.  For \
example, the perimeter of different objects have different formulas.  It \
might be easier to assign the formula for the perimeter to the specific \
object rather then make a list of all perimeter formulas and assign that list \
to the perimeter function.  The advantage of tagging an argument is that it \
simplifies the processed of adding more objects.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Clear", " ", "[", 
  RowBox[{
  "perimeter", ",", " ", "area", ",", " ", "color", ",", " ", "circle", ",", 
   " ", "square", ",", " ", "triangle"}], "]"}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"circle", " ", "/:", " ", 
   RowBox[{"perimeter", " ", "[", 
    RowBox[{"circle", " ", "[", "r_", "]"}], "]"}], ":=", 
   RowBox[{"2", " ", "\[Pi]", " ", "r"}]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"circle", " ", "/:", " ", 
   RowBox[{"area", " ", "[", 
    RowBox[{"circle", " ", "[", "r_", "]"}], "]"}], ":=", 
   RowBox[{"\[Pi]", " ", 
    SuperscriptBox["r", "2"]}]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"circle", " ", "/:", " ", 
   RowBox[{"color", " ", "[", 
    RowBox[{"circle", " ", "[", "r_", "]"}], "]"}], ":=", " ", 
   "\"\<Red\>\""}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"square", " ", "/:", "  ", 
   RowBox[{"perimeter", " ", "[", " ", 
    RowBox[{"square", " ", "[", "x_", "]"}], "]"}], ":=", 
   RowBox[{"4", " ", "x"}]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"square", " ", "/:", " ", 
   RowBox[{"area", " ", "[", " ", 
    RowBox[{"square", "[", "x_", "]"}], "]"}], ":=", 
   SuperscriptBox["x", "2"]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"square", " ", "/:", " ", 
   RowBox[{"color", " ", "[", " ", 
    RowBox[{"square", "[", "x_", "]"}], "]"}], ":=", " ", 
   "\"\<Blue\>\""}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"triangle", " ", "/:", "  ", 
   RowBox[{"area", " ", "[", " ", 
    RowBox[{"triangle", "[", 
     RowBox[{"b_", ",", "h_"}], "]"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", "b", "*", "h"}]}]}]], "InputOnly"],

Cell[BoxData[
 RowBox[{"triangle", " ", "/:", "  ", 
  RowBox[{"color", " ", "[", " ", 
   RowBox[{"triangle", "[", 
    RowBox[{"b_", ",", "h_"}], "]"}], "]"}], ":=", " ", 
  "\"\<Green\>\""}]], "InputOnly"],

Cell["Observe:", "Text"],

