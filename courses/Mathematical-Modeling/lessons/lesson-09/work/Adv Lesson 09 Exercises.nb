Cell["7: A usage message and full holding", "Section",ExpressionUUID->"7a24da0f-9d79-4d5f-ad6e-9830d9a63a5f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
