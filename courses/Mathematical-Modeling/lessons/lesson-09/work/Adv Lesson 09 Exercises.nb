Cell["4: Teaching Integrate about a new function, by tagging", "Section",ExpressionUUID->"9623bdf0-2ed8-461b-a55c-3ca21abae65a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"myFunction", ",", "myFunctionIntegral", ",", "x", ",", "y"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"myFunction", "[", "x_", "]"}], 
    RowBox[{"\[DifferentialD]", "x_"}]}]}], ":=", 
  RowBox[{"myFunctionIntegral", "[", "x", "]"}]}]}], "Input",ExpressionUUID->\
"bd2a0f6e-7b03-40b0-b5c7-efa455779129"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "myFunction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myFunction", "/:", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"myFunction", "[", "x_", "]"}], 
     RowBox[{"\[DifferentialD]", "x_"}]}]}], ":=", 
   RowBox[{"myFunctionIntegral", "[", "x", "]"}]}], ";"}]}], "Input",Expressio\
nUUID->"6990ac44-fefa-493c-a2e4-5f4f59bb2799"],

Cell["??myFunction", "Input",ExpressionUUID->"48db015d-b79a-4859-bebe-e0d333ce9ac5"],

