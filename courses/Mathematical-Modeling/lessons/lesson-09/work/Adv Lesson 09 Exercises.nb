    RowBox[{"x_", "?", "OddQ"}], "]"}], ":=", "\"\<x is odd\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", "\"\<x is even\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "2", "]"}], ":=", "\"\<x = 2\>\""}]}], "Input",ExpressionU\
UID->"d2987872-09be-49a8-9002-e0897e13f0a7"],

