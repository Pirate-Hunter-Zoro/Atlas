    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "2", ",", "3"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "2"}], "]"}], ",", 
   RowBox[{"f", "[", "1", "]"}], ",", 
   RowBox[{"f", "[", "]"}]}], "}"}]], "Input",ExpressionUUID->"50dc6983-3f5a-\
47ed-abd5-301fccd8ec10"],

Cell["2: Definition order - anything, odd, even, and the literal 2", "Section",ExpressionUUID->"ae156ab5-c075-431e-8f67-79b61dd35124"],

