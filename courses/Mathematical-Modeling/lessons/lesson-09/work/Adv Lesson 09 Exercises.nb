Cell["\<\
Advanced Lesson 9 - Exercises: Defaults, Definition Order, Tags and \
Attributes
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"674890ff-6f9a-48c1-8517-1149624bcb58"],

Cell["1: Optional arguments with default values", "Section",ExpressionUUID->"57e6b16c-df9f-4a9a-b56f-1cd4db597795"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", 
    RowBox[{"y_", ":", "10"}], ",", 
    RowBox[{"z_", ":", "20"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]}], "Input",ExpressionUUID->\
"209a5580-915c-4fac-a293-9d2aae9aafd6"],

Cell["?f", "Input",ExpressionUUID->"94dd09c3-2481-4eb0-a772-ad0bc17ce5b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
