Cell["\<\
3: Four tests and a catch-all, and why the order changes the answers\
\>", "Section",ExpressionUUID->"008aff4d-f5c1-4633-9ac0-acc2b3c896a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "i"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "OddQ"}], "]"}], ":=", "\"\< x is odd\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "Positive"}], "]"}], ":=", "\"\< x is positive\>\""}], 
