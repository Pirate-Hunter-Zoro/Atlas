Cell["\<\
Your Name:  Mikey Ferguson

Your Math Class:  MATH 7013 - Advanced Mathematical Modeling\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"32949290-ffa1-4533-98ae-8ccb1159cada"],

Cell["\<\
1:  Define a function:   f( x, y, z ) = {x, y, z}   such that argument:  y  \
has a default value of 10, and argument:  z  has a default value of 20.  \
Evaluate:  f[1,2,3,4],  f[1,2,3],  f[1,2],  f[1], f[ ]\
\>", "Text",ExpressionUUID->"5b35cdab-e92a-4718-857a-bfd248182e97"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", 
    RowBox[{"y_", ":", "10"}], ",", 
    RowBox[{"z_", ":", "20"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]}], "Input",ExpressionUUID->\
"209a5580-915c-4fac-a293-9d2aae9aafd6"],

Cell["?f", "Input",ExpressionUUID->"94dd09c3-2481-4eb0-a772-ad0bc17ce5b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "2", ",", "3"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"1", ",", "2"}], "]"}], ",", 
   RowBox[{"f", "[", "1", "]"}], ",", 
   RowBox[{"f", "[", "]"}]}], "}"}]], "Input",ExpressionUUID->"50dc6983-3f5a-\
47ed-abd5-301fccd8ec10"],

Cell["\<\
2: Make 2 copies of the following code segment by interchanging the second \
and third lines.  Evaluate each of the 2 code segments.  Also display  ?f  \
for each of the 2 code segments.  Observe the differences between the 2 code \
segments (and also differences between how you typed them in and how they are \
stored) and identify which code segment (first, second or both) that would \
work if we want the numbers to be identified as:  even or odd or = 2.
\tf[x_]:=\"x is anything\"
\tf[x_?OddQ]:=\"x is odd\"
\tf[x_?EvenQ]:=\"x is even\"
\tf[2]:=\"x = 2\"
\tTable[{i,f[i]},{i,1,4,1/2}]  // TableForm\
\>", "Text",ExpressionUUID->"520079e5-2115-4844-b2ca-b5717a7625e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "i"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", "\"\<x is anything\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "OddQ"}], "]"}], ":=", "\"\<x is odd\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", "\"\<x is even\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "2", "]"}], ":=", "\"\<x = 2\>\""}]}], "Input",ExpressionU\
UID->"d2987872-09be-49a8-9002-e0897e13f0a7"],

Cell["?f", "Input",ExpressionUUID->"5bdbf9db-9563-421b-9024-739a214af26d"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "4", ",", 
      FractionBox["1", "2"]}], "}"}]}], "]"}], "]"}]], "Input",ExpressionUUID->\
"06233289-8498-4be0-9f3f-dbc7e5e9bd60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "i"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "OddQ"}], "]"}], ":=", "\"\<x is odd\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", "\"\<x is anything\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", "\"\<x is even\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "2", "]"}], ":=", "\"\<x = 2\>\""}]}], "Input",ExpressionU\
UID->"5463e535-31cf-48ea-944b-3dadf19ecc32"],

Cell["?f", "Input",ExpressionUUID->"a5153180-e66f-423a-8dba-1e168795adbd"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "4", ",", 
      FractionBox["1", "2"]}], "}"}]}], "]"}], "]"}]], "Input",ExpressionUUID->\
"c6d750a5-39fa-4cad-acd7-5c6e9cf08ce8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "i"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "2", "]"}], ":=", "\"\<x = 2\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "OddQ"}], "]"}], ":=", "\"\<x is odd\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", "\"\<x is even\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", "\"\<x is anything\>\""}]}], "Input",Ex\
pressionUUID->"bd4e9947-5114-4fea-9433-bc30f9160919"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "4", ",", 
      FractionBox["1", "2"]}], "}"}]}], "]"}], "]"}]], "Input",ExpressionUUID->\
"ccd85e27-2322-4458-9d80-705199cb8ffd"],

Cell["\<\
Both orders give the same result. Mathematica does not store definitions in \
the order they are typed: it puts more specific patterns first, so f[2] moves \
to the top and the catch-all f[x_] to the bottom whichever way they are \
entered. ?f shows the same stored order both times and the two tables are \
identical, reading odd, anything, = 2, anything, odd, anything, even. Both \
segments therefore work for identifying even, odd and 2.\
\>", "Text",ExpressionUUID->"18916f09-881d-41b1-93dc-b156b9434fe1"],

Cell["\<\
3: Make 2 copies of the following code segment by interchanging the second \
and third lines.  Evaluate each of the 2 code segments.  Also display  ?f  \
for each of the 2 code segments.  Observe the differences between the 2 code \
segments (and also differences between how you typed them in and how they are \
stored) and identify why you get different results.
\tf[x_?OddQ]:=\" x is odd\"
\tf[x_?Positive]:=\" x is positive\"
\tf[x_?IntegerQ ]:=\" x is an integer\"
\tf[2]:=\" x = 2\"
\tf[x_]:=\" x is arbitrary\"
\tTable[{i,f[i]},{i,-2,4,1/2}]  // TableForm\
\>", "Text",ExpressionUUID->"83d9655c-bf7d-4005-8439-16ab0f5673d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "i"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "OddQ"}], "]"}], ":=", "\"\< x is odd\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "Positive"}], "]"}], ":=", "\"\< x is positive\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "IntegerQ"}], "]"}], 
   ":=", "\"\< x is an integer\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "2", "]"}], ":=", "\"\< x = 2\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", "\"\< x is arbitrary\>\""}]}], "Input",\
ExpressionUUID->"ece585c8-46b9-4619-b38b-f594a2584164"],

Cell["?f", "Input",ExpressionUUID->"a51d0ba0-b6be-4025-98ff-493806c89715"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"-", "2"}], ",", "4", ",", 
      FractionBox["1", "2"]}], "}"}]}], "]"}], "]"}]], "Input",ExpressionUUID->\
"8262e907-18fc-4b16-87a5-5682222b2d8e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "i"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "OddQ"}], "]"}], ":=", "\"\< x is odd\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "IntegerQ"}], "]"}], 
   ":=", "\"\< x is an integer\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", "?", "Positive"}], "]"}], ":=", "\"\< x is positive\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "2", "]"}], ":=", "\"\< x = 2\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", "\"\< x is arbitrary\>\""}]}], "Input",\
ExpressionUUID->"ae592af4-005d-4bca-a78d-f372b9be071f"],

Cell["?f", "Input",ExpressionUUID->"8723eaeb-8475-4c28-be99-ddddc7a185b6"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"-", "2"}], ",", "4", ",", 
      FractionBox["1", "2"]}], "}"}]}], "]"}], "]"}]], "Input",ExpressionUUID->\
"1759532e-c1e2-408d-a2b3-25229c5bb55a"],

Cell["\<\
Here the order does matter. OddQ, Positive and IntegerQ are all the same \
shape of pattern, so Mathematica cannot rank them and keeps them in the order \
typed. Whichever comes first wins for a value that satisfies more than one \
test. At x = 4 the first version answers positive and the second answers \
integer.\
\>", "Text",ExpressionUUID->"8adc0a3f-18f1-418f-a612-1e011910407e"],

Cell[TextData[{
 "4: Assume that in your research you construct a complicated new function \
called: myFunction [x].  Your work requires repeated integration involving \
your new function.  However, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is unaware of your new function and its corresponding integral.  Therefore \
you integrate your function to get: myFunctionIntegral [x].  You would like \
to assign your new formula to the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command Integrate by:\n\t Integrate [ myFunction[x_], x_ ] := \
myFunctionIntegral [x]\n Part 1: Try this and explain what happens.\n Part 2: \
Tag this assignment to the functional argument:  myFunction\n Part 3: \
Evaluate:    ?? myFunction\n Part 4: Evaluate:    \[Integral] Sin[x] \
\[DifferentialD]x\n Part 5: Evaluate:    \[Integral] myFunction[x] \
\[DifferentialD]x \n Part 6: Evaluate:    \[Integral] myFunction[y] \
\[DifferentialD]y\n Part 7: What is the Head of:  \[Integral] myFunction[x] \
\[DifferentialD]x "
}], "Text",ExpressionUUID->"c4b1d18b-007e-4ce3-8a30-47d4945d1e2f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"myFunction", ",", "myFunctionIntegral", ",", "x", ",", "y"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"myFunction", "[", "x_", "]"}], 
    RowBox[{"\[DifferentialD]", "x_"}]}]}], ":=", 
  RowBox[{"myFunctionIntegral", "[", "x", "]"}]}]}], "Input",ExpressionUUID->\
"bd2a0f6e-7b03-40b0-b5c7-efa455779129"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "myFunction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myFunction", "/:", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"myFunction", "[", "x_", "]"}], 
     RowBox[{"\[DifferentialD]", "x_"}]}]}], ":=", 
   RowBox[{"myFunctionIntegral", "[", "x", "]"}]}], ";"}]}], "Input",Expressio\
nUUID->"6990ac44-fefa-493c-a2e4-5f4f59bb2799"],

Cell["??myFunction", "Input",ExpressionUUID->"48db015d-b79a-4859-bebe-e0d333ce9ac5"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"26950d54-\
dd90-48ff-9152-c68a7dce70dc"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"myFunction", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"4b3d0508-\
3df4-46a3-a550-b76d29a4693b"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"myFunction", "[", "y", "]"}], 
   RowBox[{"\[DifferentialD]", "y"}]}]}]], "Input",ExpressionUUID->"dd918801-\
7385-437f-97c1-2e681bc8d18c"],

Cell[BoxData[
 RowBox[{"Head", "[", 
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"myFunction", "[", "x", "]"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}], "]"}]], "Input",ExpressionUUID->\
"7e14e225-bccc-448a-9074-3c872f3099ca"],

Cell["\<\
Part 1: the direct assignment fails, because Integrate is Protected and \
Mathematica refuses to add a definition to it. Tagging the rule to myFunction \
instead stores it on your own symbol, which is allowed, and ??myFunction \
shows it there. After that the integral of myFunction[x] gives \
myFunctionIntegral[x], and it works for any variable name. Its Head is \
myFunctionIntegral.\
\>", "Text",ExpressionUUID->"dd4e11db-376d-4318-9125-911bf0ad35da"],

Cell["\<\
5: Assume that in your research you construct a complicated new function \
called: myFunction [x, y, z,  ...  ].  The order in which the functional \
arguments appear is irrelevant and the function should always give the same \
value irrespective of the order of the arguments.   
 Part 1: Set your function's attributes to be orderless.
 Part 2: Evaluate:    ?? myFunction
 Part 3: Evaluate:    myFunction[1,2,3]   and   myFunction[3,2,1]
 Part 4: Evaluate:    myFunction[a,b,c,d]   and   myFunction[d,c,b,a]
 Part 5: Evaluate:    myFunction[c,b,a,d] == myFunction[d,c,b,a]\
\>", "Text",ExpressionUUID->"5b6cb4f2-e11c-4e7d-85f6-ea7ef601ac0d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"myFunction", ",", "a", ",", "b", ",", "c", ",", "d"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"myFunction", ",", "Orderless"}], "]"}], ";"}]}], "Input",Expressio\
nUUID->"e96ca788-0c78-45c2-9bb8-5404c96da95e"],

Cell["??myFunction", "Input",ExpressionUUID->"4dc8b663-28dc-41e0-b16d-89e2e50c39df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"myFunction", "[", 
    RowBox[{"1", ",", "2", ",", "3"}], "]"}], ",", 
   RowBox[{"myFunction", "[", 
    RowBox[{"3", ",", "2", ",", "1"}], "]"}]}], "}"}]], "Input",ExpressionUUID\
->"6884a35a-844c-40a7-b7af-e9da155ecc63"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"myFunction", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], ",", 
   RowBox[{"myFunction", "[", 
    RowBox[{"d", ",", "c", ",", "b", ",", "a"}], "]"}]}], "}"}]], "Input",Expr\
essionUUID->"f1559d64-2325-4b62-b342-00a4df5353c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myFunction", "[", 
   RowBox[{"c", ",", "b", ",", "a", ",", "d"}], "]"}], "\[Equal]", 
  RowBox[{"myFunction", "[", 
   RowBox[{"d", ",", "c", ",", "b", ",", "a"}], "]"}]}]], "Input",ExpressionUU\
ID->"831dcb53-571c-4087-9d8f-d936aed963c8"],

Cell["\<\
6: Assume that in your research you construct a complicated new function \
called: myFunction [x, y, z,  ...  ].   When you use your function, the first \
argument \"x\" is expected to contain information which will take on several \
different values while your function is being evaluated.  However, all of the \
remaining arguments:  y, z,  ...   will only be assigned one value each which \
will remain fixed throughout the evaluation of your function.  
 Part 1: Set your function's attributes to hold only the first argument.
 Part 2: Evaluate:    ?? myFunction
 Part 3: Evaluate:    a=1, b=2, c=3, d=4    and   myFunction[a,b,c,d]   \
Explain this result.
 Part 4: Evaluate:    myFunction[a_,b_,c_,d_] := {a, b, c, d}
 Part 5: Evaluate:    ?? myFunction
 Part 6: Evaluate:    a=1, b=2, c=3, d=4,  myFunction[a,b,c,d]   
 Part 7: Explain (i.e. trace) at what point the argument \"a\" was evaluated.\
\
\>", "Text",
 CellChangeTimes->{{3.3904306117130003`*^9, 
  3.390430618551*^9}},ExpressionUUID->"4a4b5423-4622-493a-8676-e607a102a0db"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"myFunction", ",", "a", ",", "b", ",", "c", ",", "d"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"myFunction", ",", "HoldFirst"}], "]"}], ";"}]}], "Input",Expressio\
nUUID->"1409b2b7-a706-4773-ac5c-a3d53aa1ea6a"],

Cell["??myFunction", "Input",ExpressionUUID->"5c7ae7c1-5a3c-499a-a205-eaf99b165c5b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"myFunction", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]}], "Input",ExpressionUUID\
->"9174581d-2b0d-4a80-8041-9fbfd808f1f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myFunction", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}]], "Input",ExpressionUU\
ID->"1740da37-381e-4932-92da-f8d1e47968fb"],

Cell["??myFunction", "Input",ExpressionUUID->"91ad705c-f9f1-4349-9858-796592aed1f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"myFunction", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]}], "Input",ExpressionUUID\
->"4606025d-4a98-4048-bcce-010de13c1c61"],

Cell[BoxData[
 TagBox[
  RowBox[{"Trace", "[", 
   RowBox[{"myFunction", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "]"}],
  HoldForm]], "Input",ExpressionUUID->"1fb801ce-8aa2-4a81-8e55-05e57dad2925"],

Cell["\<\
Part 3: HoldFirst holds only the first argument, so b, c and d evaluate to 2, \
3 and 4 while a stays as the symbol a, giving myFunction[a, 2, 3, 4]. Part 7: \
the trace shows that a is not evaluated until the definition fires and a is \
substituted into the right-hand side, one step after the other three \
arguments have already been replaced by their values.\
\>", "Text",ExpressionUUID->"72a8ea17-c967-4eb8-8224-4b59391d677c"],

Cell["\<\
7: Assume that in your research you construct a complicated new function \
called: myFunction [x, y, z,  ...  ].   It is important to document your \
function so that other users can understand its usage.
 Part 1: Set your function's usage message to:   \"myFunction [x, y, z,  ...  \
] is important to understand.\"
             Set:     myFunction [x_, y_, z_ ] := Sin[x y z]
             Set your function's attributes to hold all of the arguments.
 Part 2: Evaluate:    ? myFunction
 Part 3: Evaluate:    ?? myFunction\
\>", "Text",
 CellChangeTimes->{{3.39043070226*^9, 
  3.3904307317469997`*^9}},ExpressionUUID->"c0fcf309-17d6-49d6-ac22-\
bc55a76e6822"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"myFunction", ",", "x", ",", "y", ",", "z"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   StyleBox[
    RowBox[{"myFunction", "::", "usage"}], "MessageName"], 
   "=", "\"\<myFunction [x, y, z, ... ] is important to understand.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"myFunction", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"Sin", "[", 
    RowBox[{"x", " ", "y", " ", "z"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"myFunction", ",", "HoldAll"}], "]"}], ";"}]}], "Input",ExpressionU\
UID->"07eb05f7-ee5a-4760-96d2-822d589228b5"],

