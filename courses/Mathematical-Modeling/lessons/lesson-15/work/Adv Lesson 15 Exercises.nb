Notebook[{
Cell[TextData[{
 StyleBox[" Exercises:", "Title"],
 "  Advanced Lesson 15 "
}], "Section",ExpressionUUID->"0f0aa8d3-1c4b-48ca-8508-e5f27ec5695f"],

Cell["\<\
Your Name:  Mikey Ferguson

Your Math Class:  MATH 7013 - Advanced Mathematical Modeling\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"ed38065c-daca-4279-a520-0adee9cd36bb"],

Cell["1:  What Is The Current Context?", "Text",ExpressionUUID->"e1269b11-68b0-45b1-b295-2c6e04fdc7d4"],

Cell[BoxData["$Context"], "Input",ExpressionUUID->"ed411e33-6eb7-4804-a422-c4d6fde24a31"],

Cell["2:  What Is The Current Context Path?", "Text",ExpressionUUID->"21ea3920-29a4-4bbe-b54b-9b80f9fcbd56"],

Cell[BoxData["$ContextPath"], "Input",ExpressionUUID->"518b21bc-0046-44e3-b901-0a0048ded00a"],

Cell["\<\
3:  Create a new symbol (with name: \"newSymbol\") in the current context and \
assign it the value:  \"Current\".\
\>", "Text",ExpressionUUID->"2771e5f4-b9c9-4466-93e4-90ab7563d966"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "newSymbol", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newSymbol", "=", "\"\<Current\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Context", "[", "newSymbol", "]"}], ",", "newSymbol"}], 
  "}"}]}], "Input",ExpressionUUID->"ed794800-a358-4de0-98b7-9b388cf36c2a"],

Cell["\<\
4:  Specify a new context (with name: newContext) and create the same symbol \
with a completely different value of: \"New\".\
\>", "Text",ExpressionUUID->"0ff74612-a4a1-4662-a13f-861a1aba5287"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Begin", "[", "\"\<newContext`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newSymbol", "=", "\"\<New\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"End", "[", "]"}]}], "Input",ExpressionUUID->"0d26df69-9643-4cbf-\
8e47-c26860c2c81a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Context", "[", "newSymbol", "]"}], ",", "newSymbol", ",", 
   RowBox[{"NameQ", "[", "\"\<newContext`newSymbol\>\"", "]"}]}], 
  "}"}]], "Input",ExpressionUUID->"ff456e51-c4e3-40fc-9b93-89d0bbffbfb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"newSymbol", "=", "\"\<Current\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newContext`newSymbol", "=", "\"\<New\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"newSymbol", ",", "newContext`newSymbol"}], "}"}]}], "Input",Express\
ionUUID->"9be28f60-9529-4c1b-941d-40b61ad7d70c"],

Cell["5:  Ask for information on \"newSymbol\"  in both contexts", "Text",ExpressionUUID->"790512f0-10c7-4030-bfe1-ab18518b5d7e"],

Cell["?Global`newSymbol", "Input",ExpressionUUID->"1ead2617-aa5c-471f-b142-1b95cfdd6d76"],

Cell["?newContext`newSymbol", "Input",ExpressionUUID->"97a9c130-1f99-420a-bcd0-05695b97b6b1"],

Cell["\<\
6:  Why must you use the Remove command (rather than just the Clear or \
ClearAll commands) on a symbol listed in context Global` if you want to \
access that same symbol in a different context (assume that the default \
context is Global`) ?\
\>", "Text",ExpressionUUID->"04587628-8eb8-4082-9a12-ec3f7e4c50ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "newSymbol", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Context", "[", "newSymbol", "]"}], ",", 
   RowBox[{"ValueQ", "[", "newSymbol", "]"}], ",", 
   RowBox[{"NameQ", "[", "\"\<Global`newSymbol\>\"", "]"}]}], "}"}]}], "Input",\
ExpressionUUID->"bed9a164-4383-4f97-8c8c-59fd30f73b95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Remove", "[", "\"\<Global`newSymbol\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"NameQ", "[", "\"\<Global`newSymbol\>\"", "]"}]}], "Input",Expression\
UUID->"7f212b6b-8c33-4b5b-becd-46f4feefc3dc"],

Cell["\<\
Clear only empties the symbol; the name Global`newSymbol still exists, and \
since Global` comes first on the context path it is still the one found when \
newSymbol is typed. Remove deletes the name itself, so the search moves past \
it and finds the symbol in the other context.\
\>", "Text",ExpressionUUID->"0d8a9377-5657-4a9c-b7fc-196e7c0f7875"]
},
WindowSize->{1100, 850},
FrontEndVersion->"15.0 for Linux x86 (64-bit) (May 26, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"53e1aa67-6381-4be0-aec1-2e1147a12ddd"
]
