Notebook[{
Cell["\<\
Advanced Lesson 15 - Exercises: Contexts
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"8b0a0f10-693f-45f0-ad16-e04e77c54caf"],

Cell["1: What is the current context?", "Section",ExpressionUUID->"b02409e7-c668-4e12-bec9-ed231524f821"],

Cell[BoxData["$Context"], "Input",ExpressionUUID->"ed411e33-6eb7-4804-a422-c4d6fde24a31"],

Cell["2: What is the current context path?", "Section",ExpressionUUID->"ac618b5c-7f95-4b38-8015-92446039e582"],

Cell[BoxData["$ContextPath"], "Input",ExpressionUUID->"518b21bc-0046-44e3-b901-0a0048ded00a"],

Cell["3: A symbol in the current context", "Section",ExpressionUUID->"3504e063-30e4-476a-81b3-40b98b1d6651"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "newSymbol", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newSymbol", "=", "\"\<Current\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Context", "[", "newSymbol", "]"}], ",", "newSymbol"}], 
  "}"}]}], "Input",ExpressionUUID->"ed794800-a358-4de0-98b7-9b388cf36c2a"],

Cell["4: The same short name in a different context", "Section",ExpressionUUID->"f47ead56-752c-47b1-85eb-45f997916f81"],

Cell["\<\
The obvious way to do this is to switch context with Begin, assign, and
switch back with End. Begin does change the current context, and End
restores the previous one and returns the name of the context being left.
But the obvious way does not work here, and it is worth watching it fail
before repairing it - the failure is exactly what Exercise 6 is about.\
\>", "Text",ExpressionUUID->"67b62075-75d4-435f-bdc8-982b5c5056b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Begin", "[", "\"\<newContext`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newSymbol", "=", "\"\<New\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"End", "[", "]"}]}], "Input",ExpressionUUID->"0d26df69-9643-4cbf-\
8e47-c26860c2c81a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Context", "[", "newSymbol", "]"}], ",", "newSymbol", ",", 
   RowBox[{"NameQ", "[", "\"\<newContext`newSymbol\>\"", "]"}]}], 
  "}"}]], "Input",ExpressionUUID->"ff456e51-c4e3-40fc-9b93-89d0bbffbfb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"newSymbol", "=", "\"\<Current\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newContext`newSymbol", "=", "\"\<New\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"newSymbol", ",", "newContext`newSymbol"}], "}"}]}], "Input",Express\
ionUUID->"9be28f60-9529-4c1b-941d-40b61ad7d70c"],

Cell["5: Information on both symbols", "Section",ExpressionUUID->"6b7a7c57-3ea5-49f9-b477-7d903a90f9ef"],

Cell["?Global`newSymbol", "Input",ExpressionUUID->"1ead2617-aa5c-471f-b142-1b95cfdd6d76"],

Cell["?newContext`newSymbol", "Input",ExpressionUUID->"97a9c130-1f99-420a-bcd0-05695b97b6b1"],

Cell["6: Why Remove, and not Clear or ClearAll", "Section",ExpressionUUID->"d0250195-c3e4-4691-ad55-fd17d9e72389"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "newSymbol", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Context", "[", "newSymbol", "]"}], ",", 
   RowBox[{"ValueQ", "[", "newSymbol", "]"}], ",", 
   RowBox[{"NameQ", "[", "\"\<Global`newSymbol\>\"", "]"}]}], "}"}]}], "Input",\
ExpressionUUID->"bed9a164-4383-4f97-8c8c-59fd30f73b95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Remove", "[", "\"\<Global`newSymbol\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"NameQ", "[", "\"\<Global`newSymbol\>\"", "]"}]}], "Input",Expression\
UUID->"7f212b6b-8c33-4b5b-becd-46f4feefc3dc"]
},
WindowSize->{1100, 850},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (May 26, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"53e1aa67-6381-4be0-aec1-2e1147a12ddd"
]
