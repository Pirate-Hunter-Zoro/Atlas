Notebook[{
Cell["\<\
Advanced Lesson 14 - Exercises: Dynamic Interaction, Files and Strings
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"a5a7c6c2-c8d2-4763-9e12-a477edef6204"],

Cell["1: Manipulate - dynamic 2-D and 3-D plots", "Section",ExpressionUUID->"6e44d7e5-1e17-4269-a0cb-af20b5bcc445"],

Cell["\<\
Exercises 1 and 2 repeat Lesson 4's Exercises 14 and 15 verbatim. The cells
below build correctly under a plain kernel, but the sliders are live only
inside a Wolfram front end. Evaluated through Wolfram Engine under Jupyter
they render as a static snapshot at the initial parameter values, so these
cells are left unevaluated here.\
\>", "Text",ExpressionUUID->"344bedc7-bb75-4311-9c86-e1adf3fb1af9"],

Cell["Manipulate[Plot[E^(-a x), {x, 0, 1}], {a, 0, 10}]", "Input",ExpressionUUID->"894c0f23-8fc2-40a3-98fc-6eaad8a89cd1"],

Cell["\<\
Manipulate[Plot[E^(-a x), {x, 0, 1}, PlotRange -> All], {a, 0, 10}]\
\>", "Input",ExpressionUUID->"e1df2de5-c382-461d-ba94-5bc373b35764"],

Cell["\<\
Manipulate[
 Plot3D[E^(-a x - b y), {x, 0, 1}, {y, 0, 1}, PlotRange -> All],
 {a, 0, 10}, {b, 0, 10, 2}]\
\>", "Input",ExpressionUUID->"30adea32-8ad5-4bfe-93ef-7bff0d38ac4f"],

Cell["2: A dynamic algebraic calculator", "Section",ExpressionUUID->"e6b32339-cc3b-49d2-b1e9-c6539b8c380d"],

Cell["Manipulate[Expand[(x + y)^n], {n, 0, 10, 1}]", "Input",ExpressionUUID->"403ef180-aa65-4960-b57b-53b14f35d7f3"],

Cell["3: Writing a list to disk, reading it back", "Section",ExpressionUUID->"753318ea-a1c9-47f3-9b6f-d7ed7fd21505"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"dataList", ",", "myData", ",", "file"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataList", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7"}],
     "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"file", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"$TemporaryDirectory", ",", "\"\<dataList.txt\>\""}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"file", ",", "dataList", ",", "\"\<List\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", "file"}], "Input",ExpressionUUID->"f55b659f-\
02e5-4e9a-822d-936a28364a65"],

Cell[BoxData[
 RowBox[{"FilePrint", "[", "file", "]"}]], "Input",ExpressionUUID->"9dada503-7104-4ec4-ae49-1f98a7a404e3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"myData", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"file", ",", "\"\<List\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "myData"}], "Input",ExpressionUUID->"69d01480-\
df96-4bc8-94a1-9c29baaa4372"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Head", "[", "myData", "]"}], ",", 
   RowBox[{"Length", "[", "myData", "]"}], ",", 
   RowBox[{"myData", "===", "dataList"}]}], "}"}]], "Input",ExpressionUUID->\
"eec87551-6bf1-476b-adce-42fb8b03a7b5"],

Cell["4: Turning text into a list of characters", "Section",ExpressionUUID->"01a46d64-013b-4c55-b706-e902f769314d"],

Cell[BoxData[
 RowBox[{"Characters", "[", "\"\<Mathematica\>\"", "]"}]], "Input",ExpressionU\
UID->"72fb187f-a66d-4cab-a846-b7c9f9b93d5d"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Characters", "[", "\"\<Mathematica\>\"", "]"}], "]"}]], "Input",Exp\
ressionUUID->"02723457-8820-44fd-b65e-a556d3d3ae53"]
},
