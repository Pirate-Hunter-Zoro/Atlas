   3.523361684434661*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"erWords", "=", 
    RowBox[{"DictionaryLookup", "[", "\"\<*er\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"erWords", "//", "Length"}]}], "Input",
 CellChangeTimes->{{3.389936061355*^9, 3.389936087684*^9}}],

Cell[TextData[{
 "\nAnd select from those only the words that when reversed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"StringReverse", "[", "#", "]"}], ")"}], TraditionalForm]]],
 " are also in the Dictionary.\nRemember, we know that the reversed word will \
start with \"re\":\n\n\t\treWords = DictionaryLookup[\"re*\"];\n\t\t\n\t\tIf[\
\n\t\t MemberQ[reWords, StringReverse[#]],\n\t\t {#, StringReverse[#]},\n\t\t \
Null\n\t\t ]\n\t\t \nFinally, take the Union to eliminate repeated \
occurrences of Null, then take the Rest to eliminate the leading Null:"
}], "Text",
 CellChangeTimes->{{3.389934747115*^9, 3.3899348372279997`*^9}, {
   3.389935002041*^9, 3.3899350711280003`*^9}, {3.389935123833*^9, 
   3.389935202273*^9}, {3.389935542854*^9, 3.389935808311*^9}, {
   3.389936029283*^9, 3.3899360470889997`*^9}, 3.5233616990548077`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reWords", "=", 
    RowBox[{"DictionaryLookup", "[", "\"\<re*\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"foundWords", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Union", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Map", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"reWords", ",", 
             RowBox[{"StringReverse", "[", "#", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"StringReverse", "[", "#", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", "Null"}], "\[IndentingNewLine]", "]"}], 
         "&"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "erWords"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "//", "Rest"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"foundWords", "//", "TableForm"}]}], "Input",
 CellChangeTimes->{{3.389933840844*^9, 3.3899339204820004`*^9}, {
