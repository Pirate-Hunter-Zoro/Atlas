Cell["\<\

Read in each record from the file until EndOfFile is reached or after more \
than 100 read attempts:\
\>", "Text",
 CellChangeTimes->{{3.3899098535548*^9, 3.3899099390908003`*^9}, 
   3.5233611029488463`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"allFileData", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nCount", "=", "0"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"While", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"temp", "=", 
     RowBox[{"Read", "[", "stream3", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "temp", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Not]", 
      RowBox[{"(", 
       RowBox[{"EndOfFile", "===", "temp"}], ")"}]}], "\[And]", 
     RowBox[{"nCount", "\[LessEqual]", "100"}]}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nCount", "=", 
     RowBox[{"nCount", "+", "1"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"allFileData", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"allFileData", ",", "temp"}], "]"}]}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.389874971906*^9, 3.3898749728640003`*^9}, {
  3.389875009*^9, 3.389875015494*^9}, {3.389875066921*^9, 3.38987508537*^9}, {
  3.389875129174*^9, 3.389875281227*^9}, {3.389875460598*^9, 
  3.389875466625*^9}, {3.389875540034*^9, 3.3898755417390003`*^9}, {
  3.3899096939428*^9, 3.3899098205268*^9}}],

Cell[BoxData["allFileData"], "Input",
 CellChangeTimes->{{3.3899097173157997`*^9, 3.3899097181198*^9}}],

Cell[TextData[{
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     ButtonBox["Close",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/Close"], "[", 
     StyleBox["stream", "TI"], "]"}], "closes", " ", "a", " ", 
    RowBox[{"stream", "."}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389873377902*^9, 3.389873383862*^9}, {3.389873535877*^9,
    3.389873538583*^9}, {3.389874341802*^9, 3.389874342745*^9}, 
   3.5233611259590764`*^9}],

Cell[BoxData[
 RowBox[{"Close", "[", "stream3", "]"}]], "Input",
 CellChangeTimes->{{3.389873819501*^9, 3.389873819837*^9}, {3.389874347712*^9,
   3.389874349981*^9}, {3.3898753579189997`*^9, 3.389875358079*^9}},
 CellID->479047439]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Importing and Exporting Data Files to and from ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox[":", "Subtitle"]
}], "Section",
 CellChangeTimes->{{3.389875659141*^9, 3.3898757170550003`*^9}, {
   3.389937123424*^9, 3.389937160449*^9}, {3.38993746742*^9, 
   3.3899374968599997`*^9}, 3.3899375295690002`*^9}],

Cell[TextData[{
 "The number of different formats that exist for data files is almost without \
limit.  It seems that each file can have its own special formatting \
difficulties.  The file could have been generated by a almost any commercial \
program, Fortran program, C++ program, spreadsheet or just some ancient file \
that must be analyzed.  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has a number of procedures which will allow almost any file to be entered \
into ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " for subsequent analysis.  \n\n",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      ButtonBox["Import",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Import"], "[", "\"\<\!\(\*
StyleBox[\"file\", \"TI\"]\)\>\"", "]"}]], "InlineFormula"],
    "\[LineSeparator]imports data from a file, returning a complete ",
    StyleBox["Mathematica",
     FontSlant->"Italic"],
    " version of it. "
   }]], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{
  3.389875697016*^9, 3.389875757145*^9, {3.389875851204*^9, 
   3.3898758757200003`*^9}, {3.3899099889968*^9, 3.3899100554628*^9}, {
   3.389937187676*^9, 3.3899372145559998`*^9}, {3.3900460753654003`*^9, 
   3.3900460801014*^9}}],

Cell[BoxData[
 RowBox[{"importData", "=", 
  RowBox[{"Import", "[", "\"\<ExampleData/rose.gif\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.389876168012*^9, 3.3898761688710003`*^9}, {
  3.3898762089960003`*^9, 3.389876212219*^9}}],

Cell[TextData[{
 "\nInside ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", the actual FullForm of the above data is:"
}], "Text",
 CellChangeTimes->{{3.3899100754068003`*^9, 3.3899101098378*^9}, 
   3.523361175689574*^9}],

Cell[BoxData[
 RowBox[{"importData", "//", "FullForm"}]], "Input",
 CellChangeTimes->{{3.389876172139*^9, 3.389876176106*^9}, {3.389876225477*^9,
   3.389876275178*^9}}],

Cell[TextData[{
 "\nWhat files types generated by other programs can you automatically Import \
into ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "? [\nThe currently supported import formats are:"
}], "Text",
 CellChangeTimes->{{3.389876061072*^9, 3.389876067224*^9}, {
  3.3899101424667997`*^9, 3.3899101431258*^9}, {3.3899102747508*^9, 
  3.3899103202438*^9}, {3.389937100008*^9, 3.389937106601*^9}, {
  3.389937374832*^9, 3.389937402528*^9}}],

Cell[BoxData[
 RowBox[{"$ImportFormats", "//", "Column"}]], "Input",
 CellChangeTimes->{{3.389876088592*^9, 3.3898760916280003`*^9}}],

Cell[TextData[{
 "\nWhat files types can you automatically export from ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "?\nThe currently supported export formats are:"
}], "Text",
 CellChangeTimes->{{3.389876061072*^9, 3.389876067224*^9}, {
  3.3899101424667997`*^9, 3.3899101431258*^9}, {3.3899102747508*^9, 
  3.3899103684758*^9}, {3.389937083924*^9, 3.38993708892*^9}}],

Cell[BoxData[
 RowBox[{"$ExportFormats", "//", "ColumnForm"}]], "Input",
 CellChangeTimes->{{3.3899102475768003`*^9, 3.3899102503208*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Manipulating Strings:", "Subtitle"]], "Section"],

Cell["\<\
In addition to dealing with numbers, data often requires the manipulation of \
strings.  A string is a finite sequence of characters.  A string is not a \
list, but commands can convert a string of characters into a list of \
characters.\
\>", "Text"],

Cell[CellGroupData[{

Cell["String is the head of a character string \"text\".", "Item",
 CellChangeTimes->{{3.3900461907714*^9, 3.3900461968834*^9}},
 FontWeight->"Bold"],

Cell["\<\
StringQ[expr] gives True if expr is a string, and False otherwise.\
\>", "Item",
 CellChangeTimes->{{3.3900461936854*^9, 3.3900462010264*^9}},
 FontWeight->"Bold"]
}, Open  ]],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
  "StringQ", "[", "\"\<Example of a string:  x = 123.4\>\"", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"StringQ", "[", "123.4", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"StringQ", "[", "someSymbol", "]"}]}]], "Input"],

Cell[TextData[{
 "\nStrings cause confusion because what is stored internally in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " as a number, list or other expression must be displayed on the computer \
screen as a string of characters.  Thus, the appearance on the computer \
screen gives no clue whether a symbol is a string of characters or has \
another head such as Integer or Real.\n\nIt is simple to convert most \
expressions to a string of characters.  One way is to use the ToString \
command."
}], "Text",
 CellChangeTimes->{{3.3899307885*^9, 3.389930816816*^9}, 
   3.5233612658504753`*^9}],

Cell[CellGroupData[{

Cell["\<\
? \"text\"
String is the head of a character string \"text\".\
\>", "Item",
 CellChangeTimes->{{3.3900461613434*^9, 3.3900461704164*^9}},
 FontWeight->"Bold"],

Cell["\<\
ToString[expr] gives a string corresponding to the printed form of expr in \
OutputForm.
ToString[expr, form] gives the string corresponding to output in the \
specified form.\
\>", "Item",
 CellChangeTimes->{{3.3900461752024*^9, 3.3900461829734*^9}},
 FontWeight->"Bold"]
}, Open  ]],

Cell[BoxData["123.4"], "Input"],

Cell[BoxData[
 RowBox[{"Head", "[", "123.4", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Head", "[", "\"\<123.4\>\"", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToString", "[", "123.4", "]"}], "//", "InputForm"}]], "Input",
 CellChangeTimes->{3.3899170387398*^9}],

Cell[BoxData[
 RowBox[{"Head", "[", "\[IndentingNewLine]", 
  RowBox[{"ToString", "[", "123.4", "]"}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.389930844415*^9, 3.389930850297*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"StringQ", "[", "\[IndentingNewLine]", 
   RowBox[{"ToString", "[", "123.4", "]"}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.389930862389*^9, 3.389930866949*^9}}],

Cell[TextData[{
 "\nAlthough there are many commands available to manipulate strings and \
their contents, a commonly used command for string manipulation is the \
Characters command which converts a string of characters to a list of \
characters.  Once we have a list, then almost any ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command can be used."
}], "Text",
 CellChangeTimes->{3.389930919045*^9, 3.523361317000987*^9}],

Cell["?*String*", "Program"],

Cell["\<\
DisplayString        StringLength
InputString          StringMatchQ
InString             StringPosition
RepeatedString       StringQ
ShowStringCharacters StringReplace
String               StringReplacePart
StringBreak          StringReverse
StringByteCount      StringSkeleton
StringDrop           StringTake
StringForm           StringToStream
StringInsert         ToString
StringJoin           WriteString\
\>", "Program"],

Cell["\<\
Characters[\"string\"] gives a list of the characters in a string.\
\>", "Item",
 CellChangeTimes->{{3.3900461374144*^9, 3.3900461418143997`*^9}},
 FontWeight->"Bold"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
   "Characters", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"ToString", "[", "123.4", "]"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "//", "InputForm"}]}]], "Input",
 CellChangeTimes->{{3.3899167222288*^9, 3.3899167329138002`*^9}, {
  3.389930942531*^9, 3.389930952135*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "Characters", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ToString", "[", "3.14159", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "InputForm"}]], "Input",
 CellChangeTimes->{{3.3899168706298*^9, 3.3899168919298*^9}, {
  3.389930960644*^9, 3.3899309658780003`*^9}}],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"Sort", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
    "Characters", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"ToString", "[", "3.14159", "]"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "//", "InputForm"}]}]], "Input",
 CellChangeTimes->{3.3899169054978*^9, {3.389930971341*^9, 3.38993098192*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "Characters", " ", "[", " ", "\"\<All men are created equal.\>\"", "]"}], "//",
   "InputForm"}]], "Input",
 CellChangeTimes->{3.3899169201138*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Sort", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
    "Characters", " ", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     " ", "\"\<All men are created equal.\>\"", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}], "//", "InputForm"}]}]], "Input",
 CellChangeTimes->{
  3.3899169298887997`*^9, {3.389930999491*^9, 3.389931011612*^9}}],

Cell[CellGroupData[{

Cell["Example: Dictionary Words", "Subsection"],

Cell[TextData[{
 "The following example illustrates the use of character strings. This \
example will read in a dictionary of ordinary words supplied by ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  Also, the following example will illustrate some manipulation of the \
character strings which contain those words.\n\nThe dictionary is supplied by \
",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".\n\n",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      ButtonBox["WordData",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/WordData"], "[", 
      RowBox[{"\"\<\!\(\*
StyleBox[\"word\", \"TI\"]\)\>\"", ",", "\"\<\!\(\*
StyleBox[\"property\", \"TI\"]\)\>\""}], "]"}]], "InlineFormula"],
    " \[LineSeparator]gives the specified property for the English word ",
    Cell[BoxData["\"\<\!\(\*
StyleBox[\"word\", \"TI\"]\)\>\""], "InlineFormula"],
    "."
   }]], TraditionalForm]]],
 "\n\n",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      ButtonBox["DictionaryLookup",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/DictionaryLookup"], "[", 
      StyleBox["patt", "TI"], "]"}]], "InlineFormula"],
    " \[LineSeparator]finds all words in an English dictionary that match the \
string pattern ",
    Cell[BoxData[
     StyleBox["patt", "TI"]], "InlineFormula"],
    ". \ne.g. *math*"
   }]], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3899131036968*^9, 3.3899131439458*^9}, {
  3.3899132495498*^9, 3.3899132543868*^9}, {3.3899133022897997`*^9, 
  3.3899133407418003`*^9}, {3.3899160071168003`*^9, 3.3899160073747997`*^9}, {
  3.3899160649488*^9, 3.3899160776168003`*^9}, {3.389931154546*^9, 
  3.3899311632650003`*^9}, {3.3899312853640003`*^9, 3.389931289572*^9}, {
  3.389936756672*^9, 3.389936757793*^9}, {3.3900462811674*^9, 
  3.3900462976303997`*^9}}],

Cell[BoxData[
 RowBox[{"DictionaryLookup", "[", "\"\<*math*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.3899143297228003`*^9, 3.3899143316647997`*^9}, {
  3.3899164281468*^9, 3.3899164303878*^9}, {3.3899168231518*^9, 
  3.3899168239538*^9}}],

Cell[TextData[{
 "\nNote that character ",
 StyleBox["strings",
  FontVariations->{"Underline"->True}],
 " were actually returned:\t"
}], "Text",
 CellChangeTimes->{{3.3899146896988*^9, 3.3899147575628*^9}, {
   3.3899164545268*^9, 3.3899164552788*^9}, 3.523361387801695*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"DictionaryLookup", "[", "\"\<*math*\>\"", "]"}], "//", 
  "InputForm"}]], "Input",
 CellChangeTimes->{{3.3899164398618*^9, 3.3899164440018*^9}, 
   3.3899167986177998`*^9, 3.3899168341918*^9}],

Cell["\<\

Next, read ALL dictionary words into a list:\
\>", "Text",
 CellChangeTimes->{{3.3899161105538*^9, 3.3899161431638002`*^9}, {
  3.52336140633188*^9, 3.523361424892066*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"dictionaryData", "=", 
   RowBox[{"DictionaryLookup", "[", "\"\<*\>\"", "]"}]}], ";"}]], "InputOnly",
 CellChangeTimes->{{3.3899143879648*^9, 3.3899144251618*^9}},
 CellTags->"T.6"],

Cell[BoxData[
 RowBox[{"dictionaryData", "//", "Length"}]], "Input"],

Cell["\<\

Look at the first few words in the dictionary:\
\>", "Text",
 CellChangeTimes->{3.523361441102228*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Take", "[", 
   RowBox[{"dictionaryData", ",", "40"}], "]"}], "//", "InputForm"}]], "Input",
 CellGroupingRules->"OutputGrouping",
 CellChangeTimes->{{3.3899164725727997`*^9, 3.3899164749208*^9}, 
   3.3899167861088*^9},
 CellTags->"T.6"],

Cell["\<\

Find the position of the character string:   \"word\"   in the list:\
\>", "Text",
 CellChangeTimes->{3.5233614459622765`*^9}],

Cell[BoxData[
 RowBox[{"wordPosition", "=", 
  RowBox[{"Position", "[", 
   RowBox[{"dictionaryData", ",", " ", "\"\<word\>\""}], "]"}]}]], "Input"],

Cell["\<\

Check this position out:\
\>", "Text",
 CellChangeTimes->{3.523361469882516*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"dictionaryData", "[", 
   RowBox[{"[", "   ", 
    RowBox[{"wordPosition", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}], "   ", "]"}], "]"}], "//", 
  "InputForm"}]], "Input",
 CellChangeTimes->{{3.3899164835738*^9, 3.3899164876098003`*^9}, 
   3.3899167769888*^9}],

Cell["\<\

Create a list which contains the length (i.e. number of characters) for each \
character string corresponding to each word in the dictionary data:\
\>", "Text",
 CellChangeTimes->{3.5233614740725574`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"wordLengths", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"StringLength", ",", "dictionaryData"}], "]"}]}], 
  ";"}]], "InputOnly",
 CellTags->"T.6"],

Cell["\<\
Count the number of words corresponding to each word length (i.e. number of \
characters):\
\>", "Text",
 CellChangeTimes->{{3.389933349874*^9, 3.3899333752679996`*^9}}],

Cell[BoxData[
 RowBox[{"plotData", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{"wordLengths", ",", "i"}], "]"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Max", "[", "wordLengths", "]"}]}], "}"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellGroupingRules->"OutputGrouping",
 CellChangeTimes->{{3.389931373086*^9, 3.389931406796*^9}},
 CellTags->"T.6"],

Cell["\<\

Plot the distribution corresponding to the number of letters in the words in \
the dictionary:\
\>", "Text",
 CellChangeTimes->{3.5233615194730115`*^9}],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"plotData", ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"PointSize", "[", "0.02", "]"}]}]}], "]"}]], "Input",
 CellTags->"T.6"],

Cell["\<\

Finally, display all words in this dictionary that have more than 19 \
characters:\
\>", "Text",
 CellChangeTimes->{{3.3899145340928*^9, 3.3899145385448*^9}, 
   3.5233615298731155`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Map", "[", "\[IndentingNewLine]", 
   RowBox[{"InputForm", ",", "\[IndentingNewLine]", 
    RowBox[{"Select", "[", 
     RowBox[{"dictionaryData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"StringLength", "[", "#1", "]"}], ">", "19"}], "&"}]}], 
     "]"}]}], "\[IndentingNewLine]", "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.3899145048008003`*^9, 3.3899145284547997`*^9}, {
   3.3899165069438*^9, 3.3899166101247997`*^9}, 3.3899167651518*^9}],

Cell["\<\

Read the first 20 dictionary words that end in \"ing\" into a list:\
\>", "Text",
 CellChangeTimes->{{3.3899161105538*^9, 3.3899161431638002`*^9}, {
   3.389931532043*^9, 3.389931544791*^9}, {3.389931625406*^9, 
   3.3899316255559998`*^9}, {3.3899316956429996`*^9, 3.389931698921*^9}, {
   3.3899368681099997`*^9, 3.3899368724969997`*^9}, 3.52336155033332*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"dictionaryDataING", "=", 
   RowBox[{"DictionaryLookup", "[", 
    RowBox[{"\"\<*ing\>\"", ",", "20"}], "]"}]}], ";"}]], "InputOnly",
 CellChangeTimes->{{3.3899143879648*^9, 3.3899144251618*^9}, {
  3.389931552514*^9, 3.389931559384*^9}, {3.389931611108*^9, 
  3.3899316124049997`*^9}},
 CellTags->"T.6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Map", "[", 
   RowBox[{"InputForm", ",", "dictionaryDataING"}], "]"}], "//", 
  "Column"}]], "Input",
 CellChangeTimes->{{3.389931647908*^9, 3.389931680565*^9}}],

Cell[TextData[{
 "\nDrop the \"ing\"\n\t",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      ButtonBox["StringDrop",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/StringDrop"], "[", 
      RowBox[{"\"\<\!\(\*
StyleBox[\"string\", \"TI\"]\)\>\"", ",", 
       StyleBox["n", "TI"]}], "]"}]], "InlineFormula"],
    "\[LineSeparator]gives ",
    Cell[BoxData["\"\<\!\(\*
StyleBox[\"string\", \"TI\"]\)\>\""], "InlineFormula"],
    " with its first ",
    Cell[BoxData[
     StyleBox["n", "TI"]], "InlineFormula"],
    " characters dropped. "
   }]], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      ButtonBox["StringDrop",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/StringDrop"], "[", 
      RowBox[{"\"\<\!\(\*
StyleBox[\"string\", \"TI\"]\)\>\"", ",", 
       RowBox[{"-", 
        StyleBox["n", "TI"]}]}], "]"}]], "InlineFormula"],
    "\[LineSeparator]gives ",
    Cell[BoxData["\"\<\!\(\*
StyleBox[\"string\", \"TI\"]\)\>\""], "InlineFormula"],
    " with its last ",
    Cell[BoxData[
     StyleBox["n", "TI"]], "InlineFormula"],
    " characters dropped. "
   }]], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389931791093*^9, 3.3899318623929996`*^9}, {
   3.3899319019379997`*^9, 3.389931929711*^9}, {3.3900463332474003`*^9, 
   3.3900463690824003`*^9}, 3.5233615818036346`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "dictionaryDataING2", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Map", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"StringDrop", "[", 
        RowBox[{"#", ",", 
         RowBox[{"-", "3"}]}], "]"}], "&"}], ",", "\[IndentingNewLine]", 
      "dictionaryDataING"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Map", "[", 
   RowBox[{"InputForm", ",", "dictionaryDataING2"}], "]"}], "//", 
  "Column"}]}], "Input",
 CellChangeTimes->{{3.389931939791*^9, 3.3899320549309998`*^9}, {
  3.389932090936*^9, 3.3899320966470003`*^9}}],

Cell["\<\

Select only the words that are in the Dictionary:\
\>", "Text",
 CellChangeTimes->{{3.389932488362*^9, 3.389932489712*^9}, {3.389932521186*^9,
    3.389932550066*^9}, 3.523361606223879*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "dictionaryDataING3", "=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Select", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
     "dictionaryDataING2", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"dictionaryData", ",", "#"}], "]"}], "&"}]}], 
