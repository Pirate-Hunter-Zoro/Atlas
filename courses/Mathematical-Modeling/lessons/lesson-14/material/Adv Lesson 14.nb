     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"StringDrop", "[", 
          RowBox[{"#", ",", 
           RowBox[{"-", "1"}]}], "]"}], "<>", "\"\<ing\>\""}], ")"}], "&"}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
