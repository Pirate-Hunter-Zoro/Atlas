     RowBox[{
     "dictionaryDataING5", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"dictionaryData", ",", "#"}], "]"}], "&"}]}], 
