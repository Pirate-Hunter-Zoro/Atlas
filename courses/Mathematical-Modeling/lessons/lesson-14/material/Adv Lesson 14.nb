   3.3896491966608*^9}, {3.3896497690248003`*^9, 3.3896497695278*^9}, {
   3.3896498341898003`*^9, 3.3896498533788*^9}, {3.3896498839178*^9, 
   3.3896501225538*^9}, {3.3896501544608*^9, 3.3896502521848*^9}, {
   3.3896503196977997`*^9, 3.3896504032448*^9}, {3.3896504372497997`*^9, 
   3.3896504421478*^9}, {3.3896505820788*^9, 3.3896507848677998`*^9}, {
   3.3896508470558*^9, 3.3896509141678*^9}, {3.3896509948278*^9, 
   3.3896510331758003`*^9}, {3.3896511850917997`*^9, 
   3.3896511865797997`*^9}, {3.3896513149138002`*^9, 3.3896513232008*^9}, {
   3.3896513536878*^9, 3.3896513809348*^9}, {3.3896517889618*^9, 
   3.3896521319868*^9}, {3.3896521797868*^9, 3.3896522729068003`*^9}, {
   3.3896523728758*^9, 3.3896523758928003`*^9}, {3.3896524314358*^9, 
   3.3896524871548*^9}, {3.3896539285518*^9, 3.3896539650768003`*^9}, {
   3.3896539983458*^9, 3.3896540637648*^9}, {3.3896541287318*^9, 
   3.3896542333227997`*^9}, {3.3896542963487997`*^9, 3.3896542980968*^9}, {
   3.3896543342948*^9, 3.3896543611438*^9}, {3.3896544106048*^9, 
   3.3896544271088*^9}}],

Cell[TextData[{
 "However, if there are ",
 StyleBox["additional",
  FontVariations->{"Underline"->True}],
 " Dynamic expressions in the remaining arguments to be used as Dynamic \
annotations, then you will need to program Dynamic[...] explicitly.\n\nThe \
output display generated by Manipulate[...] always contains ",
 StyleBox["two",
  FontVariations->{"Underline"->True}],
 " areas:\n\n\tPrimary area for the Dynamic expression and\n\tControls area.\n\
\t\nBy default the Output Cell generated from Manipulate[...] has the \
controls area is displayed on top and the primary area for the Dynamic \
expression displayed on the bottom. You can, of course, change this if you \
want.\n\nFor example:\n\n\t",
 StyleBox["Manipulate[\n\t\n\tPlot[a x + b, {x, 0, 2Pi}],  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " displayed in the primary expression area",
 StyleBox["\n\t\n\t{a, 0, 2} ,       ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] continuous Slider control of ",
 StyleBox["a",
  FontSlant->"Italic"],
 " from 0 to 2 displayed in the controls area",
 StyleBox["\n\tDynamic[ ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["expr2",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ] ,  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " you want to control displayed in the controls area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] other annotation to be displayed in the controls \
area",
 StyleBox["\n\t{b, 1, 5, 1} ,   ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] discrete Slider control of ",
 StyleBox["b",
  FontSlant->"Italic"],
 " from 1 to 5 in steps of 1 displayed in the controls area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] other annotation to be displayed in the controls \
area",
 StyleBox["\n\tDynamic[ ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["expr3",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ] ,  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " you want to control displayed in the controls area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] other annotation to be displayed in the controls \
area",
 StyleBox["\n\t{u,  ...  } ,       ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] control of ",
 StyleBox["u",
  FontSlant->"Italic"],
 " displayed in the controls area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] other annotation to be displayed in the controls \
area",
 StyleBox["\n\t... ,                 ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " you want to control displayed in the controls area",
 StyleBox["\n\t...                   ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] more controls displayed in the controls area ",
 StyleBox["\n\t ]",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\n\nhas a primary display area and many different controls and annotations \
in the controls area."
}], "Text",
 CellChangeTimes->{{3.389600685666*^9, 3.3896006894639997`*^9}, {
   3.389600854349*^9, 3.389600862738*^9}, 3.389600927474*^9, {
