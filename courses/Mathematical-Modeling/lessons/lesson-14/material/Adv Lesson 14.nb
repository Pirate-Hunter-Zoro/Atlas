Cell["\<\

Next, create a new list of data:\
\>", "Text",
 CellChangeTimes->{{3.3899094879938*^9, 3.3899095096778*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", " ", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"newDataList", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e"}], "}"}]}], 
   ";"}]}]}], "InputOnly",
 CellChangeTimes->{{3.389874373998*^9, 3.3898743902980003`*^9}, 
   3.389874442666*^9, {3.3899095771228*^9, 3.3899095772988*^9}}],

