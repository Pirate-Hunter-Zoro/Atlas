  3.389932945282*^9, 3.3899329826619997`*^9}}],

Cell["\<\

Select the remaining words that are NOT in the Dictionary and drop the \"e\" \
and join back the \"ing\":\
\>", "Text",
 CellChangeTimes->{{3.389932488362*^9, 3.389932489712*^9}, {3.389932521186*^9,
    3.389932586697*^9}, {3.389933190928*^9, 3.3899332197279997`*^9}, 
   3.5233616602544193`*^9}],

