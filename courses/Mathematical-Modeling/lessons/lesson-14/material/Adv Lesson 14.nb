Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \nAdvanced Lesson 14\n\n",
 "Manipulate[...]",
 "\nImporting and Exporting Data",
 StyleBox["\n",
  FontSlant->"Italic"],
 "Manipulating Character Strings\n\nDr. Dale R. Doty\nUniversity of Tulsa"
}], "Title",
 CellChangeTimes->{{3.3899392257650003`*^9, 3.389939235523*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Getting Input From The User:", "Subtitle"]], \
"Section"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 8.0 has vastly improved procedures for allowing a user to communicate with \
a program.  However, at this time, I will present only a simple procedure \
allowing a program to prompt a user for specific input information."
}], "Text",
 CellChangeTimes->{{3.389872112227*^9, 3.38987211535*^9}, {
   3.3899093016568003`*^9, 3.3899093032548*^9}, 3.52336055527337*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
     Manipulate:  The Dynamic Function Used 95 % of the Time!\
\>", "Section",
 CellChangeTimes->{{3.3899379643380003`*^9, 3.389937971047*^9}, {
  3.389938789211*^9, 3.389938789392*^9}, {3.390474166474*^9, 
  3.3904741707860003`*^9}}],

Cell[TextData[Cell[BoxData[GridBox[{
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["min", "TI"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["max", "TI"]]}], "}"}]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]generates a version of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula"],
     " with controls added to allow interactive \nmanipulation of the value \
of ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["min", "TI"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["max", "TI"]], ",", 
          StyleBox["du", "TI"]}], "}"}]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]allows the value of ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     " to vary between ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["min", "TI"]]], "InlineFormula"],
     " and ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["max", "TI"]]], "InlineFormula"],
     " in steps ",
     Cell[BoxData[
      StyleBox["du", "TI"]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            StyleBox["u", "TI"], ",", 
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["init", "TI"]]}], "}"}], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["min", "TI"]], ",", 
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["max", "TI"]], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]takes the initial value of ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     " to be ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["init", "TI"]]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            StyleBox["u", "TI"], ",", 
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["init", "TI"]], ",", 
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["lbl", "TI"]]}], "}"}], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]labels the controls for ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     " with ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["lbl", "TI"]]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["1", "TR"]], ",", 
            SubscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["2", "TR"]], ",", 
            StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "}"}]}], "]"}]], 
      "InlineFormula"],
     "\[LineSeparator]allows ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula"],
     " to take on discrete values ",
     Cell[BoxData[
      RowBox[{
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["\[Ellipsis]", "TR"]}]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["u", "TI"], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["v", "TI"], ",", 
          StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]provides controls to manipulate each of the ",
     Cell[BoxData[
      RowBox[{
       StyleBox["u", "TI"], ",", 
       StyleBox["v", "TI"], ",", 
       StyleBox["\[Ellipsis]", "TR"]}]], "InlineFormula"],
     ". \n"
    }]]},
   {Cell[TextData[{
     Cell[BoxData[
      RowBox[{
       ButtonBox["Manipulate",
        BaseStyle->"Link",
        ButtonData->"paclet:ref/Manipulate"], "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        RowBox[{"\"\<\!\(\*SubscriptBox[
StyleBox[\"c\", \"TI\"], 
StyleBox[\"u\", \"TI\"]]\)\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           StyleBox["u", "TI"], ",", 
           StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], ",", 
        RowBox[{"\"\<\!\(\*SubscriptBox[
StyleBox[\"c\", \"TI\"], 
StyleBox[\"v\", \"TI\"]]\)\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           StyleBox["v", "TI"], ",", 
           StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], ",", 
        StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"],
     "\[LineSeparator]links the controls to the specified controllers on an \
external device."
    }]]}
  }]],
 GridBoxOptions->{
 GridBoxBackground->{
  "Columns" -> {{None}}, "ColumnsIndexed" -> {}, 
   "Rows" -> {None, None, None, None, None, None, {None}}, 
   "RowsIndexed" -> {}}}]], "Text",
 CellChangeTimes->{{3.3895173469982*^9, 3.3895173926672*^9}, {
  3.3895174650072002`*^9, 3.3895175269462*^9}, {3.3900456954764*^9, 
  3.3900457268943996`*^9}},
 TextJustification->1.]
}, Closed]],

Cell[CellGroupData[{

Cell["     Introduction to Manipulate[...]", "Section",
 CellChangeTimes->{{3.38959970931*^9, 3.389599731852*^9}, {3.389939305712*^9, 
  3.389939310461*^9}}],

Cell[TextData[{
 "The single command ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " lets you create an astonishing range of interactive applications with just \
a few lines of input. ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " is designed to be used by anyone who is comfortable using basic commands \
such as ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 " and ",
 Cell[BoxData[
  ButtonBox["Plot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Plot"]], "InlineFormula"],
 ": it does not require learning any complicated new concepts, nor any \
understanding of user interface programing ideas.\n\nThe output you get from \
evaluating a ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " command is an interactive object containing one or more controls (sliders, \
etc.) that you can use to vary the value of one or more parameters. The \
output is very much like a small applet or widget: it is not just a static \
result, it is a running program you can interact with.\n\nAt its most basic, \
the syntax of ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " is identical to that of the humble function ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 ". \n\nConsider this ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 " command, which produces a list of numbers from 1 to 20 in steps of 1."
}], "Text",
 CellChangeTimes->{{3.389599654104*^9, 3.389599658648*^9}, {3.389599817123*^9,
   3.389599828992*^9}, {3.389606698573*^9, 3.3896067102799997`*^9}}],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{"n", ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "20", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.389599948332*^9, 3.389599949031*^9}}],

Cell[TextData[{
 "\nSimply replace the word ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 " with the word ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 ", and you get an interactive application that lets you explore values of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula"],
 " from 1 to 20 in steps of 1 with a slider."
}], "Text",
 CellChangeTimes->{{3.3896489290028*^9, 3.3896489381638002`*^9}, 
   3.5233605977137938`*^9}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{"n", ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "20", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.389599933547*^9, 3.389599934394*^9}}],

Cell[TextData[{
 "\nOf course the whole point of ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " (and ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula"],
 " for that matter) is that you can put any expression you like in the first \
argument, not just a simple variable name. \n\nOne way to think of ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " is as a way to interactively explore a large parameter space. You can move \
around that space at will, exploring interesting directions as they appear. \n\
\n",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " supports a wide range of alternate ways of specifying variables, which \
generate different kinds of controls for those variables. These dynamic \
controls include checkboxes, popup menus, and others in addition to sliders. \
\n\nThe principle is that for each Dynamic variable, ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]]],
 ", you ask for a particular set of possible values for the variable ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]]],
 " (like from 1 to 20 in steps of 1 e.g. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"u", ",", "1", ",", "20", ",", "1"}], "}"}], TraditionalForm]]],
 ") and ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " ",
 StyleBox["automatically chooses",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 " an appropriate type of control to make those values conveniently \
available.\n\n\t",
 StyleBox["Possible Values:\t\t\tManipulate Automatically Chooses an \
Appropriate Type of Control:",
  FontVariations->{"Underline"->True}],
 "\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["min", "TI"]], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["max", "TI"]]}], "}"}], " "}
    }], TraditionalForm]]],
 "\t\t\tcontinuous manipulator (slider, animator, etc.)\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      RowBox[{"{", 
       RowBox[{
        StyleBox["u", "TI"], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["min", "TI"]], ",", 
        SubscriptBox[
         StyleBox["u", "TI"], 
         StyleBox["max", "TI"]], ",", 
        StyleBox["du", "TI"]}], "}"}], "   "}
    }], TraditionalForm]]],
 "\t\t\t",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    "discrete manipulator with step ",
    Cell[BoxData[
     StyleBox["du", "TI"]], "InlineFormula"]
   }], "TableText"], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["min", "TI"]], ",", 
       SubscriptBox[
        StyleBox["y", "TI"], 
        StyleBox["min", "TI"]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["max", "TI"]], ",", 
       SubscriptBox[
        StyleBox["y", "TI"], 
        StyleBox["max", "TI"]]}], "}"}]}], "}"}], TraditionalForm]]],
 "\t\t2D slider\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     ButtonBox["Locator",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/Locator"]}], "}"}], TraditionalForm]]],
 "\t\t\t\t",
 Cell[BoxData[
  FormBox[Cell["a locator in a graphic", "TableText"], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "}"}], TraditionalForm]]],
 "\t\t\tsetter bar for few elements; popup menu for more\n\tetc.\t\t\t\t\t\
etc.\n\tetc.\t\t\t\t\tetc."
}], "Text",
 CellChangeTimes->{{3.389600685666*^9, 3.3896006894639997`*^9}, {
   3.389600854349*^9, 3.389600862738*^9}, 3.389600927474*^9, {
   3.389601646949*^9, 3.389601689881*^9}, {3.3896017394449997`*^9, 
   3.389601764225*^9}, {3.389601869466*^9, 3.389601874315*^9}, {
   3.389601915804*^9, 3.389601962358*^9}, {3.3896020021689997`*^9, 
   3.3896021412679996`*^9}, {3.389602208443*^9, 3.389602232866*^9}, 
   3.38960264229*^9, {3.38960270829*^9, 3.389603042901*^9}, {
   3.389603073834*^9, 3.3896030881610003`*^9}, {3.389603136459*^9, 
   3.38960324492*^9}, {3.3896032845109997`*^9, 3.389603300608*^9}, {
   3.389603338145*^9, 3.3896036534630003`*^9}, {3.389603693741*^9, 
   3.389604144969*^9}, {3.389604298329*^9, 3.389604298783*^9}, {
   3.389606282413*^9, 3.3896063206809998`*^9}, {3.389606363446*^9, 
   3.389606489584*^9}, {3.389606548132*^9, 3.389606592023*^9}, {
   3.3896068510559998`*^9, 3.389606898575*^9}, {3.389606933449*^9, 
   3.389607130667*^9}, {3.3896072082279997`*^9, 3.389607219101*^9}, {
   3.389607253432*^9, 3.389607261468*^9}, {3.3896086027980003`*^9, 
   3.389608608258*^9}, {3.3896489883378*^9, 3.3896490096818*^9}, {
   3.3896490660778*^9, 3.3896491141338*^9}, {3.3896491461238003`*^9, 
   3.3896491966608*^9}, {3.3896497690248003`*^9, 3.3896497695278*^9}, {
   3.3896498341898003`*^9, 3.3896498533788*^9}, {3.3896498839178*^9, 
   3.3896501225538*^9}, {3.3896501544608*^9, 3.3896502521848*^9}, {
   3.3896503196977997`*^9, 3.3896504032448*^9}, {3.3896504372497997`*^9, 
   3.3896504421478*^9}, {3.3896505820788*^9, 3.3896507848677998`*^9}, {
   3.3896508470558*^9, 3.3896509141678*^9}, {3.3896509948278*^9, 
   3.3896510331758003`*^9}, {3.3896511850917997`*^9, 
   3.3896511865797997`*^9}, {3.3896513149138002`*^9, 3.3896513232008*^9}, {
   3.3896513536878*^9, 3.3896513809348*^9}, {3.3896517889618*^9, 
   3.3896521319868*^9}, {3.3896521797868*^9, 3.3896522729068003`*^9}, {
   3.3896523728758*^9, 3.3896523758928003`*^9}, {3.3896524314358*^9, 
   3.3896524871548*^9}, {3.3896539285518*^9, 3.3896539650768003`*^9}, {
   3.3896539983458*^9, 3.3896540637648*^9}, {3.3896541287318*^9, 
   3.3896542333227997`*^9}, {3.3896542963487997`*^9, 3.3896542980968*^9}, {
   3.3896543342948*^9, 3.3896543611438*^9}, 3.3896544106048*^9, 
   3.523360599803815*^9}],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " automatically wraps its ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox["argument",
  FontVariations->{"Underline"->True}],
 " in ",
 Cell[BoxData[
  ButtonBox["Dynamic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Dynamic"]], "InlineFormula"],
 " and passes the value of its ",
 Cell[BoxData[
  ButtonBox["TrackedSymbols",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TrackedSymbols"]], "InlineFormula"],
 " option to a ",
 Cell[BoxData[
  ButtonBox["Refresh",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Refresh"]], "InlineFormula"],
 " inside that. Everything to do with updating is handled by that ",
 Cell[BoxData[
  ButtonBox["Dynamic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Dynamic"]], "InlineFormula"],
 " and ",
 Cell[BoxData[
  ButtonBox["Refresh",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Refresh"]], "InlineFormula"],
 ".\t \n\nA direct result for you is this: \n\tIf Manipulate[...]'s first \
argument is the ONLY Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " that you need to display and \n\tALL remaining arguments contain only \
Possible Values for controls (and annotations like \" ... ",
 StyleBox["text",
  FontSlant->"Italic"],
 " ... \")\n\t(as illustrated in the following example with one ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " and two controls and no annotations):\n\n\t",
 StyleBox["Manipulate[\n\t\n\t  Plot[a x + b, {x, 0, 2Pi}]",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[",  ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] Dynamic ",
 StyleBox["expr",
  FontSlant->"Italic"],
 "[",
 StyleBox["a, b",
  FontSlant->"Italic"],
 "] you want to control",
 StyleBox["  ",
  FontSlant->"Italic"],
 StyleBox["\n \t\n\t  {a, 0, 2} ,   ",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[DoubleLongLeftArrow] continuous Slider control of ",
 StyleBox["a",
  FontSlant->"Italic"],
 " from 0 to 2\n\n",
 StyleBox["\t  {b, 1, 5, 1}",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\t\[DoubleLongLeftArrow] discrete Slider control of ",
 StyleBox["b",
  FontSlant->"Italic"],
 " from 1 to 5 in steps of 1",
 StyleBox["\n\n\t]",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\n\n\tthen ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 " ",
 StyleBox["automatically handles ALL Dynamic issues",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 " and \n\tyou do NOT need to explicitly code a single Dynamic[...] \
expression yourself!"
}], "Text",
 CellChangeTimes->{{3.389600685666*^9, 3.3896006894639997`*^9}, {
   3.389600854349*^9, 3.389600862738*^9}, 3.389600927474*^9, {
