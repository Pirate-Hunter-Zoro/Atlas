Cell["\<\
Your Name:

Your Math Class:\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.3903880065649595`*^9},
 FontSize->16,
 FontWeight->"Bold"],

Cell[TextData[{
 "1: Using Manipulate[ ... ]:\n\nPart1: Create a dynamic 2-D plot of:\n\n\t",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "a"}], " ", "x"}]], TraditionalForm]]],
 "  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "1", " "}], 
   TraditionalForm]]],
 "\n\tWith a ",
 StyleBox["continuous",
  FontVariations->{"Underline"->True}],
 " slider for  a  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "a", "\[LessEqual]", "10"}], 
   TraditionalForm]]],
 "\n\t\nPart2: Note that the plot jumps around as you move the slider.  Add a \
PlotRange option to your plot to fix this problem.\n\nPart: Create a dynamic \
3-D plot of:\n\n\t",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], " ", "x"}], "-", 
     RowBox[{"b", " ", "y"}]}]], TraditionalForm]]],
 "  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "1", " "}], 
   TraditionalForm]]],
 " and  0 \[LessEqual] y \[LessEqual] 1 \n\tWith a ",
 StyleBox["continuous",
  FontVariations->{"Underline"->True}],
 " slider for  a  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "a", "\[LessEqual]", "10"}], 
   TraditionalForm]]],
 "\n\tWith a ",
 StyleBox["discrete",
  FontVariations->{"Underline"->True}],
 " slider for  b  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "b", "\[LessEqual]", "10"}], 
   TraditionalForm]]],
 "  in steps of 2"
}], "Text",
 CellChangeTimes->{{3.39038661270596*^9, 3.39038666806696*^9}, {
   3.39038687211796*^9, 3.3903869916539598`*^9}, {3.39038703139196*^9, 
   3.3903870853149595`*^9}, {3.39038756030496*^9, 3.39038758131696*^9}, {
   3.39038763079796*^9, 3.3903876330299597`*^9}, 3.3903914264769597`*^9, 
   3.390474447683*^9}],

Cell[TextData[{
 "2: Using Manipulate[ ... ]:\n\n      Create a dynamic algebraic calculator \
that expands the expression:\n\n\t",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "y"}], ")"}], "n"], TraditionalForm]]],
 "  \n\t\n      With a ",
 StyleBox["discrete",
  FontVariations->{"Underline"->True}],
 " slider for  n  where  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "n", "\[LessEqual]", "10"}], 
   TraditionalForm]]],
 "  in steps of 1"
}], "Text",
 CellChangeTimes->{{3.39038661270596*^9, 3.39038666806696*^9}, {
  3.39038687211796*^9, 3.3903869916539598`*^9}, {3.39038703139196*^9, 
