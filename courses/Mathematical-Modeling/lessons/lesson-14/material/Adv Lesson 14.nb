Cell[TextData[{
 "In the above example, it is fun to watch how one shape turns into another, \
and in this connection it is good to know about an unusual feature of sliders \
in Mathematica. If you hold down the Option key (Macintosh) or Alt key \
(Windows), the action of the slider will be slowed down by a factor of 20 \
relative to the movements of the mouse. In other words, when you drag the \
mouse left and right, the thumb will move only 1/20",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Null]", "th"], TraditionalForm]]],
 " as much as it normally would. If you move outside the area of the slider, \
the value will start moving slowly in that direction as long as the mouse \
remains clicked."
}], "Text",
 CellChangeTimes->{{3.38960134616*^9, 3.389601366288*^9}}],

Cell[TextData[{
 " \n",
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\n\n\tDynamically Manipulate the initial conditions with 2 Sliders to \
Dynamically solve a two point boundary value problem:"
}], "Text",
 CellChangeTimes->{{3.3895989726359997`*^9, 3.38959908871*^9}, {
  3.389599173652*^9, 3.3895992078389997`*^9}, {3.3896563310738*^9, 
  3.3896563345628*^9}}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"y", "[", "t", "]"}], "/.", 
       RowBox[{"First", "[", 
        RowBox[{"NDSolve", "[", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"y", "''"}], "[", "x", "]"}], "\[Equal]", 
             RowBox[{
              RowBox[{"-", "x"}], " ", 
              RowBox[{"y", "[", "x", "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"y", "[", "0", "]"}], "\[Equal]", "a"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"y", "'"}], "[", "0", "]"}], "\[Equal]", "b"}]}], "}"}],
           ",", "y", ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}]}], "]"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Epilog", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"PointSize", "[", ".02", "]"}], ",", 
          RowBox[{"Point", "[", 
           RowBox[{"{", 
            RowBox[{"4", ",", 
             RowBox[{"1", "/", "2"}]}], "}"}], "]"}], ",", 
          RowBox[{"Point", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "a"}], "}"}], "]"}]}], "}"}], ",", "Green", ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "a"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"b", "+", "a"}]}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"ImagePadding", "\[Rule]", "25"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", "3"}]}], "\[IndentingNewLine]", "]"}], 
   ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"y", "[", "0", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", 
       RowBox[{"-", "2"}], ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{
         RowBox[{"y", "'"}], "[", "0", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389598888604*^9, 3.389598956148*^9}, {
  3.3896563912788*^9, 3.3896564565148*^9}, {3.3896564928898*^9, 
  3.3896565107658*^9}, {3.3896566821808*^9, 3.3896567107508*^9}},
 CellID->163974066],

Cell[TextData[{
 "\n",
 StyleBox["Example:",
  FontSize->14,
  FontWeight->"Bold",
  FontColor->RGBColor[0.5, 0, 0.5]],
 "\n\n\tCustom Control Appearances\n\nSuppose you want to use a type of \
control that is not supported by ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 ", for example one you have built yourself using graphics and dynamics. Here \
is a block of code that defines a custom style of slider, one that shows its \
value at the thumb position."
}], "Text",
 CellChangeTimes->{{3.389609035808*^9, 3.38960903625*^9}, {3.389609342751*^9, 
   3.389609350988*^9}, 3.389609391708*^9, 3.38961048804*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ValueThumbSlider", "[", "v_", "]"}], ":=", 
    RowBox[{"ValueThumbSlider", "[", 
     RowBox[{"v", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ValueThumbSlider", "[", 
     RowBox[{
      RowBox[{"Dynamic", "[", "var_", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"min_", ",", "max_"}], "}"}], ",", "options___"}], "]"}], ":=",
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"LocatorPane", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Dynamic", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"NumberQ", "[", "var", "]"}]}], ",", 
           RowBox[{"var", "=", "min"}]}], "]"}], ";", 
         RowBox[{"{", 
          RowBox[{"var", ",", "0"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"var", "=", 
           RowBox[{"First", "[", "#", "]"}]}], ")"}], "&"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsoluteThickness", "[", "1.5", "]"}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"min", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"max", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Dynamic", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{"var", ",", 
               RowBox[{"{", 
                RowBox[{"var", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", 
                 RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Offset", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"-", "1"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"var", ",", "0"}], "}"}]}], "]"}], ",", 
                RowBox[{"Offset", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "5"}], ",", 
                    RowBox[{"-", "8"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"var", ",", "0"}], "}"}]}], "]"}], ",", 
                RowBox[{"Offset", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"5", ",", 
                    RowBox[{"-", "8"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"var", ",", "0"}], "}"}]}], "]"}]}], "}"}], 
              "]"}]}], "}"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"ImageSize", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"300", ",", "30"}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"min", ",", "max"}], "}"}], "+", 
            RowBox[{"0.1", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], 
             RowBox[{"(", 
              RowBox[{"max", "-", "min"}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"AspectRatio", "\[Rule]", 
         RowBox[{"1", "/", "10"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"min", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"max", ",", "0"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Appearance", "\[Rule]", "None"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xx", "=", "3.0"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ValueThumbSlider", "[", 
  RowBox[{
   RowBox[{"Dynamic", "[", "xx", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "10"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.38960904946*^9, 3.389609254072*^9}}],

Cell[TextData[{
 "\nTo use a custom control in ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 ", you include a pure function that is used to generate the control object \
as part of the variable specification. As long as your function conforms to \
the convention used by all the built-in control functions, with the variable \
(inside ",
 Cell[BoxData[
  ButtonBox["Dynamic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Dynamic"]], "InlineFormula"],
 ") as the ",
 StyleBox["first",
  FontVariations->{"Underline"->True}],
 " argument and the range as the ",
 StyleBox["second",
  FontVariations->{"Underline"->True}],
 " argument, you can simply use the function name and the appropriate \
arguments will be passed to it automatically by ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 ". \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"In", " ", "the", " ", "form", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["u", "TI"], ",", 
       StyleBox["func", "TI"]}], "}"}]}], ",", " ", 
    RowBox[{"then", 
     RowBox[{
      ButtonBox["Dynamic",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Dynamic"], "[", 
      StyleBox["u", "TI"], "]"}], "is", " ", "given", " ", "as", " ", "the", 
     " ", "first", " ", "argument", " ", 
     RowBox[{
      StyleBox[
       RowBox[{"to", 
        StyleBox["func", "TI"]}]], "."}]}]}], TraditionalForm]]],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"In", " ", "the", " ", "form", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["u", "TI"], ",", 
       StyleBox["uMin",
        FontSlant->"Italic"], ",", 
       StyleBox["uMax",
        FontSlant->"Italic"], ",", 
       StyleBox["func", "TI"]}], "}"}]}], ",", " ", 
    RowBox[{"then", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["uMin",
        FontSlant->"Italic"], ",", 
       StyleBox["uMax",
        FontSlant->"Italic"]}], "}"}], "is", " ", "given", " ", "as", " ", 
     "the", " ", "second", " ", "argument", " ", 
     RowBox[{
      StyleBox[
       RowBox[{"to", 
        StyleBox["func", "TI"]}]], "."}]}]}], TraditionalForm]]],
 "\n\nHere we see our custom control used in a simple ",
 Cell[BoxData[
  ButtonBox["Manipulate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Manipulate"]], "InlineFormula"],
 "."
}], "Text",
 CellChangeTimes->{{3.389609430457*^9, 3.389609431201*^9}, {3.389609485078*^9,
    3.3896095142460003`*^9}, {3.389609976156*^9, 3.389609992446*^9}, {
   3.389610068727*^9, 3.389610141593*^9}, {3.389611101648*^9, 
   3.3896111150039997`*^9}, 3.523360882156638*^9}],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"2", "\[Pi]", " ", "n", " ", "x"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "10", ",", 
     RowBox[{
      RowBox[{"ValueThumbSlider", "[", "##", "]"}], "&"}]}], "}"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.389609601866*^9, 3.389609706451*^9}}],

Cell[TextData[{
 "\nThe notation ",
 Cell[BoxData["##"], "InlineFormula"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"ValueThumbSlider", "[", "##", "]"}], "&"}], TraditionalForm]]],
 " means that all the arguments will be passed in to the function, not just \
the first one."
}], "Text",
 CellChangeTimes->{{3.3896106489440002`*^9, 3.3896107129519997`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" Transferring Your ", "Subtitle"],
 StyleBox["Mathematica", "Subtitle",
  FontSlant->"Italic"],
 StyleBox[" Data To and From The Hard Disk:", "Subtitle"]
}], "Section",
 CellChangeTimes->{{3.389873950698*^9, 3.38987395838*^9}, {3.3899093152448*^9,
   3.3899093206378*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}], " "}]], "InputOnly"],

Cell[CellGroupData[{

Cell["  Locating and transferring a file's path:", "Subsection"],

Cell[TextData[{
 "The procedure to locate and transfer a file's path into ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is as follows:\n\tUsing the menu item on the menu bar located at the top \
of the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " window, click: \n\t\tInsert ",
 Cell[BoxData[
  FormBox[">>", TraditionalForm]]],
 " File Path...\nA window will open up (corresponding to your operating \
system) which will allow you to select the file that you are interested in.  \
Once you click ",
 Cell[BoxData[
  FormBox[
   ButtonBox["\<\"\\!\\(\\*\\nStyleBox[\\\"open\\\",\\nFontSize->14]\\)\"\>",
    Appearance->{Automatic, "DialogBox"},
    ButtonFunction:>{},
    Evaluator->None,
    Method->"Preemptive"], TraditionalForm]]],
 ", then the text containing the file path will be transferred into your \
notebook at the location of your cursor.  For example, the following file was \
selected which has path:\n",
 StyleBox["Output:",
  FontColor->RGBColor[1, 0, 0]],
 "\n\"C:\\\\Documents and Settings\\\\dale-doty\\\\My \
Documents\\\\Mathematica\\\\Lessons\\\\Advanced Mathematica \
Lessons\\\\Advanced Lesson 14 Mathematica.nb\"\n"
}], "Text",
 CellChangeTimes->{{3.3898723026400003`*^9, 3.3898723536429996`*^9}, {
  3.389872387535*^9, 3.3898724162*^9}, {3.3899093414088*^9, 
  3.3899093643848*^9}, {3.3899094038318*^9, 3.3899094074308*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["  Writing data to a file:", "Subsection",
 CellChangeTimes->{{3.389874025354*^9, 3.389874030624*^9}}],

Cell["\<\
I will just illustrate a single simple case which stores a list of numbers to \
a file on your hard disk.\
\>", "Text",
 CellChangeTimes->{{3.3898725307060003`*^9, 3.3898725312200003`*^9}}],

Cell[BoxData[
 RowBox[{"dataList", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7"}], 
   "}"}]}]], "Input"],

Cell[TextData[{
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["$TemporaryPrefix",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/$TemporaryPrefix"], "is", " ", "a", " ", 
    "string", " ", "that", " ", "gives", " ", "the", " ", "path", " ", "and", 
    " ", "beginning", " ", "of", " ", "the", " ", "name", " ", "for", " ", 
    "files", " ", "and", " ", "directories", " ", "that", " ", "are", " ", 
    "created", " ", "by", 
    ButtonBox["OpenWrite",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/OpenWrite"], "and", 
    ButtonBox["CreateDirectory",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/CreateDirectory"], "when", " ", "no", " ", 
    "explicit", " ", "file", " ", "is", " ", 
    RowBox[{"specified", "."}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3898734483380003`*^9, 3.38987345352*^9}, 
   3.389874049436*^9, 3.5233609741375585`*^9}],

Cell[BoxData["$TemporaryPrefix"], "Input",
 CellID->546948306],

Cell[TextData[{
 "\n",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    Cell[BoxData[
     RowBox[{
      ButtonBox["OpenWrite",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/OpenWrite"], "[", "\"\<\!\(\*
StyleBox[\"file\", \"TI\"]\)\>\"", "]"}]], "InlineFormula"],
    "\[LineSeparator]opens a file to write output to it, and returns an ",
    Cell[BoxData[
     ButtonBox["OutputStream",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/OutputStream"]], "InlineFormula"],
    " object. "
   }]], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389873208949*^9, 3.3898732147209997`*^9}, {
   3.389873248758*^9, 3.38987329769*^9}, 3.3899094414188004`*^9, {
   3.3900458699964*^9, 3.3900458759653997`*^9}, 3.523361002877846*^9}],

Cell[BoxData[
 RowBox[{"stream1", "=", 
  RowBox[{"OpenWrite", "[", 
   RowBox[{"$TemporaryPrefix", "<>", "\"\<testfile\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.389874169311*^9, 3.389874172328*^9}},
 CellID->65933930],

Cell[TextData[{
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      ButtonBox["Write",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Write"], "[", 
      RowBox[{
       StyleBox["channel", "TI"], ",", 
       SubscriptBox[
        StyleBox["expr", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["expr", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["\[Ellipsis]", "TR"]}], "]"}], "writes", " ", "the", " ", 
     SubscriptBox[
      StyleBox[
       RowBox[{"expressions", 
        StyleBox["expr", "TI"]}]], 
      StyleBox["i", "TI"]], "in", " ", "sequence"}], ",", 
    RowBox[{"followed", " ", "by", " ", "a", " ", "newline"}], ",", 
    RowBox[{"to", " ", "the", " ", "specified", " ", "output", " ", 
     RowBox[{"channel", "."}]}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.389873337394*^9, 3.389873353902*^9}, {3.389873508116*^9,
