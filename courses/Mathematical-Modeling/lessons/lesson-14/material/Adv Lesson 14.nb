StyleBox[\"file\", \"TI\"]\)\>\"", "]"}]], "InlineFormula"],
   "\[LineSeparator]opens a file to append output to it, and returns an ",
   Cell[BoxData[
    ButtonBox["OutputStream",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/OutputStream"]], "InlineFormula"],
   " object. "
  }]], TraditionalForm]]]], "Text",
