Cell[CellGroupData[{

Cell[TextData[{
 "Notation:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"f", "[", "x", "]"}]}], "  ", 
    RowBox[{"vs", ".", "  ", 
     RowBox[{
      RowBox[{"f", "'"}], "[", "x", "]"}]}]}], TraditionalForm]], "None"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], 
     RowBox[{"f", "[", "x", "]"}]}], "  ", 
    RowBox[{"vs", ".", "  ", 
     RowBox[{
      RowBox[{"f", "''"}], "[", "x", "]"}]}]}], TraditionalForm]], "None"],
 "  "
}], "Subsection",
 CellChangeTimes->{{3.43913442728125*^9, 3.43913443525*^9}, {
  3.439134593078125*^9, 3.43913461046875*^9}, {3.439134665703125*^9, 
  3.43913476609375*^9}}],

Cell[TextData[{
 "It is often much more convenient to assign your formula to a function.  \
This allows the use of the function name rather than the formula for all of \
your calculations, which is often much more convenient.\n\nAssign the formula \
 ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"Tan", "[", "x", "]"}]], " ", 
     SuperscriptBox[
      RowBox[{"Sec", "[", "x", "]"}], "2"]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  to the function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.3897363652984*^9, 3.439065856171875*^9, 
  3.439134778984375*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"Tan", "[", "x", "]"}]], " ", 
   SuperscriptBox[
    RowBox[{"Sec", "[", "x", "]"}], "2"]}]}]], "Input"],

Cell[TextData[{
 "\nWhen you have a function of ",
 StyleBox["one",
  FontVariations->{"Underline"->True}],
 " argument, it is possible to use the optional notation  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", " ", "'"}], "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  rather than  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   "
}], "Text",
 CellChangeTimes->{{3.3897363864934*^9, 3.3897363955494003`*^9}, 
   3.439065644796875*^9, {3.43913490053125*^9, 3.4391349064375*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "'"}], "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", "x"], 
  RowBox[{"f", "[", "x", "]"}]}]], "Input",
 CellChangeTimes->{{3.439134828109375*^9, 3.439134841890625*^9}}],

Cell[TextData[{
 "\nWhen you have a function of ",
 StyleBox["one",
  FontVariations->{"Underline"->True}],
 " argument, it is possible to use the optional notation  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", " ", "''"}], "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  rather than  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], " ", 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  "
}], "Text",
 CellChangeTimes->{{3.3897363864934*^9, 3.3897363955494003`*^9}, 
   3.439065644796875*^9, {3.439134916890625*^9, 3.4391349226875*^9}}],

