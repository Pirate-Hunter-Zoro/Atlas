Cell[TextData[{
 "3:  Part 1: Generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", " ", "x"}], ")"}], " ", 
     RowBox[{"cos", "(", 
      RowBox[{"4", "x"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "    (Remember  to enter  ",
 StyleBox["\[ExponentialE]",
  FontWeight->"Bold"],
 "  from the palette and not  ",
 StyleBox["e",
  FontWeight->"Bold"],
 ".)\n     Part 2: Evaluate:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"\[Integral]", " ", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", " ", "x"}]], " ", "sin", 
    RowBox[{"(", 
     RowBox[{"3", " ", "x"}], ")"}], " ", "cos", 
    RowBox[{"(", 
     RowBox[{"4", "x"}], ")"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]],
  FontWeight->"Bold"],
 " \n     Part 3: ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " the answer.  \n     Did ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " shorten the answer in this case?  (Put your words into a Text Cell.)"
}], "Text",
 CellChangeTimes->{
  3.390618747061436*^9, 3.3906187786054363`*^9, {3.390685519901142*^9, 
