Cell[CellGroupData[{

Cell["Integration:", "Subsection",
 CellChangeTimes->{{3.43913442728125*^9, 3.43913443525*^9}, {
  3.43913449959375*^9, 3.439134505921875*^9}}],

Cell[TextData[{
 "Calculate the indefinite integral:     ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "x"], "*", 
      RowBox[{"Sin", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.4390656283125*^9, 3.439134516359375*^9}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", "x"], "*", 
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell[TextData[{
 "\nCalculate the definite integral:  ",
 "   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "a", "b"], 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "x"], "*", 
      RowBox[{"Sin", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{3.439065629703125*^9}],

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "a", "b"], 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", "x"], "*", 
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell[TextData[{
 "\nCalculate the fifth derivative of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox["x", "x"],
    FontWeight->"Bold"], TraditionalForm]]],
 ":   ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "5"], " ", 
     SuperscriptBox["x", "x"]}], 
    RowBox[{"d", " ", 
     SuperscriptBox["x", "5"]}]], TraditionalForm]],
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{3.439065631296875*^9}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"fifthDerivative", " ", "=", 
   RowBox[{
    SubscriptBox["\[PartialD]", 
     RowBox[{"x", ",", "x", ",", "x", ",", "x", ",", "x"}]], "  ", 
    RowBox[{"(", 
     SuperscriptBox["x", "x"], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.43906578959375*^9, 3.4390657916875*^9}}],

Cell["\<\

Simplify the fifth derivative:\
\>", "Text",
 CellChangeTimes->{3.439065633046875*^9}],

Cell[BoxData[
 RowBox[{"Simplify", "[", " ", "fifthDerivative", "]"}]], "Input"],

Cell["\<\

Integrate the above expression for the fifth derivative five times:\
\>", "Text",
 CellChangeTimes->{3.43906563425*^9}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"(", "\[IndentingNewLine]", 
          RowBox[{"\[Integral]", 
           RowBox[{
            RowBox[{"(", "\[IndentingNewLine]", 
             RowBox[{"\[Integral]", 
              RowBox[{
               RowBox[{"(", "\[IndentingNewLine]", 
                RowBox[{
                 SuperscriptBox["x", 
                  RowBox[{
                   RowBox[{"-", "4"}], "+", "x"}]], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "6"}], "+", 
                   RowBox[{"5", " ", 
                    SuperscriptBox["x", "2"]}], "+", 
                   RowBox[{"10", " ", 
                    SuperscriptBox["x", "3"]}], "+", 
                   SuperscriptBox["x", "4"], "+", 
                   RowBox[{"5", " ", "x", " ", 
                    RowBox[{"(", 
                    RowBox[{"2", "-", "x", "+", 
                    RowBox[{"6", " ", 
                    SuperscriptBox["x", "2"]}], "+", 
                    SuperscriptBox["x", "3"]}], ")"}], " ", 
                    RowBox[{"Log", "[", "x", "]"}]}], "+", 
                   RowBox[{"10", " ", 
                    SuperscriptBox["x", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", 
                    RowBox[{"3", " ", "x"}], "+", 
                    SuperscriptBox["x", "2"]}], ")"}], " ", 
                    SuperscriptBox[
                    RowBox[{"Log", "[", "x", "]"}], "2"]}], "+", 
                   RowBox[{"10", " ", 
                    SuperscriptBox["x", "3"], " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", "x"}], ")"}], " ", 
                    SuperscriptBox[
                    RowBox[{"Log", "[", "x", "]"}], "3"]}], "+", 
                   RowBox[{"5", " ", 
                    SuperscriptBox["x", "4"], " ", 
                    SuperscriptBox[
                    RowBox[{"Log", "[", "x", "]"}], "4"]}], "+", 
                   RowBox[{
                    SuperscriptBox["x", "4"], " ", 
                    SuperscriptBox[
                    RowBox[{"Log", "[", "x", "]"}], "5"]}]}], ")"}]}], 
                "\[IndentingNewLine]", ")"}], 
               RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", 
             ")"}], 
            RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", 
          ")"}], 
         RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", ")"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", ")"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",
 CellChangeTimes->{{3.3897357707074003`*^9, 3.3897359373134003`*^9}}]
}, Closed]],

