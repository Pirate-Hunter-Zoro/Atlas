Cell["Consider the following basic algebraic manipulations:", "Text"],

Cell[BoxData[
 RowBox[{"Expand", "[", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"x", " ", "+", " ", "y"}], ")"}], "4"], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Factor", "[", 
  RowBox[{
   SuperscriptBox["x", "4"], "+", 
   RowBox[{"4", " ", 
    SuperscriptBox["x", "3"], " ", "y"}], "+", 
   RowBox[{"6", " ", 
    SuperscriptBox["x", "2"], " ", 
    SuperscriptBox["y", "2"]}], "+", 
   RowBox[{"4", " ", "x", " ", 
    SuperscriptBox["y", "3"]}], "+", 
   SuperscriptBox["y", "4"]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Cancel", "[", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"5", "x"}], "+", "4"}], 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"6", "x"}], "+", "8"}]], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"3", "x"}], "-", "4"}], 
    RowBox[{
     SuperscriptBox["x", "2"], "-", "1"}]]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Together", "[", 
  RowBox[{
   FractionBox[
    RowBox[{"1", "+", "x"}], 
    RowBox[{"2", "+", "x"}]], "+", 
   FractionBox[
    RowBox[{"4", "+", "x"}], 
    RowBox[{"1", "+", "x"}]]}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["Simplifying Algebraic Expressions:", "Subsection"],

Cell[TextData[{
 "Often it is possible to simplify an expression in just one step by applying \
the ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " command:"
}], "Text",
 CellChangeTimes->{{3.439063237796875*^9, 3.4390632416875*^9}}],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  FractionBox[
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"5", "x"}], "+", "4"}], 
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"6", "x"}], "+", "8"}]], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"5", "x"}], "+", "4"}], 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"6", "x"}], "+", "8"}]], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"3", "x"}], "-", "4"}], 
    RowBox[{
     SuperscriptBox["x", "2"], "-", "1"}]]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Simplify", "[", " ", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"Sin", "[", "x", "]"}], "2"], "+", 
   SuperscriptBox[
    RowBox[{"Cos", "[", "x", "]"}], 
    RowBox[{"2", " "}]]}], "]"}]], "Input"],

Cell["\<\

However, there is a limit to how much simplification can be performed \
automatically.\
\>", "Text",
 CellChangeTimes->{{3.3897338977104*^9, 3.3897339076694*^9}, 
   3.439063907171875*^9}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Warning! Extreme Example:",
 FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
 CellChangeTimes->{{3.3901844625025997`*^9, 3.3901844812125998`*^9}}],

Cell[BoxData[
 RowBox[{"Expand", "[", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", " ", "+", " ", "z"}], ")"}], "10"], " ", "+", " ", 
     RowBox[{"y", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", " ", "+", " ", "z"}], ")"}], "20"]}]}], ")"}], "4"], 
  "]"}]], "Input",
 CellChangeTimes->{{3.3901845108936*^9, 3.3901846148066*^9}}],

Cell[TextData[{
 "\nSimplify the above result using the command ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Simplify", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3901847733946*^9, 3.3901847869835997`*^9}, {
  3.4390639223125*^9, 3.439063951484375*^9}}],

Cell[BoxData[
 RowBox[{"Simplify", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   SuperscriptBox["x", "40"], "+", 
   RowBox[{"4", " ", 
