    SuperscriptBox["x", "79"], " ", 
    SuperscriptBox["y", "4"], " ", "z"}], "+", 
   RowBox[{"780", " ", 
    SuperscriptBox["x", "38"], " ", 
    SuperscriptBox["z", "2"]}], "+", 
   RowBox[{"4900", " ", 
    SuperscriptBox["x", "48"], " ", "y", " ", 
    SuperscriptBox["z", "2"]}], "+", 
   RowBox[{"10620", " ", 
    SuperscriptBox["x", "58"], " ", 
    SuperscriptBox["y", "2"], " ", 
    SuperscriptBox["z", "2"]}], "+", 
