}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Example:", "Subsection"],

Cell[TextData[{
 "The following example illustrates how a typical problem in Calculus \
translates into ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".\n\nFind the local maximum and minimum points for the following function:"
}], "Text",
 CellChangeTimes->{{3.439066710421875*^9, 3.4390667309375*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{"11", "-", 
   RowBox[{"60", " ", "x"}], "+", 
   RowBox[{"46", " ", 
    SuperscriptBox["x", "2"]}], "-", 
   RowBox[{"12", " ", 
    SuperscriptBox["x", "3"]}], "+", 
   SuperscriptBox["x", "4"], " "}]}]], "Input"],

Cell["\<\

Graph the function to get a basic idea of how it behaves:\
\>", "Text",
 CellChangeTimes->{{3.3897365136214*^9, 3.3897365519664*^9}, 
   3.439066606296875*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "6"}], "}"}]}], "]"}]], "Input"],

Cell[TextData[{
 "\nIt appears that there are critical points near ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"x", "=", "1"}],
     FontWeight->"Bold"], ",", 
    StyleBox[" ",
     FontWeight->"Bold"], 
    RowBox[{
     RowBox[{
      StyleBox[
       RowBox[{"x", "=", "3"}],
       FontWeight->"Bold"], "  ", "and", "  ", 
      StyleBox["x",
       FontWeight->"Bold"]}], 
     StyleBox["=",
      FontWeight->"Bold"], 
     StyleBox["5",
      FontWeight->"Bold"]}]}], TraditionalForm]]],
 ".\n\nFirst, differentiate the function:"
}], "Text",
 CellChangeTimes->{{3.3897365729203997`*^9, 3.3897366476164*^9}, {
   3.3897366995724*^9, 3.3897367038534*^9}, 3.439066608484375*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "'"}], "[", "x", "]"}]], "Input"],

Cell[TextData[{
 "\nSet the first derivative equal to  ",
 StyleBox["0",
  FontWeight->"Bold"],
 "  and solve for   ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.3897364670464*^9, 3.439066609984375*^9}],

Cell[BoxData[
 RowBox[{"Solve", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], "[", "x", "]"}], " ", "\[Equal]", " ", "0"}], ",", 
   " ", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", "x"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897368247964*^9, 3.3897368338014*^9}}],

Cell["\<\

The above points are the critical points for the function.

Check the second derivative to determine if each point is a local maximum or \
a local minimum:\
\>", "Text",
 CellChangeTimes->{3.439066611546875*^9, 3.43906670240625*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "''"}], "[", "1", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "''"}], "[", "3", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "''"}], "[", "5", "]"}]], "Input"],

Cell[TextData[{
 "\nThe above analysis indicates that the function   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"11", "-", 
     RowBox[{"60", " ", "x"}], "+", 
     RowBox[{"46", " ", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"12", " ", 
      SuperscriptBox["x", "3"]}], "+", 
     SuperscriptBox["x", "4"], " "}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   has a local maximum at ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    StyleBox[
     RowBox[{"x", " ", "=", " ", "3"}],
     FontWeight->"Bold"]}], TraditionalForm]]],
 "  and local minimums at  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "=", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "=", " ", "5"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n\nGraph the function to verify the accuracy of the above analysis:"
}], "Text",
 CellChangeTimes->{{3.3897368695674*^9, 3.3897368830354*^9}, 
   3.43906661309375*^9, 3.4390666965*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "6"}], "}"}]}], "]"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["Indefinite Integrals:", "Subsection",
 CellChangeTimes->{{3.390795184304*^9, 3.3907951848780003`*^9}}],

Cell[TextData[{
 "When ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " evaluates an ",
 StyleBox["indefinite",
  FontVariations->{"Underline"->True}],
 " integral, it returns a ",
 StyleBox["generic",
  FontVariations->{"Underline"->True}],
 " form for the answer.  Much of the time, the generic form works just fine \
under ",
 StyleBox["most",
  FontVariations->{"Underline"->True}],
 " circumstances when you plug in the limits of integration.  \nHowever, for ",
 StyleBox["certain",
  FontVariations->{"Underline"->True}],
 " functions the ",
 StyleBox["generic",
  FontVariations->{"Underline"->True}],
 " form may ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " be valid for ",
 StyleBox["all",
  FontVariations->{"Underline"->True}],
 " possible values for the limits of integration.  For example, consider the \
problematic function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"1", "/", "x"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  which, of course, has a problematic value at  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "=", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3897369310474*^9, 3.3897369317544003`*^9}, {
  3.3899961163694*^9, 3.3899961195764*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   FractionBox["1", "x"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "10"}], ",", "10"}], "}"}]}]}], "]"}]], "Input"],

Cell[TextData[{
 "\nThe ",
 StyleBox["generic",
  FontVariations->{"Underline"->True}],
 " indefinite integral of the problematic function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"1", "/", "x"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  is:"
}], "Text",
 CellChangeTimes->{3.439066781625*^9}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   FractionBox["1", "x"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell[TextData[{
 "\nThe area under the curve for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"1", "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " can be found as:\n\t\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "1", "2"], 
    RowBox[{
     FractionBox["1", "x"], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"=", 
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        FractionBox["1", "x"], 
        RowBox[{"\[DifferentialD]", "x"}]}]}], " ", 
      SubsuperscriptBox["|", "1", "2"]}]}], " "}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"=", 
     RowBox[{
      RowBox[{"Log", "[", "x", "]"}], " ", 
      SubsuperscriptBox["|", "1", "2"]}]}], " "}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"=", 
    RowBox[{
     RowBox[{"Log", "[", "2", "]"}], "-", 
     RowBox[{"Log", "[", "1", "]"}]}]}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"=", "0.6931471805599453`"}], TraditionalForm]}]],
 "\n\t\t\nHowever, the (undefined) area under the curve for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "2"}], "\[LessEqual]", "x", "\[LessEqual]", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " (where ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " passes through zero) can ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " be found as:\n\t\t",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "2"}], "1"], 
     RowBox[{
      FractionBox["1", "x"], 
      RowBox[{"\[DifferentialD]", "x"}], "    ", 
      RowBox[{"(", "Undefined", ")"}]}]}], " "}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"=", 
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        FractionBox["1", "x"], 
        RowBox[{"\[DifferentialD]", "x"}]}]}], " ", 
      SubsuperscriptBox["|", 
       RowBox[{"-", "2"}], "1"]}]}], "  "}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"=", 
     RowBox[{
      RowBox[{"Log", "[", "x", "]"}], " ", 
      SubsuperscriptBox["|", 
       RowBox[{"-", "2"}], "1"]}]}], "     "}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"=", 
    RowBox[{
     RowBox[{"Log", "[", "1", "]"}], "-", 
     RowBox[{"Log", "[", 
      RowBox[{"-", "2"}], "]"}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Pi]"}], "-", 
     RowBox[{"Log", "[", "2", "]"}]}]}], TraditionalForm]}]]
}], "Text",
 CellChangeTimes->{{3.3899961666264*^9, 3.3899961746624002`*^9}, {
  3.43906678384375*^9, 3.439066825125*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Log", "[", "1", "]"}], "-", 
  RowBox[{"Log", "[", 
   RowBox[{"-", "2"}], "]"}]}]], "Input"],

Cell[TextData[{
 "\nRemember, most of the time (at least when you're dealing with ",
 StyleBox["non",
  FontVariations->{"Underline"->True}],
 "problematic functions) the generic form of the indefinite integral can \
always be used.  But you ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " keep in mind that problematic functions may require special considerations."
}], "Text",
 CellChangeTimes->{3.439066785875*^9}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" ODEs:", "Subtitle"]], "Section"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has an extensive ordinary differential equation solving package.  Many \
ODEs can be solved symbolically if they are simple enough.\nFor example, \
solve the following second order ODE:"
}], "Text"],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"y", "''"}], "[", "t", "]"}], " ", "+", " ", 
     RowBox[{"y", "[", "t", "]"}]}], "  ", "\[Equal]", " ", "0"}], ",", " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"y", "[", "t", "]"}], ",", " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "t"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{{3.3897400416204*^9, 3.3897400536654*^9}}],

Cell[TextData[{
 "As expected, the general solution involves the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "[", "t", "]"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Cos", "[", "t", "]"}], TraditionalForm]]],
 " functions and two arbitrary constants  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "[", "1", "]"}], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "[", "2", "]"}], TraditionalForm]]],
 ".\nIt is possible to include either initial or boundary value conditions as \
well.  For example, solve the above ODE with boundary conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "[", "0", "]"}], " ", "=", " ", "0"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"y", "'"}], "[", "\[Pi]", "]"}], " ", "=", " ", "1"}], 
   TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3897400737414*^9, 3.3897401176794*^9}}],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "''"}], "[", "t", "]"}], "+", 
       RowBox[{"y", "[", "t", "]"}]}], "\[Equal]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "\[Pi]", "]"}], "\[Equal]", "1"}]}], 
    "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"y", "[", "t", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "t"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{{3.3897401446674*^9, 3.3897402077054*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Sin", "[", "t", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "\[Pi]"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.3899963773104*^9, 3.3899964285734*^9}}],

Cell["\<\
As a second example, solve the simple first order ODE system:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "+", 
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], "\[Equal]", 
      RowBox[{"x1", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x2", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"x2", "[", "t", "]"}], "+", "t"}]}]}], "\[IndentingNewLine]", 
    "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", "[", "t", "]"}], ",", 
     RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "t"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{{3.3897402475664*^9, 3.3897403155604*^9}}],

Cell[TextData[{
 "Solve the same ODE system subject to the initial conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x1", "[", "0", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"1", "  ", "and", "  ", 
      RowBox[{"x2", "[", "0", "]"}]}], " ", "=", " ", "2"}]}], 
   TraditionalForm]]]
}], "Text"],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "+", 
       RowBox[{
        SuperscriptBox["x2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], "\[Equal]", 
      RowBox[{"x1", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x2", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"x2", "[", "t", "]"}], "+", "t"}]}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x1", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "2"}]}], 
    "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x1", "[", "t", "]"}], ",", 
     RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "t"}], "\[IndentingNewLine]", "]"}]], "Input"],

Cell[TextData[{
 "Plot the solution  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", "t"]}], "-", 
      RowBox[{"3", " ", 
       SuperscriptBox["\[ExponentialE]", "t"], " ", "t"}]}], ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox["\[ExponentialE]", "t"]}], "-", "t"}]}], "}"}], 
   TraditionalForm]]],
 "  parametrically for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "7"}], " ", "\[LessEqual]", " ", "t", " ", "\[LessEqual]", 
    " ", "1"}], TraditionalForm]]]
}], "Text"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", "t"]}], "-", 
      RowBox[{"3", " ", 
       SuperscriptBox["\[ExponentialE]", "t"], " ", "t"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox["\[ExponentialE]", "t"]}], "-", "t"}]}], 
    "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "7"}], ",", "1"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897403657674*^9, 3.3897403916244*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" PDEs:", "Subtitle"]], "Section"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " can find the ",
 StyleBox["symbolic",
  FontVariations->{"Underline"->True}],
 " solution to some PDEs.  However, you need to be aware that ",
 StyleBox["most",
  FontVariations->{"Underline"->True}],
 " PDEs do ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " have simple closed form solutions.  Therefore, you will almost always be \
using numerical procedures to find such solutions (i.e. you will be using \
NDSolve rather than DSolve).\n\nFind the general solution to the following \
first order PDE:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], " ", "x", " ", "t"}], ")"}], "*", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], " ", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "t"], " ", 
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}]}], "=", 
    RowBox[{"x", "*", "t"}]}], TraditionalForm]]]
}], "Text"],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], " ", "x", " ", "t"}], ")"}], " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
     RowBox[{
      SubscriptBox["\[PartialD]", "t"], 
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}]}], "\[Equal]", 
    RowBox[{"x", " ", "t"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897404595224*^9, 3.3897404735874*^9}}],

Cell[TextData[{
 "Initial conditions would be required to determine the form of the function  \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"C", "[", "1", "]"}], "[", "...", "]"}], TraditionalForm]]],
 ".\n\nFor example, consider the Initial Value Problem:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], " ", "x", " ", "t"}], ")"}], " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
     RowBox[{
      SubscriptBox["\[PartialD]", "t"], 
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}]}], "\[Equal]", 
    RowBox[{"x", " ", "t"}]}], TraditionalForm]]],
 "\n\t\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", "\[Pi]", " ", "x"}], "]"}]}], TraditionalForm]]],
 "\n\t"
}], "Text",
 CellChangeTimes->{{3.3899966949274*^9, 3.3899966963374*^9}, {
  3.3899968196674*^9, 3.3899969005394*^9}, {3.5231000548474803`*^9, 
  3.5231000623632317`*^9}}],

Cell[BoxData[
 RowBox[{"DSolve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], " ", "x", " ", "t"}], ")"}], " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], "\[Equal]", 
      RowBox[{"x", " ", "t"}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", "\[Pi]", " ", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
    "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897404595224*^9, 3.3897404735874*^9}, {
   3.3899965007764*^9, 3.3899965237674*^9}, {3.3899966786734*^9, 
   3.3899967307584*^9}, {3.3899967615514*^9, 3.3899968096194*^9}, 
   3.3899969077033997`*^9, {3.3899970437404003`*^9, 3.3899970714604*^9}}],

Cell[TextData[{
 "Plot the solution:\n\n\t  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "x"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         FractionBox[
          RowBox[{"3", " ", 
           SuperscriptBox["t", "2"]}], "2"]], " ", "x"}], "+", 
       RowBox[{"3", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", 
               SuperscriptBox["t", "2"]}], "+", 
              RowBox[{"2", " ", 
               RowBox[{"Log", "[", "x", "]"}]}]}], ")"}]}]], " ", "\[Pi]"}], 
         "]"}]}]}], ")"}]}]}], TraditionalForm]]],
 "    \n\t  \n\t  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", 
    RowBox[{"1", "  ", "and", "   ", "0"}], "\[LessEqual]", " ", "t", " ", 
    "\[LessEqual]", " ", "0.9"}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3899971794914*^9, 3.3899972676154003`*^9}, {
  3.5231000842424192`*^9, 3.5231000842424192`*^9}}],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    FractionBox["1", "3"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "x"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"3", " ", 
          SuperscriptBox["t", "2"]}], "2"]], " ", "x"}], "+", 
      RowBox[{"3", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"3", " ", 
              SuperscriptBox["t", "2"]}], "+", 
             RowBox[{"2", " ", 
              RowBox[{"Log", "[", "x", "]"}]}]}], ")"}]}]], " ", "\[Pi]"}], 
        "]"}]}]}], ")"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "0.9"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3899967867004004`*^9, 3.3899967917054*^9}, {
  3.3899969152504*^9, 3.3899969998733997`*^9}, {3.3899970807014*^9, 
  3.3899970943814*^9}, {3.3906466103*^9, 3.3906466160220003`*^9}}]
}, Closed]],

