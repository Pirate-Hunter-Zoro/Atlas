Cell[CellGroupData[{

Cell["Simplifying with Assumptions:", "Subsection"],

Cell[TextData[{
 "It is possible to simplify using additional assumptions (thereby allowing \
additional and more specific simplifications).  Consider the following \
examples.\n\n",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " must leave the expression   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Sin", "[", " ", 
     RowBox[{"x", " ", "+", " ", 
      RowBox[{"2", " ", "n", " ", "\[Pi]"}]}], " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   as  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Sin", "[", " ", 
     RowBox[{"x", " ", "+", " ", 
      RowBox[{"2", " ", "n", " ", "\[Pi]"}]}], " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "   because it does not simplify ",
 StyleBox["unless",
  FontVariations->{"Underline"->True}],
 " the value of  ",
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]]],
 "  is ",
 StyleBox["known",
  FontVariations->{"Underline"->True}],
 " to be an integer.  And unless you explicitly tell ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " that  ",
 StyleBox["n",
  FontWeight->"Bold"],
 "  is an integer, then it will ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " know.  Therefore, there is ",
 StyleBox["no",
  FontVariations->{"Underline"->True}],
 " immediate simplification for the expression:  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Sin", "[", " ", 
     RowBox[{"x", " ", "+", " ", 
      RowBox[{"2", " ", "n", " ", "\[Pi]"}]}], " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3897339336534*^9, 3.3897339420464*^9}, 
   3.3897339933604*^9, {3.3907924938459997`*^9, 3.390792619483*^9}, {
   3.390792649691*^9, 3.390792651792*^9}, {3.439064044546875*^9, 
   3.439064103578125*^9}}],

Cell[BoxData[
 RowBox[{"Simplify", "[", " ", 
  RowBox[{"Sin", "[", 
   RowBox[{"x", "+", 
    RowBox[{"2", " ", "n", " ", "\[Pi]"}]}], "]"}], " ", "]"}]], "Input"],

Cell[TextData[{
 "\nHowever, if we assume that  ",
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]]],
 "  is an integer (",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"n", "\[Element]", "Integers"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ") then the expression can be simplified:"
}], "Text",
 CellChangeTimes->{{3.3897339832684*^9, 3.3897339878584003`*^9}, {
   3.390792690814*^9, 3.39079280517*^9}, {3.390792840465*^9, 
   3.3907928414119997`*^9}, 3.439064111125*^9}],

Cell[BoxData[
 RowBox[{"Assuming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"n", "\[Element]", "Integers"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"x", "+", 
      RowBox[{"2", " ", "n", " ", "\[Pi]"}]}], "]"}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897340121254*^9, 3.3897340228094*^9}}],

Cell[TextData[{
 "\nYou can find  ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Element]",
    FontWeight->"Bold"], TraditionalForm]]],
 "  on the ",
 StyleBox["Basic Math Input Palette",
  FontWeight->"Bold"],
 " (do not confuse ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Element]",
    FontWeight->"Bold"], TraditionalForm]]],
 " with the Greek letter ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Epsilon]",
    FontWeight->"Bold"], TraditionalForm]]],
 ").\n\n",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ",
 StyleBox["must",
  FontVariations->{"Underline"->True}],
 " leave the expression   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SqrtBox[
     SuperscriptBox["x", "2"]],
    FontWeight->"Bold"], TraditionalForm]]],
 "   as   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SqrtBox[
     SuperscriptBox["x", "2"]],
    FontWeight->"Bold"], TraditionalForm]]],
 "   because it does ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " simplify ",
 StyleBox["unless",
  FontVariations->{"Underline"->True}],
 " the value of  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  is a real number.  Therefore, there is no immediate simplification for \
this expression:"
}], "Text",
 CellChangeTimes->{{3.390792809939*^9, 3.3907928350439997`*^9}, {
   3.4390641536875*^9, 3.439064158234375*^9}, 3.439133823265625*^9}],

Cell[BoxData[
 RowBox[{"Simplify", "[", " ", 
  SqrtBox[
   SuperscriptBox["x", "2"]], " ", "]"}]], "Input"],

Cell[TextData[{
 "\nIn fact, the simplification depends upon whether we only assume that the \
number is ",
 StyleBox["real",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{3.4390641839375*^9}],

Cell[BoxData[
 RowBox[{"Assuming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"x", "\[Element]", "Reals"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", " ", 
    SqrtBox[
     SuperscriptBox["x", "2"]], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897340515924*^9, 3.3897340629564*^9}}],

Cell[TextData[{
 "\nor if we assume that  ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]]],
 "  is a positive or zero real number (i.e.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "\[GreaterEqual]", " ", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " ):"
}], "Text",
 CellChangeTimes->{{3.3897340775624*^9, 3.3897340847144003`*^9}, {
  3.439064200046875*^9, 3.439064254046875*^9}, {3.43913390484375*^9, 
  3.439133908359375*^9}}],

Cell[BoxData[
 RowBox[{"Assuming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"x", "\[GreaterEqual]", "0"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", " ", 
    SqrtBox[
     SuperscriptBox["x", "2"]], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897340930064*^9, 3.3897341031144*^9}}],

Cell[TextData[{
 "\nor if we assume that  ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 "  is negative real number (i.e.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "<", " ", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " ):"
}], "Text",
 CellChangeTimes->{{3.3897341101154003`*^9, 3.3897341171563997`*^9}, {
  3.439064265703125*^9, 3.439064276359375*^9}, {3.439133918640625*^9, 
  3.439133920015625*^9}}],

Cell[BoxData[
 RowBox[{"Assuming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"x", "<", "0"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", " ", 
    SqrtBox[
     SuperscriptBox["x", "2"]], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897341228644*^9, 3.3897341308084*^9}}],

Cell[TextData[{
 "\nThe simplification of the expression   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"2", " ", "n"}], " ", "+", "1"}]], "   ", 
     SqrtBox[
      SuperscriptBox["x", 
       RowBox[{"2", "n"}]]]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  depends upon both the value of  ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]]],
 "  as well as the value of  ",
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]]],
 ". \nSimplifying the expression without assumptions yields little \
simplification:"
}], "Text",
 CellChangeTimes->{{3.3897341443134003`*^9, 3.3897341929254*^9}, 
   3.43906431278125*^9}],

Cell[BoxData[
 RowBox[{"Simplify", "[", " ", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"2", " ", "n"}], " ", "+", "1"}]], "   ", 
   SqrtBox[
    SuperscriptBox["x", 
     RowBox[{"2", "n"}]]]}], "  ", "]"}]], "Input",
 CellChangeTimes->{3.390792927578*^9}],

Cell[TextData[{
 "\nIf  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"n", " ", "\[Element]", " ", "Integers"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ", then the expression simplifies as follows (remember,  ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]]],
 "  could have been a complex number):"
}], "Text",
 CellChangeTimes->{{3.439064343296875*^9, 3.4390643473125*^9}}],

Cell[BoxData[
 RowBox[{"Assuming", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"n", "\[Element]", "Integers"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"2", " ", "n"}], " ", "+", "1"}]], "   ", 
     SqrtBox[
      SuperscriptBox["x", 
       RowBox[{"2", "n"}]]]}], "]"}]}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", "]"}]], "Input",
 CellChangeTimes->{{3.3897342098354*^9, 3.3897342237524*^9}, 
   3.390792961696*^9}],

Cell[TextData[{
 "\nIf  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["x",
      FontWeight->"Bold"], 
     StyleBox[" ",
      FontWeight->"Bold"], 
     StyleBox["<",
      FontWeight->"Bold"], 
     StyleBox[" ",
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["0",
       FontWeight->"Bold"], "  ", "and", "  ", 
      StyleBox["n",
       FontWeight->"Bold"]}]}], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    StyleBox["\[Element]",
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    StyleBox["Integers",
     FontWeight->"Bold"]}], TraditionalForm]]],
 ", then the expression simplifies as follows:"
}], "Text"],

Cell[BoxData[
 RowBox[{"Assuming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "<", "0"}], " ", "\[And]", " ", 
    RowBox[{"n", "\[Element]", "Integers"}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"2", " ", "n"}], " ", "+", "1"}]], "   ", 
     SqrtBox[
      SuperscriptBox["x", 
       RowBox[{"2", "n"}]]]}], "]"}]}], " ", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", " ", "]"}]], "Input",
 CellChangeTimes->{{3.3897342397254*^9, 3.3897342531563997`*^9}, 
   3.390792956177*^9, {3.523098930094016*^9, 3.5230989375487614`*^9}}],

Cell[TextData[{
 "\nYou can find  ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[And]",
    FontSize->14,
    FontWeight->"Bold"], TraditionalForm]]],
 "  (i.e. logical \"",
 StyleBox["and",
  FontWeight->"Bold"],
 "\") as well as ",
 StyleBox["\[Element]",
  FontWeight->"Bold"],
 " on the ",
 StyleBox["Basic Math Input Palette",
  FontWeight->"Bold"],
 ".\n\nAs one final example, consider the simplification of the expression \n\
\n\t   ",
 Cell[BoxData[
  StyleBox[
   FractionBox[
    SuperscriptBox["x", "2"], 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["x", "2"]}]]],
   FontWeight->"Bold"]],
  CellChangeTimes->{{3.3897342806354*^9, 3.3897342921354*^9}, {
   3.439064568734375*^9, 3.439064639265625*^9}, {3.43906469425*^9, 
   3.4390648008125*^9}}],
 " \n\t   \nassuming that\n\n\t",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], "\[Equal]", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], ")"}], "2"]}]}], "  ", 
    "\[And]", "  ", 
    RowBox[{"0", "<", "\[Theta]", "<", 
     RowBox[{"\[Pi]", "/", "2"}]}]}],
   FontWeight->"Bold"]],
  CellChangeTimes->{{3.3897342806354*^9, 3.3897342921354*^9}, {
   3.439064568734375*^9, 3.439064639265625*^9}, {3.43906469425*^9, 
   3.4390648008125*^9}}]
}], "Text",
 CellChangeTimes->{{3.3897342688034*^9, 3.3897342707734003`*^9}, {
  3.390793017672*^9, 3.39079304174*^9}, {3.439064388140625*^9, 
  3.4390644423125*^9}, {3.439064480234375*^9, 3.439064498609375*^9}, {
  3.4390648210625*^9, 3.439064903578125*^9}, {3.43906506615625*^9, 
  3.43906506796875*^9}, {3.43906522603125*^9, 3.43906523009375*^9}}],

Cell[BoxData[
 RowBox[{"Assuming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], "\[Equal]", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], ")"}], "2"]}]}], "\[And]", 
    RowBox[{"0", "<", "\[Theta]", "<", 
     RowBox[{"\[Pi]", "/", "2"}]}]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    FractionBox[
     SuperscriptBox["x", "2"], 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897342806354*^9, 3.3897342921354*^9}, {
  3.439064568734375*^9, 3.439064639265625*^9}, {3.43906469425*^9, 
  3.4390648008125*^9}, {3.43906494096875*^9, 3.439065045109375*^9}}],

Cell[TextData[{
 "\nThe above examples illustrate that simplifications can contain ",
 StyleBox["any",
  FontVariations->{"Underline"->True}],
 " combination of:\n\n\t\tdomain   \t\t(e.g.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "\[Element]", "Integers"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ")\n\t\trelationships\t\t(e.g.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "<", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ")\n\t\tequations\t\t(e.g.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], "+", "1"}], "==", "a"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ")\n\t\tlogical operators\t(e.g.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"x", "<", "0"}], " ", "\[And]", " ", 
     RowBox[{"n", "\[Element]", "Integers"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ")\n\t\t\nThe problem is that we are ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " guaranteed that ",
 StyleBox["every",
  FontVariations->{"Underline"->True}],
 " possible transformation of a simplifying assumption will be made ",
 StyleBox["automatically",
  FontVariations->{"Underline"->True}],
 " by ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  However, you would be surprised how much can be accomplished \
automatically."
}], "Text",
 CellChangeTimes->{{3.3897343400604*^9, 3.3897343414044*^9}, 
   3.3897344255364*^9, {3.439065151765625*^9, 3.43906518015625*^9}}],

Cell[TextData[{
 "As expected, there are limits to the assumptions which can be imposed on \
the simplification process.  Refer to ",
 StyleBox["Mathematica'",
  FontSlant->"Italic"],
 "s Help for additional information and examples."
}], "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Solving Equations:", "Subtitle"]], "Section"],

Cell[CellGroupData[{

Cell["Notation for Equations:   lhs == rhs", "Subsection"],

Cell[TextData[{
 "New users of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " often confuse an assignment (both immediate and delayed):\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"a", " ", "=", " ", "3"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"y", " ", ":=", " ", 
     RowBox[{
      RowBox[{"3", " ", 
       SuperscriptBox["x", "2"]}], " ", "+", " ", "1"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], " ", "=", " ", 
     RowBox[{"Sin", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"g", "[", "x_", "]"}], ":=", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "x"], " ", "+", " ", "5"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"plot1", " ", "=", " ", 
     RowBox[{"Plot", "[", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "x", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t\nwith an equation:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"a", " ", "==", " ", "3"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"y", "==", 
     RowBox[{
      RowBox[{"3", 
       SuperscriptBox["x", "2"]}], " ", "+", " ", "1"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], " ", "==", " ", 
     RowBox[{"Sin", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"g", "[", "x", "]"}], "==", 
     FormBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], " ", "+", " ", "5"}],
      TraditionalForm]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"x", " ", "y"}], " ", "+", " ", 
      RowBox[{"3", " ", "x"}]}], " ", "==", " ", 
     RowBox[{
      RowBox[{"2", " ", "x"}], " ", "+", " ", "4"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t\nAll you have to remember it is:\n\tAssignments:\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"lhs", " ", "=", " ", "rhs"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  or  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"lhs", " ", ":=", " ", "rhs"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\tEquations:\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"lhs", " ", "==", " ", "rhs"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\nEquations are only used within certain functions, for example the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Solve", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command."
}], "Text",
 CellChangeTimes->{{3.3897344045604*^9, 3.3897344145814*^9}, {
  3.3897344521544*^9, 3.3897345493384*^9}, {3.390793109118*^9, 
  3.390793118676*^9}, {3.4390652883125*^9, 3.43906531165625*^9}, {
  3.439065361140625*^9, 3.439065363234375*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["Solving Algebraic Expressions:", "Subsection"],

Cell[TextData[{
 "It is often possible to explicitly solve algebraic expressions.  \nFor \
example, consider solving the linear equation for  ",
 StyleBox["x",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.390793152178*^9, 3.390793153666*^9}}],

Cell[BoxData[
 RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"3", "*", "x"}], " ", "+", " ", "4"}], "\[Equal]", "5"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897347267883997`*^9, 3.3897347341294003`*^9}}],

Cell[TextData[{
 "\nConsider solving the ",
 StyleBox["algebraic",
  FontVariations->{"Underline"->True}],
 " equation for  ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.3897347538104*^9, 3.439065344*^9}],

Cell[BoxData[
 RowBox[{"Solve", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x", " ", "-", "4"}], " ", "\[Equal]", 
    SqrtBox["x"]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "x"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897348055804*^9, 3.3897348140783997`*^9}}],

Cell[TextData[{
 "\nConsider solving the general quadratic formula for  ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{3.3897347594734*^9, 3.439065346640625*^9}],

Cell[BoxData[
 RowBox[{"Solve", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", "*", 
      SuperscriptBox["x", "2"]}], " ", "+", " ", 
     RowBox[{"b", "*", "x"}], " ", "+", " ", "c"}], "\[Equal]", "0"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897348243754*^9, 3.3897348322464*^9}}],

Cell["\<\

As expected, there are two solutions to this second order equation.\
\>", "Text",
 CellChangeTimes->{3.439065348109375*^9}],

Cell[TextData[{
 "Next, solve two simultaneous linear equations in two variables  ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontWeight->"Bold"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox["y",
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3897347672274*^9, 3.3897347709494*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"y", " ", "\[Equal]", 
       RowBox[{
        RowBox[{"2", "*", "x"}], " ", "+", " ", "3"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"y", " ", "\[Equal]", 
       RowBox[{
        RowBox[{"4", "*", "x"}], " ", "-", "5"}]}]}], " ", 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], " "}]], "Input",
 CellChangeTimes->{{3.3897348494494*^9, 3.3897348826443996`*^9}, 
   3.523099177397744*^9}],

Cell[TextData[{
 "\nPlot the two straight lines  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"2", " ", "x"}], " ", "+", " ", "3"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"4", " ", "x"}], " ", "-", " ", "5"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "8"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  to visualize our solution  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "\[Rule]", "4"}], ",", 
      RowBox[{"y", "\[Rule]", "11"}]}], "}"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{{3.390641347892*^9, 3.390641421148*^9}, {3.390641477677*^9,
    3.3906415341619997`*^9}, 3.439065349828125*^9, {3.439065420546875*^9, 
   3.43906542753125*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"2", "x"}], "+", "3"}], ",", " ", 
     RowBox[{
      RowBox[{"4", "x"}], "-", "5"}]}], " ", "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", "8"}], "}"}]}], " ", "]"}]], "Input",
 CellChangeTimes->{{3.3906412463859997`*^9, 3.390641335649*^9}}],

Cell[TextData[{
 "\nNext, solve two simultaneous quadratic equations in two variables  ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox["y",
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3897347742524*^9, 3.3897347778164*^9}, 
   3.4390653513125*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", "*", 
         SuperscriptBox["x", "2"]}], "+", 
        RowBox[{"b", "*", "x"}], "+", "c"}], "\[Equal]", "y"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"y", "+", 
        SuperscriptBox["x", "2"]}], "\[Equal]", "1"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}], "//", "Grid"}]], "Input",
 CellChangeTimes->{{3.3897349326294003`*^9, 3.3897349339124002`*^9}, {
  3.3897350041664*^9, 3.3897350083594*^9}, {3.3897351260004*^9, 
  3.3897351709274*^9}}],

Cell["\<\

As expected, there are multiple solutions to this problem.\
\>", "Text",
 CellChangeTimes->{3.439065352796875*^9}]
}, Closed]],

Cell[CellGroupData[{

Cell["Warning:", "Subsection"],

Cell[TextData[{
 "Please keep in mind that only equations which are fundamentally ",
 StyleBox["algebraic",
  FontVariations->{"Underline"->True}],
 " have closed form symbolic solutions.  Equations involving transcendental \
functions often have no general symbolic solution.  For example, consider the \
equation   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], "\[Equal]", 
     SuperscriptBox["x", "2"]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".  It indeed has solutions, but no simple formula exists for finding all of \
them.  Using the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Solve", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command to solve this equation will generate a warning message:"
}], "Text",
 CellChangeTimes->{{3.3897352186594*^9, 3.3897352291404*^9}, 
   3.439065506171875*^9}],

Cell[BoxData[
 RowBox[{"Solve", "[", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "\[Equal]", 
    SuperscriptBox["x", "2"]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "x"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{{3.3897352567074003`*^9, 3.3897352694034*^9}}],

Cell["\<\

Such equations require numeric rather than symbolic methods.  
To better understand where the solutions might be located, plot the two \
functions (i.e. left-hand side and right-hand side) together:\
\>", "Text",
 CellChangeTimes->{3.43906551690625*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], ",", 
     SuperscriptBox["x", "2"]}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897353063384*^9, 3.3897353285414*^9}, 
   3.523099282186222*^9}],

Cell[TextData[{
 "\nIt appears that there are solutions at  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "=", " ", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and near  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "=", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".  We can ",
 StyleBox["numerically",
  FontVariations->{"Underline"->True}],
 " find the solution near  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", " ", "=", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  by using the ",
 StyleBox["numerical",
  FontVariations->{"Underline"->True}],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"FindRoot", "[", "...", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " command:"
}], "Text",
 CellChangeTimes->{{3.439065518828125*^9, 3.439065557609375*^9}}],

Cell[BoxData[
 RowBox[{"FindRoot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "==", 
    SuperscriptBox["x", "2"]}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1.0"}], "}"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897353556244*^9, 3.3897353675444*^9}}]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Trigonometry:", "Subtitle"]], "Section"],

Cell[TextData[{
 "Many of the same commands that work on algebraic expressions will also work \
on trigonometric expressions as well.  For example, expand the trigonometric \
expression  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Sin", "[", " ", 
     RowBox[{"10", "*", "x"}], " ", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " :  "
}], "Text",
 CellChangeTimes->{{3.3897353881514*^9, 3.3897353903964*^9}, 
   3.3897354536524*^9}],

Cell[BoxData[
 RowBox[{"Expand", "[", "  ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sin", "[", " ", 
    RowBox[{"10", "*", "x"}], " ", "]"}], ",", " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Trig", " ", "\[Rule]", " ", "True"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897354037444*^9, 3.3897354392464*^9}}],

Cell["\<\

Simplify the previous result:\
\>", "Text",
 CellChangeTimes->{3.43906558453125*^9}],

Cell[BoxData[
 RowBox[{"Simplify", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"10", " ", 
    SuperscriptBox[
     RowBox[{"Cos", "[", "x", "]"}], "9"], " ", 
    RowBox[{"Sin", "[", "x", "]"}]}], "-", 
   RowBox[{"120", " ", 
    SuperscriptBox[
     RowBox[{"Cos", "[", "x", "]"}], "7"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "x", "]"}], "3"]}], "+", 
   RowBox[{"252", " ", 
    SuperscriptBox[
     RowBox[{"Cos", "[", "x", "]"}], "5"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "x", "]"}], "5"]}], "-", 
   RowBox[{"120", " ", 
    SuperscriptBox[
     RowBox[{"Cos", "[", "x", "]"}], "3"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "x", "]"}], "7"]}], "+", 
   RowBox[{"10", " ", 
    RowBox[{"Cos", "[", "x", "]"}], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "x", "]"}], "9"]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897354679734*^9, 3.3897354731644*^9}}],

Cell["\<\

Other simplifications specific to trigonometric expressions can be made as \
well:\
\>", "Text",
 CellChangeTimes->{3.439065592890625*^9}],

Cell[BoxData[
 RowBox[{"Simplify", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "\[Alpha]", "]"}], 
    RowBox[{"Cos", "[", "\[Beta]", "]"}]}], "+", 
   RowBox[{
    RowBox[{"Cos", "[", "\[Alpha]", "]"}], 
    RowBox[{"Sin", "[", "\[Beta]", "]"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.3897354854634*^9, 3.3897354895053997`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Calculus:", "Subtitle"]], "Section"],

Cell[TextData[{
 "Essentially everything that can be done symbolically with the Calculus can \
also be performed in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".  "
}], "Text",
