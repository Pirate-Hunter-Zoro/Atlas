    SuperscriptBox["z", "2"]}], "+", 
   RowBox[{"9880", " ", 
    SuperscriptBox["x", "37"], " ", 
    SuperscriptBox["z", "3"]}], "+", 
   RowBox[{"78400", " ", 
    SuperscriptBox["x", "47"], " ", "y", " ", 
    SuperscriptBox["z", "3"]}], "+", 
   RowBox[{"205320", " ", 
    SuperscriptBox["x", "57"], " ", 
    SuperscriptBox["y", "2"], " ", 
    SuperscriptBox["z", "3"]}], "+", 
   RowBox[{"218960", " ", 
