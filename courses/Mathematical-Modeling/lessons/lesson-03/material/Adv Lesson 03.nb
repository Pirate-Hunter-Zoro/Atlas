Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " \nAdvanced Lesson 3\n\nSymbolic Manipulations\n\nDr. Dale R. Doty\n\
University of Tulsa"
}], "Title",
 CellChangeTimes->{{3.390795246771*^9, 3.390795251818*^9}, {
  3.5231822797521114`*^9, 3.5231822821233115`*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Symbolic Manipulations:", "Subtitle"]], "Section",
 CellChangeTimes->{3.439063183640625*^9}],

Cell[TextData[{
 "One of the most powerful features of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is its ability to perform symbolic computations.  A truly vast amount of \
work can be accomplished symbolically.  A tiny fraction of the symbolic \
capability is displayed below. "
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox[" Algebraic Manipulations:", "Subtitle"]], "Section"],

Cell[TextData[{
 "Evaluate (",
 StyleBox["Shift-Enter",
  Background->RGBColor[1, 1, 0]],
 ") the following Input Cell to clear and remove any existing definitions \
from memory before you start this lesson."
}], "Text",
 CellChangeTimes->{{3.3907793381137037`*^9, 3.3907794823047037`*^9}, {
  3.3907795655947037`*^9, 3.3907795802237043`*^9}}],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", " ", "]"}]}]], "InputOnly"],

Cell[CellGroupData[{

Cell["Algebraic Manipulations:", "Subsection"],

Cell[TextData[{
 "You can load the Basic Math Assistant Palette:\n\n\t",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " Menu:  ",
 StyleBox["Palettes \[DoubleLongRightArrow] Basic Math Assistant",
  FontWeight->"Bold"],
 "\n\t\nIt can be used to display a few of the algebraic commands in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.439063450140625*^9, 3.439063622953125*^9}}],

