 RowBox[{
  RowBox[{"f", "''"}], "[", "x", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[PartialD]", 
   RowBox[{"x", ",", "x"}]], 
  RowBox[{"f", "[", "x", "]"}]}]], "Input",
 CellChangeTimes->{{3.439134828109375*^9, 3.4391348634375*^9}}],

