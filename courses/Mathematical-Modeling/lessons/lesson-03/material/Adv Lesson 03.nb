Cell[TextData[{
 "Remember to clear all variables that you will use below:  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Clear", "[", 
     RowBox[{
     "a", ",", "b", ",", "c", ",", "x", ",", "y", ",", "f", ",", "n"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.3906923197301426`*^9, 3.3906923812721424`*^9}, {
  3.3906924809361424`*^9, 3.3906924908791423`*^9}}],

Cell[TextData[{
 " 1: Part 1: Solve:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"a", " ", 
     SuperscriptBox["x", "4"]}], " ", "+", " ", 
    RowBox[{"b", " ", 
     SuperscriptBox["x", "2"]}], " ", "+", " ", "c"}], " ", "=", " ", "0"}]],
  FontWeight->"Bold"],
 "    for:   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "\n     Part 2: Solve:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"a", " ", 
     SuperscriptBox["x", "4"]}], " ", "+", " ", 
    RowBox[{"b", " ", 
     SuperscriptBox["x", "2"]}], " ", "+", " ", "c"}], " ", "=", " ", "0"}]],
  FontWeight->"Bold"],
 "    for:   ",
 StyleBox["a",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.390650355355*^9, 3.390650367828*^9}}],

Cell[TextData[{
 " 2: Part 1: Solve:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"\t", 
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], " ", "+", " ", 
     RowBox[{"b", " ", "y"}], " ", "+", " ", "c"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "    ", "and", "     ", "y"}], " ", "+", " ", 
      RowBox[{"a", " ", 
       SuperscriptBox["z", "2"]}], " ", "+", " ", 
      RowBox[{"b", " ", 
       SuperscriptBox["x", "2"]}], " ", "+", " ", "c"}], "  ", "=", " ", 
     "1"}]}]}]],
  FontWeight->"Bold"],
 "    for:   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["y",
  FontWeight->"Bold"],
 "    \n     ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " the answer.  \n     Did ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " shorten the answer in this case?  (Put your words into a Text Cell.)\n     \
Part 2: Solve:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"\t", 
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], " ", "+", " ", 
     RowBox[{"b", " ", "y"}], " ", "+", " ", "c"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "    ", "and", "     ", "y"}], " ", "+", " ", 
      RowBox[{"a", " ", 
       SuperscriptBox["z", "2"]}], " ", "+", " ", 
      RowBox[{"b", " ", 
       SuperscriptBox["x", "2"]}], " ", "+", " ", "c"}], "  ", "=", " ", 
     "1"}]}]}]],
  FontWeight->"Bold"],
 "    for:   ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "   "
}], "Text",
 CellChangeTimes->{{3.390618476205436*^9, 3.390618508818436*^9}, {
  3.3906185445984364`*^9, 3.390618593113436*^9}, {3.3906187179814363`*^9, 
