Simplify the above result:\
\>", "Text",
 CellChangeTimes->{3.439065646796875*^9}],

Cell[BoxData[
 RowBox[{"Simplify", "[", "  ", 
  RowBox[{
   RowBox[{"f", "''"}], "[", "x", "]"}], "  ", "]"}]], "Input"],

Cell["\<\

Find the indefinite integral:\
\>", "Text",
 CellChangeTimes->{3.4390656484375*^9}],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"Tan", "[", "x", "]"}]], " ", 
   SuperscriptBox[
    RowBox[{"Sec", "[", "x", "]"}], "2"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",
 CellChangeTimes->{3.43913497421875*^9}],

