Cell[CellGroupData[{

Cell[TextData[StyleBox["Warning! Extreme Example:",
 FontSize->14,
 FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
 CellChangeTimes->{{3.3901844625025997`*^9, 3.3901844812125998`*^9}}],

Cell[TextData[{
 "Find the ",
 StyleBox["5th",
  FontWeight->"Bold"],
 " ",
 StyleBox["derivative",
  FontWeight->"Bold"],
 " of: \n\n\t\t  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SuperscriptBox[
     SuperscriptBox[
      SuperscriptBox[
       SuperscriptBox[
        SuperscriptBox[
         RowBox[{"Sin", "[", "x", "]"}], 
         RowBox[{"Cos", "[", "x", "]"}]], 
        RowBox[{"Tan", "[", "x", "]"}]], 
       RowBox[{"Cot", "[", "x", "]"}]], 
      RowBox[{"Sec", "[", "x", "]"}]], 
     RowBox[{"Csc", "[", "x", "]"}]],
    FontSize->16,
    FontWeight->"Bold"], TraditionalForm]]],
 "\n\t\t  \nEvaluating the 5th derivative generates about 30 pages of \
output!!!!!!"
}], "Text",
 CellChangeTimes->{{3.390192165627*^9, 3.390192211429*^9}, {3.390647100407*^9,
   3.3906471957650003`*^9}, {3.390794354718*^9, 3.39079435588*^9}, {
  3.390794731321*^9, 3.3907947826610003`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"fifthDeriv", "[", "x_", "]"}], "=", 
  RowBox[{
   SubscriptBox["\[PartialD]", 
    RowBox[{"x", ",", "x", ",", "x", ",", "x", ",", "x"}]], 
   RowBox[{"(", 
    SuperscriptBox[
     SuperscriptBox[
      SuperscriptBox[
       SuperscriptBox[
        SuperscriptBox[
         RowBox[{"Sin", "[", "x", "]"}], 
         RowBox[{"Cos", "[", "x", "]"}]], 
        RowBox[{"Tan", "[", "x", "]"}]], 
       RowBox[{"Cot", "[", "x", "]"}]], 
      RowBox[{"Sec", "[", "x", "]"}]], 
     RowBox[{"Csc", "[", "x", "]"}]], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.3901917627539997`*^9, 3.390191818255*^9}, {
   3.39019186348*^9, 3.3901919473199997`*^9}, {3.3901919956879997`*^9, 
   3.390192001969*^9}, {3.390794659868*^9, 3.3907946860220003`*^9}, {
   3.390794718*^9, 3.390794724151*^9}, 3.390794786815*^9}],

Cell[TextData[{
 "\nThe above output is huge!!! \n\nTo see it all, click on the \"",
 StyleBox["Show Full Output",
  FontWeight->"Bold"],
 "\" button and stand back!!!\n(Scroll back through the above expression to \
really see how big it is.)\n\nExamine the contents of the above Output Cell.\n\
How many hours would it take ",
 StyleBox["you",
  FontVariations->{"Underline"->True}],
 " to do the above calculation by hand?\n\nPlot the graph of the 5th \
derivative for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"1", "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.3901922558929996`*^9, 3.390192301903*^9}, {
   3.390192482102*^9, 3.3901924956610003`*^9}, {3.390794458908*^9, 
   3.390794500678*^9}, {3.390794800263*^9, 3.390794872842*^9}, 
   3.439066183609375*^9, {3.439066225546875*^9, 3.439066373015625*^9}, 
   3.439134269953125*^9}],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"fifthDeriv", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "10"}], ",", "10"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Ticks", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"4", 
         RowBox[{"\[Pi]", "/", "12"}]}], ",", 
        RowBox[{"5", 
         RowBox[{"\[Pi]", "/", "12"}]}], ",", 
        RowBox[{"6", 
         RowBox[{"\[Pi]", "/", "12"}]}], ",", 
        RowBox[{"7", 
         RowBox[{"\[Pi]", "/", "12"}]}]}], "}"}], ",", "Automatic"}], 
     "}"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.390192012815*^9, 3.3901920371610003`*^9}, {
   3.390192098543*^9, 3.390192118457*^9}, {3.390192358145*^9, 
   3.3901924297790003`*^9}, {3.390192461976*^9, 3.390192474825*^9}, {
   3.390192567259*^9, 3.390192581539*^9}, {3.3901926292939997`*^9, 
   3.390192695065*^9}, {3.390192803611*^9, 3.39019298946*^9}, 
   3.3907948851429996`*^9}],

Cell[TextData[{
 "\nThe above plot suggests that there is a singularity at  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "=", 
     RowBox[{"\[Pi]", "/", "2"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n\nVerify that there is indeed a singularity (i.e. an ",
 StyleBox["indeterminate",
  FontWeight->"Bold"],
 " expression) at ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", "=", 
     RowBox[{"\[Pi]", "/", "2"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
