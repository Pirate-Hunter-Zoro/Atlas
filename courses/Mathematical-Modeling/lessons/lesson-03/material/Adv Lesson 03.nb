      RowBox[{"f", "'"}], "[", "x", "]"}], ",", 
     RowBox[{
      RowBox[{"f", "''"}], "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
