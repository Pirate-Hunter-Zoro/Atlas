 FontWeight->"Bold"],

Cell[CellGroupData[{

Cell["Differentiation:", "Subsection",
 CellChangeTimes->{{3.43913442728125*^9, 3.43913443525*^9}}],

Cell[TextData[{
 "Consider ordinary differentiation:   ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", " ", 
     SuperscriptBox["\[ExponentialE]", "x"], "*", 
     RowBox[{"Sin", "[", "x", "]"}]}], 
    RowBox[{"d", " ", "x"}]], TraditionalForm]],
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.439134451140625*^9, 3.439134457265625*^9}}],

Cell[TextData[{
 "Start by plotting  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", "x"], "*", 
     RowBox[{"Sin", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "4"}], "\[LessEqual]", "x", "\[LessEqual]", "4"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":"
}], "Text",
 CellChangeTimes->{{3.390641807623*^9, 3.3906418863900003`*^9}, {
  3.390641924334*^9, 3.39064195599*^9}, {3.390793834825*^9, 
  3.3907938494230003`*^9}, {3.3907939030559998`*^9, 3.3907939153859997`*^9}}],

Cell[BoxData[
 RowBox[{"Plot", "[", " ", 
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", "x"], "*", 
    RowBox[{"Sin", "[", "x", "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}]}], " ", "]"}]], "Input",
 CellChangeTimes->{{3.39064170173*^9, 3.390641772585*^9}, 3.390641970524*^9, {
   3.3907938584960003`*^9, 3.390793885632*^9}}],

Cell[TextData[{
 "\nCalculate the first derivative:   ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"d", " ", 
     SuperscriptBox["\[ExponentialE]", "x"], "*", 
     RowBox[{"Sin", "[", "x", "]"}]}], 
    RowBox[{"d", " ", "x"}]], TraditionalForm]],
  FontWeight->"Bold"]
}], "Text",
