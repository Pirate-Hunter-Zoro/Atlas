   3.3906866169291425`*^9, 3.3906867781021423`*^9}, {3.3906931513081427`*^9, 
   3.3906931551491423`*^9}, {3.390775775071*^9, 3.390775775691*^9}}],

Cell[TextData[{
 "4:  Part 1: Generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", " ", "x"}], ")"}], " ", 
     RowBox[{"cos", "(", 
      RowBox[{"4", "x"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  \n     Part 2: Differentiate:     ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", " ", "x"}], ")"}], " ", 
     RowBox[{"cos", "(", 
      RowBox[{"4", " ", "x"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "    with respect to ",
 StyleBox["x",
  FontWeight->"Bold"],
 ".\n     Part 3: ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " the answer.  Did ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " shorten the answer in this case?\n     Part 4: Define a function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  to be  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", " ", "x"}], ")"}], " ", 
     RowBox[{"cos", "(", 
      RowBox[{"4", " ", "x"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".     Remember to use  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "=", " ", "..."}],
    FontWeight->"Bold"], TraditionalForm]]],
 "    and not ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{" ", 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n     \tHint: Copy, paste and edit your work from Parts 1, 2 and 3 to \
simplify your work in the following Parts.\n     Part 5: Generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "(", "x", ")"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  \n     Part 6: Differentiate:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "(", "x", ")"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  with respect to ",
 StyleBox["x",
  FontWeight->"Bold"],
 " using the  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  notation.\n     Part 7: Use  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"f", "'"}], "[", "x", "]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  to simplify the answer.\n     Part 8: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and verify that you get the same result. \n     Part 9: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "''"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and verify that you get the same result.\n     Part 10: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'''"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x", ",", "x"}]], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and verify that you get the same result. \n                  Hint: To get \
 ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x", ",", "x"}]], 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  edit  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  by adding ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["  ", 
     StyleBox[
      RowBox[{",", "x"}],
      FontWeight->"Bold"]],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]]],
 "  to get   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x", ",", "x"}]], 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n     Remember to put your words into one or more Text Cells."
}], "Text",
 CellChangeTimes->{
  3.3906187844054365`*^9, {3.3906867975141425`*^9, 3.390686811380142*^9}, {
   3.3906869637201424`*^9, 3.3906869827741423`*^9}, {3.3906900002791424`*^9, 
   3.3906902534031425`*^9}, {3.3906903060211425`*^9, 3.3906905395221424`*^9}, 
   3.3906930537841425`*^9, {3.3906934192231426`*^9, 3.390693452967142*^9}, {
   3.3906935348101425`*^9, 3.3906935349261427`*^9}, {3.3906936695931425`*^9, 
   3.3906938339951425`*^9}, {3.390693905710142*^9, 3.3906939183001423`*^9}, {
   3.390795404951*^9, 3.390795431123*^9}, {3.439067050875*^9, 
   3.439067063796875*^9}, {3.439067140234375*^9, 3.43906714328125*^9}}],

Cell[TextData[{
 "5:Find the local (not global) maximum for the function   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "3"], " ", "-", " ", "x", " ", "+", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n     Part 1: Start by defining a function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  to be  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "3"], " ", "-", " ", "x", " ", "+", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n     Part 2: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and verify that you get the same result. \n     Part 3: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "''"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and verify that you get the same result. \n     Part 4: Plot the function \
 ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "(", "x", ")"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  on the same graph as its derivative  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 ".\n     Part 5: Find the critical points for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "(", "x", ")"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  by solving  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"f", "'"}], 
      RowBox[{"(", "x", ")"}]}], "=", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  and then determine \n                 the local maximum by checking  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "''"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  at the critical points.\n                 Remember to put your words into \
one or more Text Cells."
}], "Text",
 CellChangeTimes->{{3.390649653447*^9, 3.390649806072*^9}, {3.390649860981*^9,
   3.390649946092*^9}, {3.39065043448*^9, 3.3906504774440002`*^9}, {
  3.390687244894142*^9, 3.3906875119351425`*^9}, {3.3906890976641426`*^9, 
  3.3906891078171425`*^9}, {3.3906920793841424`*^9, 3.390692142262142*^9}, {
  3.3906933093501425`*^9, 3.3906933125221424`*^9}, {3.3906935098271427`*^9, 
  3.390693513915142*^9}, {3.3907956336140003`*^9, 3.390795634597*^9}}],

Cell[TextData[{
 "6:  Part 1: Simplify ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "\[Pi]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " without assumptions:\n       Part 2: Simplify ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "\[Pi]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " assuming that  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"n", "\[Element]", "Integers"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":\n       Part 3: Simplify ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "\[Pi]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " assuming that  ",
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontWeight->"Bold"], TraditionalForm]]],
 "  is even, i.e.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"n", "/", "2"}], "\[Element]", "Integers"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":\n       Part 4: Simplify ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "\[Pi]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " assuming that  ",
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontWeight->"Bold"], TraditionalForm]]],
 "  is odd:"
}], "Text",
 CellChangeTimes->{{3.390687621887142*^9, 3.3906876354951425`*^9}, {
  3.3906876693971424`*^9, 3.3906877062701426`*^9}, {3.3906891134451427`*^9, 
  3.3906891147961426`*^9}, {3.3907956399370003`*^9, 3.390795640796*^9}}],

Cell[TextData[{
 "7:  Part 1: Generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "5"], " ", 
     RowBox[{"sin", "(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "1"}], "\[LessEqual]", "x", "\[LessEqual]", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  \n       Part 2: Evaluate the following ",
 StyleBox["indefinite",
  FontVariations->{"Underline"->True}],
 " integral to obtain the generic answer:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox["x", "5"], " ", 
      RowBox[{"sin", "(", "x", ")"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n       Part 3:  Evaluate the following ",
 StyleBox["definite",
  FontVariations->{"Underline"->True}],
 " integral:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "2", "3"], 
     RowBox[{
      SuperscriptBox["x", "5"], " ", 
      RowBox[{"Sin", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n       Remember to put your words into a Text Cell."
}], "Text",
 CellChangeTimes->{{3.3906501152460003`*^9, 3.390650119284*^9}, {
   3.3906877898841424`*^9, 3.390687794165142*^9}, {3.390687879894142*^9, 
   3.3906879435541425`*^9}, {3.3906891185201426`*^9, 
   3.3906891186081424`*^9}, {3.3906933306231422`*^9, 
   3.3906933344001427`*^9}, {3.390776326773*^9, 3.390776327424*^9}, 
   3.390795489519*^9, {3.3907955256*^9, 3.390795564701*^9}, {
   3.390795645701*^9, 3.3907956466359997`*^9}}],

Cell[TextData[{
 "8:  Part 1: ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " to generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SqrtBox["x"],
    FontWeight->"Bold"], TraditionalForm]]],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "1"}], "\[LessEqual]", "x", "\[LessEqual]", "1"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "  and note what happens for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "1"}], "\[LessEqual]", "x", "<", "0"}],
    FontWeight->"Bold"], TraditionalForm]]],
 " .\n                   You will better see the plot if you use the plot \
option:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"Thickness", "[", "0.01", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n                         ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot", "[", "                        ", 
     RowBox[{"...", "                          ", ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"Thickness", "[", "0.01", "]"}]}]}], "]"}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n       Part 2: Evaluate the following ",
 StyleBox["indefinite",
  FontVariations->{"Underline"->True}],
 " integral to obtain the generic answer:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n       Part 3: Evaluate the following definite integral:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "1", "2"], 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n       Part 4: Evaluate the following definite integral:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "a", "b"], 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n                  Why is it ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " surprising that the answer depends upon the values of both  ",
 Cell[BoxData[
  FormBox[
   StyleBox["a",
    FontWeight->"Bold"], TraditionalForm]]],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox["b",
    FontWeight->"Bold"], TraditionalForm]]],
 "?\n       Part 5: Evaluate the following definite integral ",
 StyleBox["assuming",
  FontWeight->"Bold"],
 " that  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "<", "a", "<", "b"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "a", "b"], 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n                  Why is it ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " surprising that the answer is both convergent and a real number?\n       \
Part 6: Evaluate the following definite integral ",
 StyleBox["assuming",
  FontWeight->"Bold"],
 " that  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"a", "<", "0", "<", "b"}],
    FontWeight->"Bold"], TraditionalForm]]],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "a", "b"], 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]]],
 "\n                  Why is it ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " surprising that the answer is both convergent and ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " a real number?"
}], "Text",
 CellChangeTimes->{{3.3906879766951427`*^9, 3.3906879809071426`*^9}, {
  3.3906880533361425`*^9, 3.390688159156142*^9}, {3.3906882701851425`*^9, 
  3.3906884162991424`*^9}, {3.3906884543861427`*^9, 3.390688472151142*^9}, {
  3.3906891230501423`*^9, 3.390689123177142*^9}, {3.390795650889*^9, 
  3.390795652087*^9}}],

Cell[TextData[{
 "\n\n",
 Cell[BoxData[
  FormBox[
   FrameBox[
    StyleBox[
     RowBox[{
      StyleBox["Print",
       FontSize->16], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["your",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["homework",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["exercises",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["using",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["the",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox["following",
       FontSize->14], 
      StyleBox[" ",
       FontSize->14], 
      StyleBox[
       RowBox[{"steps", ":"}],
       FontSize->14]}],
     FontWeight->"Bold",
     FontColor->RGBColor[1, 0, 0]]], TraditionalForm]],
  FontSize->16],
 "\n\n \[GrayCircle] Just like you did for Lesson 1, at the top of your \
exercises, enter your name, your class and your quiz section into the top \
text cell as illustrated below:\n\n \[GrayCircle] Select ",
 StyleBox["only",
  FontVariations->{"Underline"->True}],
 " the 2nd outer cell bracket containing ",
 StyleBox["ONLY",
  FontVariations->{"Underline"->True}],
 " the ",
 StyleBox["exercises",
  FontVariations->{"Underline"->True}],
 " section. (Do NOT print the lesson.):"
}], "Text",
 CellChangeTimes->{{3.390428545079*^9, 3.390428598755*^9}, {
   3.3904286397200003`*^9, 3.390429050267*^9}, {3.390429145796*^9, 
