Cell[TextData[{
 "7:  Part 1: Generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "5"], " ", 
     RowBox[{"sin", "(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "a13cbac1-d4e6-431d-ab3d-6e3ef065e3a2"],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "1"}], "\[LessEqual]", "x", "\[LessEqual]", "1"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "fd561561-2edb-428e-b735-13a5c1568a5b"],
 "  \n       Part 2: Evaluate the following ",
 StyleBox["indefinite",
  FontVariations->{"Underline"->True}],
 " integral to obtain the generic answer:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox["x", "5"], " ", 
      RowBox[{"sin", "(", "x", ")"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e3590a07-806b-457c-9eba-d2d8d770cd3b"],
 "\n       Part 3:  Evaluate the following ",
 StyleBox["definite",
  FontVariations->{"Underline"->True}],
 " integral:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "2", "3"], 
     RowBox[{
      SuperscriptBox["x", "5"], " ", 
      RowBox[{"Sin", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "3b5a9754-11a7-46bc-8548-ece3e412473d"],
 "\n       Remember to put your words into a Text Cell."
}], "Text",
 CellChangeTimes->{{3.3906501152460003`*^9, 3.390650119284*^9}, {
   3.3906877898841424`*^9, 3.390687794165142*^9}, {3.390687879894142*^9, 
