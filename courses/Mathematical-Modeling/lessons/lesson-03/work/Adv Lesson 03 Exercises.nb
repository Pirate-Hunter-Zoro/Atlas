  3.390650367828*^9}},ExpressionUUID->"096cee18-2fd2-4036-b5f2-9b827f96dd29"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "4"]}], "+", 
     RowBox[{"b", " ", 
      SuperscriptBox["x", "2"]}], "+", "c"}], "\[Equal]", "0"}], ",", "x"}], 
  "]"}]], "Input",ExpressionUUID->"0fe56150-f45f-4b11-a603-e2764292c15e"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "4"]}], "+", 
     RowBox[{"b", " ", 
      SuperscriptBox["x", "2"]}], "+", "c"}], "\[Equal]", "0"}], ",", "a"}], 
  "]"}]], "Input",ExpressionUUID->"f774fc57-3e49-4790-9f95-c793de6e34f4"],

Cell[TextData[{
 " 2: Part 1: Solve:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"\t", 
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], " ", "+", " ", 
     RowBox[{"b", " ", "y"}], " ", "+", " ", "c"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "    ", "and", "     ", "y"}], " ", "+", " ", 
      RowBox[{"a", " ", 
       SuperscriptBox["z", "2"]}], " ", "+", " ", 
      RowBox[{"b", " ", 
       SuperscriptBox["x", "2"]}], " ", "+", " ", "c"}], "  ", "=", " ", 
     "1"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"1281ab1b-5a40-4c43-9767-cae8cea66fca"],
 "    for:   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["y",
  FontWeight->"Bold"],
 "    \n     ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " the answer.  \n     Did ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " shorten the answer in this case?  (Put your words into a Text Cell.)\n     \
Part 2: Solve:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"\t", 
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], " ", "+", " ", 
     RowBox[{"b", " ", "y"}], " ", "+", " ", "c"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "    ", "and", "     ", "y"}], " ", "+", " ", 
      RowBox[{"a", " ", 
       SuperscriptBox["z", "2"]}], " ", "+", " ", 
      RowBox[{"b", " ", 
       SuperscriptBox["x", "2"]}], " ", "+", " ", "c"}], "  ", "=", " ", 
     "1"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"a8aa7629-dcc1-47a2-ad01-3206e61155b2"],
 "    for:   ",
 StyleBox["a",
  FontWeight->"Bold"],
 "  and  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "   "
}], "Text",
