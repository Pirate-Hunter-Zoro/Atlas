Cell[BoxData[
 RowBox[{"sol2a", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", " ", 
         SuperscriptBox["x", "2"]}], "+", 
        RowBox[{"b", " ", "y"}], "+", "c"}], "\[Equal]", "z"}], ",", 
      RowBox[{
       RowBox[{"y", "+", 
        RowBox[{"a", " ", 
         SuperscriptBox["z", "2"]}], "+", 
        RowBox[{"b", " ", 
         SuperscriptBox["x", "2"]}], "+", "c"}], "\[Equal]", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]], "Input",ExpressionUUID->\
"fc333da6-5fd8-4ee6-bd8e-9c106b288eb5"],

Cell[BoxData[
 RowBox[{"Simplify", "[", "sol2a", "]"}]], "Input",ExpressionUUID->"a4d5473f-a00f-4be9-a315-b5c779c8020e"],

Cell[BoxData[
 RowBox[{"sol2b", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
