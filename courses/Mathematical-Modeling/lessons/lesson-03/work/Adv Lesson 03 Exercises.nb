Cell["\<\
No. The integral comes back the same size after Simplify, because it is \
already in its shortest form.\
\>", "Text",ExpressionUUID->"d65fe6df-5bd6-4804-b09c-a38410a9394a"],

Cell[TextData[{
 "4:  Part 1: Generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", " ", "x"}], ")"}], " ", 
     RowBox[{"cos", "(", 
      RowBox[{"4", "x"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "39a19266-5ed7-471f-8abd-bf511c6b8f68"],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "24e205a4-a06f-4306-b765-d569f772b7b7"],
 "  \n     Part 2: Differentiate:     ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", " ", "x"}], ")"}], " ", 
     RowBox[{"cos", "(", 
      RowBox[{"4", " ", "x"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "26b7f8eb-a888-4b4f-bd02-3f5637e94d35"],
 "    with respect to ",
 StyleBox["x",
  FontWeight->"Bold"],
 ".\n     Part 3: ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " the answer.  Did ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " shorten the answer in this case?\n     Part 4: Define a function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "db2aee2d-b618-419e-a4da-dba487787c13"],
 "  to be  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", " ", "x"}], ")"}], " ", 
     RowBox[{"cos", "(", 
      RowBox[{"4", " ", "x"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "ef00dacb-1547-422b-a61f-e7d27c9bc636"],
 ".     Remember to use  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "=", " ", "..."}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "1913094e-9049-4a65-873e-5ce33aef0d39"],
 "    and not ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{" ", 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "093ff5dd-ceda-40fa-aaf9-7d0b68d6b901"],
 ".\n     \tHint: Copy, paste and edit your work from Parts 1, 2 and 3 to \
simplify your work in the following Parts.\n     Part 5: Generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "(", "x", ")"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e7b928c2-48b0-414f-99c7-0778f102d487"],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e782ab9e-ba4c-4acc-b549-037f601af605"],
 "  \n     Part 6: Differentiate:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "(", "x", ")"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e6fffd2c-10c6-4eff-8ede-5d46a3fac5c5"],
 "  with respect to ",
 StyleBox["x",
  FontWeight->"Bold"],
 " using the  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], "[", "x", "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e04b233c-4e51-4bcc-82b8-bb5d7256a518"],
 "  notation.\n     Part 7: Use  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"f", "'"}], "[", "x", "]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "c3d3bd13-a999-4b2d-a5c5-b9ea36f7566a"],
 "  to simplify the answer.\n     Part 8: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "54620cdb-bfdd-4b73-878e-ed2e93c8416f"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "8dd329f3-55ac-4883-a657-7804198b032b"],
 "  and verify that you get the same result. \n     Part 9: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "''"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "8c029335-0e75-446a-bcad-8e972e9e7623"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "4340fe6b-0bb8-4452-ac53-f5bc023e2c57"],
 "  and verify that you get the same result.\n     Part 10: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'''"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "568a4593-b1b3-40ae-9d5e-cd238b47b905"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x", ",", "x"}]], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "565a7fed-a986-4f63-9629-c376282ffbf8"],
 "  and verify that you get the same result. \n                  Hint: To get \
 ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x", ",", "x"}]], 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "def97b6c-6c31-43a6-9b24-e1978ad320de"],
 "  edit  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "9825f9e3-6006-4c5b-bea1-56a965ca4e39"],
 "  by adding ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["  ", 
     StyleBox[
      RowBox[{",", "x"}],
      FontWeight->"Bold"]],
    FontColor->RGBColor[1, 0, 0]], TraditionalForm]],ExpressionUUID->
  "08fa1687-116f-4e70-9035-0bc7a0bcf264"],
 "  to get   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x", ",", "x"}]], 
     RowBox[{"f", "[", "x", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "ed61ae7d-9ce4-4a5f-9157-7727d406a46f"],
 "\n     Remember to put your words into one or more Text Cells."
}], "Text",
