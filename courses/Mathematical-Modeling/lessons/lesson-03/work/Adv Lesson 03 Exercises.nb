 RowBox[{"{", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["f", 
      TagBox[
       RowBox[{"(", "3", ")"}],
       Derivative],
      MultilineFunction->None], "[", "x", "]"}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "3"}], "}"}]], 
     RowBox[{"f", "[", "x", "]"}]}]}], "]"}], "}"}]], "Input",ExpressionUUID->\
"07ea6866-d3e3-4c30-b070-dfc015274842"],

Cell["\<\
Simplify does help here: the derivative goes from 46 parts down to 28, \
because the product rule leaves terms that combine. Parts 8 to 10 show that \
f'[x] and the partial derivative notation are two ways of writing the same \
thing: subtracting the two and simplifying gives 0 for the first, second and \
third derivatives.\
\>", "Text",ExpressionUUID->"e1fe7e95-2641-42b9-93c5-c799b3df0f5a"],

Cell[TextData[{
 "5:Find the local (not global) maximum for the function   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "3"], " ", "-", " ", "x", " ", "+", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "c64e269b-8d2a-42e6-8ac6-72a2ecd4aa50"],
 "\n     Part 1: Start by defining a function  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "fbface1a-81a9-4968-bd7b-87efa4b67646"],
 "  to be  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "3"], " ", "-", " ", "x", " ", "+", " ", "1"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "083c5bef-1ba3-45e6-ac60-f17ec6c9ee5a"],
 ".\n     Part 2: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "08594490-2cc7-40ba-bd2a-7fde54a7eb6c"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "129ef3e7-f2ec-41b5-8e6d-0a7f7658abc8"],
 "  and verify that you get the same result. \n     Part 3: Evaluate both  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "''"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "5ba7f7a7-00f9-460a-bc2f-4bb1ffcc2656"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], " ", 
     RowBox[{"(", 
      RowBox[{"f", "(", "x", ")"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "5780c8a6-4eea-49b7-a180-b9fe2a4b904b"],
 "  and verify that you get the same result. \n     Part 4: Plot the function \
 ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "(", "x", ")"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "82ef4798-7b16-4ec9-96f6-812d72f4f9e9"],
 "  on the same graph as its derivative  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "73677f3e-0550-4a4d-b7eb-94bc0ca8f16a"],
 ".\n     Part 5: Find the critical points for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "(", "x", ")"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e9bce58d-3b5f-4732-b049-9c984b9e4e8a"],
 "  by solving  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"f", "'"}], 
      RowBox[{"(", "x", ")"}]}], "=", "0"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "09aca07b-75b6-49c2-bfeb-8437b7cd266e"],
 "  for  ",
 StyleBox["x",
  FontWeight->"Bold"],
 "  and then determine \n                 the local maximum by checking  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "''"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "5a16795b-67b2-4f1b-a584-c8600f32b9ed"],
 "  at the critical points.\n                 Remember to put your words into \
one or more Text Cells."
}], "Text",
 CellChangeTimes->{{3.390649653447*^9, 3.390649806072*^9}, {3.390649860981*^9,
   3.390649946092*^9}, {3.39065043448*^9, 3.3906504774440002`*^9}, {
  3.390687244894142*^9, 3.3906875119351425`*^9}, {3.3906890976641426`*^9, 
  3.3906891078171425`*^9}, {3.3906920793841424`*^9, 3.390692142262142*^9}, {
  3.3906933093501425`*^9, 3.3906933125221424`*^9}, {3.3906935098271427`*^9, 
