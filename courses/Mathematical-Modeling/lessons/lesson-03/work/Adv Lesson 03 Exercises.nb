     RowBox[{"\"\<f\>\"", ",", "\"\<f'\>\""}], "}"}]}]}], "]"}]], "Input",Expr\
essionUUID->"49106fbe-e8e0-4d61-af6f-a9d751db0977"],

Cell[BoxData[
 RowBox[{"crit", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["f", "\[Prime]",
       MultilineFunction->None], "[", "x", "]"}], "\[Equal]", "0"}], ",", 
    "x"}], "]"}]}]], "Input",ExpressionUUID->"7f8d5163-b3ec-4f57-b869-\
581484412b29"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "/.", "\[VeryThinSpace]", "s"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["f", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "x", "]"}], "/.", "\[VeryThinSpace]", 
      "s"}], ",", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], "/.", "\[VeryThinSpace]", "s"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "crit"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"be163be9-d606-4944-a9ad-beff3be3e226"],

Cell["\<\
The critical points are x = -1/Sqrt[3] and x = +1/Sqrt[3]. The second \
derivative is -2 Sqrt[3] at the first, which is negative, so that is the \
local maximum; at the second it is +2 Sqrt[3], a local minimum. The plot \
agrees: the curve turns over on the left and turns back up on the right.\
\>", "Text",ExpressionUUID->"e3c1360f-3f61-486c-88e2-bae804a86953"],

Cell[TextData[{
 "6:  Part 1: Simplify ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "\[Pi]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e3d12829-fd5a-4f8f-9ab5-49c459673a29"],
 " without assumptions:\n       Part 2: Simplify ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "\[Pi]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "0c1c943f-7d5d-4b8e-bf2c-1d5c6d239b4c"],
 " assuming that  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"n", "\[Element]", "Integers"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "107b7733-6585-4aee-9dab-57500a8ddfe3"],
 ":\n       Part 3: Simplify ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "\[Pi]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b33f792e-029d-4351-9187-7e810d05d239"],
 " assuming that  ",
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "34ec4cb1-8866-4ee9-9cd5-fb5aa47246da"],
 "  is even, i.e.  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"n", "/", "2"}], "\[Element]", "Integers"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "cb32f9d0-263e-45ec-8cc6-45800d364ef5"],
 ":\n       Part 4: Simplify ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "\[Pi]"}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "f31b25c0-3079-4ec9-b96a-0c06c9286d27"],
 " assuming that  ",
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "17769843-4ca0-427b-b71e-637751f62c1b"],
 "  is odd:"
}], "Text",
 CellChangeTimes->{{3.390687621887142*^9, 3.3906876354951425`*^9}, {
  3.3906876693971424`*^9, 3.3906877062701426`*^9}, {3.3906891134451427`*^9, 
