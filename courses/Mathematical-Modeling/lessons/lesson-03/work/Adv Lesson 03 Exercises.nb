Cell["\<\
Your Name:  Mikey Ferguson

Your Math Class:  MATH 7013 - Advanced Mathematical Modeling\
\>", "Program",
 CellChangeTimes->{{3.390368232619*^9, 3.3903682391219997`*^9}, {
   3.390368866851*^9, 3.390368908736*^9}, {3.3903690435030003`*^9, 
   3.390369082222*^9}, 3.460216894593193*^9},
 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"dea9464a-82bd-4200-965e-fb5e580e4002"],

Cell[TextData[{
 StyleBox["Note: Most of the following exercises are expressed in every day \
mathematical notation rather than proper ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation.  You ", "Subsubsection"],
 StyleBox["MUST", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" convert every day notation into ", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" notation for your code to work properly.  For example:\n\n\t\
Equations ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be changed from  \"=\"  to  \"==\"  to work correctly (i.e. ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "==", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]],ExpressionUUID->
  "afc03304-de3e-43ec-8e59-ae606957b136"],
 StyleBox["  not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["x", "2"], "=", 
     RowBox[{"2", "x"}]}], "Subsubsection"], TraditionalForm]],ExpressionUUID->
  "af91eab0-85cb-44b9-8ca4-6327f634ab4d"],
 StyleBox["  ).  \n\tFunctions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be expressed as  f[x]  and  not  f(x)  to work correctly.  \n\t\
Functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be defined using  \"_\"  to work correctly (i.e.  ", 
  "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]],ExpressionUUID->"ad2e6b29-6747-427c-9634-11ab1cbec5d6"],
 StyleBox["  and not  ", "Subsubsection"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["x", "2"]}], "+", "1"}]}], "Subsubsection"], 
   TraditionalForm]],ExpressionUUID->"6d9715c3-2644-4681-84d9-b9a2bcc50441"],
 StyleBox[").\n\t", "Subsubsection"],
 StyleBox["Mathematica", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox[" functions ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" start with a capital (i.e.  Sin[x]  not  sin[x]).\n\t", 
  "Subsubsection"],
 StyleBox["Your", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" functions should start with a lower case letter (i.e.  f[x]  not  \
F[x]).\n\tSpecial symbols ", "Subsubsection"],
 StyleBox["must", "Subsubsection",
  FontVariations->{"Underline"->True}],
 StyleBox[" be entered correctly (i.e.  ", "Subsubsection"],
 StyleBox["\[ExponentialE]", "Subsection"],
 StyleBox["  from the palette and not  e ).\n\t\nThese exercises begin your \
training in making this conversion on your own automatically.\n", 
  "Subsubsection"]
}], "Text",
 CellChangeTimes->{{3.39064873246*^9, 3.390649069177*^9}, {3.390649104818*^9, 
   3.390649156885*^9}, {3.390649215119*^9, 3.39064939362*^9}, {
   3.390649427467*^9, 3.390649437834*^9}, {3.3906856676331425`*^9, 
