   3.3907956466359997`*^9}},ExpressionUUID->"eaff3adb-b6db-47df-96e9-\
6c423eb35d4c"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "5"], " ", 
    RowBox[{"Sin", "[", "x", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"5e28f8d4-ac61-46ad-adf0-cc0115312fb6"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "5"], " ", 
    RowBox[{"Sin", "[", "x", "]"}]}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"94d76b05-\
f9b6-4cc7-8e47-f388770f3864"],

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "2", "3"], 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "5"], " ", 
    RowBox[{"Sin", "[", "x", "]"}]}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"20112976-\
0f60-4fad-b528-d65b461a6d10"],

Cell["\<\
The indefinite integral is what repeated integration by parts gives. The \
definite integral from 2 to 3 comes out exactly as 112 Cos[2] - 63 Cos[3] + \
40 Sin[2] - 15 Sin[3], which is about 50.016.\
\>", "Text",ExpressionUUID->"0029b71b-fc78-4b1b-b5d6-eb3704932118"],

Cell[TextData[{
 "8:  Part 1: ",
 StyleBox["Try",
  FontVariations->{"Underline"->True}],
 " to generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SqrtBox["x"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b9ba8115-db59-4b7d-88bf-3593a61bd993"],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "1"}], "\[LessEqual]", "x", "\[LessEqual]", "1"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "5e0da6b7-bb3b-40ab-943f-89abd5db5276"],
 "  and note what happens for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"-", "1"}], "\[LessEqual]", "x", "<", "0"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "03dd108b-e5a0-4f90-9933-3f4f6288e8f1"],
 " .\n                   You will better see the plot if you use the plot \
option:   ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"Thickness", "[", "0.01", "]"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "549c639a-72e7-4880-8425-4c0db2f6be16"],
 "\n                         ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Plot", "[", "                        ", 
     RowBox[{"...", "                          ", ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"Thickness", "[", "0.01", "]"}]}]}], "]"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "c8137a40-9073-4426-be93-7b1406b6a413"],
 "\n       Part 2: Evaluate the following ",
 StyleBox["indefinite",
  FontVariations->{"Underline"->True}],
 " integral to obtain the generic answer:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e76cb13b-4147-46bb-ac81-c1ba7c1747d2"],
 "\n       Part 3: Evaluate the following definite integral:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "1", "2"], 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "c15126ad-7f52-4a25-8941-bf7763f829a9"],
 "\n       Part 4: Evaluate the following definite integral:\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "a", "b"], 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "ea6f2b00-33ba-417f-b800-75fed09e85fb"],
 "\n                  Why is it ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " surprising that the answer depends upon the values of both  ",
 Cell[BoxData[
  FormBox[
   StyleBox["a",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "28aa5329-ce0d-46e5-8475-01c5a46a6af8"],
 "  and  ",
 Cell[BoxData[
  FormBox[
   StyleBox["b",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "1b770e71-d4d5-4b84-b5d6-52934af58549"],
 "?\n       Part 5: Evaluate the following definite integral ",
 StyleBox["assuming",
  FontWeight->"Bold"],
 " that  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "<", "a", "<", "b"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "910faed5-c89e-41aa-85d2-b2b03438903e"],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "a", "b"], 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "cffa49af-9243-4303-b019-dbf7f0532071"],
 "\n                  Why is it ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " surprising that the answer is both convergent and a real number?\n       \
Part 6: Evaluate the following definite integral ",
 StyleBox["assuming",
  FontWeight->"Bold"],
 " that  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"a", "<", "0", "<", "b"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "cbb965bf-e3d9-4a3b-ae9e-e6015bbb1c63"],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubsuperscriptBox["\[Integral]", "a", "b"], 
     RowBox[{
      SqrtBox["x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "25e10a5a-8145-4709-a306-b877baec9fb4"],
 "\n                  Why is it ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " surprising that the answer is both convergent and ",
 StyleBox["not",
  FontVariations->{"Underline"->True}],
 " a real number?"
}], "Text",
 CellChangeTimes->{{3.3906879766951427`*^9, 3.3906879809071426`*^9}, {
  3.3906880533361425`*^9, 3.390688159156142*^9}, {3.3906882701851425`*^9, 
  3.3906884162991424`*^9}, {3.3906884543861427`*^9, 3.390688472151142*^9}, {
  3.3906891230501423`*^9, 3.390689123177142*^9}, {3.390795650889*^9, 
  3.390795652087*^9}},ExpressionUUID->"dd9501fe-2b8a-47f4-89e7-91c766c0c899"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   SqrtBox["x"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"Thickness", "[", "0.01`", "]"}]}]}], "]"}]], "Input",ExpressionUU\
ID->"60592357-2809-47f3-a30f-1dc2e22d7b01"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   SqrtBox["x"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"cb2cfd50-\
6c18-49f2-b29e-0f7cbfeaf17d"],

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "1", "2"], 
  RowBox[{
   SqrtBox["x"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"19688dfd-\
41a8-42e2-b4d9-76e339d1601b"],

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "a", "b"], 
  RowBox[{
   SqrtBox["x"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input",ExpressionUUID->"feccefab-\
0a0b-4cf3-82f1-0c96c9bac858"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   SqrtBox["x"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"0", "<", "a", "<", "b"}]}]}], "]"}]], "Input",ExpressionUUID->\
"bd457ec7-4f06-471e-a40e-79fb6ef598e1"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   SqrtBox["x"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"a", "<", "0", "<", "b"}]}]}], "]"}]], "Input",ExpressionUUID->\
"9dcb40cd-6244-4fed-9dce-271ef51713fa"],

Cell["\<\
Sqrt[x] is not a real number for negative x, so on -1 <= x < 0 there is \
nothing to draw and the curve only begins at 0. The indefinite integral is \
(2/3) x^(3/2), and from 1 to 2 it is (2/3)(2 Sqrt[2] - 1). From a to b with \
no assumptions Mathematica cannot tell whether the interval crosses the \
negative axis, so it answers with a ConditionalExpression stating when its \
result is valid. Assuming 0 < a < b the whole interval is where Sqrt[x] is \
real, so the answer is real. Assuming a < 0 < b part of the interval is where \
Sqrt[x] is imaginary, so the answer picks up a factor of I.\
\>", "Text",ExpressionUUID->"b52665e1-bbce-4092-ae4c-a730c2d30b45"]
},
