Cell[TextData[{
 " 1: Part 1: Solve:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"a", " ", 
     SuperscriptBox["x", "4"]}], " ", "+", " ", 
    RowBox[{"b", " ", 
     SuperscriptBox["x", "2"]}], " ", "+", " ", "c"}], " ", "=", " ", "0"}]],
  FontWeight->"Bold",ExpressionUUID->"25af385e-9df2-4005-91cb-37116ac93afd"],
 "    for:   ",
 StyleBox["x",
  FontWeight->"Bold"],
 "\n     Part 2: Solve:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"a", " ", 
     SuperscriptBox["x", "4"]}], " ", "+", " ", 
    RowBox[{"b", " ", 
     SuperscriptBox["x", "2"]}], " ", "+", " ", "c"}], " ", "=", " ", "0"}]],
  FontWeight->"Bold",ExpressionUUID->"58c6fa9d-80dc-4232-a037-a23892f9c5b7"],
 "    for:   ",
 StyleBox["a",
  FontWeight->"Bold"]
}], "Text",
