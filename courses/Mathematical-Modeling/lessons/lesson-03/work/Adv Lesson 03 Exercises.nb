   3.3906891186081424`*^9}, {3.3906933306231422`*^9, 
   3.3906933344001427`*^9}, {3.390776326773*^9, 3.390776327424*^9}, 
   3.390795489519*^9, {3.3907955256*^9, 3.390795564701*^9}, {
