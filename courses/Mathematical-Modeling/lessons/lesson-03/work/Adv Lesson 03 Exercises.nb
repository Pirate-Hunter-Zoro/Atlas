    TemplateBox[{},
     "Integers"]}]}], "]"}]], "Input",ExpressionUUID->"6052fca6-b086-4386-\
ad3e-e10f0c3bee22"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Cos", "[", 
    RowBox[{"n", " ", "\[Pi]"}], "]"}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"n", "-", "1"}], "2"], "\[Element]", 
    TemplateBox[{},
     "Integers"]}]}], "]"}]], "Input",ExpressionUUID->"a2112183-2e89-42f9-\
a35a-9b5da2f7062b"],

Cell["7: Plot and integrate x^5 Sin[x]", "Section",ExpressionUUID->"7f8820d4-e5ec-427c-9b38-97071d4d53ed"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
