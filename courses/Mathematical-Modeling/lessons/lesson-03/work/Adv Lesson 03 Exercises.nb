Notebook[{
Cell["\<\
Advanced Lesson 3 - Exercises: Solve, Plot, Differentiate, Integrate, \
Simplify
Mikey Ferguson
MATH 7013 - Advanced Mathematical Modeling\
\>", "Title",ExpressionUUID->"5167176d-baef-438a-9e3b-59adabcb739d"],

Cell["\<\
Everyday notation has been converted to Mathematica notation throughout:
equations use \"==\", functions use square brackets, user definitions use the
underscore, and E, Pi and I are the built-in constants rather than the bare
letters e, p and i.\
\>", "Text",ExpressionUUID->"bfff4542-29a7-49b0-b010-da489b6b5f0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b", ",", "c", ",", "x", ",", "y", ",", "f", ",", "n"}], 
   "]"}], ";"}]], "Input",ExpressionUUID->"2cea9eb0-7882-4857-b877-\
73fe0d89e40b"],

Cell["1: Solving a biquadratic", "Section",ExpressionUUID->"e7166a4f-ae50-463f-8676-63cd529cb173"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "4"]}], "+", 
     RowBox[{"b", " ", 
      SuperscriptBox["x", "2"]}], "+", "c"}], "\[Equal]", "0"}], ",", "x"}], 
  "]"}]], "Input",ExpressionUUID->"0fe56150-f45f-4b11-a603-e2764292c15e"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox["x", "4"]}], "+", 
     RowBox[{"b", " ", 
      SuperscriptBox["x", "2"]}], "+", "c"}], "\[Equal]", "0"}], ",", "a"}], 
  "]"}]], "Input",ExpressionUUID->"f774fc57-3e49-4790-9f95-c793de6e34f4"],

Cell["2: A nonlinear system in two unknowns", "Section",ExpressionUUID->"dfc4e306-a82b-4e2a-b9d5-540d0b5dd0f1"],

Cell[BoxData[
 RowBox[{"sol2a", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", " ", 
         SuperscriptBox["x", "2"]}], "+", 
        RowBox[{"b", " ", "y"}], "+", "c"}], "\[Equal]", "z"}], ",", 
      RowBox[{
       RowBox[{"y", "+", 
        RowBox[{"a", " ", 
         SuperscriptBox["z", "2"]}], "+", 
        RowBox[{"b", " ", 
         SuperscriptBox["x", "2"]}], "+", "c"}], "\[Equal]", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]], "Input",ExpressionUUID->\
"fc333da6-5fd8-4ee6-bd8e-9c106b288eb5"],

Cell[BoxData[
 RowBox[{"Simplify", "[", "sol2a", "]"}]], "Input",ExpressionUUID->"a4d5473f-a00f-4be9-a315-b5c779c8020e"],

Cell[BoxData[
 RowBox[{"sol2b", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", " ", 
         SuperscriptBox["x", "2"]}], "+", 
        RowBox[{"b", " ", "y"}], "+", "c"}], "\[Equal]", "z"}], ",", 
      RowBox[{
       RowBox[{"y", "+", 
        RowBox[{"a", " ", 
         SuperscriptBox["z", "2"]}], "+", 
        RowBox[{"b", " ", 
         SuperscriptBox["x", "2"]}], "+", "c"}], "\[Equal]", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "x"}], "}"}]}], "]"}]}]], "Input",ExpressionUUID->\
"0d9540ff-72ae-40d8-8a4f-a3994c9a23fa"],

Cell["3: Plot and integrate E^(2x) Sin[3x] Cos[4x]", "Section",ExpressionUUID->"c3686a1c-86ac-4851-8188-68b14506b571"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", " ", "x"}]], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"3", " ", "x"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"4", " ", "x"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",ExpressionUUID\
->"48d2e07c-c05f-45b1-8a9a-990a39f5af3b"],

Cell[BoxData[
 RowBox[{"int3", "=", 
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"3", " ", "x"}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"4", " ", "x"}], "]"}]}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]}]], "Input",ExpressionUUID->\
"a1a5511d-9551-4524-accf-12f26d809169"],

Cell[BoxData[
 RowBox[{"Simplify", "[", "int3", "]"}]], "Input",ExpressionUUID->"2fbbd783-1013-4183-9edf-dd4390db058f"],

Cell["4: The same function, ten ways", "Section",ExpressionUUID->"9a0dd210-b9f9-408a-8221-c18e4e80303d"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", " ", "x"}]], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"3", " ", "x"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"4", " ", "x"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",ExpressionUUID\
->"fcad922d-79ad-460b-9d86-e5e446bd169d"],

Cell[BoxData[
 RowBox[{"d4", "=", 
  RowBox[{
   SubscriptBox["\[PartialD]", "x"], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"3", " ", "x"}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"4", " ", "x"}], "]"}]}], ")"}]}]}]], "Input",ExpressionUUID->\
"10e106a3-09d9-4744-924a-8d5a9c8aedc4"],

Cell[BoxData[
 RowBox[{"Simplify", "[", "d4", "]"}]], "Input",ExpressionUUID->"6daca218-bc63-4005-8966-7be251913567"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", " ", "x"}]], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"3", " ", "x"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"4", " ", "x"}], "]"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"dcfe52c2-7159-43c5-a518-de77641d23f6"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",ExpressionUUID\
->"123a9db2-5ac5-4c48-82c7-83d38619196b"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["f", "\[Prime]",
   MultilineFunction->None], "[", "x", "]"}]], "Input",ExpressionUUID->\
"bb4d31d0-6f99-4267-a700-2e78837c4db0"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   SuperscriptBox["f", "\[Prime]",
    MultilineFunction->None], "[", "x", "]"}], "]"}]], "Input",ExpressionUUID->\
"59dcadff-0c91-4745-bf32-ffbe42539649"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["f", "\[Prime]",
      MultilineFunction->None], "[", "x", "]"}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"f", "[", "x", "]"}]}]}], "]"}], "}"}]], "Input",ExpressionUUID->\
"872a065a-b47b-4f5d-ad43-2d07142b1038"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["f", "\[Prime]\[Prime]",
      MultilineFunction->None], "[", "x", "]"}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "2"}], "}"}]], 
     RowBox[{"f", "[", "x", "]"}]}]}], "]"}], "}"}]], "Input",ExpressionUUID->\
"246b909f-cc58-4bb6-a5b1-38790f32cfea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["f", 
      TagBox[
       RowBox[{"(", "3", ")"}],
       Derivative],
      MultilineFunction->None], "[", "x", "]"}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "3"}], "}"}]], 
     RowBox[{"f", "[", "x", "]"}]}]}], "]"}], "}"}]], "Input",ExpressionUUID->\
"07ea6866-d3e3-4c30-b070-dfc015274842"],

Cell["5: The local maximum of x^3 - x + 1", "Section",ExpressionUUID->"51bea92f-a4b3-4dbd-b290-1e4d704f35b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["x", "3"], "-", "x", "+", "1"}]}], ";"}]}], "Input",Express\
ionUUID->"d40a16a5-998f-40ec-9de5-b8022b6dd402"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}], ",", 
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"f", "[", "x", "]"}]}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["f", "\[Prime]",
       MultilineFunction->None], "[", "x", "]"}], "-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], 
      RowBox[{"f", "[", "x", "]"}]}]}], "]"}]}], "}"}]], "Input",ExpressionUUI\
D->"be955219-8f6b-4eee-aff1-157242a2f7db"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["f", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "x", "]"}], ",", 
   RowBox[{
    SubscriptBox["\[PartialD]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "2"}], "}"}]], 
    RowBox[{"f", "[", "x", "]"}]}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["f", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "x", "]"}], "-", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"{", 
        RowBox[{"x", ",", "2"}], "}"}]], 
      RowBox[{"f", "[", "x", "]"}]}]}], "]"}]}], "}"}]], "Input",ExpressionUUI\
D->"f81f6b9b-add6-468d-8bb8-ccce97db3ed5"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{
      SuperscriptBox["f", "\[Prime]",
       MultilineFunction->None], "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<f\>\"", ",", "\"\<f'\>\""}], "}"}]}]}], "]"}]], "Input",Expr\
essionUUID->"49106fbe-e8e0-4d61-af6f-a9d751db0977"],

Cell[BoxData[
 RowBox[{"crit", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["f", "\[Prime]",
       MultilineFunction->None], "[", "x", "]"}], "\[Equal]", "0"}], ",", 
    "x"}], "]"}]}]], "Input",ExpressionUUID->"7f8d5163-b3ec-4f57-b869-\
581484412b29"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "/.", "\[VeryThinSpace]", "s"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["f", "\[Prime]\[Prime]",
