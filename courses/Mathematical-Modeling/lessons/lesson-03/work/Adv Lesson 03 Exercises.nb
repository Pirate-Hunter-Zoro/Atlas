Cell["\<\
No. Simplify changed almost nothing here (140 parts before, 138 after). The \
solutions are already about as short as Mathematica can write them.\
\>", "Text",ExpressionUUID->"50fe1245-9276-4ef7-b005-7beb91e1f099"],

Cell[TextData[{
 "3:  Part 1: Generate a plot of  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", " ", "x"}], ")"}], " ", 
     RowBox[{"cos", "(", 
      RowBox[{"4", "x"}], ")"}]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "97845cc3-f9ea-4459-80f0-4543195bbd82"],
 "  for  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "2"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b20b3acd-64bc-4bf4-9d26-87253c45c7bc"],
 "    (Remember  to enter  ",
 StyleBox["\[ExponentialE]",
  FontWeight->"Bold"],
 "  from the palette and not  ",
 StyleBox["e",
  FontWeight->"Bold"],
 ".)\n     Part 2: Evaluate:  ",
 StyleBox[" ",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"\[Integral]", " ", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", " ", "x"}]], " ", "sin", 
    RowBox[{"(", 
     RowBox[{"3", " ", "x"}], ")"}], " ", "cos", 
    RowBox[{"(", 
     RowBox[{"4", "x"}], ")"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]],
  FontWeight->"Bold",ExpressionUUID->"6ebd0e96-53fb-4286-859f-ad41169269f5"],
 " \n     Part 3: ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " the answer.  \n     Did ",
 StyleBox["Simplify",
  FontWeight->"Bold"],
 " shorten the answer in this case?  (Put your words into a Text Cell.)"
}], "Text",
 CellChangeTimes->{
