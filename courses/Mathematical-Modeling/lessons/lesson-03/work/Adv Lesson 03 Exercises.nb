Cell["6: Simplifying Cos[n Pi] under assumptions", "Section",ExpressionUUID->"3fb3e9e4-3976-4fad-9fb5-c3020278009c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "n", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"Cos", "[", 
   RowBox[{"n", " ", "\[Pi]"}], "]"}], "]"}]}], "Input",ExpressionUUID->\
"d9a84cd5-3cba-4a85-9be9-f9d664cdd822"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Cos", "[", 
    RowBox[{"n", " ", "\[Pi]"}], "]"}], ",", 
   RowBox[{"n", "\[Element]", 
    TemplateBox[{},
     "Integers"]}]}], "]"}]], "Input",ExpressionUUID->"d914b844-d499-472a-\
a24d-cd537bffb37b"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Cos", "[", 
    RowBox[{"n", " ", "\[Pi]"}], "]"}], ",", 
   RowBox[{
