% ===========================================================================
%  coursemacros.sty — shared preamble for the mathematical modeling repo
%  MATH 7013, Advanced Mathematical Modeling (Beltrami + Mathematica lessons)
% ===========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{coursemacros}[2026/08/24 mathematical modeling coursework macros]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}

\RequirePackage[margin=1in]{geometry}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc}
\RequirePackage{verbatim}
\RequirePackage[colorlinks=true,linkcolor=BrickRed,citecolor=BrickRed,urlcolor=NavyBlue]{hyperref}

% --- theorem environments --------------------------------------------------
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}

\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{model}[theorem]{Model}
\newtheorem{example}[theorem]{Example}
\newtheorem{exercise}[theorem]{Exercise}

\theoremstyle{remark}
\newtheorem*{remark}{Remark}
\newtheorem*{assumption}{Modelling assumption}

% --- problem / solution ----------------------------------------------------
\newenvironment{problem}[1]
  {\par\medskip\noindent\textbf{Problem #1.}\ \itshape}
  {\par\medskip}
\newenvironment{solution}
  {\par\noindent\textbf{Solution.}\ }
  {\par\medskip}

% Mathematica input transcribed into the write-up. The USER types what goes in
% here; assistants do not (see AI_INSTRUCTIONS.md section 3).
\newenvironment{mathematica}
  {\par\medskip\noindent\textbf{Mathematica.}\par\verbatim}
  {\endverbatim\par\medskip}

% --- number systems and vectors --------------------------------------------
\newcommand{\NN}{\mathbb{N}}
\newcommand{\ZZ}{\mathbb{Z}}
\newcommand{\RR}{\mathbb{R}}
\newcommand{\CC}{\mathbb{C}}
\newcommand{\vect}[1]{\mathbf{#1}}
\newcommand{\xvec}{\vect{x}}
\newcommand{\yvec}{\vect{y}}
\newcommand{\fvec}{\vect{f}}
\newcommand{\zerovec}{\vect{0}}
\newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
\newcommand{\abs}[1]{\left|#1\right|}
\newcommand{\inner}[2]{\left\langle #1, #2 \right\rangle}

% --- calculus and dynamics -------------------------------------------------
\newcommand{\dd}{\mathrm{d}}
\newcommand{\diff}[2]{\frac{\dd #1}{\dd #2}}
\newcommand{\ddt}[1]{\frac{\dd #1}{\dd t}}
\newcommand{\pdiff}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\Jac}{\mathbf{J}}
\DeclareMathOperator{\trace}{tr}
\DeclareMathOperator{\Det}{det}
\DeclareMathOperator{\dive}{div}
\DeclareMathOperator{\curl}{curl}
\newcommand{\grad}{\nabla}
\newcommand{\Lap}{\Delta}
\newcommand{\eqm}[1]{\xvec^{*}_{#1}}      % equilibrium point
\newcommand{\eig}[1]{\lambda_{#1}}
\newcommand{\phaseplane}{\text{phase plane}}

% --- odds and ends ---------------------------------------------------------
\newcommand{\set}[1]{\left\{#1\right\}}
\newcommand{\given}{\,\middle|\,}
\newcommand{\todo}[1]{\textcolor{BrickRed}{\textbf{[TODO: #1]}}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\nouppercase{\leftmark}}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\endinput
