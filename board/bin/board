#!/usr/bin/env python3
"""
board -- command line for the live tutoring board.

The assistant runs these. The student never does.

    board start [--port N] [--lan]     bring the board up (loopback unless --lan)
    board status                       is it up, and on what URLs
    board stop                         bring it down
    board open "Galois Theory" "Ch 7 -- splitting fields" [--lecture|--homework]
                                       archive the last lesson, label the new one
    board open ... --thread <id>       a sitting on one thread, named after it
    board mode [teach|do]              who writes the code in this session; no
                                       word prints it. Only this, POST /mode,
                                       and the tutor obeying "do it" change it
    board finish                       offer the push, on the iPad, at session end
    board push ["message"]             commit and push this repository now
    board next [kind] [slug]           print the path of the next card to write
    board write <kind> <slug>          read a card body on stdin, write the card
    board write --over <card> ...      write over a card already on the board
    board write pending <slug>         the placeholder a doing turn writes first;
                                       the report goes --over it
    board brief                        what a turn is BOUND by, in ONE call: the
                                       method, the subject's RULES.md at HEAD,
                                       and its TUTOR.md
    board recap [--cards N|--all]      the lesson so far in ONE call: every card as
                                       a line, the newest in full, their turns
    board memo <section> < text        replace one section of the bound subject's
                                       TUTOR.md: "Where things are", "Now",
                                       "Open decisions" or "Done recently".
                                       --append adds to it. Refuses a file over
                                       800 words. Never writes RULES.md
    board memo --show                  print TUTOR.md
    board step "ran the suite: 89 green"
                                       one line for a MISSION, saying what you
                                       have just finished. It lands at once and
                                       is what somebody tapping the mission
                                       reads; a report at the end is nothing at
                                       all until then. What is done, not what
                                       you are about to do
    board step --show                  the whole trail, including the board's own
                                       lines: dispatched, a turn started, picked
                                       up after the node went away
    board handoff < handoff.md         write HANDOFF.md at session end, <=350 words,
                                       stamped with its chapter. The only writer.
    board handoff --show|--check       read it, or say how long it is
    board thread < threads.json        write this project's deliverables and
                                       threads. Replaces the derived picture;
                                       re-checked on every read
    board thread --show|--check        read it, or say what has gone stale in it
    board thread task|done|decide|close [<thread>] ...
                                       edit one thread; `board thread --help`
    board job [--label <slug>] [--session <id>] [--produces <p>]
              [--export <p>] [--fixes <id>] [--fresh] -- <recipe> [VAR=v ...]
                                       long work, reporting itself: with
                                       Slurm it submits, without it files a
                                       relay request for the cluster. Its
                                       ending wakes a turn; a failure wakes a
                                       [repair] turn. --show lists them
    board diagnose [--label <slug>] --fixes <id> -- <recipe> [VAR=v ...]
                                       `board job` for a diagnostic: a recipe
                                       that prints RELAY: lines, no output
    board hold|release <thread>        on the cluster: the thread's files are
                                       written there, coached from the Mac
    board send [<thread>]              on the cluster, after each step: commit
                                       it, run the thread's check, push, and
                                       print the coach's reply
    board coach <thread> < reply.md    on the Mac: the coach's reply to a step
    board code <session> <path>...     on the cluster: hold these paths for a
                                       coding session; each pause is a step on
                                       code/<session>, checked and pushed.
                                       --end commits them to main, --abandon
                                       drops the ref. `board code --help`
    board colibri [--label <slug>] "<task>"
                                       queue a Colibri task: on the cluster it
                                       starts a generation if none is up; on
                                       the Mac it files a `colibri` request.
                                       --show lists the queue
    board round <document> [--print]   the ink on a paper, deck or write-up,
                                       filed as a round of its ledger; prints
                                       the ledger and the ids to answer
    board deckfig <deck dir> <subject> <id>
                                       copy one more figure into a deck whose
                                       brief lists it; prints the path to use
    board direction --show             what this workspace is FOR, in their own
                                       words, when they have changed it. It
                                       outranks the plan, the map and the
                                       handoff. `board brief` already has it
    board direction < what.md          replace it -- their sentence, not yours
    board meeting --since 7d [--subject <id>]...
                                       THE meeting deck, projects/Meetings/
                                       docs/meeting/: a presentation to the
                                       mentors, written by a turn over a brief
                                       of the period, replaced each time.
                                       --print shows the brief
    board inbox [--all]                what the student sent; marks it read
    board slate [--all]                paths of the pages written on the iPad
    board wait [--timeout N]           block until the student sends something
    board archive                      file the current lesson away
    board export [--all]               the whole conversation as a numbered PDF
    board session new|show|list|end|reopen|delete [id]
                                       the session store, sessions/<id>/: a new
                                       session, its session.json, End (the only
                                       thing that ends one), or delete to the trash
    board bind <subject> [--create] [--phi yes|no] [--session <id>]
                                       bind this session to courses/<name> or
                                       projects/<name>; --create makes it first
                                       (a project needs --phi). Files nothing
    board file <upload> [materials|<relpath>] [--session <id>]
                                       move an upload into the bound subject,
                                       materials/ by default; its ink follows
    board writeup add <label> < text   an agreed answer into the session's
                                       write-up: statement, a line ---, then
                                       their argument; files the sent page and
                                       rebuilds the PDF
    board writeup new|build|status     start it, rebuild it, what is still empty
    board writeup use <name> | list    write into a course's set (hw04, ch07)
                                       (`board hw` is the same command)
    board build <file> [--format docx|pdf] [--strict] [--reference-doc F] [--keep-aux]
                                       build a document beside its source: a .tex
                                       with pdflatex (deck or article), a .md with
                                       pandoc to .docx, and .pdf when the engine
                                       exists. The only way anything here compiles
    board textbook split <course> [NN ...]
                                       cut the course's textbook/ PDF into
                                       chapters/chNN-*/reading/chNN.pdf by the
                                       page ranges in its chapters.tsv
    board textbook scaffold <course> [--chapter-homework] [NN ...]
    board textbook scaffold <course> --hw NN [NN ...]
                                       chapter notes (and homework) .tex files,
                                       or numbered homework sets, from
                                       board/tex/writeup.tex.in; never overwrites
    board vpn up [--hostname N]        the Tailscale link (name defaults to 'board')
    board vpn status|serve|down, for devices off this network
    board init [name]                  write tutorboard.json for this repository
    board doctor                       check the machine has what this needs
    board egress [--repair]            can a turn get out, and through which exit node
    board limit [--clear|--set S]      has the tutor's allowance here run out
    board eyes [--answer]              can the assistant driving this actually see?
    board see <path> [--page N]        what is in this image or PDF page, in words,
                                       for an assistant whose model has no eyes

Card kinds: lesson, question, correct, wrong, review, note, recap. (A `review`
card is you reviewing an answer.)
"""

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time

TOOL = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, TOOL)
# `board code` runs on the cluster, on its python3, beside the data: it is
# answered before anything below is imported, so it loads tutorboard/code.py
# and what that needs, and no server, runner or model module.
if __name__ == "__main__" and sys.argv[1:2] == ["code"]:
    from tutorboard import code as _code
    sys.exit(_code.main(sys.argv[2:]))
from tutorboard import (assistants, atlas, brief, direction, gitops,
                        handoff, holds, jobs, keys, leaving, limits, machine, memo,
                        missions, paths, plain, ports, processes, progress,
                        reasoning, seeing, sense, sessions, tex, worktree)
from tutorboard import briefs, subjects
from tutorboard import mode as session_mode
from tutorboard.net import egress, tailscale
from tutorboard.course import config, document, homework, paper
from tutorboard.course import repo as course_repo
# `map` is a builtin; the module keeps the name the board calls the thing and
# the binding does not.
from tutorboard.course import map as course_map
from tutorboard.course import threads as course_threads
SERVE = os.path.join(TOOL, "serve.py")
# `pending` is the placeholder a doing turn opens with and writes its report
# over. A turn that exits leaving the newest card `pending` has not reported,
# and the daemon says so -- see `report_owed` in `tutorboard/runner/loop.py`.
KINDS = ("lesson", "question", "correct", "wrong", "review", "note", "recap",
         "pending")

# How many cards `board recap` names as lines. Every turn reads this, so it is
# the one part of the recap that must not grow with the lesson -- see cmd_recap.
# Wide enough to hold a whole sitting's worth of shape, which is what a turn
# reasons about; a chapter's worth is HANDOFF.md's job.
LINES = 40


# ---------------------------------------------------------------------------
def this_node():
    """What this machine calls itself. One place decides; see boardlib.

    This used to be `socket.gethostname()` here and `os.uname()` in the launcher,
    which can disagree on the same machine -- and both follow the network, which
    renamed this one mid-session and orphaned a running board from every command
    that wanted to restart it.
    """
    return machine.node_name()


def alive(info):
    """Is this board actually running *here*?

    The home directory is shared across every compute node, so `live/.board.json`
    may well have been written by a board on a different machine. A bare pid check
    would then report a stranger's process as ours.
    """
    if not info:
        return False
    node = info.get("node")
    if node and node != this_node():
        return False
    return processes.board_is_running(info.get("pid"), info.get("root") or live_root(info))


def live_root(info):
    return info.get("root", "")


def slurm_nodes():
    """Nodes where this user currently holds an allocation, or None if unknown."""
    return machine.slurm_nodes()


def default_port(root):
    """Stable per-repository port so two courses can hold boards at once."""
    return ports.default_port(os.path.basename(root))


def free_port(root):
    """The first port in this repository's sequence that nothing is holding.

    Two courses used to be able to hash to the same number, and the second one to
    start just failed to come up -- "board failed to come up; see board.log", with
    the real reason four lines into a log nobody opens. The sequence is a pure
    function of the name, so another machine can walk the same one looking for
    this course without having to be told anything.
    """
    seq = ports.port_sequence(os.path.basename(root))
    for port in seq:
        if not port_answers(port):
            return port, None
    return seq[0], ("every port this course can use is busy (%s); "
                    "stop another board or pass --port"
                    % ", ".join(str(p) for p in seq))


def slugify(s):
    s = re.sub(r"[^A-Za-z0-9]+", "-", (s or "").strip().lower()).strip("-")
    return (s or "card")[:48]


# ---------------------------------------------------------------------------
def install_teaching(live):
    """Put the teaching method where this course's assistant will read it.

    It lives in Tutor-Board and is copied into `live/` on every start, so every
    repository teaches the same way and none of them can drift -- the alternative
    is the same document pasted into a dozen AI_INSTRUCTIONS.md files, going out
    of step one repository at a time. `live/` is gitignored, so this is a
    delivery, not an edit to the course.
    """
    src = os.path.join(TOOL, "TEACHING.md")
    if not os.path.exists(src):
        return None
    dest = live.path("TEACHING.md")
    try:
        shutil.copyfile(src, dest)
    except OSError:
        return None
    return dest


# WHAT AN UNATTENDED TUTOR MAY DO IS NOT SET HERE, and it used to be.
#
# `install_permissions` wrote each course its own `.claude/settings.local.json`
# -- a daemon has nobody to approve a tool call, so a tool that needs
# permission simply fails, silently as far as the board is concerned, and a
# first homework turn once composed a whole opening card and ended having
# written nothing. The grants were right; their HOME was wrong. They named one
# vendor's file, in one vendor's directory, written into every course this tool
# touched, so the board was the thing putting a provider's config into nine
# repositories.
#
# They are `ai-config/workspaces/tutors.allow` now, folded into that
# assistant's own settings by its installer, and no workspace carries a config
# directory at all. Adding a grant is a line in that file and
# `bash ai-config/scripts/install.sh`.
def cmd_start(live, args):
    info = live.info()
    if info and alive(info):
        print("already up: " + "  ".join(info["urls"]))
        ts_repoint(info["port"])
        return 0
    if info and info.get("node") and info["node"] != this_node():
        # Shared home, different machine. Either it is still serving over the
        # tailnet and nothing needs doing, or its allocation ended and the record
        # is stale.
        held = slurm_nodes()
        if held is not None and info["node"] not in held:
            print("clearing a stale record from %s (no allocation there any more)"
                  % info["node"])
        else:
            print("a board for this repository is already running on %s." % info["node"])
            print("start one here anyway with: board start --force")
            if "--force" not in args:
                return 1

    install_teaching(live)

    port, port_error = free_port(live.root)
    lan = False
    i = 0
    while i < len(args):
        if args[i] in ("--port", "-p"):
            i += 1
            port = int(args[i])
            port_error = None
        elif args[i] == "--lan":
            lan = True
        i += 1
    if port_error:
        print(port_error, file=sys.stderr)
        return 1
    if port != default_port(live.root):
        # Say so rather than letting it be a surprise: the number is in the
        # record and in /health, but a person reading the log deserves the reason.
        print("port %d was busy; this board is on %d"
              % (default_port(live.root), port))

    # Whatever this repository left running before now, which is nothing the
    # record still names. See `drop_strays`.
    drop_strays(live)

    log = open(live.path("board.log"), "ab")
    cmd = [sys.executable, SERVE, "--root", live.root, "--port", str(port)]
    if lan:
        cmd.append("--lan")
    proc = subprocess.Popen(cmd, stdout=log, stderr=log, start_new_session=True,
                            cwd=live.root)
    for _ in range(60):
        time.sleep(0.1)
        info = live.info()
        if info and info.get("pid") == proc.pid:
            break
    else:
        print("board failed to come up; see " + live.path("board.log"), file=sys.stderr)
        return 1
    print("board up (pid %d)" % proc.pid)
    for u in info["urls"]:
        print("  " + u)
    ts_repoint(port)
    return 0


def cmd_stop(live, args):
    info = live.info()
    if info and not alive(info) and info.get("node") not in (None, this_node()):
        print("the record points at %s, not this node; not touching it." % info["node"])
        print("removing the local record only.")
        try:
            os.remove(live.path(".board.json"))
        except OSError:
            pass
        return 0
    if not info or not alive(info):
        print("not running")
        return 0
    try:
        os.killpg(os.getpgid(info["pid"]), signal.SIGTERM)
    except OSError:
        try:
            os.kill(info["pid"], signal.SIGTERM)
        except OSError:
            pass
    # Take it off the tailnet too, or a stopped board leaves a forwarding rule
    # pointing at a port nothing answers on -- which the other machine then finds
    # and believes.
    if info.get("port"):
        tailscale.unpublish_board(info["port"])
    try:
        os.remove(live.path(".board.json"))
    except OSError:
        pass
    print("board down")
    return 0


def cmd_status(live, args):
    info = live.info()
    st = live.state()
    up = bool(info and alive(info))
    print("board:   %s" % ("up" if up else "down"))
    if up:
        for u in info["urls"]:
            print("  " + u)
    if info and info.get("node"):
        print("node:    %s%s" % (info["node"],
                                 "" if info["node"] == this_node() else "  (not this one)"))
    print("repo:    %s" % live.root)
    cfg = read_config(live.root)
    print("course:  %s" % (st.get("course") or cfg["name"]))
    print("mode:    %s" % config.mode_of(st))
    print("chapter: %s" % st.get("chapter", "-"))
    print("session: %s%s" % (st.get("session", "lecture"),
                             "  (finish offered)" if st.get("finished") else ""))
    print("cards:   %d" % len(live.card_names()))
    msgs = read_messages(live)
    print("unread:  %d" % sum(1 for m in msgs if not m.get("read")))
    return 0


def cmd_open(live, args):
    """Start a sitting, and say what kind it is: a lecture or a homework set.

    A lecture and a homework sitting are different jobs. In a lecture the user is
    being taught and writes back to show they followed. In homework they are
    producing work that has to end up typeset and compiled, and the write-up is
    the assistant's to do once the mathematics is agreed. Who writes the code is
    the session's mode, which opening a sitting never changes (`board mode`).
    """
    session = None
    which = None
    agent = None
    node = None
    thread = None
    rest = []
    skip_next = False
    for i, a in enumerate(args):
        if skip_next:
            skip_next = False
            continue
        if a == "--lecture":
            session = "lecture"
        elif a == "--homework":
            session = "homework"
        elif a == "--agent":
            # WHICH ASSISTANT THIS SITTING WANTS, written with the sitting: a
            # chapter change replaces the tutor the moment it is opened, so a
            # choice written after that is one the incoming daemon never saw.
            # Only the shape of the name is checked; `resolve_agent` drops one
            # this machine has not got.
            agent = config.clean_agent(args[i + 1] if i + 1 < len(args) else "")
            if agent is None:
                print("  --agent takes an assistant's name; ignored",
                      file=sys.stderr)
            skip_next = True
        elif a == "--node":
            # Which box of the map this sitting is about. Checked against what
            # the map actually holds, never carried through as typed.
            node = (args[i + 1] if i + 1 < len(args) else "").strip()
            skip_next = True
        elif a == "--thread":
            # Which thread of `threads.json` this sitting is on. Checked
            # against the file, never carried through as typed.
            thread = (args[i + 1] if i + 1 < len(args) else "").strip()
            skip_next = True
        elif a == "--set":
            which = args[i + 1] if i + 1 < len(args) else None
            skip_next = True
        elif a.startswith("--"):
            # --review, --walk, --make, --aim, --kind and --stance among them:
            # the method is the tutor's to pick in teach mode, and who writes
            # the code is `board mode`.
            print("board open: no option %s (who writes the code is `board "
                  "mode teach|do`)" % a, file=sys.stderr)
            return 2
        else:
            rest.append(a)
    course = rest[0] if len(rest) > 0 else None
    chapter = rest[1] if len(rest) > 1 else None

    # A chapter is its own thing, and its handoff goes with it.
    #
    # `HANDOFF.md` is the only continuity a session has, and it was continuity
    # across the wrong boundary: opening Chapter 3 carried "left unfinished in
    # Chapter 1" into it, and the new chapter's tutor read that and offered to go
    # back for an exercise the student had closed. Reported in those words. So
    # the handoff of the chapter being left is parked under its own name, and the
    # one belonging to the chapter being opened -- if it has been taught before
    # -- comes back.
    was = live.state().get("chapter") or ""
    if (chapter or "") != was:
        parked = handoff.park_handoff(live.root, was)
        if parked:
            print("  handoff for %s parked at %s"
                  % (was or "the last sitting", os.path.relpath(parked, live.root)))
    cmd_archive(live, [])
    if (chapter or "") != was and handoff.restore_handoff(live.root, chapter):
        print("  handoff from the last sitting on this chapter is back")
    # A BOX OF A THREAD FILE IS A THREAD. Its id is the thread's, so a map tap
    # that names it opens a sitting on the thread, and `node` is kept only for
    # a box of a derived map.
    clean_threads, _bad = course_threads.read(live.root)
    if node and not thread and course_threads.thread(clean_threads, node):
        thread, node = node, None
    on = None
    if thread:
        on = course_threads.thread(clean_threads, thread)
        if not on:
            print("  no thread called %r in threads.json; ignored" % thread,
                  file=sys.stderr)
            thread = None
        else:
            # Named after the thread, always: a sitting is its thread's.
            chapter = chapter or on["title"]
    if node:
        found = course_map.find(live.root, node, live.state())
        if not found:
            print("  no part of the map called %r; ignored" % node, file=sys.stderr)
            node = None
        elif not chapter:
            chapter = found["name"]
    live.set_state(course=course, chapter=chapter, session=session or "lecture",
                   finished=None, hw=None,
                   # What this sitting is about, cleared by opening the next one.
                   node=node, thread=thread,
                   # A rethink's sentence belongs to the sitting it opened.
                   rethink=None,
                   # And which assistant, under the same rule.
                   agent=agent,
                   # Legacy sitting keys, cleared: the mode is the session's.
                   kind=None, aim=None, stance=None, makes=None,
                   review=None, walk=None,
                   opened=time.strftime("%Y-%m-%d %H:%M"))
    print("%s open: %s / %s" % (session or "lecture", course or "-", chapter or "-"))
    if thread:
        print("  thread: %s" % thread)
    if agent:
        print("  assistant: %s  (this sitting only)" % agent)
    if session == "homework":
        print("  you write the mathematics; the write-up and the compile are mine")
        # Bind the sitting to a problem set now, so nothing later has to guess.
        if which:
            cmd_writeup(live, ["use", which])
        else:
            st = homework.status(live.root, live.state())
            if st and st["name"]:
                live.set_state(hw=st["rel"])
                print("  set: %s  (%s)" % (st["name"], st["rel"]))
            elif st and st["ambiguous"]:
                print("  which set? board writeup use <name>, or reopen with --set")
    return 0


def cmd_archive(live, args):
    """Close the current session and put the whole of it somewhere permanent.

    The transcript goes with the cards. A lesson the student can reopen and
    still see their own working in is the entire reason for keeping these; a
    folder of the assistant's cards with the student's half missing is a
    record of half a conversation.

    A stored session (`sessions/<id>/`) is never archived: it persists until
    the owner ends it, and only `board session end` does that.
    """
    if live.stored:
        print("a session is never archived; it keeps every card until the owner "
              "ends it (board session end <id>)", file=sys.stderr)
        return 1
    names = live.card_names()
    slate = sorted(n for n in os.listdir(live.slate) if re.match(r"^page-\d+\.(json|png)$", n))
    turns_path = live.path("turns.jsonl")
    has_turns = os.path.exists(turns_path)
    if not names and not slate and not has_turns:
        print("nothing to archive")
        return 0
    st = live.state()
    label = slugify(st.get("chapter") or st.get("course") or "lesson")
    dest = os.path.join(live.archive, time.strftime("%Y%m%d-%H%M%S") + "-" + label)
    os.makedirs(dest, exist_ok=True)
    for n in names:
        os.rename(os.path.join(live.cards, n), os.path.join(dest, n))
    if slate:
        sdest = os.path.join(dest, "slate")
        os.makedirs(sdest, exist_ok=True)
        for n in slate:
            os.rename(os.path.join(live.slate, n), os.path.join(sdest, n))
        print("archived %d slate pages" % len([n for n in slate if n.endswith(".png")]))
    if has_turns:
        os.rename(turns_path, os.path.join(dest, "turns.jsonl"))
    frozen = sorted(os.listdir(live.answers)) if os.path.isdir(live.answers) else []
    if frozen:
        adest = os.path.join(dest, "answers")
        os.makedirs(adest, exist_ok=True)
        for n in frozen:
            os.rename(os.path.join(live.answers, n), os.path.join(adest, n))
        print("archived %d answer file(s)" % len(frozen))

    # MARKS AND DRAFTS ARE KEYED BY CARD NUMBER, AND CARD NUMBERS START AGAIN
    # AT 0001 IN EVERY SITTING.
    #
    # So a record left behind in `live/` is not merely stale, it is MISFILED:
    # `notes.load_notes` reads every `NNNN.json` in the directory and hands it
    # to the board keyed by that bare number, and the board lays it over
    # whichever card now carries it. Reported from the device as old
    # annotations showing up on new tutoring text blocks, which is exactly
    # what it was -- last night's ink on card 1, drawn over tonight's card 1.
    #
    # Only the card-keyed ones. A mark on a page of a document is anchored to
    # the document and not to the lesson, and `writing.ann_file` gives those a
    # flattened, digest-carrying name for that reason -- they belong to the
    # workspace and outlive every sitting in it.
    card_key = re.compile(r"^\d{1,4}\.(json|png)$")
    marks = sorted(n for n in os.listdir(live.notes)
                   if card_key.match(n)) if os.path.isdir(live.notes) else []
    if marks:
        ndest = os.path.join(dest, "annotations")
        os.makedirs(ndest, exist_ok=True)
        for n in marks:
            os.rename(os.path.join(live.notes, n), os.path.join(ndest, n))
        print("archived %d annotation file(s)" % len(marks))
    drafts = sorted(n for n in os.listdir(live.text)
                    if re.match(r"^\d{1,4}\.txt$", n)) if os.path.isdir(live.text) else []
    if drafts:
        tdest = os.path.join(dest, "text")
        os.makedirs(tdest, exist_ok=True)
        for n in drafts:
            os.rename(os.path.join(live.text, n), os.path.join(tdest, n))
        print("archived %d typed draft(s)" % len(drafts))
    try:
        with open(os.path.join(dest, "state.json"), "w", encoding="utf-8") as fh:
            json.dump(st, fh, indent=2)
    except OSError:
        pass
    print("archived %d cards to %s" % (len(names), os.path.relpath(dest, live.root)))
    return 0


def cmd_history(live, args):
    """Every past session in this repository, newest first."""
    try:
        names = sorted(os.listdir(live.archive), reverse=True)
    except OSError:
        names = []
    shown = 0
    for name in names:
        folder = os.path.join(live.archive, name)
        if not os.path.isdir(folder):
            continue
        st = {}
        try:
            with open(os.path.join(folder, "state.json"), "r", encoding="utf-8") as fh:
                st = json.load(fh) or {}
        except (OSError, ValueError):
            pass
        cards = len([n for n in os.listdir(folder) if re.match(r"^\d{4}[-_.]", n)])
        turns = 0
        try:
            with open(os.path.join(folder, "turns.jsonl"), "r", encoding="utf-8") as fh:
                turns = len({json.loads(l).get("id") for l in fh if l.strip()})
        except (OSError, ValueError):
            pass
        print("  %-24s %-10s %-28s %2d cards  %2d answered"
              % (name, st.get("session") or "-",
                 (st.get("chapter") or st.get("course") or "-")[:28], cards, turns))
        shown += 1
    if not shown:
        print("nothing archived yet")
    return 0


def cmd_next(live, args):
    kind = args[0] if args and args[0] in KINDS else "lesson"
    rest = args[1:] if (args and args[0] in KINDS) else args
    slug = slugify(" ".join(rest)) if rest else kind
    print(os.path.join(live.cards, "%04d-%s.md" % (live.next_index(), slug)))
    return 0


def cmd_write(live, args):
    """Write a card. With `--over`, write over one that is already on the board.

    `--over` exists for the shape a DOING turn has, and it is the opposite shape
    to a teaching turn's. A teaching turn's card IS the work, so it is written
    first and the board fills immediately. A doing turn's work is a change to the
    repository, and a card written before that change can only describe an
    intention -- which is exactly what happened the first time somebody tapped
    "write the code for me" and got a plan and a question instead of a diff.

    So a doing turn writes one plain sentence saying what it is about to do, which
    lands at once and means the board is never blank, then does the work, then
    writes the REPORT over the top of that sentence. One card in the transcript,
    the truth in it, and nobody watching an empty screen.
    """
    if not args:
        print("usage: board write [--over <card>] <kind> [slug] < body.md",
              file=sys.stderr)
        return 1
    over = None
    if "--over" in args:
        at = args.index("--over")
        if at + 1 >= len(args):
            print("board write: --over needs the card to write over "
                  "(the path `board next` or an earlier `board write` printed)",
                  file=sys.stderr)
            return 1
        over = args[at + 1]
        args = args[:at] + args[at + 2:]
        if not args:
            args = ["lesson"]
    kind = args[0] if args[0] in KINDS else "lesson"
    rest = args[1:] if args[0] in KINDS else args
    # A TITLE IS A TITLE, AND A FLAG IS NOT PART OF IT.
    #
    # `board write lesson --title "Opening: verify the call path"` is the obvious
    # thing to type and there was no such option, so the flag itself went into
    # the title: the board showed a card called `--title Opening: verify the
    # call path` and filed it under `0001-title-opening-verify-...`. The title is
    # what the reader sees at the top of the card and what the transcript is
    # indexed by, so a stray flag in it is visible and permanent.
    #
    # So the flag is accepted, and anything else that looks like one is dropped
    # rather than spelled out in the lesson. An unknown option is a mistake; a
    # mistake printed on the board is a worse one.
    words = []
    skip = False
    for i, a in enumerate(rest):
        if skip:
            skip = False
            continue
        if a in ("--title", "--name", "--slug"):
            skip = True
            if i + 1 < len(rest):
                words.append(rest[i + 1])
            continue
        if a.startswith("--"):
            continue
        words.append(a)
    title = " ".join(words).strip()
    body = sys.stdin.read()
    # The last gate before a card becomes the lesson. A reasoning model that was
    # given a card to write and handed back its own deliberation first -- "the
    # student is asking about the Galois correspondence, let me recall..." -- is
    # a leak with no undo: the card is written, pushed to every device, and
    # committed to the transcript. The tutor is expected to have caught this on
    # the wire; this catches the agent that is not ours, and it only strips a
    # block the card OPENS with, because the body of a lesson is not ours to edit.
    clean = reasoning.strip_reasoning(body, leading_only=True)
    if clean.strip():
        if clean != body:
            print("board write: dropped a block of model reasoning from the top "
                  "of this card", file=sys.stderr)
        body = clean
    # And the shape no strip can help with: thinking with no tag on it, where the
    # whole card is the thought. There is nothing to remove, so this refuses --
    # a turn that writes no card is a wait; a monologue that becomes a card is
    # the lesson, and there is no undo. Reported from a Galois sitting on
    # 1 September 2026, eight hundred tokens of it, cut off mid-sentence.
    #
    # `--force` exists because the judgement is a heuristic and a lesson ABOUT
    # how models reason is a real lesson somebody may one day want to write.
    if "--force" not in args and reasoning.reads_as_reasoning(body):
        print("board write: this reads as deliberation rather than a card -- it "
              "talks about the student instead of to them, or narrates its own "
              "thinking. Nothing was written.\n"
              "Write the card itself: the mathematics, addressed to the student. "
              "If you meant it, pass --force.", file=sys.stderr)
        return 1
    # AND THE SHAPE THE PERSON ACTUALLY COMPLAINED ABOUT: a wall of text.
    #
    # "All tutor responses should be EASY to read. I never want to face a wall
    # of text." `live/TEACHING.md` has asked for that since a card came back
    # correct and unreadable -- five headings, five hundred words -- and asking
    # is what `HANDOFF.md` was doing while it grew to eleven times its cap. A
    # prompt is a preference; this is a door. See `tutorboard/plain.py` for what
    # counts as a wall and what is not counted at all.
    if "--force" not in args:
        bad = plain.wall(body)
        if bad:
            print(plain.says_why(*bad), file=sys.stderr)
            return 1
    if over:
        # Only a card that is already on this board. A path out of an argument is
        # a path somebody could have written anything into, and this one is
        # opened for writing -- so it is resolved and checked against the cards
        # directory rather than trusted, the same rule every other name from
        # outside follows here.
        want = over if os.path.isabs(over) else os.path.join(live.cards, over)
        want = os.path.realpath(want)
        room = os.path.realpath(live.cards)
        if not (want.startswith(room + os.sep) and os.path.isfile(want)):
            print("board write: no card on this board at %r. Write a new one, or "
                  "pass the path an earlier `board write` printed." % over,
                  file=sys.stderr)
            return 1
        path = want
        # The name carries the title, and a report is not called what the
        # sentence it replaced was called. Renaming keeps the index, which is
        # what fixes a card's place in the transcript.
        if title:
            renamed = os.path.join(live.cards, "%s-%s.md"
                                   % (os.path.basename(path)[:4],
                                      slugify(title or kind)))
            if renamed != path:
                try:
                    os.replace(path, renamed)
                    path = renamed
                except OSError:
                    pass
    else:
        name = "%04d-%s.md" % (live.next_index(), slugify(title or kind))
        path = os.path.join(live.cards, name)
    head = "---\nkind: %s\n" % kind
    if title:
        head += "title: %s\n" % title
    head += "---\n"
    # A CARD IS NEVER HALF ON THE BOARD.
    #
    # `open(path, "w")` TRUNCATES before it writes, so between those two moments
    # the file exists and is empty -- and the hub rebuilds the moment it sees
    # this directory change. A build that lands in that window puts a card on the glass
    # with no body: nothing to type, so `typeOut` skips it, so no hold is taken,
    # so the writing surface comes straight down and the NEXT BOARD APPEARS
    # BEFORE THE RESPONSE. On this filer it is worse than a race, because the
    # empty parse is then cached against `(mtime, size)` read through NFS
    # attribute caching and survives until those attributes refresh.
    #
    # Measured in a Galois sitting: card 0041 rendered empty at 10:38:38 and its
    # real body typed 36 seconds later. Reported as "I just submitted a written
    # response and the next board showed up before the tutor response showed
    # up", against a board whose own trace shows both cards typing correctly --
    # because they did. The fault was upstream of the animation entirely.
    #
    # `os.replace` is atomic on POSIX within one directory, so a reader sees the
    # card whole or does not see it at all. Same directory, because a rename
    # across filesystems is a copy and is not atomic.
    tmp = os.path.join(os.path.dirname(path),
                       ".%s.%d.part" % (os.path.basename(path), os.getpid()))
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(head + body.rstrip() + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise
    print(path)
    return 0


def read_turns(live):
    """Every turn, newest revision last. The file is append-only by design."""
    out = []
    try:
        with open(live.path("turns.jsonl"), "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
    except OSError:
        pass
    return out


# ---------------------------------------------------------------------------
# homework: a problem set is a file in the course, and the board tracks it
# ---------------------------------------------------------------------------
def hw_build(live, st):
    """Compile the session's write-up and record what happened in `hw.json`,
    which the board's banner paints. `homework.build` does both; pushing
    calls this too. A pushed `.pdf` older than the `.tex` beside it is a
    finished-looking document missing the exercise the evening was spent on.
    """
    return homework.build(live.root, live.live, st)


def hw_stale(live):
    """The sitting's problem set, if its PDF is missing or older than its source.

    Returns the status dict to build from, or None if there is nothing to do --
    no problem sets in this repository, none bound to this sitting, or a PDF that
    is already newer than the `.tex`.
    """
    try:
        st = homework.status(live.root, live.state())
    except Exception:                                   # noqa: BLE001
        return None
    if not st or not st.get("rel") or not st.get("name"):
        return None
    tex = os.path.join(live.root, st["rel"])
    if not os.path.exists(tex):
        return None
    pdf = homework.compiled_pdf(live.root, tex)
    if pdf and os.path.getmtime(pdf) >= os.path.getmtime(tex):
        return None
    return st


def cmd_session(live, args):
    """The session store, `sessions/<id>/` under the Atlas root.

    board session new ["title"]     a new session, unbound, in teach; prints its id
    board session show [id]         its session.json; no id: TUTORBOARD_SESSION's
    board session list              every session, newest first
    board session end <id>          set `ended`; commit the subject's TUTOR.md and
                                    the artifacts listing the session
    board session reopen <id>       clear `ended`
    board session delete <id>       move it to ~/.local/share/tutor-board/trash/
    """
    sub = args[0] if args else "show"
    rest = args[1:]
    try:
        if sub == "new":
            rec = sessions.new(title=" ".join(rest).strip() or None)
            print(rec["id"])
            print(sessions.path(rec["id"]))
            return 0
        if sub == "list":
            for rec in sessions.all():
                print("%s  %-6s %-5s %-28s %s" % (
                    rec.get("id"), "ended" if rec.get("ended") else "open",
                    rec.get("mode") or "", rec.get("subject") or "(unbound)",
                    rec.get("title") or ""))
            return 0
        if sub == "show":
            sid = rest[0] if rest else sessions.current()
            if not sid:
                print("board session show: name a session id, or run inside one "
                      "(TUTORBOARD_SESSION)", file=sys.stderr)
                return 2
            rec = sessions.get(sid)
            if not rec:
                raise sessions.NoSession("no session %r" % sid)
            print(sessions.show(rec))
            return 0
        if sub in ("end", "reopen", "delete"):
            if len(rest) != 1:
                print("board session %s <id>: name exactly one session" % sub,
                      file=sys.stderr)
                return 2
            sid = rest[0]
            if sub == "reopen":
                sessions.reopen(sid)
                print("reopened %s" % sid)
                return 0
            if sub == "delete":
                print("moved %s to %s" % (sid, sessions.delete(sid)))
                return 0
            rec, ok, said = sessions.end(sid)
            print("ended %s at %s" % (sid, rec.get("ended")))
            if said:
                print(said)
            return 0 if ok else 1
    except sessions.NoSession as exc:
        print("board session %s: %s" % (sub, exc), file=sys.stderr)
        return 1
    print("board session: new | show [id] | list | end <id> | reopen <id> | "
          "delete <id>", file=sys.stderr)
    return 2


def _session_flag(args, who):
    """`(session id, Atlas root, the other words)`: `--session <id>`, else the
    session TUTORBOARD_SESSION names, whose Atlas root holds its store."""
    rest, sid, base = list(args), "", None
    if "--session" in rest:
        n = rest.index("--session")
        if n + 1 >= len(rest):
            raise sessions.Refused("%s: --session needs an id" % who)
        sid = rest[n + 1]
        del rest[n:n + 2]
    elif sessions.current():
        sid = sessions.current()
        here = os.path.abspath(os.environ["TUTORBOARD_SESSION"])
        base = os.path.dirname(os.path.dirname(here))
    return sid, base, rest


def cmd_bind(live, args):
    """Bind the session to a subject, making the subject first if asked.

    board bind <subject> [--session <id>]
        set the session's subject (courses/<name> or projects/<name>) and drop
        a [bind] line that wakes nothing. Nothing is filed and nothing moves.
    board bind <subject> --create [--phi yes|no]
        make the subject, then bind: the slug of the name as its directory,
        tutorboard.json, a TUTOR.md skeleton, and for --phi yes a .gitignore
        keeping phi/, results/ and .env out. One commit. A course holds no
        patient data; a project must say --phi yes or --phi no. With no
        session, it only makes the subject.

    The session is TUTORBOARD_SESSION's, or --session <id>.
    """
    try:
        sid, base, rest = _session_flag(args, "board bind")
        create = "--create" in rest
        rest = [a for a in rest if a != "--create"]
        phi = None
        if "--phi" in rest:
            n = rest.index("--phi")
            said = rest[n + 1].lower() if n + 1 < len(rest) else ""
            if said not in ("yes", "no"):
                print("board bind: --phi yes or --phi no", file=sys.stderr)
                return 2
            if not create:
                print("board bind: --phi goes with --create; an existing "
                      "subject keeps its own answer", file=sys.stderr)
                return 2
            phi = said == "yes"
            del rest[n:n + 2]
        if len(rest) != 1:
            print("usage: board bind <courses/name|projects/name> [--create] "
                  "[--phi yes|no] [--session <id>]", file=sys.stderr)
            return 2
        subject = rest[0]
        if create:
            from tutorboard import subjects
            made, ok, said = subjects.create(subject, phi=phi, base=base)
            if not ok:
                print("board bind: %s was not made: %s" % (subject, said),
                      file=sys.stderr)
                return 1
            print("made %s (phi: %s)" % (made["id"], "yes" if phi else "no"))
            subject = made["id"]
        if not sid:
            if create:
                print("no session to bind; the subject stands on its own")
                return 0
            print("board bind: name a session (--session <id>) or run inside "
                  "one (TUTORBOARD_SESSION)", file=sys.stderr)
            return 2
        rec, changed = sessions.bind(sid, subject, base=base)
        print("%s %s to %s" % ("bound" if changed else "already bound",
                               rec["id"], rec["subject"]))
        return 0
    except (sessions.NoSession, sessions.Refused, ValueError) as exc:
        print("board bind: %s" % exc, file=sys.stderr)
        return 1


def cmd_file(live, args):
    """File an upload into the session's subject.

    board file <upload> [materials|<relpath>] [--session <id>]

    Moves <upload> (a name in the session's uploads/) into the bound subject:
    materials/ by default, or a path inside the subject -- a directory, or the
    file's new name. Its ink moves from the session to <subject>/.ink/,
    re-keyed by the new path. Refused for an unbound session, a path that
    leaves the subject, a hidden or fenced directory, or a name already taken.
    Nothing is committed.
    """
    try:
        sid, base, rest = _session_flag(args, "board file")
        if len(rest) not in (1, 2):
            print("usage: board file <upload> [materials|<relpath>] "
                  "[--session <id>]", file=sys.stderr)
            return 2
        if not sid:
            print("board file: name a session (--session <id>) or run inside "
                  "one (TUTORBOARD_SESSION)", file=sys.stderr)
            return 2
        got = sessions.file(sid, rest[0], rest[1] if len(rest) == 2 else None,
                            base=base)
    except (sessions.NoSession, sessions.Refused) as exc:
        print("board file: %s" % exc, file=sys.stderr)
        return 1
    print("filed %s -> %s/%s" % (got["from"], got["subject"], got["to"]))
    for old, new in sorted(got["keys"].items()):
        print("    ink %s -> %s" % (old, new))
    return 0


def _sid(live):
    """The stored session's id, or None for a workspace's live/."""
    return os.path.basename(live.live.rstrip(os.sep)) if live.stored else None


def _sent_page(live, want=None):
    """`(path, turn id)` of the newest sent page, or of turn `want`; `(None,
    why)` when there is none on disk."""
    turns = [t for t in read_turns(live) if t.get("png")]
    if want:
        turns = [t for t in turns if t.get("id") == want]
    if not turns:
        return None, ("no turn %s with a sent page" % want) if want else "no sent page"
    turn = turns[-1]
    src = os.path.join(live.session, turn["png"].lstrip("/"))
    if not os.path.exists(src):
        src = os.path.join(live.answers, os.path.basename(turn["png"]))
    if not os.path.exists(src):
        return None, "the page for %s is not on disk: %s" % (turn["id"], turn["png"])
    return src, turn.get("id")


def _writeup_status(live, st):
    print("%s  %s" % (st["name"], st["rel"]))
    if not st["problems"]:
        print("  no problems written yet")
    for p in st["problems"]:
        if not p["stated"]:
            mark = "statement not transcribed"
        elif p["written"]:
            mark = "written up"
        elif p["region"]:
            mark = "EMPTY"
        else:
            mark = "no solution region"
        print("  %-6s %s" % (p["label"], mark))
    print("  %d of %d written up" % (st["written"], st["total"]))
    # A sheet can be worked in any order; the document is written in the
    # sheet's. So say what is left, in order, and where the next answer goes.
    left = st.get("outstanding") or []
    if left:
        print("  still to write up, in order: %s" % ", ".join(left))
        print("  next: %s" % st["next"])
    elif st["total"]:
        print("  the whole set is written up")
    rec = read_hw_build(live)
    if rec:
        print("  last build: %s at %s" % ("ok" if rec["ok"] else "FAILED", rec["iso"]))


def cmd_writeup(live, args):
    """The session's write-up: every agreed answer, typeset and built.

    board writeup add <label> [--turn tNN] [--no-page] [--no-build] < text
        stdin is the STATEMENT, a line `---`, then THEIR agreed argument. Writes
        both into the write-up (the label's region, replaced if it was filled;
        a new problem appended where the file has no such label), copies the
        newest sent page (or turn tNN's) into handwritten/<set>-<label>.png, and
        rebuilds the PDF. Fenced ``` code blocks are set verbatim.
    board writeup new [title]    start it now rather than at the first add
    board writeup build          rebuild the PDF; a failure reaches the banner
    board writeup status         which file, what is written, what is next
    board writeup use <name>     write into this course set (hw04, ch07)
    board writeup list           every problem set in the subject
    board writeup file <label> [--turn tNN]   file a sent page only

    The first add or new makes the write-up: the bound homework set, in place,
    when the session is on one (`use`, or a title naming it), else
    docs/<session-slug>/writeup.tex from board/tex/writeup.tex.in. A session
    bound to no subject refuses: `board bind` first. `board hw` is the same
    command under its old name.
    """
    sub = args[0] if args else "status"
    rest = args[1:]
    state = live.state()
    if live.stored and not state.get("subject"):
        print("this session is bound to no subject, so it has nowhere to write "
              "up: `board bind courses/<name>` or `board bind projects/<name>` "
              "first", file=sys.stderr)
        return 1

    if sub == "use":
        if not rest:
            print("usage: board writeup use <name or path>   (board writeup list "
                  "shows them)", file=sys.stderr)
            return 1
        want = rest[0]
        for s in homework.sets(live.root):
            if want in (s["name"], s["rel"]) or os.path.abspath(want) == s["tex"]:
                live.set_state(hw=s["rel"])
                print("this session writes into %s  (%s)" % (s["name"], s["rel"]))
                return 0
        print("no problem set called %r here" % want, file=sys.stderr)
        return 1

    if sub in ("--list", "list"):
        every = homework.sets(live.root)
        if not every:
            print("this subject has no problem sets; `board writeup add` starts "
                  "the session's own write-up")
            return 1
        for s in every:
            print("  %-8s %s" % (s["name"], s["rel"]))
        return 0

    if sub in ("new", "add"):
        title = None
        if sub == "new":
            title = " ".join(a for a in rest if not a.startswith("--")) or None
        try:
            found, made = homework.start(live.root, state, session=_sid(live),
                                         title=title,
                                         author=(state or {}).get("student") or "")
        except ValueError as exc:
            print("board writeup: %s" % exc, file=sys.stderr)
            return 1
        if found["rel"] != state.get("hw"):
            live.set_state(hw=found["rel"])
        if made:
            print("started %s" % found["rel"])
        if sub == "new":
            if not made:
                print("this session writes into %s  (%s)" % (found["name"], found["rel"]))
            return 0
        if not rest or rest[0].startswith("--"):
            print("usage: board writeup add <label> [--turn tNN] [--no-page] "
                  "[--no-build] < statement, a line ---, then the argument",
                  file=sys.stderr)
            return 2
        label = rest[0]
        statement, argument = homework.split_input(sys.stdin.read())
        said, why = homework.add(found["tex"], label, statement, argument)
        if not said:
            print("board writeup add: %s" % why, file=sys.stderr)
            return 1
        print("%s %s in %s (statement %s)" % (
            {"filled": "wrote", "replaced": "rewrote", "added": "added"}[said["region"]],
            said["label"], found["rel"], said["statement"]))
        if "--no-page" not in rest:
            src, which = _sent_page(live, _flag_value(rest, "--turn"))
            if src:
                dest = homework.file_page(src, found, said["label"])
                print("filed %s's page as %s" % (which, os.path.relpath(dest, live.root)))
            else:
                print("no page filed: %s" % which)
        if "--no-build" in rest:
            return 0
        code, pdf, out = hw_build(live, found)
        if code == 0:
            print("built %s" % os.path.relpath(pdf, live.root) if pdf else out)
        else:
            print("BUILD FAILED -- the error is on the board's banner; fix it "
                  "and run board writeup build:\n" + out)
        return code

    st = homework.status(live.root, state)
    if st is None or (not st["name"] and not st["ambiguous"]):
        print("no write-up yet; the first `board writeup add <label>` starts one")
        return 1 if sub == "build" else 0
    if not st["name"]:
        print("cannot tell which set this session is. Pin one, or let the first "
              "add start the session's own:")
        print("  board writeup use %s" % (st["ambiguous"][0] if st["ambiguous"] else "<name>"))
        print("%d to choose from; board writeup list shows them all" % len(st["ambiguous"]))
        return 1

    if sub == "status":
        _writeup_status(live, st)
        return 0

    if sub == "build":
        code, pdf, out = hw_build(live, st)
        print(out)
        if pdf:
            print(pdf)
        return code

    if sub == "file":
        if not rest:
            print("usage: board writeup file <problem label> [--turn tNNNN]",
                  file=sys.stderr)
            return 1
        src, why = _sent_page(live, _flag_value(rest, "--turn"))
        if not src:
            print(why, file=sys.stderr)
            return 1
        dest = homework.file_page(src, st, rest[0])
        print(os.path.relpath(dest, live.root))
        return 0

    print("unknown: board writeup %s  (add, new, build, status, use, list, file)"
          % sub, file=sys.stderr)
    return 1


def _flag_value(args, name):
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args):
            return args[i + 1]
    return None


def read_hw_build(live):
    return homework.last_build(live.live)


def read_messages(live):
    out = []
    try:
        with open(os.path.join(live.inbox, "messages.jsonl"), "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
    except OSError:
        pass
    return out


def cmd_inbox(live, args):
    show_all = "--all" in args
    msgs = read_messages(live)
    pick = msgs if show_all else [m for m in msgs if not m.get("read")]
    if not pick:
        print("inbox empty")
        return 0
    for m in pick:
        print("[%s] %s" % (m.get("iso", "?"), m.get("text", "")))
        for f in m.get("files", []):
            print("    file: %s" % os.path.join(live.uploads, f))
        if m.get("slate"):
            print("    slate: %s" % m["slate"])
    if not show_all:
        for m in msgs:
            m["read"] = True
        with open(os.path.join(live.inbox, "messages.jsonl"), "w", encoding="utf-8") as fh:
            for m in msgs:
                fh.write(json.dumps(m) + "\n")
    return 0


def cmd_finish(live, args):
    """Raise the end-of-session offer on the board.

    The user is on an iPad, so the question has to be asked there rather than in
    a terminal they are not looking at.
    """
    live.set_state(finished=time.strftime("%Y-%m-%d %H:%M"))
    print("the board is now offering to save and push this session's work")
    return 0


def cmd_push(live, args):
    """Commit and push. It does not end the session, in any repository.

    A lesson is filed by `board archive` and by `board open`, and by nothing
    else: the same tap has to mean the same thing in a `code` course and in a
    maths one.

    ONE PATH TO A COMMIT. `gitops.save` is what the save button runs through
    `lesson/git.py` too -- two doors onto one commit. The commit belongs to the
    repository the workspace is in.

    It commits THIS WORKSPACE and nothing else, with the pathspec
    `lesson_git.save_pathspec` builds for the save button too: never the tool,
    another workspace or NFS litter. `board push "msg" -- <paths>` narrows it
    to those paths, which is how a turn commits the work it did under a message
    naming the thread; a path outside the workspace is refused. Where a thread
    file exists, a `<word>: ` lead must be one of its threads, or nothing is
    committed (`threads.commit_prefix`).
    """
    from tutorboard.lesson import git as lesson_git
    only = None
    if "--" in args:
        cut = args.index("--")
        args, only = args[:cut], args[cut + 1:]
        if not only:
            print("`--` with no paths after it: name what to commit",
                  file=sys.stderr)
            return 1
    message = " ".join(a for a in args if not a.startswith("--")) or gitops.SAVE

    # A SUBJECT THAT NAMES A THREAD NAMES A REAL ONE. `<thread>: msg` is how a
    # turn files its work under the question it answers, and a typo there is a
    # commit nobody finds by its thread again. Only where a valid thread file
    # exists; a broken one is `board thread --check`'s to report, not a save's.
    spine, broken = course_threads.read(live.root)
    if spine and not broken:
        _tid, wrong = course_threads.commit_prefix(
            spine, message, atlas.identify(live.root))
        if wrong:
            detail = "nothing was committed: " + wrong
            print(detail, file=sys.stderr)
            with open(live.path("push.json"), "w", encoding="utf-8") as fh:
                json.dump({"ok": False, "at": time.time(),
                           "iso": time.strftime("%Y-%m-%d %H:%M:%S"),
                           "detail": detail}, fh, indent=2)
            return 1

    # Never into the middle of an operation somebody started in a terminal. This
    # runs unattended -- `board finish` raises the offer and the tutor may push
    # on its own -- and a repository part-way through a rebase has its own plan
    # for the next commit. Say what is in the way and change nothing.
    busy = worktree.busy_reason(live.root)
    if busy:
        detail = ("nothing was committed: %s in this repository, so a commit now "
                  "would land in the middle of it. Nothing has been lost -- "
                  "finish or abort that, then save again." % busy)
        print(detail, file=sys.stderr)
        with open(live.path("push.json"), "w", encoding="utf-8") as fh:
            json.dump({"ok": False, "at": time.time(),
                       "iso": time.strftime("%Y-%m-%d %H:%M:%S"),
                       "detail": detail}, fh, indent=2)
        return 1

    # AND NOTHING THAT REACHES FOR SESSION CONTENT, WHICH IS THE CHECK GIT
    # CANNOT MAKE. A `.gitignore` keeps the fenced directory out of the index,
    # so a diff cannot carry a phi FILE. It can carry phi CONTENT -- a fixture
    # cut out of a transcript, an example hard-coded from one -- written by the
    # one assistant allowed to read that directory and pushed by a turn that is
    # not. `ai-config/policy/phi.py` is the lab's own rule and this is the first
    # thing that calls it. See `tutorboard/leaving.py` for what it does and does
    # not catch.
    #
    # `--anyway` is the override and it is deliberately a keyboard act: a tap
    # that waves a PHI fence through from a tablet is the thing the fence is
    # for. From the iPad the way past this is to tell the tutor, which is a
    # person deciding and an assistant acting.
    if "--anyway" not in args:
        phi = leaving.reason(live.root)
        if phi:
            print(phi, file=sys.stderr)
            with open(live.path("push.json"), "w", encoding="utf-8") as fh:
                json.dump({"ok": False, "at": time.time(),
                           "iso": time.strftime("%Y-%m-%d %H:%M:%S"),
                           "detail": phi}, fh, indent=2)
            return 1

    # A THREAD HELD AT THE CLUSTER IS THE CLUSTER'S. Its files are being written
    # there, beside the data; a commit of them from here is the one thing that
    # makes the two machines' pulls conflict. See `tutorboard/holds.py`.
    held = holds.refusal(live.root, only)
    if held:
        print(held, file=sys.stderr)
        with open(live.path("push.json"), "w", encoding="utf-8") as fh:
            json.dump({"ok": False, "at": time.time(),
                       "iso": time.strftime("%Y-%m-%d %H:%M:%S"),
                       "detail": held}, fh, indent=2)
        return 1

    # The write-up is part of the work, so it is part of the commit.
    #
    # An exercise is finished when it is typeset, not when it is agreed: the
    # point of the hour is the piece of mathematics, and the `.tex` is where that
    # lives. But compiling it was a step the tutor had to remember, in a turn
    # that had already delivered its card -- and a session ends by being
    # abandoned far more often than it ends tidily. What got pushed was then a
    # `.tex` containing tonight's proof and a `.pdf` from last week that does
    # not, which is worse than no PDF at all: it looks finished and is silently
    # missing the exercise the evening was spent on.
    #
    # Only when it is actually out of date, so an ordinary save costs nothing.
    if "--no-build" not in args:
        stale = hw_stale(live)
        if stale is not None:
            print("the write-up is newer than its PDF; compiling %s first"
                  % stale["name"])
            code, pdf, out = hw_build(live, stale)
            if code == 0:
                print("  built %s" % (pdf or "the document"))
            else:
                # Push anyway. The source is the record and losing it to a LaTeX
                # error is the one outcome worse than a stale PDF -- but say so
                # loudly, and the board says so too, because the person is not
                # reading this terminal.
                print("  BUILD FAILED — pushing the source anyway; the PDF will "
                      "be behind until it is fixed:")
                print("  " + "\n  ".join(out.strip().splitlines()[-8:]))

    # `top` decides which repository is committed, and the pathspec what in it.
    top = lesson_git.repo_top(live.root)
    specs, refused = lesson_git.save_pathspec(live.root, top, only)
    if refused:
        print("not in this workspace, so not committed from here: "
              + ", ".join(refused), file=sys.stderr)
        return 1

    # THE WORKSPACE LEADS THE MESSAGE, exactly as it does for the save button in
    # `lesson/git.py`. One repository, one history: a commit carrying the whole
    # tree under a bare "lesson complete" is one nobody can find again, and the
    # two doors would otherwise write two different kinds of subject for the
    # same commit.
    where = atlas.identify(live.root)
    if where and not message.startswith(where):
        message = "%s: %s" % (where, message)

    ok, out = gitops.save(top, specs, message)
    print(out)
    # THE SAME RECORD EITHER DOOR WROTE IT. `push.json` is what the board reads
    # to draw the last outcome, shaped exactly as `lesson/git.py` shapes it.
    record = {"ok": ok, "at": time.time(),
              "iso": time.strftime("%Y-%m-%d %H:%M:%S"),
              "workspace": where, "detail": out[-1200:]}
    with open(live.path("push.json"), "w", encoding="utf-8") as fh:
        json.dump(record, fh, indent=2)
    st = live.state()
    if st.pop("finished", None) is not None:
        with open(live.path("state.json"), "w", encoding="utf-8") as fh:
            json.dump(st, fh, indent=2)

    # A save is a save everywhere, and it files nothing away: `board archive`
    # and `board open` are what file a lesson, and they are the only things
    # that do.
    return 0 if ok else 1


def cmd_slate(live, args):
    """Where the iPad pages are on disk. Open the PNGs -- that is the handwriting."""
    pages = sorted(n for n in os.listdir(live.slate) if re.match(r"^page-\d+\.png$", n))
    if not pages:
        print("slate empty")
        return 0
    show = pages if "--all" in args else pages[-6:]
    if len(show) < len(pages):
        print("(%d earlier pages not listed; --all for all)" % (len(pages) - len(show)))
    for n in show:
        p = os.path.join(live.slate, n)
        print("%s  %s  %.0f KiB" % (
            time.strftime("%H:%M:%S", time.localtime(os.path.getmtime(p))),
            p, os.path.getsize(p) / 1024.0))
    return 0


def card_meta(raw):
    """Front matter and body of a card, without pulling in a YAML parser."""
    meta, text = {}, raw
    if raw.startswith("---"):
        end = raw.find("\n---", 3)
        if end != -1:
            for line in raw[3:end].splitlines():
                if ":" in line:
                    k, v = line.split(":", 1)
                    meta[k.strip().lower()] = v.strip()
            text = raw[end + 4:].lstrip("\n")
    return meta, text


def cmd_recap(live, args):
    """The lesson so far, compactly, in ONE command.

    This exists to be cheap. An assistant picking a course up cold used to be
    told to read every card in `live/cards/` in order, which is one tool round
    trip per card -- and on a model billed by the token every round trip resends
    the whole conversation, so a twelve-card lesson costs twelve times the
    growing context before a word of teaching is written. What it actually needs
    is the shape of the lesson, the last thing it said, and the last thing the
    student did.

    So: one line per card, the newest cards in full, and the student's latest
    turn with its file paths. `--cards N` widens the full window; `--all` prints
    every card in full for the rare case where that is genuinely wanted.
    """
    names = live.card_names()
    turns = read_turns(live)
    st = live.state()

    full = 1
    if "--cards" in args:
        try:
            full = max(0, int(args[args.index("--cards") + 1]))
        except (IndexError, ValueError):
            pass
    if "--all" in args:
        full = len(names)

    head = " — ".join(x for x in (st.get("course"), st.get("session"),
                                  st.get("chapter")) if x)
    print(head or "no session open")
    hw = st.get("hw")
    if hw:
        print("homework set: %s" % hw)

    # Newest revision per turn id: the file is append-only and a correction
    # supersedes in place, so an older revision is not part of the lesson.
    newest = {}
    for t in turns:
        tid = t.get("id")
        if tid and t.get("rev", 1) >= newest.get(tid, {}).get("rev", 0):
            newest[tid] = t
    live_turns = sorted(newest.values(), key=lambda t: t.get("t") or 0)
    answered = {t.get("answers") for t in live_turns if t.get("answers")}

    if not names:
        print("no cards yet — nothing has been taught in this session")
    else:
        print("%d card(s), %d student turn(s)\n" % (len(names), len(live_turns)))
        # The one thing in the recap that still grew with the lesson. A hundred
        # and seven cards is 6.4k of titles, read at the start of every turn,
        # for a shape a turn acts on the recent end of -- and the older end is
        # what HANDOFF.md is for. So the list is the last LINES of them, with
        # the earlier ones counted rather than named; `--all` prints the lot.
        shown = names if full >= len(names) else names[-LINES:]
        if len(shown) < len(names):
            print("  (%d earlier card(s) not listed — HANDOFF.md is what carries "
                  "the chapter, `board recap --all` lists them)"
                  % (len(names) - len(shown)))
        for n in shown:
            with open(os.path.join(live.cards, n), "r", encoding="utf-8") as fh:
                meta, _ = card_meta(fh.read())
            cid = n[:4]
            mark = ""
            kind = (meta.get("kind") or "lesson").lower()
            if kind == "question":
                mark = "  <- answered" if cid in answered or n in answered \
                       else "  <- OPEN, not answered yet"
            print("  %s %-9s %s%s" % (cid, kind, meta.get("title", ""), mark))

    for n in names[len(names) - full:] if full else []:
        with open(os.path.join(live.cards, n), "r", encoding="utf-8") as fh:
            raw = fh.read()
        # Read back through the same gate the board reads through. A tutor whose
        # own deliberation ended up in a card should see that the turn did not
        # land -- and should certainly not be fed its own private working back as
        # though it were the lesson so far.
        meta_r, body_r = card_meta(raw)
        clean = reasoning.card_body(body_r)
        if clean != body_r:
            raw = raw[:len(raw) - len(body_r)] + clean
        print("\n--- %s, in full ---\n%s" % (n, raw.strip()))

    # What the student has actually done, one line each. A fresh session picking
    # this lesson up needs to know where they went wrong three cards ago without
    # re-reading three cards, and this is the cheap form of that.
    if len(live_turns) > 1:
        print("\ntheir turns so far:")
        for t in live_turns[:-1]:
            what = (t.get("text") or "").strip().replace("\n", " ")
            if t.get("signal"):
                what = "[%s] %s" % (t["signal"], what)
            if t.get("png") and not what:
                what = "handwriting"
            print("  %-19s %-6s %s" % (t.get("iso") or "?",
                                       ("-> " + t["answers"]) if t.get("answers") else "",
                                       what[:96]))

    if live_turns:
        t = live_turns[-1]
        print("\n--- their most recent turn (%s) ---" % (t.get("iso") or "?"))
        if t.get("answers"):
            print("answers card %s" % t["answers"])
        if t.get("signal"):
            print("signal: %s" % t["signal"])
        if t.get("text"):
            print(t["text"].strip())
        if t.get("png"):
            print("handwriting: %s" % os.path.join(live.session, str(t["png"]).lstrip("/")))
        for f in t.get("files", []) or []:
            print("file: %s" % os.path.join(live.uploads, f))

    unread = [m for m in read_messages(live) if not m.get("read")]
    if unread:
        print("\n%d unread message(s) in the inbox — `board inbox` has them"
              % len(unread))
    return 0


def cmd_brief(live, args):
    """Everything a cold turn is bound by, in ONE call.

    Every turn is its own session, so every turn is a cold turn. The brief is
    the method, the subject's RULES.md at HEAD and its TUTOR.md, with
    board/TEACHING.md named at the bottom for the rare rule that needs its
    detail (`tutorboard.brief`).

    Pair it with `board recap`, which is the other half: this is the standing
    rules, that is the lesson so far. Two calls, and a turn needs nothing else
    before it can teach.

    AND A MISSION IS BRIEFED AS A DOING TURN. `/elsewhere` writes the task into
    the target's inbox as a sentence of the student's and nothing else, so this
    briefing is the whole of what a mission reads -- and a session in teach
    mode would brief a change somebody asked for as a lesson. `missions.running`
    is that question, asked here because this is the only place that knows it
    is answering a cold turn. Only ever `True`: a session in do mode keeps
    saying it.

    AND THE RECORD IS CARRIED, NOT JUST THE ANSWER. A mission replaces the
    sitting in the briefing rather than decorating it -- see
    `sense.MISSION_SENSE` -- and the trail it is told to read is named for the
    mission, so the briefing needs to know which one is running.
    """
    rec = missions.live_mission(live.root)
    fixing = None if rec else _repairing(live)
    sys.stdout.write(brief.briefing(
        live, sense, doing=True if rec or fixing is not None else None,
        mission=rec,
        repair=jobs.repair_brief(live.root, fixing) if fixing is not None
        else None))
    return 0


def _repairing(live):
    """The requests a `[repair]` turn in flight was woken for -- `[""]` where
    no inbox line says -- or None when this is no repair turn.

    A FAILED CLUSTER JOB IS REPAIRED BY A DOING TURN, whatever the workspace
    teaches under, the way a mission is: a teaching workspace would otherwise
    brief a broken job as a lesson about it. The daemon records every
    `[repair]` request in the batch the turn was woken with (`turn_repairs` in
    `live/agent.json`, `woken_for` in runner/turn.py), so one behind a student's
    message counts; a record without it falls back to the signal and the
    newest `[repair]` line (`jobs.drop`).
    """
    st = inside_a_daemon_turn(live)
    if not st:
        return None
    rids = st.get("turn_repairs")
    if isinstance(rids, list) and [r for r in rids if isinstance(r, str) and r]:
        return [r for r in rids if isinstance(r, str) and r]
    if st.get("turn_signal") != jobs.REPAIR:
        return None
    return [jobs.last_repair(live.root)]


def cmd_memo(live, args):
    """Write one section of the bound subject's TUTOR.md. Body on stdin.

        board memo Now < now.md              replace the "Now" section
        board memo "Open decisions" --append < more.md
                                             add to the end of a section
        board memo --show                    print TUTOR.md

    The sections are "Where things are", "Now", "Open decisions" and "Done
    recently"; a section name is matched without regard to case. A missing
    TUTOR.md starts as their skeleton. The whole file is capped at 800 words
    and the cap refuses rather than trims, naming the count: the brief carries
    the file on every turn. Only TUTOR.md is ever written; RULES.md is the
    owner's.
    """
    if live.stored and live.atlas and \
            os.path.realpath(live.root) == os.path.realpath(live.atlas):
        print("board memo: this session is bound to no subject, so there is no "
              "TUTOR.md. `board bind courses/<Name>` or `board bind "
              "projects/<Name>` first.", file=sys.stderr)
        return 1
    if "--show" in args:
        text = memo.tutor(live.root)
        print(text if text else "no TUTOR.md")
        return 0
    append = "--append" in args
    words = [a for a in args if not a.startswith("--")]
    if not words:
        print("board memo: name the section: %s"
              % ", ".join('"%s"' % x for x in memo.SECTIONS), file=sys.stderr)
        return 1
    body = sys.stdin.read()
    try:
        path, n = memo.write(live.root, " ".join(words), body, append=append)
    except memo.Refused as why:
        print("board memo: %s" % why, file=sys.stderr)
        return 1
    print("%s (%d of %d words)" % (path, n, memo.WORDS))
    return 0


def cmd_step(live, args):
    """One line saying what this mission has just FINISHED. Body on stdin.

        board step < line           add it
        board step "ran the suite"  or as an argument
        board step --show           print the whole trail

    THE ASK: *"Whenever an agent is dispatched in some way, make it so that if
    I click on that box that says 'A Mission is still going' I can see what has
    been going on and been accomplished thus far."*

    A doing turn writes one sentence, does the work, and writes the report over
    the top of it. On a local model that prefills for hours, BOTH of those
    arrive hours in -- one mission ran five hours, took a pick-up, and had put
    nothing anywhere. This is the line in between, and there is one per finished
    thing rather than one per turn.

    What is DONE, never what is about to be. A trail of intentions is a plan,
    and a plan on the glass reads as work that happened.

    It lands on every mission in this workspace that has not ended, which is
    one of them: a workspace runs a mission at a time. Where there is no
    mission this refuses and says so, because a step written nowhere is worse
    than a command that is not there.

    `--show` prints the trail with times, the board's own lines marked. It is
    what a turn picked up after a node hop reads to find out what the four
    hours before it achieved -- and `board brief` already carries it, so the
    flag is for looking rather than for a turn's first move.
    """
    open_now = progress.open_ids(missions.stored(live.root))
    if "--show" in args:
        if not open_now:
            print("no mission is running in this workspace")
            return 0
        for mid in open_now:
            trail = progress.read(live.root, mid)
            print("-- mission %s: %d step(s)" % (mid, len(trail)))
            for one in trail:
                print("   %s  %s%s"
                      % (time.strftime("%H:%M", time.localtime(one["at"])),
                         "" if one["who"] == "agent" else "[board] ",
                         one["said"]))
        return 0
    said = " ".join(a for a in args if not a.startswith("-")).strip()
    if not said:
        said = sys.stdin.read().strip()
    if not said:
        print("board step: say what you finished, on stdin or as an argument",
              file=sys.stderr)
        return 1
    if not open_now:
        print("board step: no mission is running in this workspace, so there "
              "is nobody waiting on a progress line. Write a card instead.",
              file=sys.stderr)
        return 1
    # TRUNCATED RATHER THAN REFUSED, which is the opposite of `board memo` and
    # is the right way round for this one. TUTOR.md is read at the start of
    # every turn, so length there is paid over and over and the cap is a door.
    # A step is read once by a person watching, and a refused step is a step
    # that never happened -- which is the defect this command exists for.
    hit = 0
    for mid in open_now:
        if progress.add(live.root, mid, said):
            hit += 1
    if not hit:
        print("board step: the trail could not be written", file=sys.stderr)
        return 1
    n = len(progress.read(live.root, open_now[0]))
    print("step %d on mission %s%s"
          % (n, open_now[0],
             " (cut to %d characters)" % progress.STEP_CHARS
             if len(said) > progress.STEP_CHARS else ""))
    return 0


def cmd_handoff(live, args):
    """Write HANDOFF.md, capped, stamped with its chapter. Body on stdin.

        board handoff < handoff.md   replace it
        board handoff --show         print what is there
        board handoff --check        say how long it is

    This is the ONLY thing that should write that file, and it is written ONCE,
    by the wrap-up turn at the end of a session -- not edited during a teaching
    turn. A turn that edits it pays to read 5k tokens of it first, adds a
    paragraph, and hands the next turn a longer file; do that for a fortnight
    and the cap in the prompt is a decoration. Keep TUTOR.md with `board memo`
    instead.

    The cap refuses rather than trims, because the useful half of a handoff is
    at the bottom: what to teach next. Cutting the tail keeps the description
    and throws away the instruction.
    """
    if "--show" in args:
        text, about = handoff.read_handoff(live.root)
        if not text.strip():
            print("no handoff")
            return 0
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
        return 0
    if "--check" in args:
        n, over = handoff.handoff_length(live.root)
        if not n:
            print("no handoff")
            return 0
        print("%d words, cap %d%s"
              % (n, handoff.HANDOFF_WORDS, (", OVER by %d" % over) if over else ", ok"))
        return 1 if over else 0
    body = sys.stdin.read()
    kept, n, over = handoff.write_handoff(
        live.root, body, chapter=live.state().get("chapter") or "")
    if over:
        print("board handoff: %d words, and the cap is %d. Nothing was written.\n"
              "It is read at the start of every turn of every future session, so "
              "length here is a cost paid over and over. Keep: where they got to "
              "by topic, what they got wrong and what the misunderstanding was, "
              "what they got right so it is not re-taught, and the one next thing."
              % (n, handoff.HANDOFF_WORDS), file=sys.stderr)
        return 1
    if not kept:
        print("board handoff: nothing on stdin; the handoff was left alone",
              file=sys.stderr)
        return 1
    print("%s (%d words)" % (handoff.handoff_path(live.root), n))
    return 0


def cmd_direction(live, args):
    """What this workspace is FOR, in their words. Body on stdin.

        board direction --show          print what is in force
        board direction < what.md       replace it (the person's words, not yours)
        board direction --clear         back to what the repository's own
                                        documents say

    THIS IS THEIRS, NOT YOURS. It is set from the board, in one tap, at the
    moment somebody realises the whole shape of the work is wrong -- and what it
    says then outranks the plan, the map, the README and the handoff, all of
    which were written for the direction it replaced. A turn does not need this
    command to read it: `board brief` puts it at the top of every briefing.

    Writing one from a turn is for the case where they said it in a message
    rather than by tapping the button, and it is still their sentence that goes
    in. Do not paraphrase it into your own plan; the plan is the file you then
    rewrite to match.
    """
    if "--show" in args:
        text, when = direction.read(live.root)
        if not text:
            print("no direction set; the repository's own documents stand")
            return 0
        print("set %s\n%s" % (when or "at some point", text))
        return 0
    if "--clear" in args:
        direction.clear(live.root)
        print("direction cleared")
        return 0
    body = sys.stdin.read()
    kept, when = direction.write(live.root, body)
    if not kept:
        print("board direction: nothing on stdin; what is in force was left "
              "alone", file=sys.stderr)
        return 1
    print("%s (set %s)" % (direction.path(live.root), when))
    return 0


def cmd_round(live, args):
    """File the ink on one document as a round of its ledger, and print it.

        board round <document>          file the marks on it as numbered
                                        requests and print the ledger and ids
        board round <document> --print  the same, with every request in full

    INK ON A DOCUMENT IS ANSWERED IN ITS LEDGER. Marks on a paper, deck or
    write-up reach a turn by more than one road -- the library's note panel,
    the board's document drawer, a sitting -- and only a round in the ledger
    turns them into pairs the owner can tap through, and takes them off the
    page once answered. So a turn asked to act on marks runs this first, then
    answers every id in the `answers` of the ledger it prints. Write no record
    of your own beside it: ink answered anywhere else stays on the page.

    `<document>` is either name a document has: the library's id, or the one
    in a mark's key (`doc/<name>/p<n>`). Nothing is woken. Where the newest
    round has not been answered yet, that round is printed rather than the
    same ink filed twice. With no ink and nothing reopened, nothing is filed.
    """
    from tutorboard.course import ledger, library

    want = [a for a in args if not a.startswith("--")]
    if not want:
        print("board round: which document? `board round <document>`; the "
              "library's ids are on /library and in `board doctor`",
              file=sys.stderr)
        return 1
    root = live.root
    doc = library.find_any(root, want[0])
    if not doc:
        print("board round: this workspace has no document called %r" % want[0],
              file=sys.stderr)
        return 1
    rs = ledger.rounds(root, doc)
    if rs and not ledger.landed(root, doc, rs[-1][1]):
        path, filed = rs[-1][1], False
    else:
        rec = library.write_note(live, doc["id"], "", hand_over=True)
        if not rec.get("ok") or not rec.get("ledger"):
            print("board round: nothing to file on %s: there is no ink on it "
                  "and no request reopened. %s" % (doc["title"], rec.get("error") or ""),
                  file=sys.stderr)
            return 1
        path, filed = rec["path"], True
    led = ledger._read(ledger.ledger_path(path), {}) or {}
    rel = os.path.relpath(ledger.ledger_path(path), root).replace(os.sep, "/")
    ids = [i.get("id") for i in led.get("items") or [] if isinstance(i, dict)]
    print(rel)
    print("round %s of %s, %s: %d request%s, %s" % (
        led.get("round") or "?", doc["title"],
        "filed now" if filed else "filed %s and not answered yet" % (led.get("filed") or ""),
        len(ids), "" if len(ids) == 1 else "s", ", ".join(ids)))
    print("Answer every id in that file's `answers`: a disposition (done, partly, "
          "not done, pushed back), `did` -- one sentence, and for not done and "
          "pushed back the reply the owner reads beside their ink -- and for done "
          "and partly `new`, the new wording copied exactly from the source.")
    if "--print" in args:
        for it in led.get("items") or []:
            if not isinstance(it, dict):
                continue
            line = "%s  %s, page %s" % (it.get("id"), it.get("kind"), it.get("page") or "-")
            if it.get("crop"):
                line += "  crop %s" % it["crop"]
            print(line)
            if it.get("text"):
                print("    " + str(it["text"]).replace("\n", "\n    "))
            if it.get("reopened_because"):
                print("    reopened because: %s" % it["reopened_because"])
    return 0


def cmd_deckfig(live, args):
    """Copy one more figure into a deck whose brief lists it.

        board deckfig <deck dir> <subject> <result id>

    The deck is a directory holding `_brief.json` -- the meeting deck is
    `docs/meeting` in projects/Meetings -- named relative to this session's
    subject, or to the Atlas root. The figure is copied into the deck's
    `figures/` as `<subject>--<id>.<ext>`, and the path to put in
    `\\includegraphics` is printed. Open the image before you put it on a slide.

    AN ID, OR A WORD FROM ITS NAME: a word that picks out exactly one figure in
    that subject is taken as it, and one that matches several lists them.

    NAMES, NEVER PATHS. The subject is one the deck's brief was made from, and
    the id is one that subject's results offer -- `results.find` resolves it and
    asks the fence again before the file is opened. Anything else is refused,
    in a sentence.
    """
    if len(args) != 3:
        print("board deckfig: say the deck, the subject and the result id -- "
              "board deckfig <deck dir> <subject> <result id>", file=sys.stderr)
        return 1
    want_deck, want_ws, want_id = args
    base = atlas.root() or live.root
    deck = None
    for top in (live.root, base):
        here = os.path.realpath(os.path.join(top, want_deck))
        if paths.within(here, os.path.realpath(base)) \
                and os.path.isfile(os.path.join(here, briefs.BRIEF_JSON)):
            deck = here
            break
    if not deck:
        print("board deckfig: %s holds no %s, so it is not a deck with a brief"
              % (want_deck, briefs.BRIEF_JSON), file=sys.stderr)
        return 1
    found = subjects.find(want_ws, base)
    if not found:
        print("board deckfig: %s is not a subject in this repository"
              % want_ws, file=sys.stderr)
        return 1
    allowed = briefs.drawn_from(deck)
    if found["id"] not in allowed:
        print("board deckfig: this deck was made from %s, not %s -- a figure "
              "comes from a subject the deck is about"
              % (", ".join(allowed) or "no subject", found["id"]), file=sys.stderr)
        return 1
    rid = briefs.figure_named(found["root"], want_id)
    if isinstance(rid, list):
        print("board deckfig: %s matches %s in %s -- say one of those ids"
              % (want_id, ", ".join(rid), found["id"]) if rid else
              "board deckfig: %s offers no figure called %s -- the ids are in "
              "the brief's catalog, and a word from the file's name finds one "
              "that is not listed" % (found["id"], want_id), file=sys.stderr)
        return 1
    got = briefs.snapshot(found["root"], rid, found["id"], deck)
    if not got:
        print("board deckfig: %s offers no figure called %s -- the ids are in "
              "the brief's catalog" % (found["id"], want_id), file=sys.stderr)
        return 1
    print(got)
    return 0


def cmd_mode(live, args):
    """Who writes the code in this session: teach or do.

        board mode              print it
        board mode teach|do     set it; one transcript turn and one inbox line

    The only ways the mode changes are this, `POST /mode`, and the tutor
    obeying "do it" -- by running this. Nothing infers `do`.
    """
    if not args:
        print("mode: %s" % config.mode_of(live.state()))
        return 0
    by = "tutor" if os.environ.get("TUTORBOARD_TURN") else "student"
    try:
        mode, changed = session_mode.set_mode(live, args[0], by=by)
    except ValueError as exc:
        print("board mode: %s" % exc, file=sys.stderr)
        return 2
    print("mode: %s%s" % (mode, "" if changed else "  (already)"))
    return 0


def cmd_meeting(live, args):
    """The meeting deck: a presentation to the mentors, written over a brief.

        board meeting --since 7d
        board meeting --since 2026-09-01 --subject projects/PSYCH-ASR
        board meeting --since last            (since the last deck)
        board meeting --since monday --print  (the brief; writes nothing)

    The period snaps to a local midnight. Per subject the brief carries the
    commits that are its own work with their whole messages, how its TUTOR.md
    changed, the sessions that ended in the period, and the period's figures.
    Without `--print` it is asked for: the deck in projects/Meetings/docs/
    meeting/ is replaced, its brief written beside it, and a `[writeup]` turn
    in a session bound to projects/Meetings writes and builds `meeting.tex`.
    """
    def value(flag):
        if flag in args:
            n = args.index(flag)
            if n + 1 < len(args):
                return args[n + 1]
        return ""

    base = atlas.root() or live.root
    when, human = briefs.resolve_since(value("--since"), base)
    if when is None:
        print("board meeting: %s" % human, file=sys.stderr)
        return 1
    want = [args[i + 1] for i, a in enumerate(args)
            if a == "--subject" and i + 1 < len(args)]
    if "--print" in args:
        blocks, every, why = briefs.blocks_for(base, want or None, when)
        if why or not blocks:
            print("board meeting: %s" % (why or "nothing landed in %s" % human),
                  file=sys.stderr)
            return 1
        rec = briefs.write_brief(base, briefs.deck_dir(base) or os.path.join(
            base, briefs.MEETINGS, briefs.deck_rel()), blocks, when, human=human,
            dry=True)
        sys.stdout.write(rec["markdown"] + "\n")
        return 0
    from tutorboard.server.routes import library as library_route
    got, err = library_route.ask_meeting(live, base, when, human, want=want or None)
    if err:
        print("board meeting: %s" % (err[0].get("detail") or err[0].get("error")
                                     or "it could not be asked for"), file=sys.stderr)
        return 1
    print("the meeting deck is being written in session %s: %s" % (
        got.get("session") or "?", os.path.join(base, got["dir"], briefs.STEM + ".tex")))
    return 0


def cmd_thread(live, args):
    """The thread file: this project's deliverables, and the threads under them.

        board thread < threads.json          write the whole file
        board thread --show [<thread>]       print it, or one thread
        board thread --check                 what it claims that the tree does not
        board thread add < thread.json       add one thread
        board thread add --deliverable < d.json
                                             add one deliverable
        board thread task [<thread>] "<text>"
                                             add an open task
        board thread done [<thread>] <task>  tick a task, by number or text
        board thread decide [<thread>] <decision> ["<rule>"]
                                             write a decision's rule, by number
                                             or question; a new question with no
                                             rule is an open decision
        board thread close [<thread>]        the owner closed it
        board thread reopen [<thread>]       undo a close
        board thread export ...              retired: the owner approves an
                                             export in tutorboard.json
                                             `relay.exports`
        board thread check [<thread>] <script>|--drop
                                             the tracked script `board send`
                                             runs on the cluster after each
                                             step; it prints only RELAY: lines

    `<thread>` may be left out where the sitting open now is on a thread.

    **Every write is validated and refused whole**, with every problem printed
    at once; nothing is half-applied. A turn edits threads only through this
    command. The file is `threads.json` at the workspace root, tracked, and
    re-checked against the tree on every read: a path that has gone drops out,
    and `--check` says aloud what the file claims that the tree does not.

    A thread's status is never written here. It is derived -- done, running,
    requested, written, result, open -- from the file, git, the job registry
    and which paths exist. `closed` is the only typed state.

    **`aggregate` is the owner's word, never a turn's.** A turn runs `export`
    bare, puts the printed question on its card, and runs `--aggregate` only
    after the owner has answered yes on the board.
    """
    root = live.root
    args = list(args)

    if "--show" in args:
        args.remove("--show")
        clean, problems = course_threads.read(root)
        if problems:
            for line in problems:
                print("  " + line, file=sys.stderr)
            return 1
        if not clean:
            print("no thread file. `board thread < threads.json` writes one; "
                  "until then the board derives a picture from the tree.")
            return 0
        if args:
            one = course_threads.thread(clean, args[0])
            if not one:
                print("board thread: no thread called %r" % args[0],
                      file=sys.stderr)
                return 1
            stage = course_threads.stages(root).get(one["id"]) or {}
            json.dump(dict(one, stage=stage), sys.stdout, indent=2,
                      ensure_ascii=False)
        else:
            json.dump(clean, sys.stdout, indent=2, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0

    if "--check" in args:
        if not course_threads.has(root):
            print("no thread file, so there is nothing to have gone stale.")
            return 0
        stale = course_threads.check(root)
        if not stale:
            print("the thread file is true: every file and document it names "
                  "is still there.")
        else:
            print("%d thing(s) the thread file claims that the tree does not:"
                  % len(stale))
            for line in stale:
                print("  " + line)
        # Not a failure: staleness is news, and `&&` chains must still run.
        return _thread_visible(root)

    verb = args[0] if args else ""
    if not verb:
        body = sys.stdin.read()
        if not body.strip():
            print("board thread: nothing on stdin; the file was left alone",
                  file=sys.stderr)
            return 1
        try:
            raw = json.loads(body)
        except ValueError as exc:
            print("board thread: that is not valid JSON -- %s\nNothing was "
                  "written." % exc, file=sys.stderr)
            return 1
        return _thread_store(root, raw, "written")

    if verb not in ("add", "task", "done", "decide", "close", "reopen",
                    "export", "check"):
        print("board thread: %r is not a subcommand; `board thread --help` "
              "lists them" % verb, file=sys.stderr)
        return 1

    clean, problems = course_threads.read(root)
    if problems:
        print("board thread: the file on disk is not valid, so nothing was "
              "changed:", file=sys.stderr)
        for line in problems:
            print("  " + line, file=sys.stderr)
        return 1
    rest = args[1:]

    if verb == "add":
        try:
            one = json.loads(sys.stdin.read() or "null")
        except ValueError as exc:
            print("board thread add: that is not valid JSON -- %s" % exc,
                  file=sys.stderr)
            return 1
        raw = clean or {"version": course_threads.VERSION,
                        "deliverables": [], "threads": []}
        key = "deliverables" if "--deliverable" in rest else "threads"
        if isinstance(one, dict) and any(
                x["id"] == one.get("id") for x in raw[key]):
            print("board thread add: %r is already there. Read it with `board "
                  "thread --show`, change it, and write the whole file back."
                  % one.get("id"), file=sys.stderr)
            return 1
        raw = dict(raw)
        raw[key] = list(raw[key]) + [one]
        return _thread_store(root, raw, "added %s" % (
            "deliverable" if key == "deliverables" else "thread"))

    if not clean:
        print("board thread: no thread file here yet; write one first",
              file=sys.stderr)
        return 1

    ids = set(t["id"] for t in clean["threads"])
    if rest and rest[0] in ids:
        tid, rest = rest[0], rest[1:]
    else:
        tid = str(live.state().get("thread") or "").strip()
        if tid not in ids:
            print("board thread %s: name the thread first -- %s"
                  % (verb, ", ".join(sorted(ids)) or "there are none"),
                  file=sys.stderr)
            return 1
    one = course_threads.thread(clean, tid)

    def pick(items, want, field):
        """An item by its 1-based number or its exact text, or None."""
        want = (want or "").strip()
        if want.isdigit() and 1 <= int(want) <= len(items):
            return items[int(want) - 1]
        for it in items:
            if it[field] == want:
                return it
        return None

    if verb == "task":
        text = " ".join(rest).strip()
        if not text:
            print("board thread task: say what the task is", file=sys.stderr)
            return 1
        one["tasks"].append({"text": text, "done": False})
        said = "task added to `%s`" % tid
    elif verb == "done":
        task = pick(one["tasks"], " ".join(rest), "text")
        if not task:
            print("board thread done: `%s` has no task %r. Its tasks:\n%s"
                  % (tid, " ".join(rest), "\n".join(
                      "  %d. %s%s" % (i + 1, t["text"],
                                      " (done)" if t["done"] else "")
                      for i, t in enumerate(one["tasks"]))), file=sys.stderr)
            return 1
        task["done"] = True
        said = "ticked on `%s`: %s" % (tid, task["text"])
    elif verb == "decide":
        if not rest:
            print("board thread decide: name the decision", file=sys.stderr)
            return 1
        found = pick(one["decisions"], rest[0], "q")
        rule = " ".join(rest[1:]).strip() or None
        if found:
            found["rule"] = rule
            said = "`%s`: %s -- %s" % (tid, found["q"],
                                       rule or "open again")
        else:
            one["decisions"].append({"q": rest[0], "rule": rule})
            said = "`%s`: a %s decision, %s" % (
                tid, "decided" if rule else "new open", rest[0])
    elif verb == "export":
        # Export approval is the subject's tutorboard.json `relay.exports`,
        # the owner's edit, which a turn cannot commit (tutorboard/exports.py).
        print("board thread export is retired: a thread no longer approves an "
              "export. The owner approves one in this subject's "
              "tutorboard.json, `relay.exports`, as {\"glob\": \"results/...\"}"
              " (a csv or json also needs \"aggregate\": true), and commits "
              "it. Put the question on your card:\n\n  May %s be published? "
              "The repository is public. Say yes only if every number in it "
              "is an aggregate, with no row for a patient, participant or "
              "recording.\n\nNothing was written."
              % (" ".join(w for w in rest if not w.startswith("--"))
                 or "<results/path>"), file=sys.stderr)
        return 1
    elif verb == "check":
        if rest == ["--drop"]:
            one["check"] = ""
            said = "`%s` has no check" % tid
        elif len(rest) == 1:
            one["check"] = rest[0]
            said = ("`%s`: its check is %s. Commit it before `board hold`: a "
                    "hold refuses a check that is not tracked" % (tid, rest[0]))
        else:
            print("board thread check: name one script, or --drop",
                  file=sys.stderr)
            return 1
    elif verb == "close":
        one["closed"] = True
        said = "`%s` is closed" % tid
    else:
        one["closed"] = False
        said = "`%s` is open again" % tid
    return _thread_store(root, clean, said)


def _thread_store(root, raw, said):
    """Validate and write the thread file, or print every problem and write nothing."""
    problems, path = course_threads.write(root, raw)
    if problems:
        print("board thread: %d problem(s), and nothing was written."
              % len(problems), file=sys.stderr)
        for line in problems:
            print("  " + line, file=sys.stderr)
        return 1
    clean, _ = course_threads.read(root)
    n = len(clean["threads"])
    print("%s: %s (%d deliverable%s, %d thread%s)"
          % (said, path, len(clean["deliverables"]),
             "" if len(clean["deliverables"]) == 1 else "s",
             n, "" if n == 1 else "s"))
    stale = course_threads.check(root, documents=False)
    if stale:
        print("%d of them do not match the tree; `board thread --check` says "
              "which." % len(stale))
    return _thread_visible(root)


def _thread_visible(root):
    """Refuse aloud if git cannot see the thread file, with the exact edit.

    Asked of git rather than read out of `.gitignore`. A workspace that ignores
    `*.json` hides `threads.json` too, and a thread file git cannot see is lost
    on the next clone with nothing having said so.
    """
    if not _is_ignored(root, course_threads.NAME):
        return 0
    sys.stdout.flush()
    print("\nBUT GIT CANNOT SEE IT. A rule in this workspace's .gitignore "
          "hides threads.json,\nso it is local to this machine and the next "
          "clone will not have it.\n\n"
          "  Add this line to %s, after the rule that hides it:\n"
          "      !threads.json" % os.path.join(root, ".gitignore"),
          file=sys.stderr)
    return 1


def _is_ignored(root, rel):
    """Would git ignore this path? Asked of git, never inferred from the file."""
    try:
        p = subprocess.run(["git", "check-ignore", "-q", rel],
                           cwd=root, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
    except OSError:
        return False
    return p.returncode == 0


def cmd_job(live, args):
    """Long work, labelled, so it reports itself.

        board job [--label <slug>] [--session <id>] [--produces <path>]...
            [--export <path>]... [--fixes <id>] -- <recipe> [VAR=value ...]

    `<recipe>` is a tracked `.sbatch` file in this workspace. `VAR=value` sets
    a variable its header declares, one `#RELAY-VAR NAME PATTERN` line per
    variable; anything undeclared is refused. `--produces` and `--export` are
    workspace-relative; an `--export` path must be approved by the subject's
    committed tutorboard.json `relay.exports` (`tutorboard/exports.py`).
    `--label` is an optional slug naming the work, in the request id and every
    line about it. `--session` is the Mac session filing it; it defaults to
    the session `$TUTORBOARD_SESSION` names, and the report wakes that session.
    No thread is named or read. `--fixes <id>` files it as an attempt to
    repair a recipe request that failed -- its rerun, or a diagnostic --
    naming the one that failed first; it is a relay request's word, so with
    Slurm it is refused. Without Slurm, a rerun of a recipe whose repair is
    open must carry it (`jobs.open_fix`), so the cap on automatic attempts
    counts every one. `--fresh` files it as a new request all the same: the
    owner's way to start again past the cap, refused inside a daemon turn.

    `board diagnose` is this command under another name, for a diagnostic: a
    tracked recipe that prints `RELAY:` lines and produces nothing. It
    validates no differently.

    ON A MACHINE WITH SLURM it submits the recipe wrapped so its exit code is
    written to `relay/state/` (`jobs.submit_recipe`, `--export=ALL,...`), and
    appends the job to this workspace's registry. When it ends, a `[job]`
    line wakes a turn that reports it.

    ON A MACHINE WITHOUT SLURM -- the Mac -- it writes
    `relay/requests/<id>.json`, commits that one file and pushes it. The
    cluster's relay runs it and commits a report, which wakes the session.
    The request is pinned to this machine's HEAD (`commit`), so it is
    refused while a tracked file under the subject is uncommitted: board
    push first. The cluster refuses it where its HEAD lacks that commit, and
    the report's `ran_at` is the HEAD it ran at.

    Either way the request is checked first, every problem printed at once, and
    nothing is filed or submitted if there is any.

    **A turn that starts long work starts it through here.** A bare `sbatch`
    is work the board cannot see, and on the Mac it is an error.

        board job [--label <slug>] -- sbatch <args>
                                the raw form, on a machine with Slurm only
        board job --show        every job and request, folded to its last state
    """
    root = live.root
    args = list(args)
    if args[:1] == ["--show"]:
        recs = jobs.view(root)
        if not recs:
            print("no jobs registered here.")
            return 0
        for j in sorted(recs.values(), key=lambda r: r.get("submitted") or 0):
            print("%-10s %-24s %-11s %s" % (
                j.get("slurm") or j.get("jobid"),
                j.get("label") or j.get("thread") or "-",
                j.get("state") or "PENDING", j.get("cmd", "")))
        return 0
    if "--" not in args:
        print("board job: put the recipe after `--`: board job [--label "
              "<slug>] [--produces <path>] [--export <path>] -- <recipe> "
              "[VAR=value]", file=sys.stderr)
        return 1
    cut = args.index("--")
    head, argv = args[:cut], args[cut + 1:]
    produces, export, words, fixes, i = [], [], [], None, 0
    fresh = "--fresh" in head
    head = [h for h in head if h != "--fresh"]
    while i < len(head):
        if head[i] in ("--produces", "--export") and i + 1 < len(head):
            (produces if head[i] == "--produces" else export).append(head[i + 1])
            i += 2
            continue
        if head[i] == "--fixes" and i + 1 < len(head):
            fixes = head[i + 1]
            i += 2
            continue
        words.append(head[i])
        i += 1
    label, session = _job_label(words, "board job")
    if label is None:
        return 1
    rels, bad = [], []
    for p in produces + export:
        # Workspace-relative, like a thread's `outputs`; an absolute path is
        # made so.
        rel = course_threads._rel(os.path.relpath(p, root)
                                  if os.path.isabs(p) else p)
        (rels if rel else bad).append(rel or p)
    if bad:
        print("board job: --produces and --export name paths inside this "
              "workspace, and %s is not. Nothing was submitted."
              % ", ".join(bad), file=sys.stderr)
        return 1
    produces, export = rels[:len(produces)], rels[len(produces):]
    slurm = jobs.has_slurm()
    if not argv:
        print("board job: name the recipe after `--`", file=sys.stderr)
        return 1
    if fixes is not None and slurm:
        print("board job: `--fixes` links a relay request; on the cluster "
              "`board job` submits directly. Nothing was submitted.",
              file=sys.stderr)
        return 1
    if fresh and fixes is not None:
        print("board job: `--fresh` starts a new request and `--fixes` "
              "repairs an old one; name one. Nothing was filed.",
              file=sys.stderr)
        return 1
    if fresh and inside_a_daemon_turn(live):
        print("board job: `--fresh` is the owner's, and this is a turn. A "
              "repair files its rerun with `--fixes`, inside the cap. Nothing "
              "was filed.", file=sys.stderr)
        return 1

    if os.path.basename(argv[0]) == "sbatch":
        if not slurm:
            print("board job: this machine has no Slurm, so a bare sbatch is "
                  "an error here. Name the recipe and its variables instead: "
                  "board job -- <recipe.sbatch> [VAR=value ...], and the "
                  "cluster runs it.", file=sys.stderr)
            return 1
        if export:
            print("board job: --export rides a recipe, not a raw sbatch",
                  file=sys.stderr)
            return 1
        return _job_submitted(root, label, jobs.submit(root, label, argv,
                                                       produces=produces))

    recipe, env, wrong = _recipe_args(root, argv)
    if wrong:
        print("board job: %s. Nothing was %s." % (
            wrong, "submitted" if slurm else "filed"), file=sys.stderr)
        return 1
    taken = set(r["id"] for r in jobs.requests(root))
    req = {"id": jobs.new_id(label,
                             os.path.splitext(os.path.basename(recipe))[0],
                             taken),
           "kind": "recipe", "recipe": recipe, "env": env,
           "produces": produces, "export": export}
    if label:
        req["label"] = label
    if session:
        req["session"] = session
    if not slurm:
        req["filed"] = round(time.time(), 3)
    if fixes is not None:
        req["fixes"] = fixes
    ok, problems = jobs.check(root, req)
    origin = "" if slurm or fresh or fixes is not None else jobs.open_fix(
        root, recipe, env)
    if origin:
        problems = list(problems) + [
            "%s failed and its repair is open, so its rerun names it: add "
            "`--fixes %s` (the owner starts over with `--fresh`)"
            % (origin, origin)]
    if problems:
        print("board job: %d problem(s), and nothing was %s:" % (
            len(problems), "submitted" if slurm else "filed"), file=sys.stderr)
        for line in problems:
            print("  " + line, file=sys.stderr)
        return 1
    if slurm:
        # Wrapped, so its exit code is written where the relay's poll reads
        # it: sacct is refused on this cluster.
        return _job_submitted(root, label, jobs.submit_recipe(
            root, label, recipe, env=env, produces=produces, export=export))
    return _request_filed(root, ok)


def _job_label(words, who):
    """`(label, session)` out of `--label <slug>` and `--session <id>`, the
    session defaulting to the one `$TUTORBOARD_SESSION` names. `label` is ""
    where none was given, and None having said why the words are wrong."""
    label, session, i = "", "", 0
    while i < len(words):
        w = words[i]
        if w in ("--label", "--session") and i + 1 < len(words):
            if w == "--label":
                label = words[i + 1].strip()
            else:
                session = words[i + 1].strip()
            i += 2
            continue
        print("%s: %r is not an option here. Work is named with --label "
              "<slug>; no thread is named." % (who, w), file=sys.stderr)
        return None, None
    if label and not jobs.LABEL_RE.match(label):
        print("%s: --label %r must be 1-40 characters of a-z, 0-9 and hyphen"
              % (who, label), file=sys.stderr)
        return None, None
    if not session:
        session = os.path.basename(
            os.environ.get("TUTORBOARD_SESSION", "").rstrip("/"))
    if session and not jobs.SESSION_RE.match(session):
        print("%s: %r is not a session id" % (who, session), file=sys.stderr)
        return None, None
    return label, session


def _recipe_args(root, argv):
    """`(recipe, env, problem)` out of `<recipe> [VAR=value ...]`.

    The recipe is workspace-relative, or relative to where this was typed."""
    first = argv[0]
    if os.path.isabs(first):
        cand = first
    elif os.path.exists(os.path.join(root, first)):
        cand = os.path.join(root, first)
    else:
        cand = os.path.join(os.getcwd(), first)
    recipe = course_threads._rel(os.path.relpath(cand, root)) or first
    env, wrong = {}, []
    for word in argv[1:]:
        name, eq, value = word.partition("=")
        if not eq or not name:
            wrong.append(word)
            continue
        env[name] = value
    if wrong:
        return recipe, env, ("after the recipe come VAR=value words only, and "
                             "%s is not one" % ", ".join(repr(w) for w in wrong))
    return recipe, env, ""


def _job_submitted(root, label, got):
    rec, why = got
    if not rec:
        print("board job: %s" % why, file=sys.stderr)
        return 1
    where = jobs.registry(root)
    print("job %s submitted%s, registered in %s%s"
          % (rec["jobid"], " as `%s`" % label if label else "",
             os.path.relpath(where, root),
             "; its log is " + rec["log"] if rec.get("log") else ""))
    return 0


def _request_filed(root, req):
    """Commit and push a checked request, and say what happened."""
    hidden = jobs.request_visible(root)
    if hidden:
        print("board: %s Nothing was filed." % hidden, file=sys.stderr)
        return 1
    # The request is pinned to HEAD (`commit`), so an edit not committed
    # under the subject is code the cluster would not run.
    changed = jobs.dirty(root)
    if changed:
        print("board: %s" % jobs.dirty_said(root, changed), file=sys.stderr)
        return 1
    path, ok, said = jobs.file_request(root, req)
    rel = os.path.relpath(path, root)
    if not ok:
        print("board: the request is written at %s but did not reach the "
              "cluster:\n%s" % (rel, said), file=sys.stderr)
        return 1
    print("request %s filed at %s and pushed. The cluster's relay picks it "
          "up on its next pass, and its report wakes %s."
          % (req["id"], rel, "session " + req["session"]
             if req.get("session") else "this workspace's inbox"))
    return 0


def cmd_ask_cluster(live, args):
    """Retired: no model runs beside the data, so a failure is not diagnosed
    by a cluster turn. Its recipe prints `RELAY:` lines, the Mac repairs it,
    and a question the report does not answer is a diagnostic recipe."""
    print("board ask-cluster is retired: no model runs on the cluster. A "
          "failed job's report carries its RELAY: lines and wakes a [repair] "
          "turn here; to ask the cluster more, file a diagnostic recipe, one "
          "that prints RELAY: lines and produces nothing:\n"
          "  board diagnose --fixes <failed request> -- "
          "<diagnose.sbatch> [VAR=value ...]\nNothing was filed.",
          file=sys.stderr)
    return 2


def _held_id(live, words, who):
    """The hold a command names: its one word, else the only hold standing,
    else the sitting's thread where that is held. None, having said why."""
    standing = holds.holds(live.root)
    if len(words) > 1:
        print("%s: name at most one hold" % who, file=sys.stderr)
        return None
    if words:
        hid = words[0]
        if not jobs.REQUEST_ID_RE.match(hid):
            print("%s: %r is not a hold's id" % (who, hid), file=sys.stderr)
            return None
        return hid
    if len(standing) == 1:
        return sorted(standing)[0]
    tid = str(live.state().get("thread") or "")
    if tid in standing:
        return tid
    print("%s: name the hold -- held here: %s"
          % (who, ", ".join(sorted(standing)) or "none"), file=sys.stderr)
    return None


def _hold_target(live, args, who="board hold"):
    """`(target, said)` for `board hold`'s words, or `(None, "")` having said
    why. See `holds.resolve_target`."""
    words, as_id, script = [], None, None
    i = 0
    args = list(args)
    while i < len(args):
        a = args[i]
        if a == "--":
            words.append("--")
            words.extend(args[i + 1:])
            break
        if a in ("--as", "--check"):
            if i + 1 >= len(args):
                print("%s: %s takes a value" % (who, a), file=sys.stderr)
                return None, ""
            if a == "--as":
                as_id = args[i + 1].strip()
            else:
                script = _workspace_rel(live.root, args[i + 1])
            i += 2
            continue
        if a.startswith("--"):
            print("%s: %s is not an option here" % (who, a), file=sys.stderr)
            return None, ""
        words.append(a)
        i += 1
    target, said, problems = holds.resolve_target(
        live.root, words, live.state(), cwd=os.getcwd(), as_id=as_id,
        script=script)
    if problems:
        print("%s: %d problem(s), and nothing was held:" % (who, len(problems)),
              file=sys.stderr)
        for line in problems:
            print("  " + line, file=sys.stderr)
        return None, ""
    return target, said


def _workspace_rel(root, word):
    """A path typed at the cluster, as the workspace-relative path it names."""
    for base in (root, os.getcwd()):
        full = os.path.realpath(os.path.join(base, word))
        if os.path.exists(full):
            rel = os.path.relpath(full, os.path.realpath(root))
            return course_threads._rel(rel) or word
    return word


def cmd_hold(live, args):
    """Hold a sitting at the cluster, so the owner writes its code here.

        board hold <thread>                         a thread of threads.json
        board hold [--as <id>] [--check <script>] -- <path>...
        board hold                                  the current sitting

    Typed in the cluster checkout, in any workspace. A path is a file or a
    directory, workspace-relative, and must exist; the id is `--as` or a slug
    of the first path's name. A bare `board hold` holds the sitting in
    `live/state.json`: its thread, its homework file, its chapter's directory,
    or its map box's files, and says which.

    Records `relay/holds/<id>.json`, commits it alone and pushes it. Until
    `board release`, the held files are the cluster's: the Mac's turns refuse
    to write them, and the Mac polls every 20 seconds.

    The check is `--check` (a tracked script), else the thread's `check`,
    else the workspace's `check` in tutorboard.json. A workspace whose output
    is closed (`holds.output_open`) refuses a hold with none.
    """
    target, said = _hold_target(live, args)
    if not target:
        return 1
    ok, lines = holds.hold(live.root, target, said=said)
    for line in lines:
        print(line, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def cmd_release(live, args):
    """End a hold: the Mac may write its files again.

        board release [<id>]

    Refused while a held file has uncommitted edits; `board send` them first.
    """
    hid = _held_id(live, list(args), "board release")
    if not hid:
        return 1
    ok, lines = holds.release(live.root, hid)
    for line in lines:
        print(line, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def cmd_send(live, args):
    """The owner's one command per step of a sitting held at the cluster.

        board send [<id>] [--wait N|--no-wait] [--anyway]
        board send --reply [<id>]          print the coach's last reply

    Commits the held files' changes as `<id>: step`, runs the hold's check
    here and commits its report (`relay/reports/check-<id>-<n>.json`), pushes
    both, and waits up to three minutes for the coach's reply from the Mac.
    The report carries the exit code and RELAY: lines, and where this
    workspace's output is open, the check's own output cut to fit.
    `--anyway` is the PHI check's keyboard override, as for `board push`.
    """
    words = [a for a in args if not a.startswith("--")]
    wait = holds.WAIT_SECONDS
    if "--no-wait" in args:
        wait = 0
    if "--wait" in args:
        i = args.index("--wait")
        try:
            wait = int(args[i + 1])
        except (IndexError, ValueError):
            print("board send: --wait takes seconds", file=sys.stderr)
            return 1
        words = [w for w in words if w != args[i + 1]]
    if "--reply" in args:
        hid = _held_id(live, words, "board send --reply")
        if not hid:
            return 1
        step, body = holds.upstream_reply(live.root, hid)
        if not body:
            print("no reply from the coach on %s yet" % hid)
            return 0
        print("step %d:\n\n%s" % (step, body))
        return 0
    if len(words) > 1:
        print("board send: name at most one hold", file=sys.stderr)
        return 1
    return holds.send(live.root, words[0] if words else None, wait=wait,
                      anyway="--anyway" in args)


def cmd_coach(live, args):
    """The coach's reply to a step held at the cluster. Body on stdin.

        board coach [<id>] [--step N] < reply.md

    Writes `relay/coach/<id>.md`, commits it alone and pushes it; `board
    send` on the cluster prints it. It is public: the code and the check's
    result, and in a fenced workspace its aggregate numbers, never rows.
    `--step` defaults to the newest check.
    """
    words = list(args)
    step = None
    if "--step" in words:
        i = words.index("--step")
        try:
            step = int(words[i + 1])
        except (IndexError, ValueError):
            print("board coach: --step takes a number", file=sys.stderr)
            return 1
        del words[i:i + 2]
    hid = _held_id(live, words, "board coach")
    if not hid:
        return 1
    ok, said = holds.write_coach(live.root, hid, sys.stdin.read(), step=step)
    print(said if ok else "board coach: " + said,
          file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def cmd_colibri(live, args):
    """Queue a task for Colibri, the local model that may read PHI.

        board colibri [--label <slug>] [--session <id>] "<task>"
        board colibri --show            the queue, oldest first (on the cluster)

    ON THE CLUSTER it writes the task into the queue -- libr-local-llm's
    ignored `relay/state/colibri/` -- and starts an on-demand generation if none is
    queued or running. The generation loads (about 68 minutes cold), works the
    queue one task at a time in the workspace each task names, and exits once
    the queue has been empty for 20 minutes. A generation that dies is replaced
    by its clone, which resumes the task by name; three deaths fail it.

    ON THE MAC it files a `colibri` relay request instead, committed and pushed
    like `board job`'s. The workspace opts in with `relay.colibri: true` in its
    tutorboard.json.

    A task is read-only analysis: Colibri writes its outputs under the
    workspace's ignored `phi/` and never changes a tracked file. When it is
    done the relay checks the workspace; any change git can see fails the task
    and stays on the cluster, uncommitted. A relay report carries only state,
    counts and the task's public `RELAY:` lines.
    """
    from tutorboard import colibri
    root = live.root
    words = list(args)
    if words[:1] == ["--show"]:
        q = colibri.queue_root()
        recs = colibri.tasks(q) if q else []
        if not recs:
            print("the Colibri queue is empty.")
            return 0
        for r in recs:
            print("%-26s %-9s %-24s %-22s attempts %d, deaths %d" % (
                r.get("id"), r.get("queue"), r.get("workspace"),
                r.get("label") or r.get("thread") or "-",
                int(r.get("attempts") or 0),
                int(r.get("deaths") or 0)))
        return 0
    if not words or not words[-1].strip():
        print("board colibri: say what the task is", file=sys.stderr)
        return 1
    brief = words[-1].strip()
    label, session = _job_label(words[:-1], "board colibri")
    if label is None:
        return 1
    if len(brief) > jobs.MAX_BRIEF:
        print("board colibri: the task is %d characters and the cap is %d"
              % (len(brief), jobs.MAX_BRIEF), file=sys.stderr)
        return 1
    if jobs.has_slurm():
        rec, said = colibri.file(label, brief, root)
        if rec is None:
            print("board colibri: %s. Nothing was queued." % said,
                  file=sys.stderr)
            return 1
        print("task %s%s: %s. `board colibri --show` lists the queue."
              % (rec["id"], " (`%s`)" % label if label else "", said))
        return 0
    taken = set(r["id"] for r in jobs.requests(root))
    req = {"id": jobs.new_id(label, "colibri", taken), "kind": "colibri",
           "brief": brief, "filed": round(time.time(), 3)}
    if label:
        req["label"] = label
    if session:
        req["session"] = session
    ok, problems = jobs.check(root, req)
    if problems:
        print("board colibri: %d problem(s), and nothing was filed:"
              % len(problems), file=sys.stderr)
        for line in problems:
            print("  " + line, file=sys.stderr)
        return 1
    return _request_filed(root, ok)


def inside_a_daemon_turn(live):
    """Is a headless turn in flight on this machine right now?

    If one is, then whoever is asking IS that turn, because a headless turn is
    the only thing running inside it -- and a turn does not wait. The daemon
    that started it does: it runs `board wait` itself between turns, and that is
    the whole engine.

    A turn that waits as well holds a full conversation open while the student
    thinks, and then answers their next message inside the previous turn's
    context. Measured in Galois Theory on 8 September 2026 as a single turn of
    36 round trips and 5.05M cached input tokens -- four times what a turn
    should cost, two cards deep before it let go.

    Nothing in the prompt could stop it: the course contract documents `board
    wait` as the way to be woken, which is true and correct for a person at a
    terminal, and a headless tutor reading that contract in full did as it was
    told. So the guard is here, where wording cannot reach it.
    """
    try:
        with open(live.path("agent.json"), "r", encoding="utf-8") as fh:
            st = json.load(fh) or {}
    except (OSError, ValueError):
        return None
    if st.get("mode") == "interactive":
        return None                      # somebody's terminal; their wait to run
    if (st.get("state") or "") != "working":
        return None                      # the daemon is between turns, or gone
    if st.get("host") and st["host"] != this_node():
        return None                      # another machine's daemon, another home
    if not processes.agent_is_attached(st, this_node()):
        return None
    return st


def cmd_wait(live, args):
    """Block until the student sends something, then print it and exit.

    This is the wake-up primitive. Any agent that can run a shell command can use
    it: run it in the background and act when it exits, or call it in a loop with
    a timeout. It polls a file mtime and costs nothing while it waits.

    **Anything already unread wakes it immediately.** It used to take the unread
    count as a baseline and return only when that count grew, which meant a
    message sent while no tutor was attached was invisible for ever -- and that
    is exactly the cold start the `begin` button exists for: the student taps
    *ask the tutor to begin*, a tutor is attached a minute later, and it sits
    waiting for a second tap on a board that is already asking. Marking read is
    what consumes a message, so unread is the whole test and a baseline can only
    lose one.

    **`--timeout` IS BEST EFFORT AND CANNOT BE MADE OTHERWISE HERE. Whoever
    needs a real bound puts it on the parent.** The deadline is checked between
    polls, and a poll is an `open()` on a filer: an NFS open can block in the
    kernel uninterruptibly, in state `D`, where no further line of this process
    runs until the filer answers. The loop below is then never reached again and
    the number on the command line means nothing -- measured at 71 minutes
    against a `--timeout 300`. Do not try to repair that in here; a deadline
    enforced by the thing that might hang is not a deadline. `WAIT_CEILING` in
    `runner/loop.py` is where the daemon bounds it, and any other caller wanting one
    does the same.
    """
    timeout = 900.0
    if "--timeout" in args:
        timeout = float(args[args.index("--timeout") + 1])

    # A turn does not wait; the daemon that started it does. See
    # `daemon_owns_the_wait` for what this cost before it was refused. It exits
    # 0 and says what to do instead, deliberately: a non-zero exit reads to an
    # agent as a broken command and gets retried, which is the same wait again.
    if "--force" not in args and inside_a_daemon_turn(live):
        print("A headless turn is in flight on this board, which means this IS "
              "that turn -- and a turn does not wait.\n"
              "End your turn instead. The daemon is already blocked on the next "
              "message and will hand it to a fresh turn the moment it lands. "
              "If the subject's state changed, keep TUTOR.md true with `board "
              "memo <section>` first.")
        return 0

    start = time.time()
    while True:
        if [m for m in read_messages(live) if not m.get("read")]:
            return cmd_inbox(live, [])
        if time.time() - start >= timeout:
            break
        # A quarter second, not a whole one. This is dead time between the tap
        # and the assistant learning about it, on every single turn, and it
        # costs nothing to shorten: the loop is one small read of one file.
        time.sleep(0.25)
    print("nothing sent in %.0fs" % timeout)
    return 2


# ---------------------------------------------------------------------------
# export: the conversation -> one .tex, so a lesson becomes a permanent document
#
# The markdown-to-LaTeX converter and the transcript builder both live in
# `document.py` now, because the board serves this from a button and cannot
# import a script with no `.py` on the end of it.
# ---------------------------------------------------------------------------
TEX_HEAD = document.TEX_HEAD
KIND_HEAD = document.KIND_HEAD
md_to_tex = document.md_to_tex
inline_tex = document.inline_tex
tex_escape = document.tex_escape


def cmd_export(live, args):
    """The whole sitting as one document: the tutor's cards and the student's own
    working, in the order they happened.

        board export                    this lesson, built, numbered, staged
        board export --chapter          every sitting on the chapter that is open
        board export --chapter "Ch 7"   every sitting on that one
        board export --sitting <id>     one finished sitting, by its archive id
        board export --all              every filed lesson and this one, as one
        board export --no-build         write the .tex and stop

    SCOPES, NOT EXPORTERS. All four go through one `document.build`, get the
    same numbering and produce the same shape -- because the moment there are
    two exporters there are two answers to "what is in a document" and one of
    them is out of date.

    What does not change with the scope is the property that makes an export
    worth having: it is the whole sitting in reading order -- the question,
    every revision of the working as it was actually sent, what the tutor said,
    and the next attempt underneath. Half a conversation is what `board archive`
    refuses to keep, for the same reason.

    It used to be the cards alone, named with a timestamp, written into a
    directory git ignores -- which is a record of half a conversation that
    nobody can find and nothing keeps.
    """
    def after(flag):
        if flag in args:
            n = args.index(flag)
            if n + 1 < len(args) and not args[n + 1].startswith("--"):
                return args[n + 1]
        return ""

    scope, which = "lesson", ""
    if "--all" in args:
        scope = "all"
    elif "--sitting" in args:
        scope, which = "sitting", after("--sitting")
        if not which:
            print("board export --sitting needs the id of a filed sitting. "
                  "`board history` lists them.", file=sys.stderr)
            return 1
    elif "--chapter" in args:
        # No name means the chapter that is open, which is what somebody at a
        # terminal in the middle of one means by "this chapter".
        scope, which = "chapter", after("--chapter")

    rec = document.build(live.root, scope=scope, which=which,
                         make_pdf="--no-build" not in args)
    if not rec.get("ok") and not rec.get("tex"):
        print(rec.get("detail") or "nothing to export", file=sys.stderr)
        return 1
    print(rec["tex"])
    if rec.get("sittings", 1) > 1:
        print("%d sittings, in the order they happened" % rec["sittings"])
    if rec.get("pdf"):
        print(rec["pdf"])
    elif rec.get("detail"):
        print("FAILED to compile\n" + rec["detail"], file=sys.stderr)
    if rec.get("tracked"):
        print("staged for the next push")
    return 0 if rec.get("ok") else 1


# ---------------------------------------------------------------------------
# Tailscale, in userspace mode so it needs no root and no TUN device.
#
# The compute node is on the institute network and the iPad is not, so there is
# no LAN route between them. Tailscale gives both machines an address on the
# same private network wherever they happen to be.
# ---------------------------------------------------------------------------
TS_DIR = tailscale.TS_DIR
TS_SOCK = tailscale.TS_SOCK
TS_LOG = os.path.join(TS_DIR, "tailscaled.log")


def ts(*args, **kw):
    """Run the tailscale CLI, whether it is ours or the system's."""
    prefix, kind = tailscale.tailscale_cli()
    if not prefix:
        return 1, "tailscale is not installed"
    cmd = prefix + list(args)
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=kw.get("timeout", 25))
        return p.returncode, p.stdout.decode("utf-8", "replace")
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, str(exc)


def ts_daemon_running():
    """Is OUR tailscaled up on THIS machine?

    `pgrep -x`, matching the executable's name rather than a string inside a
    command line. The pattern this used -- `-f "tailscaled --tun=..."` -- is
    matched by any process that merely MENTIONS it, which on this cluster
    includes every `srun bash -c` wrapper and every shell one-liner written to
    ask the question. A false yes here is the worst answer available: the caller
    concludes the link is up and never starts one, and the board serves on
    loopback at an address the iPad cannot reach.
    """
    return tailscale.daemon_running()


def ts_talks(timeout=12.0):
    """Can the CLI actually reach the daemon? A socket file is not an answer.

    The socket lives in the SHARED home, so the path existing says only that
    some machine once had a daemon -- and the daemon takes a moment to bind it
    after being started. Waiting on the file alone therefore returns the instant
    a start begins, and the `tailscale up` that follows fails with "failed to
    connect to local tailscaled", which is what it did on compute306 while every
    process looked healthy and the iPad stayed white.
    """
    end = time.time() + timeout
    while True:
        code, _ = ts("status", timeout=8)
        if code == 0:
            return True
        if time.time() >= end:
            return False
        time.sleep(0.5)


def ts_start_daemon():
    if ts_daemon_running():
        return True
    os.makedirs(TS_DIR, exist_ok=True)
    # A socket file with no daemon behind it is a leftover from another node --
    # this directory is the shared home -- and `tailscaled` will not bind an
    # address that is already a file. Removed only when nothing of ours is
    # running here, which is the branch above.
    try:
        os.remove(TS_SOCK)
    except OSError:
        pass
    log = open(TS_LOG, "ab")
    subprocess.Popen(
        ["tailscaled", "--tun=userspace-networking", "--socket=" + TS_SOCK,
         "--statedir=" + TS_DIR, "--socks5-server=localhost:1055"],
        stdout=log, stderr=log, start_new_session=True)
    # The daemon ANSWERING is the test, not its socket existing: see `ts_talks`.
    if ts_talks():
        return True
    return False


def ts_info():
    """(ipv4, dns_name) for this node, or (None, None)."""
    code, out = ts("status", "--json")
    if code != 0:
        return None, None
    # `ts` folds stderr into stdout, and the CLI puts advisory warnings there --
    # a client/daemon version skew is the common one -- so the output may open
    # with prose before the JSON object. Start at the first brace.
    start = out.find("{")
    if start == -1:
        return None, None
    try:
        data = json.loads(out[start:])
    except ValueError:
        return None, None
    me = data.get("Self") or {}
    ips = me.get("TailscaleIPs") or []
    v4 = next((i for i in ips if ":" not in i), None)
    name = (me.get("DNSName") or "").rstrip(".")
    return v4, (name or None)


def served_ports(out):
    """Every local port an HTTPS name is proxying to right now.

    `tailscale serve status` lists two different things and they look alike. A
    TCP FORWARD is printed once per board, with its own port, as a tree of
    `tcp://…:PORT` lines -- one board's plain-HTTP address on the tailnet. The
    HTTPS NAME is the thing this is actually about, and it appears at the bottom
    as `https://<name>` followed by `|-- / proxy http://127.0.0.1:PORT`.

    The first pattern in the output is therefore a TCP forward belonging to some
    board or other, in whatever order the daemon felt like printing them, and
    reading THAT as "who holds the address" is how a guard against stealing the
    name came to be a coin toss. Somebody mid-proof in Galois Theory looked up
    at a board labelled PSYCH-ASR. Only the proxy lines count.
    """
    return [int(p) for p in
            re.findall(r"proxy\s+https?://127\.0\.0\.1:(\d+)", out or "")]


def served_by_name(out):
    """{https name: local port} -- which name is pointed where.

    There is more than one name. This node answers to its own
    `compute-node.<tailnet>` and to the stable `board.<tailnet>` the iPad has in
    its home screen, and they can point at different boards. "Who holds the
    address" is only a question about one of them at a time.
    """
    by = {}
    name = None
    for line in (out or "").splitlines():
        line = line.strip()
        m = re.match(r"https://([^\s/]+)", line)
        if m:
            name = m.group(1)
            continue
        m = re.search(r"proxy\s+https?://127\.0\.0\.1:(\d+)", line)
        if m and name:
            by[name] = int(m.group(1))
    return by


def served_port(out):
    """Which local port the tailnet name is proxying to right now, if any."""
    ports = served_ports(out)
    return ports[0] if ports else None


def port_answers(port):
    """Is anything listening on this port on this machine."""
    import socket as _s
    if not port:
        return False
    sock = _s.socket()
    sock.settimeout(0.4)
    try:
        return sock.connect_ex(("127.0.0.1", int(port))) == 0
    except OSError:
        return False
    finally:
        try:
            sock.close()
        except OSError:
            pass


def recorded_ports():
    """Every port a board on THIS node currently claims as its own.

    A board writes its port into its own repository's `live/.board.json` when it
    starts, and the NEXT board in that repository overwrites it. So a board left
    behind by an allocation that ended keeps running, keeps answering, and is
    named by no record anywhere: invisible to every tool that reads records, and
    still holding whatever it was holding.

    That is not hypothetical. A Galois Theory board from an ended generation went
    on answering on 9098 while the live one served 9195, and because it ANSWERED
    it kept `https://compute-node…/` -- the one address the iPad is installed
    against -- for an hour and three quarters. The tutor was up, the board was
    up, the watch loop was reporting itself healthy, and
    the reply the tutor had written was on a board nothing was pointing at.
    Reported in the only words it needs: "The tutor in Galois Theory is also not
    responding... If claude is working, and the tutoring server is up, how could
    we ever be left hanging?"

    So ANSWERING IS NOT OWNING. A port owns the address when a live record names
    it; a port that answers and no record names is a leftover, and a leftover has
    no claim on anything.

    Returns None where the question cannot be answered at all, which is not the
    same as an empty set -- see below.
    """
    here, ports = this_node(), set()
    try:
        every = atlas.workspaces()
    except Exception:
        # None, and not an empty set. This runs inside `board start`, and a
        # repository layout it cannot read is a reason to leave the address
        # alone rather than to fail a launch -- but an empty set would say
        # "nobody has a record", which reads as "take it from whoever is there".
        # None says "cannot tell", and the caller then believes answering, which
        # is the rule this replaced and the cautious one to fall back to.
        return None
    for ws in every:
        try:
            with open(course_repo.session_path(ws["root"], ".board.json"),
                      "r", encoding="utf-8") as fh:
                rec = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(rec, dict) or not rec.get("port"):
            continue
        if rec.get("node") and rec["node"] != here:
            continue
        if not processes.board_is_running(rec.get("pid"), rec.get("root") or ws["root"]):
            continue
        try:
            ports.add(int(rec["port"]))
        except (TypeError, ValueError):
            continue
    return ports


def boards_serving(root):
    """(pid, port) for every board process serving THIS repository on this node.

    There should be exactly one and the record should name it. A second is the
    leftover described in `recorded_ports`, and the moment to be rid of it is the
    moment a new board for the same repository starts -- which is precisely when
    it became a leftover.

    `ps` rather than `/proc`, because this runs on a Mac as well.
    """
    found = []
    try:
        out = subprocess.run(["ps", "-eo", "pid=,args="], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, timeout=10).stdout
        out = out.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError):
        return found
    for line in out.splitlines():
        line = line.strip()
        if "serve.py" not in line or "--root" not in line:
            continue
        parts = line.split()
        if not parts or not parts[0].isdigit():
            continue
        pid, at, port = int(parts[0]), None, None
        for n, word in enumerate(parts):
            if word == "--root" and n + 1 < len(parts):
                at = parts[n + 1]
            elif word == "--port" and n + 1 < len(parts) and parts[n + 1].isdigit():
                port = int(parts[n + 1])
        if pid != os.getpid() and at and paths.same_dir(at, root):
            found.append((pid, port))
    return found


def drop_strays(live):
    """Stop any board for this repository that the record does not name.

    Called as a new one starts. Only this repository's, only on this node, and
    only ones the record has already let go of: a board the record DOES name is
    handled by `cmd_start`'s own "already up" branch above, which is a different
    answer and the right one.
    """
    info = live.info() or {}
    keep = info.get("pid") if processes.board_is_running(info.get("pid"), live.root) else None
    for pid, port in boards_serving(live.root):
        if keep and pid == keep:
            continue
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
        except OSError:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                continue
        print("stopped a board this repository had left behind (pid %d%s)"
              % (pid, ", port %d" % port if port else ""))


def serve_target(port):
    """Where the tailnet HTTPS name should point: at the board on this machine.

    `tailscale serve` only ever proxies to a LOCAL backend -- given a remote
    tailnet address in its config it answers every request with a 502 -- so the
    one name the iPad is installed against belongs to the machine holding it,
    and the only question is which of that machine's boards it opens.
    """
    return "http://127.0.0.1:%d" % port


def ts_repoint(port, force=False):
    """Keep the HTTPS name pointed at a board that is actually answering.

    Each repository has its own port, so switching from one course to another
    would otherwise leave https://board…/ proxying to a board that is no longer
    running. The address is the thing that must stay constant, not the target.

    But it must not be stolen either. Starting a board used to claim the name
    unconditionally, and `tutor restart` restarts every board on the machine one
    after another -- so the address ended up wherever the alphabet happened to
    put the last course. Somebody halfway through a Galois proof was dropped into
    a completely different lesson by a deploy, on a device with one URL baked
    into it and no way to say which course it wanted.

    So: a name already pointing at a board that is up and answering is that
    board's, and a start does not take it. What does take it is the name pointing
    at nothing -- a course whose board has gone -- or an explicit `board vpn
    serve`, which is a person saying which course they mean.
    """
    if not ts_daemon_running():
        return
    target = serve_target(port)
    code, out = ts("serve", "status", timeout=15)
    if code != 0 or "https://" not in out:
        return
    if target in out:
        return
    # ANY https name that is proxying to a board which is up owns the address.
    # Asking only about the first one found was the same mistake as reading a
    # TCP forward for a proxy: two names, and the answer depended on order.
    #
    # AND "UP" MEANS RECORDED, NOT MERELY ANSWERING. A board an ended generation
    # left behind answers exactly like a live one and is named by no record, so
    # on the answering test alone it held the address against every board that
    # came after it -- for as long as the process lived. See `recorded_ports`.
    mine = recorded_ports()
    held = [p for p in served_ports(out)
            if p != port and port_answers(p) and (mine is None or p in mine)]
    if not force and held:
        return
    code, _ = ts("serve", "--bg", "--https=443", target, timeout=40)
    if code == 0:
        _, name = ts_info()
        print("  https://%s/ now points here" % (name or "the tailnet name"))


def cmd_vpn(live, args):
    sub = args[0] if args else "status"

    # WHICH PORT THE NAME IS POINTING AT, as a number and nothing else.
    # `tutor restart` bounces every board on the machine one after another, and
    # while one is down the name it holds points at nothing -- which is exactly
    # the condition under which the next board to come up is allowed to take it.
    # So a deploy handed the address to whichever course the loop reached last.
    # This is how the restart remembers who had it, before it starts stopping
    # things. Asked for in the only words it needs: "I thought I was in Galois
    # Theory - why the hell is the top left label PSYCH-ASR?"
    if sub == "holder":
        if not ts_daemon_running():
            return 1
        code, out = ts("serve", "status", timeout=15)
        if code != 0:
            return 1
        by = served_by_name(out)
        _, me = ts_info()
        # This node's own name first, because that is the one the iPad has. Failing that, any name at all.
        held = by.get(me) if me else None
        if not held and by:
            held = sorted(by.values())[0]
        if not held:
            return 1
        print(held)
        return 0

    prefix, kind = tailscale.tailscale_cli()
    if kind == "system":
        # Tailscale is already installed and running here -- a Mac, typically.
        # There is nothing for us to start, and starting a second daemon would
        # only fight the one that works.
        if sub in ("up", "status"):
            code, out = ts("status")
            print(out.strip() or "tailscale is managed by this system")
            return code
        if sub == "down":
            print("tailscale is managed by this system; leave it alone")
            return 0
        if sub == "serve":
            # The system CLI is already connected; there is nothing to start.
            # This must not fall through to the userspace-daemon path below -- on
            # a Mac that would spawn a second tailscaled and a second identity,
            # fighting the one that is already running.
            info = live.info()
            if not info:
                print("start the board first", file=sys.stderr)
                return 1
            if "--if-free" in args:
                ts_repoint(info["port"])
                return 0
            code, out = ts("serve", "--bg", "--https=443",
                           serve_target(info["port"]), timeout=40)
            print(out.strip() or "serving")
            if code != 0:
                print("\nHTTPS needs certificates enabled once for the tailnet:\n"
                      "  admin console -> DNS -> HTTPS Certificates -> Enable",
                      file=sys.stderr)
            return code

    # Ours to stop only once the system branch above has had its say: on a Mac
    # a bare `tailscale down` here took the owner's own Tailscale off the tailnet.
    if sub == "down":
        ts("down")
        subprocess.run(["pkill", "-f", "tailscaled --tun=userspace-networking"])
        print("tailscale stopped")
        return 0

    if kind == "missing":
        print("tailscale is not installed. To reach the board from another\n"
              "network you need it on this machine:\n\n"
              + tailscale.tailscale_download_hint(), file=sys.stderr)
        return 1

    if not ts_start_daemon():
        print("tailscaled would not start; see " + TS_LOG, file=sys.stderr)
        return 1

    if sub == "up":
        # Always "board", never the compute node's own name. The state file is
        # shared, so this is one machine that moves -- exactly like a laptop
        # changing networks -- and its address never changes.
        for n, a in enumerate(args):
            if a == "--hostname" and n + 1 < len(args):
                tailscale.set_tailnet_hostname(args[n + 1])
        name = tailscale.tailnet_hostname()
        code, out = ts("up", "--hostname=" + name, "--accept-dns=false", timeout=20)
        _, status = ts("status")
        if "Log in at:" in status:
            url = status.split("Log in at:", 1)[1].strip().split()[0]
            print("NOT LOGGED IN. Open this once, on any device, to link this node:")
            print("  " + url)
            return 3
        print(out.strip() or "tailscale up")
        return 0

    if sub == "serve":
        info = live.info()
        if not info:
            print("start the board first", file=sys.stderr)
            return 1
        # `--if-free` ASKS FIRST, and it is what anything automatic must use.
        #
        # A bare `serve` is forced on purpose: it is the one command whose whole
        # meaning is "point the address at THIS course", spoken by a person. That
        # made it exactly the wrong thing for `link()` in `bin/tutor` to call on
        # every launch, which it did -- so starting a tutor in any workspace
        # silently took the address from whatever course somebody was reading on
        # the iPad. One URL is baked into that device and there is no way from it
        # to say which course was meant.
        if "--if-free" in args:
            ts_repoint(info["port"])
            return 0
        code, out = ts("serve", "--bg", "--https=443",
                       serve_target(info["port"]), timeout=40)
        print(out.strip() or "serving")
        if code != 0:
            print("\nHTTPS needs certificates enabled once for the tailnet:\n"
                  "  admin console -> DNS -> HTTPS Certificates -> Enable", file=sys.stderr)
        return code

    code, out = ts("status")
    print(out.strip())
    return code


def read_config(root):
    """What this repository calls itself: its `tutorboard.json`, with `name`
    defaulted to the directory. A `mode` or `stance` left in the file is
    ignored: who writes the code is the session's mode (`board mode`).
    """
    cfg = {"name": None}
    try:
        with open(os.path.join(root, "tutorboard.json"), "r", encoding="utf-8") as fh:
            cfg.update(json.load(fh) or {})
    except (OSError, ValueError):
        pass
    if not cfg.get("name"):
        cfg["name"] = os.path.basename(root).replace("-", " ")
    cfg.pop("mode", None)
    cfg.pop("stance", None)
    return cfg


def cmd_init(live, args):
    """Name this repository, so the board does not have to use its directory.

    There is nothing else to declare. `--math` and `--code` used to live here and
    chose between two methods and two interfaces; both are gone, and a `mode`
    left in an existing file is dropped on the way past rather than kept as a
    key that means nothing.
    """
    name = " ".join(a for a in args if not a.startswith("--")) \
        or os.path.basename(live.root).replace("-", " ")

    path = os.path.join(live.root, "tutorboard.json")
    cfg = {}
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as fh:
                cfg = json.load(fh) or {}
        except ValueError:
            pass
    dropped = cfg.pop("mode", None)
    cfg["name"] = name
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
    print("%s\n  name: %s" % (path, name))
    if dropped:
        print("  dropped 'mode: %s' -- there is one board and one method now"
              % dropped)
    print("  -> answers come back on the board: written on the slate, or typed")
    return 0


EYES_DOC = r"""\documentclass[border=24pt]{standalone}
\usepackage{amsmath,amssymb}
\begin{document}
\begin{minipage}{9cm}
\centering
{\Huge\bfseries %(token)s}\\[10pt]
{\Large $\displaystyle \int_0^{%(a)s} x^{%(b)s}\,dx$}\\[10pt]
{\large the word is \textbf{%(word)s}}
\end{minipage}
\end{document}
"""

EYES_WORDS = ["lattice", "kernel", "cyclotomic", "residue", "orbit", "cocycle",
              "spectrum", "filtration", "adjoint", "quotient"]


def cmd_build(live, args):
    """Build documents beside their sources.

        board build path/to/deck.tex
        board build paper/draft.md [--format docx|pdf] [--strict]
                                         [--reference-doc journal.docx]

    A .tex runs pdflatex in its own directory (beamer or article, detected),
    twice and a third time when the log asks; TEXINPUTS holds the subject's
    `latex/` and the board's `tex/`. Scratch files go on success; `--keep-aux`
    keeps the `.aux`. A .md builds a .docx with the reference document found
    from the source upward (`formats/*.docx`), plus a .pdf when the PDF engine
    exists. A figure that did not reach the .docx fails the build; one that will
    not sit on the page fails it only with `--strict`.
    """
    from tutorboard import build
    formats, ref, files = [], None, []
    strict = keep_aux = False
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--format", "--reference-doc"):
            if i + 1 >= len(args):
                print("%s needs a value" % a, file=sys.stderr)
                return 2
            if a == "--format":
                if args[i + 1] not in ("docx", "pdf"):
                    print("--format is docx or pdf", file=sys.stderr)
                    return 2
                formats.append(args[i + 1])
            else:
                ref = args[i + 1]
            i += 2
            continue
        if a in ("--strict", "-s"):
            strict = True
        elif a == "--keep-aux":
            keep_aux = True
        elif a.startswith("-"):
            print("unknown option: %s" % a, file=sys.stderr)
            return 2
        else:
            files.append(a)
        i += 1
    if not files:
        print("usage: board build <file.tex|file.md> [--format docx|pdf] "
              "[--strict] [--reference-doc F] [--keep-aux]", file=sys.stderr)
        return 2
    status = 0
    for f in files:
        rec = build.build(f, formats=formats or None, strict=strict,
                          reference_docx=ref, keep_aux=keep_aux)
        if rec.get("detail"):
            print(rec["detail"], file=sys.stdout if rec["ok"] else sys.stderr)
        for out in rec["built"]:
            print(out)
        if not rec["ok"]:
            status = 1
    return status


def cmd_textbook(live, args):
    """A course's textbook tooling: one shared copy, in board/scripts.

        board textbook split <course> [NN ...]
        board textbook scaffold <course> [--chapter-homework] [NN ...]
        board textbook scaffold <course> --hw NN [NN ...]

    <course> is a subject id (`courses/Galois-Theory`), its slug, or a path to
    the course directory. `split` cuts the one PDF in textbook/ into
    chapters/chNN-slug/reading/chNN.pdf by chapters.tsv; `scaffold` writes the
    chapter and homework .tex files from board/tex/writeup.tex.in and never overwrites.
    Both outputs that belong to somebody else stay ignored.
    """
    from tutorboard import subjects
    scripts = {"split": "split-textbook.sh", "scaffold": "scaffold.sh"}
    if len(args) < 2 or args[0] not in scripts:
        print("usage: board textbook split|scaffold <course> [...]  "
              "(board textbook --help)", file=sys.stderr)
        return 2
    sub, want, rest = args[0], args[1], args[2:]
    if os.path.isdir(want):
        where = os.path.realpath(want)
    else:
        found = subjects.find(want)
        where = found["root"] if found else None
    if not where:
        print("no course called %r: give its id (courses/<Name>), its name "
              "or its directory" % want, file=sys.stderr)
        return 1
    return subprocess.call(["bash", os.path.join(TOOL, "scripts",
                                                 scripts[sub]), where] + rest)


def cmd_eyes(live, args):
    """Settle, by experiment, whether the assistant driving this can see.

    Model capabilities are a moving target and the harness matters as much as the
    model: something vision-capable behind a tool that only ever sends text is
    still blind here. Rather than trust anyone's recollection, render an image
    with a value nobody could guess and ask.
    """
    import random
    stamp = os.path.join(live.session, "eyes")
    os.makedirs(stamp, exist_ok=True)
    answer_path = os.path.join(stamp, "answer.txt")

    if "--answer" in args:
        try:
            with open(answer_path, "r", encoding="utf-8") as fh:
                print(fh.read().strip())
        except OSError:
            print("nothing generated yet; run: board eyes")
        return 0

    token = "%04d-%04d" % (random.randint(1000, 9999), random.randint(1000, 9999))
    word = random.choice(EYES_WORDS)
    a, b = random.randint(2, 9), random.randint(2, 5)
    integral = "%s^%s/%s" % (a, b + 1, b + 1)

    # `tex_path`, not `tex`: the module of that name is imported at the top of
    # this file and a local of the same name shadows it, so the next line --
    # `tex.tex_env()` -- died with "'str' object has no attribute 'tex_env'".
    # This is the one command that answers "can the tutor read my handwriting",
    # which is the question somebody asks on exactly the evening it is broken.
    tex_path = os.path.join(stamp, "eyes.tex")
    with open(tex_path, "w", encoding="utf-8") as fh:
        fh.write(EYES_DOC % {"token": token, "word": word, "a": a, "b": b})

    from tutorboard import build
    rec = build.build(tex_path)
    pdf = os.path.join(stamp, "eyes.pdf")
    if not rec["ok"] or not os.path.exists(pdf):
        print("could not render the test image; is TeX installed? (board doctor)",
              file=sys.stderr)
        print(rec.get("detail") or "", file=sys.stderr)
        return 1

    png = os.path.join(stamp, "eyes.png")
    subprocess.run(["pdftoppm", "-png", "-r", "120", "-singlefile", pdf,
                    os.path.splitext(png)[0]],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    if not os.path.exists(png):
        # pdftoppm is not everywhere; the PDF on its own is still a fair test.
        png = pdf

    with open(answer_path, "w", encoding="utf-8") as fh:
        fh.write("token: %s\nword:  %s\nintegral evaluates to: %s\n"
                 % (token, word, integral))

    print(png)
    print()
    print("Ask the assistant driving this to open that file and report the token,")
    print("the word, and what the integral evaluates to.")
    print("Then run `board eyes --answer` to see whether it read them or invented them.")
    print()
    print("If it cannot, it cannot tutor from this board: every answer comes back")
    print("as handwriting or a photograph, and there is no mode that turns that")
    print("off any more. Point a different assistant at it -- `tutor --agents`")
    print("lists what this machine can drive.")
    return 0


def state_agent(live):
    """Who is teaching in this workspace right now, off `live/agent.json`."""
    try:
        with open(os.path.join(live.session, "agent.json"), "r",
                  encoding="utf-8") as fh:
            return json.load(fh) or {}
    except (OSError, ValueError):
        return {}


def cmd_see(live, args):
    """What is in this image or PDF page, in words.

        board see path/to/page.png
        board see sheet.pdf --page 3
        board see page.png --ask "just the numbers in the right-hand column"
        board see --route            where an image would go, and nothing else

    FOR AN ASSISTANT WHOSE MODEL CANNOT SEE ONE. Every tutor here is told on its
    first turn to open whatever the student sent -- handwriting is a PNG and a
    problem sheet a PDF -- and a model without vision cannot. This is what it
    calls instead. The answer comes back on stdout as text, so it is read the way
    every other `board` command is read.

    Where the image goes is a `vision` block on a recipe, resolved through the
    running agent first and `vision_agent` second; `board see --route` says which
    one answered. See `tutorboard/seeing.py`.

    A PATH INSIDE A FENCE IS REFUSED BEFORE ANYTHING IS OPENED, because this
    sends a file to a hosted provider and a board command does not go through
    any assistant's pre-tool hook.
    """
    rest = [a for a in args if not a.startswith("--")]
    page = None
    if "--page" in args:
        n = args.index("--page")
        page = args[n + 1] if n + 1 < len(args) else None
    prompt = None
    if "--ask" in args:
        n = args.index("--ask")
        prompt = args[n + 1] if n + 1 < len(args) else None
    for taken in (page, prompt):
        if taken in rest:
            rest.remove(taken)

    who = (state_agent(live) or {}).get("agent")
    if "--route" in args:
        settings, why = seeing.route(who)
        if not settings:
            print(why, file=sys.stderr)
            return 1
        print("%s  %s  via the '%s' recipe"
              % (settings.get("model"),
                 settings.get("endpoint")
                 or " ".join(settings.get("cmd") or []),
                 settings.get("agent")))
        return 0
    if not rest:
        print("board see <path> -- an image, or a PDF with --page N",
              file=sys.stderr)
        return 1
    try:
        said, _settings = seeing.describe(rest[0], page=page, prompt=prompt,
                                          agent=who, root=live.root)
    except seeing.Refused as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(said)
    return 0


def machine_shape():
    """What this machine is for. Platform knowledge, so it lives in boardlib."""
    return machine.machine_shape()


def cmd_limit(live, args):
    """Whether this machine's tutor has any allowance left, and until when.

        board limit              report
        board limit --clear      say the allowance is back, now
        board limit --set 3600   say it is gone for this many seconds

    The record is per machine rather than per course, because an allowance
    belongs to an account and every board here is equally unable to spend one.
    It is written by a tutor whose turn failed saying so, it expires by itself,
    and it is published in `/health`, because only the machine that hit the
    limit can know about it.

    `--clear` exists because a provider's reset time is a promise: an allowance
    that came back early should not have to wait out a guess. A turn going
    through clears it too, without anyone typing anything.
    """
    rec = limits.limit_record()
    if "--set" in args:
        n = args[args.index("--set") + 1] if args.index("--set") + 1 < len(args) else "3600"
        limits.mark_limited(time.time() + float(n))
        print("marked out of allowance for %ss" % n)
        return 0
    if "--clear" in args:
        print("cleared" if limits.clear_limited() else "nothing was recorded")
        return 0
    if not rec:
        print("allowance: fine  (nothing recorded on %s)" % this_node())
        return 0
    left = float(rec["until"]) - time.time()
    print("allowance: GONE until %s  (%d min)"
          % (time.strftime("%H:%M", time.localtime(rec["until"])), left / 60))
    print("agent:     %s" % (rec.get("agent") or "unknown"))
    print("\nturns fail until it returns, and the board says so rather than")
    print("answering with something worse.")
    print("clear it early with:  board limit --clear")
    return 0


def cmd_egress(live, args):
    """Can a turn actually leave this machine, and through where.

        board egress             report
        board egress --repair    rotate exit nodes until a turn can get out

    An exit node is invisible to everything about serving a lesson -- tailnet
    traffic does not go through it, so the iPad reaches the board exactly as
    before. It is entirely visible to the tutor, whose every request leaves from
    somewhere else, and a provider that geo-blocks or challenges commercial VPN
    egress turns that into a tutor which listens, fails every turn, and says so
    only in a log.
    """
    node = egress.exit_node()
    print("exit node: %s" % (node["name"] if node else "none (direct)"))
    print("probe:     %s" % ", ".join(egress.egress_probe_urls()))
    ok = egress.egress_ok()
    print("egress:    %s" % ("reachable" if ok else "NOT REACHABLE"))
    if ok:
        if node:
            egress.remember_good_exit_node(node["ip"])
        return 0
    if "--repair" not in args:
        print("\na turn cannot get out from here. rotate with:  board egress --repair")
        return 1
    ok, detail = egress.rotate_exit_node(log=lambda m: print("  " + m))
    print("\n%s" % ("now reachable through %s" % detail if ok else
                     "could not repair: %s" % detail))
    return 0 if ok else 1


def cmd_doctor(live, args):
    import platform as _pl
    import shutil as _sh
    env_path = tex.tex_env().get("PATH", "")
    ok = True
    print("system:   %s %s" % (_pl.system(), _pl.machine()))
    print("shape:    %s" % machine_shape())
    print("python:   %s" % sys.version.split()[0])
    for exe in ("latex", "pdflatex", "dvisvgm"):
        found = _sh.which(exe, path=env_path)
        print("%-9s %s" % (exe + ":", found or "MISSING"))
        ok = ok and bool(found)
    print("katex:    %s" % ("vendored" if os.path.exists(
        os.path.join(TOOL, "web", "katex", "katex.min.js")) else "MISSING"))
    # Not fatal, and said plainly rather than left to be discovered from a panel
    # that will not fill: without one of these the iPad can still SAVE a PDF, it
    # just cannot READ one on the board -- `paper.renderer`.
    _rend = paper.renderer()
    print("pdf pages: %s" % (
        "%s  (a document can be read on the board)" % _rend[1] if _rend
        else "no pdftoppm, pdftocairo or gs — a PDF can be saved to the device "
             "but not read on the board. Install poppler (brew install poppler, "
             "or your package manager) to fix that."))
    node = _sh.which("node")
    if node:
        p = subprocess.run([node, "-e", "require('jsdom')"], cwd=TOOL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("tests:    %s" % ("all suites runnable" if p.returncode == 0 else
                                "run `bash test/all.sh` — it fetches what it needs"))
    else:
        print("tests:    node not installed (the board does not need it)")
    cfg = read_config(live.root)
    print("repo:     %s" % live.root)
    print("course:   %s" % cfg["name"])
    print("node:     %s" % this_node())
    print("port:     %d (default for this repo)" % default_port(live.root))
    lim = limits.limit_record()
    if lim:
        print("allowance: GONE until %s — '%s' has nothing left to spend here"
              % (time.strftime("%H:%M", time.localtime(lim["until"])),
                 lim.get("agent") or "the tutor"))
    xn = egress.exit_node()
    if xn:
        print("exit node: %s  (every request a tutor makes leaves from there)"
              % xn["name"])
        print("egress:   %s" % ("reachable" if egress.egress_ok()
                                else "NOT REACHABLE — board egress --repair"))
    v4, tsname = ts_info()
    print("tailnet:  %s  (this machine calls itself '%s')"
          % (tsname or "not linked", tailscale.tailnet_hostname()))

    # --- and the half of the machine that actually teaches -------------------
    # Everything above this line is about whether the board can be SERVED. None
    # of it goes wrong on a normal evening. What goes wrong is that the board is
    # up, a tutor is attached, and nothing arrives -- and until this section
    # existed, `board doctor` reported a healthy machine in exactly that state.
    print()
    ok = tutor_health(live) and ok
    return 0 if ok else 1


def tutor_health(live):
    """Who teaches on this machine, and can they. Printed; True if they can.

    Read off the registry (`tutor --agents --json`) rather than by asking a
    provider, so `board doctor` stays something you can run while somebody is
    waiting -- and rather than off `config.json`, which holds only what this
    machine overrides: a recipe it does not mention is the built-in one.
    """
    table = assistants.listing()
    if not table:
        print("teaching: unknown -- `tutor --agents --json` did not answer")
        return False
    wanted = table.get("machine") or table.get("default") or "(unset)"
    print("teaching: '%s'" % wanted)
    if table.get("only"):
        print("only:     %s  (tutor agent only --off lifts it)"
              % table["only"].get("why"))
    recipe = {a.get("name"): a for a in (table.get("agents") or [])}.get(wanted)
    if wanted != "(unset)" and (recipe is None or recipe.get("missing")):
        print("          NOT INSTALLED here — every turn would fail into a log")
        return False
    # The second way a recipe cannot run, and it fails identically: a daemon
    # that listens and then dies every turn in a log nobody opens. Named here
    # because `board doctor` is what somebody runs while a student is waiting.
    need = (recipe or {}).get("unkeyed")
    if need:
        print("          NEEDS %s in %s — put one `%s=...` line in it"
              % (need, keys.store(), need))
        return False
    until = limits.limited_until()
    if until:
        print("allowance: run out until %s  (board limit --clear)"
              % time.strftime("%H:%M", time.localtime(until)))

    # A RECIPE THIS MACHINE'S CONFIG IS HOLDING DOWN, which is the failure
    # nothing could see. `agents` merges one level deep, so a field named in
    # `config.json` beats the built-in recipe for ever: a fix shipped to the
    # tool lands on every machine except the one whose config mentions that
    # field, and the symptom is the tool's own behaviour looking wrong. This
    # machine's config held a verbatim copy of the whole table from an older
    # version; its `codex` entry had neither the resume path nor the sandbox
    # flag, so every resumed Codex turn failed silently while the recipe in the
    # repository read correctly.
    #
    # Asked of the registry rather than worked out here, because the merge is
    # in `bin/tutor` and a second opinion about it would drift -- the same rule
    # `tutorboard/assistants.py` is built on. Not fatal: a machine may have a
    # deliberate override, and this is the line that makes it a decision again
    # rather than something forgotten.
    held = [(a.get("name"), a.get("shadowed"))
            for a in (table.get("agents") or []) if a.get("shadowed")]
    for name, fields in held:
        print("recipe:   '%s' -- %s overrides %s"
              % (name, paths.CONFIG, ", ".join(fields)))
        print("          The built-in recipe has moved on since that was "
              "written. Remove it unless this machine needs it.")
    return True


def cmd_code(live, args):
    """A coding session at the cluster: `board code --help`. Run as `board
    code ...` it never gets here; this is for a caller holding COMMANDS."""
    from tutorboard import code as coding
    return coding.main(args)


# ---------------------------------------------------------------------------
COMMANDS = {
    "start": cmd_start, "stop": cmd_stop, "status": cmd_status,
    "open": cmd_open, "next": cmd_next, "write": cmd_write,
    "inbox": cmd_inbox, "archive": cmd_archive, "export": cmd_export,
    "doctor": cmd_doctor, "slate": cmd_slate, "wait": cmd_wait,
    "vpn": cmd_vpn, "init": cmd_init, "eyes": cmd_eyes, "build": cmd_build,
    "see": cmd_see,
    "finish": cmd_finish, "push": cmd_push, "history": cmd_history,
    "writeup": cmd_writeup, "hw": cmd_writeup, "recap": cmd_recap, "mode": cmd_mode,
    "egress": cmd_egress, "limit": cmd_limit,
    "brief": cmd_brief, "memo": cmd_memo, "handoff": cmd_handoff,
    "step": cmd_step,
    "thread": cmd_thread, "job": cmd_job, "diagnose": cmd_job,
    "ask-cluster": cmd_ask_cluster,
    "hold": cmd_hold, "release": cmd_release, "send": cmd_send,
    "coach": cmd_coach,
    "colibri": cmd_colibri, "code": cmd_code,
    "meeting": cmd_meeting,
    "direction": cmd_direction, "deckfig": cmd_deckfig,
    "round": cmd_round, "textbook": cmd_textbook,
    "session": cmd_session, "bind": cmd_bind, "file": cmd_file,
}

# Commands about a directory or file they are given, not the workspace they run in:
# no `live/` is made for them.
NO_LIVE = ("textbook", "build", "session", "bind", "file", "code")


def help_for(cmd, fn):
    """What one command is for, off its own docstring."""
    said = (fn.__doc__ or "").strip()
    if not said:
        print("board %s -- no help is written for this one. `board help` lists "
              "every command." % cmd)
        return 0
    print("board %s\n\n%s" % (cmd, said))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    rest = argv[1:]
    root = None
    if "--repo" in rest:
        n = rest.index("--repo")
        root = rest[n + 1]
        rest = rest[:n] + rest[n + 2:]
    fn = COMMANDS.get(cmd)
    if not fn:
        print("unknown command: %s (try: board help)" % cmd, file=sys.stderr)
        return 1
    # ASKING FOR HELP IS NOT AN ARGUMENT, and this one is worth the four lines.
    #
    # `board write --help` reached `cmd_write`, which drops anything that looks
    # like an option, read an empty body off a terminal and wrote a BLANK CARD
    # onto the lesson -- pushed to every device, in the transcript, with no undo.
    # Somebody trying to find out what a command does should not be able to
    # damage a sitting by asking.
    #
    # Only in the first position, which is where anybody types it. Further along
    # it may be the value of an option, and guessing which is how `--title
    # --help` becomes a help screen instead of a card.
    #
    # Answered BEFORE the repository is found, because "what does this do" is a
    # question with an answer outside a course.
    if rest and rest[0] in ("-h", "--help", "help"):
        return help_for(cmd, fn)
    if cmd in NO_LIVE:
        return fn(None, rest)
    live = course_repo.resolve(root, create=False)
    live.ensure_dirs(cli=True)
    return fn(live, rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
