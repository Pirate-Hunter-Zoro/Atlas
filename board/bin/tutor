)


# A SHIP IS A TURN, AND IT IS NOT PART OF THE LESSON EITHER.
#
# A mission was set going in this workspace from a board somewhere else and told
# to ship itself when it was done. It is done, and this turn is the ship.
#
# WHY IT IS A DIFFERENT ASSISTANT FROM THE ONE THAT DID THE WORK, and the owner
# answered this before it was built: the local model decodes at three tokens a
# second and it is the one assistant allowed to read the fenced directory, so it
# is the wrong thing to push its own diff. This turn is a second pair of eyes
# that could not have read what it is checking -- which is also why the machine
# check in `board push` is not the whole of it. See `tutorboard/leaving.py`.
#
# It runs FRESH and writes no card, for the same reasons a revision does.
HEADLESS_SHIP_PROMPT = (
    "You are running headless, and THIS TURN IS NOT PART OF THE LESSON. Nobody "
    "is waiting at a board for a card.\n\n"
    "%(inbox)s\n\n"
    "Do this, and nothing else:\n"
    "1. Read what is uncommitted in this repository: `git status` and then "
    "`git diff` over what it names. You are looking at work another assistant "
    "did, so read it rather than trusting it.\n"
    "2. Judge whether it is the mission's work and whether it is safe to make "
    "public. This repository is pushed to a remote anybody can read. The one "
    "thing that must never go is session content -- a transcript line, a "
    "quoted span, an example taken from real audio -- wherever it has been "
    "pasted, including a test fixture or a docstring. If you find any, STOP: "
    "do not push, and say so in your last line so the next turn and the person "
    "can read it.\n"
    "3. If it is clean, run `board push \"<a one-line message saying what the "
    "mission did>\"`. That commits and pushes the whole repository; it is the "
    "only push in this tool and it makes its own machine check before it goes. "
    "If it REFUSES, do not work around it and do not pass `--anyway`: the "
    "refusal names a file, and saying so is the answer.\n\n"
    "**Write no card.** Do not run `board write`, do not run `board open`, do "
    "not touch `live/state.json`, `live/cards/` or `HANDOFF.md`, and do not run "
    "`board wait`. Do not read `AI_INSTRUCTIONS.md`, `live/TEACHING.md` or the "
    "cards: none of them is about this. End the turn when the push has "
    "happened, or when you have said why it must not."
)


def turn_plan(spec, carried, recycle, signal=""):
    """Which recipe and which prompt this turn gets, and whether it is fresh.

    `carried` is how many turns the agent's current session already holds; 0
    means there is nothing to resume. `recycle` is `session_turns` from the
    config -- 0 resumes for ever. `signal` is what the inbox line says this turn
    is for, which matters for exactly one of them.

    Resuming saves re-reading the contract, the method and the lesson. It is not
    free: a resumed turn resends the whole conversation as input, so turn twenty
    pays for nineteen turns of history. Past a point a fresh session that reads
    the contract once and the lesson back through `board recap` is cheaper than
    carrying everything, so this is where the two are traded off.

    A REVISION IS ALWAYS FRESH, whatever is there to resume. It is not part of
    the lesson -- see `HEADLESS_REVISE_PROMPT` -- and resuming one into a lesson
    drags the lesson into the document and the document back into the lesson. A
    SHIP is the same: it reads a diff and pushes it, and a lesson resumed into
    that is a tutor that thinks the evening was about git.
    """
    recipe = spec.get("headless")
    first = spec.get("headless_first") or recipe
    if signal == "revise":
        return first, HEADLESS_REVISE_PROMPT, True
    # An overhaul is a revision's louder twin and runs fresh for the same
    # reason. What differs is only what it is allowed to do to the document.
    if signal == "rework":
        return first, HEADLESS_REWORK_PROMPT, True
    # A ship is the same shape: its own session, nothing of the lesson in it,
    # and nothing of it left in the lesson afterwards.
    if signal == "ship":
        return first, HEADLESS_SHIP_PROMPT, True
    # And a document asked for mid-sitting. Fresh for the revision's reason
    # rather than the ship's: the lesson resumed into it is exactly the narration
    # a write-up must not be, and this is the one turn whose product is that
    # document.
    if signal == "writeup":
        return first, HEADLESS_WRITEUP_PROMPT, True
    # A CARRY RESUMES, WHATEVER THE COUNT SAYS. `session_turns` is 1, so
    # `carried` is 0 or 1 and every turn is otherwise fresh -- which makes the
    # `--continue` recipe unreachable and costs a 15,900-token preamble at a few
    # tokens a second of prefill on every hop. This is the one place that is
    # overridden, and the reason is that there IS a session: the turn that just
    # died opened it.
    if signal == "carry":
        return recipe, HEADLESS_CARRY_PROMPT, False
    fresh = carried == 0 or bool(recycle) and carried >= recycle
    return (first if fresh else recipe,
            HEADLESS_FIRST_PROMPT if fresh else HEADLESS_RESUME_PROMPT,
            fresh)


def carry_after(signal, fresh, carried):
    """How many turns the agent's session carries once this turn has finished.

    Ordinarily: one if it started a new session, one more if it resumed. The
    exceptions are a revision, an overhaul, a ship and a document asked for
    mid-sitting, and they are the reason this is a function rather than an
    expression. A revision runs FRESH, so the agent's current conversation is now
    about a document -- and leaving the count at one would make the next turn of
    the LESSON resume into it, which is exactly the drag the revision was made
    fresh to avoid. Zero, so the next lesson turn starts its own session and
    reads the lesson back with `board recap`.
    """
    if signal in ("revise", "rework", "ship", "writeup"):
        return 0
    return 1 if fresh else carried + 1


# WHAT A TURN WAS WOKEN FOR, so the board can say it while the turn runs.
#
# `board inbox` prints a message as `[<iso>] [<signal>] <text>`, and the signal
# is the one word that says what kind of work this turn is. The board needs it
# for exactly one reason and it is a reported one: a direction change wakes a
# turn that rewrites the plan, and that turn OPENS with a card saying it is
# re-planning. The strip's rule is "a card landed, so stop talking", so the
# indicator went away in the first ten seconds of a job that takes minutes --
# "I got left hanging for a bit while it was thinking and modifying the plan".
#
# Anchored at the start of the message rather than searched for, because a
# student who writes "[help]" in the middle of a sentence has not sent a signal.
_SIGNAL_TAG = re.compile(r"^\[[^\]\n]*\]\s*\[([a-z]+)\]")


def turn_signal(out):
    """The signal the inbox message carries, or "". Never raises."""
    for line in (out or "").splitlines():
        line = line.strip()
        if not line:
            continue
        m = _SIGNAL_TAG.match(line)
        return m.group(1) if m else ""
    return ""


def open_mission(root):
    """The newest mission record in this workspace that has not ended, or None.

    Which mission the turn that just died was working: a daemon answers one
    workspace and a workspace runs one mission at a time, so the newest open
    record is it.
    """
    try:
        for rec in missions.stored(root):
            if not rec.get("ended"):
                return rec
    except Exception:                                        # noqa: BLE001
        pass
    return None


def mission_turn(root, log=None, renew=False):
    """Stamp the open colibrì mission with a turn in flight. `(record, env)`.

    Three things at once, all of them about the node going away. `turn_at` is
    the only evidence of a turn in flight that a board hop cannot overwrite --
    see `missions.turn_open`. `ceiling` is re-stamped off the generation this
    turn is about to step into, because the one the dispatch saw may be two
    hops back and a passed ceiling reads as an ending. `session` is the
    conversation id the client opens now and resumes after a hop, so a pick-up
    names the conversation rather than taking whichever is newest in the
    directory.

    `env` is what the turn runs with, and both are None where there is no
    colibrì mission -- an ordinary sitting owns none of this.

    `renew` mints a new id, and EVERY TURN THAT IS NOT RESUMING NEEDS ONE: the
    client refuses `--session-id` for an id that already has a conversation and
    exits 1, so handing a fresh launch the id the last turn opened kills the
    turn. A resume that found nothing to resume needs one for the same reason.
    """
    rec = open_mission(root)
    if not rec or rec.get("agent") != "colibri":
        return None, None
    sid = ("" if renew else str(rec.get("session") or "")) or str(uuid.uuid4())
    ceiling = None
    try:
        said = colibri.status(fresh=True)
        left = said.get("left")
        if (isinstance(left, (int, float))
                and said.get("state") in ("warm", "loading")):
            ceiling = time.time() + float(left)
    except Exception:                                        # noqa: BLE001
        pass
    rec = missions.turn_open(root, rec, ceiling=ceiling, session=sid)
    if log:
        log.write("-- mission %s in session %s\n" % (rec.get("id"), sid))
    return rec, dict(os.environ, COLI_SESSION_ID=sid)


def carry_line(out):
    """The same inbox message, tagged as a pick-up rather than a first ask.

    The tag rides in the text because that is where `turn_signal` reads it from,
    and the stamp stays in front of it because `board inbox` writes the stamp
    and the daemon is re-queueing something that has already been printed. Every
    later line -- file paths, a slate -- is kept exactly as it was.
    """
    if turn_signal(out) == "carry":
        return out
    lines = (out or "").splitlines()
    for i, line in enumerate(lines):
        if not line.strip():
            continue
        m = re.match(r"^(\[[^\]\n]*\]\s*)(.*)$", line)
        lines[i] = (m.group(1) + "[carry] " + m.group(2) if m
                    else "[%s] [carry] %s"
                    % (time.strftime("%Y-%m-%d %H:%M:%S"), line))
        return "\n".join(lines)
    return "[%s] [carry] " % time.strftime("%Y-%m-%d %H:%M:%S")


def carry_spent(root, rec):
    """Is there nothing left to pick this mission up with? The daemon's stop.

    THE STOPPING CONDITION LIVES IN THE RECORD AND IS READ BACK FROM IT, so
    the daemon and the hub give up on the same mission at the same moment
    rather than each counting for itself. An ending on the file counts too:
    once a board has frozen a mission, a daemon still re-queueing it is a turn
    every five minutes against work nobody is waiting for.
    """
    if not rec:
        return False
    got = next((r for r in missions.stored(root)
                if r.get("id") == rec.get("id")), rec)
    return bool(got.get("ended")) or not missions.has_budget(got)


def take_hop(root, log, out, this_signal, ran, why, rec=None):
    """Own this mission's pick-up and re-queue the work. `(mine, pending)`.

    `mine` is False where there is no colibrì mission in that workspace at
    all, or where its budget is gone, and the caller falls through to ordinary
    failure handling -- a sitting that is not a mission has nothing to carry,
    and a mission out of pick-ups is the failure this turn looks like.

    `rec` IS THE MISSION THE TURN OPENED, AND THE CALLER HAS TO SAY WHICH.
    Nothing stops a second mission being dispatched into a workspace while the
    first one's turn is running, and `open_mission` then answers with the
    newer record -- so the hop is charged to a mission that has not run and
    the one that was cut off is left owed, which is the same work queued
    twice. Derived here only where the caller has no record to name.

    THE CLAIM IS WHAT STOPS TWO CLIENTS LANDING ON ONE CONVERSATION. Every
    board on the machine sweeps every workspace, so this daemon and another
    board's hub can both decide the same hop is owed. Whoever loses the
    exclusive create writes no `pending` and falls back to `board wait`, where
    the winner's `[carry]` line is already sitting.
    """
    mrec = rec if rec is not None else open_mission(root)
    if not mrec or mrec.get("agent") != "colibri":
        return False, None
    if carry_spent(root, mrec):
        log.write("-- %s, and mission %s has no pick-ups left to spend\n"
                  % (why, mrec.get("id")))
        return False, None
    log.write("-- %s; picking the mission up where it stopped\n" % why)
    sync_transcript(root, log)
    # Owed first, so a node dying inside this window leaves the repair on disk
    # for whichever board comes up next.
    missions.owe_carry(root, mrec)
    if this_signal == "carry":
        missions.stalled(root, mrec, ran)
    # Re-read before claiming: `claim_carry` names its exclusive flag for the
    # hop number, and `stalled` has just rewritten the file.
    got = next((r for r in missions.stored(root)
                if r.get("id") == mrec.get("id")), None)
    if not got or not missions.claim_carry(root, got):
        log.write("-- another board has taken this hop; its line is in the "
                  "inbox and this one waits for it\n")
        return True, None
    return True, carry_line(out)


def agent_state(live, **kw):
    path = os.path.join(live, "agent.json")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            st = json.load(fh)
    except (OSError, ValueError):
        st = {}
    st.update(kw)
    st["last_seen"] = time.time()
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(st, fh, indent=2)
    os.replace(tmp, path)
    return st


def owed_message(live):
    """A student message a previous daemon failed on and never answered, or None.

    The other half of `owe` in `headless`. Read once at the top of a daemon's
    life, because the alternative -- an inbox line the board already marked read
    -- hands the next daemon a `board wait` that blocks for ever over work that
    was handed in.
    """
    try:
        with open(os.path.join(live, "agent.json"), "r", encoding="utf-8") as fh:
            got = (json.load(fh) or {}).get("owed")
    except (OSError, ValueError):
        return None
    return got if isinstance(got, str) and got.strip() else None


def record_is_ours(live, pid=None):
    """Does `agent.json` still name this process as the daemon on it?

    `agent_state` is a read-modify-write on one file that several processes
    write -- this daemon, the launcher, `tutor restart`, the hub -- and merging
    is what makes that safe for a field somebody is adding. It is not safe for
    the LAST write a daemon makes, which is `state: "stopped"`: a bounce hands
    the workspace over, the successor comes up and records its own pid, and the
    process that was replaced then stamps `stopped` on the record of the one
    that replaced it. `supervise.tutor_verdict` reads `stopped` as "a person
    said no" and never revives it, so the cost is a board that serves perfectly
    with nothing reading it until somebody notices by hand.

    Only the exit write is guarded, and the test is deliberately generous: an
    unreadable record, and a record whose pid a start has not filled in yet, are
    both answered yes. The successor writes its real pid within seconds of
    forking, which is the window this closes -- the narrow one where two daemons
    are alive and only one of them owns the file.
    """
    pid = os.getpid() if pid is None else pid
    try:
        with open(os.path.join(live, "agent.json"), "r", encoding="utf-8") as fh:
            got = (json.load(fh) or {}).get("pid")
    except (OSError, ValueError):
        return True
    return not got or got == pid


def mark_waking(live, agent_name, pid=None):
    """Record that a tutor is on its way up, before anything slow is attempted.

    Written by both halves of a start -- the launcher that decides, and the
    daemon that then spends several seconds bringing a link, a board and a
    sitting up before it can listen. Either is enough on its own, which matters
    because a person can start a daemon directly and never go through the other.

    IT CLEARS THE TWO FLAGS THAT SAY A DAEMON IS OWED. `restarting` says a
    bounce is unfinished and `handover` says the machine went, and both are
    answered by a daemon arriving -- this one. `agent_state` merges, so a flag
    nothing clears survives every later write, and a record still carrying
    `handover` while it listens makes the NEXT stop of it read as a machine
    going away: `supervise.tutor_verdict` returns `revive` and the watchdog
    starts the workspace's configured assistant over whoever was deliberately
    put there. A start is the only thing that has earned the right to clear
    either, and it is the one place every path up goes through.

    IT LEAVES `last_error` AND `failed_at` ALONE WHERE THE FAILURE BELONGS TO THE
    AGENT COMING UP, and that is the whole of what the board has to show for a
    turn that wrote no card. A daemon is most often restarted BECAUSE the last
    turn fell over, so clearing the reason here erases it at the one moment
    somebody is looking for it: the iPad then reads `listening`, no error, no
    card, which is the tutor claiming to be fine about work it never did. What
    retires a failure is something NEWER -- a turn that GOES THROUGH clears it on
    its success, and `lesson.state._failure` drops it the moment a card is
    written past it. A start is not newer than anything.

    AND IT CLEARS THE CLOCKS THE DAEMON BEFORE THIS ONE LEFT BEHIND. `agent_state`
    merges, so `stopped_at`, `turn_started` and `turn_signal` from a process that
    is gone sit in the same record as this one's `started` and are read as
    though they were this one's -- the board draws how long a turn has been
    running off `turn_started`, and a record carrying 17:40:07 beside a daemon
    that came up at 20:16 draws a turn that has been going for two and a half
    hours. A start is the one moment that has earned the right to clear them,
    because it is the one moment they are certainly about somebody else.

    AND A FAILURE IS DROPPED WHEN THE AGENT CHANGES, because the strip names the
    agent on the record and would otherwise paint the new one with the old one's
    fault: "claude's last turn failed -- cannot reach api.deepseek.com", about a
    host claude never opens. `failed_agent` is stamped beside the error for
    exactly this comparison. A provider swap is the common case here -- it is
    what a climb-down IS -- so the error is kept only where it is still about
    whoever is about to teach.
    """
    try:
        return agent_state(live, agent=agent_name, pid=pid, state="waking",
                           waking_at=time.time(), restarting=False,
                           handover=None, host=this_host(),
                           stopped_at=0, turn_started=0, turn_signal="",
                           **not_this_agents_failure(live, agent_name))
    except OSError:
        return None


def not_this_agents_failure(live, agent_name):
    """The fields that drop a failure belonging to somebody else, or `{}`.

    Written wherever the agent ON the record changes -- a start, and a
    climb-down between turns -- because the board reads the agent and the
    failure out of the same record and puts them in one sentence. A failure that
    outlives the provider it happened to is then a sentence about the wrong
    provider, which is a new way to mislead rather than the honest history the
    retention is for.
    """
    try:
        with open(os.path.join(live, "agent.json"), "r", encoding="utf-8") as fh:
            was = json.load(fh) or {}
    except (OSError, ValueError):
        return {}
    if not was.get("last_error"):
        return {}
    whose = was.get("failed_agent") or was.get("agent")
    if whose == agent_name:
        return {}
    return {"last_error": None, "failed_at": 0, "failed_agent": None}


def headless_stop(cfg, args):
    stopped = 0
    for c in courses(cfg):
        path = os.path.join(c["root"], "live", "agent.json")
        try:
            with open(path, "r", encoding="utf-8") as fh:
                st = json.load(fh)
        except (OSError, ValueError):
            continue
        pid = st.get("pid")
        # An interactive assistant is somebody's terminal. `headless --stop` is
        # for daemons, and killing a session a person is sitting in front of is
        # not what anyone typing it meant.
        if st.get("mode") == "interactive":
            continue
        if pid and st.get("host") == this_host():
            try:
                os.kill(pid, signal.SIGTERM)
                print("  stopped %s (pid %d)" % (c["dir"], pid))
                stopped += 1
            except OSError:
                pass
        try:
            os.remove(path)
        except OSError:
            pass
    print("stopped %d" % stopped if stopped else "nothing was listening")
    return 0


def sync(root, quiet=False):
    """Pull whatever another machine pushed, before the session starts.

    The point of the handoff is that a course can be picked up somewhere else,
    and a handoff written on the machine you left is worth nothing to the one
    you arrive on until it is fetched. So every session begins by catching up.

    Fast-forward only, and never fatal. A session that will not start because a
    branch diverged is worse than a session that starts a commit behind and says
    so -- the person is holding an iPad and cannot fix a merge from there.

    And it does not touch a repository somebody is part-way through an operation
    in. A course is somewhere its owner works, not only somewhere they are
    taught; a fast-forward arriving in the middle of their rebase is the tutor
    reaching into a terminal it knows nothing about.
    """
    if not worktree.git_dir(root):
        return None
    busy = worktree.busy_reason(root)
    if busy:
        if not quiet:
            print("  not synced: %s here, so the repository is left exactly as it is"
                  % busy)
        return False
    # A pull needs the index too, so a lock a killed git left behind stops a
    # session opening up to date just as surely as it stops a commit. Rubbish
    # goes out here as well; a lock somebody is holding is left, and the pull
    # below fails and says so in the usual way.
    cleared = worktree.clear_stale_lock(root)
    if cleared and not quiet:
        print("  " + cleared)
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/false")
    def git(*args, **kw):
        return subprocess.run(["git"] + list(args), cwd=root, env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              timeout=kw.get("timeout", 45))
    try:
        if git("remote", "get-url", "origin").returncode != 0:
            return None
        before = git("rev-parse", "HEAD").stdout.decode().strip()
        p = git("pull", "--ff-only", timeout=60)
        after = git("rev-parse", "HEAD").stdout.decode().strip()
    except (OSError, subprocess.TimeoutExpired):
        if not quiet:
            print("  could not reach the remote; working with what is here")
        return False
    if p.returncode != 0:
        out = p.stdout.decode("utf-8", "replace").strip().splitlines()
        if not quiet:
            print("  not synced: %s" % (out[-1] if out else "pull failed"))
            print("  the session will start anyway, on what is here")
        return False
    if before != after and not quiet:
        n = git("rev-list", "--count", "%s..%s" % (before, after)).stdout.decode().strip()
        print("  pulled %s commit(s) from another machine" % n)
    return True


# ---------------------------------------------------------------------------
# The tool pulls itself.
#
# `sync` above catches a COURSE up -- the lesson, the handoff, the chapters
# taught before this one. Nothing ever caught up the *board*, and no timer can:
# a compute node ceases to exist, so a schedule on one is not a plan -- and a fix
# pushed from anywhere sat on GitHub until somebody remembered to pull it by
# hand, which is the thing this repository keeps failing at.
#
# The only moment a compute node gets is the moment you log in to it, which is
# already where `tutor resume` runs. So the pull goes there, and the launcher
# gets it too.
#
# Three states, carried in the environment across the re-exec below:
#
#   unset     nothing has been pulled yet in this process tree;
#   "moved"   the pull moved HEAD, and this process is the one running the code
#             that arrived -- what is still holding the old code must be bounced;
#   "done"    pulled, or there was nothing to pull. Do not pull again.
TOOL_SYNC = "TUTOR_TOOL_SYNC"


def tool_pull(root=None):
    """Fast-forward this repository, the tool itself. Returns (moved, message).

    Same rules as `sync`, for the same reasons: `--ff-only`, never fatal, and
    quiet when there was nothing to do. A diverged branch or a dead remote is one
    line and the session starts anyway -- somebody holding an iPad cannot resolve
    a merge, and a launcher that refuses to launch is worse than a launcher one
    commit behind.

    Nothing is pulled over the top of an operation in progress either. This
    repository is somewhere work happens too, and a fast-forward -- followed by
    this process re-execing on the code that arrived -- is not a thing to do
    underneath somebody's half-finished rebase.
    """
    root = root or TOOL
    if not worktree.git_dir(root):
        return False, None
    busy = worktree.busy_reason(root)
    if busy:
        return False, ("  the board was not updated: %s here, so it is left "
                       "exactly as it is" % busy)
    # Same rubbish, same answer: a lock nobody holds in the TOOL's repository
    # would stop every board on this machine from ever updating again.
    worktree.clear_stale_lock(root)
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/false")

    def git(*args, **kw):
        return subprocess.run(["git"] + list(args), cwd=root, env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              timeout=kw.get("timeout", 45))
    try:
        if git("remote", "get-url", "origin").returncode != 0:
            return False, None
        before = git("rev-parse", "HEAD").stdout.decode().strip()
        p = git("pull", "--ff-only", timeout=60)
        after = git("rev-parse", "HEAD").stdout.decode().strip()
    except (OSError, subprocess.TimeoutExpired):
        return False, "  the board could not reach its remote; running what is here"
    if p.returncode != 0:
        out = p.stdout.decode("utf-8", "replace").strip().splitlines()
        return False, ("  the board did not update: %s"
                       % (out[-1] if out else "pull failed"))
    if not before or before == after:
        return False, None
    return True, "  pulled the board: %s -> %s" % (before[:8], after[:8])


def tool_reexec():
    """Replace this process with the version of it that was just pulled.

    `bin/tutor` was read into memory when this process started, exactly the way a
    board reads `serve.py`. Pulling a fix to the launcher and then carrying on
    inside the launcher that was there before the
    pull is the same bug this repository keeps relearning, one level further in --
    and it is the one that would be hardest to see, because the version that
    reports what it did would be the old one.

    Normally this does not return. If the exec fails there is nothing to do but
    carry on with what is loaded, which is a commit behind and still works.
    """
    os.environ[TOOL_SYNC] = "moved"
    # `execve` throws away whatever is sitting in this process's buffers, and
    # stdout is a pipe or a log file every time this runs for real -- which is
    # to say buffered. The line saying what was pulled would be lost in exactly
    # the situation it was written for: reading the log afterwards to find out
    # why the board changed under a lesson.
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        os.execve(sys.executable,
                  [sys.executable, os.path.realpath(__file__)] + sys.argv[1:],
                  dict(os.environ))
    except OSError:
        os.environ[TOOL_SYNC] = "done"
    return False


def tool_adopt(cfg):
    """Put the processes still holding the old code onto the code that arrived.

    This is `scripts/ship.sh` seen from the other end. Shipping bounces the boards
    and tutors on the machine the change was written on; the machine that
    *receives* the change has to do the same thing, or the fix is on disk and
    nowhere else -- the pages are served from disk and look new while the
    endpoints behind them are the old ones. That is the single most expensive
    misunderstanding this repository has produced, and a pull without a restart
    is how it happens quietly.

    `cmd_restart` decides what is safe to touch: only boards answering on this
    node, the proxy if this machine has one, and never a tutor mid-turn.
    """
    return cmd_restart(cfg, ["--tutors"]) == 0


def tool_sync(cfg, quiet=False):
    """Catch this machine up on the board, and bounce what is holding old code.

    Called from the two places a session begins -- `tutor resume`, which is what a
    login hook runs, and the launcher. Not from `tutor restart`, which `ship.sh`
    calls immediately after a push, where there is nothing to pull.

    `quiet` silences the "there is no network today" line, which would otherwise
    appear on every login on a machine that has none. It does not silence an
    actual update: a board that has just changed underneath a running lesson is
    worth a line in the log, and both callers of `--quiet` write to one.
    """
    stage = os.environ.get(TOOL_SYNC)
    if stage == "moved":
        os.environ[TOOL_SYNC] = "done"
        return tool_adopt(cfg)
    if stage:
        return False
    moved, msg = tool_pull()
    os.environ[TOOL_SYNC] = "done"
    if msg and (moved or not quiet):
        print(msg)
    if not moved:
        return False
    tool_reexec()                 # normally never returns
    return tool_adopt(cfg)


# The parts of `live/` that are the transcript rather than runtime state: what a
# lesson IS, and what it would be a bug to lose. `live/state.json` and
# `live/text/` are not here on purpose -- those are a snapshot by nature and the
# newest one is the right one.
TRANSCRIPT_DIRS = ("live/slate", "live/answers", "live/cards", "live/annotations")
TRANSCRIPT_FILES = ("live/turns.jsonl",)


def archived_names(root):
    """Every basename anywhere under `live/archive/`, which is where a filed
    lesson's pages, answers and cards legitimately go."""
    names = set()
    base = os.path.join(root, "live", "archive")
    for here, _dirs, files in os.walk(base):
        for name in files:
            names.add(name)
    return names


def keep_transcript_files(root, git, note):
    """Refuse to commit the disappearance of anything that is the lesson.

    Called with the index already staged. Anything staged as a deletion under a
    transcript directory, whose basename is not now in the archive, is checked
    back out of HEAD -- which un-stages the deletion and puts the file back on
    disk in one move.
    """
    paths = list(TRANSCRIPT_DIRS) + list(TRANSCRIPT_FILES)
    # `--no-renames`, and it is load-bearing: two slate pages are routinely
    # byte-identical -- a page cut as a copy of another, an attempt handed in
    # twice -- so a deletion paired with an addition of the same bytes is
    # reported as a RENAME, and a rename is not a deletion. The very files this
    # is here to protect are the ones most likely to hide behind it.
    p = git("diff", "--cached", "--no-renames", "--name-only",
            "--diff-filter=D", "--", *paths)
    if p.returncode != 0:
        return []
    gone = [l.strip() for l in p.stdout.decode("utf-8", "replace").splitlines()
            if l.strip()]
    if not gone:
        return []
    filed = archived_names(root)
    put_back = [g for g in gone if os.path.basename(g) not in filed]
    if not put_back:
        return []
    # In batches, because a filed chapter can be hundreds of files and a command
    # line has a limit.
    for i in range(0, len(put_back), 200):
        git("checkout", "HEAD", "--", *put_back[i:i + 200])
    note("transcript: put back %d file(s) another machine's snapshot dropped: %s"
         % (len(put_back),
            ", ".join(os.path.basename(x) for x in put_back[:6])
            + (" …" if len(put_back) > 6 else "")))
    return put_back


def keep_pulled_files(root, git, note, before):
    """Undo a pull that took somebody's working off the disk.

    THE PULL IS THE DESTRUCTIVE HALF. Two clones commit snapshots of `live/`,
    so each one's commit deletes the other's newest pages -- and a fast-forward
    then CHECKS THAT OUT, physically removing files this machine has and the
    other never saw. `keep_transcript_files` cannot help afterwards: HEAD has
    moved, and a file HEAD does not hold is a file HEAD cannot put back.

    Same rule as the commit side, and it has to be the same rule: a deletion
    whose basename is now in `live/archive/` is `board archive` doing its job,
    and anything else is a snapshot talking about a machine it is not on. Those
    come back out of the commit we were on before the pull, and the beat that
    follows commits them as the additions they are.
    """
    if not before:
        return []
    after = git("rev-parse", "HEAD").stdout.decode().strip()
    if not after or after == before:
        return []
    paths = list(TRANSCRIPT_DIRS) + list(TRANSCRIPT_FILES)
    p = git("diff", "--no-renames", "--name-only", "--diff-filter=D",
            before, after, "--", *paths)      # see above on --no-renames
    if p.returncode != 0:
        return []
    gone = [l.strip() for l in p.stdout.decode("utf-8", "replace").splitlines()
            if l.strip()]
    if not gone:
        return []
    filed = archived_names(root)
    put_back = [g for g in gone if os.path.basename(g) not in filed]
    if not put_back:
        return []
    for i in range(0, len(put_back), 200):
        git("checkout", before, "--", *put_back[i:i + 200])
    note("transcript: a pull would have removed %d file(s) of this machine's "
         "working; put back: %s"
         % (len(put_back),
            ", ".join(os.path.basename(x) for x in put_back[:6])
            + (" …" if len(put_back) > 6 else "")))
    return put_back


def sync_transcript(root, log=None):
    """Commit and push the lesson transcript, pulling first.

    The transcript -- cards, turns, ink, answers, session state and the archive
    -- is versioned, so a lecture is the same wherever it is picked up. This runs
    on a beat while the headless tutor is alive: an allocation that dies
    mid-lesson costs one beat of work, not the evening. The pull is
    fast-forward-only and everything here is non-fatal -- a diverged branch or a
    dead remote is logged and retried next beat, never resolved by hand, because
    a transcript is append-only on one machine at a time and a merge is the last
    thing it should ever need.

    AND IT IS NOT THE ONLY THING IN THIS REPOSITORY. The person being taught here
    is the same person who opens a terminal in it and works, and this runs
    unattended every ninety seconds with nobody watching what it does to git. So
    it takes two promises, both in `tutorboard.worktree`: it does nothing at all
    while a rebase, a merge or a bisect is outstanding, and its commit names the
    transcript explicitly rather than committing whatever happened to be in the
    index. Committing the index is what it used to do, and a beat landing in the
    middle of somebody's afternoon would carry their half-staged refactor into
    history under the message "lesson transcript".
    """
    if not worktree.git_dir(root):
        return
    busy = worktree.busy_reason(root)
    if busy:
        if log:
            try:
                log.write("transcript: left alone this beat -- %s\n" % busy)
            except (OSError, ValueError):
                pass
        return
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/false")

    def note(line):
        if log:
            try:
                log.write(line + "\n")
            except (OSError, ValueError):
                pass

    # THE BEAT IS WHAT HEALS A LOCK, BECAUSE IT IS THE ONLY THING THAT COMES BACK.
    #
    # Everything here runs git under a timeout, and a git killed at its timeout
    # leaves `.git/index.lock` on disk. From then on nothing in this repository
    # can commit: not this beat, not the save button, not the person's own
    # terminal. That happened on Galois Theory on 10 September and it went
    # unnoticed for seventy minutes, because the beat's own failure was silent
    # -- see the `git add` below -- and a save from the iPad answered with git's
    # advice to remove the file by hand.
    #
    # A lock nobody holds is rubbish, and this runs every ninety seconds whether
    # or not anybody is looking, which makes it the right place to throw it out.
    # A lock somebody IS holding is left alone and the beat waits, which costs
    # one beat and is exactly what waiting is for.
    verdict, _ = worktree.lock_reason(root)
    if verdict == "held":
        note("transcript: left alone this beat -- the git index is locked by a "
             "command that is still running")
        return
    if verdict == "stale":
        cleared = worktree.clear_stale_lock(root)
        if cleared:
            note("transcript: " + cleared)

    def git(*args, **kw):
        return subprocess.run(["git"] + list(args), cwd=root, env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              timeout=kw.get("timeout", 60))
    try:
        if git("remote", "get-url", "origin").returncode != 0:
            return
        # Where we were, so a pull that DELETES somebody's working can be told
        # from one that merely brings work in. The pull is the destructive half
        # of this loop and the guard below the commit cannot see it: after a
        # fast-forward, HEAD no longer holds the file, so there is nothing left
        # to restore it from. This is the only moment that knows.
        before = git("rev-parse", "HEAD").stdout.decode().strip()
        p = git("pull", "--ff-only")
        if p.returncode != 0:
            out = p.stdout.decode("utf-8", "replace").strip().splitlines()
            note("transcript: not pulled (%s)" % (out[-1] if out else "pull failed"))
        else:
            keep_pulled_files(root, git, note, before)
        # Checked, not fired and forgotten. An `add` that fails stages nothing,
        # so the `diff --cached` below finds nothing to commit and this returns
        # as though the beat had simply had a quiet ninety seconds -- which is
        # how a locked index went seventy minutes without a word while pages
        # piled up uncommitted. A beat that cannot do its job says so.
        added = git("add", "-A", "live")
        if added.returncode != 0:
            out = added.stdout.decode("utf-8", "replace").strip().splitlines()
            note("transcript: NOT staged (%s)" % (out[-1] if out else "git add failed"))
            return
        # A TRANSCRIPT IS APPEND-ONLY, SO A COMMIT MUST NEVER SAY A PAGE IS GONE.
        #
        # Two clones run this on a beat over the same course, and `git add -A`
        # commits a SNAPSHOT of whichever working tree it is standing in. Neither
        # machine has the other's newest pages, so each snapshot deletes the
        # other's -- and the next fast-forward pull checks that snapshot out and
        # removes the files from disk. Measured on Galois Theory: `live/slate/`
        # pages 50 to 53, written between 10:13 and 10:25, present in one line of
        # history and physically absent from the working tree by 11:09. From the
        # iPad that is "none of the boards have my preserved written work on them"
        # with the work genuinely gone from the sheet it was on.
        #
        # Nothing in this tool ever deletes a slate page, an answer or a card
        # except `board archive`, which RENAMES it under `live/archive/` -- so a
        # deletion whose basename is somewhere in the archive is accounted for and
        # anything else is a snapshot talking about a machine it is not on. Those
        # are put back, on disk as well as in the index, which also repairs a
        # clone that has already been clobbered by a pull.
        keep_transcript_files(root, git, note)
        # `-- live`, both times. `git commit` commits the INDEX, so asking
        # whether there is anything to commit -- and then committing it -- swept
        # up anything a person had staged in a terminal here. `--only` takes the
        # named paths from the working tree and leaves the rest of the index
        # exactly as it was, which is what makes a beat safe to run underneath
        # somebody who is working.
        if git("diff", "--cached", "--quiet", "--", "live").returncode == 0:
            return
        if git("commit", "-m", "lesson transcript",
               "--only", "--", "live").returncode != 0:
            return
        # `origin HEAD` rather than a bare push, so it works whether or not the
        # clone has an upstream set for its branch.
        q = git("push", "origin", "HEAD")
        note("transcript: pushed" if q.returncode == 0 else "transcript: push failed")
    except (OSError, subprocess.TimeoutExpired):
        note("transcript: could not reach the remote")


def agent_record(root):
    """What `live/agent.json` says, believed or not."""
    try:
        with open(os.path.join(root, "live", "agent.json"), "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def agent_live(root):
    """The daemon recorded for this course, if it is really there.

    A pid on a shared filesystem proves nothing -- the record may have been
    written by a node whose allocation has since ended -- so the host is checked
    before the pid is believed.
    """
    st = agent_record(root)
    return st if processes.agent_is_attached(st, this_host()) else None


def agent_held_elsewhere(cfg, course, agent_name):
    """Which OTHER workspace already has this agent listening, or None.

    Asked only of an agent whose recipe says it is `exclusive`, and asked across
    the whole MACHINE rather than this process: what is being protected is a
    server with one slot in it, and the sitting that would evict it may be on
    another node. The home directory is shared, so the record of a tutor over
    there is readable from here -- which is exactly what has to be found -- and
    the heartbeat is the only honest test of it, never the pid, because a pid
    written on one node names a process table this one cannot read.
    """
    for c in courses(cfg):
        if paths.same_dir(c["root"], course["root"]):
            continue
        rec = agent_record(c["root"])
        if not rec or rec.get("agent") != agent_name:
            continue
        if rec.get("host") == this_host():
            if agent_live(c["root"]):
                return c["dir"]
        elif processes.agent_attached_away(rec, rec.get("host")):
            return c["dir"]
    return None


def cards_are_tracked(root):
    """Would a card written in this workspace be committed?

    `git check-ignore` rather than a list of workspaces: the answer is a property
    of the repository and it is written down in the one place that decides it.
    Exit 0 means ignored, 1 means it would be tracked, and anything else means
    there is no git here to ask -- which is not a reason to refuse anybody.
    """
    probe = os.path.join(root, "live", "cards", "0001-probe.md")
    try:
        p = subprocess.run(["git", "check-ignore", "-q", probe], cwd=root,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return p.returncode == 1


def agent_start(cfg, course, agent_name, session=None):
    """Put an assistant in this course's repository, detached.

    Detached because the thing asking is usually an HTTP request from the iPad,
    which must not wait on an agent, and because the daemon has to outlive the
    request that started it.
    """
    root = course["root"]
    live_dir = os.path.join(root, "live")
    st = agent_live(root)
    if st:
        # A start already in flight is not a reason to start a second one, and
        # it is not "already listening" either -- saying so to whoever asked
        # would be the same lie the board was telling.
        if st.get("state") == "waking":
            return 0, "%s is already waking up in %s" % (st.get("agent"),
                                                         course["dir"])
        return 0, "%s already listening in %s" % (st.get("agent"), course["dir"])
    if not agent_name:
        return 1, "no agent resolved for %s" % course["dir"]
    spec = cfg["agents"].get(agent_name) or {}
    if not spec.get("headless"):
        return 1, "'%s' has no headless recipe; add one in %s" % (agent_name, CONFIG)
    gone = missing_command(spec.get("headless"))
    if gone:
        return 1, ("'%s' needs `%s`, which is not on the path here; "
                   "try: tutor --agents" % (agent_name, gone))
    # REFUSED BY NAME, BEFORE `waking` IS WRITTEN. Both of these are properties
    # of the recipe rather than of this file: the strings on the entry are the
    # reasons, so the day either stops being true the line comes out of the
    # table and nothing here has to be edited.
    if spec.get("exclusive"):
        held = agent_held_elsewhere(cfg, course, agent_name)
        if held:
            return 1, ("'%s' is already working in %s, and it runs one sitting "
                       "at a time on this machine: %s. Stop that one first: "
                       "tutor agent stop %s"
                       % (agent_name, held, spec["exclusive"], held))
    if spec.get("private") and cards_are_tracked(root):
        return 1, ("'%s' will not open in %s, because a card written there is "
                   "committed and %s. Add `live/*` to that workspace's "
                   ".gitignore, or choose a workspace whose live/ is already "
                   "ignored." % (agent_name, course["dir"], spec["private"]))

    os.makedirs(live_dir, exist_ok=True)
    # SAY THAT A TUTOR IS COMING, BEFORE ANYTHING SLOW HAPPENS.
    #
    # This is the first moment anything knows a start has been decided, and
    # until now it was also the last moment before several seconds of silence:
    # the board is already up and serving the iPad, and the only record on disk
    # was the previous run's -- pid gone, which the board reads as "tutor
    # stopped, nothing is reading the board". Reported from a relaunch: "the
    # tutor was just marked as dead or not available... which put me in 'send
    # again' mode leading to massive confusion."
    #
    # `waking` expires on its own (see `processes.WAKING_GRACE`), so a start
    # that dies here does not leave the board claiming one is on the way.
    mark_waking(live_dir, agent_name)

    # The catch-up moved INTO the daemon. It is a `git pull` against a remote
    # over a tailnet that may itself be coming back up, and it was being done
    # here -- inside the request that asked for a tutor. `spawn.tutor_cli` gives
    # this thirty seconds and `sync` alone allows sixty, so a slow remote did
    # not make the start slow, it made the start get KILLED before it had
    # spawned anything, and the board then sat on a record that never appeared.
    # Nothing downstream needs the pull to have happened before the fork.
    # `--respawn` says this daemon was started by machinery rather than by a
    # person, and the only thing it changes is that the spawned process does NOT
    # record a course choice. Every caller here is a machine deciding to put a
    # tutor back where one already was -- a login hook, a periodic pull, a
    # restart after a ship -- and none of them is somebody saying which lesson
    # the address should open. The entry points that ARE somebody saying so
    # record it themselves before they get here; see the hub tap in `serve.py`.
    cmd = [sys.executable, os.path.realpath(__file__), "headless", course["dir"],
           "--agent", agent_name, "--respawn"]
    if session:
        cmd.append("--" + session)
    out = open(os.path.join(live_dir, "agent.log"), "a", buffering=1)
    kw = {"cwd": root, "stdout": out, "stderr": subprocess.STDOUT,
          "stdin": subprocess.DEVNULL}
    if hasattr(os, "setsid"):
        kw["preexec_fn"] = os.setsid      # survives the terminal that spawned it
    try:
        subprocess.Popen(cmd, **kw)
    except OSError as exc:
        return 1, str(exc)
    return 0, "%s starting in %s" % (agent_name, course["dir"])


def handed_off(cfg, course, agent_name):
    """Spawn the detached waiter that completes a restart the foreground gave up
    on, and say in one clause what was arranged. See `finish_restart`.

    Detached, not a thread: `cmd_restart` is a CLI that exits, and a thread goes
    with it. Output to the course's own `agent.log`, because that is where the
    next person looking at this tutor will already be.
    """
    live_dir = os.path.join(course["root"], "live")
    cmd = [sys.executable, os.path.realpath(__file__), "finish-restart",
           course["dir"]]
    if agent_name:
        cmd += ["--agent", agent_name]
    try:
        out = open(os.path.join(live_dir, "agent.log"), "a", buffering=1)
    except OSError:
        out = subprocess.DEVNULL
    kw = {"cwd": course["root"], "stdout": out, "stderr": subprocess.STDOUT,
          "stdin": subprocess.DEVNULL}
    if hasattr(os, "setsid"):
        kw["preexec_fn"] = os.setsid
    try:
        subprocess.Popen(cmd, **kw)
    except OSError as exc:
        return ("nothing is waiting for it -- %s -- so the watchdog is what "
                "brings it back" % exc)
    return "it comes back on its own the moment that turn ends"


def agent_stop(course, wait=False):
    """Ask the daemon to finish. It writes the handoff on its way out.

    SIGTERM rather than a kill, because the whole point of the wrap-up turn is
    that it happens. It can take a minute; nothing here waits for it unless
    asked, since the caller is usually a person switching course.
    """
    st = agent_live(course["root"])
    if not st:
        return 0, "nothing was listening in %s" % course["dir"]
    # A record written by the launcher before the fork has no pid yet. There is
    # nothing to signal; the daemon it is waiting for will find the record gone.
    if not st.get("pid"):
        try:
            os.remove(os.path.join(course["root"], "live", "agent.json"))
        except OSError:
            pass
        return 0, "the start in %s was called off" % course["dir"]
    try:
        os.kill(st["pid"], signal.SIGTERM)
    except (OSError, TypeError, ValueError) as exc:
        return 1, str(exc)
    if wait:
        for _ in range(120):
            if not agent_live(course["root"]):
                break
            time.sleep(1)
    return 0, "%s in %s is wrapping up" % (st.get("agent"), course["dir"])


def cmd_agent(cfg, args):
    """tutor agent status|start|ensure|stop|which [course]

    The board drives this when a course is opened or left. Each course keeps its
    own assistant: they are cheap while idle, and one that survives being left
    still has the lesson in its head when you come back.
    """
    sub = args[0] if args else "status"
    rest = [a for a in args[1:] if not a.startswith("--")]
    found = courses(cfg)

    if sub == "status":
        for c in found:
            st = agent_live(c["root"])
            print("  %-26s %s" % (c.get("name") or c["dir"],
                                  ("%s (%s, %d turn(s))"
                                   % (st.get("agent"), st.get("state"), st.get("turns", 0)))
                                  if st else "-"))
        return 0

    if not rest:
        print("which course? try: tutor agent %s <name>" % sub, file=sys.stderr)
        return 1
    course = pick(found, rest[0])

    if sub == "stop":
        code, msg = agent_stop(course, wait="--wait" in args)
        print(msg, file=sys.stderr if code else sys.stdout)
        return code

    if sub == "which":
        # WHICH ASSISTANT THIS WORKSPACE RUNS WHEN NOBODY NAMES ONE.
        #
        # `resolve_agent` is the one place the precedence lives, and a dispatch
        # has to know the answer: an assistant it STARTS for a mission is the
        # mission's and is given back when the mission ends, while the
        # workspace's own stays. A second copy of five layers in the server is
        # a second copy that drifts. Nothing but the name on stdout, and an
        # empty line where the configuration resolves to nothing, because the
        # board reads this rather than a person.
        print(resolve_agent(cfg, course, say=lambda m: None) or "")
        return 0

    if sub == "ensure":
        # `start` that says nothing when there was nothing to do. This is what
        # another machine asks over ssh on every login -- see `ensure_agent_away`
        # -- and a line per shell for a tutor that is fine is noise in the one
        # log where a real failure has to be findable. It speaks when it starts
        # something, and when it cannot.
        if agent_live(course["root"]):
            return 0
        name = resolve_agent(cfg, course, _flag(args, "--agent"))
        code, msg = agent_start(cfg, course, name)
        print(msg, file=sys.stderr if code else sys.stdout)
        return code

    if sub == "start":
        # An assistant per course, not one per machine. Switching used to stop
        # whatever was listening elsewhere, so coming back to a course meant a
        # cold agent that had to re-read the contract, the method and the lesson
        # before it could write a word. A listening daemon is blocked on `board
        # wait` and costs nothing while nobody is asking it anything, so there is
        # no reason to make attention exclusive. They still write their handoff
        # when they are actually stopped.
        name = resolve_agent(cfg, course, _flag(args, "--agent"))
        # Somebody named this course -- on the command line, or by tapping it in
        # the hub, which comes through here. That is a decision and it moves the
        # address; `agent_start` does not record one, because its other callers
        # are timers. `--respawn` is the same word used there and means the same
        # thing: a machine asked for this daemon, so it starts one without
        # moving the address. A dispatch into a workspace nobody is looking at
        # passes it, because the person is still looking at the board they
        # tapped on.
        if "--respawn" not in args:
            remember_course(course)
        code, msg = agent_start(cfg, course, name)
        print(msg, file=sys.stderr if code else sys.stdout)
        return code

    print("unknown: tutor agent %s" % sub, file=sys.stderr)
    return 1


def _flag(args, name):
    for n, a in enumerate(args):
        if a == name and n + 1 < len(args):
            return args[n + 1]
    return None


def for_this_turn(cfg, course, running, carried, signal, log=None):
    """Who writes the next card. `(cfg, agent_name, spec, why)`.

    THE ASSISTANT IS RE-RESOLVED EVERY TURN. This re-reads the config and the
    sitting's own `state.json` at the top of each one and asks `resolve_agent`
    again, so a tap on the front door and a sitting rewritten from the iPad both
    land on the next card. Where the answer has not changed -- which is nearly
    always -- nothing happens and nothing is paid.

    What makes that cheap is `session_turns`, which is 1: a hosted turn holds no
    conversation worth protecting and reconstructs the evening off disk whoever
    takes it. The exception is colibrì, whose client pays a 15,900-token preamble
    at a few tokens a second of prefill to open one, and that is the first guard
    below rather than a rule over all of them.

    THREE GUARDS, AND THEY ARE THE WHOLE OF WHAT MUST NOT MOVE:

      - not while `carried > 0`. That is the one case where the agent's own
        session genuinely holds something, and swapping throws it away;
      - not under a `[carry]`, which resumes a colibrì conversation by id --
        `turn_plan`'s carry branch is the same test;
      - never into or out of a `private` recipe. It is the fence flag: the only
        assistant allowed to read `phi`, whose cards must not reach a remote. A
        swap in is a hosted model in a fenced workspace; a swap out is that
        workspace's tutor replaced by one that cannot open its files.
    """
    cfg = load_config()
    fresh = dict(course)
    fresh.update(read_course(course["root"]))
    fresh["root"] = course["root"]
    wanted = resolve_agent(cfg, fresh, say=lambda m: log and log.write("-- %s\n" % m))
    wanted = wanted or running
    # AND WHETHER THE ONE BEING ASKED FOR CAN BE REACHED AT ALL, before a turn
    # is spent finding out. Free for a recipe that talks to the machine's own
    # provider, which is nearly all of them; see `probe_before_turn`.
    probe_before_turn(cfg, wanted, log)
    # Then the allowance, which is the other half and belongs to the agent.
    name, said = choose_agent(cfg, wanted)
    if name == running:
        # AND IT GOES ON SAYING WHY FOR AS LONG AS IT IS TRUE, which is the
        # difference between a climb-down and a silence. `agent_why` is rewritten
        # on every turn precisely so it cannot outlive the swap it describes --
        # so returning None here because nothing MOVED this turn wipes it on the
        # first turn after the daemon came up on the substitute. Measured on the
        # shape that started this: the sitting asks for `deepseek`, the daemon
        # probes it dark and comes up as `claude` with the sentence on the
        # record, and one turn later the record says `claude` and nothing else.
        # The student chose a provider, is being taught by another, and the
        # board has stopped mentioning it.
        #
        # What settles it is WANTED rather than RUNNING: the sitting's own
        # choice against the one taking the turn. They differ for exactly as
        # long as the stand-down or the allowance lasts, and `choose_agent`'s
        # sentence already names the host and the hour.
        return cfg, running, cfg["agents"].get(running) or {}, (
            said if name != wanted else None)
    holding = (cfg["agents"].get(running) or {}).get("private")
    taking = (cfg["agents"].get(name) or {}).get("private")
    if carried > 0:
        why = "this agent's own session is carrying %d turn(s)" % carried
    elif signal == "carry":
        why = "a carry resumes a conversation by id"
    elif holding or taking:
        why = "one of the two is the fenced reader, and that is nobody's automatic choice"
    else:
        if log:
            log.write("-- %s\n" % (said or "the sitting now asks for '%s'" % name))
        return cfg, name, cfg["agents"].get(name) or {}, (said or
                "the sitting now asks for '%s'" % name)
    if log:
        log.write("-- staying on '%s' rather than '%s': %s\n" % (running, name, why))
    return cfg, running, cfg["agents"].get(running) or {}, None


def headless(cfg, course, agent_name, session):
    spec = cfg["agents"].get(agent_name) or {}
    recipe = spec.get("headless")
    if not recipe:
        print("'%s' has no headless recipe in %s.\n"
              "Add one: a command that takes a prompt, does the work, and exits."
              % (agent_name, CONFIG), file=sys.stderr)
        return 1
    gone = missing_command(recipe)
    if gone:
        print("'%s' needs `%s`, which is not on the path on %s.\n"
              "Install it, or name another in %s -- `tutor --agents` lists what "
              "this machine can actually run."
              % (agent_name, gone, this_host(), CONFIG),
              file=sys.stderr)
        return 1
    # AND THE SAME REFUSAL FOR A KEY, because the failure is the same failure.
    # A daemon that starts unkeyed shows on the iPad as an assistant listening
    # and then fails every turn into a log -- which is precisely the shape
    # `missing_command` exists to prevent, one layer along. The file is named
    # because nobody can guess it and putting the line in takes ten seconds.
    need = keys.unkeyed(spec)
    if need:
        print("'%s' needs the key %s, which is not in %s.\n"
              "Put `%s=...` in that file, one NAME=value a line.%s"
              % (agent_name, need, keys.store(), need,
                 ("\n" + keys.why_not()) if keys.why_not() else ""),
              file=sys.stderr)
        return 1

    root = course["root"]
    live = os.path.join(root, "live")
    os.makedirs(live, exist_ok=True)
    # Before the link, the board, the sitting and the catch-up -- all of which
    # take time the person holding the iPad is already watching. With a real pid
    # this time, so a start that dies is noticed by the pid test rather than
    # having to wait out the grace.
    mark_waking(live, agent_name, pid=os.getpid())
    # Moved here from `agent_start`, so the request that asks for a tutor does
    # not wait on a remote. Every session still begins by catching up; it just
    # does it where there is nobody watching the clock.
    sync(root, quiet=True)
    logpath = os.path.join(live, "agent.log")
    log = open(logpath, "a", buffering=1)
    host = this_host()
    # WHICH ASSISTANT IS WRITING IS A PER-TURN QUESTION, and it is asked at the
    # top of each one by `for_this_turn`: the config and the sitting's own
    # `state.json` are re-read, the allowance is checked, and where the answer
    # has moved the recipe is re-bound. `agent_name` and `spec` below are this
    # turn's answer rather than the daemon's, and they change under the loop.

    board(root, "start")
    link(root)
    if session:
        board(root, "open", course.get("name") or course["dir"], "session", "--" + session)
    _, net = board(root, "net")
    urls = "\n".join("  " + l.strip() for l in net.splitlines() if l.strip().startswith("http"))
    with open(os.path.join(live, "BRIEF.md"), "w", encoding="utf-8") as fh:
        fh.write(BRIEF % {"name": course.get("name") or course["dir"],
                          "stance": course.get("stance") or "teach",
                          "session": session or "lecture", "urls": urls,
                          "handoff": handoff_clause(root)})

    # AND WHETHER THE PROVIDER THIS SITTING NAMES ANSWERS FROM HERE AT ALL,
    # ASKED BEFORE THE PERSON SENDS ANYTHING RATHER THAN AFTER. The probe costs
    # 0.17 s -- 0.07 s for the reset from a filtered host, 0.10 s for the 401
    # from one that answers -- and it replaces a first turn that spends about
    # three minutes retrying and writes no card. Cached in `probe_before_turn`
    # for `PROBE_TTL`, and skipped entirely for a recipe with no provider of its
    # own, so an ordinary sitting pays nothing for it.
    #
    # The climb-down is then taken HERE rather than at the top of the first
    # turn, so the board comes up saying who is actually teaching. A student
    # watching a chip that says `deepseek` over a hostname this machine cannot
    # open has been told nothing, and the whole of what the swap is worth is
    # that somebody is told.
    probe_before_turn(cfg, agent_name, log)
    took, why_took = choose_agent(cfg, agent_name)
    if took != agent_name:
        log.write("-- %s\n" % (why_took or "'%s' is taking this sitting" % took))
        agent_name = took
        spec = cfg["agents"].get(took) or {}
        recipe = spec.get("headless") or spec.get("headless_first")
    # `last_error` and `failed_at` are not cleared here either: see
    # `mark_waking`. Coming up is not evidence that the turn that fell over
    # before it went well.
    agent_state(live, host=host, agent=agent_name, pid=os.getpid(),
                started=time.time(), state="listening", turns=0, waking_at=0,
                agent_why=why_took or None,
                **not_this_agents_failure(live, agent_name))
    print(net.rstrip())
    print("\n%s is listening in %s. Send from the board; nothing here needs a keyboard."
          % (agent_name, course["dir"]))
    print("stop with: tutor headless --stop\n")

    running = {"go": True, "waiter": None}

    def bye(*_):
        running["go"] = False
        # Kill the blocking `board wait` too, or shutting down takes as long as
        # its timeout -- five minutes of a course that has already been left.
        #
        # THE WHOLE GROUP, AND SIGKILL. A waiter stuck on the filer cannot act
        # on a polite signal, and a restart that walks away leaving one behind
        # is a daemon nobody can replace: the record says a bounce is in flight,
        # the old process holds the workspace, and the new one never starts.
        w = running["waiter"]
        if w and w.poll() is None:
            drop_waiter(w)
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    def beat_transcript():
        # The transcript is versioned so a lesson survives the host it was taught
        # on. Push it on a beat -- pulling first, so whichever machine is active
        # stays caught up with the other. This is what makes a course read the
        # same on whichever node it is picked up on without anyone remembering
        # to push, and it is what makes an allocation dying mid-lesson cost one
        # beat of work rather than the evening.
        while running["go"]:
            sync_transcript(root, log)
            end = time.time() + 90
            while running["go"] and time.time() < end:
                time.sleep(1)
    threading.Thread(target=beat_transcript, daemon=True).start()

    turns = 0
    # Which chapter this daemon has actually been teaching, refreshed each turn.
    # Not read at the end: by then the board may have opened the next one, and
    # the handoff would be stamped with a chapter it says nothing about.
    taught_chapter = [chapter_now(root)]
    carried = 0          # turns the agent's current session is carrying
    # An inbox whose turn failed for a reason that has since been repaired. The
    # student sent something and got nothing back; `board wait` will not hand it
    # over twice, so it is carried here rather than waiting for them to give up
    # and send again.
    # AN OWED MESSAGE LIVES ON DISK, NOT IN THIS PROCESS. `pending` is the
    # daemon's promise to re-answer a student message whose turn fell over, and
    # `board wait` has already rewritten `live/inbox/messages.jsonl` with
    # `read: true` before the turn ran -- so the inbox will not hand it over
    # again and this variable is the only copy. Measured on 23 September: a turn
    # failed at 17:43:05, the message was re-queued here, the daemon was
    # signalled three seconds later, and the student's work went with the
    # process. `live/cards/` stayed empty, the next daemon's `board wait` found
    # nothing unread, and nothing was answered until the person sent it again
    # two and a half hours later.
    #
    # So every assignment goes through `owe`, which writes it into `agent.json`
    # as well, and the loop starts by draining whatever the daemon before it
    # left owed. That covers a signal, a walltime handover, a `tutor restart`
    # and a lost node, which are four ways to lose the same thing.
    def owe(msg):
        agent_state(live, owed=msg or None)
        return msg

    pending = owed_message(live)
    if pending:
        log.write("-- the daemon before this one owed an answer to a message; "
                  "it is the first turn\n")
    # THE SAME FAILURE TWICE IS A BROKEN RECIPE, NOT A BAD MINUTE. `(agent,
    # reason, count)` for whatever the last turn failed of, so a provider that
    # answers every turn with the same fault -- a model that has been renamed, a
    # key the provider now rejects -- is stood down and the lesson climbs down to
    # something that can teach it. Two, because one is a blip and the second
    # identical one is a pattern; and the reason has to MATCH, so two unrelated
    # faults do not add up to a verdict. In the process rather than on disk: it
    # is about this run of turns, and the stand-down it buys is what persists.
    striking = [None, None, 0]
    recycle = int(cfg.get("session_turns", 12) or 0)
    while running["go"]:
        if pending is not None:
            out, pending = pending, None
            log.write("-- answering the message whose turn failed before\n")
        else:
            # `--force`, because `board wait` now refuses a caller that is
            # inside a headless turn -- and this is the one caller that is not.
            # The guard reads `agent.json`, which still says `working` from the
            # turn that just finished at the moment this starts, so the daemon
            # cannot be told apart from its own turn by state alone.
            running["waiter"] = subprocess.Popen(
                [sys.executable, BOARD, "wait",
                 "--timeout", str(WAIT_TIMEOUT), "--force"],
                cwd=root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                start_new_session=True)
            try:
                raw = running["waiter"].communicate(timeout=WAIT_CEILING)[0]
                code = running["waiter"].returncode
            except subprocess.TimeoutExpired:
                # It is past its own deadline and did not enforce it, so it is
                # wedged rather than slow. See `drop_waiter`.
                drop_waiter(running["waiter"], log)
                raw, code = b"", 2
            out = raw.decode("utf-8", "replace")
            running["waiter"] = None
            if not running["go"]:
                break
            if code != 0:
                agent_state(live, state="listening")     # timed out; still alive
                continue

        # A MESSAGE IS OWED FROM THE MOMENT IT IS TAKEN, NOT FROM THE MOMENT A
        # TURN FAILS. `board wait` has already rewritten `live/inbox/messages.jsonl`
        # with `read: true`, so from here until something answers it, this record
        # is the only copy of it anywhere -- and a turn is minutes long. The
        # failure paths below all re-owe it, which covered a turn that came back;
        # it did not cover a daemon signalled, a node lost or a walltime handover
        # WHILE the turn was running, and those land in the same three minutes.
        # Written here rather than flushed from `bye`, because a signal handler
        # that has to reach the filer to save a student's work is a promise made
        # at the worst possible moment.
        owe(out)
        turns += 1
        this_signal = turn_signal(out)
        # `turn_started` is the daemon's clock, and the board needs it: its own
        # measure of how long a turn has been going starts when it first SEES
        # the working state, which on a reload or a second device is nowhere
        # near when the turn began.
        # AND THE LAST FAILURE STAYS ON THE RECORD WHILE THIS ONE RUNS. Clearing
        # it here would retire a failure on the strength of a turn STARTING,
        # which settles nothing: a daemon killed or a node lost mid-turn would
        # leave `working`, no error and no card -- the empty record, one state
        # along. A turn that GOES THROUGH clears it, below. What stops the board
        # painting an old failure over a running turn is
        # `lesson.state._failure`, which does not report one older than the turn
        # in flight.
        agent_state(live, state="working", turns=turns,
                    turn_started=time.time(), turn_signal=this_signal)
        log.write("\n=== %s turn %d ===\n%s\n" % (time.strftime("%H:%M:%S"), turns, out))

        # Keep saying so while the turn runs. The heartbeat used to be written
        # only at these boundaries, so a turn that took longer than the board's
        # two-minute window -- which a turn that reads a chapter and writes a
        # card routinely does -- showed on the iPad as "assistant not
        # responding" while the assistant was in the middle of teaching.
        beating = threading.Event()

        def beat():
            while not beating.wait(30.0):
                agent_state(live, state="working", turns=turns)

        ticker = threading.Thread(target=beat, daemon=True)
        ticker.start()

        # The first turn of a session has no conversation to continue, and a
        # resume flag against nothing is an immediate failure. After that the
        # agent's own session is worth keeping: without it every turn pays for
        # re-reading the contract, the method and the lesson before it can write
        # a word, which is most of what a turn costs.
        # A fresh session when there is nothing to resume, and again once the
        # one we have has carried enough turns to be more expensive than
        # starting over. Everything a fresh session needs is on disk: the
        # contract, the method, and `board recap` for the lesson.
        # WHO WRITES THIS ONE. Asked now rather than when the daemon started,
        # so a tap on the front door lands on the next card rather than the next
        # sitting, and so an allowance that ran out is climbed down from and
        # later climbed back to. See `for_this_turn`.
        cfg, next_agent, next_spec, moved = for_this_turn(
            cfg, course, agent_name, carried, this_signal, log)
        # The config was re-read, so everything taken off it is too.
        recycle = int(cfg.get("session_turns", 12) or 0)
        if moved:
            agent_name, spec = next_agent, next_spec
            recipe = spec.get("headless")
        # WHO IS WRITING, AND WHY IF IT CHANGED, BEFORE THE TURN RATHER THAN
        # AFTER IT. The strip paints both off this record, and `agent_why` is
        # written on EVERY turn rather than only on a swap: written once it
        # would outlive the swap it describes, and the board would go on
        # explaining a climb-down that had long since climbed home.
        # AND THE LAST FAILURE GOES WITH THE AGENT IT BELONGS TO. The board says
        # "<agent>'s last turn failed -- <reason>" out of these two fields
        # together, so a climb-down that left the old provider's reason behind
        # would blame the new one for it. See `not_this_agents_failure`.
        agent_state(live, agent=agent_name, agent_why=moved or None,
                    **not_this_agents_failure(live, agent_name))
        first = spec.get("headless_first") or recipe
        use, template, fresh = turn_plan(spec, carried, recycle, this_signal)
        if fresh and carried:
            log.write("-- starting a fresh session after %d turn(s); the lesson "
                      "is read back with `board recap`\n" % carried)
        # A script agent builds its own context, so it gets the raw inbox rather
        # than the instruction prompt the interactive agents expect -- its whole
        # state is on disk and it re-reads what it needs.
        taught_chapter[0] = chapter_now(root) or taught_chapter[0]
        fill = {"inbox": out.strip(),
                # Only the chapter that is open. A handoff about another one is
                # parked as this is read, so a tutor is never handed the last
                # chapter's unfinished business as though it were this one's.
                "handoff": (HANDOFF_CLAUSE
                            if handoff.handoff_applies(root, chapter_now(root))
                            else NO_HANDOFF_CLAUSE)}
        prompt = out.strip() if spec.get("raw_prompt") else template % fill
        cmd = with_usage(spec, [a.replace("{prompt}", prompt) for a in use])
        # Where this turn's own words begin, so that if it fails we can read
        # back what it said rather than guess at why.
        mark = os.path.getsize(logpath) if os.path.exists(logpath) else 0
        # WHICH MISSION THIS TURN IS, WRITTEN DOWN BEFORE THE CLIENT STARTS.
        # After `working` and not before it, so no reader ever sees a turn in
        # flight against a record that still says `listening`. See
        # `missions.turn_open`: `agent.json` cannot carry this across a board
        # hop, because the board coming up adopts the daemon and overwrites it.
        #
        # AND A FRESH TURN GETS A FRESH CONVERSATION ID. The client refuses
        # `--session-id` for an id that already has a conversation -- "Session
        # ID <uuid> is already in use", exit 1 -- and `session_turns` is 1, so
        # every mission turn that is not a `[carry]` is fresh and would hand
        # back the id the turn before it opened. `renew` is `fresh` for that
        # reason: a resume keeps the id, a new session gets a new one.
        mrec, turn_env = mission_turn(root, log, renew=fresh)
        turn_env = turn_environment(spec, turn_env)
        started_at = time.time()
        timed_out = False
        cap = turn_timeout(cfg, root, spec, this_signal)
        try:
            rc, timed_out = run_turn(cmd, root, log, cap, env=turn_env)
            err = None if rc == 0 else ("timed out" if timed_out
                                        else "exit %d" % rc)
            # A resume that finds nothing to resume is not a broken turn; it is a
            # first turn wearing the wrong recipe. Try it once as one.
            # Not where the node went, where there was nothing to step into, or
            # where the cap cut it: all three keep the session, and retrying
            # them fresh pays a whole preamble and eats the signal that says
            # what happened.
            keeps = timed_out or reads_as_carry(err) or reads_as_wait(err)
            if err and use is not first and not keeps:
                # A fresh session holds nothing, so the resume prompt -- which
                # says "you already have the contract, the method and the lesson"
                # -- would produce a card written against no contract at all.
                # Retry as what it actually is: a first turn.
                log.write("!! resume failed, retrying as a fresh turn\n")
                # And under a NEW conversation id. The old one may exist but be
                # unresumable, and `--session-id` on an id that is live is a
                # collision rather than a fresh session.
                mrec, turn_env = mission_turn(root, log, renew=True)
                turn_env = turn_environment(spec, turn_env)
                cmd = with_usage(spec, [a.replace("{prompt}", HEADLESS_FIRST_PROMPT % fill)
                                        for a in first])
                rc, timed_out = run_turn(cmd, root, log, cap, env=turn_env)
                err = None if rc == 0 else ("timed out" if timed_out
                                            else "exit %d" % rc)
                fresh = True
        except OSError as exc:
            err = str(exc)
        finally:
            beating.set()

        # WHAT THE TURN SAID, READ BEFORE THE EXIT CODE IS BELIEVED. An exit
        # code is the agent summarising itself, and an agent that writes
        # `is_error` into its own result object and then exits 0 has failed the
        # turn whatever the number says: no card is written, and a board that
        # took the number would go back to `listening` with nothing to show and
        # nothing to say -- the one state this tool must never present as
        # normal. The words win. See `result_object_error`.
        said = turn_output(logpath, mark)
        if not err and result_object_error(said):
            err = "the agent reported a failure and exited 0"

        # AND THE PAGE THAT NEVER ARRIVED, WHICH EXITS 0 AND READS AS A LESSON.
        # `board see` refuses an answer carrying one of these -- `blind_answer`
        # in `tutorboard/seeing.py` -- but a tutor whose model can see is told by
        # the turn prompt to open the PNG itself, so the slate goes through the
        # binary's own Read tool and never passes that guard. An endpoint that
        # cannot take the image block substitutes the placeholder INTO THE
        # CONVERSATION and answers 200, so the model marks handwriting it was
        # never shown, confidently, and the exit code agrees with it. That is
        # the one failure on this board a person cannot catch by reading the
        # card, because the card is fluent.
        #
        # The list is imported rather than repeated: a second copy of a
        # provider's placeholder wording is a table that goes stale in the file
        # nobody is looking at. Asked of the whole turn, not of a card, because
        # the substitution happens wherever the image was handed over.
        if not err:
            blind = seeing.blind_answer(said)
            if blind:
                err = ("the page never reached the model -- it answered around "
                       "%s, so anything it said about the handwriting is "
                       "invented" % blind)

        # WHAT IT COST, WHETHER OR NOT IT WORKED. A turn that died on its last
        # round trip is billed for the ones before it, and a failure that is
        # missing from `cost.jsonl` is a provider whose bad evening is invisible
        # in the one place the money is counted. Nothing is written where the
        # turn said nothing: `read_turn_usage` returns {} and `record_cost`
        # stops there.
        record_cost(live, log, turns, agent_name, fresh,
                    read_turn_usage(logpath, mark, spec.get("usage"), spec))

        if err:
            log.write("!! %s\n" % err)
            if reads_as_wait(err) and not carry_spent(root, mrec):
                # NOTHING TO STEP INTO YET, WHICH IS NOT A FAILURE AND NOT A
                # HOP. A chain gap is ordinary: the successor is a 68-minute
                # cold pin and pends behind a full node. So no error is
                # stamped, no hop is counted and no stall is counted -- and the
                # backoff is not optional, because asking `squeue` in a tight
                # loop for an hour is the other way to break this.
                #
                # AND THE FALLBACK IS TOLD TO LEAVE IT ALONE, BEFORE AND AFTER
                # THE WAIT. From the record a daemon between attempts looks
                # exactly like a mission nobody is driving -- `turn_at` set,
                # `listening` on a node that is fine -- so the hub would claim
                # a hop every backoff and spend `CARRY_HOPS` inside half an
                # hour of an ordinary chain gap. See `missions.defer_carry`.
                #
                # AND THE WAITING ENDS WHERE THE RECORD'S BUDGET DOES. A chain
                # that never comes back is not a thing this repairs, and a
                # daemon asking about it every five minutes for ever, against
                # a mission the board has already failed, is the shape that
                # never stops. See `carry_spent`.
                log.write("-- there is no generation to step into yet; asking "
                          "again in %d s\n" % int(missions.CARRY_BACKOFF))
                if mrec:
                    missions.defer_carry(root, mrec)
                agent_state(live, state="listening", last_error=None,
                            failed_at=0, retrying=True)
                end = time.time() + missions.CARRY_BACKOFF
                while running["go"] and time.time() < end:
                    time.sleep(1)
                if not running["go"]:
                    break
                if mrec:
                    # Again on the way out: the hold expires as the sleep does,
                    # and the next turn needs the second or two it takes to
                    # write `working` and re-open the turn.
                    missions.defer_carry(root, mrec)
                pending = owe(carry_line(out))
                continue
            if reads_as_carry(err) or timed_out:
                # THE GENERATION ENDED, THE TASK DID NOT FAIL. The client is a
                # step of the colibri allocation and dies with it; this daemon is
                # in the BOARD's allocation and is still here. Re-queue the same
                # work with the resume recipe -- the successor has already
                # printed COLIBRI-SERVE LOADED, so the next attempt starts
                # seconds from now.
                #
                # A turn cut at its cap is the same move. It burns a hop, which
                # is what bounds a wedged client, and `run_turn` has already
                # killed the process group so there is no orphan left answering.
                mine, pending = take_hop(
                    root, log, out, this_signal, time.time() - started_at,
                    "the turn hit its %d h cap" % (cap // 3600) if timed_out
                    else "the generation that turn ran in ended", rec=mrec)
                owe(pending)
                if mine:
                    # NO FAILURE IS STAMPED. `missions.judge`'s failure rule
                    # fires off `last_error` within one hub poll, and a mission
                    # frozen `failed` is never re-derived.
                    agent_state(live, state="listening", last_error=None,
                                failed_at=0, retrying=pending is not None)
                    continue
            # A failed turn has three very different causes wearing one symptom,
            # and they need telling apart. The model refusing, or the agent
            # falling over, is nothing this can fix. The machine being unable to
            # reach the provider at all is. And the allowance having run out is
            # neither: nothing is broken, and the same turn will succeed later
            # with not one thing changed.
            #
            # The allowance is asked about first because it is the one the turn
            # itself answers -- the agent said so in its output, and a provider
            # that could say so is a provider we plainly reached, which settles
            # the egress question at the same time and for free.
            until = limits.reads_as_usage_limit(said)
            if until:
                # THIS AGENT, NOT THIS MACHINE. Claude running out says nothing
                # about DeepSeek, and a machine-wide mark would take the
                # fallback out along with the thing it is falling back from.
                limits.mark_limited(until, agent=agent_name)
                log.write("!! '%s' is out of allowance here until %s\n"
                          % (agent_name,
                             time.strftime("%H:%M", time.localtime(until))))
                # `retrying`, BECAUSE THE DAEMON IS. The strip reads exactly
                # this field: without it the board says "send again to carry
                # on", and a student who obeys queues a second copy of their
                # work behind a turn this loop was about to take itself. The
                # message is re-queued four lines down; that is what retrying
                # means.
                agent_state(live, state="listening", last_error="out of allowance",
                            failed_at=time.time(), failed_agent=agent_name,
                            limited=until, retrying=True)
                # The student sent something and got nothing. Whoever ends up
                # answering it, it is the same message.
                pending = owe(out)

                # Push the lesson before standing aside, rather than waiting
                # for the next beat. Whoever picks this up reads it out of the
                # repository, and that includes the message we have just failed
                # to answer -- so the beat that would have carried it is exactly
                # the beat we have no time for.
                sync_transcript(root, log)

                # AND THEN THE NEXT TURN CLIMBS DOWN. `for_this_turn` runs at
                # the top of the loop and `choose_agent` will not offer this one
                # again until its expiry passes, so the message we just failed
                # to answer is handed to the next provider that is installed,
                # keyed and unlimited -- and the lesson loses nothing, because a
                # turn is cold and reads the evening back off disk.
                #
                # Where there is no such provider, `choose_agent` hands the turn
                # back to this one and it fails where it is visible, which is
                # exactly what this did before there was a second: the failure is
                # on the card stream with its reason, `/health` publishes the
                # limit, and `board limit` says until when.
                nxt, _ = choose_agent(load_config(), agent_name)
                if nxt != agent_name:
                    log.write("-- the next turn goes to '%s'\n" % nxt)
                else:
                    log.write("!! nothing else here can take it; turns will "
                              "fail until the allowance returns -- `board "
                              "limit` says when\n")
                continue

            # Not a limit. Ask the network, rather than guess -- and ask about
            # THIS PROVIDER before asking about the machine, because the two
            # have different answers and only the narrow one is ever true here.
            # A filter that drops one hostname leaves the rest of the internet
            # reachable, so the machine-wide probe reports a healthy network
            # over a recipe whose every turn dies in the TLS handshake, and the
            # board says `exit 1` about a fault no tutor can fix.
            #
            # Only when a turn has actually failed. Probing on every turn would
            # add a round trip to the internet to every card the student waits
            # for, to answer a question that is almost always yes.
            own = agent_probe_urls(spec)
            if own and not egress.egress_ok(urls=own) and egress.egress_ok():
                host = probe_host(own)
                until = time.time() + egress.UNREACHABLE_WINDOW
                egress.mark_unreachable(agent_name, host, until)
                log.write("!! '%s' cannot reach %s from here, and everything "
                          "else on the network answers; standing it down until "
                          "%s\n" % (agent_name, host,
                                    time.strftime("%H:%M", time.localtime(until))))
                # `retrying` for the same reason as the allowance above: the
                # message is put back below and the next turn answers it.
                agent_state(live, state="listening",
                            last_error="cannot reach %s" % host,
                            failed_at=time.time(), failed_agent=agent_name,
                            retrying=True)
                # The student sent something and got nothing, and the next turn
                # climbs down exactly as it does for an allowance: `choose_agent`
                # will not offer this recipe again until the expiry passes, and
                # a cold turn reads the evening back off disk whoever takes it.
                pending = owe(out)
                sync_transcript(root, log)
                nxt, _ = choose_agent(load_config(), agent_name)
                if nxt != agent_name:
                    log.write("-- the next turn goes to '%s'\n" % nxt)
                else:
                    log.write("!! nothing else here can take it; every turn "
                              "will fail until %s answers from this machine\n"
                              % host)
                if mrec:
                    missions.turn_over(root, mrec, time.time() - started_at)
                continue
            # AND WHETHER IT WAS THE MACHINE, kept, because the sentence below
            # recomputes the reason from the turn's own words and would write
            # `exit 1` over the top of it. `failWord` in `board.js` has a case
            # for this one -- "this machine cannot reach the internet" -- and it
            # never once fired, because by the time the board read the record
            # the reason had been replaced by the exit code.
            dark_machine = False
            if not egress.egress_ok():
                dark_machine = True
                log.write("!! nothing can get out from here; the turn may not be "
                          "the tutor's fault\n")
                agent_state(live, state="listening", last_error="no egress",
                            failed_at=time.time(), failed_agent=agent_name)
                fixed, detail = egress.rotate_exit_node(
                    log=lambda m: log.write("   %s\n" % m))
                if fixed:
                    log.write("-- egress repaired via %s; retrying the turn\n" % detail)
                    # The student sent something and got nothing. Put the same
                    # inbox back so the next pass answers it rather than waiting
                    # for them to send again.
                    pending = owe(out)
                else:
                    log.write("!! egress still broken (%s); turns will keep "
                              "failing until the network is fixed\n" % detail)
            # Stamped, so the board can tell a failure that just happened from
            # one an hour ago -- and can say so at all, which it could not. A
            # student whose working was handed in and answered by nothing is the
            # one state this tool must never present as normal.
            # In words, not as an exit code. See `failure_reason`.
            # And the turn is over on this path in the one sense that matters:
            # nothing is owed. A pick-up repairs a node that went away, not a
            # model that refused.
            if mrec:
                missions.turn_over(root, mrec, time.time() - started_at)
            why = "no egress" if dark_machine else failure_reason(said, err)
            # LOUD IS NOT THE SAME AS RECOVERABLE, and this is where the
            # difference is paid. The two causes above both climb down: an
            # exhausted allowance and a dark host each stand the recipe aside
            # and hand the message to whoever can take it. Everything else --
            # the provider renaming the model the recipe pins, the key being
            # rejected, the endpoint answering 404 to every request -- reaches
            # the board in the provider's own words and then happens again on
            # the next message, and the next, for ever, a wasted turn each time.
            # So a recipe that fails the same way twice is stood down on the
            # same terms, and `choose_agent` gives the lesson to something that
            # can write a card. `board agents` says until when.
            if striking[0] == agent_name and striking[1] == why:
                striking[2] += 1
            else:
                striking = [agent_name, why, 1]
            if striking[2] >= 2 and not egress.stood_down(agent_name):
                egress.mark_failing(agent_name, why)
                until = (egress.stood_down(agent_name) or {}).get("until", 0)
                log.write("!! '%s' has failed the same way twice (%s); standing "
                          "it down until %s\n"
                          % (agent_name, why,
                             time.strftime("%H:%M", time.localtime(until))))
                pending = owe(out)
                sync_transcript(root, log)
                nxt, _ = choose_agent(load_config(), agent_name)
                if nxt != agent_name:
                    log.write("-- the next turn goes to '%s'\n" % nxt)
                else:
                    log.write("!! nothing else here can take it; turns will "
                              "fail until this recipe is repaired\n")
            agent_state(live, state="listening", last_error=why,
                        failed_at=time.time(), failed_agent=agent_name,
                        retrying=pending is not None)
        else:
            if mrec:
                missions.turn_over(root, mrec, time.time() - started_at)
            carried = carry_after(this_signal, fresh, carried)
            # A turn that went through on this agent is proof of THIS agent's
            # allowance, whatever the record still says. The reset time a
            # provider hands out is a promise; this is a measurement. Per agent,
            # because clearing the lot would un-limit a provider nothing has
            # heard from since it ran out.
            if limits.limited_until(agent_name):
                log.write("-- a turn went through on '%s'; its allowance is "
                          "back\n" % agent_name)
                limits.clear_limited(agent_name)
            # And the same argument for a provider that was dark: the expiry is
            # a guess about when a filter might lift, a card written through it
            # is a measurement, and the measurement wins.
            if egress.stood_down(agent_name):
                log.write("-- a turn went through on '%s'; it is not stood "
                          "down any more\n" % agent_name)
                egress.clear_unreachable(agent_name)
            striking = [None, None, 0]
            agent_state(live, state="listening", last_error=None,
                        failed_at=0, failed_agent=None, retrying=False)

        # AND THE DEBT IS SETTLED HERE, ONCE, BY WHAT THE TURN LEFT BEHIND.
        # `pending` is this loop's own answer to "is the same message still
        # owed": None where the turn went through, and None where it failed for
        # something no retry repairs -- the model refused, the recipe is wrong --
        # which is the case the board tells the student to send again for. The
        # branches that DO re-queue it set `pending` and then `continue` past
        # this, so nothing here can un-owe a message the daemon has promised to
        # answer. Every path out of a turn therefore leaves the record saying the
        # truth about it, rather than every path having to remember to.
        owe(pending)

    # The last turn, and the only one the student never sees.
    #
    # WHO WRITES IT IS RE-ASKED HERE, AND IT IS NOT AUTOMATICALLY WHOEVER JUST
    # FAILED. `agent_name`, `spec` and `recipe` are the LOOP's, rebound only by
    # `for_this_turn` at the top of a turn -- and a session whose last turn
    # stood its own provider down never takes another turn, so the loop falls
    # out of the bottom with the dead recipe still bound. Measured on 23
    # September: the log said `-- the next turn goes to 'claude'` at 17:43:05,
    # and the wrap-up three seconds later printed DeepSeek's own
    # unrecognised-model line, ran on DeepSeek's `ANTHROPIC_BASE_URL`, died
    # `ECONNRESET` after 179 seconds, was billed to DeepSeek, and wrote nothing.
    # The one turn that must not be skipped was spent on the one recipe that
    # could not take it.
    #
    # AND IT IS SKIPPED RATHER THAN SPENT WHEN NOTHING HERE CAN WRITE ONE.
    # Three minutes of known-dead retries is worse than no handoff, because the
    # `finish_restart` window is burned along with them and the next daemon is
    # kept waiting behind a turn that was never going to answer.
    stuck = None
    if turns:
        cfg = load_config()
        took, why_took = choose_agent(cfg, agent_name)
        if took != agent_name:
            log.write("-- the handoff goes to '%s': %s\n"
                      % (took, why_took or "it is what can write one here"))
            agent_name = took
            spec = cfg["agents"].get(took) or {}
            recipe = spec.get("headless") or spec.get("headless_first")
        stuck = agent_unavailable(cfg, agent_name)
        if stuck:
            log.write("\n=== %s handoff ===\n!! no handoff was attempted: %s, "
                      "and nothing else on this machine can write one. "
                      "HANDOFF.md is whatever the last session left; the "
                      "transcript is what the next one reads.\n"
                      % (time.strftime("%H:%M:%S"), stuck))
    if turns and not stuck:
        agent_state(live, state="wrapping up")
        log.write("\n=== %s handoff ===\n" % time.strftime("%H:%M:%S"))
        # The handoff is the one turn that must not be skipped -- it is the only
        # continuity the next session has -- and a tutor stopped because its
        # allowance ran out cannot write it. It is attempted anyway and the
        # failure is logged like any other: a session that ends with no handoff
        # is a session the next one has to reconstruct from the cards, which is
        # worse than the transcript but is not nothing.
        # A script agent may have its own way to write the handoff; default to the
        # ordinary turn recipe otherwise.
        wrap = spec.get("handoff") or recipe
        cmd = with_usage(spec, [a.replace("{prompt}", HANDOFF_PROMPT) for a in wrap])
        mark = os.path.getsize(logpath) if os.path.exists(logpath) else 0
        landing = os.path.join(root, "HANDOFF.md")
        try:
            before = os.path.getmtime(landing)
        except OSError:
            before = 0
        try:
            done = subprocess.run(cmd, cwd=root, stdout=log,
                                  stderr=subprocess.STDOUT,
                                  env=turn_environment(spec),
                                  timeout=cfg.get("handoff_timeout", 600))
            # The wrap-up is a turn and it is billed like one, so it is counted
            # like one. It used to be the most expensive turn of the session --
            # it re-read the cards, the contract and the old handoff before
            # writing a word -- and nothing would have shown that.
            record_cost(live, log, turns + 1, agent_name, False,
                        read_turn_usage(logpath, mark, spec.get("usage"), spec))
            # WHETHER THIS TURN WROTE ONE, WHICH IS NOT THE SAME QUESTION AS
            # WHETHER THE FILE IS THERE. A handoff from a previous session is
            # always there, so existence proved nothing: a wrap-up that died on
            # the wire was logged as `handoff written` and then had LAST week's
            # file re-stamped with the chapter this session taught -- a stale
            # note claiming to be this evening's, which is the one lie the
            # handoff must not tell, since it is all the next session gets.
            # Three facts and all three have to hold: the turn exited 0, it did
            # not report its own failure, and the file is newer than the turn.
            said = turn_output(logpath, mark)
            failed = (done.returncode != 0 and ("exit %d" % done.returncode)) \
                or (result_object_error(said) and
                    "the agent reported a failure and exited 0")
            try:
                wrote = not failed and os.path.getmtime(landing) > before
            except OSError:
                wrote = False
            # Say which chapter it is about, now, while this is the only process
            # that knows. The wrap-up is a model call and takes as long as it
            # takes; by the time anybody reads the file the board may already
            # have opened the next chapter, and an unstamped handoff would then
            # be read as though it belonged to it.
            if wrote:
                handoff.stamp_handoff(root, taught_chapter[0])
                log.write("handoff written\n")
            elif failed:
                log.write("!! the handoff turn failed (%s); HANDOFF.md is "
                          "whatever the last session left, and is left saying "
                          "so\n" % failure_reason(said, failed))
            else:
                log.write("!! no HANDOFF.md was written\n")
        except (subprocess.TimeoutExpired, OSError) as exc:
            log.write("!! handoff failed: %s\n" % exc)

    # Keep the record and say what happened to it. Deleting it makes the board
    # say "no tutor attached", which is the same thing it says when a course
    # never had one -- and the two want different things from the person reading
    # it. `state: stopped` reads on the board as "tutor stopped, nothing is
    # reading the board", which is the truth and is actionable.
    #
    # AND IT DOES NOT SAY WHY, BECAUSE IT DOES NOT KNOW WHY.
    #
    # This wrote `restarting: False`, and `restarting` is the one field that
    # says whether somebody asked for this daemon back. It is written by the
    # ASKER -- `tutor restart --tutors`, before it signals -- precisely so that
    # a bounce can be told from a death, and the daemon receiving the signal
    # cannot tell the two apart. Erasing it on the way out turned every abandoned
    # bounce into a record identical to a person's `tutor agent stop`, which
    # `supervise.tutor_verdict` reads as "a person said no" and never revives.
    #
    # Measured, in Galois Theory: a ship's restart wrote the flag and signalled;
    # the handoff turn took 97 seconds and the restart gives it 90, so it printed
    # "still writing its handoff; run this again in a minute" and returned
    # WITHOUT starting anything. The daemon then exited through this line, wiped
    # the flag, and three generations of the serving chain revived that course's
    # BOARD and refused its TUTOR -- fifteen hours of a board that served
    # perfectly with nothing reading it, and a `turn_signal` still naming an
    # answer that had been handed in. From the iPad: the app works and the tutor
    # is down.
    #
    # Nothing clears the flag here because nothing here has earned the right to.
    # `mark_waking` clears it, and it is written by both halves of a start, so
    # the flag lives exactly as long as the restart it describes is unfinished --
    # and a restart nobody finished is one the watchdog now finishes, after
    # `REATTACH_GRACE`.
    #
    # AND IT IS WRITTEN ONLY WHERE THIS PROCESS IS STILL THE ONE ON THE RECORD.
    # See `record_is_ours`: a bounce that has already brought the successor up
    # leaves two daemons alive for a moment, and this line landing on the new
    # one's record retires a tutor that is listening. Nothing is written at all
    # in that case -- the successor's own `listening` is the truth, and the only
    # thing this process has left to say about the file is nothing.
    if record_is_ours(live):
        agent_state(live, state="stopped", stopped_at=time.time())
    else:
        log.write("-- another daemon already holds this record; its state is "
                  "left alone\n")
    print("stopped after %d turn(s)" % turns)
    return 0


# HOW LONG A RESTART WAITS FOR A BOUNCED DAEMON TO RECORD ITS OWN PID.
#
# `agent_start` writes `waking` with no pid and then forks; the pid arrives once
# the daemon has brought the link, the board and the sitting up, which is
# seconds. Bounded, because a restart is run by somebody watching a terminal and
# a command that waits for ever is a command nobody runs after a ship.
RESTART_WAIT = 20


# How long a detached waiter will sit on a wrap-up turn before giving up on it.
# The turn is a model call writing HANDOFF.md, and `agent_stop` allows it to take
# minutes; twenty is far past anything measured and is a bound rather than an
# expectation. What it must not be is ninety seconds, which is the number the
# foreground gives up at -- see `finish_restart`.
FINISH_WAIT = 1200


def finish_restart(cfg, args):
    """Wait out a wrap-up turn this machine already signalled, then start the
    replacement. Spawned detached by `cmd_restart`; nobody types this.

    A RESTART MUST NOT WALK AWAY FROM A RESTART IT STARTED. The foreground waits
    ninety seconds for the daemon's record to clear, and a handoff turn is a
    model call that routinely outruns that -- 97 seconds, measured. The branch
    that gave up wrote nothing further and returned, leaving `restarting: True`
    on the record with NOTHING pending: the board reads that flag and says
    "claude is restarting", truthfully, for as long as it takes somebody else to
    notice.

    Somebody else was `tutor watch`, at `REATTACH_GRACE` — 180 seconds. That is
    the right backstop and it is not a plan. It only exists where a watch loop is
    running, so a hand `tutor restart --tutors` in an `salloc`, or a ship on a
    machine the serving chain is not under, left the tutor down with the flag on
    and no clock anywhere. And where it does exist, the person holding the iPad
    still watches a lesson say "restarting" for three minutes. Reported in those
    words: "Suddenly it says 'claude is restarting' - and I don't foresee that
    finishing... what the hell happened?"

    So the operation finishes itself, as soon as the turn it is waiting for
    actually ends rather than at a fixed grace. The watchdog stays exactly as it
    is: two things that may both start a tutor is not a race, because
    `agent_start` answers "already listening" and changes nothing.
    """
    plain = [a for a in args if not a.startswith("-")]
    found = courses(cfg)
    course = pick(found, plain[0]) if plain else None
    if not course:
        return 1
    # The record is the least reliable of the three by the time this runs -- the
    # whole job is to wait for it to disappear -- so configuration is the
    # fallback, which is the same answer `cmd_restart` resolves and the one that
    # should be running here anyway.
    name = (_flag(args, "--agent")
            or (agent_live(course["root"]) or {}).get("agent")
            or resolve_agent(cfg, course))
    for _ in range(FINISH_WAIT):
        if not agent_live(course["root"]):
            code, msg = agent_start(cfg, course, name)
            return 0 if code == 0 else 1
        time.sleep(1.0)
    # Still wrapping up after twenty minutes. Leave the flag: it is true, and
    # the watchdog is the right owner of a case this far outside the measured
    # range. Saying so where a person will find it is the whole of what is left.
    print("finish-restart: %s was still wrapping up after %d s; leaving the "
          "restart flag for the watchdog" % (course["dir"], FINISH_WAIT))
    return 1


def cmd_restart(cfg, args):
    """Restart every long-lived process on this machine, on the current code.

    A board is a long-lived process that read `serve.py` when it started, so a
    change to this tool reaches a course only when its board comes back. That is
    invisible from the outside: the pages are served from disk and look new while
    the endpoints behind them are still the old ones, which is exactly the sort of
    difference somebody spends an evening not finding.

    Only boards that are actually answering on this node are touched -- a record
    on a shared filesystem may belong to another machine, and stopping a stranger's
    process is worse than leaving a stale one. `--tutors` adds the daemons.
    """
    host = this_host()
    # WHO HOLDS THE ADDRESS, BEFORE ANYTHING IS STOPPED.
    #
    # There is one HTTPS name and it points at one board. A start claims it only
    # when it is pointing at nothing -- but this loop stops each board in turn,
    # so while one is down the name it holds IS pointing at nothing, and the
    # next course to come up takes it. The alphabet decided which. Somebody
    # mid-proof in Galois Theory looked up at a board labelled PSYCH-ASR, on a
    # device with one URL baked into it, with no way to say which course they
    # meant. A deploy must not move somebody's address.
    #
    # The name points at ONE port, machine-wide, so it is asked once; which
    # course that is is then read off the board each one is actually running on,
    # because a port is a pure function of the workspace's directory basename
    # and the record in `live/.board.json` is the fact rather than a derivation
    # of it.
    all_courses = courses(cfg)
    held_port = None
    for c in all_courses:
        code, out = board(c["root"], "vpn", "holder")
        if code == 0 and out.strip().isdigit():
            held_port = int(out.strip())
        break
    held_before = None
    if held_port:
        for c in all_courses:
            try:
                with open(os.path.join(c["root"], "live", ".board.json"),
                          "r", encoding="utf-8") as fh:
                    if json.load(fh).get("port") == held_port:
                        held_before = (c["dir"], c["root"], held_port)
                        break
            except (OSError, ValueError):
                continue

    touched, skipped = [], []
    for c in all_courses:
        live = os.path.join(c["root"], "live")
        try:
            with open(os.path.join(live, ".board.json"), "r", encoding="utf-8") as fh:
                info = json.load(fh)
        except (OSError, ValueError):
            continue
        if info.get("node") and info["node"] != host:
            skipped.append("%s (on %s)" % (c["dir"], info["node"]))
            continue
        if not processes.board_is_running(info.get("pid"), c["root"]):
            continue
        board(c["root"], "stop")
        code, out = board(c["root"], "start")
        if code == 0:
            touched.append(c["dir"])
        else:
            skipped.append("%s (%s)" % (c["dir"], out.strip().splitlines()[-1:] or "failed"))

    # And give it back. The board that had the name has just come up on the new
    # code; whatever the loop pointed the name at in the meantime, it goes back
    # to where it was. `vpn serve` is the forced claim, which is the right verb:
    # this is not a guess about which course is wanted, it is a restoration of
    # the one that was.
    if held_before:
        name, root, port = held_before
        code, out = board(root, "vpn", "holder")
        now = out.strip() if code == 0 else ""
        if now != str(port):
            board(root, "vpn", "serve")
            print("the address is back on %s" % name)

    if touched:
        print("restarted: %s" % ", ".join(touched))
    else:
        print("no boards were running on %s" % host)
    for s2 in skipped:
        print("  left alone: %s" % s2)

    if "--tutors" not in args:
        return 0

    # The daemons hold old code for exactly the same reason the boards do: this
    # file is read once, when the process starts. A tutor in the middle of a turn
    # is left alone -- bouncing it loses the card it is writing, and the student
    # is the one who pays for that.
    import signal as _sig
    bounced, coming, held = [], [], []
    for c in courses(cfg):
        st = agent_live(c["root"])
        if not st or st.get("mode") == "interactive":
            continue
        if st.get("state") == "working":
            held.append("%s (mid-turn)" % c["dir"])
            continue
        # What configuration says NOW, not what happened to be running. A restart
        # used to bring back whatever the record named, which meant changing
        # `default_agent` never reached a course whose tutor was restarted rather
        # than stopped -- the config said one thing and the board ran another, for
        # ever. This is the safe moment to act on it: the daemon is being stopped
        # anyway, and the SIGTERM below makes it write HANDOFF.md, which is
        # precisely the continuity a different tutor picks up from.
        was_name = st.get("agent")
        name = resolve_agent(cfg, c) or was_name
        # Say, on disk, that this is a RESTART and not a death. The board reads
        # this record to decide what to tell the person holding the iPad, and a
        # daemon being bounced looks from there exactly like one that died: the
        # chip goes to "no tutor attached" and the empty-board banner appears,
        # in the middle of a lesson, because a fix was shipped. Reported as
        # "No tutor attached. NOW the tutor just got attached, but this is
        # spotty". It is one word in the record and it turns a dead end into
        # "reattaching".
        agent_state(c["root"] + "/live", restarting=True, stopped_at=time.time())
        was = st.get("pid")
        if not was:
            # A record with no pid in it. It happens: a daemon killed with its
            # state directory underneath it leaves half a file, and `os.kill`
            # with None does not raise OSError -- it raises TypeError, which is
            # not caught here and took the whole restart down with it, every
            # course after this one included.
            held.append("%s (no pid in its record)" % c["dir"])
            continue
        try:
            os.kill(was, _sig.SIGTERM)
        except OSError:
            pass
        # The wrap-up turn a SIGTERM starts writes HANDOFF.md, and the next tutor
        # reads it -- so waiting for the record to clear is waiting for the
        # continuity to be written, not merely for a process to die. It is one
        # turn, and a turn can take minutes, so this does not wait for ever.
        gone = False
        for _ in range(90):
            if not agent_live(c["root"]):
                gone = True
                break
            time.sleep(1.0)
        if not gone:
            # `agent_start` answers "already listening" here and answers it with
            # a success code, which is how this came to report a restart it had
            # not performed. Say what actually happened.
            #
            # AND WHAT HAPPENS NEXT, because this is the one branch that leaves a
            # restart half-done. A handoff turn is a model call and routinely
            # outruns the ninety seconds above; the `restarting` flag written
            # before the signal stays on the record, and that is what the
            # watchdog picks the tutor back up from once `REATTACH_GRACE` is out.
            # Telling somebody to run it again was the only instruction while
            # the daemon's own exit erased the flag -- and nobody ever does.
            # AND THIS BRANCH NOW FINISHES ITSELF. See `finish_restart`: a
            # detached waiter sits on the wrap-up turn and starts the
            # replacement the moment it ends, so recovery does not depend on a
            # watch loop existing, and does not wait out a fixed grace where it
            # does. The watchdog stays as the backstop it was.
            waiting = handed_off(cfg, c, name)
            held.append("%s (still writing its handoff; %s)"
                        % (c["dir"], waiting))
            continue
        code, msg = agent_start(cfg, c, name)
        if code != 0:
            held.append("%s (%s)" % (c["dir"], msg.strip() or "did not come back"))
            continue
        # A RECORD WITH NO PID IN IT IS NOT A RESTART THAT DID NOT HAPPEN.
        #
        # This read the record once, immediately after the start -- and a start
        # writes `waking` with no pid BEFORE it forks, so the read found a
        # pidless record every time and reported every successful restart as one
        # it had left alone. That is the defect above it wearing the opposite
        # coat: it used to claim restarts it had not performed, and then denied
        # the ones it had. Read off a real ship, with both daemons in fact coming
        # back on the new code: "left alone: claude starting in Galois-Theory".
        #
        # So wait for the daemon's OWN record -- a pid, and a different one --
        # and then say which of the three things happened.
        back = None
        for _ in range(RESTART_WAIT):
            now = agent_live(c["root"]) or {}
            if now.get("pid") and now["pid"] != was:
                back = now
                break
            time.sleep(1.0)
        if back:
            bounced.append(c["dir"] if name == was_name
                           else "%s (%s -> %s)" % (c["dir"], was_name, name))
        elif agent_live(c["root"]):
            # Launched, still on its way, and the one that was there is already
            # gone: not a failure, and not a restart anybody can confirm yet.
            # Saying "left alone" here is the lie -- nothing was left alone.
            coming.append("%s (%s)" % (c["dir"], name))
        else:
            held.append("%s (%s)" % (c["dir"], msg.strip() or "did not come back"))

    if bounced:
        print("tutors restarted: %s" % ", ".join(bounced))
    elif not held and not coming:
        print("no tutors were attached on %s" % host)
    for h in coming:
        print("  coming back: %s -- the old one is gone; it records its pid "
              "when it starts listening" % h)
    for h in held:
        print("  left alone: %s" % h)
    return 0


# What "you were working here" looks like on disk. Several signals, because no
# single one survives everything:
#
#   .board.json  a board is running, or was killed without being stopped --
#                but `board stop` DELETES it, so a cleanly stopped course has
#                none at all;
#   state.json   the session: course, chapter, kind. Written by `board open`
#                and updated through the sitting, and never removed;
#   turns.jsonl  the student's own contributions, appended as they answer;
#   cards        the tutor's, written as it teaches.
#
# Taking the newest of these was the fix for a real mistake: the first version
# looked only at `.board.json`, so stopping the board you were using made that
# course invisible and the next login resumed a DIFFERENT one -- quietly, since
# a login hook runs with --quiet, and the tailnet name moved with it.
LIVE_SIGNS = (".board.json", "state.json", "turns.jsonl", "cards")


def last_used(root):
    """When this course was last worked in, as far as disk can say. 0 if never."""
    best = 0
    for rel in LIVE_SIGNS:
        try:
            best = max(best, os.path.getmtime(os.path.join(root, "live", rel)))
        except OSError:
            continue
    return best




def remember_course(course):
    """Note that a PERSON chose this course, and when.

    Not a registry: courses are still whatever directories are sitting there.
    This records a *decision*, which is a different thing and cannot be derived
    from the filesystem -- because resuming a course touches its files too, so
    "most recently used" is self-reinforcing. A hook that resumed the wrong
    course once would go on resuming it for ever, quietly, taking the tailnet
    name with it every time. Naming one is how you say otherwise.
    """
    choice.remember_chosen(course["dir"], course["root"],
                           family=course.get("family") or "")


def chosen_course(cfg):
    """(when, course) for the last course a person named, if it still exists."""
    rec = choice.chosen_course()
    if not rec:
        return None
    for c in courses(cfg):
        if paths.same_dir(c["root"], rec.get("root")) or c["dir"] == rec.get("dir"):
            return (rec.get("at") or 0, c)
    return None                   # named once, since deleted or renamed


def last_board(cfg):
    """The course to bring back.

    Two signals, and the newer one wins: when a person last named a course, and
    when a course was last worked in. Neither alone is enough -- a name given a
    week ago should not beat an afternoon spent in another course, and file times
    alone cannot tell a course you chose from one a login hook happened to
    start.
    """
    best = chosen_course(cfg)
    for c in courses(cfg):
        when = last_used(c["root"])
        if when and (not best or when > best[0]):
            best = (when, c)
    return best[1] if best else None


def address_course(cfg, here):
    """Which of the boards up here the one HTTPS name is for. None if none is.

    The person's own word and nothing blended into it, which is why this is not
    `last_board`. That answers a different question -- which course to pick back
    up -- and answers it partly from file times, which is right there and wrong
    here: a tutor writes cards and transcript pushes into its own course every
    few minutes, so "most recently used" is a vote the busiest course always
    wins, and the address walks off to it while somebody is reading a different
    one on the iPad. One device, one URL, no way from it to say which course was
    meant; so the only thing that may say is `chosen.json`, which is a decision.

    `here` is the boards answering on this node. None means this node has
    nothing the person asked for -- nobody has ever chosen, or the chosen
    course's board is somewhere else -- and a caller that carries on anyway is
    guessing and must behave like it.
    """
    best = chosen_course(cfg)
    if not best:
        return None
    for c in here:
        if paths.same_dir(c["root"], best[1]["root"]):
            return c
    return None


def board_record(root):
    try:
        with open(os.path.join(root, "live", ".board.json"), "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def prune_dead_records(cfg, host):
    """Drop `live/.board.json` for boards on nodes that are gone.

    Only for nodes Slurm can positively say are no longer yours. No Slurm at all
    means unknown, and unknown is left exactly where it is -- deleting a record
    for a board that is in fact answering would leave a live process nothing can
    find. Returns the courses it swept, for the caller to report.
    """
    held = machine.slurm_nodes()
    if held is None:
        return []
    swept = []
    for c in courses(cfg):
        info = board_record(c["root"]) or {}
        on = info.get("node")
        if not on or on == host or on in held:
            continue
        try:
            os.remove(os.path.join(c["root"], "live", ".board.json"))
            swept.append(c["dir"])
        except OSError:
            pass
    return swept


def allocation_nodes():
    """The compute nodes this user holds, best first.

    `machine.slurm_nodes()` answers the set question -- is the node in that
    record still mine -- and a set has no order. This one has to choose a machine
    to hand work to, so it is ordered, and the order is three rules deep:

    1. The node a board is already on. A lesson that is up is the answer to
       "which machine", and moving one that is alive is exactly what `tutor
       resume` refuses to do.
    2. The allocation this shell belongs to. `salloc` puts its job id in the
       environment of the shell it starts, so that is the allocation the person
       asked for a moment ago.
    3. Everything else, newest allocation first.
    """
    order = list(hostnames(os.environ.get("SLURM_JOB_NODELIST")
                           or os.environ.get("SLURM_NODELIST")))
    for _, nodes, _jid in _running_jobs():
        order += nodes

    seen, out = set(), []
    for n in order:
        n = n.split(".")[0].lower()
        if n and n not in seen:
            seen.add(n)
            out.append(n)
    return out


# The log the login hook redirects itself into, and the only trace a hop leaves
# on the machine it hopped FROM. Named here so a test can point it somewhere
# else; `install-autostart.sh` writes the same path into the hook.
RESUME_LOG = "~/.tutor-resume.log"

# How long to watch a Slurm step before believing in it. A refusal measures a
# hundredth of a second, so this is two orders of magnitude of margin, and it is
# spent only on a login where ssh had ALREADY failed after its own ten-second
# connect timeout. Nothing waits on it: the hook backgrounds the whole resume.
STEP_WATCH_SECONDS = 5.0


def tool_line(tail):
    """This tool, run on another machine, as one shell word-list.

    The path is resolved rather than taken from `argv[0]`: the other end may
    have it on `PATH` under a different name, or not at all, and the checkout is
    on the shared home either way.
    """
    return " ".join(shlex.quote(a) for a in
                    [sys.executable, os.path.realpath(__file__)] + list(tail))


def ssh_tool(target, tail, timeout=300):
    """Run this tool on another of your nodes. Returns (code, output).

    255 means ssh itself could not get in -- a credential this shell does not
    have, usually -- as distinct from the tool running there and failing, which
    is a code of its own with something to read underneath it. Callers choose
    what to do about the difference: the login hop asks Slurm instead, and a
    repair that only wanted to start a tutor says so and stops.
    """
    try:
        p = subprocess.run(["ssh", "-n", "-o", "BatchMode=yes",
                            "-o", "ConnectTimeout=10", "-o", "LogLevel=ERROR",
                            "-o", "StrictHostKeyChecking=accept-new",
                            target, tool_line(tail)],
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           stdin=subprocess.DEVNULL, timeout=timeout)
        return p.returncode, p.stdout.decode("utf-8", "replace")
    except subprocess.TimeoutExpired:
        return 255, ""
    except OSError as exc:
        return 255, str(exc)


def hop_to_allocation(cfg, rest):
    """Run this resume on the compute node, from the login node that holds it.

    `salloc` hands you a shell ON THE LOGIN NODE and holds the allocation from
    there. The compute node itself gets no login at all, so the one moment a
    node was said to get -- the moment you log in to it -- did not happen unless
    somebody went and made it happen, by opening a terminal on the node and
    leaving it open. That is the ceremony: the allocation exists, the machine is
    yours, the board is not running, and the thing standing between them is a
    person typing on a second machine.

    So the login node hands the whole job over. It is the same command on the
    other end -- the node pulls, re-execs onto what it pulled, bounces whatever
    is holding the old code, starts the board, re-points the tailnet name and
    attaches a tutor -- and nothing about the decision is made here. This
    machine only knows which node to knock on.

    Returns an exit code when it tried, or None when there is nothing to hand
    the work to, in which case the caller carries on as before.
    """
    if "--no-hop" in rest or os.environ.get("TUTOR_BOARD_NO_HOP"):
        return None
    if "--force" in rest:
        # `--force` has one meaning already -- take the board off a machine that
        # is still alive -- and it is aimed at THIS machine. Leave it there.
        return None
    mine = machine.slurm_nodes()
    if mine is None or not mine:
        return None                       # not a cluster, or nothing allocated
    host = this_host()
    if host in mine:
        return None                       # this IS the allocation; resume here

    where = {}
    course = last_board(cfg)
    if course:
        where = board_record(course["root"]) or {}
    order = ([where["node"]] if where.get("node") else []) + allocation_nodes()
    target = next((n for n in order if n in mine and n != host), None)
    if not target:
        return None

    tail = ["resume", "--no-hop"] + [a for a in rest if a != "--no-hop"]
    line = tool_line(tail)

    # One line either way, and it is printed even under `--quiet`. Quiet is for
    # a login that had nothing to do; this one crossed a machine, and it is the
    # only trace of that anywhere.
    def tell(msg):
        print("%s: %s" % (target, msg))

    # ssh first, because it leaves nothing behind on this machine: the board ends
    # up in the node's own user session, exactly where it sits when somebody
    # opens a terminal there, and it needs no process here to stay alive.
    code, out = ssh_tool(target, tail)

    if code != 255:
        for l in out.splitlines():
            if l.strip():
                tell(l.strip())
        if not out.strip():
            tell("nothing to do")
        return code

    # ssh could not get in. On a cluster that is usually a credential this shell
    # does not have rather than anything being wrong with the node, and Slurm
    # will run something there without one -- so ask it to. The step has to
    # OUTLIVE the command: everything a step starts is in the step's cgroup, and
    # that cgroup is emptied the moment the step ends, detached or not. So it
    # holds itself open, which ties the board's life to the allocation's -- which
    # is the truth about a compute node anyway.
    job = job_holding(target)
    if not job:
        tell("ssh could not get in, and no running allocation of yours holds it")
        return 1
    log_path = os.path.expanduser(RESUME_LOG)
    log = open(log_path, "a", buffering=1)
    mark = os.path.getsize(log_path)
    step = ["srun", "--overlap", "--jobid", job, "--nodes=1", "--ntasks=1",
            "--nodelist", target, "bash", "-c", line + "; exec sleep 31536000"]
    try:
        running = subprocess.Popen(step, stdout=log, stderr=subprocess.STDOUT,
                                   stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as exc:
        tell("ssh could not get in, and neither could srun: %s" % exc)
        return 1

    # Then WATCH it for a moment, because `Popen` returning says only that srun
    # was EXECUTED. Slurm refuses a step it cannot place in about a hundredth of
    # a second, and that refusal used to arrive after this function had already
    # printed that the board was started inside the job and returned 0 -- so the
    # log carried a success line with the truth four lines below it, and the one
    # place anybody looks said the opposite of what happened. A step that really
    # was created holds itself open for the life of the allocation, so anything
    # that exits inside this window did not start a board.
    gone = None
    deadline = time.time() + STEP_WATCH_SECONDS
    while True:
        gone = running.poll()
        if gone is not None or time.time() >= deadline:
            break
        time.sleep(0.05)

    if gone is not None:
        tell("ssh could not get in, and the step did not stay up: %s"
             % (step_said(log_path, mark) or "srun exited %s without a word" % gone))
        return 1

    tell("ssh could not get in; started inside job %s instead, which holds the "
         "board open for as long as the allocation" % job)
    return 0


def hostnames(spec):
    """Expand a Slurm nodelist -- `compute[303-305]` -- into names.

    Slurm writes a set of machines as one string, and a name tested against that
    string with `in` is a substring match: `compute30` is in `compute[301,305]`
    and is not one of them. `scontrol` is the only thing entitled to read this
    notation, so it does.
    """
    spec = (spec or "").strip()
    if not spec:
        return []
    try:
        p = subprocess.run(["scontrol", "show", "hostnames", spec],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if p.returncode != 0:
        return []
    return [l.strip() for l in p.stdout.decode("utf-8", "replace").splitlines()
            if l.strip()]


def _running_jobs():
    """(start time, node names, job id) per running allocation, newest first."""
    out = []
    try:
        p = subprocess.run(["squeue", "-h", "-u", os.environ.get("USER", ""),
                            "-t", "RUNNING", "-o", "%S|%N|%i"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           timeout=10)
        if p.returncode != 0:
            return []
        for line in p.stdout.decode("utf-8", "replace").splitlines():
            bits = line.split("|")
            if len(bits) == 3 and bits[1].strip():
                out.append((bits[0].strip(), hostnames(bits[1]), bits[2].strip()))
    except (OSError, subprocess.TimeoutExpired):
        return []
    return sorted(out, reverse=True)


def job_holding(target):
    """The running allocation that actually holds `target`, or "".

    The id handed to `srun --jobid` has to be the allocation that owns the node,
    and the one in this shell's environment routinely is not it. `salloc` exports
    `SLURM_JOB_ID` for the job it just made, while the node a hop is aimed at
    comes off the board record FIRST -- a node that outlives the shell which
    started the board, and so usually belongs to an older allocation on a
    different machine. Hand Slurm a job holding no part of `target` and the step
    is refused for "Requested node configuration is not available", which names
    neither the job nor the node: the log then reads like a partition problem
    rather than a mismatch made here, and the hop reports success either way.

    This shell's own job wins when it does hold the node -- it is the allocation
    the person asked for a moment ago. Otherwise the newest one that holds it.
    Names are compared short and lower-cased, because `squeue` and `scontrol`
    disagree about domains and case where nothing else does.
    """
    want = (target or "").split(".")[0].strip().lower()
    if not want:
        return ""
    owners = []
    for _when, nodes, jid in _running_jobs():
        if want in [n.split(".")[0].strip().lower() for n in nodes]:
            owners.append(jid)
    here = (os.environ.get("SLURM_JOB_ID") or "").strip()
    if here and here in owners:
        return here
    return owners[0] if owners else ""


def step_said(path, mark, lines=2):
    """What srun appended to the log after `mark`, as one line.

    The reason a step was refused is in the log and not in the exit status:
    "Unable to create step for job N: Requested node configuration is not
    available" names the job it was asked of, while an exit of 1 names nothing.
    Reading back from a mark taken before the step started is what makes the
    reported line the step's OWN words rather than the tail of an older hop.
    """
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            fh.seek(mark)
            fresh = [l.strip() for l in fh.read().splitlines() if l.strip()]
    except (OSError, ValueError):
        return ""
    return " / ".join(fresh[-lines:])


def pull_vendor(quiet=False):
    """Move `vendor/colibri` forward, and COMMIT THE POINTER ITSELF.

        "Regarding some kind of external repo like colibri, I want to have that
         git pulled every time I salloc, just like tutoring becomes available
         every time I salloc. I want it tracked in our repo too."

    A submodule is exactly that: the repository tracks a POINTER to a commit in
    somebody else's repository, and the pointer is a tracked file like anything
    else. This is the half that makes it happen on a compute node, and it lives
    in `cmd_resume` because a compute node gets ONE moment and it is the login.

    A login is not the only moment a workstation gets, and a machine left up for
    a week never has one. So `tutor pull` exposes this same routine, and
    `tutor-pull.timer` runs it daily -- the same guards, the same commit
    message, one implementation. A timer is safe here only BECAUSE of the third
    rule below: it commits nothing when anything else in the tree is dirty, so
    it cannot sweep up an afternoon it arrived in the middle of.

    The third rule is the one that bites. A bumped pointer is a change in the
    working tree, so pulling colibri leaves the repository dirty every time
    colibri moves -- and `git.repo_dirty` is on the board, which means the
    person is shown "unsaved work" for something they did not do, on a file they
    have never heard of. So the pull commits the bump, with a fixed message
    naming the old commit and the new one.

    **That is the only commit anything in this system makes on its own**, so it
    is guarded three ways, and every guard is one `scripts/catch-up.sh` already
    has written out for the course loop:

    * only when `vendor/colibri` is the ONLY dirty path. Anything else in the
      tree and this does nothing at all -- a commit that sweeps up somebody's
      afternoon because a vendored library moved is the exact failure the
      `--only` pathspec exists to prevent;
    * never when a merge or a rebase is outstanding, because a terminal in here
      has its own plan for the next commit;
    * never on a detached HEAD, where a commit is reachable from nothing.

    `vendor/colibri-build` is NOT pulled. It is the same upstream pinned at an
    older commit because it is a BUILD TREE, and a build tree that moves
    underneath a build is the failure it exists to avoid. Moving it forward is
    the person's to do, by hand.
    """
    base = atlas.root()
    sub = os.path.join(base, "vendor", "colibri")
    if not os.path.isdir(os.path.join(sub, ".git")) and \
       not os.path.isfile(os.path.join(sub, ".git")):
        return None                      # not a checkout here; nothing to do

    def say(msg):
        if not quiet:
            print("  " + msg)

    busy = worktree.busy_reason(base)
    if busy:
        say("colibri not pulled: %s in the repository" % busy)
        return False

    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/false")

    def git(*args, **kw):
        return subprocess.run(["git"] + list(args), cwd=kw.pop("cwd", base),
                              env=env, stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, timeout=kw.get("timeout", 90))

    try:
        before = git("rev-parse", "HEAD", cwd=sub).stdout.decode().strip()
        p = git("submodule", "update", "--remote", "--merge", "vendor/colibri")
        after = git("rev-parse", "HEAD", cwd=sub).stdout.decode().strip()
    except (OSError, subprocess.TimeoutExpired):
        say("could not reach colibri's remote; leaving it where it is")
        return False
    if p.returncode != 0:
        out = p.stdout.decode("utf-8", "replace").strip().splitlines()
        say("colibri not pulled: %s" % (out[-1] if out else "update failed"))
        return False
    if before == after:
        return True                      # already current, and silent about it

    # --- the pointer is now dirty. Commit it, or say why not. ---------------
    try:
        if git("rev-parse", "--abbrev-ref", "HEAD").stdout.decode().strip() == "HEAD":
            say("colibri moved, but HEAD is detached here, so the pointer is "
                "left uncommitted")
            return False
        status = git("status", "--porcelain").stdout.decode("utf-8", "replace")
    except (OSError, subprocess.TimeoutExpired):
        return False

    dirty = [l[3:].strip() for l in status.splitlines() if l.strip()]
    stray = [d for d in dirty if d.rstrip("/") != "vendor/colibri"]
    if stray:
        say("colibri moved to %s, and the pointer is left uncommitted because "
            "there is other uncommitted work here: %s"
            % (after[:8], ", ".join(stray[:3])))
        return False

    msg = ("vendor/colibri moves from %s to %s\n\n"
           "The pointer only. Written by `tutor resume` on login, which is the "
           "one moment a compute node gets, and committed here rather than left "
           "dirty -- an uncommitted pointer nobody touched shows on the board as "
           "unsaved work, which is a lie the person cannot act on."
           % (before[:8], after[:8]))
    try:
        git("commit", "--only", "-m", msg, "--", "vendor/colibri")
    except (OSError, subprocess.TimeoutExpired):
        return False
    say("colibri moved %s -> %s, pointer committed" % (before[:8], after[:8]))
    return True


def cmd_resume(cfg, args):
    """Take the board over on this machine. Safe to run from a login hook.

    Nothing on a compute node outlives its allocation -- not the board, not the
    tutor, not `tailscaled` itself -- so arriving on a new node means the tailnet
    name points at a machine that no longer exists and the iPad gets nothing.
    There is no way for a node to be asked to take over, because being asked
    requires something already listening, and the thing that was listening is
    what died. The only moment a compute node can act on is the moment you log
    in to it, which is what this is for.

    It is deliberately dull: quiet when there is nothing to do, quick when there
    is nothing to do, and it never takes a board away from a machine that is
    still alive unless told to.
    """
    quiet = "--quiet" in args
    force = "--force" in args
    rest = [a for a in args if not a.startswith("-")]
    host = this_host()

    def say(msg):
        if not quiet:
            print(msg)

    # Records left behind by nodes that no longer exist make the hub lie: it
    # cannot tell a board that died with an allocation from one that is
    # answering, so a course reads as "live on compute304" days after compute304
    # stopped being a machine you had, and a tap goes where nothing is
    # listening. Logging in is the moment to sweep them, because it is the
    # moment we can find out which nodes are real. Before choosing a course,
    # since a record is one of the things that decides.
    swept = prune_dead_records(cfg, host)
    if swept:
        say("cleared a dead board record for: %s" % ", ".join(swept))

    # Somebody else's repository, pulled forward and tracked by pointer. Here
    # because a login is the one moment a compute node gets -- the same reason
    # everything else in this function is here.
    pull_vendor(quiet=quiet)

    # And the OTHER thing here that nobody else updates: the unprivileged
    # Tailscale unpacked into this home directory. No package manager knows
    # about it and there is no administrator to notice, so it stays at the
    # version of the afternoon it was installed while the control plane it
    # talks to moves on. It is quiet and free when it is already current, and
    # it never restarts the daemon -- see `update_userspace`.
    tailscale.update_userspace(quiet=quiet)

    # AND THE CHAIN ITSELF, WHICH IS THE ONE THING A LOGIN CAN REPAIR THAT
    # NOTHING ELSE CAN. A generation that fell over in its first second never
    # reached the line that queues its successor, so the self-renewing
    # allocation is the one part of this that cannot watch itself all the way
    # down. A login is exactly the moment somebody is here to notice, and this
    # is quiet and free when the chain is fine.
    chain_repair(cfg, say)

    found = courses(cfg)

    # A board that DIED is not a board that was stopped, and until now nothing
    # ever looked. `board stop` removes the record; a crash, an OOM or a reboot
    # leaves one behind naming a pid that is gone. This command restores the
    # course last worked in -- exactly one of them -- so any other board that
    # fell over while nobody was sitting at this machine stayed down until a
    # person noticed and said so. From the iPad that is a course in the hub that
    # will not open, on a machine that is otherwise perfectly healthy.
    #
    # Three conditions, and each one is a thing that must NOT be started: only
    # where a record exists, so a course nobody has ever opened is not brought up
    # by a timer; only where it names this node, because a record from another
    # machine proves nothing this one can check; and only where the pid is really
    # gone, which `board_is_running` decides by realpath rather than by string.
    #
    # And not on a compute node. There, this runs from a login hook, a board
    # belongs to an allocation, and a login is a person arriving who wants the
    # one course they came for -- starting every board that an ended allocation
    # left a record of, on a shared login node, is the thing the guard further
    # down exists to prevent.
    revived = []
    if machine.machine_shape() != "compute node":
        for c in found:
            rec = board_record(c["root"]) or {}
            if not rec or rec.get("node") != host:
                continue
            if processes.board_is_running(rec.get("pid"), c["root"]):
                continue
            code, _ = board(c["root"], "start")
            if code == 0:
                revived.append(c["dir"])
    if revived:
        say("restarted a board that had died: %s" % ", ".join(revived))

    # THE HOME NODE, ASKED BEFORE THIS MACHINE STARTS ANYTHING.
    #
    # A login hook runs on every interactive shell, including every shell on the
    # `salloc` you keep for coach coding -- so without this, every new terminal
    # there drags the lesson off the serving node and the two of them take turns
    # owning the address. The chain's node is where the board lives; `--force` is
    # still a person insisting, and the serving node's own loop will take it back.
    home = supervise.serving_node()
    if home and home != host and not force:
        say("the board lives on %s, which is the serving job's node; nothing to "
            "do here (tutor serve status)" % home)
        return 0

    course = pick(found, rest[0]) if rest else last_board(cfg)
    if not course:
        say("no board has ever run in %s; start one with: tutor" % cfg["courses_dir"])
        return 0

    if rest:
        remember_course(course)        # named on the command line: a decision

    root = course["root"]
    info = board_record(root) or {}
    on = info.get("node")

    # Catch up before anything else, on every resume and not only the one that
    # starts a fresh board: a handoff or a pushed chapter written on the machine
    # you just left is the whole point of writing it down. Fast-forward only and
    # never fatal, so it is cheap to run on every login.
    sync(root, quiet=True)

    if on == host and processes.board_is_running(info.get("pid"), root):
        # Already serving here. The one thing worth checking is that the tailnet
        # name still points at this port, since that is the part a second board
        # on this node moves out from under it.
        link(root)
        started = ensure_agent(cfg, course, args, say)
        say("%s is already up here%s" % (course["dir"], started))
        return 0

    if on and on != host and not force:
        # A record from another node proves nothing on a shared filesystem, so
        # ask Slurm whether that machine is still a machine you hold. Unknown --
        # no squeue at all -- is not the same as gone, and is left alone.
        nodes = machine.slurm_nodes()
        if nodes is None or on in nodes:
            say("%s is on %s, which is still yours; leaving it there "
                "(--force to move it here)" % (course["dir"], on))
            # Leaving the BOARD there is right. Leaving the question of whether
            # anything is listening to it unasked is what kept a dead tutor
            # dead: see `ensure_agent_away`.
            ensure_agent_away(course, on, args)
            return 0

    # Not every machine you log in to is a machine you should start a board on.
    # A login node is shared, is not yours, and is where long-running processes
    # go to be killed -- and this runs from a login hook, so it will be invited
    # to try. Slurm knows which nodes are actually yours; if there is no Slurm at
    # all this is not a cluster and the question does not arise.
    mine = machine.slurm_nodes()
    if mine is not None and host not in mine and not force:
        say("%s is not one of your allocations; not starting a board here" % host)
        return 0

    code, out = board(root, "start")
    if code != 0:
        say(out.strip() or "could not start the board")
        return 1
    link(root)
    started = ensure_agent(cfg, course, args, say)
    _, net = board(root, "net")
    for line in net.splitlines():
        if "ts.net/" in line and "https" in line:
            say("%s is up here, at %s%s" % (course["dir"], line.strip().split()[0], started))
            break
    else:
        say("%s is up here%s" % (course["dir"], started))
    return 0


def ensure_agent(cfg, course, args, say):
    """Attach a tutor unless told not to. Returns a clause for the caller's line."""
    if "--no-agent" in args:
        return ""
    if agent_live(course["root"]):
        return ", tutor already attached"
    name = resolve_agent(cfg, course, _flag(args, "--agent"))
    code, msg = agent_start(cfg, course, name)
    return (", %s attached" % name) if code == 0 else (", no tutor (%s)" % msg)


def ensure_agent_away(course, on, args):
    """Put a tutor back on a board that is running on ANOTHER of your nodes.

    A BOARD AND ITS TUTOR ARE TWO PROCESSES AND THEY DIE SEPARATELY. An
    allocation ending takes the daemon with it; the board comes back on the next
    node you log in to, and from there the course reads "board on compute301, no
    tutor" -- which nothing went and did anything about. `tutor resume` saw a
    board on a node that is still yours, said it was leaving it there, and
    returned before it reached `ensure_agent`; `tutor restart --tutors` only
    bounces tutors that are already attached, and reports "no tutors were
    attached" for one that died. So the lesson sat on the iPad with nothing
    listening to it for as long as the person went on logging in to the machine
    they work on rather than the one the board is on.

    The record is trusted first, because the common case is a tutor that is
    perfectly well and a login that should cost nothing -- and `agent_attached_
    away` is the only honest test from here, a pid on another machine being
    unreadable. Only a silent record is worth an ssh.

    Over ssh only, and not the hop's Slurm fallback: a step has to hold itself
    open for the life of what it starts, and one sleeping step per login is too
    much to pay for a repair that is usually not needed. When ssh cannot get in,
    say so -- a board with nothing listening to it is the one thing the person
    must not have to guess at.
    """
    if "--no-agent" in args:
        return
    if processes.agent_attached_away(agent_record(course["root"]), on):
        return
    code, out = ssh_tool(on, ["agent", "ensure", course["dir"]], timeout=120)
    said = [l.strip() for l in out.splitlines() if l.strip()]
    for line in said:
        print("%s: %s" % (on, line))
    if code == 255 and not said:
        print("%s: that board has no tutor and ssh could not get in to start "
              "one -- run `tutor agent start %s` there"
              % (on, course["dir"]))


def cmd_cost(cfg, args):
    """What the turns on this machine actually cost, per turn and in total.

        tutor cost              the course an assistant is attached to
        tutor cost galois       a course by name
        tutor cost --all        every course on this machine, one line each
        tutor cost galois --turns   every turn, oldest first

    This is the only honest answer to "is the new arrangement cheaper", and it
    is the reason `usage_args` is on the recipe. Read straight out of
    `live/cost.jsonl`, which every headless turn appends one line to.

    TOKENS is the headline, not dollars. On a subscription what runs out is a
    five-hour allowance, and a percentage of that is computed from what went
    through the model -- input, output, and cache both written and read. Set
    `quota_tokens` in the config and this says what share of a window a turn
    took; leave it null and it says the tokens and lets you divide.

    Two other columns matter. ROUND TRIPS is what a prompt can change, and the
    only thing that turned one turn into 1.4M tokens. And the LAST line is the
    one to read: a second half that costs more per turn than the first means a
    turn is carrying context it should have read back off disk, which is the
    defect this whole arrangement exists to prevent and the one that is
    invisible in every other kind of monitoring, because nothing is broken while
    it happens.
    """
    found = courses(cfg)
    everything = "--all" in args
    per_turn = "--turns" in args
    rest = [a for a in args if not a.startswith("--")]
    try:
        window = int(cfg.get("quota_tokens") or 0)
    except (TypeError, ValueError):
        window = 0

    def share(tokens):
        """That many tokens as a share of one allowance window, if calibrated."""
        return ("  (%.2f%% of a window)" % (100.0 * tokens / window)) if window else ""

    if everything:
        rows = [(c, read_costs(c["root"])) for c in found]
        rows = [(c, r) for c, r in rows if r]
        if not rows:
            print("no turn has reported a cost on this machine yet.")
            print("Turns record one only on a recipe whose `usage` names a "
                  "parser -- `claude-json` or `codex-jsonl`; see "
                  "`tutor --agents`.")
            return 0
        print("%-22s %6s %8s %11s %10s  %s" %
              ("course", "turns", "trips/t", "tokens/t", "total", "who"))
        for c, r in sorted(rows, key=lambda x: -sum(t.get("tokens", 0) for t in x[1])):
            n = len(r)
            print("%-22s %6d %8.1f %11s %9.2f  %s" %
                  (c["dir"][:22], n,
                   sum(t.get("requests", 0) for t in r) / float(n),
                   thousands(sum(t.get("tokens", 0) for t in r) / float(n)),
                   sum(t.get("usd", 0) for t in r),
                   ", ".join(sorted({t.get("agent") or "?" for t in r}))))
        total = sum(t.get("tokens", 0) for _, r in rows for t in r)
        print("\n%s tokens across %d turn(s) on %s%s"
              % (thousands(total), sum(len(r) for _, r in rows), this_host(),
                 share(total)))
        return 0

    if rest:
        course = pick(found, rest[0])
    else:
        # The course an assistant is actually attached to, or the only one that
        # has ever billed anything. Asking "which course?" when there is exactly
        # one answer is the sort of question a tool should not need to ask.
        course = next((c for c in found if agent_live(c["root"])), None)
        if not course:
            billed = [c for c in found if read_costs(c["root"])]
            course = billed[0] if len(billed) == 1 else None
    if not course:
        print("which course? try: tutor cost --all", file=sys.stderr)
        return 1
    rows = read_costs(course["root"])
    if not rows:
        print("%s: no turn has reported a cost here yet." % course["dir"])
        return 0

    if per_turn:
        print("%-19s %5s %-7s %6s %10s %10s %8s %8s %8s" %
              ("when", "turn", "session", "trips", "tokens", "cacheread",
               "cachewrit", "out", "cost"))
        for t in rows:
            print("%-19s %5s %-7s %6d %10s %10s %10s %8s %8.3f" %
                  (t.get("iso", "?"), t.get("turn", "?"),
                   "fresh" if t.get("fresh") else "resumed",
                   t.get("requests", 0), thousands(t.get("tokens", 0)),
                   thousands(t.get("cache_read", 0)),
                   thousands(t.get("cache_write", 0)), thousands(t.get("out", 0)),
                   t.get("usd", 0)))
        print()

    n = len(rows)
    tokens = sum(t.get("tokens", 0) for t in rows)
    fresh = sum(1 for t in rows if t.get("fresh"))
    print("%s — %d turn(s) on %s, %d of them their own session"
          % (course["dir"], n, this_host(), fresh))
    # SPLIT BY WHO TAUGHT IT, which is the whole reason to have three. A line
    # per provider, and it is drawn only where there is more than one -- a
    # single-provider evening already has its totals below.
    by_agent = {}
    for t in rows:
        by_agent.setdefault(t.get("agent") or "?", []).append(t)
    if len(by_agent) > 1:
        for name, r in sorted(by_agent.items(),
                              key=lambda kv: -sum(t.get("tokens", 0) for t in kv[1])):
            money = sum(t.get("usd", 0) for t in r)
            print("  %-10s %3d turn(s), %8s tokens, %s"
                  % (name, len(r), thousands(sum(t.get("tokens", 0) for t in r)),
                     ("$%.2f" % money) if money else "no price table — tokens only"))
    print("  %s tokens a turn%s, %.1f round trips a turn"
          % (thousands(tokens / float(n)), share(tokens / float(n)),
             sum(t.get("requests", 0) for t in rows) / float(n)))
    print("  %s tokens in total%s, $%.2f" % (thousands(tokens), share(tokens),
                                             sum(t.get("usd", 0) for t in rows)))
    dear = max(rows, key=lambda t: t.get("tokens", 0))
    print("  dearest turn: %s tokens%s over %d round trips (%s)"
          % (thousands(dear.get("tokens", 0)), share(dear.get("tokens", 0)),
             dear.get("requests", 0), dear.get("iso", "?")))
    if not window:
        print("  set `quota_tokens` in the config to see these as a share of "
              "one allowance window")
    # The number this whole arrangement exists to hold flat. A rising trend here
    # means a turn is carrying something it should have read back off disk.
    if n >= 6:
        half = n // 2
        early = sum(t.get("tokens", 0) for t in rows[:half]) / float(half)
        late = sum(t.get("tokens", 0) for t in rows[half:]) / float(n - half)
        print("  first half %s a turn, second half %s -- %s"
              % (thousands(early), thousands(late),
                 "flat, which is the point" if late <= early * 1.25
                 else "RISING: a turn is carrying context it could read back"))
    return 0


def cmd_where(cfg, args):
    """What is up, and whether anything is listening."""
    host = this_host()
    print("this machine: %s\n" % host)
    any_up = False
    for c in courses(cfg):
        live = os.path.join(c["root"], "live")
        board_up, on, agent = "-", "", "-"
        try:
            with open(os.path.join(live, ".board.json"), "r", encoding="utf-8") as fh:
                info = json.load(fh)
            on = info.get("node") or "?"
            if on == host:
                if processes.board_is_running(info.get("pid"), c["root"]):
                    board_up = "up :%s" % info.get("port", "?")
                    any_up = True
                else:
                    board_up = "down"
            else:
                board_up = "on " + on
        except (OSError, ValueError):
            pass
        try:
            with open(os.path.join(live, "agent.json"), "r", encoding="utf-8") as fh:
                st = json.load(fh)
            if processes.agent_is_attached(st, host):
                agent = "%s %s" % (st.get("agent"), st.get("state"))
            elif processes.agent_attached_away(st, st.get("host")):
                # A TUTOR ON ANOTHER NODE IS NOT A STALE RECORD.
                #
                # This asked one question -- is that pid alive HERE -- so a
                # daemon listening perfectly well on the node the board is on
                # read as `stale` from the machine the person types on, which is
                # the machine they type `tutor where` on. The heartbeat is what
                # can be checked across a shared filesystem, and it is checked
                # the same way the repair does it.
                agent = "%s %s on %s" % (st.get("agent"), st.get("state"),
                                         st.get("host"))
            else:
                agent = "stale"
        except (OSError, ValueError):
            pass
        print("  %-24s board:%-10s agent:%s" % (c.get("name") or c["dir"], board_up, agent))
    if any_up:
        print()
        for c in courses(cfg):
            _, net = board(c["root"], "net")
            for l in net.splitlines():
                if "ts.net/" in l and "https" in l:
                    print("  reachable at %s" % l.strip().split()[0])
                    break
            break

    # WHICH MACHINE THIS IS ALL STANDING ON, AND FOR HOW LONG. Everything above
    # is about processes; none of it says that the node they are on is borrowed
    # and when it goes back. One line, and only where there is a chain to
    # describe -- `tutor serve status` is the whole of it.
    rows = supervise.serve_jobs()
    for r in rows or []:
        if r["state"] == "RUNNING":
            print("\n  served from job %s on %s, %s of this generation left"
                  % (r["id"], r["node"], r["left"]))
        elif r["dependency"]:
            print("  job %s is queued behind it, so the board outlives this "
                  "allocation" % r["id"])
    if rows == []:
        print("\n  no serving chain: this machine's board goes when its "
              "allocation does (tutor serve)")
    return 0


# ---------------------------------------------------------------------------
# Watching what is up, and holding on to the machine it is up on
# ---------------------------------------------------------------------------
def serve_settings(cfg):
    """What one generation of the serving chain asks Slurm for.

    `c3_short`, nine hours, and both halves of that are measurements.

    The seven-day partitions are the ones a chain would rather have, and neither
    can serve a board:

    - `c3_accel`'s node has NO ROUTE TO TAILSCALE'S CONTROL PLANE. Measured, from
      inside a job on compute306: github 200, api.anthropic.com 405, and
      `controlplane.tailscale.com` reset at the first read, every time, while the
      same request from compute301 answers 200 in a third of a second. A tutor
      could teach from there; the iPad could not reach it, and the iPad is the
      point.
    - `c3` holds the nodes that do work, and `c3_short` OUTRANKS IT -- priority
      tier 20 against 10 -- with `c3`'s PreemptMode set to SUSPEND under a GANG
      scheduler. So a seven-day board there is SIGSTOPped, and time-sliced, by
      the first busy afternoon: alive, holding its port, answering nothing, on a
      node whose watch loop is frozen in the same cgroup. It is the one failure
      nothing in here can see or report.

    `c3_short` is the top tier, so nothing can preempt it, and its nine-hour
    ceiling is the thing this whole chain exists to make irrelevant: a handover
    costs the seconds the scheduler takes, about three times a day, and it is
    automatic.

    Every value is a config key, because the day the cluster is rearranged this
    has to be answerable without a commit.
    """
    return {"partition": cfg.get("serve_partition") or "c3_short",
            "time": cfg.get("serve_time") or "09:00:00",
            "cpus": cfg.get("serve_cpus") or 2,
            "mem": cfg.get("serve_mem") or "8G"}


def last_line(out):
    """The last thing a command said, for a one-line report. Never an empty one."""
    said = [l.strip() for l in (out or "").splitlines() if l.strip()]
    return said[-1] if said else "no reason given"


def watch_once(cfg, host, memo, say, claim=False):
    """One pass over every workspace, repairing what is down. Returns what it did.

    `memo` is the loop's memory, keyed by workspace: how many health probes have
    missed in a row, how many repairs have been tried, and when the next one is
    allowed. A board that is a second late writing a slate PNG is not a board to
    bounce, and a tutor that cannot start -- no allowance, no command on the path
    -- must not be started every twenty seconds for seven days.

    What it will NOT do is the load-bearing half:

    - nothing without a record. `board stop` and `tutor headless --stop` remove
      theirs, and a workspace nobody has ever opened never had one. Both mean a
      person has not asked for this, and a watchdog that starts nine boards
      because it found nine directories is a worse failure than the one it fixes.
    - nothing whose record names a node that is still an allocation of yours.
      The pid in it cannot be read from here, so the only honest answer is to
      leave it, and the login-time repair (`ensure_agent_away`) is what reaches
      across to a node over ssh.
    - nothing a restart is already doing. `tutor restart --tutors` writes
      `restarting` before it signals, exactly so a bounce can be told from a
      death, and this waits that grace out before deciding a bounce has failed.
    """
    did = []
    held = machine.slurm_nodes()
    # One ask per node per pass, and the answer is remembered: `take_from` is a
    # whole-machine errand, so asking it again for the second workspace on the
    # same node would stop what the first one just started.
    asked = {}
    for c in courses(cfg):
        root, name = c["root"], c["dir"]
        mem = memo.setdefault(name, {"misses": 0, "board_tries": 0, "board_at": 0.0,
                                     "tutor_tries": 0, "tutor_at": 0.0})
        now = time.time()

        # --- the board ------------------------------------------------------
        rec = board_record(root) or {}
        theirs = rec.get("node") and rec["node"] != host
        # "Still one of yours" is what Slurm answers, and unknown (no squeue at
        # all, or a controller not answering) counts as still yours: the wrong
        # move here is to take a live board off another machine.
        theirs_live = None if held is None else (rec.get("node") in held)
        # `claim` IS THE SERVING NODE'S STANDING ORDER, and it is the one thing
        # that overrides "leave a live node alone". The chain's node is home: the
        # board lives there, the address is there, and an `salloc` is for coach
        # coding and holds no lesson. Without it, a board that died on a node you
        # still hold is repaired by nobody -- the only watch loop is over here,
        # and it was told to keep its hands off. That is exactly how a white
        # screen outlived a watchdog on 17 September.
        if theirs and (claim or theirs_live is False):
            verdict = "adopt"
        else:
            pid_ok = processes.board_is_running(rec.get("pid"), root)
            answers = supervise.answering(rec.get("port")) if (rec and pid_ok) else False
            mem["misses"] = 0 if answers else mem["misses"] + 1
            verdict = supervise.board_verdict(rec, host, pid_ok, answers, mem["misses"])
        if verdict in ("revive", "hung", "adopt") and now >= mem["board_at"]:
            if (verdict == "adopt" and theirs_live
                    and not take_from(rec["node"], say, asked)):
                mem["board_tries"] += 1
                mem["board_at"] = now + supervise.next_try(mem["board_tries"])
                continue
            if verdict == "hung":
                # Wedged rather than gone: the pid has to be taken out before a
                # start, or the port is still held and the new one lands
                # somewhere the iPad is not looking.
                board(root, "stop")
            code, out = board(root, "start")
            if code == 0:
                # AND THE ADDRESS, which is the half the iPad actually feels. A
                # board back on loopback with no tailnet link is a board nobody
                # can reach, and on a node that has just taken the serving over
                # there is no link yet: `tailscaled` died with the allocation
                # that had it, and the claim in the shared state directory still
                # names that node. `link` clears a claim from a node Slurm no
                # longer gives you, starts the daemon, and takes the HTTPS name
                # only if it is pointing at nothing -- which is exactly the
                # rule a start follows anyway.
                link(root)
            mem["misses"] = 0
            mem["board_tries"] = 0 if code == 0 else mem["board_tries"] + 1
            mem["board_at"] = now + supervise.next_try(mem["board_tries"])
            note = "%s: board %s" % (name, {"revive": "was dead", "hung": "was wedged",
                                            "adopt": "moved here"}[verdict])
            did.append(note if code == 0 else
                       "%s -- and would not start (%s)" % (note, last_line(out)))
            say(did[-1])
        elif verdict == "ok":
            mem["board_tries"] = 0

        # --- the tutor ------------------------------------------------------
        st = agent_record(root) or {}
        theirs = st.get("host") and st["host"] != host
        theirs_live = None if held is None else (st.get("host") in held)
        if theirs and (claim or theirs_live is False) and supervise.left_behind(st):
            # `left_behind` is the same question either way: was this tutor
            # serving, or was it told to go. A node asked to let go writes the
            # handover flag on its way out, which is what makes a claim carry the
            # lesson instead of ending it.
            tverdict = "adopt"
        else:
            tverdict = supervise.tutor_verdict(
                st, host, processes.pid_alive(st.get("pid")))
        if tverdict in ("revive", "adopt") and now >= mem["tutor_at"]:
            # Only where something is still RUNNING there. A record that says
            # `stopped` has already let go -- asking that node again is a
            # whole-machine stop aimed at a machine that has nothing of this
            # lesson left, and it arrives after the board has already moved.
            if (tverdict == "adopt" and theirs_live
                    and st.get("state") != "stopped"
                    and not take_from(st["host"], say, asked)):
                mem["tutor_tries"] += 1
                mem["tutor_at"] = now + supervise.next_try(mem["tutor_tries"])
                continue
            # Whatever configuration says now, not what the dead record named:
            # the same rule `cmd_restart` follows, and for the same reason.
            agent_name = resolve_agent(cfg, c) or st.get("agent")
            # The handover flag has been acted on; leaving it set would make
            # every later stop of this tutor look like a machine going away.
            if st.get("handover"):
                agent_state(os.path.join(root, "live"), handover=None)
            code, msg = agent_start(cfg, c, agent_name)
            mem["tutor_tries"] = 0 if code == 0 else mem["tutor_tries"] + 1
            mem["tutor_at"] = now + supervise.next_try(mem["tutor_tries"])
            did.append("%s: tutor %s -- %s"
                       % (name, "moved here" if tverdict == "adopt" else "was dead",
                          (msg or "").strip()))
            say(did[-1])
        elif tverdict == "ok":
            mem["tutor_tries"] = 0

    # --- THE ADDRESS, EVERY PASS ------------------------------------------
    # A board can be perfect and unreachable, and that is the whole of what the
    # iPad experiences: one HTTPS name, which needs a `tailscaled` on THIS node
    # and a `tailscale serve` pointing at a port that answers. Both can fail with
    # nothing dying -- a link that lost a race while a generation was starting,
    # a name still pointing at the port of a board that has moved -- and until
    # now nothing ever looked again. `link` was called after a board START, so a
    # link that failed there was never retried: measured on compute306, where
    # every process was healthy, both boards answered on loopback, and the glass
    # stayed white.
    addr = memo.setdefault("#address", {"at": 0.0, "tries": 0,
                                        "waiting": False})
    now = time.time()
    if now >= addr["at"]:
        here = [c for c in courses(cfg)
                if processes.board_is_running(
                    (board_record(c["root"]) or {}).get("pid"), c["root"])
                and (board_record(c["root"]) or {}).get("node") == host]
        stalled = None
        if here:
            # WHICH COURSE THE ADDRESS IS FOR IS A DECISION. `address_course`
            # reads the person's, and reads nothing else; with no choice
            # standing on this node it is None and what follows is the boards
            # here in the order they were found, which is the alphabet wearing a
            # disguise. A guess may keep the address alive and may not move it:
            # everything below that says "and only when the choice is known"
            # says it for that reason.
            want = address_course(cfg, here)
            guess = want is None
            if guess:
                want = here[0]
            mine = (board_record(want["root"]) or {}).get("port")
            why = forced = None
            if not tailscale.daemon_running():
                why = "there is no tailnet link on this node"
            else:
                code, out = board(want["root"], "vpn", "holder")
                port = (out or "").strip()
                if not (code == 0 and port.isdigit()
                        and supervise.answering(int(port))):
                    why = "the address is not pointing at a board that answers"
                elif not guess and mine and int(port) != int(mine):
                    # POINTING AT SOMETHING THAT ANSWERS IS NOT THE TEST. A
                    # board the person did not ask for answers just as well, and
                    # the pass that only asks "does anything answer" calls that
                    # healthy and leaves them in it for ever: one bad moment --
                    # the chosen board a few seconds down, mid-restart -- hands
                    # the name to the next course along and nothing ever asks
                    # again. The name has to be on the chosen board's own port.
                    #
                    # WHICH IS ALSO WHERE ANSWERING IS NOT OWNING LANDS. A board
                    # an ended generation left behind answers exactly like a
                    # live one and is named by no record, so "does anything
                    # answer" calls the name resting on it healthy for as long
                    # as that process lives -- and a leftover's port is not the
                    # chosen board's port either, so this is the test that takes
                    # the name off it. No separate one: a leftover is still an
                    # address that draws, and with nobody having chosen there is
                    # nothing here entitled to move it onto something else.
                    #
                    # ONLY A CHOICE REACHES THIS BRANCH, and `guess` is what
                    # keeps it that way: this is the one place that overrides
                    # the guard against a wandering address, and the alphabet
                    # is not entitled to it. A record with no port says nothing
                    # either way and is left alone -- a truncated record read as
                    # drift is a claim every pass, for ever.
                    #
                    # AND A NAME IS WORTH MOVING ONLY ONTO A BOARD THAT CAN DRAW
                    # SOMETHING. `here` is a pid and a node, which a wedged
                    # board passes: alive, holding its port, answering nothing.
                    # Claiming for that is a white screen in exchange for a
                    # working wrong lesson. The wedged board is the half above's
                    # to fix -- it stops the pid, starts it again and links it --
                    # and the name comes back on the pass after that one.
                    if supervise.answering(int(mine)):
                        why = "the address is pointing at a course nobody chose"
                        forced = True
                    else:
                        stalled = True
            # HOLDING STILL IS ALSO A THING TO SAY, once. The name is on a
            # course nobody chose and the chosen course's board cannot be given
            # it yet, which is a state a reader of the log has to be able to
            # see; a line every twenty seconds is not seeing it. The flag marks
            # the entry, and is cleared wherever the state is not so the next
            # time is reported too. `tries` is untouched by it: the recheck is
            # the next pass, not a backoff away, because this clears the moment
            # the board half finishes.
            if stalled and not addr["waiting"]:
                did.append("the address is pointing at a course nobody chose, "
                           "and %s's own board is not answering yet, so the "
                           "name is left where it is" % want["dir"])
                say(did[-1])
            if why:
                if forced:
                    # A name on another course's LIVE board is not free, and
                    # `link` will not take it: `--if-free` is there so that a
                    # board coming up cannot drag the iPad out of the lesson
                    # somebody is reading. A standing choice may, and is the one
                    # thing that may, so it uses the forced claim -- the same
                    # command a person types to say which course they mean,
                    # typed here on their behalf because they already said it.
                    #
                    # A CLAIM THAT FAILED MUST NOT READ LIKE ONE THAT WORKED.
                    # `tailscaled` runs on a node that is not logged in, so the
                    # gate above passes and the serve is still refused -- and
                    # unlike `link` this path never runs `board vpn up` first.
                    # The exit code is the only thing that knows.
                    code, out = board(want["root"], "vpn", "serve")
                    if code == 0:
                        did.append("%s, so the address was pointed back at %s"
                                   % (why, want["dir"]))
                    else:
                        did.append("%s -- and the claim for %s would not go "
                                   "through (%s)"
                                   % (why, want["dir"], last_line(out)))
                else:
                    link(want["root"])
                    did.append("%s, so the link was brought up for %s"
                               % (why, want["dir"]))
                addr["tries"] += 1
                addr["at"] = now + supervise.next_try(addr["tries"])
                say(did[-1])
            else:
                addr["tries"] = 0
        # A pass with no board up here is not the state ending, but it is not
        # the state either, and the flag has to come off in both: an empty
        # `here` is what a generation handover looks like, which is exactly when
        # the address gets stuck, and a flag left set there silences the line on
        # the way back in.
        addr["waiting"] = bool(stalled)
    return did


def cmd_watch(cfg, args):
    """Keep the boards and tutors on this machine up. Runs until it is stopped.

        tutor watch                 the loop
        tutor watch --once          one pass, then stop
        tutor watch --interval 30   how often to look (seconds)

    This is what the serving job runs, and it is worth running by hand inside an
    `salloc` too: it is the difference between a tutor that died at four o'clock
    and a tutor that was back at four o'clock and twenty seconds.

    It repairs only what a person has already asked for -- see `watch_once` --
    and it says what it repaired into whatever log it was started with, as well
    as into `watch.json`, which is what `tutor serve status` reads.
    """
    interval = float(_flag(args, "--interval") or supervise.POLL)
    once = "--once" in args
    host = this_host()
    memo, repairs, checks = {}, [], 0
    started = time.time()

    stopping = {"now": False}

    def bye(*_):
        stopping["now"] = True
    for sig in (signal.SIGTERM, signal.SIGINT):
        try:
            signal.signal(sig, bye)
        except (OSError, ValueError):
            pass

    def say(line):
        print("[%s] %s" % (time.strftime("%H:%M:%S"), line))

    while True:
        checks += 1
        try:
            did = watch_once(cfg, host, memo, say)
        except Exception as exc:                             # noqa: BLE001
            # A WATCHDOG MAY NOT DIE OF THE THING IT IS WATCHING. One unreadable
            # record, one workspace half-way through being created, one NFS
            # hiccup -- any of them would take the loop down and leave nothing
            # watching anything, which is worse than the fault it tripped over.
            did = []
            say("the watch pass failed and the loop is carrying on: %r" % (exc,))
        repairs = (repairs + did)[-20:]
        supervise.note_watch(host=host, pid=os.getpid(), started=started,
                             last=time.time(), checks=checks, repairs=repairs,
                             job=os.environ.get("SLURM_JOB_ID") or "")
        if once or stopping["now"]:
            break
        if supervise.stopped():
            say("tutor serve stop was called; the watch loop is standing down")
            break
        end = time.time() + interval
        while time.time() < end and not stopping["now"]:
            time.sleep(0.5)
        if stopping["now"]:
            break
    return 0


def ensure_successor(cfg, job, say):
    """Queue the generation that takes over when this one ends. Returns its id.

    Idempotent on purpose, and that is not decoration: `--requeue` means this
    script can be run a second time for the same job id after a node failure,
    and the first thing it does is this. A pending job whose dependency names
    this job IS the successor -- asked of Slurm rather than of a file, because
    the file cannot know that a submission was refused.
    """
    if supervise.stopped():
        say("not queueing a successor: tutor serve stop was called")
        return None
    rows = supervise.serve_jobs()
    if rows is None:
        say("squeue did not answer, so no successor was queued this time")
        return None
    already = supervise.successor_of(job, rows)
    if already:
        return already["id"]
    want = serve_settings(cfg)
    new, err = supervise.submit(want["partition"], want["time"], want["cpus"],
                                want["mem"], after=job,
                                chdir=atlas.root())
    if err:
        say("could not queue the next generation: %s" % err)
        return None
    say("job %s is queued behind this one, on %s for %s"
        % (new, want["partition"], want["time"]))
    return new


def cmd_down(cfg, args):
    """Take this machine out of serving. The other half of `tutor resume`.

        tutor down              every board and tutor here, and the tailnet link
        tutor down galois       one workspace, and nothing else

    There was no way to say this, and it is what a machine handing the board over
    has to be able to say. Two boards serving one `live/` directory off a shared
    home is worse than a board on the wrong machine: both write cards, both
    answer the same inbox line, and the student pays for two turns of the same
    lesson. So before the serving node picks a workspace up, the node that has it
    is asked -- over ssh, the same route `ensure_agent_away` uses -- to let go.

    The tutor is stopped with a wait, because that stop IS the handoff turn and
    the point of taking it over is to carry the lesson, not to drop it.
    """
    named = [a for a in args if not a.startswith("-")]
    host = this_host()
    found = courses(cfg)
    if named:
        want = [pick(found, named[0])]
    else:
        want = [c for c in found
                if (board_record(c["root"]) or {}).get("node") == host
                or (agent_record(c["root"]) or {}).get("host") == host]
    if not want or want == [None]:
        print("nothing here to stop")
        return 0
    for c in want:
        st = agent_record(c["root"]) or {}
        if st.get("host") == host and st.get("state") not in (None, "stopped"):
            # The record says it is a handover rather than somebody leaving, so
            # whoever takes it over knows to pick it back up. `agent_state` merges,
            # so the daemon's own exit record does not erase this.
            agent_state(os.path.join(c["root"], "live"),
                        handover=time.strftime("%Y-%m-%d %H:%M:%S"))
            code, msg = agent_stop(c, wait=True)
            print("  %s" % (msg or "").strip())
        # ONLY A BOARD THIS MACHINE ACTUALLY HAS. `board stop` against a record
        # naming another node does not stop anything -- it cannot -- and it
        # DELETES THE RECORD, which is worse than doing nothing: the process goes
        # on serving with nothing on disk naming it, so the hub cannot find it,
        # the watch loop sees no record and leaves it alone, and the next tutor
        # start puts a SECOND board on a fallback port against the same `live/`.
        # That is not hypothetical; it is what this line did the first time it
        # ran, to PSYCH-ASR, ten seconds after the board had moved.
        on = (board_record(c["root"]) or {}).get("node")
        if on and on != host:
            print("  %s: its board is on %s, not here; left alone"
                  % (c["dir"], on))
            continue
        code, out = board(c["root"], "stop")
        print("  %s: %s" % (c["dir"], last_line(out)))
    if not named:
        # The link is a property of the MACHINE, not of a workspace, and it is
        # the thing that must not be held by a node that has stopped serving:
        # the state directory is shared, so a claim left behind makes the next
        # node refuse to bring the link up at all.
        code, out = board(want[0]["root"], "vpn", "down")
        print("  %s" % last_line(out))
    return 0


def take_from(node, say, asked=None):
    """Ask another of your nodes to stop serving. True if it did, or has.

    MACHINE-WIDE, not one workspace, and that is the whole reason this is not a
    loop over courses: the TAILNET LINK belongs to the machine. `board vpn up` on
    a new node refuses while the claim in the shared state directory names a node
    Slurm still says is yours -- so a claim that took the boards one at a time
    would land them on a node with no link and no address, which is a white
    screen with every process healthy. `tutor down` with no workspace named stops
    every board and tutor there AND lets the link go.

    ssh first, and then Slurm, which is the same two routes `hop_to_allocation`
    uses and for the same reason: ssh between compute nodes here is refused for
    want of a key, and a step in the allocation that HOLDS the node needs no
    credential of its own. A step is the right shape for this particular errand
    because the errand is to STOP things -- nothing has to outlive the step, so
    the cgroup emptying when it ends costs nothing.

    Where neither route gets in, this returns False and the caller starts
    NOTHING, because the failure being avoided is two live boards writing one
    `live/` directory rather than one board on the wrong machine.
    """
    if asked is not None and node in asked:
        return asked[node] if isinstance(asked, dict) else True

    def answer(ok, lines):
        for line in [l.strip() for l in (lines or "").splitlines() if l.strip()]:
            say("%s: %s" % (node, line))
        if isinstance(asked, dict):
            asked[node] = ok
        elif asked is not None:
            asked.add(node)
        return ok

    code, out = ssh_tool(node, ["down"], timeout=240)
    if code != 255:
        return answer(True, out)

    job = job_holding(node)
    if not job:
        # Nothing of yours holds that node any more, so there is nobody to ask
        # and nothing left running there to ask about.
        return answer(True, "")
    step = ["srun", "--overlap", "--jobid", job, "--nodes=1", "--ntasks=1",
            "--nodelist", node] + [sys.executable, os.path.realpath(__file__), "down"]
    try:
        p = subprocess.run(step, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           stdin=subprocess.DEVNULL, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return answer(False, "could not be asked to let go: %s" % exc)
    said = p.stdout.decode("utf-8", "replace")
    if p.returncode != 0:
        return answer(False, "would not let go: %s" % (last_line(said)))
    return answer(True, said)


def previously_serving(cfg, host, only_dead=True):
    """The workspaces that had boards up on some other node than this one.

    Read off `live/.board.json` naming a node Slurm no longer gives you, which
    is the only evidence there is: nothing records a generation's set of boards,
    and the records that imply it are swept on the next resume.

    A board on a node that is STILL yours is not in here. That is an allocation
    of your own with a board in it -- an `salloc` for coach coding, most likely --
    and taking its lesson away from it is the one thing `tutor resume` has always
    refused to do.
    """
    held = machine.slurm_nodes()
    if held is None:
        return []
    out = []
    for c in courses(cfg):
        on = (board_record(c["root"]) or {}).get("node")
        if not on or on == host:
            continue
        # `only_dead` is the login's question -- which lessons did the machine
        # that went have up. A serving generation asks the other one: which
        # lessons are anywhere else at all, because it is about to ask those
        # nodes to let go and their records will be gone a second later.
        if only_dead and on in held:
            continue
        out.append(c)
    return out


def claim_elsewhere(cfg, host, say):
    """Ask every other node of yours to stop serving. Returns the nodes asked.

    BEFORE ANYTHING IS STARTED HERE, and the order is the whole point. `board
    vpn up` refuses to bring the link up while the claim in the shared state
    directory names a node Slurm still says is yours -- so a board started
    before the ask comes up on loopback with no tailnet name, and nothing
    afterwards goes back to check. Every process healthy, and a white screen.
    """
    held = machine.slurm_nodes()
    nodes = set()
    for c in courses(cfg):
        for n in ((board_record(c["root"]) or {}).get("node"),
                  (agent_record(c["root"]) or {}).get("host")):
            if n and n != host and (held is None or n in held):
                nodes.add(n)
    asked = {}
    for n in sorted(nodes):
        say("asking %s to stop serving, so this node can" % n)
        take_from(n, say, asked)
    return [n for n, ok in asked.items() if ok]


def hand_over(cfg, host, say, deadline=240):
    """The walltime is coming. Get the lesson to a saving point while it can be.

    A generation ends and its node stops being yours, which takes the board, the
    tutor and `tailscaled` with it. The transcript beat has pushed the lesson
    itself every ninety seconds, so what is actually at risk is the one thing
    only the daemon can write: the handoff, which is the whole of what the next
    session knows. So each daemon is asked to stop the way a person switching
    course asks it -- SIGTERM, which is the wrap-up turn -- and this waits.

    Bounded, because the warning is finite: Slurm gives the job
    `HANDOVER_WARNING` seconds and then takes the machine whatever anybody is
    part-way through.
    """
    asked = []
    for c in courses(cfg):
        st = agent_live(c["root"])
        if not st or st.get("mode") == "interactive":
            continue
        if st.get("host") and st["host"] != host:
            continue
        # WHY it is being stopped, on disk, before it is stopped. The daemon's
        # exit record cannot carry this -- it does not know -- and the next
        # generation has to tell a machine that went from a person who left.
        agent_state(os.path.join(c["root"], "live"),
                    handover=time.strftime("%Y-%m-%d %H:%M:%S"))
        code, msg = agent_stop(c)
        say("handover: %s" % (msg or "").strip())
        if code == 0:
            asked.append(c)
    end = time.time() + deadline
    while time.time() < end:
        if not any(agent_live(c["root"]) for c in asked):
            break
        time.sleep(2)
    for c in asked:
        # The last push, now that nothing is writing. The daemon's own beat does
        # this every ninety seconds; this one is for the handoff it just wrote.
        try:
            sync_transcript(c["root"])
        except Exception:                                    # noqa: BLE001
            pass
    say("handover done; the next generation takes it from here")


def chain_repair(cfg, say):
    """Put the serving chain back if it was meant to be running and is not.

    Only where one was started and not stopped: the record says a chain exists,
    no stop flag says a person ended it, and Slurm has nothing under the job
    name. Anything less than all three and this does nothing at all, because the
    alternative is a login hook that submits a seven-day job on a machine where
    nobody ever asked for one.
    """
    rec = supervise.chain_record()
    if not rec.get("job") or supervise.stopped():
        return
    if machine.slurm_nodes() is None:
        return
    rows = supervise.serve_jobs()
    if rows is None or rows:
        return                     # unknown, or perfectly well
    want = serve_settings(cfg)
    job, err = supervise.submit(want["partition"], want["time"], want["cpus"],
                                want["mem"], chdir=atlas.root())
    if err:
        say("the serving chain had stopped and could not be restarted: %s" % err)
        return
    supervise.note_generation(job=job, node=None, started=time.time(),
                              generation=(rec.get("generation") or 0) + 1,
                              previous=rec.get("job"), successor=None,
                              partition=want["partition"], walltime=want["time"])
    say("the serving chain had stopped; job %s is queued to take it back up" % job)


def cmd_serve(cfg, args):
    """Serve the board from a Slurm job that keeps renewing its own allocation.

        tutor serve            start the chain (refuses a second one)
        tutor serve status     which generation is up, where, what it repaired
        tutor serve stop       end it: the flag, then the cancel
        tutor serve restart    end it and start a fresh one on current settings

    The point of it is that `salloc` stops being part of the day. A generation
    submits its successor with `--dependency=afterany:<itself>` before it does
    anything else, so the queue always holds the next machine; the board, the
    tutors and a watch loop run inside the current one; and the tailnet name
    follows whichever node the chain is on, which is the address the iPad has
    baked into it.

    `tutor serve inside` is what the job script runs. It is not for typing.
    """
    sub = (args[0] if args and not args[0].startswith("-") else "start")
    rest = args[1:] if args and not args[0].startswith("-") else args

    if sub == "inside":
        return serve_inside(cfg, rest)

    if sub == "chain":
        job = os.environ.get("SLURM_JOB_ID") or _flag(rest, "--job")
        if not job:
            print("no job to chain behind: run this inside one, or pass --job",
                  file=sys.stderr)
            return 1
        return 0 if ensure_successor(cfg, job, print) else 1

    if sub == "status":
        return serve_status(cfg)

    if sub in ("stop", "restart"):
        supervise.mark_stopped("tutor serve %s" % sub)
        err = supervise.cancel()
        if err:
            print("the flag is set, but scancel said: %s" % err, file=sys.stderr)
        else:
            print("the chain is cancelled and will not queue another generation")
        if sub == "stop":
            print("what is running on the node now goes when its job does.")
            print("start it again with: tutor serve")
            return 0
        # A restart waits for the queue to be empty of the old chain, or the
        # guard below refuses the new generation for being a second one -- and
        # says nothing about why, which is how `serve.sh restart` came back
        # having cancelled a chain and started nothing.
        #
        # Thirty seconds was not enough and could not be: a cancelled generation
        # goes to COMPLETING while its tutors write their handoffs, which is a
        # model turn each. Four minutes, out loud, and then said plainly rather
        # than left to the guard.
        waited = False
        for n in range(240):
            rows = supervise.serve_jobs()
            if rows is not None and not rows:
                break
            if n == 2:
                waited = True
                print("waiting for the old generation to finish its handoff...")
            time.sleep(1.0)
        else:
            print("the old chain is still in the queue after four minutes, so "
                  "nothing new was submitted.", file=sys.stderr)
            print("squeue -u $USER -n %s   to see what it is doing"
                  % supervise.JOB_NAME, file=sys.stderr)
            print("tutor serve            to start one once it has gone",
                  file=sys.stderr)
            return 1
        if waited:
            print("it has gone.")

    # --- starting it -------------------------------------------------------
    if machine.slurm_nodes() is None:
        print("there is no Slurm here, so there is nothing to renew: this "
              "machine's board comes back with `tutor resume`.", file=sys.stderr)
        return 1
    rows = supervise.serve_jobs()
    if rows is None:
        print("squeue did not answer, so I cannot tell whether a chain is "
              "already running. Nothing was submitted.", file=sys.stderr)
        return 1
    if rows and "--force" not in rest:
        print("a serving chain is already there:")
        for r in rows:
            print("  job %-9s %-9s %s" % (r["id"], r["state"],
                                          r["node"] or "(%s)" % r["dependency"]))
        print("\ntutor serve status   what it is doing")
        print("tutor serve restart  replace it with a fresh one")
        return 1
    supervise.clear_stopped()
    want = serve_settings(cfg)
    job, err = supervise.submit(want["partition"], want["time"], want["cpus"],
                                want["mem"], chdir=atlas.root())
    if err:
        print("could not submit the serving job: %s" % err, file=sys.stderr)
        return 1
    supervise.note_generation(started=time.time(), job=job, generation=1,
                              partition=want["partition"], walltime=want["time"],
                              node=None, previous=None)
    print("job %s is queued: %s, %s, %s CPU(s), %s"
          % (job, want["partition"], want["time"], want["cpus"], want["mem"]))
    print("it brings the boards and the tutors up itself, watches them, and "
          "queues the next generation before it does either.")
    print("\nwatch it arrive:  tutor serve status")
    print("end it for good:  tutor serve stop")
    return 0


def serve_inside(cfg, args):
    """One generation of the chain, from the inside. Run by the job script.

    The order is the whole of it:

    1. Queue the successor. FIRST, before the code is caught up and before a
       single board is started, because everything after this line can fail and
       the one thing that must not is the chain. A generation that dies in its
       first second still leaves a machine queued behind it.
    2. Catch the tool up and re-exec onto it. A generation lasts seven days; it
       should not start seven days behind.
    3. Take the board over on this node -- the tailnet link, the boards, the
       tutors -- which is `tutor resume`, the same routine a login runs, and
       which leaves a board alone on an allocation you are still holding.
    4. Watch, until the walltime warning arrives.
    5. Hand over: the daemons write their handoffs while there is still a machine.
    """
    job = os.environ.get("SLURM_JOB_ID") or ""
    host = this_host()

    def say(line):
        print("[%s] %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), line), flush=True)

    say("generation up on %s as job %s" % (host, job or "(no job id)"))
    if supervise.stopped():
        say("tutor serve stop was called; this generation is standing down and "
            "queueing nothing")
        return 0

    successor = ensure_successor(cfg, job, say) if job else None
    was = supervise.chain_record()
    supervise.note_generation(
        job=job, node=host, started=time.time(), successor=successor,
        generation=(was.get("generation") or 0) + 1 if was.get("job") != job
        else was.get("generation"),
        previous=was.get("job") if was.get("job") != job else was.get("previous"),
        partition=os.environ.get("SLURM_JOB_PARTITION") or "")

    # The walltime warning, and an ordinary cancel, are the same event: this
    # machine is about to stop being ours. `--signal=B:USR1@N` is what Slurm
    # sends before the limit; SIGTERM is what `scancel` sends, and it arrives
    # with a grace period of its own (KillWait), which is shorter -- so the
    # handover is given what is left rather than the full four minutes.
    going = {"why": None, "at": 0.0}

    def leaving(signum, _frame):
        if going["why"]:
            return
        going["why"] = "the walltime" if signum == signal.SIGUSR1 else "a cancel"
        going["at"] = time.time()
    for sig in (signal.SIGUSR1, signal.SIGTERM, signal.SIGINT):
        try:
            signal.signal(sig, leaving)
        except (OSError, ValueError):
            pass

    # WHAT THE LAST GENERATION WAS SERVING, ASKED BEFORE ANYTHING SWEEPS IT.
    # `cmd_resume` calls `prune_dead_records`, which deletes exactly the records
    # that say which lessons were up when that machine went -- and it is right to
    # delete them. So they are read first: a handover that brings back only the
    # one course somebody last chose is a handover that loses the others.
    previous = previously_serving(cfg, host, only_dead=False)
    claim_elsewhere(cfg, host, say)

    tool_sync(cfg, quiet=True)          # may re-exec; see `tool_reexec`
    # `--force`, AND THAT IS A DECISION THAT WAS MADE THE OTHER WAY FIRST.
    #
    # The polite version left a board alone on any node still allocated to you,
    # so that an `salloc` with somebody mid-proof on it was never robbed. What
    # that actually bought was a lesson on a machine no watch loop was allowed
    # to touch: the board died on compute301 while the only watchdog was over
    # here under orders to keep its hands off, and the iPad went white with a
    # healthy chain running. One home node, and it is this one -- an `salloc` is
    # for coach coding and holds no lesson. `claim_elsewhere` asks the other node
    # to let go first, so the lesson is carried rather than duplicated.
    code = cmd_resume(cfg, ["--force"])
    say("resume returned %d" % code)
    for c in previous:
        if processes.board_is_running((board_record(c["root"]) or {}).get("pid"),
                                      c["root"]):
            continue
        code, out = board(c["root"], "start")
        say("%s was up on the machine that went, and is up here again: %s"
            % (c["dir"], last_line(out) if code else "started"))

    memo, repairs, checks = {}, [], 0
    loop_started, last_chain = time.time(), time.time()
    while not going["why"]:
        checks += 1
        try:
            # `claim`: this node is home, so a workspace serving anywhere else is
            # brought here rather than left to a machine nothing is watching.
            did = watch_once(cfg, host, memo, say, claim=True)
        except Exception as exc:                             # noqa: BLE001
            did = []
            say("the watch pass failed and the loop is carrying on: %r" % (exc,))
        repairs = (repairs + did)[-20:]
        supervise.note_watch(host=host, pid=os.getpid(), job=job,
                             started=loop_started, last=time.time(),
                             checks=checks, repairs=repairs)
        if supervise.stopped():
            say("tutor serve stop was called; standing down")
            return 0
        # THE CHAIN IS WATCHED TOO. A submission can be refused -- a queue limit,
        # a controller restart mid-sbatch -- and a chain that has quietly stopped
        # being a chain is the one failure of this arrangement nobody would see
        # until the board went dark a week later.
        if job and time.time() - last_chain > supervise.SUCCESSOR_EVERY:
            last_chain = time.time()
            nxt = ensure_successor(cfg, job, say)
            if nxt and nxt != successor:
                successor = nxt
                supervise.note_generation(successor=nxt)
        end = time.time() + supervise.POLL
        while time.time() < end and not going["why"]:
            time.sleep(0.5)

    say("%s is taking this node; handing over" % going["why"])
    left = supervise.HANDOVER_WARNING - 30 if going["why"] == "the walltime" else 20
    hand_over(cfg, host, say, deadline=max(10, left))
    return 0


def serve_status(cfg):
    """What the chain is doing, in the fewest lines that can be acted on."""
    rows = supervise.serve_jobs()
    rec = supervise.chain_record()
    if supervise.stopped():
        print("STOPPED -- `tutor serve stop` was called; nothing will be queued.")
        print("start it again with: tutor serve\n")
    if rows is None:
        print("squeue did not answer here, so what follows is the record only.")
    elif not rows:
        print("nothing of the chain is in the queue.")
        if rec.get("job"):
            print("the last generation recorded was job %s on %s."
                  % (rec["job"], rec.get("node") or "?"))
        print("start it with: tutor serve")
    for r in rows or []:
        if r["state"] == "RUNNING":
            print("running   job %-9s on %-11s %s left, %s"
                  % (r["id"], r["node"], r["left"], r["partition"]))
        else:
            print("%-9s job %-9s %s"
                  % (r["state"].lower(), r["id"],
                     "waiting on %s" % r["dependency"] if r["dependency"]
                     else "(no dependency -- it will start when it can)"))
    if rec.get("generation"):
        print("generation %s of this chain%s"
              % (rec["generation"],
                 ", the one before it was job %s" % rec["previous"]
                 if rec.get("previous") else ""))
    w = supervise.watch_record()
    if w.get("last"):
        ago = int(time.time() - w["last"])
        print("watched on %s, %d check(s), last %s"
              % (w.get("host") or "?", w.get("checks") or 0,
                 "%d s ago" % ago if ago < 300 else
                 "%s -- WHICH IS NOT RECENT" % time.strftime(
                     "%H:%M:%S", time.localtime(w["last"]))))
        for line in (w.get("repairs") or [])[-5:]:
            print("  repaired: %s" % line)
    return 0


def main(argv):
    cfg = load_config()
    args, flags = [], {"session": None, "agent": None, "no_agent": False,
                       "over": [], "respawn": False, "stance": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif a in ("--list", "-l"):
            # Grouped by family, because a flat list of nine is a list and the
            # families are what make it readable. The heading is printed when
            # it changes rather than looked up, so a new family needs no edit
            # here.
            seen = ""
            for c in courses(cfg):
                fam = c.get("family") or ""
                if fam != seen:
                    seen = fam
                    print("\n%s" % (fam or "workspaces"))
                print("  %-26s %-6s %s"
                      % (c.get("name") or c["dir"],
                         "do" if c.get("stance") == "do" else "", c["dir"]))
            print()
            return 0
        elif a == "--agents":
            # AS JSON, FOR THE BOARD, and out of this one table rather than a
            # second list somewhere the browser can read. The board offers the
            # choice of assistant for a sitting being opened, so it has to know
            # which ones this machine actually has -- and the registry is here,
            # because an agent entry is a command recipe. Asked once per board
            # process and cached; see `tutorboard/assistants.py`.
            if "--json" in argv:
                print(json.dumps({
                    "default": cfg["default_agent"],
                    # Who reads an image for an assistant that cannot. Named
                    # here rather than guessed at by the caller, because the
                    # registry is this table and a second one drifts.
                    "vision_agent": cfg.get("vision_agent") or None,
                    "agents": [
                        {"name": n,
                         "cmd": " ".join(spec.get("cmd", [])),
                         "missing": missing_command(spec.get("cmd")),
                         # AND THE SECOND WAY A RECIPE CANNOT RUN HERE. An
                         # executable that is absent is `missing`; a key that is
                         # absent is this. Both have to reach the browser,
                         # because a button that is drawn, tapped, and dies in a
                         # log file hands the person holding the iPad the one
                         # thing they can least act on. The key's NAME is the
                         # value, so the dimmed button's title can say which
                         # line to put in the file.
                         "unkeyed": keys.unkeyed(spec),
                         # And where that file is, once, so the whole of the
                         # setup instructions for a provider is on the glass.
                         "keys": keys.store(),
                         # Why this one may refuse to open, in the recipe's own
                         # words, so the board can say it before the tap rather
                         # than after.
                         "exclusive": spec.get("exclusive") or None,
                         "private": spec.get("private") or None,
                         # Where an image goes when the assistant running the
                         # sitting cannot see one. The whole route, because
                         # `board see` resolves it out of this rather than out
                         # of a second copy of the table -- an endpoint and a
                         # model name are not secrets, and the key is named
                         # rather than carried. See `tutorboard/seeing.py`.
                         "vision": spec.get("vision") or None,
                         # AND WHETHER IT COULD TAKE A TURN RIGHT NOW, which is
                         # a different question from whether it is installed and
                         # keyed. An allowance that has run out and a hostname
                         # this machine cannot open are both facts already on
                         # disk, and until they reached here the chooser drew a
                         # dark provider as a live button: `deepseek` undimmed
                         # and tappable while its TLS handshake was being reset
                         # at 57 ms. This is a file read, not a round trip --
                         # `agent_unavailable` is documented as reading those
                         # findings rather than measuring them, precisely so it
                         # can sit under a poll.
                         "unavailable": agent_unavailable(cfg, n),
                         "headless": bool(spec.get("headless")
                                          or spec.get("headless_first"))}
                        for n, spec in sorted(cfg["agents"].items())],
                }))
                return 0
            print("config: %s" % CONFIG)
            print("machine: %s (%s)" % (this_host(), machine.machine_shape()))
            print()
            for n, spec in sorted(cfg["agents"].items()):
                mark = "*" if n == cfg["default_agent"] else " "
                gone = missing_command(spec.get("cmd"))
                need = keys.unkeyed(spec)
                print(" %s %-10s %-28s %s"
                      % (mark, n, " ".join(spec.get("cmd", [])),
                         "not installed here" if gone
                         else ("needs %s in %s" % (need, keys.store())) if need
                         else ""))
            print("\n* is the default. Edit the config to add your own.")
            print("A provider is a recipe plus a key: one entry in `agents` "
                  "and one line in\n%s." % keys.store())
            return 0
        elif a == "--homework":
            flags["session"] = "homework"
        elif a == "--lecture":
            flags["session"] = "lecture"
        elif a in ("--review", "--test-review"):
            flags["session"] = "review"
        elif a in ("--walk", "--walkthrough"):
            flags["session"] = "walk"
        elif a == "--over":
            # Repeated, one per chapter: a chapter title may contain a comma.
            i += 1
            if i < len(argv):
                flags["over"].append(argv[i])
        elif a == "--stance":
            # This sitting's, not the repository's. `board open` is what writes
            # it, and it is cleared by the next one -- nothing here touches
            # tutorboard.json.
            i += 1
            want = (argv[i] if i < len(argv) else "").strip().lower()
            flags["stance"] = want if want in ("do", "teach") else None
            if flags["stance"] is None:
                print("--stance takes 'do' or 'teach'; ignored", file=sys.stderr)
        elif a == "--no-agent":
            flags["no_agent"] = True
        elif a == "--respawn":
            flags["respawn"] = True
        elif a == "--stop":
            pass
        elif a == "--agent":
            i += 1
            flags["agent"] = argv[i]
        else:
            args.append(a)
        i += 1

    if args and args[0] in ("restart", "restart-boards"):
        return cmd_restart(cfg, args[1:])

    # Spawned by `cmd_restart`, never typed. See `finish_restart`.
    if args and args[0] == "finish-restart":
        return finish_restart(cfg, args[1:])

    if args and args[0] == "where":
        return cmd_where(cfg, args[1:])

    # The allocation, rather than anything in it. `serve` is the chain that keeps
    # a machine under the board; `watch` is the loop that keeps the board up on
    # the machine, and is worth running by hand inside an `salloc` too.
    if args and args[0] == "serve":
        return cmd_serve(cfg, argv[argv.index("serve") + 1:])

    if args and args[0] == "watch":
        return cmd_watch(cfg, argv[argv.index("watch") + 1:])

    if args and args[0] == "down":
        return cmd_down(cfg, argv[argv.index("down") + 1:])

    if args and args[0] == "pull":
        # What the daily timer runs. `resume` does this too, on login; this is
        # the same routine with nothing else attached, so a timer never starts a
        # board or hops to an allocation.
        #
        # Two things are pulled and they are independent: somebody else's
        # repository, and the Tailscale in this home directory that no package
        # manager maintains. Both are attempted whatever the other one did --
        # an unreachable git remote is not a reason to leave the VPN client a
        # year behind -- and the exit code is the worse of the two.
        quiet = "--quiet" in argv
        moved = [pull_vendor(quiet=quiet),
                 tailscale.update_userspace(quiet=quiet, force=True)]
        return 0 if all(m is not False for m in moved) else 1

    if args and args[0] == "cost":
        return cmd_cost(cfg, args[1:])

    if args and args[0] == "resume":
        rest = argv[argv.index("resume") + 1:]
        # A login node holding an allocation does none of this itself. It hands
        # the whole command to the node, which is the machine that should be
        # pulling, re-execing and bouncing its own boards -- so the hop comes
        # before the pull, not after it.
        hopped = hop_to_allocation(cfg, rest)
        if hopped is not None:
            return hopped
        # Before anything, and before the course is caught up: this is what a
        # login hook runs, and on a compute node it is the only moment there is.
        tool_sync(cfg, quiet="--quiet" in rest)
        return cmd_resume(cfg, rest)

    if args and args[0] == "agent":
        return cmd_agent(cfg, argv[argv.index("agent") + 1:])

    if args and args[0] == "headless":
        rest = args[1:]
        if "--stop" in argv:
            return headless_stop(cfg, rest)
        found = courses(cfg)
        course = pick(found, rest[0]) if rest else choose(found)
        # Only when a person asked for this. `agent_start` spawns exactly this
        # command with `--respawn`, and it is spawned in a LOOP over the courses
        # on this machine -- so recording here handed the address to whichever
        # course the loop finished on, every login, every periodic pull, every
        # ship. That is the 28 August defect back through a different door, and
        # it is worse than the original: because the record is what `tutor
        # resume` reads to decide, the wrong course re-elected itself for ever,
        # and a tap on the right one in the hub was overwritten by the next tick.
        if not flags["respawn"]:
            remember_course(course)
        return headless(cfg, course, resolve_agent(cfg, course, flags["agent"]),
                        flags["session"])

    # Starting a session by hand is the other moment worth catching up in. It
    # comes before the course is chosen because a re-exec throws away everything
    # done so far, and doing that after a prompt would ask the question twice.
    tool_sync(cfg)

    found = courses(cfg)
    if not found:
        print("no courses under %s" % cfg["courses_dir"], file=sys.stderr)
        return 1
    course = pick(found, args[0]) if args else choose(found)
    remember_course(course)

    # --- catch up ----------------------------------------------------------
    print("\n%s" % (course.get("name") or course["dir"]))
    sync(course["root"])

    # --- the board ---------------------------------------------------------
    code, out = board(course["root"], "start")
    if code != 0:
        print(out.strip(), file=sys.stderr)
        return 1
    link(course["root"])
    if flags["session"] or flags["stance"]:
        # A sitting held over a scope NAMES ITSELF -- "Test review — Ch 07",
        # "Walkthrough — grade" -- and `board open` is what knows how. Passing a
        # title unasked is what put the word `session` in the title bar where
        # that name belonged, on every review ever started from here.
        title = " ".join(args[1:])
        extra = []
        for name in flags["over"]:
            extra += ["--over", name]
        if flags["stance"]:
            extra += ["--stance", flags["stance"]]
        board(course["root"], "open", course.get("name") or course["dir"],
              *([title] if title else []),
              "--" + (flags["session"] or "lecture"), *extra)
    _, net = board(course["root"], "net")
    urls = "\n".join("  " + l.strip() for l in net.splitlines()
                     if l.strip().startswith("http"))

    print("%s%s" % (course.get("name") or course["dir"],
                     " — stance: do" if course.get("stance") == "do" else ""))
    print(net.rstrip())

    live = os.path.join(course["root"], "live")
    os.makedirs(live, exist_ok=True)
    brief = BRIEF % {
        "name": course.get("name") or course["dir"],
        # What THIS SITTING runs under, which is the repository's answer unless
        # this invocation said otherwise. `board brief` says the same thing and
        # says which of the two it came from; this one line has to agree with it.
        "stance": flags["stance"] or course.get("stance") or "teach",
        "session": flags["session"] or "lecture",
        "urls": urls or "  (run: board net)",
        "handoff": handoff_clause(course["root"]),
    }
    with open(os.path.join(live, "BRIEF.md"), "w", encoding="utf-8") as fh:
        fh.write(brief)

    if flags["no_agent"]:
        return 0

    # --- the assistant -----------------------------------------------------
    # `interactive`: this is the one call site that opens a terminal session
    # rather than running headless turns.
    name = resolve_agent(cfg, course, flags["agent"], interactive=True)
    spec = cfg["agents"].get(name) if name else None
    if not spec:
        print("\nno assistant resolved for %s. Try: tutor --agents" % course["dir"],
              file=sys.stderr)
        return 1

    cmd = list(spec.get("cmd", []))
    opener = ("Read live/BRIEF.md, then run `board brief` and `board recap` and "
              "begin. Those two commands are the method, this course's unbendable "
              "rules, the handoff and the lesson; AI_INSTRUCTIONS.md and "
              "live/TEACHING.md are on disk for the rule that needs its detail, "
              "and reading either in full costs about ten thousand tokens you "
              "will then carry all session. The board is already running; do not "
              "start another.")
    if spec.get("prompt") == "argv":
        cmd.append(opener)
    else:
        print("\n  then tell it:  %s" % opener)

    print("\nstarting %s in %s\n" % (name, course["dir"]))
    # Say on the board that somebody is attached. `execvp` replaces this process
    # with the assistant, so this pid is about to BE the assistant -- which is
    # what makes the record checkable later without a heartbeat. An interactive
    # session is idle whenever the person is thinking, and a heartbeat would call
    # that dead; the process either exists or it does not.
    agent_state(live, host=this_host(), agent=name, pid=os.getpid(),
                mode="interactive", cmd=cmd[0], state="attached",
                started=time.time(), turns=0, last_error=None)
    try:
        os.chdir(course["root"])
        os.execvp(cmd[0], cmd)          # hand the terminal over entirely
    except OSError as exc:
        print("could not start %s: %s" % (name, exc), file=sys.stderr)
        print("check `tutor --agents`, or edit %s" % CONFIG, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
