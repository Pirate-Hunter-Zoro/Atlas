#!/usr/bin/env python3
"""
tutor -- the Mac's tutor daemons, and the cluster's relay.

    tutor headless galois       run the assistant as a daemon, driven from the iPad
    tutor headless --stop       stop it
    tutor agent status          which course has an assistant attached
    tutor agent start galois    attach one there
    tutor agent stop galois     ask it to write its handoff and go
    tutor agent only deepseek   run one assistant only on this machine (--off lifts it)
    tutor resume [course]       bring the board back on this Mac (a stub on the cluster)
    tutor cost [galois]         what the turns on this machine actually cost
    tutor cost --all            every course, one line each
    tutor doctor [agent] [--keep]  prove a built-in recipe against its live provider
    tutor pull                  move vendor/colibri forward and commit the pointer
    tutor pull --hear [--status]  pull every 20 s; hear the cluster's reports
    tutor relay ...             board/bin/relay: the cluster's relay (what scrontab runs)
    tutor restart [--tutors] [--stale] [--wait] [--since T]
                                restart every board here (and its tutor) on current code
    tutor watch                 keep the boards and tutors here up, and repair what dies
    tutor down [course]         stop serving here -- the boards, the tutors, the link
    tutor --list                the workspaces on disk
    tutor --agents [--json]     which assistants are configured

Boards run on the Mac. The cluster runs the relay and no model, ever.
Which assistant runs is configuration, not code; see `tutor --agents`.
"""

import json
import os
import shutil
import sys

TOOL = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, TOOL)
# A DAEMON STAMPS THE CODE IT RUNS BEFORE IT IMPORTS IT. See `tutorboard/stamp.py`.
from tutorboard import stamp
if sys.argv[1:2] == ["headless"]:
    stamp.mark_loaded()
from tutorboard import gitsync, jobs, keys, machine, processes, relay
from tutorboard.agents import doctor, recipes, usage
from tutorboard.runner import daemon, loop, watch

RELAY = os.path.join(TOOL, "bin", "relay")


def cmd_agent(cfg, args):
    """tutor agent status|start|ensure|stop|which [course]
       tutor agent only <name>|--off

    The board drives this when a course is opened or left. Each course keeps its
    own assistant: they are cheap while idle, and one that survives being left
    still has the lesson in its head when you come back.
    """
    sub = args[0] if args else "status"
    rest = [a for a in args[1:] if not a.startswith("--")]
    if sub == "only":
        return agent_only(cfg, args[1:])
    found = daemon.courses(cfg)

    if sub == "status":
        for c in found:
            st = daemon.agent_live(c["root"])
            print("  %-26s %s" % (c.get("name") or c["dir"],
                                  ("%s (%s, %d turn(s))"
                                   % (st.get("agent"), st.get("state"), st.get("turns", 0)))
                                  if st else "-"))
        return 0

    if not rest:
        print("which course? try: tutor agent %s <name>" % sub, file=sys.stderr)
        return 1
    course = daemon.pick(found, rest[0])

    if sub == "stop":
        code, msg = daemon.agent_stop(course, wait="--wait" in args)
        print(msg, file=sys.stderr if code else sys.stdout)
        return code

    if sub == "which":
        # WHICH ASSISTANT THIS WORKSPACE RUNS WHEN NOBODY NAMES ONE.
        #
        # `resolve_agent` is the one place the precedence lives, and a dispatch
        # has to know the answer: an assistant it STARTS for a mission is the
        # mission's and is given back when the mission ends, while the
        # workspace's own stays. A second copy of four layers in the server is
        # a second copy that drifts. Nothing but the name on stdout, and an
        # empty line where the configuration resolves to nothing, because the
        # board reads this rather than a person.
        print(recipes.resolve_agent(cfg, course, say=lambda m: None) or "")
        return 0

    if sub == "ensure":
        # `start` that says nothing when there was nothing to do: a line for a
        # tutor that is fine is noise in the one log where a real failure has
        # to be findable. It speaks when it starts something, and when it
        # cannot.
        if daemon.agent_live(course["root"]):
            return 0
        name = recipes.resolve_agent(cfg, course, daemon.flag(args, "--agent"))
        code, msg = daemon.agent_start(cfg, course, name)
        print(msg, file=sys.stderr if code else sys.stdout)
        return code

    if sub == "start":
        # An assistant per course, not one per machine. Switching used to stop
        # whatever was listening elsewhere, so coming back to a course meant a
        # cold agent that had to re-read the contract, the method and the lesson
        # before it could write a word. A listening daemon is blocked on `board
        # wait` and costs nothing while nobody is asking it anything, so there is
        # no reason to make attention exclusive. They still write their handoff
        # when they are actually stopped.
        name = recipes.resolve_agent(cfg, course, daemon.flag(args, "--agent"))
        # Somebody named this course -- on the command line, or by tapping it in
        # the hub, which comes through here. That is a decision and it moves the
        # address; `agent_start` does not record one, because its other callers
        # are timers. `--respawn` is the same word used there and means the same
        # thing: a machine asked for this daemon, so it starts one without
        # moving the address. A dispatch into a workspace nobody is looking at
        # passes it, because the person is still looking at the board they
        # tapped on.
        if "--respawn" not in args:
            daemon.remember_course(course)
        code, msg = daemon.agent_start(cfg, course, name)
        print(msg, file=sys.stderr if code else sys.stdout)
        return code

    print("unknown: tutor agent %s" % sub, file=sys.stderr)
    return 1


def agent_only(cfg, args):
    """`tutor agent only <name>` sets the switch; `--off` lifts it.

    One key, `only_agent`, in this machine's config, written the way the front
    door writes `default_agent`: the file as it is on disk with one key
    changed, atomically, because every `tutor` on the machine reads it. A name
    the switch could not honour is refused before it is written -- a recipe
    that is not here, the fenced reader, or one that cannot take a turn today
    -- because a switch naming nothing runnable leaves the machine with no
    tutor at all. A running daemon picks it up on its next turn.
    """
    off = "--off" in args
    named = [a for a in args if not a.startswith("--")]
    if off == bool(named):
        print("usage: tutor agent only <name>   or   tutor agent only --off",
              file=sys.stderr)
        return 2
    if named:
        name = named[0]
        spec = (cfg.get("agents") or {}).get(name)
        bare = dict(cfg, only_agent=None)
        why = (("there is no recipe called '%s'; try: tutor --agents" % name)
               if not spec else
               ("'%s' is the fenced reader, and the switch is about hosted "
                "providers" % name) if spec.get("private") else
               recipes.agent_unavailable(bare, name))
        if why:
            print("tutor agent only: %s" % why, file=sys.stderr)
            return 1
    try:
        with open(recipes.CONFIG, "r", encoding="utf-8") as fh:
            user = json.load(fh) or {}
    except FileNotFoundError:
        user = {}
    except (OSError, ValueError) as exc:
        print("tutor agent only: cannot read %s (%s)" % (recipes.CONFIG, exc),
              file=sys.stderr)
        return 1
    if off:
        user.pop("only_agent", None)
    else:
        user["only_agent"] = named[0]
    os.makedirs(os.path.dirname(recipes.CONFIG), exist_ok=True)
    tmp = recipes.CONFIG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(user, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, recipes.CONFIG)
    if off:
        print("only_agent is off: every installed assistant is available again")
    else:
        print("this machine is running %s only (\"only_agent\": \"%s\" in %s)"
              % (recipes.agent_label(cfg, named[0]), named[0], recipes.CONFIG))
    return 0


def cmd_resume(cfg, args):
    """Bring the board back on this Mac. A stub on the cluster.

    Boards run on the Mac and nowhere else: the cluster runs the relay and no
    model, ever. On a Slurm host this says so and exits 0, so an old login hook
    still in somebody's `.bashrc` costs one line rather than a board.

    On the Mac it is deliberately dull: it moves `vendor/colibri` forward,
    restarts any board here whose process died, catches the chosen course up,
    starts its board if it is down and attaches its tutor unless `--no-agent`.
    """
    quiet = "--quiet" in args
    rest = [a for a in args if not a.startswith("-")]

    def say(msg):
        if not quiet:
            print(msg)

    # Slurm is `sbatch` or `squeue` on the path; `TUTOR_SLURM` decides where
    # it is set, as it does for `jobs.has_slurm`.
    if jobs.has_slurm() or (os.environ.get("TUTOR_SLURM", "").strip() != "0"
                            and shutil.which("squeue")):
        print("tutor resume: boards run on the Mac; nothing to do on the cluster")
        return 0

    host = recipes.this_host()
    relay.pull_vendor(quiet=quiet)
    found = daemon.courses(cfg)

    # A board that DIED is not a board that was stopped. `board stop` removes
    # the record; a crash, an OOM or a reboot leaves one behind naming a pid
    # that is gone. Only where a record exists and names this machine, so a
    # course nobody has ever opened is not brought up.
    revived = []
    for c in found:
        rec = daemon.board_record(c["root"]) or {}
        if not rec or rec.get("node") != host:
            continue
        if processes.board_is_running(rec.get("pid"), c["root"]):
            continue
        code, _ = daemon.board(c["root"], "start")
        if code == 0:
            revived.append(c["dir"])
    if revived:
        say("restarted a board that had died: %s" % ", ".join(revived))

    course = daemon.pick(found, rest[0]) if rest else daemon.last_board(cfg)
    if not course:
        say("no board has ever run in %s" % cfg["courses_dir"])
        return 0
    if rest:
        daemon.remember_course(course)        # named on the command line: a decision

    root = course["root"]
    gitsync.sync(root, quiet=True)
    info = daemon.board_record(root) or {}
    if not (info.get("node") == host
            and processes.board_is_running(info.get("pid"), root)):
        code, out = daemon.board(root, "start")
        if code != 0:
            say(out.strip() or "could not start the board")
            return 1
    started = ""
    if "--no-agent" not in args:
        if daemon.agent_live(root):
            started = ", tutor already attached"
        else:
            name = recipes.resolve_agent(cfg, course, daemon.flag(args, "--agent"))
            code, msg = daemon.agent_start(cfg, course, name)
            started = (", %s attached" % name) if code == 0 \
                else (", no tutor (%s)" % msg)
    say("%s is up here%s" % (course["dir"], started))
    return 0


def cmd_cost(cfg, args):
    """What the turns on this machine actually cost, per turn and in total.

        tutor cost              the course an assistant is attached to
        tutor cost galois       a course by name
        tutor cost --all        every course on this machine, one line each
        tutor cost galois --turns   every turn, oldest first

    Read straight out of `live/cost.jsonl`, which every headless turn appends
    one line to. The report is `usage.cost_report` and `usage.cost_all`.
    """
    found = daemon.courses(cfg)
    rest = [a for a in args if not a.startswith("--")]
    if "--all" in args:
        return usage.cost_all(cfg, found)
    if rest and os.path.isfile(os.path.join(rest[0], "live", usage.COST_LOG)):
        # A directory that is not a course, such as `tutor doctor --keep`'s.
        course = {"dir": os.path.basename(os.path.abspath(rest[0])),
                  "root": os.path.abspath(rest[0])}
    elif rest:
        course = daemon.pick(found, rest[0])
    else:
        # The course an assistant is actually attached to, or the only one that
        # has ever billed anything. Asking "which course?" when there is exactly
        # one answer is the sort of question a tool should not need to ask.
        course = next((c for c in found if daemon.agent_live(c["root"])), None)
        if not course:
            billed = [c for c in found if usage.read_costs(c["root"])]
            course = billed[0] if len(billed) == 1 else None
    if not course:
        print("which course? try: tutor cost --all", file=sys.stderr)
        return 1
    return usage.cost_report(cfg, course, per_turn="--turns" in args)


def cmd_relay(args):
    """`tutor relay ...` is `board/bin/relay ...`: the relay's own entry."""
    sys.stdout.flush()
    sys.stderr.flush()
    os.execv(sys.executable, [sys.executable, RELAY] + list(args))


def main(argv):
    cfg = recipes.load_config()
    args, flags = [], {"session": None, "agent": None, "respawn": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif a in ("--list", "-l"):
            # Grouped by family, because a flat list of nine is a list and the
            # families are what make it readable. The heading is printed when
            # it changes rather than looked up, so a new family needs no edit
            # here.
            seen = ""
            for c in daemon.courses(cfg):
                fam = c.get("family") or ""
                if fam != seen:
                    seen = fam
                    print("\n%s" % (fam or "workspaces"))
                print("  %-26s %-6s %s"
                      % (c.get("name") or c["dir"],
                         "do" if c.get("stance") == "do" else "", c["dir"]))
            print()
            return 0
        elif a == "--agents":
            shadows = recipes.config_shadows()
            # AS JSON, FOR THE BOARD, and out of this one table rather than a
            # second list somewhere the browser can read. The board offers the
            # choice of assistant for a sitting being opened, so it has to know
            # which ones this machine actually has -- and the registry is here,
            # because an agent entry is a command recipe. Asked once per board
            # process and cached; see `tutorboard/assistants.py`.
            if "--json" in argv:
                print(json.dumps({
                    "default": cfg["default_agent"],
                    # What a sitting that names nobody, in a workspace that
                    # names nobody for its kind, gets ON THIS MACHINE, as in
                    # `resolve_agent`. The thread sheet draws it.
                    "machine": recipes.resolve_agent(cfg, None, say=lambda m: None),
                    # Who reads an image for an assistant that cannot. Named
                    # here rather than guessed at by the caller, because the
                    # registry is this table and a second one drifts.
                    "vision_agent": cfg.get("vision_agent") or None,
                    # THE SWITCH, so the strip can say why every other button
                    # is grey: the recipe this machine runs only, its label,
                    # and the sentence each barred recipe carries. Null when
                    # it is off. See `only_bars`.
                    "only": ({"agent": recipes.only_agent(cfg),
                              "label": recipes.agent_label(cfg, recipes.only_agent(cfg)),
                              "why": "this machine is running %s only"
                                     % recipes.agent_label(cfg, recipes.only_agent(cfg)),
                              "config": recipes.CONFIG}
                             if recipes.only_agent(cfg) else None),
                    "agents": [
                        {"name": n,
                         "cmd": " ".join(spec.get("cmd", [])),
                         "missing": recipes.missing_command(spec.get("cmd")),
                         # AND THE SECOND WAY A RECIPE CANNOT RUN HERE. An
                         # executable that is absent is `missing`; a key that is
                         # absent is this. Both have to reach the browser,
                         # because a button that is drawn, tapped, and dies in a
                         # log file hands the person holding the iPad the one
                         # thing they can least act on. The key's NAME is the
                         # value, so the dimmed button's title can say which
                         # line to put in the file.
                         "unkeyed": keys.unkeyed(spec),
                         # And where that file is, once, so the whole of the
                         # setup instructions for a provider is on the glass.
                         "keys": keys.store(),
                         # Why this one may refuse to open, in the recipe's own
                         # words, so the board can say it before the tap rather
                         # than after.
                         "exclusive": spec.get("exclusive") or None,
                         "private": spec.get("private") or None,
                         # Where an image goes when the assistant running the
                         # sitting cannot see one. The whole route, because
                         # `board see` resolves it out of this rather than out
                         # of a second copy of the table -- an endpoint and a
                         # model name are not secrets, and the key is named
                         # rather than carried. See `tutorboard/seeing.py`.
                         "vision": spec.get("vision") or None,
                         # AND WHETHER IT COULD TAKE A TURN RIGHT NOW, which is
                         # a different question from whether it is installed and
                         # keyed. An allowance that has run out and a hostname
                         # this machine cannot open are both facts already on
                         # disk, and until they reached here the chooser drew a
                         # dark provider as a live button: `deepseek` undimmed
                         # and tappable while its TLS handshake was being reset
                         # at 57 ms. This is a file read, not a round trip --
                         # `agent_unavailable` is documented as reading those
                         # findings rather than measuring them, precisely so it
                         # can sit under a poll.
                         "unavailable": recipes.agent_unavailable(cfg, n),
                         # And whether that is the switch rather than a fact
                         # about the recipe: a barred button is not tappable
                         # at all, where a stood-down one still is.
                         "barred": recipes.only_bars(cfg, n),
                         # AND WHICH FIELDS OF IT THIS MACHINE'S CONFIG IS
                         # HOLDING DOWN. A merged field is frozen at the day
                         # somebody wrote it, so a fix shipped to the recipe
                         # lands everywhere except here -- and nothing said so
                         # until this. See `config_shadows`.
                         "shadowed": shadows.get(n) or None,
                         "headless": bool(spec.get("headless")
                                          or spec.get("headless_first"))}
                        for n, spec in sorted(cfg["agents"].items())],
                }))
                return 0
            print("config: %s" % recipes.CONFIG)
            print("machine: %s (%s)" % (recipes.this_host(), machine.machine_shape()))
            print()
            if recipes.only_agent(cfg):
                print("only: this machine is running %s only (\"only_agent\": "
                      "\"%s\"; tutor agent only --off lifts it)\n"
                      % (recipes.agent_label(cfg, recipes.only_agent(cfg)), recipes.only_agent(cfg)))
            for n, spec in sorted(cfg["agents"].items()):
                mark = "*" if n == cfg["default_agent"] else " "
                gone = recipes.missing_command(spec.get("cmd"))
                need = keys.unkeyed(spec)
                print(" %s %-10s %-28s %s"
                      % (mark, n, " ".join(spec.get("cmd", [])),
                         "off: %s" % recipes.only_bars(cfg, n) if recipes.only_bars(cfg, n)
                         else "not installed here" if gone
                         else ("needs %s in %s" % (need, keys.store())) if need
                         else ""))
                if shadows.get(n):
                    print("   %-10s config overrides: %s  (frozen at whatever "
                          "the built-in recipe said that day)"
                          % ("", ", ".join(shadows[n])))
            print("\n* is the default. Edit the config to add your own.")
            print("A provider is a recipe plus a key: one entry in `agents` "
                  "and one line in\n%s." % keys.store())
            return 0
        elif a == "--homework":
            flags["session"] = "homework"
        elif a == "--lecture":
            flags["session"] = "lecture"
        elif a in ("--review", "--test-review"):
            flags["session"] = "review"
        elif a in ("--walk", "--walkthrough"):
            flags["session"] = "walk"
        elif a == "--respawn":
            flags["respawn"] = True
        elif a == "--stop":
            pass
        elif a == "--agent":
            i += 1
            flags["agent"] = argv[i]
        else:
            args.append(a)
        i += 1

    if args and args[0] in ("restart", "restart-boards"):
        return watch.cmd_restart(cfg, args[1:])

    # Spawned by `cmd_restart`, never typed. See `finish_restart`.
    if args and args[0] == "finish-restart":
        return watch.finish_restart(cfg, args[1:])

    if args and args[0] == "relay":
        return cmd_relay(argv[argv.index("relay") + 1:])

    if args and args[0] == "watch":
        return watch.cmd_watch(cfg, argv[argv.index("watch") + 1:])

    if args and args[0] == "down":
        return watch.cmd_down(cfg, argv[argv.index("down") + 1:])

    if args and args[0] == "pull":
        # What the daily timer runs. `resume` does this too, on login; this is
        # the same routine with nothing else attached, so a timer never starts a
        # board or hops to an allocation.
        quiet = "--quiet" in argv
        if "--hear" in argv:
            # The relay's half, which the timer runs every time it fires. On a
            # machine with Slurm it does nothing: the relay pulls there.
            pulled, interval, heard = gitsync.hear_pass(
                force="--force" in argv, quiet=quiet)
            for rec in heard:
                print("heard %s on %s: %s" % (rec.get("request"),
                                              rec.get("workspace"),
                                              str(rec.get("state")).lower()))
            if "--status" in argv:
                if pulled is None:
                    print("this machine has Slurm; the relay pulls here")
                else:
                    print("pulls every %ds" % interval)
            return 0
        return 0 if relay.pull_vendor(quiet=quiet) is not False else 1

    if args and args[0] == "cost":
        return cmd_cost(cfg, args[1:])

    if args and args[0] == "doctor":
        return doctor.cmd_doctor(cfg, argv[argv.index("doctor") + 1:])

    if args and args[0] == "resume":
        return cmd_resume(cfg, argv[argv.index("resume") + 1:])

    if args and args[0] == "agent":
        return cmd_agent(cfg, argv[argv.index("agent") + 1:])

    if args and args[0] == "headless":
        rest = args[1:]
        if "--stop" in argv:
            return daemon.headless_stop(cfg, rest)
        if not rest:
            print("which course? try: tutor headless <name>", file=sys.stderr)
            return 1
        course = daemon.pick(daemon.courses(cfg), rest[0])
        # Only when a person asked for this. `agent_start` spawns exactly this
        # command with `--respawn`, and it is spawned in a LOOP over the courses
        # on this machine -- so recording here handed the address to whichever
        # course the loop finished on, every login, every periodic pull, every
        # ship. That is the 28 August defect back through a different door, and
        # it is worse than the original: because the record is what `tutor
        # resume` reads to decide, the wrong course re-elected itself for ever,
        # and a tap on the right one in the hub was overwritten by the next tick.
        if not flags["respawn"]:
            daemon.remember_course(course)
        return loop.headless(
            cfg, course, recipes.resolve_agent(cfg, course, flags["agent"]),
            flags["session"])

    # There is no interactive launch: a session is started from the iPad.
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
