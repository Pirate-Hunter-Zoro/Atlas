#!/usr/bin/env python3
"""
tutor -- start a tutoring session.

    tutor                       pick a course from what is on disk
    tutor galois                match a course by name
    tutor galois --homework     and open a homework sitting
    tutor galois --review --over ch01 --over ch07
                                or a test review over the chapters named
    tutor psych-asr --walk --over psych_asr.evaluate.grade.grade
                                or a walkthrough of machinery already written
    tutor psych-asr --stance do  who writes the code, for this sitting only
    tutor trd --agent opencode  with a particular assistant
    tutor galois --no-agent     just bring the board up
    tutor resume                take the board over on this machine (for a login hook)
    tutor headless galois       run the assistant as a daemon, driven from the iPad
    tutor headless --stop       stop it
    tutor agent status          which course has an assistant attached
    tutor agent start galois    attach one there, detaching whatever was elsewhere
    tutor agent stop galois     ask it to write its handoff and go
    tutor cost [galois]         what the turns on this machine actually cost
    tutor cost --all            every course, one line each
    tutor pull                  move vendor/colibri forward and commit the pointer
    tutor where                 what is up, on this machine and on the tailnet
    tutor restart [--tutors]    restart every board here (and its tutor) on current code
    tutor watch                 keep the boards and tutors here up, and repair what dies
    tutor down [course]         stop serving here -- the boards, the tutors, the link
    tutor serve                 serve from a Slurm job that renews its own allocation
    tutor serve status          which generation is up, where, and what it repaired
    tutor serve stop            end that chain

One command, from anywhere. It finds the course, brings its board up, opens a
session, and launches whichever assistant you use -- already pointed at the
repository's own contract, with the board already running.

The alternative it replaces is: remember which directory, cd there, start an
agent, and then tell the agent to start the board. That last step in particular
is ceremony the person should never have to perform, and forgetting it produces
a session where the assistant is talking into a terminal nobody is reading.

Which assistant runs is configuration, not code. Nothing here knows or cares
which one it is; see `tutor --agents`.
"""

import json
import os
import re
import shlex
import shutil
import subprocess
import sys

TOOL = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, TOOL)
from tutorboard import (atlas, choice, handoff, keys, limits, machine, missions,
                        paths, processes, seeing, supervise, worktree)
from tutorboard.course import config
from tutorboard.net import egress, tailscale

BOARD = os.path.join(TOOL, "bin", "board")
CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.join(os.path.expanduser("~"), ".config")),
    "tutor-board")
CONFIG = os.path.join(CONFIG_DIR, "config.json")

DEFAULT_CONFIG = {
    # The repository root. It was `dirname(TOOL)` because a course was a
    # directory sitting next to the board; it is now the directory holding
    # `atlas.json`, one level above the tool, and `atlas.root()` is what walks
    # to it. The key keeps its name so a config file already on a machine still
    # reads -- what it MEANS is the same sentence about a different shape.
    "courses_dir": atlas.root(),
    "default_agent": "claude",
    "agents": {
        # `prompt: argv`  -- the brief is passed as a final argument
        # `prompt: none`  -- the agent is launched bare and told where to read
        #
        # `headless` is how to run one turn without a terminal: a command that
        # takes a prompt, does the work, and exits. {prompt} is substituted.
        # Continuity across turns is the agent's own business -- most keep a
        # session and offer a flag to resume it, which is what belongs here.
        # The default. Claude Code is a general coding agent with the course
        # repository already in front of it, which is most of a tutor: it reads
        # the slate PNG itself rather than through a transcription model, writes
        # the card, and edits the course's own .tex when a homework sitting needs
        #
        # What it is allowed to do headless is NOT set here, and is not set by
        # this tool at all any more. It is `ai-config/workspaces/tutors.allow`,
        # folded into the assistant's own settings by that repository's
        # installer. Repeating a grant as a flag on this command would be a
        # second source of truth for one policy, and the two would drift the
        # first time either moved.
        "claude": {
            "cmd": ["claude"], "prompt": "argv",
            # `headless_first` opens the session; `headless` continues it, so the
            # agent is not re-reading the whole contract on every single turn.
            "headless_first": ["claude", "-p", "{prompt}"],
            "headless": ["claude", "-p", "{prompt}", "--continue"],
            # How this agent can be asked what a turn cost, and what to add to
            # the command to make it say. Nobody reads stdout, so the JSON is
            # not cosmetic: it is the only measurement of the thing every
            # decision in this file is about -- see `read_turn_usage`.
            #
            # It is TWO fields and it is appended rather than written into the
            # recipes above, deliberately. A machine's config file overrides
            # `agents` one level deep, and this machine's config holds a
            # verbatim copy of the claude recipe from an older version of this
            # tool: had the flag gone in the argv, every machine carrying such a
            # copy would silently stop reporting, which is the one failure a
            # measurement must not have.
            "usage": "claude-json",
            "usage_args": ["--output-format", "json"],
            # Anything else this machine wants on every headless turn. Empty,
            # and deliberately so, but this is where the one remaining lever
            # goes if it is ever wanted.
            #
            # After a turn stopped carrying the lesson, OUTPUT became the
            # largest single line on the bill: measured at 9.5k output tokens a
            # turn, which at $25 per million is $0.24 of a $0.37 turn -- and a
            # card is a few hundred words, so most of that is thinking and tool
            # arguments. `["--effort", "medium"]` here cuts it.
            #
            # `["--model", "opus"]` is the other thing that goes here. This
            # machine's Claude Code settings say `opus[1m]`, and the largest
            # single request across every measured Galois session was 189,588
            # tokens -- five per cent short of the 200k line above which a long
            # context is charged and weighted differently. Twelve cards was
            # under it; fourteen would not have been. A turn now holds 22k to
            # 44k, so the 1M window buys nothing.
            #
            # It is left empty because both of those are teaching decisions as
            # much as cost decisions, and this file does not get to make them.
            # The rule in AI_INSTRUCTIONS.md cuts both ways: teaching quality
            # comes first, and a change to it is weighed as a change to what it
            # costs.
            "extra_args": [],
            # AND THE EYES EVERY OTHER RECIPE BORROWS, WHICH ARE A COMMAND
            # RATHER THAN AN ENDPOINT. This model can already see, so `board
            # see` for an assistant that cannot is one more run of the binary
            # that is installed here anyway: no second endpoint, no second key,
            # and nothing to keep in step with a provider's model names. The
            # command is run in the image's own directory and asked for the file
            # by name, because a headless turn has nobody to approve a read
            # outside its working directory. See `tutorboard/seeing.py`.
            #
            # "THE BINARY THAT IS INSTALLED HERE ANYWAY" IS THE PREMISE, AND A
            # RECIPE CAN BREAK IT. `board see` is run by the tutor's own Bash
            # tool, inside a turn whose environment the running recipe wrote --
            # so in a DeepSeek sitting `ANTHROPIC_BASE_URL` is inherited and
            # this command is not Claude at all. Measured: 14.4 s and a correct
            # transcription in a clean environment, 180 s and a refusal with
            # those four variables exported. `seeing.ROUTING` is the scrub that
            # makes the premise true again, and `env` here is how a recipe
            # overrides it -- a value of None unsets.
            "vision": {"cmd": ["claude", "-p", "{prompt}"],
                       "model": "whatever this machine's Claude Code settings "
                                "select",
                       "sighted": True},
        },
        # THE SAME BINARY, POINTED SOMEWHERE ELSE, AND FOUR VARIABLES DO IT.
        # DeepSeek serves an Anthropic-format `/messages` endpoint, so the
        # agent that runs it is the `claude` executable already installed here
        # with the environment below -- and every part of this tool that knows
        # how to drive Claude Code goes on working unchanged:
        # `headless_first` / `headless`, the `--continue` resume, the
        # `--output-format json` accounting in `read_turn_usage`, the timeouts,
        # and the `ai-config` pre-tool hook, which fences PHI by intercepting
        # the binary's tool calls and therefore fences this provider too, for
        # free. Codex has no such hook; this one inherits the fence that already
        # exists.
        #
        # What it is NOT, so nobody builds it twice. Not an entry driven through
        # `opencode`: that is a second agent's config file, a second credential
        # store and a second thing to keep in step, for a provider the binary we
        # already run reaches directly. Not a descriptor in `ai-config` either:
        # that layer keys on the ASSISTANT and its filenames, and the assistant
        # here is Claude Code, so a second descriptor for one binary is two
        # installers writing the same symlink.
        #
        # AND THE ONE THING THE VARIABLES CANNOT SUPPLY IS A ROUTE. The
        # variables are client-side and correct; a turn still only leaves this
        # machine if the network carries it, and from here the TLS handshake to
        # `api.deepseek.com` is reset on the ClientHello. The same address under
        # its CloudFront name completes, so the drop keys on the HOSTNAME, and
        # no environment variable reaches that -- the ask is a firewall
        # exception, not a line of Python. What it costs while the name is
        # filtered: a turn spends about three minutes retrying and dies as
        # `API Error: Connection dropped (ECONNRESET)`. `egress_probe` is what
        # makes that one stood-down turn rather than every turn, by name. The
        # measurement, the controls that place the device, and the exception to
        # ask for are in `projects/libr-local-llm/docs/deepseek-egress.md`.
        "deepseek": {
            "cmd": ["claude"], "prompt": "argv",
            "headless_first": ["claude", "-p", "{prompt}"],
            "headless": ["claude", "-p", "{prompt}", "--continue"],
            "usage": "claude-json",
            "usage_args": ["--output-format", "json"],
            "extra_args": [],
            "needs_key": "DEEPSEEK_API_KEY",
            # THE HOST A TURN ACTUALLY OPENS, so a failure can be attributed to
            # it. A recipe pointed at a third party talks to a host the
            # machine-wide `egress_probe` never asks about, and a network that
            # filters one provider's hostname answers for every other -- so
            # without this a turn that died in the TLS handshake is reported as
            # a healthy network and `exit 1`. Asked only of a turn that has
            # already failed; see `agent_probe_urls` and
            # `egress.mark_unreachable`.
            "egress_probe": ["https://api.deepseek.com/anthropic/v1/messages"],
            # `[claude-code:unrecognized_model]` ON STDERR IS COSMETIC, and it
            # prints on every turn here. The binary emits it for any id outside
            # Anthropic's own lineup and then dispatches the request anyway --
            # its one effect is that fast mode is off. It is not a refusal: a
            # turn that fails after printing it failed of something else, and
            # that something is named in the `result` field of the JSON result
            # object; see `result_object_error`.
            #
            # `ANTHROPIC_CUSTOM_MODEL_OPTION` and its `_NAME` / `_DESCRIPTION` /
            # `_SUPPORTED_CAPABILITIES` siblings do not belong here: they add an
            # entry to the interactive `/model` picker, which a `-p` turn never
            # opens. `--model` on the command line is the same selection the
            # variable below already makes. Measured, all three routes put the
            # identical request on the wire.
            #
            # PIN THE MODEL OR LOSE THE HANDWRITING. Unpinned, the endpoint maps
            # by NAME: an id starting `claude-opus` lands on `deepseek-v4-pro`,
            # which is text-only and SUBSTITUTES A PLACEHOLDER FOR AN IMAGE
            # BLOCK rather than failing. The literal text is
            # `[Unsupported Image]`, returned with HTTP 200 and a normal result
            # object, so a tutor handed a slate PNG answers confidently about
            # nothing and no exit code says so. Measured elsewhere, the same 71 KB JPEG both
            # times: 403 input tokens on `deepseek-flash` against 102 on
            # `deepseek-v4-pro`, which is the image not arriving. That string in
            # a reply is the detector, and `seeing.blind_answer` is where it is
            # read.
            #
            # EVERY SLOT, NOT THE TWO OBVIOUS ONES. This machine's Claude Code
            # settings say `opus[1m]`, which is exactly the name that lands on
            # the text-only model -- but the binary does not resolve one id per
            # turn. It resolves the `opus`, `sonnet` and `haiku` ALIASES through
            # `ANTHROPIC_DEFAULT_*_MODEL`, spawns a Task-tool subagent on
            # `CLAUDE_CODE_SUBAGENT_MODEL`, and picks its own cheap calls off
            # the small one. Any slot left unset is a request that goes out
            # under a `claude-*` name and comes back from a model that cannot
            # see, in the middle of a turn that was reading handwriting.
            # `ANTHROPIC_SMALL_FAST_MODEL` is marked deprecated in the client's
            # own environment reference and `ANTHROPIC_DEFAULT_HAIKU_MODEL` is
            # its replacement: both are set, because which one the installed
            # binary reads is not a thing this file gets to assume.
            #
            # AND THE BARE ID RATHER THAN `deepseek-flash[1m]`, WHICH IS THE ONE
            # OPEN QUESTION HERE. The `[1m]` suffix is how the client selects a
            # long-context variant of a name it knows, and the model's own window
            # is a million tokens -- so an unrecognised id may well be sized off
            # the client's default table instead. Third parties driving this
            # endpoint write the suffix and report working turns; DeepSeek's own
            # integration guide writes the bare name. Neither settles it, and it
            # cannot be settled from here: the only test is a live turn, and the
            # hostname is filtered. So the bare id, which is the spelling the
            # provider documents. If the suffix is tried once the firewall
            # opens and the first turn comes back 400 naming the model, that is
            # the answer and it goes straight back. The small, haiku and
            # subagent slots stay bare either way -- those calls are short and
            # do not want the long-context weighting.
            "env": {
                "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
                "ANTHROPIC_AUTH_TOKEN": "{DEEPSEEK_API_KEY}",
                "ANTHROPIC_MODEL": "deepseek-flash",
                "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-flash",
                "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-flash",
                "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-flash",
                "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-flash",
                "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-flash",
            },
            # WHY `deepseek-flash` AND NOT THE PRO, and THE SAME ID DOES BOTH
            # JOBS. It serves DeepSeek-V4.1-Flash: a multimodal model that
            # natively processes images and text, 1M-token context, DocVQA 95.6
            # -- which is the document-reading benchmark a photograph of a slate
            # is scored by -- and ahead of `deepseek-v4-pro` on the coding and
            # mathematics benchmarks as well as cheaper. The API serves exactly
            # two ids: this one and `deepseek-v4-pro`, which is text-only.
            # `deepseek-v4-flash` and `deepseek-v4-flash-vision-exp` are
            # deprecated aliases onto this one. There is no separate eyes model
            # to reach for: DeepSeek-OCR-2 reads documents better and is
            # published as open weights, not as an id this endpoint accepts, so
            # it is a self-hosting project rather than a one-string change here.
            #
            # WHAT CAN BE RE-CHECKED FROM HERE, AND WHAT CANNOT, because this is
            # the field that goes stale and the obvious way to check it is shut.
            # `api.deepseek.com` and `api-docs.deepseek.com` are both filtered,
            # so `GET https://api.deepseek.com/models` dies in the same
            # handshake as a turn. `huggingface.co` and `github.com` are NOT,
            # and the provider's own answer lives there: the model card at
            # `deepseek-ai/DeepSeek-V4.1-Flash` carries the `image-text-to-text`
            # tag and the 1M window, and `github.com/deepseek-ai/deepseek-recipe`
            # is the protocol adapter this endpoint is built from, with
            # `deepseek-flash` as the id throughout. Re-check against those two
            # rather than waiting for the firewall.
            #
            # Where `board see` sends an image when the assistant running the
            # sitting has no eyes. The OpenAI-format endpoint rather than the
            # Anthropic one, because that is a single request rather than an
            # agent loop. It accepts an `image_url` part whose url is a base64
            # data URL, in four media types and no others -- jpeg, png, gif,
            # webp -- which is `seeing.IMAGES` exactly, so a fifth extension
            # added there is a 400 from here.
            "vision": {
                "endpoint": "https://api.deepseek.com/v1/chat/completions",
                "model": "deepseek-flash",
                "needs_key": "DEEPSEEK_API_KEY",
                # THE ROUTE SAYS WHETHER ITS MODEL HAS EYES, because the one
                # failure this path must not have is a confident paragraph about
                # a page nobody looked at. Declared, then PROVED: `seeing.ask`
                # puts a code in the image that is nowhere in the prompt and
                # refuses an answer that does not carry it back. A route that
                # says `false` is never handed a page at all.
                "sighted": True,
            },
            # WHAT A TURN COST, IN DOLLARS, COMPUTED HERE. The binary emits
            # `total_cost_usd` and it is WRONG for this provider: those are
            # Anthropic's prices. The token counts in the same object are the
            # model's own report and are right, so `read_turn_usage` keeps
            # those and `priced` does the arithmetic off this table. Per
            # million tokens, and the peak window is DeepSeek's own, in UTC on
            # weekdays. What is recorded in `cost.jsonl` is the RATE THAT
            # APPLIED rather than the window -- a table of windows goes stale
            # silently and a recorded rate cannot.
            "prices": {
                "peak": {"in": 0.30, "cache_write": 0.30,
                         "cache_read": 0.006, "out": 1.20},
                "off": {"in": 0.15, "cache_write": 0.15,
                        "cache_read": 0.003, "out": 0.60},
                "peak_utc": [["01:00", "04:00"], ["06:00", "10:00"]],
                "peak_weekdays_only": True,
            },
        },
        "opencode": {
            "cmd": ["opencode"], "prompt": "argv",
            "headless_first": ["opencode", "run", "{prompt}"],
            "headless": ["opencode", "run", "--continue", "{prompt}"],
        },
        # HALF A RECIPE UNTIL NOW: no `headless_first`, so `turn_plan` fell back
        # to `headless` for a first turn and there was no resume path at all,
        # and no `usage`, so every Codex turn was free in `cost.jsonl`.
        #
        # `codex exec resume --last` is the resume spelling, checked against
        # this machine's installed binary rather than against anybody's memory.
        "codex": {
            "cmd": ["codex"], "prompt": "argv",
            "headless_first": ["codex", "exec", "{prompt}"],
            "headless": ["codex", "exec", "resume", "--last", "{prompt}"],
            # It CAN report, and `--json` is what makes it. The stream carries
            # a `token_count` event whose `total_token_usage` is the running
            # total for the session, which is why the parser takes the LAST one
            # rather than summing -- see `read_codex_usage`.
            "usage": "codex-jsonl",
            "usage_args": ["--json"],
            # AND NO MODEL PINNED, DELIBERATELY, which is the opposite of the
            # decision taken for deepseek one entry up. There the endpoint maps
            # an unrecognised name onto a text-only model that quietly discards
            # images, so leaving it unset loses handwriting. Codex has no such
            # mapping: unset means `~/.codex/config.toml`, which is this
            # machine owner's own choice of model, and overriding it from here
            # would be this file making a teaching decision it does not get to
            # make. `env` or `-c model=...` is where it goes if that changes.
            "env": {},
            # No price table, so a Codex turn records its tokens and NO dollar
            # figure. That is the honest answer rather than a wrong number: the
            # rate depends on which model the config names and on whether the
            # account is on a subscription. `board cost` prints the tokens.
        },
        "aider":  {"cmd": ["aider"], "prompt": "none"},
        "cursor": {"cmd": ["cursor-agent"], "prompt": "none"},
        # THE LOCAL MODEL, and it is a command recipe like any other -- nothing
        # in this file knows what a model is, which is exactly why a second one
        # is a sixth row rather than a feature. `coli-code` puts a coding client
        # in a directory against GLM-5.2 int4 served on a compute node by
        # `coli-up`; see projects/libr-local-llm/README.md §4c.
        #
        # It exists for one job: it is the only assistant allowed to read `phi`,
        # because it runs on our own hardware and nothing leaves the node.
        #
        # `--continue` on the resumed turn is not a nicety here, it is the whole
        # cost argument, and it is much stronger than it is for a hosted model.
        # The client's preamble is 15,900 tokens and prefill runs at a few tokens
        # a second, so a fresh session is two to three HOURS before the first
        # word while a continued one reuses the KV prefix. `--yes` because a
        # headless turn has nobody to approve a tool call.
        "colibri": {
            "cmd": ["coli-code"], "prompt": "argv",
            "headless_first": ["coli-code", "--yes", "{prompt}"],
            "headless": ["coli-code", "--yes", "--continue", "{prompt}"],
            # AND ITS OWN CEILING. Both numbers below were chosen against a
            # hosted model that answers in seconds; this one spends hours in
            # prefill before it emits a token, so every turn would be killed and
            # the board would paint it as a turn that FAILED rather than one that
            # was interrupted. Eight hours, taken as a floor by `turn_timeout`,
            # under a nine-hour generation, so the generation's own end is the
            # cut rather than this number and a turn reaching this one is a
            # client that is wedged.
            "timeout": 28800,
            # ONE SITTING AT A TIME, MACHINE-WIDE, AND THE STRING IS THE REASON.
            # The server runs a single KV slot, so a second sitting anywhere on
            # this machine evicts the first one's prefix and the first then
            # re-pays its preamble: hours of work destroyed by a tap that looked
            # harmless. A refusal that names the workspace already holding it,
            # not a queue. The engine supports 16 slots and `COLI_KV_SLOTS` is
            # wired through the serve job; the day somebody measures what a slot
            # costs at a 131072 window, this line comes out and nothing else
            # changes.
            "exclusive": "the server runs one KV slot, so a second sitting "
                         "evicts the first one's prefix and costs it the whole "
                         "preamble again",
            # AND ITS CARDS MUST NOT BE COMMITTED. This is the only assistant
            # allowed to read `phi`, which is the entire reason it exists -- and
            # a card is how every turn reports. `research/PSYCH-ASR/.gitignore`
            # excludes `live/*` with `live/map.json` the single exception, so a
            # card there is never tracked; `courses/Galois-Theory/live/cards/` is
            # in the pushed history. Same feature, two workspaces, and in one of
            # them it pushes the local model's output to a remote where nothing
            # can audit what it quoted. So the rule is about the ASSISTANT and is
            # the same everywhere: refuse where the card would be tracked, and
            # name the one line that changes it.
            "private": "it is the only assistant allowed to read `phi`, so its "
                       "cards must not reach a remote",
        },
    },
    # WHO READS AN IMAGE FOR AN ASSISTANT THAT CANNOT SEE ONE.
    #
    # `board see <path>` resolves the vision route from the running agent's own
    # recipe first and falls back to this. It is named rather than guessed
    # because the registry is the table above and a second one drifts -- and it
    # is a NAME rather than an endpoint for the same reason: a provider is a
    # recipe plus a key, and its vision route belongs on the recipe with the
    # rest of it.
    #
    # THE DEFAULT AGENT'S OWN EYES, because this is the fallback and a fallback
    # that needs a second provider to be reachable is not one. Reading
    # handwriting is what this board rests on, so the route that answers when a
    # recipe has no eyes of its own is the binary that is installed here anyway,
    # with the key that is already paying for the lesson. A recipe naming its
    # own `vision` block is still asked first, and a sitting driving DeepSeek
    # still reads its slates through DeepSeek.
    "vision_agent": "claude",
    # Which assistant a given machine prefers, keyed by its short hostname. A
    # laptop and a cluster node do not have the same tools installed and should
    # not need different configuration files to say so. Empty means every
    # machine falls through to default_agent.
    "hosts": {},
    # WHO TAKES THE TURN WHEN THE ONE WE WANT HAS NOTHING LEFT TO SPEND, in
    # order. Null means "whatever `--agents` reports, in the order it reports
    # it", because a list nobody has set should still do something sensible --
    # and every candidate is filtered anyway: installed, keyed, not itself
    # limited, and never `private`, which is the fence flag and must not be
    # crossed into by a choice nobody made. See `choose_agent`.
    "fallback": None,
    "headless_timeout": 900,
    # ---------------------------------------------------------------------
    # AND HOW LONG A TURN THAT DOES THE WORK GETS, which is not the same number
    # ---------------------------------------------------------------------
    # A teaching turn writes a card and stops: thirty seconds, a minute if the
    # mathematics is long. Fifteen minutes is a generous cap on that and a
    # nonsense cap on a turn that was asked to WRITE THE CODE -- that one stages
    # models, runs a test suite, submits jobs and reads what came back. The first
    # successful one took 56 minutes; the second was killed at 15 with eight
    # files changed, nothing committed, and an opening sentence on the board that
    # still said "running the four typists" twenty minutes after nothing was.
    #
    # So the kind of sitting picks the number. It is still a cap rather than a
    # licence -- a turn that has genuinely hung has to end -- but it is a cap
    # that matches the work.
    "doing_timeout": 3600,
    # How long the wrap-up turn gets. It is one turn, but it writes files.
    "handoff_timeout": 600,
    # ---------------------------------------------------------------------
    # How many turns one of the agent's own sessions carries. ONE.
    # ---------------------------------------------------------------------
    # This was 12 and the arithmetic says 1. What a turn costs is, very nearly,
    # ROUND TRIPS x CONTEXT SIZE, and a resumed session grows the second factor
    # without bound while saving only the cold read.
    #
    # Measured in Galois Theory on 8 September 2026, eleven cards on
    # claude-opus-5[1m], one resumed session throughout:
    #
    #     turn  context   requests   cost
    #        1     74k       18      $2.24   (cold: contract + method + handoff)
    #        3     96k        8      $1.36
    #        8    152k       36      $4.49   (the turn that also ran `board wait`)
    #       11    176k        8      $2.43
    #     session total, 11 cards                     $25.40
    #
    # The context column is the whole story. It is not the cache expiring --
    # a `--continue` turn re-caches only its increment, measured at 40 tokens on
    # a 43k conversation -- it is that every one of a turn's round trips is
    # charged for the whole conversation behind it, at $0.50 per million to read
    # it back plus a cache write that scales with its size. Nineteen turns of
    # history that the twentieth turn will not look at are paid for on every one
    # of that turn's eight round trips.
    #
    # A fresh session pays instead for what it reads back off disk, and that is
    # now two commands: `board brief` (the method, this course's unbendable
    # rules, the handoff, the last turn's note) and `board recap` (the lesson).
    # Together about 4.5k tokens against the 24k of documents a cold turn used to
    # read, and the harness prefix itself is free -- measured: a second `claude
    # -p` in the same directory reads its 28k system prompt out of cache for
    # $0.015, because the cache is keyed on the prefix and not on the session.
    #
    # So a turn holds ~22k instead of 176k, and holds it whether it is turn 2 or
    # turn 40. What made this possible is that nothing is carried in the
    # conversation any more: the lesson is on disk, and what the tutor was
    # THINKING is on disk too, in `live/NEXT.md`, written by every turn with
    # `board note` and read by the next one out of `board brief`.
    #
    # 0 resumes for ever, which is the right answer on a flat rate and the wrong
    # one on a meter. Any N recycles after N turns, which is what this was.
    "session_turns": 1,
    # ---------------------------------------------------------------------
    # How many tokens the plan's rolling window holds, for `tutor cost`
    # ---------------------------------------------------------------------
    # On a subscription -- Max, Team, Enterprise -- what runs out is not money
    # but a five-hour allowance, and nothing published says how many tokens that
    # is or how the kinds are weighted. So this is a CALIBRATION and it is null
    # until somebody sets it: `tutor cost` reports tokens, which is what any
    # weighting is applied to, and adds a percentage only when this says what to
    # divide by.
    #
    # Calibrate it from one observation. A turn that a person saw take 5% of
    # their window, measured at 1.39M tokens, puts the window near 28M -- so
    # `"quota_tokens": 28000000`. It will be approximate, because a cache read
    # and an output token are certainly not weighted the same; it is still worth
    # far more than nothing, because the thing worth watching is whether the
    # figure is FLAT across a lesson, and a constant factor does not affect that.
    "quota_tokens": None,
    # ---------------------------------------------------------------------
    # What the serving job asks Slurm for, per generation
    # ---------------------------------------------------------------------
    # `tutor serve` submits a job that submits its own successor, so these are
    # the terms the board's machine is renewed on. The partition is the one
    # decision in here with a wrong answer, and both seven-day partitions are
    # wrong ones: see `serve_settings`, which has the measurements.
    "serve_partition": "c3_short",
    "serve_time": "09:00:00",
    "serve_cpus": 2,
    "serve_mem": "8G",
}


def load_config():
    """The defaults above, with this machine's config file laid over them.

    `agents` merges one level DEEPER than everything else, and the reason is a
    trap somebody has to fall into only once. A machine adjusting a single field
    of a built-in recipe -- saying that the claude on THIS machine takes an extra
    flag, say -- writes the obvious thing:

        "agents": { "claude": { "prompt": "none" } }

    With a plain `update` that REPLACES the whole recipe: the command, the
    headless turn, the handoff, all of it, gone. The machine then has an agent
    called `claude` that cannot run anything, and every turn fails into a log
    while the board shows a tutor listening. Nothing in the file the person wrote
    says that; they added one key.

    So a dict per agent merges into the built-in one, and adding an agent that
    does not exist yet works exactly as before because there is nothing to merge
    with. Replacing a recipe outright is still possible and is now something you
    have to mean: give the entry a `"replace": true`.
    """
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        with open(CONFIG, "r", encoding="utf-8") as fh:
            user = json.load(fh) or {}
        for k, v in user.items():
            if k == "agents" and isinstance(v, dict):
                for name, spec in v.items():
                    have = cfg["agents"].get(name)
                    if isinstance(spec, dict) and isinstance(have, dict) \
                            and not spec.get("replace"):
                        merged = dict(have)
                        merged.update(spec)
                        cfg["agents"][name] = merged
                    else:
                        cfg["agents"][name] = spec
            else:
                cfg[k] = v
    except (OSError, ValueError):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        if not os.path.exists(CONFIG):
            with open(CONFIG, "w", encoding="utf-8") as fh:
                json.dump(DEFAULT_CONFIG, fh, indent=2)
                fh.write("\n")

    # A `courses_dir` LEFT OVER FROM THE FLAT LAYOUT is dropped here.
    #
    # The key used to mean "the directory the courses are siblings in", and
    # every machine has one saved from before the move naming the home
    # directory. Read literally after the move, `tutor where` walked `~` flat,
    # found the old working directories still sitting there, and listed
    # Tutor-Board itself as a course.
    #
    # The test is whether it holds an `atlas.json`, which is what a repository
    # root is. So a person who deliberately points this at ANOTHER checkout
    # still gets what they asked for, and a value that can only be wrong is
    # wrong once, here, instead of at every use. `atlas.root()` needs no
    # configuring at all: it derives from where this package actually is.
    said = cfg.get("courses_dir")
    if said:
        said = os.path.expanduser(said)
        if not os.path.isfile(os.path.join(said, "atlas.json")):
            cfg["courses_dir"] = atlas.root()
    return cfg


# ---------------------------------------------------------------------------
def read_course(root):
    """What a course calls itself, and what its tutor is for.

    `mode` -- `math` or `code` -- used to be read here and carried into the
    session brief. There is one method and one board now, so it is dropped on
    the way past: a key left in a course's own file must never be the reason two
    courses behave differently. `stance` is the one thing still read, and it is
    only ever what the file says.
    """
    cfg = {"name": os.path.basename(root).replace("-", " "), "stance": "teach"}
    try:
        with open(os.path.join(root, "tutorboard.json"), "r", encoding="utf-8") as fh:
            cfg.update(json.load(fh) or {})
    except (OSError, ValueError):
        pass
    cfg.pop("mode", None)
    cfg["stance"] = "do" if str(cfg.get("stance") or "").lower() == "do" else "teach"
    return cfg


def this_host():
    """What this machine calls itself. One place decides; see boardlib."""
    return machine.node_name()


def missing_command(recipe):
    """The recipe's own executable, when this machine has not got it.

    Worth asking because the default is now a particular program rather than a
    self-contained script, and two machines do not have the same tools installed.
    An agent whose command is missing does not fail loudly: the daemon starts,
    the board shows an assistant listening, and every turn dies in a log file. Say
    it where somebody can still do something about it.

    A script agent runs under this interpreter, which is by definition present.
    """
    exe = (recipe or [None])[0]
    if not exe or os.path.basename(exe) == os.path.basename(sys.executable):
        return None
    return None if shutil.which(exe) else exe


# What a turn said on its way down, in the order a person would find useful.
# `!!` is this file's own marker for something that went wrong; a tutor writes
# its own reason in the other two forms.
FAILURE_MARKERS = ("!! ", "error: ", "Error: ")


def result_object_error(text):
    """What an agent's own result object says went wrong, or None.

    Claude Code's `--output-format json` closes a turn with one line carrying
    `type: result`; on a failure `is_error` is true and `result` holds the
    sentence. The recipes that drive a third-party provider through that same
    binary report the same way, so this is the one place a provider-side fault
    -- a refused model, a reset connection, a rejected key -- says so in words.

    The LAST such line, because a turn retried as a fresh one writes two.

    AND A RESULT OBJECT TOO LONG TO HAVE SURVIVED WHOLE still says what
    happened, which is the second line of defence rather than the first.
    `turn_output` now pulls its seek back to the start of the final line, so an
    ordinary long turn arrives here parseable -- but a log rotated under the
    daemon, or an offset past the line, still hands over a fragment that no
    longer opens with a brace, which is why neither test is what admits a line
    here. What is read off a fragment is read directly, and the ORDER matters:
    measured on a real result line, `"is_error"` sits at byte 932 and `"result"`
    at 1006, so a front cut loses the verdict before it loses the sentence. A
    fragment with no verdict in it therefore ends the scan rather than being
    guessed at in either direction -- guessing failure marks a good turn as
    broken, and guessing success is the silence this whole path exists to end.
    """
    for line in reversed((text or "").splitlines()):
        line = line.strip()
        if '"result"' not in line:
            continue
        if line.startswith("{"):
            try:
                d = json.loads(line)
            except ValueError:
                d = None
            if d is not None:
                if d.get("type") != "result" or not d.get("is_error"):
                    return None
                got = d.get("result")
                return got.strip() if isinstance(got, str) and got.strip() else None
        # The tail of a result object, or an ordinary log line that happens to
        # hold the word: only the first is answered for, and `type` says which
        # it is. A fragment that reports no failure is still the newest verdict,
        # so it ends the scan rather than letting an older turn's failure through.
        if not re.search(r'"type"\s*:\s*"result"', line):
            continue
        if not re.search(r'"is_error"\s*:\s*true', line):
            return None
        got = re.search(r'"result"\s*:\s*"((?:[^"\\]|\\.)*)"', line)
        try:
            return json.loads('"%s"' % got.group(1)).strip() if got else None
        except ValueError:
            return None
    return None


def failure_reason(text, code_note):
    """Why the turn failed, in words, rather than the number it exited with.

    `exit 1` is what the student's iPad used to say, and it is a dead end: it is
    true, it is the same for every cause, and there is nothing a person holding
    the board can do with it except go and find somebody who can read a log. The
    turn almost always said something better than that on its way down -- "every
    model on the chain deliberated instead of writing a card", "no provider key
    on this machine" -- and that sentence is already in the log, one line above
    the number nobody can use.

    So: the last thing it said that looks like a reason, capped to something that
    fits in the chrome, with the exit code kept on the end for whoever does open
    the log. `code_note` when it said nothing at all, which is a real outcome and
    must not become an empty banner.

    THE AGENT'S OWN VERDICT IS ASKED FOR FIRST, because the marker prefixes miss
    it entirely: an agent reporting `--output-format json` puts its reason in a
    `result` field inside one long JSON line that starts with a brace, so the
    line reads as ordinary output and a turn killed by `API Error: Connection
    dropped (ECONNRESET)` reaches the board as `exit 1`. That is the same banner
    every other cause wears, which is the dead end this function exists to end.
    """
    said = result_object_error(text)
    if said:
        return "%s (%s)" % (said[:160], code_note)
    lines = [l.strip() for l in (text or "").splitlines() if l.strip()]
    for line in reversed(lines[-40:]):
        for mark in FAILURE_MARKERS:
            if line.startswith(mark):
                said = line[len(mark):].strip()
                # `!! exit 1` is this function's own output from a previous turn,
                # or the line written just above the call. Not a reason.
                if said and not said.startswith(("exit ", "timed out")):
                    return "%s (%s)" % (said[:160], code_note)
    return code_note


def turn_output(path, offset, cap=20000, line_cap=400000):
    """What this turn wrote to the log, which is everything it managed to say.

    An agent's stdout and stderr both go straight into the log file, so the only
    record of WHY a turn failed is the stretch of that file it has just written.
    The tail of it is enough, and the cap is there because a turn that dumped a
    repository into its output must not be read back into memory whole.

    AND THE LAST LINE IS NEVER CUT, WHATEVER THE CAP SAYS, because it is the one
    line whose every field is load-bearing: the client's result object, which is
    where `result_object_error` reads whether the turn actually failed. That
    object is long exactly when the turn had a lot to say, and a blind seek to
    `size - cap` lands in the middle of it -- measured on a real turn, the tail
    kept `"result"` and lost the `"is_error"` that comes before it, so a failure
    read back as a clean turn. So the seek is pulled back to the start of the
    final line when the cap would have cut it, bounded by `line_cap` for the
    same reason the cap exists at all.
    """
    try:
        size = os.path.getsize(path)
        floor = max(0, offset)
        with open(path, "rb") as fh:
            back = max(floor, size - line_cap)
            fh.seek(back)
            tail = fh.read()
            cut = tail.rstrip(b"\n").rfind(b"\n")
            last = back + cut + 1 if cut >= 0 else back
            fh.seek(min(max(floor, size - cap), last))
            return fh.read().decode("utf-8", "replace")
    except OSError:
        return ""


# ---------------------------------------------------------------------------
# What a turn cost, measured rather than argued about
# ---------------------------------------------------------------------------
# Every decision in this file about reading, resuming and re-reading is a
# decision about money, and until now not one of them could be checked. The
# numbers that justified them were read out of `~/.claude.json` and a session
# transcript by hand, after the fact, by somebody who knew where to look -- so
# the next change to any of it would have been guesswork wearing a comment.
#
# `--output-format json` makes the agent say what its turn cost. This writes it
# down, one line per turn, and `tutor cost` adds it up. The cost of the
# accounting is zero: it is a field in output the daemon was already logging.
#
# `usage` in that JSON is cumulative for the whole invocation -- every round trip
# the turn took, not the last one. Measured: a five-round-trip turn reports
# cache_read 152,020, which is the sum of its five requests and not any one of
# them. That is exactly the number worth watching, because ROUND TRIPS x CONTEXT
# is what a turn is billed for.
COST_LOG = "cost.jsonl"


def with_usage(spec, cmd):
    """The turn's command, plus whatever makes this agent report what it cost.

    Appended here rather than written into the recipe, because a machine's
    config file overrides `agents` one level deep and a config holding a
    verbatim copy of an older recipe would otherwise stop reporting without
    saying so. Idempotent: a recipe that already carries the flag is left alone.
    """
    extra = [a for a in (spec.get("usage_args") or []) if a not in cmd]
    extra += [a for a in (spec.get("extra_args") or []) if a not in cmd]
    return list(cmd) + extra


def turn_environment(spec, base=None):
    """What one turn runs with: this process's environment, plus the recipe's.

    A RECIPE'S `env` IS HOW A PROVIDER IS POINTED SOMEWHERE ELSE, and it is the
    one part of a turn that must not reach argv. `with_usage` appends flags to
    the command because flags are public; a key on a command line is in `ps`
    output for anything on the machine to read, which is the whole reason
    `ai-config/policy/credentials.txt` exists. So routing goes here.

    `{NAME}` in a value is substituted from `tutorboard/keys.py`. A value naming
    a key the store has not got is DROPPED rather than passed through with the
    braces still on it -- see `keys.fill`. The recipe should not have been
    offered at all in that case, which is what `unkeyed` on `--agents --json`
    is for; this is the second guard behind it.

    `base` is what the caller already built -- a colibri mission's
    `COLI_SESSION_ID`, which is the only other thing that sets a turn's
    environment. Merged here so the two land in one dict rather than in two
    places that fight. None in and no `env` on the recipe gives None back, so a
    turn that wants nothing special still inherits the daemon's environment
    exactly as it did.
    """
    extra = (spec or {}).get("env") or {}
    if not extra:
        return base
    env = dict(base if base is not None else os.environ)
    for name, value in extra.items():
        filled = keys.fill(value)
        if filled is not None:
            env[str(name)] = filled
    return env


def turn_words(path, offset):
    """What this turn actually printed, from `offset` on. "" if unreadable."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            fh.seek(max(0, offset))
            return fh.read(4000000)
    except OSError:
        return ""


def read_turn_usage(path, offset, kind, spec=None):
    """What the agent said this turn cost, or {} if it did not say.

    `kind` is the recipe's `usage` field and it is a DISPATCH rather than an
    equality test, which is the difference between a table of three providers
    and a table of one. An agent whose `usage` names no parser -- `usage: none`,
    or nothing at all -- costs nothing here and is simply not accounted for.
    Never raises: this is bookkeeping beside a lesson, and a lesson does not
    stop because a number could not be parsed.

    `spec` is the recipe, and it is here for the dollars rather than the tokens.
    A provider driven through somebody else's binary reports the token counts
    correctly -- they are the model's own -- and the price WRONG, because the
    prices compiled into that binary are its vendor's. So the counts come from
    the parser and `priced` recomputes the money off the recipe's own table
    wherever it has one.
    """
    parser = USAGE_PARSERS.get(kind)
    if not parser:
        return {}
    got = parser(turn_words(path, offset))
    return priced(got, spec) if got else got


def read_claude_usage(blob):
    """Claude Code's `--output-format json` result object."""
    # The last line of the turn that is a result object. Not the only line:
    # warnings, and anything the agent printed on its way, share this stream.
    for line in reversed(blob.splitlines()):
        line = line.strip()
        if not line.startswith("{") or '"result"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") != "result":
            continue
        u = d.get("usage") or {}
        models = d.get("modelUsage") or {}
        billed = (int(u.get("input_tokens") or 0)
                  + int(u.get("output_tokens") or 0)
                  + int(u.get("cache_creation_input_tokens") or 0)
                  + int(u.get("cache_read_input_tokens") or 0))
        return {
            # Everything that went through the model this turn. On a
            # subscription this is the number that matters: what runs out is a
            # five-hour allowance, and a percentage of it is computed from
            # tokens rather than from dollars.
            "tokens": billed,
            "in": int(u.get("input_tokens") or 0),
            "out": int(u.get("output_tokens") or 0),
            "cache_write": int(u.get("cache_creation_input_tokens") or 0),
            "cache_read": int(u.get("cache_read_input_tokens") or 0),
            # Round trips. This is the lever a prompt can actually pull, and the
            # one that turned a turn into $4.49 when it also ran `board wait`.
            "requests": int(d.get("num_turns") or 0),
            "usd": float(d.get("total_cost_usd") or 0.0),
            "models": sorted(models),
            "session": d.get("session_id") or "",
        }
    return {}


def read_codex_usage(blob):
    """Codex's `--json` event stream, in either of the two shapes it has had.

    TWO SHAPES, because the stream belongs to the client and the client moved.
    Both are read: which one arrives depends on the binary installed on this
    machine, and nothing here gets to insist on a version.

    * `turn.completed`, carrying a `usage` object. One per `codex exec`
      invocation -- measured on 0.156.1 against a run that made two shell
      calls, which produced three `item.completed` events and exactly one
      `turn.completed`. SUMMED, because each is its own turn's bill.
    * `token_count`, carrying `total_token_usage`, which is the RUNNING TOTAL
      for the session. The LAST of those is the answer, and summing them would
      count every earlier round trip again -- the one way to get this wrong
      that produces a plausible number.

    A stream in the first shape read by the second rule reports NOTHING: there
    is no `token_count` line to match, so every Codex turn was free in
    `cost.jsonl` and absent from every total.

    Round trips are counted rather than reported, because Codex reports no such
    number: one event per turn in the new shape, one per trip in the old.
    """
    fresh, last, trips = [], None, 0
    for line in blob.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        if '"turn.completed"' in line:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            got = d.get("usage")
            if isinstance(got, dict):
                fresh.append(got)
            continue
        if "token_count" not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        info = d.get("info") or d.get("msg") or d
        total = (info.get("total_token_usage")
                 or (info.get("info") or {}).get("total_token_usage"))
        if isinstance(total, dict):
            last = total
            trips += 1
    # The new shape wins where a stream somehow carries both: a client that
    # reports `usage` on the turn is reporting THIS turn, and a running total
    # beside it would be the whole session's.
    if fresh:
        def summed(field):
            return sum(int(u.get(field) or 0) for u in fresh)
        got_in, cached = summed("input_tokens"), summed("cached_input_tokens")
        out = summed("output_tokens")
        written = summed("cache_write_input_tokens")
        trips = len(fresh)
    elif last:
        got_in = int(last.get("input_tokens") or 0)
        cached = int(last.get("cached_input_tokens") or 0)
        out = int(last.get("output_tokens") or 0)
        written = 0
    else:
        return {}
    return {
        # `input_tokens` INCLUDES the cached part in this report, so the two are
        # separated here to mean what they mean everywhere else in this file --
        # and the billed total must not add them twice.
        "tokens": got_in + out,
        "in": max(0, got_in - cached),
        "out": out,
        "cache_write": written,
        "cache_read": cached,
        "requests": trips,
        "usd": 0.0,
        "models": [],
        "session": "",
    }


# Which parser reads which agent's report. A provider is a parser added beside
# the others; nothing else in this file learns a new name.
USAGE_PARSERS = {
    "claude-json": read_claude_usage,
    "codex-jsonl": read_codex_usage,
}


def at_peak_rate(prices, now=None):
    """Is the provider's peak window open right now? Peak unless told otherwise.

    The windows are the provider's own, in UTC, as `[["01:00", "04:00"], ...]`,
    and `peak_weekdays_only` says whether Saturday and Sunday count. Peak is the
    default answer for a table with no windows on it, because guessing the dear
    rate cannot understate a bill.
    """
    spans = (prices or {}).get("peak_utc")
    if not spans:
        return True
    t = time.gmtime(now if now is not None else time.time())
    if (prices or {}).get("peak_weekdays_only") and t.tm_wday >= 5:
        return False
    mins = t.tm_hour * 60 + t.tm_min
    for span in spans:
        try:
            a, b = [int(x[:2]) * 60 + int(x[3:5]) for x in span]
        except (ValueError, IndexError, TypeError):
            continue
        if a <= mins < b or (b < a and (mins >= a or mins < b)):
            return True
    return False


def priced(usage, spec, now=None):
    """The dollars this turn cost, from the RECIPE's price table.

    Three outcomes and they are all deliberate:

      - a recipe with a price table gets a figure computed here, and the RATE
        THAT APPLIED is recorded beside it. A provider whose price has a peak
        and an off-peak window can only be said honestly one of two ways, and
        recording what applied beats encoding the windows in the reader: a
        table of windows goes stale silently, a recorded rate cannot;
      - a recipe with none keeps whatever the agent itself said, which for
        Claude Code against Anthropic is right;
      - and one with neither records the tokens and NO dollar figure, which is
        the honest answer rather than a wrong number.
    """
    prices = (spec or {}).get("prices")
    if not prices:
        return usage
    peak = at_peak_rate(prices, now)
    rate = prices.get("peak" if peak else "off") or {}
    per = lambda n, k: (usage.get(n, 0) / 1000000.0) * float(rate.get(k, 0) or 0)
    out = dict(usage)
    out["usd"] = round(per("in", "in") + per("cache_write", "cache_write")
                       + per("cache_read", "cache_read") + per("out", "out"), 6)
    out["rate"] = {"window": "peak" if peak else "off",
                   "in": rate.get("in"), "cache_write": rate.get("cache_write"),
                   "cache_read": rate.get("cache_read"), "out": rate.get("out")}
    return out


def record_cost(live, log, turn, agent_name, fresh, usage):
    """One line per turn in `live/cost.jsonl`, and one in the log.

    `live/` is not tracked, so this is a per-machine record of a per-machine
    bill, which is the right scope: the allowance that paid for it belongs to
    this machine's account.
    """
    if not usage:
        return
    rec = dict(usage)
    rec.update({"t": time.time(), "iso": time.strftime("%Y-%m-%d %H:%M:%S"),
                "turn": turn, "agent": agent_name, "fresh": bool(fresh),
                "host": this_host()})
    try:
        with open(os.path.join(live, COST_LOG), "a", encoding="utf-8") as fh:
            fh.write(json.dumps(rec) + "\n")
    except OSError:
        pass
    try:
        log.write("-- turn %d: %s tokens over %d round trip(s) "
                  "(cache read %s, cache written %s, out %s), %s\n"
                  % (turn, thousands(rec.get("tokens", 0)), rec["requests"],
                     thousands(rec["cache_read"]), thousands(rec["cache_write"]),
                     thousands(rec["out"]),
                     ("$%.3f at the %s rate" % (rec["usd"], rec["rate"]["window"]))
                     if rec.get("rate") else
                     ("$%.3f" % rec["usd"]) if rec.get("usd")
                     else "no price table for this provider"))
    except (OSError, ValueError):
        pass


def thousands(n):
    return "%.1fk" % (n / 1000.0) if n >= 1000 else str(n)


def read_costs(root):
    try:
        with open(os.path.join(root, "live", COST_LOG), "r", encoding="utf-8") as fh:
            return [json.loads(l) for l in fh if l.strip()]
    except (OSError, ValueError):
        out = []
        try:
            with open(os.path.join(root, "live", COST_LOG), "r",
                      encoding="utf-8") as fh:
                for l in fh:
                    l = l.strip()
                    if not l:
                        continue
                    try:
                        out.append(json.loads(l))
                    except ValueError:
                        pass
        except OSError:
            pass
        return out


def resolve_agent(cfg, course, override=None, interactive=False, say=None):
    """Which assistant tutors this course, on this machine, in this sitting.

    Most specific wins, and every layer is configuration rather than code:

      1. --agent on the command line          -- this once
      2. "agent" in the sitting's state.json  -- this evening's work
      3. "agent" in the course's tutorboard.json -- this course, everywhere
      4. "hosts" in the config, by hostname   -- this machine, every course
      5. default_agent                        -- everything else

    THE SITTING IS THE LAYER THAT WAS MISSING, and the one the iPad can reach.
    Without it, choosing the local model for one evening's work meant editing a
    file that is a statement about the workspace for ever -- and none of the four
    layers around it can be touched from a tablet. It sits above the workspace
    for the same reason a sitting stance and a sitting aim do: a choice made for
    an evening is not a decision about what the repository is.

    AN ASSISTANT IS RE-RESOLVED EVERY TURN. This function answers the question
    and `for_this_turn` asks it again at the top of each turn, so a tap on the
    front door or a sitting rewritten from the iPad lands on the next card
    rather than the next sitting. What makes that cheap is that `session_turns`
    is 1: a hosted turn holds no conversation, and reconstructs the evening from
    `board brief` and `board recap` off disk whoever takes it.

    The one recipe that cannot be left mid-way is one CARRYING a session -- a
    colibrì `[carry]`, where the preamble is 15,900 tokens and hours of prefill.
    That is a guard in `for_this_turn` rather than a rule here.

    The sitting layer is what the iPad writes: `_mark` writes it with the
    sitting, and a sitting that does not name one clears it.

    Which model an assistant runs is not a layer here and never should be: an
    agent entry is a command recipe, so a second model is a second entry whose
    `cmd` carries the flag. Nothing in this file knows what a model is.
    """
    say = say or (lambda m: print(m, file=sys.stderr))
    mine = config.sitting_agent((course or {}).get("root"))
    # The sitting's own answer is DROPPED when this machine has no such agent,
    # where every other layer refuses. It is the one layer written from a
    # browser, and a name that resolves to nothing leaves the course with no
    # tutor at all -- which is a worse answer to a misspelling than the
    # workspace's own.
    if mine and mine not in cfg["agents"]:
        say("this sitting asks for '%s', which is not an assistant here; "
            "falling back" % mine)
        mine = None
    picked = None
    for pick in (override, mine, (course or {}).get("agent"),
                 (cfg.get("hosts") or {}).get(this_host()),
                 cfg.get("default_agent")):
        if pick and pick in cfg["agents"]:
            picked = pick
            break
        if pick:
            say("no agent called '%s'; try: tutor --agents" % pick)
            return None
    return picked


def agent_probe_urls(spec):
    """The endpoints THIS recipe's turns open, or None for the machine's own.

    A recipe that points the binary somewhere else -- `ANTHROPIC_BASE_URL` at a
    third party -- talks to a host the machine-wide probe never asks about, and
    the two questions have different answers when one hostname is filtered and
    the rest of the internet is not. None means the recipe adds nothing to the
    default agent's, which is what `egress.egress_probe_urls` already returns.
    """
    urls = (spec or {}).get("egress_probe")
    if isinstance(urls, str):
        urls = [urls]
    return [u for u in urls if u] if urls else None


# How long one answer about a third-party provider's reachability stands before
# it is asked again. Long enough that a sitting cannot make the daemon probe
# once a turn, short enough that a filter lifted at lunchtime is picked up in the
# afternoon -- and the stand-down record, not this, is what remembers a NO.
PROBE_TTL = 600
_PROBED = {}


def probe_before_turn(cfg, name, log=None, now=None):
    """Ask whether this recipe's own provider answers, before a turn is spent on it.

    THE ONE MOMENT A ROUND TRIP IS WORTH IT. A recipe pointed at a third party
    -- `ANTHROPIC_BASE_URL` somewhere else -- talks to a host nothing else on
    this machine talks to, so nothing else has an opinion about it, and the first
    news of a filtered hostname is a student watching three minutes of retries
    end in no card. That turn is the expensive way to learn something a socket
    answers in a tenth of a second.

    Only for a recipe that names its OWN endpoints. Everything driving the
    machine's default provider is covered by the machine-wide probe the failure
    path already runs, and would pay a round trip here for nothing.

    Cached, and never in front of an answer: the result stands for `PROBE_TTL`,
    a recipe already stood down is not asked about again, and a machine with no
    egress at all is not this provider's fault and is left to
    `egress.rotate_exit_node` on the failure path.
    """
    spec = (cfg.get("agents") or {}).get(name) or {}
    own = agent_probe_urls(spec)
    now = now or time.time()
    if not own or egress.stood_down(name, now):
        return None
    if now - _PROBED.get(name, 0) < PROBE_TTL:
        return None
    _PROBED[name] = now
    if egress.egress_ok(urls=own, timeout=8) or not egress.egress_ok():
        return None
    host = probe_host(own)
    egress.mark_unreachable(name, host)
    until = (egress.stood_down(name, now) or {}).get("until", now)
    if log:
        log.write("!! '%s' cannot reach %s from here, and everything else on "
                  "the network answers; standing it down until %s before a turn "
                  "is spent on it\n"
                  % (name, host, time.strftime("%H:%M", time.localtime(until))))
    return host


def probe_host(urls):
    """The hostname a probe list is about, for saying which one went dark."""
    try:
        from urllib.parse import urlsplit
        return urlsplit((urls or [""])[0]).hostname or ""
    except (ValueError, IndexError):
        return ""


def agent_unavailable(cfg, name, now=None):
    """Why this agent cannot take a turn on this machine right now, or None.

    Five reasons and they are all facts rather than opinions: the executable is
    not here, the key is not here, the allowance is gone until a time somebody
    wrote down, the provider's own hostname does not answer from this machine, or
    its turns fail here for a reason the network is innocent of -- a renamed
    model, a rejected key. In the words the board already uses.

    The last two are READ here and never measured here. This runs behind
    `--agents --json`, which the board asks several times a second, and a probe
    on that path would put a round trip to the internet under every poll. A
    failed turn does the measuring and writes the finding down, and so does the
    one probe a sitting pays when it is pointed at a recipe with a provider of
    its own; see `egress.mark_unreachable`, `egress.mark_failing` and
    `probe_before_turn`.
    """
    spec = (cfg.get("agents") or {}).get(name)
    if not spec:
        return "there is no recipe called '%s'" % name
    if not (spec.get("headless") or spec.get("headless_first")):
        return "'%s' has no headless recipe" % name
    gone = missing_command(spec.get("cmd"))
    if gone:
        return "`%s` is not on the path here" % gone
    need = keys.unkeyed(spec)
    if need:
        return "%s is not in %s" % (need, keys.store())
    until = limits.limited_until(name, now)
    if until:
        return ("its allowance is gone until %s"
                % time.strftime("%H:%M", time.localtime(until)))
    dark = egress.stood_down(name, now)
    if dark and dark["host"]:
        return ("%s does not answer from this machine; asking again after %s"
                % (dark["host"],
                   time.strftime("%H:%M", time.localtime(dark["until"]))))
    if dark:
        return ("its turns keep failing here (%s); asking again after %s"
                % (dark["why"][:120],
                   time.strftime("%H:%M", time.localtime(dark["until"]))))
    return None


def choose_agent(cfg, wanted, now=None):
    """Who actually takes the next turn. `(name, why)`; `why` is None if nothing moved.

    THE LIMIT BELONGS TO AN AGENT, NOT TO THE MACHINE, AND THIS IS WHERE THAT
    STOPS BEING A SENTENCE. When the one we want has run out, the next one that
    is installed, keyed, unlimited and not `private` takes the turn, and the
    lesson goes on.

    AND THE STUDENT IS TOLD, which is the condition on all of it: `why` comes
    back so the caller can put it in the log and in `agent_state`, and the strip
    names the assistant that is writing. A lesson answered by something else
    without anybody saying so would be worse than a board that reports the
    failure -- see the standing rule in `AI_INSTRUCTIONS.md`.

    WHAT MAKES IT SAFE IS ALREADY TRUE, and it is the reason this is small:
    `session_turns` is 1, so every ordinary turn is cold -- it reconstructs the
    evening from `board brief` and `board recap`, off disk, off the transcript
    the beat has been pushing every ninety seconds. A provider swap between
    turns therefore loses NOTHING: there is no conversation to transfer. The one
    place a session genuinely IS carried is a `[carry]`, and the caller guards
    that rather than this.

    `private` is never fallen into. It is the fence flag -- the only assistant
    allowed to read `phi`, whose cards must not reach a remote -- and an
    automatic choice is exactly the kind of choice that must not cross it.
    """
    if wanted and not agent_unavailable(cfg, wanted, now):
        return wanted, None
    said = cfg.get("fallback")
    if not isinstance(said, list) or not said:
        # What `--agents` reports, in the order it reports it.
        said = sorted(cfg.get("agents") or {})
    for name in said:
        if name == wanted:
            continue
        spec = (cfg.get("agents") or {}).get(name) or {}
        if spec.get("private"):
            continue
        if agent_unavailable(cfg, name, now):
            continue
        return name, ("'%s' cannot take this turn -- %s; '%s' is taking it"
                      % (wanted, agent_unavailable(cfg, wanted, now), name))
    # Nobody else can either, so the turn goes to the one we wanted and fails
    # where it is visible. Exactly today's behaviour, which is the right answer
    # when there is no second provider to reach for.
    return wanted, None


def courses(cfg):
    """Whatever is on disk. No registry, so nothing to keep in step.

    `atlas.workspaces()` is the walk: the families named in `atlas.json`, a
    workspace per second-level directory, vendor skipped, the board skipped. It
    used to be one listing of the board's parent directory, and the thing that
    has NOT changed is that nothing anywhere lists the workspaces -- a directory
    holding `tutorboard.json`, `AI_INSTRUCTIONS.md` or `live/` is one, found by
    looking.

    `TUTORBOARD_COURSES` still beats everything, and it is not a nicety. It is
    how a test says "this tree, not this machine's", and until 7 September only
    the shell scripts had heard of it: `catch-up.sh` walked the directory it was
    pointed at, then handed the machine to `tutor restart --tutors`, which asked
    the configuration and found the real home. Running the test suite therefore
    bounced the board somebody was being taught on, and -- because a `HOME` the
    test HAD moved gave a different config and so a different derived port --
    left a second board for the same course answering on a port nobody knew
    about. One variable, one meaning, everywhere. It now means "the repository
    root" rather than "the directory the courses are siblings in", which is the
    same sentence about the new shape; `atlas.root()` reads it.
    """
    # `TUTORBOARD_COURSES` beats the configuration; `courses_dir` is what a
    # person set, and it is honoured when they set something real. A value left
    # over from the flat layout is dropped by `load_config` before it gets here
    # -- see the note there, which is where that belongs, because a stale value
    # should be wrong ONCE at load rather than at every use.
    base = os.environ.get("TUTORBOARD_COURSES") or cfg.get("courses_dir") \
        or atlas.root()
    out = []
    for w in atlas.workspaces(base):
        info = read_course(w["root"])
        info["root"] = w["root"]
        info["dir"] = w["dir"]
        info["id"] = w["id"]
        info["family"] = w["family"]
        out.append(info)
    return out


def pick(cands, query):
    """Match on the directory name or the declared course name, loosely."""
    if not query:
        return None
    q = re.sub(r"[^a-z0-9]", "", query.lower())
    exact = [c for c in cands if re.sub(r"[^a-z0-9]", "", c["dir"].lower()) == q]
    if exact:
        return exact[0]
    hits = [c for c in cands
            if q in re.sub(r"[^a-z0-9]", "", c["dir"].lower())
            or q in re.sub(r"[^a-z0-9]", "", (c.get("name") or "").lower())]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        print("'%s' matches more than one course:" % query, file=sys.stderr)
        for c in hits:
            print("  %s" % c["dir"], file=sys.stderr)
        sys.exit(1)
    print("no course matching '%s'. Try: tutor --list" % query, file=sys.stderr)
    sys.exit(1)


def choose(cands):
    print("Courses:\n")
    for i, c in enumerate(cands, 1):
        print("  %2d  %-26s %s" % (i, c.get("name") or c["dir"],
                                   "do" if c.get("stance") == "do" else ""))
    print()
    try:
        raw = input("which? ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit(0)
    if raw.isdigit() and 1 <= int(raw) <= len(cands):
        return cands[int(raw) - 1]
    return pick(cands, raw)


def board(root, *args):
    p = subprocess.run([sys.executable, BOARD] + list(args), cwd=root,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return p.returncode, p.stdout.decode("utf-8", "replace")


def link(root):
    """Bring the tailnet link up, on every launch, before anything reads addresses.

    An allocation ending takes the daemon with it, so the first thing a new
    session needs is the link back -- and asking a person to run it themselves
    is exactly the ceremony this launcher exists to remove. Nothing is forced:
    the ownership check inside `board` clears a claim from a node that is no
    longer held, and refuses when another live node really is holding it.

    A machine with no tailscale, or one that is not logged in, is a legitimate
    outcome; the board is still up on loopback. This never fails a launch.
    """
    code, out = board(root, "vpn", "up")
    if code == 3:
        print(out.strip())              # not logged in -- the URL is the point
        return
    if code != 0:
        return
    # `board net` re-points an existing serve on its own; this is for the case
    # where there is no serve yet, which is every first link on a fresh daemon.
    #
    # `--if-free`, and that word is the whole of it. A bare `vpn serve` is the
    # forced claim -- a person saying "point the address at this course" -- and
    # calling it here meant every tutor launch in every workspace took the name,
    # whoever was reading whatever on the iPad. Starting a tutor in PSYCH-ASR
    # dropped somebody mid-proof in Galois Theory into a different course.
    code, out = board(root, "vpn", "serve", "--if-free")
    if code != 0:
        print(out.strip(), file=sys.stderr)


BRIEF = """# Session brief

You are tutoring in this repository. Read `AI_INSTRUCTIONS.md` in full before
anything else; it is the contract and it overrides your own defaults.

- Course: **%(name)s**
- Stance: **%(stance)s**  (teach = they do the work and you set it; do = you do the work and the card is a report)
  Run `board brief` before your first card: it says whether this stance is the
  repository's or was chosen for this sitting alone, and a sitting's does not
  outlive it.
- Session: **%(session)s**

**The board is already running.** Do not start another one. It is at:

%(urls)s

The user is reading that page, probably on an iPad, not this terminal. Write each
teaching turn as a card in `live/cards/` and keep the terminal to a line or two.
Check `board inbox` at the start of every turn. When the session ends, run
`board finish` so the board can offer to save and push.

**Every course works the same way.** There is no mode: the user answers on the
board, by writing on the slate or by typing, in this repository and in every
other one. A repository whose subject is code is no exception — if they have
implemented something, they will say so in a written or typed turn, and that
turn is your cue to go and look at what actually changed.

**Reading handwriting.** Handwriting is a PNG, a problem sheet is a PDF. If your
model can see images, open the file directly. If it cannot, run `board see
<path>` -- it prints what is on the page, and `--page N` picks a page of a PDF.
It refuses a path inside a fence, because it sends the file to a provider.

**Read `live/TEACHING.md` before your first card.** It is the method every course
on this board is taught by, and it is not optional. The rule it all follows from:
**the lesson is exercises, not explanation.** Pick the section's exercises first,
choose a manageable few, and for each one state it in full, hand the student one
tiny thing to work themselves per idea it actually needs — your objects, their
showing — then re-pose the exercise in full and ask for it. One question per turn,
then stop. It ships with the board rather than with the course, so it is the same
everywhere and cannot drift.

%(handoff)s

**`board recap` is how you read the lesson, not `live/cards/` one file at a
time.** One command prints the session, every card as a line, the newest card in
full and the student's own turns. Reading a twelve-card lesson card by card is
twelve round trips for something you were handed in one, and on a model billed by
the token every one of them is charged against the whole conversation. Read what
you need once; do not re-read this brief, the contract or the method on later
turns.
"""

# Sessions do not end tidily. A course is switched on the iPad, a lid closes, an
# allocation expires. Whatever the reason, the assistant gets one last turn to
# write down where things got to, because the alternative is the next session
# opening cold and asking the student to recap their own lesson.
HANDOFF_PROMPT = (
    "This session is ending now. You get one turn and nobody will read stdout.\n\n"
    # A teaching turn is its own session now, so this one is resumed onto the
    # LAST turn and holds one card, not the evening. Reading the lesson back is
    # therefore not optional here -- but it is one call, not twelve.
    "Run `board recap` first: this session holds only the last turn of the "
    "lesson, and the recap is the whole shape of it in one call. Do not read "
    "live/cards/ file by file, and do not read AI_INSTRUCTIONS.md, "
    "live/TEACHING.md or the old HANDOFF.md to write this.\n\n"
    "Then write the handoff by piping it to `board handoff` -- that command is "
    "the only thing that writes HANDOFF.md, it stamps the chapter for you, and "
    "**it refuses a body over 350 words.** The cap is not a suggestion: this "
    "file is read at the start of every turn of every future session, so length "
    "here is a cost paid over and over. If it refuses, cut it and pipe it "
    "again. Short and concrete:\n\n"
    "- where the student got to, by topic, not by card number\n"
    "- what they got wrong, and what the misunderstanding actually was\n"
    "- what they got right, so it is not re-taught\n"
    "- the single next thing to teach, and why that one\n"
    "- anything about how this student works that took you a while to learn\n\n"
    # Not a documentation review. "Fix anything that drifted" was read as an
    # invitation to re-read and rewrite two long documents on the way out of
    # every session, which is a whole turn's worth of tokens for nothing the
    # student asked for.
    "If something you wrote this session made a specific line in the course's "
    "README or AI_INSTRUCTIONS.md actually false, fix that line. Do not review "
    "either document for drift and do not rewrite sections.\n\n"
    "Do not ask questions, do not start new teaching, and do not write a card -- "
    "the student has already gone."
)


# ---------------------------------------------------------------------------
# Headless: the assistant as a daemon, driven entirely from the iPad.
#
# `board wait` blocks until the student sends something and then exits. That is
# the whole engine: wait, hand what arrived to the assistant, let it write cards,
# wait again. Nobody is at a terminal at any point.
#
# It writes a heartbeat as it goes, because a daemon you cannot see is worse than
# no daemon -- the board shows whether anything is actually listening.
# ---------------------------------------------------------------------------
import signal
import threading
import time
import uuid

from tutorboard import colibri

# Two prompts, and the difference between them is most of what a headless course
# costs. The first turn of a daemon's life has nothing in context, so it pays for
# the contract, the method and the lesson once. Every turn after it runs with the
# agent's own session resumed -- the recipe's `--continue` -- so it ALREADY holds
# all of that, and the old single prompt told it to read the lot again anyway:
# AI_INSTRUCTIONS.md, TEACHING.md, BRIEF.md, HANDOFF.md and every card in the
# lesson, one tool call each. On a model billed by the token that is not a small
# waste. Every round trip inside a turn resends the whole conversation, so a
# re-read is charged again for the rest of the turn and again for the rest of the
# session; a twelve-card lesson was paying twelve growing round trips before a
# word of teaching was written. Nothing about teaching quality needed it.
HANDOFF_CLAUSE = (
    "**Read `HANDOFF.md` before your first card** if the repository has one. It is\n"
    "what the last session left for you: where the student got to, what they got\n"
    "wrong, and what comes next. Sessions end without warning — a switched course, a\n"
    "closed lid, an allocation that expired — so it is the only continuity there is.")

NO_HANDOFF_CLAUSE = (
    "**There is no handoff for this chapter, and that is deliberate.** A chapter is\n"
    "its own thing: what was left unfinished in an earlier one is not this chapter's\n"
    "business, and bringing it in is exactly what the student asked to stop. Do not\n"
    "go looking for it — not in `live/archive/`, not in `live/handoffs/`, not in an\n"
    "older chapter's write-up. If they want to go back to an earlier chapter they\n"
    "will say so, and reopening it brings that chapter's own handoff back with it.")


def chapter_now(root):
    """Which chapter is open, according to the board's own state."""
    try:
        with open(os.path.join(root, "live", "state.json"), "r", encoding="utf-8") as fh:
            return (json.load(fh) or {}).get("chapter") or ""
    except (OSError, ValueError):
        return ""


def doing_now(root, signal=""):
    """Is the sitting that is open one whose product is a change, not a card?

    ASKED OF `course/config.py`, WHICH IS THE ONE ANSWER. This function used to
    hold its own copy of the aims that write -- a third list of the same three
    words, beside `sense`'s and the browser's -- and it read `tutorboard.json` by
    hand as well, so a family's default style in `atlas.json` reached the prompt
    and not the clock. A doing turn on a teaching turn's timeout is a turn killed
    at fifteen minutes with eight files changed and nothing committed.

    AND THREE TURNS ANSWER IT WITHOUT THE SITTING. A step handed over -- `POST
    /handover` -- is a doing turn inside a coaching sitting, and the sitting is
    left saying `coach` on purpose, because the next card is a coach card again.
    A ship is not part of the sitting at all. And a document asked for mid-
    sitting -- `POST /writeup` -- is deliberately not an aim change: a paper is a
    product rather than a style, so the sitting still says `drill` or `trace`
    while this turn writes one and compiles it. So the state says `teach` and is
    right about the evening; only the signal this turn was woken with says what
    THIS turn does.
    """
    if signal in ("handover", "rework", "ship", "writeup"):
        # A step handed over writes code. A ship reads a diff, judges it and
        # runs a push against a remote over a tailnet -- neither is a card, and
        # a doing turn on a teaching turn's clock is a turn killed with the work
        # half done. A REWORK is the same arithmetic on a document: thirty-three
        # pages rewritten and a LaTeX build at the end of it, which a teaching
        # turn's fifteen minutes kills with the deck half replaced. A WRITEUP is
        # that arithmetic from nothing: a paper drafted whole and built, which is
        # the longest of the four. A plain revision is not here on purpose -- it
        # changes what a note names and is over in a minute.
        return True
    try:
        with open(os.path.join(root, "live", "state.json"), "r", encoding="utf-8") as fh:
            st = json.load(fh) or {}
    except (OSError, ValueError):
        return False
    if st.get("session") == "make":
        return True
    try:
        # The sitting's own aim first, whatever kind of sitting it is: somebody
        # who asked for a deck about the machinery they were walking through has
        # asked for work to be done, and the kind of sitting does not say so.
        mine = config.clean_aim(st.get("aim"))
        if mine:
            return config.AIM_STANCE.get(mine) == "do"
        if (st.get("session") or "lecture") not in ("lecture", "homework"):
            return False
        return config.stance_for(root, st) == "do"
    except Exception:
        return False


def turn_timeout(cfg, root, spec=None, signal=""):
    """How long this turn gets, by what kind of turn it is AND which agent runs it.

    The two numbers in the configuration are about the SITTING: a teaching turn
    writes a card and stops, a turn that was asked to write the code stages
    models and runs a suite. Both were measured against a hosted model that
    starts answering in seconds.

    An agent may be slower than either by an order of magnitude, and one is: a
    colibri turn spends two to three hours in prefill before it emits its first
    token, so every one of its turns died at the cap and was painted as a turn
    that FAILED rather than one that was interrupted. A `timeout` on the recipe
    is taken as a FLOOR, so the existing numbers stay exactly as they are for
    every other agent and the slow one carries its own.

    `signal` is what the inbox line says this turn is for, and it reaches here
    because one kind of turn is not the kind of turn its sitting is -- see
    `doing_now`.
    """
    plain = int(cfg.get("headless_timeout", 900) or 900)
    if doing_now(root, signal):
        plain = max(plain, int(cfg.get("doing_timeout", 3600) or 3600))
    try:
        floor = int((spec or {}).get("timeout") or 0)
    except (TypeError, ValueError):
        floor = 0
    return max(plain, floor)


def handoff_clause(root):
    """What to tell a tutor about the handoff -- including that there is none."""
    return (HANDOFF_CLAUSE if handoff.handoff_applies(root, chapter_now(root))
            else NO_HANDOFF_CLAUSE)


# The single line every turn ends on, and the two things it must not do. Both
# were measured costing real money, and neither could be fixed by asking nicely
# in a longer paragraph -- `board wait` and `board handoff` refuse now.
TURN_TAIL = (
    "Before you finish, leave the next turn a note: `board note`, at most 120 "
    "words on stdin -- what you actually READ in their answer (the misreading, "
    "not the mark) and the one thing you are aiming at next. Not a summary of "
    "the lesson; `board recap` has that. This turn is its own session and "
    "nothing you are holding survives it, so that note is the only thing that "
    "does.\n\n"
    "Two things not to do, both of which cost real money before they were "
    "refused outright:\n"
    "- **Do not run `board wait`.** A turn does not wait. The daemon that "
    "started this turn is already blocked on the student's next message and "
    "will hand it to a fresh turn the moment it lands. Waiting here holds this "
    "whole conversation open while they think and then answers them inside it.\n"
    "- **Do not touch `HANDOFF.md`.** Not a read, not an edit. The wrap-up turn "
    "at the end of the session writes it, once, with `board handoff`. A "
    "teaching turn that edits it pays to read five thousand tokens of it first "
    "and hands the next turn a longer one.\n\n"
    "End your turn when the card and the note are written."
)

# What `coli-code` exits when the generation its step ran in ended under it. The
# client is the only process that knows which job that was, so it is the only
# thing that can tell a hop from a bad answer -- and it says so in a number
# rather than in prose, because prose in a log is not a branch.
CARRY_EXIT = 75

# And what it exits when there is no generation worth stepping into yet. A chain
# gap is ordinary -- the successor is a 68-minute cold pin and pends behind a
# full node -- so a pick-up landing in one must cost neither a hop nor a stall.
NOTHING_YET_EXIT = 76


def reads_as_carry(err):
    """Did that turn end because its node went, rather than because it failed?"""
    return err == "exit %d" % CARRY_EXIT


def reads_as_wait(err):
    """Was there nothing to step into, so that nothing has happened at all?"""
    return err == "exit %d" % NOTHING_YET_EXIT


# HOW LONG THE DAEMON WAITS FOR A MESSAGE, AND HOW LONG IT WAITS FOR THE THING
# THAT IS WAITING. Two numbers, and the second one exists because the first is a
# promise `board wait` cannot always keep.
#
# `cmd_wait` polls a file every quarter second and checks its own deadline
# between polls. A poll is an `open()` on a filer, and an NFS open can block in
# the kernel UNINTERRUPTIBLY -- state `D`, where no Python of that process runs
# again until the filer answers. Its deadline is therefore never reached, and
# nothing inside that command can fix it: a timeout enforced by the thing that
# might hang is not a timeout.
#
# Measured on 23 September 2026, in Probability: one waiter stuck 71 minutes in
# `nfs_set_open_stateid_locked` with `--timeout 300` on its command line. The
# daemon was healthy, its process alive, and it wrote no heartbeat and took no
# turn for the whole of it -- so the board said the tutor had not picked the
# message up, which was true and unactionable. A restart could not clear it
# either: the daemon was inside `communicate()` with no bound, so the signal was
# accepted and nothing acted on it.
#
# So the PARENT bounds the child. `WAIT_CEILING` is a margin over the deadline
# the child was given rather than a number of its own: past it, the child is not
# coming back, and a fresh one costs nothing. Both stay well inside
# `processes.AWAY_SILENCE`, which is what decides whether a board calls this
# daemon dead.
WAIT_TIMEOUT = 300
WAIT_CEILING = 420


def drop_waiter(p, log=None):
    """SIGKILL a `board wait` that is not coming back. Never blocks.

    SIGKILL RATHER THAN SIGTERM, and that is the safety property rather than
    impatience. A wedged waiter is inside a syscall; a signal to it is queued
    and delivered when the filer answers, which may be an hour later. On SIGTERM
    it would then run Python again -- and the next thing `cmd_wait` does on
    finding a message is `cmd_inbox`, which MARKS IT READ and prints it down a
    pipe nobody is holding any more. That is the student's message consumed and
    lost. SIGKILL cannot be caught, so no further line of that process runs.

    The group, because `start_new_session` put it in one, for the reason
    `run_turn` does it. And it is not waited on: reaping a process in
    uninterruptible sleep is the same hang one level up.
    """
    try:
        os.killpg(os.getpgid(p.pid), signal.SIGKILL)
    except OSError:
        pass
    if log:
        log.write("!! the wait for a message did not come back in %d s and has "
                  "been killed; asking again\n" % WAIT_CEILING)


def run_turn(cmd, root, log, timeout, env=None):
    """Run one turn to completion or to its cap. `(returncode, timed_out)`.

    THE WHOLE PROCESS GROUP, because `coli-code` is a shell that runs `srun`,
    and killing the shell alone orphans the step: the client goes on answering
    on the serving node, and the next turn is a second client on one KV slot.
    `start_new_session` puts the turn in a group of its own so there is a group
    to signal, and SIGTERM is given fifteen seconds before SIGKILL so a client
    that can close its transcript does.
    """
    # AND NOTHING ON STDIN. A client that reads stdin when it is not a terminal
    # appends whatever it finds to the prompt and BLOCKS until the far end
    # closes -- `codex exec` prints "Reading additional input from stdin..." and
    # waits, which for a `tutor headless` started from a terminal is for ever.
    # The turn then dies at its cap having said nothing, and on the board that
    # is indistinguishable from a model thinking for fifteen minutes. The
    # spawned daemon already passes DEVNULL to itself; this is the same answer
    # one level down, where it covers every way a turn is started.
    p = subprocess.Popen(cmd, cwd=root, stdout=log, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL,
                         start_new_session=True, env=env)
    try:
        return p.wait(timeout), False
    except subprocess.TimeoutExpired:
        pass
    for sig, grace in ((signal.SIGTERM, 15), (signal.SIGKILL, None)):
        try:
            os.killpg(os.getpgid(p.pid), sig)
        except OSError:
            pass
        try:
            p.wait(grace)
            break
        except subprocess.TimeoutExpired:
            continue
    return p.returncode, True


HEADLESS_FIRST_PROMPT = (
    "You are running headless: there is no terminal and nobody will read "
    "stdout. The student is on the board.\n\n"
    # Two calls, and they are the whole of the cold read. This used to be three
    # documents in three round trips -- AI_INSTRUCTIONS.md, live/TEACHING.md and
    # HANDOFF.md, 24k tokens in Galois Theory -- read before a word of teaching
    # was written, and then carried for the rest of the session. `board brief`
    # is the tenth of that which a turn acts on.
    "Run these two commands first, and read nothing else before them:\n"
    "- `board brief` -- the method, this course's rules that do not bend, the "
    "handoff from the last session, and the note the turn before this one left "
    "you.\n"
    "- `board recap` -- the lesson: every card as a line, the newest in full, "
    "the student's own turns, and which question is still open.\n\n"
    "**Do not read AI_INSTRUCTIONS.md, live/TEACHING.md, live/BRIEF.md or "
    "HANDOFF.md, and do not read live/cards/ file by file.** Those two commands "
    "are what a turn needs; the documents are on disk and the brief names their "
    "sections for the rare rule that needs its detail. Every round trip you "
    "take is charged for the whole conversation behind it, so a document read "
    "here is paid for again by everything you do afterwards.\n\n"
    "They just sent this:\n\n%(inbox)s\n\n"
    "That text is the inbox -- it already carries every file path, so do not "
    "run `board inbox` as well; it has been marked read and will tell you "
    "nothing. Open anything the text names: handwriting is a PNG and a problem "
    "sheet a PDF, read however your model sees images -- opening the file "
    "directly, or `board see <path>` where it cannot.\n\n"
