#!/usr/bin/env bash
# ---------------------------------------------------------------------------
#  tutor-pull -- the periodic pull, from a timer that fires every two minutes.
#
#      tutor-pull            hear the cluster; pull vendor and Tailscale daily
#      tutor-pull --force    both, regardless
#
#  EVERY RUN: `tutor pull --hear`. On a machine without Slurm it pulls the
#  repository every two minutes while a relay request is out and hourly
#  otherwise, then drops a `[job]` line for each cluster report that ended.
#  The cadence is decided there (`jobs.pull_due`), not by the timer. On a
#  machine with Slurm it does nothing: the relay pulls there.
#
#  ONCE A DAY: `tutor pull`, below.
#
#  `tutor pull` moves the two things this repository depends on and does not
#  write: `vendor/colibri`, somebody else's repository tracked here by pointer,
#  and the unprivileged Tailscale unpacked under $HOME that no package manager
#  knows about. Both also happen on login from `tutor resume`, which is the one
#  moment a compute node gets; this is the copy for a workstation that is left
#  up for a week and never has a login.
#
#  IT REIMPLEMENTS NOTHING. The submodule fast-forward, the pointer commit and
#  the three guards that make an unattended commit safe are `pull_vendor` in
#  `bin/tutor`; the client update and its four refusals are `update_userspace`
#  in `tutorboard/net/tailscale.py`; the cadence and the hearing are
#  `hear_pass` in `bin/tutor`. This file is a stamp, a log and two calls.
#
#  Never fatal and never clever: a dirty tree, a detached HEAD, an unreachable
#  remote or a package index that does not answer is written to the log and
#  left alone. Merging somebody else's repository is not a decision a timer
#  gets to make.
#
#  A launchd agent on the Mac (`scripts/launchd/`, every 120 seconds); a
#  systemd --user timer on Linux, because pam refuses cron on this cluster.
# ---------------------------------------------------------------------------
set -uo pipefail

STAMP="$HOME/.local/state/tutor-pull.stamp"
LOG="$HOME/.local/state/tutor-pull.log"
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

mkdir -p "$(dirname "$LOG")" 2>/dev/null
say() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

# A systemd --user unit or a launchd agent gets almost no PATH, so find the
# tool the way the person's shell would and then the way the installer put it.
TUTOR="$(command -v tutor 2>/dev/null)"
[ -x "${TUTOR:-}" ] || TUTOR="$HOME/.local/bin/tutor"
[ -x "$TUTOR" ] || { say "no tutor on PATH; nothing pulled"; exit 0; }

export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false

# Silent when there was nothing to hear, so the log only grows when a report did.
if [ "$FORCE" -eq 1 ]; then
  heard="$("$TUTOR" pull --hear --quiet --force 2>&1)"
else
  heard="$("$TUTOR" pull --hear --quiet 2>&1)"
fi
[ -n "$heard" ] && say "$(printf '%s' "$heard" | tr -s ' \n' ' ')"

today="$(date '+%Y-%m-%d')"
if [ "$FORCE" -eq 0 ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$today" ]; then
  exit 0
fi

out="$("$TUTOR" pull 2>&1)"
rc=$?

# `tutor pull` is silent when there was nothing to move, so silence is the
# common case and worth one line rather than an empty one.
trimmed="$(printf '%s' "$out" | tr -s ' \n' ' ' | sed 's/^ *//; s/ *$//')"
if [ -n "$trimmed" ]; then
  say "$trimmed"
elif [ "$rc" -eq 0 ]; then
  say "already current"
else
  say "nothing pulled (exit $rc)"
fi

printf '%s\n' "$today" > "$STAMP"
exit 0
