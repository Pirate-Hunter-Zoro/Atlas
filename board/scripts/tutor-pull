#!/usr/bin/env bash
# ---------------------------------------------------------------------------
#  tutor-pull -- the periodic pull, from a timer that fires every twenty seconds.
#
#      tutor-pull            hear the cluster; pull vendor daily
#      tutor-pull --force    both, regardless
#
#  EVERY RUN: `tutor pull --hear`. On a machine without Slurm it pulls Atlas
#  every twenty seconds, then drops a `[job]` line for each cluster report
#  that ended and a `[coach]` line for each held step's check.
#  The cadence is decided there (`jobs.pull_due`), not by the timer. On a
#  machine with Slurm it does nothing: the relay pulls there.
#
#  ONCE A DAY: `tutor pull`, below: a plain fast-forward of Atlas, which
#  brings the vendor checkouts along when the pull moved their pointers. Only
#  the cluster relay bumps vendor pointers.
#
#  IT REIMPLEMENTS NOTHING. The pull and its guards are `pull`, and the cadence
#  and the hearing are `hear_pass`, both in `tutorboard/gitops.py`.
#  This file is a stamp, a log and two calls.
#
#  Never fatal and never clever: a dirty tree, a detached HEAD
#  or an unreachable remote is written to the log and
#  left alone. Merging somebody else's repository is not a decision a timer
#  gets to make.
#
#  A launchd agent on the Mac (`scripts/launchd/`, every 20 seconds).
# ---------------------------------------------------------------------------
set -uo pipefail

STAMP="$HOME/.local/state/tutor-pull.stamp"
LOG="$HOME/.local/state/tutor-pull.log"
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

mkdir -p "$(dirname "$LOG")" 2>/dev/null
say() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

# A launchd agent gets almost no PATH, so find the
# tool the way the person's shell would and then the way the installer put it.
TUTOR="$(command -v tutor 2>/dev/null)"
[ -x "${TUTOR:-}" ] || TUTOR="$HOME/.local/bin/tutor"
[ -x "$TUTOR" ] || { say "no tutor on PATH; nothing pulled"; exit 0; }

export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false

# Silent when there was nothing to hear, so the log only grows when a report did.
if [ "$FORCE" -eq 1 ]; then
  heard="$("$TUTOR" pull --hear --quiet --force 2>&1)"
else
  heard="$("$TUTOR" pull --hear --quiet 2>&1)"
fi
[ -n "$heard" ] && say "$(printf '%s' "$heard" | tr -s ' \n' ' ')"

today="$(date '+%Y-%m-%d')"
if [ "$FORCE" -eq 0 ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$today" ]; then
  exit 0
fi

out="$("$TUTOR" pull 2>&1)"
rc=$?

# `tutor pull` is silent when there was nothing to move, so silence is the
# common case and worth one line rather than an empty one.
trimmed="$(printf '%s' "$out" | tr -s ' \n' ' ' | sed 's/^ *//; s/ *$//')"
if [ -n "$trimmed" ]; then
  say "$trimmed"
elif [ "$rc" -eq 0 ]; then
  say "already current"
else
  say "nothing pulled (exit $rc)"
fi

printf '%s\n' "$today" > "$STAMP"
exit 0
