{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["libr-ai"],
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "edit": "deny",
    "bash": "deny",
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",
    "skill": "deny",
    "lsp": "deny"
  },
  "provider": {
    "libr-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LIBR AI (IT's Open WebUI)",
      "options": {
        "baseURL": "https://ai.laureateinstitute.org/api",
        "apiKey": "{file:~/.config/libr-ai/key}"
      },
      "models": {
        "gpt-oss:120b": {
          "name": "GPT-OSS 120B (IT DGX Spark)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B (IT DGX Spark)",
          "limit": { "context": 131072, "output": 32768 }
        }
      }
    }
  }
}
