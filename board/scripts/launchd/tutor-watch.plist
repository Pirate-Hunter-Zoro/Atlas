<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  tutor watch on a Mac: what brings every board back after a reboot.

  A Mac is a machine that comes back, so here the boards ARE supervised:
  launchd keeps `tutor watch` running. It repairs only what a person already asked for -- a board
  or a tutor with a record in its workspace's live/ -- so a reboot brings back
  exactly the boards that were up, and `board stop` keeps one down.

  A LaunchAgent for the reason tutor-pull.plist gives: automatic login brings it
  up with nobody at the keyboard, inside the session whose keychain the
  assistants and git sign in from.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>tutor-board.tutor-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" PYTHONUNBUFFERED=1; mkdir -p "$HOME/.local/state"; exec "$HOME/.local/bin/tutor" watch >>"$HOME/.local/state/tutor-watch.log" 2>&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
